// dom_test: min-width, box sizes and HTML tag defaults.

module dom_test;

fn testMinWidth(mem: &Arena, css: &Css) {
    let t = Dom.new(mem, css);
    t.begin();
    let r1 = el(&t, 0, "div", S_TEST, "row");
    let a1 = el(&t, 0, "div", S_TEST, "fa");
    let wd1 = el(&t, 0, "div", S_TEST, "wide");
    t.close();
    t.close();
    let b1 = el(&t, 1, "div", S_TEST, "fb");
    t.close();
    t.close();
    let r2 = el(&t, 1, "div", S_TEST, "row");
    let a2 = el(&t, 0, "div", S_TEST, "fz");
    let wd2 = el(&t, 0, "div", S_TEST, "wide");
    t.close();
    t.close();
    let b2 = el(&t, 1, "div", S_TEST, "fb");
    t.close();
    t.close();
    t.end();
    t.layoutAt(1000.0, 600.0);
    // fa: min-width auto = min-content = the 300px child, so it overflows the 200px row
    near(nw(&t, a1), 300.0, 0.01, "min-width:auto: the item keeps its 300px min-content");
    near(nw(&t, b1), 0.0, 0.01, "overflowing row: the 50px empty item shrinks (flex-shrink 1, its auto min is 0)");
    near(nx(&t, b1), 300.0, 0.01, "second item pushed past the row end");
    // fz: min-width 0, flex:1 -> 200 - 50
    near(nw(&t, a2), 150.0, 0.01, "min-width:0: the item shrinks to the free space");
    near(nx(&t, b2), 150.0, 0.01, "second item stays inside the row");
    near(nw(&t, b2), 50.0, 0.01, "second item keeps its 50px");
    // shrink: two 150px items in 200px -> 100 each (proportional to base size)
    let t3 = Dom.new(mem, css);
    t3.begin();
    el(&t3, 0, "div", S_TEST, "row");
    let sa = el(&t3, 0, "div", S_TEST, "s150");
    t3.close();
    let sb = el(&t3, 1, "div", S_TEST, "s150");
    t3.close();
    t3.close();
    t3.end();
    t3.layoutAt(1000.0, 600.0);
    near(nw(&t3, sa), 100.0, 0.01, "shrink: 150px items in a 200px row -> 100");
    near(nw(&t3, sb), 100.0, 0.01, "shrink: second item");
    near(nx(&t3, sb), 100.0, 0.01, "shrink: second item x");
    ok(r1 >= 0 && r2 >= 0 && wd1 >= 0 && wd2 >= 0, "ids");

}

fn testBoxes(mem: &Arena, css: &Css) {
    let t = Dom.new(mem, css);
    t.begin();
    let cb = el(&t, 0, "div", S_TEST, "cbx");
    t.close();
    let nn = el(&t, 1, "div", S_TEST, "none");
    t.close();
    let pc = el(&t, 2, "div", S_TEST, "pct");
    t.close();
    let mg = el(&t, 3, "div", S_TEST, "mg");
    t.close();
    let rel = el(&t, 4, "div", S_TEST, "rel");
    let ab = el(&t, 0, "div", S_TEST, "abr");
    t.close();
    let ab2 = el(&t, 1, "div", S_TEST, "abs2");
    t.text("hi");
    t.close();
    t.close();
    let after = el(&t, 5, "div", S_TEST, "mg");
    t.close();
    t.end();
    t.layoutAt(400.0, 300.0);
    near(nw(&t, cb), 124.0, 0.01, "content-box: width 100 + padding 20 + border 4");
    near(nh(&t, cb), 54.0, 0.01, "content-box: height 30 + 24");
    near(ny(&t, pc), nh(&t, cb), 0.01, "display:none takes no space");
    near(nw(&t, pc), 200.0, 0.01, "width 50% of 400");
    near(nx(&t, mg), 7.0, 0.01, "margin-left 7");
    near(ny(&t, mg), nh(&t, cb) + 20.0 + 5.0, 0.01, "margin-top 5, no collapsing with the previous sibling");
    near(nw(&t, mg), 386.0, 0.01, "block stretches between margins");
    near(ny(&t, rel), ny(&t, mg) + 10.0 + 5.0, 0.01, "next after margin-bottom 5");
    near(nx(&t, ab), 70.0, 0.01, "absolute right:10");
    near(ny(&t, ab), 67.0, 0.01, "absolute bottom:5");
    near(nx(&t, ab2), 4.0, 0.01, "absolute left:4");
    near(ny(&t, ab2), 3.0, 0.01, "absolute top:3");
    near(nw(&t, ab2), tw(16, false, "hi"), 1.0, "absolute shrink-to-fit width (only left set)");
    ok(nn >= 0 && after >= 0, "ids");

}

// The built-in tag styles (the `j3.ui.uastyle` UA sheet, `tagDisplay`) and how they meet author rules: an author
// class beats the UA rule, an equal-weight author tag rule comes later and wins, and inherited `white-space` reaches code.
const HTML_CSS: string = ".title { font-weight: 400; } .pl { font-weight: 400; } .box { width: 300px; } .m { margin: 8px 0; } b { font-weight: 300; }";

fn testHtmlTags(mem: &Arena) {
    let c = Css.new(mem);
    uastyle.load(&c); // first, as a generated root does: the author sheet below comes after it
    parse(&c, HTML_CSS, "html.css", S_TEST);
    let t = Dom.new(mem, &c);
    t.begin();
    let ul = el(&t, 0, "ul", S_TEST, "");
    let li = el(&t, 0, "li", S_TEST, "");
    let st = el(&t, 0, "strong", S_TEST, "");
    t.text("bold");
    t.close();
    let tt = el(&t, 1, "strong", S_TEST, "title");
    t.text("title");
    t.close();
    t.close();
    t.close();
    let p = el(&t, 1, "p", S_TEST, "pl");
    let sp = el(&t, 0, "strong", S_TEST, "");
    t.text("in p");
    t.close();
    t.close();
    let h3 = el(&t, 2, "h3", S_TEST, "");
    let em = el(&t, 0, "em", S_TEST, "");
    t.text("x");
    t.close();
    t.close();
    let pre = el(&t, 3, "pre", S_TEST, "");
    let cd = el(&t, 0, "code", S_TEST, "");
    t.text("k");
    t.close();
    t.close();
    let bx = el(&t, 4, "div", S_TEST, "box");
    let hr = el(&t, 0, "hr", S_TEST, "m");
    t.close();
    t.close();
    let bb = el(&t, 5, "b", S_TEST, "");
    t.text("b");
    t.close();
    let a = el(&t, 6, "a", S_TEST, "");
    t.text("link");
    t.close();
    t.end();
    t.layoutAt(400.0, 300.0);
    ok(t.nodes.items[ul].disp == dom.DP_BLOCK && t.nodes.items[li].disp == dom.DP_BLOCK, "ul and li are blocks");
    ok(t.nodes.items[pre].disp == dom.DP_BLOCK && t.nodes.items[hr].disp == dom.DP_BLOCK, "pre and hr are blocks");
    ok(t.nodes.items[h3].disp == dom.DP_BLOCK && t.nodes.items[bx].disp == dom.DP_BLOCK, "h3 and a div are blocks");
    ok(t.nodes.items[st].disp == dom.DP_INLINE && t.nodes.items[a].disp == dom.DP_INLINE, "strong and a are inline");
    ok(t.nodes.items[cd].disp == dom.DP_INLINE, "code is inline");
    ok(c.get(t.nodes.items[st].tstyle, P_FONT_WEIGHT).f == 700.0, "strong is bold (700)");
    ok(c.get(t.nodes.items[tt].tstyle, P_FONT_WEIGHT).f == 400.0, "an author class beats the UA strong rule");
    ok(c.get(t.nodes.items[sp].tstyle, P_FONT_WEIGHT).f == 700.0, "strong inside a font-weight 400 p is still bold");
    ok(c.get(t.nodes.items[bb].tstyle, P_FONT_WEIGHT).f == 300.0, "an author b rule after the UA sheet wins at equal weight");
    ok(c.get(t.nodes.items[em].tstyle, P_FONT_STYLE).i == 1, "em is italic, also inside an h3");
    ok(c.get(t.nodes.items[cd].tstyle, P_WHITE_SPACE).i == WS_PRE, "pre's white-space reaches a nested code");
    ok(c.get(t.nodes.items[a].tstyle, P_CURSOR).i == 2, "a has a pointer cursor");
    near(nh(&t, hr), 1.0, 0.01, "hr is a 1px rule");
    near(nw(&t, hr), nw(&t, bx), 0.01, "hr with margin 8px 0 is the full width of its block");
    near(nw(&t, hr), 300.0, 0.01, "hr width is the box's 300");
    near(ny(&t, hr) - ny(&t, bx), 8.0, 0.01, "hr keeps its margin-top 8");
    // a universal author rule is a later, user origin: it beats the UA em rule at specificity 0
    let c2 = Css.new(mem);
    uastyle.load(&c2);
    parse(&c2, "* { font-style: normal; }", "star.css", S_TEST);
    let t2 = Dom.new(mem, &c2);
    t2.begin();
    let e2 = el(&t2, 0, "em", S_TEST, "");
    t2.text("x");
    t2.close();
    t2.end();
    t2.layoutAt(400.0, 300.0);
    ok(c2.get(t2.nodes.items[e2].tstyle, P_FONT_STYLE).i == 0, "a universal author rule beats the UA em rule");
    ok(p >= 0 && sp >= 0, "ids");
}

const BOUND_CSS: string = ".g { display: flex; flex-wrap: wrap; gap: 2px; padding: 4px; } .k { width: 30px; height: 20px; padding: 2px; border: 1px solid #000; } .k2 { background: #f00; } .k.kw { width: 40px; } .bigf { font-size: 18px; } .r { width: 200px; height: 100px; overflow: hidden; }";

/// 100 fixed-size cards in a wrapping flex row; card `tx` says `s`, card `k2` has a paint-only extra class, card `wide` is wider.
fn boundFrame(d: &Dom, cards: []int, tx: int, s: string, k2: int, wide: int) {
    d.begin();
    el(d, 0, "div", S_TEST, "g");
    for i in 0..100 {
        cards[i] = el(d, i, "div", S_TEST, "k");
        d.clsIf(cards[i], "k2", i == k2);
        d.clsIf(cards[i], "kw", i == wide);
        leaf(d, 0, "span", S_TEST, "", if i == tx { s } else { "1" });
        d.close();
    }
    d.close();
    d.end();
    d.layoutAt(400.0, 300.0);
}

/// Layout boundaries: a change inside a fixed-size card lays out that card's subtree only, not the 100-item flex row.
fn testBoundaries(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    let cards = mem.alloc::<int>(100);
    boundFrame(&d, cards, -1, "", -1, -1);
    boundFrame(&d, cards, -1, "", -1, -1);
    let grid = d.nodes.items[cards[0]].parent;
    ok(d.nodes.items[cards[5]].bound && d.nodes.items[cards[5]].relay, "a 30x20 card in a roomy wrapping row is a boundary");
    let x6 = nx(&d, cards[6]);
    let y6 = ny(&d, cards[6]);
    // the card's span and text are inline, laid out by the card's own line layout: one `layoutBox` for the subtree,
    // where the full climb laid out the root, the row and the card
    let laid0 = d.laid;
    boundFrame(&d, cards, 5, "22222", -1, -1);
    ok(d.laid - laid0 == 1, "new text in one card lays out that card's subtree only");
    ok(!d.nodes.items[grid].dirty && !d.nodes.items[cards[5]].dirty, "row and card are clean after layout");
    near(nx(&d, cards[6]), x6, 0.01, "the next card stays put");
    near(ny(&d, cards[6]), y6, 0.01, "the next card stays put (y)");
    ok(fragW(&d, cards[5]) > fragW(&d, cards[4]) * 3.0, "the text inside was laid out again: five digits are wider than one");
    // a paint-only class swap changes no property layout reads: nothing lays out, the card shows the new style
    let laid1 = d.laid;
    boundFrame(&d, cards, 5, "22222", 7, -1);
    ok(d.laid - laid1 == 0, "a background-only class swap lays out 0 boxes");
    ok(d.css.get(d.nodes.items[cards[7]].style, P_BACKGROUND).kind == V_COLOR, "and the card has the new background");
    // a size change is no boundary change: the row lays out again and moves the cards after it
    let laid2 = d.laid;
    boundFrame(&d, cards, 5, "22222", 7, 9);
    let wideOnly = d.laid - laid2;
    ok(wideOnly > 0, "a wider card lays out the row");
    near(nw(&d, cards[9]), 40.0, 0.01, "the wider card is 40 wide");
    near(nx(&d, cards[10]) - nx(&d, cards[9]), 42.0, 0.01, "the card after it moved (40 + gap 2)");
    boundFrame(&d, cards, 5, "22222", 7, -1);
    // a queued boundary under a row that lays out anyway is laid out once, by the row
    let laid3 = d.laid;
    boundFrame(&d, cards, 5, "55", 7, 9);
    ok(d.laid - laid3 == wideOnly + 1, "new text in card 5 plus a wider card 9: the row pass lays card 5 once");
    ok(d.relayout.len == 0, "the relayout list is drained");
    // the parent reads its first child's baseline: when a boundary's moves, the parent lays out again after all
    let d2 = Dom.new(mem, css);
    let pb = baseFrame(&d2, false);
    let k = d2.nodes.items[pb].first;
    let b0 = d2.nodes.items[k].baseline;
    near(d2.nodes.items[pb].baseline, ny(&d2, k) + b0, 0.01, "the block's baseline is its first card's");
    baseFrame(&d2, true);
    ok(d2.nodes.items[k].baseline > b0 + 1.0, "bigger text inside the card moves its baseline down");
    near(d2.nodes.items[pb].baseline, ny(&d2, k) + d2.nodes.items[k].baseline, 0.01, "and the block took it up");
    ok(!d2.nodes.items[0].dirty && d2.relayout.len == 0, "clean after the fallback");
    // two nested boundaries queued in one frame: the outer one's replay must reach the inner one through the clean box between
    let d3 = Dom.new(mem, css);
    let c = nestFrame(&d3, "1", false);
    nestFrame(&d3, "1", false);
    let w1 = fragW(&d3, c);
    nestFrame(&d3, "22222", true);
    ok(!d3.nodes.items[c].dirty, "the inner card is clean after its outer boundary relaid in the same frame");
    ok(fragW(&d3, c) > w1 * 3.0, "and its new text was laid out");
}

/// A fixed `.r` box holding an auto block with a `.k` card saying `s`, then a sibling whose font grows when `big`; returns the card.
fn nestFrame(d: &Dom, s: string, big: bool): int {
    d.begin();
    el(d, 0, "div", S_TEST, "r");
    el(d, 0, "div", S_TEST, "");
    let c = el(d, 0, "div", S_TEST, "k");
    leaf(d, 0, "span", S_TEST, "", s);
    d.close();
    d.close();
    let sib = el(d, 1, "div", S_TEST, "");
    d.clsIf(sib, "bigf", big);
    d.text("y");
    d.close();
    d.close();
    d.end();
    d.layoutAt(400.0, 300.0);
    return c;
}

/// One card whose `.k` box holds a bar with `style:width` `w` px, `style:background` `bg` and `style:color` `c`; returns the bar.
fn inlineFrame(d: &Dom, w: f32, bg: string, c: string): int {
    return inlinePad(d, w, bg, c, "");
}

/// `inlineFrame` plus `style:padding-left` `pad` (empty: none).
fn inlinePad(d: &Dom, w: f32, bg: string, c: string, pad: string): int {
    d.begin();
    el(d, 0, "div", S_TEST, "k");
    let bar = el(d, 0, "div", S_TEST, "");
    d.styleNum(bar, 0, "width", w);
    d.styleStr(bar, 1, "background", bg);
    d.styleStr(bar, 2, "color", c);
    d.styleStr(bar, 3, "padding-left", pad);
    d.text("x");
    d.close();
    d.close();
    d.end();
    d.layoutAt(400.0, 300.0);
    return bar;
}

/// `style:` changes skip the bar's cascade (`Dom.cascaded`); a paint-only one lays nothing out, a width relays the box.
fn testInlineStyle(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    let bar = inlineFrame(&d, 10.0, "#f00", "#f00");
    inlineFrame(&d, 10.0, "#f00", "#f00");
    let c0 = d.cascaded;
    let r0 = d.restyled;
    let l0 = d.laid;
    inlineFrame(&d, 10.0, "#00f", "#f00");
    ok(d.cascaded == c0 && d.restyled - r0 == 1, "a style:background change restyles the bar alone, without a cascade");
    ok(d.laid == l0, "a style:background change lays out 0 boxes");
    ok(d.css.get(d.nodes.items[bar].style, P_BACKGROUND).c != d.css.get(d.nodes.items[bar].style, P_COLOR).c, "the bar has the new background");
    // color is inherited: the text under the bar restyles too (its own cascade, under the bar's new style)
    let c1 = d.cascaded;
    let r1 = d.restyled;
    inlineFrame(&d, 10.0, "#00f", "#0f0");
    ok(d.cascaded - c1 == 1 && d.restyled - r1 == 2, "a style:color change restyles the bar and the text that inherits it");
    ok(d.laid == l0, "a style:color change lays out 0 boxes");
    ok(d.css.get(d.nodes.items[bar].style, P_COLOR).c == d.css.get(d.nodes.items[d.nodes.items[bar].first].style, P_COLOR).c, "the text took the new color");
    let c2 = d.cascaded;
    let r2 = d.restyled;
    inlineFrame(&d, 14.0, "#00f", "#0f0");
    ok(d.cascaded == c2 && d.restyled - r2 == 1, "a style:width change restyles the bar alone, without a cascade");
    ok(d.laid > l0, "a style:width change lays out again");
    near(nw(&d, bar), 14.0, 0.01, "the bar is 14 wide");
    // the patched build: an em override resolves to px of the element's font-size, and a dropped override shows the cascade again
    inlinePad(&d, 14.0, "#00f", "#0f0", "2em");
    let pv = d.css.get(d.nodes.items[bar].style, P_PADDING_TOP + 3);
    near(pv.f, 2.0 * d.css.get(d.nodes.items[bar].style, P_FONT_SIZE).f, 0.01, "style:padding-left 2em is twice the font-size");
    ok(pv.kind == V_PX, "in px");
    inlinePad(&d, 14.0, "", "#0f0", "");
    let base = d.dyns.items[d.nodes.items[bar].dyn].base;
    ok(sameV(d.css.get(d.nodes.items[bar].style, P_BACKGROUND), d.css.get(base, P_BACKGROUND)), "a dropped style:background shows the cascade's again");
    ok(sameV(d.css.get(d.nodes.items[bar].style, P_PADDING_TOP + 3), d.css.get(base, P_PADDING_TOP + 3)), "a dropped style:padding-left too");
    near(nw(&d, bar), 14.0, 0.01, "the bar is 14 wide again without the padding");
}

fn sameV(a: Value, b: Value): bool {
    return a.kind == b.kind && a.f == b.f && a.i == b.i && a.c == b.c;
}

/// A block holding one 30x20 card with a span, its text 18px when `big`; returns the block.
fn baseFrame(d: &Dom, big: bool): int {
    d.begin();
    let pb = el(d, 0, "div", S_TEST, "");
    el(d, 0, "div", S_TEST, "k");
    let sp = el(d, 0, "span", S_TEST, "");
    d.clsIf(sp, "bigf", big);
    d.text("x");
    d.close();
    d.close();
    d.close();
    d.end();
    d.layoutAt(400.0, 300.0);
    return pb;
}

/// Width of the first text fragment block `id` owns.
fn fragW(d: &Dom, id: int): f32 {
    return d.frags.items[d.nodes.items[id].frag0].w;
}
