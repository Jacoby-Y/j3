// dom_test: hand-built idle-breakout component trees (what the generated code does).

module dom_test;

// ---- tree builders (what the generated code does) ---------------------------------------------------

fn el(d: &Dom, slot: int, tag: string, scope: int, cls: string): int {
    let id = d.open(slot, d.tag(tag), scope);
    if cls.len > 0 {
        d.cls(id, cls);
    }
    return id;
}

/// <tag class=cls>text</tag>
fn leaf(d: &Dom, slot: int, tag: string, scope: int, cls: string, text: string): int {
    let id = el(d, slot, tag, scope, cls);
    d.text(text);
    d.close();
    return id;
}

fn ballCard(d: &Dom, slot: int, name: string, owned: string, dmg: string, price: string): int {
    let card = el(d, slot, "div", S_BALLCARD, "card");
    el(d, 0, "div", S_BALLCARD, "top");
    leaf(d, 0, "span", S_BALLCARD, "name", name);
    leaf(d, 1, "span", S_BALLCARD, "owned", owned);
    d.close();
    leaf(d, 1, "small", S_BALLCARD, "", "Fires straight up, hits hard.");
    el(d, 2, "div", S_BALLCARD, "stats");
    leaf(d, 0, "span", S_BALLCARD, "", dmg);
    leaf(d, 1, "span", S_BALLCARD, "", "spd 320");
    d.close();
    el(d, 3, "button", S_BALLCARD, "");
    d.text("Buy · ");
    leaf(d, 1, "span", S_BALLCARD, "price", price);
    d.close();
    d.close();
    return card;
}

fn ballShop(d: &Dom, n: int): int {
    leaf(d, 0, "h2", S_BALLSHOP, "", "Balls 3 / 40");
    let grid = el(d, 1, "div", S_BALLSHOP, "grid");
    for k in 0..n {
        ballCard(d, k, "Plain", "x3", "dmg 5", "120");
    }
    d.close();
    return grid;
}

fn upgradeRow(d: &Dom, slot: int, label: string, value: string, cost: string): int {
    let row = el(d, slot, "div", S_UPGRADEROW, "row");
    leaf(d, 0, "span", S_UPGRADEROW, "label", label);
    leaf(d, 1, "span", S_UPGRADEROW, "value", value);
    leaf(d, 2, "button", S_UPGRADEROW, "", cost);
    d.close();
    return row;
}

fn upgrades(d: &Dom, rows: int): int {
    let sec = el(d, 0, "section", S_UPGRADES, "");
    leaf(d, 0, "h2", S_UPGRADES, "", "Click");
    for k in 0..rows {
        upgradeRow(d, k + 1, "Click damage", "12", "250");
    }
    d.close();
    return sec;
}

fn prestige(d: &Dom, longText: string): int {
    let box = el(d, 0, "div", S_PRESTIGE, "box");
    leaf(d, 0, "h1", S_PRESTIGE, "", "Prestige");
    leaf(d, 1, "p", S_PRESTIGE, "", longText);
    el(d, 2, "div", S_PRESTIGE, "gain");
    leaf(d, 0, "span", S_PRESTIGE, "", "You would get");
    leaf(d, 1, "span", S_PRESTIGE, "crystal", "+5");
    d.close();
    leaf(d, 3, "small", S_PRESTIGE, "", "Crystals = √(gold earned this run / 1000). Earned so far: 98765 and a fair amount of padding text so it wraps.");
    leaf(d, 4, "button", S_PRESTIGE, "go", "Prestige");
    d.close();
    return box;
}

fn stats(d: &Dom): int {
    let dl = el(d, 0, "dl", S_STATS, "");
    let names: [9]string = ["Level", "Bricks left", "Bricks broken", "Damage / second", "Balls", "Click damage", "Gold this run", "Crystals", "Prestiges"];
    let vals: [9]string = ["12", "340", "1200", "55", "4", "3", "98765", "7", "0"];
    for k in 0..9 {
        leaf(d, k * 2, "dt", S_STATS, "", names[k]);
        let cl = "";
        if k == 6 {
            cl = "gold";
        }
        leaf(d, k * 2 + 1, "dd", S_STATS, cl, vals[k]);
    }
    d.close();
    return dl;
}

fn settings(d: &Dom): int {
    let list = el(d, 0, "div", S_SETTINGS, "list");
    el(d, 0, "label", S_SETTINGS, "");
    leaf(d, 0, "span", S_SETTINGS, "", "Paused");
    let cb = el(d, 1, "input", S_SETTINGS, "");
    d.attrType(cb, "checkbox");
    d.close();
    d.close();
    el(d, 1, "label", S_SETTINGS, "");
    leaf(d, 0, "span", S_SETTINGS, "", "Game speed");
    let rg = el(d, 1, "input", S_SETTINGS, "");
    d.attrType(rg, "range");
    d.close();
    leaf(d, 2, "span", S_SETTINGS, "val", "1x");
    d.close();
    d.close();
    return list;
}

/// Sidebar; the main area shows `tab` (0 shop, 1 upgrades, 2 prestige, 3 stats, 4 settings).
fn sidebar(d: &Dom, tab: int, count: int, longText: string, gold: string) {
    el(d, 0, "div", S_SIDEBAR, "side");
    el(d, 0, "header", S_SIDEBAR, "");
    el(d, 0, "div", S_SIDEBAR, "wallet");
    leaf(d, 0, "span", S_SIDEBAR, "gold", gold);
    leaf(d, 1, "span", S_SIDEBAR, "crystal", "7 crystals");
    d.close();
    leaf(d, 1, "small", S_SIDEBAR, "", "Level 3 · 55 dmg/s");
    d.close();
    el(d, 1, "nav", S_SIDEBAR, "");
    let names: [5]string = ["Balls", "Upgrades", "Prestige", "Stats", "Settings"];
    for i in 0..5 {
        let b = el(d, i, "button", S_SIDEBAR, "");
        d.clsIf(b, "active", tab == i);
        d.text(names[i]);
        d.close();
    }
    d.close();
    el(d, 2, "main", S_SIDEBAR, "");
    if tab == 0 {
        ballShop(d, count);
    } else if tab == 1 {
        upgrades(d, count);
    } else if tab == 2 {
        prestige(d, longText);
    } else if tab == 3 {
        stats(d);
    } else {
        settings(d);
    }
    d.close();
    d.close();
}

fn game(d: &Dom, tab: int, count: int, paused: bool, longText: string, gold: string) {
    d.begin();
    el(d, 0, "div", S_GAME, "app");
    el(d, 0, "canvas", S_GAME, "field");
    el(d, 0, "div", S_GAME, "hud");
    leaf(d, 0, "span", S_GAME, "level", "Level 3");
    leaf(d, 1, "span", S_GAME, "", "42 bricks");
    d.close();
    if paused {
        el(d, 1, "div", S_GAME, "paused");
        leaf(d, 0, "h1", S_GAME, "", "Paused");
        leaf(d, 1, "button", S_GAME, "", "Resume");
        d.close();
    }
    d.close();
    el(d, 1, "div", S_GAME, "half");
    sidebar(d, tab, count, longText, gold);
    d.close();
    d.close();
    d.end();
}

// ---- tree queries ----------------------------------------------------------------------------------

fn kid(d: &Dom, id: int, n: int): int {
    let c = d.nodes.items[id].first;
    for i in 0..n {
        c = d.nodes.items[c].next;
    }
    return c;
}
