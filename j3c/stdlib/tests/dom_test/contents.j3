// dom_test: display: contents and its block/grid variants.

module dom_test;

// ===== display: contents rows sharing a grid's columns (chunk 6d) =====
const CT_CSS: string = ".g { display: grid; grid-template-columns: 1fr 140px 100px; width: 600px; height: 300px; overflow-y: auto; } .r { display: contents; } .c { height: 20px; } .w { display: grid; grid-template-columns: 10px 20px 30px 40px 50px 60px; width: 400px; } .w2 { display: grid; grid-template-columns: 1fr 1fr 2fr 50px 1fr; width: 450px; }";

#[singleton]
let CT_CLICK: int;

fn ctFrame(d: &Dom, ord: []int, n: int, uids: []int) {
    d.beginFrame(Vec2 { x: 800.0, y: 400.0 });
    el(d, 0, "div", S_TEST, "g");
    el(d, 0, "div", S_TEST, "r");
    for c in 0..3 {
        el(d, c, "div", S_TEST, "c");
        d.close();
    }
    d.close();
    for i in 0..n {
        let row = ord[i];
        if uids[row] < 0 {
            uids[row] = d.groupNew(-1);
        }
        d.keyBegin(uids[row]);
        el(d, 0, "div", S_TEST, "r");
        for c in 0..3 {
            let cell = el(d, c, "div", S_TEST, "c");
            if d.clicked(cell) {
                CT_CLICK = row * 10 + c;
            }
            d.close();
        }
        d.close();
        d.keyEnd();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn testContents(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, CT_CSS, "ct.css", S_TEST);
    let ok1 = css.warns.len == 0;
    ok(ok1, "contents css parses clean");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    let ord = mem.alloc::<int>(1000);
    let uids = mem.alloc::<int>(1000);
    for i in 0..1000 {
        ord[i] = i;
        uids[i] = -1;
    }
    d.simInput(-5.0, -5.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    ctFrame(&d, ord, 1000, uids);
    let g = kid(&d, 0, 0);
    let hr = kid(&d, g, 0);
    near(nw(&d, hr), 0.0, 0.01, "a contents element has no box");
    near(nw(&d, kid(&d, hr, 0)), 360.0, 0.01, "header cell 0: 1fr takes the rest");
    near(nw(&d, kid(&d, hr, 1)), 140.0, 0.01, "header cell 1: 140px");
    near(nx(&d, kid(&d, hr, 1)), 360.0, 0.01, "header cell 1 x");
    near(nx(&d, kid(&d, hr, 2)), 500.0, 0.01, "header cell 2 x");
    let ok2 = true;
    for i in 0..1000 {
        let r = kid(&d, g, i + 1);
        let a = kid(&d, r, 0);
        let b = kid(&d, r, 1);
        let c = kid(&d, r, 2);
        if nx(&d, a) != 0.0 || nx(&d, b) != 360.0 || nx(&d, c) != 500.0 || nw(&d, a) != 360.0 || nw(&d, c) != 100.0 || ny(&d, a) != f32(20 * (i + 1)) || ny(&d, c) != ny(&d, a) {
            ok2 = false;
        }
    }
    ok(ok2, "1000 keyed contents rows share the header's column x, widths and row y");
    near(d.nodes.items[g].contentH, 20020.0, 0.01, "grid content height counts the flattened rows");
    // hit test: a cell of a contents row takes the click
    CT_CLICK = -1;
    d.simInput(400.0, 50.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    d.simInput(400.0, 50.0, true, 0.0);
    ctFrame(&d, ord, 1000, uids);
    d.simInput(400.0, 50.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    ok(CT_CLICK == 11, "click at (400, 50) lands on row 1 cell 1 through the contents row");
    // scroll: far rows still paint and hit (the contents row is never culled as a zero box)
    for k in 0..40 {
        d.simInput(400.0, 50.0, false, -5.0);
        ctFrame(&d, ord, 1000, uids);
    }
    let sy = d.nodes.items[g].scrollY;
    ok(sy > 1000.0, "wheel scrolls through the contents rows");
    CT_CLICK = -1;
    d.simInput(10.0, 50.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    d.simInput(10.0, 50.0, true, 0.0);
    ctFrame(&d, ord, 1000, uids);
    d.simInput(10.0, 50.0, false, 0.0);
    ctFrame(&d, ord, 1000, uids);
    ok(CT_CLICK == (int((50.0 + sy) / 20.0) - 1) * 10, "click after scrolling hits the row under the mouse");
    // reorder (reverse) and remove one row
    for i in 0..1000 {
        ord[i] = 999 - i;
    }
    ctFrame(&d, ord, 1000, uids);
    let r1 = kid(&d, g, 1);
    let ok3 = nx(&d, kid(&d, r1, 1)) == 360.0 && nw(&d, kid(&d, r1, 0)) == 360.0;
    ok(ok3, "reordered rows keep the shared columns");
    for i in 0..999 {
        ord[i] = 998 - i;
    }
    d.groupFree(uids[999]);
    ctFrame(&d, ord, 999, uids);
    ok(kid(&d, g, 1000) < 0, "removed row is gone (999 rows + header)");
    near(d.nodes.items[g].contentH, 20000.0, 0.01, "content height after removal");
    // steady: idle frames cost nothing
    d.simInput(-5.0, -5.0, false, 0.0);
    ctFrame(&d, ord, 999, uids);
    ctFrame(&d, ord, 999, uids);
    let used0 = mem.used;
    let laid0 = d.laid;
    let re0 = d.restyled;
    for k in 0..300 {
        ctFrame(&d, ord, 999, uids);
    }
    ok(d.laid == laid0 && d.restyled == re0, "300 idle frames: 0 layouts, 0 style recomputes");
    ok(mem.used == used0, "300 idle frames: no arena growth");
    // N tracks
    let t = Dom.new(mem, &css);
    t.begin();
    el(&t, 0, "div", S_TEST, "w");
    for q in 0..6 {
        el(&t, q, "div", S_TEST, "c");
        t.close();
    }
    t.close();
    el(&t, 1, "div", S_TEST, "w2");
    for q in 0..5 {
        el(&t, q, "div", S_TEST, "c");
        t.close();
    }
    t.close();
    t.end();
    t.layoutAt(800.0, 600.0);
    let w = kid(&t, 0, 0);
    near(nx(&t, kid(&t, w, 5)), 150.0, 0.01, "six px tracks: column 5 x");
    near(nw(&t, kid(&t, w, 5)), 60.0, 0.01, "six px tracks: column 5 width");
    let w2 = kid(&t, 0, 1);
    near(nw(&t, kid(&t, w2, 0)), 80.0, 0.01, "fr tracks: 1fr of 400px over 5fr");
    near(nw(&t, kid(&t, w2, 2)), 160.0, 0.01, "fr tracks: 2fr");
    near(nx(&t, kid(&t, w2, 3)), 320.0, 0.01, "fr tracks: the 50px track x");
}

const CT2_CSS: string = ".t { display: grid; grid-template-columns: auto 50% 40px; width: 400px; } .r { display: contents; } .c { height: 20px; background: #000000; } .r:hover > .c { background: #ff0000; } .r.sel > .c { height: 30px; }";

#[singleton]
let CT2_TXT: string;

fn ct2Frame(d: &Dom, sel: bool) {
    d.beginFrame(Vec2 { x: 800.0, y: 400.0 });
    el(d, 0, "div", S_TEST, "t");
    for r in 0..3 {
        let rr = el(d, r, "div", S_TEST, "r");
        d.clsIf(rr, "sel", r == 1 && sel);
        el(d, 0, "div", S_TEST, "c");
        d.text(if r == 2 { CT2_TXT } else { "x" });
        d.close();
        el(d, 1, "div", S_TEST, "c");
        d.close();
        el(d, 2, "div", S_TEST, "c");
        d.close();
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

// display: contents outside a grid is a block: own box, own children, counted by the scroll extent
const CB_CSS: string = ".sb { display: block; width: 200px; height: 100px; overflow: auto; } .fx { display: flex; width: 300px; } .r { display: contents; width: 80px; height: 300px; margin-left: 50px; } .c { height: 20px; }";

fn testContentsBlock(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, CB_CSS, "cb.css", S_TEST);
    ok(css.warns.len == 0, "contents block css parses clean");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    for f in 0..2 {
        d.beginFrame(Vec2 { x: 800.0, y: 400.0 });
        el(&d, 0, "div", S_TEST, "sb");
        el(&d, 0, "div", S_TEST, "r");
        el(&d, 0, "div", S_TEST, "c");
        d.close();
        d.close();
        d.close();
        el(&d, 1, "div", S_TEST, "fx");
        el(&d, 0, "div", S_TEST, "r");
        el(&d, 0, "div", S_TEST, "c");
        d.close();
        d.close();
        d.close();
        d.layout();
        d.endFrame();
    }
    let sb = kid(&d, 0, 0);
    let r = kid(&d, sb, 0);
    near(nh(&d, r), 300.0, 0.01, "contents in a block parent has its own height");
    near(nw(&d, kid(&d, r, 0)), nw(&d, r), 0.01, "its child lies inside it");
    near(d.nodes.items[sb].contentH, 300.0, 0.01, "scroll extent covers a contents block");
    near(d.nodes.items[sb].contentW, 130.0, 0.01, "content width counts the contents block's own offset");
    let fx = kid(&d, 0, 1);
    let fr = kid(&d, fx, 0);
    near(nw(&d, fr), 80.0, 0.01, "contents in a flex parent is a box with its width");
    near(nw(&d, kid(&d, fr, 0)), 80.0, 0.01, "its child sits inside it");
}

fn testContents2(mem: &Arena) {
    let css = Css.new(mem);
    // text needs a font: the idle-breakout theme declares one
    let dir = "examples/idle-breakout/ui/";
    if !exists(`{dir}theme.css`) {
        dir = "../examples/idle-breakout/ui/";
    }
    parse(&css, load(mem, `{dir}theme.css`), `{dir}theme.css`, 0);
    // the real app puts its 15px text size on `.app` (theme.css has a 16px root, one rem); this tree has no `.app`
    parse(&css, "div { font-size: 0.9375rem; }", "app.css", 0);
    parse(&css, CT2_CSS, "ct2.css", S_TEST);
    ok(css.warns.len == 0, "contents2 css parses clean");
    FONTPATH = css.fonts.items[0].path;
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    CT2_TXT = "x";
    d.simInput(-5.0, -5.0, false, 0.0);
    ct2Frame(&d, false);
    ct2Frame(&d, false);
    let t = kid(&d, 0, 0);
    let r0 = kid(&d, t, 0);
    let r1 = kid(&d, t, 1);
    let r2 = kid(&d, t, 2);
    near(nx(&d, kid(&d, r0, 1)), tw(15, false, "x") + 0.0, 3.0, "auto track fits the widest cell text");
    near(nw(&d, kid(&d, r0, 1)), 200.0, 0.01, "50% track is half the container's content width");
    near(nx(&d, kid(&d, r0, 2)) + nw(&d, kid(&d, r0, 2)), nx(&d, kid(&d, r0, 1)) + 200.0 + 40.0, 0.01, "px track after the % track");
    // hover a cell: the contents row matches :hover and restyles its cells
    let cell = kid(&d, r0, 0);
    let st0 = d.nodes.items[cell].tstyle;
    d.simInput(2.0, 2.0, false, 0.0);
    ct2Frame(&d, false);
    ct2Frame(&d, false);
    ok(d.nodes.items[cell].tstyle != st0, ".row:hover > .cell restyles the cell through a contents row");
    ok(d.nodes.items[kid(&d, r0, 1)].tstyle != st0 && d.nodes.items[kid(&d, r1, 0)].tstyle == st0, "only the hovered row's cells restyle");
    d.simInput(-5.0, -5.0, false, 0.0);
    ct2Frame(&d, false);
    ct2Frame(&d, false);
    ok(d.nodes.items[cell].tstyle == st0, "hover off restores the cell style");
    // toggling a class on the contents row restyles its cells and relayouts the grid
    near(ny(&d, kid(&d, r2, 0)), 40.0, 0.01, "row 2 starts at 40");
    ct2Frame(&d, true);
    near(nh(&d, kid(&d, r1, 0)), 30.0, 0.01, ".row.sel > .cell changes the cell height");
    near(ny(&d, kid(&d, r2, 0)), 50.0, 0.01, "the grid relayouts: row 2 moves down by 10");
    ct2Frame(&d, false);
    near(ny(&d, kid(&d, r2, 0)), 40.0, 0.01, "class removed: row 2 moves back");
    // a text change inside one cell relayouts the container and widens the auto track
    let wBefore = nw(&d, kid(&d, r0, 0));
    CT2_TXT = "a much longer cell text";
    ct2Frame(&d, false);
    near(nw(&d, kid(&d, r0, 0)), tw(15, false, "a much longer cell text"), 3.0, "auto track follows the widest cell after a text change");
    ok(nw(&d, kid(&d, r0, 0)) > wBefore + 20.0, "auto track grew");
    near(nx(&d, kid(&d, r0, 1)), nw(&d, kid(&d, r0, 0)), 0.01, "later tracks shift with it");
    ct2Frame(&d, false);
    let used0 = mem.used;
    let laid0 = d.laid;
    let re0 = d.restyled;
    for k in 0..200 {
        ct2Frame(&d, false);
    }
    ok(d.laid == laid0 && d.restyled == re0 && mem.used == used0, "200 idle frames after the text change: 0 layouts, 0 restyles, no arena growth");
}
