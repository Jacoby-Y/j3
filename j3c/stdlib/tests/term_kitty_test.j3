// Tests for kitty graphics in j3.term.grid: APC parsing, direct RGBA / RGB / zlib transmit, chunks, replies and
// quiet, put, query, delete, scrolling with the text, ED and RIS.
//   timeout 120 j3c run j3c/stdlib/tests/term_kitty_test.j3
// Panics on the first failed check. In samples `@` is ESC and `~` is ST (ESC \).

module term_kitty_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;
use j3.term.ansi;
use j3.term.ansi.Parser;
use j3.term.grid.Grid;
use j3.text.Text;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn s(x: string, a: &Arena): string {
    let t = Text.new(a);
    for i in 0..x.len {
        if x[i] == 64 {
            t.push(27);
        } else if x[i] == 126 {
            t.push(27);
            t.push(92);
        } else {
            t.push(x[i]);
        }
    }
    return t.str();
}

fn main() {
    let a = Arena.create(16 * 1024 * 1024);
    let g = Grid.new(&a, 20, 5, 100);
    g.cellPxW = 1;
    g.cellPxH = 1;
    let p = Parser.new(&a);
    // 2x2 red RGBA, displayed: OK reply, a placement at the cursor, the cursor moves past it
    ansi.feed(&p, s("@_Ga=T,f=32,s=2,v=2,i=7;/wAA//8AAP//AAD//wAA/w==~", &a), &g);
    ok(g.reply.str() == s("@_Gi=7;OK~", &a), "transmit+display replies OK");
    g.reply.clear();
    ok(g.kittyPlacements().len == 1, "one placement");
    let pl = g.kittyPlacements()[0];
    ok(pl.row == 0 && pl.col == 0 && pl.cols == 2 && pl.rows == 2 && pl.dw == 2 && pl.dh == 2, "placed at the cursor, sized in cells");
    ok(g.cursorY() == 1 && g.cursorX() == 2, "cursor moved past the image");
    let im = g.kittyImage(pl.serial);
    ok(im.w == 2 && im.h == 2 && im.px[0] == 255 && im.px[1] == 0 && im.px[3] == 255, "pixels stored");
    // chunked RGB, quiet: no reply
    ansi.feed(&p, s("@_Ga=t,f=24,s=2,v=2,i=8,q=1,m=1;AP8AAP8A~@_Gm=0;AP8AAP8A~", &a), &g);
    ok(g.reply.len() == 0, "q=1 hides OK");
    let k = g.kittyImage(g.kittyPlacements()[0].serial + 1);
    ok(k.w == 2 && k.px[1] == 255 && k.px[3] == 255, "chunked RGB becomes RGBA");
    // zlib RGBA put with C=1 (cursor stays), then by placement id again (replaces it)
    ansi.feed(&p, s("@_Ga=T,f=32,o=z,s=2,v=2,i=9,p=3,C=1,c=4,r=1;eJxjYPj/nwEJAwA71Af5~", &a), &g);
    g.reply.clear();
    ok(g.cursorY() == 1 && g.cursorX() == 2, "C=1 keeps the cursor");
    ok(g.kittyPlacements().len == 2 && g.kittyPlacements()[1].cols == 4 && g.kittyPlacements()[1].dw == 4, "c/r size the box");
    ansi.feed(&p, s("@_Ga=p,i=9,p=3,C=1~", &a), &g);
    ok(g.reply.str() == s("@_Gi=9,p=3;OK~", &a) && g.kittyPlacements().len == 2, "same placement id replaces");
    g.reply.clear();
    // errors
    ansi.feed(&p, s("@_Ga=p,i=99~", &a), &g);
    ok(g.reply.str() == s("@_Gi=99;ENOENT:no such image~", &a), "put of a missing image");
    g.reply.clear();
    ansi.feed(&p, s("@_Ga=q,f=32,s=5,v=5,i=31;AAAA~", &a), &g);
    ok(g.reply.len() > 0 && g.reply.str()[g.reply.len() - 3] != 75, "query with short data is an error");
    g.reply.clear();
    ansi.feed(&p, s("@_Ga=q,f=24,s=2,v=2,i=31;AP8AAP8AAP8AAP8A~", &a), &g);
    ok(g.reply.str() == s("@_Gi=31;OK~", &a), "query OK");
    g.reply.clear();
    // scrolling: placements move with the text into scrollback
    for i in 0..4 {
        ansi.feed(&p, "\n", &g);
    }
    ok(g.kittyPlacements()[0].row == 0 - 1, "placement scrolled up one row");
    // delete by id (uppercase frees the image)
    ansi.feed(&p, s("@_Ga=d,d=I,i=9~", &a), &g);
    ok(g.kittyPlacements().len == 1, "delete by id");
    ok(g.kittyImage(k.serial + 1).w == 0, "uppercase frees the image");
    // ED 2 clears placements on the screen; RIS frees everything
    ansi.feed(&p, s("@[2J", &a), &g);
    ansi.feed(&p, s("@_Ga=p,i=7~", &a), &g);
    g.reply.clear();
    ok(g.kittyPlacements().len == 1, "put again after clear");
    ansi.feed(&p, s("@c", &a), &g);
    ok(g.kittyPlacements().len == 0 && g.kittyImage(pl.serial).w == 0, "RIS frees all");
    // other APC strings are ignored; text after keeps printing
    ansi.feed(&p, s("@_Xnope~hi", &a), &g);
    ok(g.cell(0, 0).cp == 104 && g.cell(1, 0).cp == 105, "non-G APC dropped, text continues");
    printLn("term_kitty_test ok");
}
