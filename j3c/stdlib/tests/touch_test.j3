// Touch fingers, app lifecycle and the Back key in j3.game, driven by real SDL events: they are pushed with
// SDL_PushEvent and read back through the normal `game.poll` path. Never opens a visible window:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/touch_test.j3
// Panics on the first failed check. Layouts are from SDL 2.32 SDL_events.h: a finger event has 64-bit
// touchId (offset 8) and fingerId (16), then x y dx dy pressure floats from 24; a key event has its scancode at 16.

module touch_test;

use j3.game;
use j3.game.Mouse;
use j3.io.printLn;
use j3.math.abs;
use j3.sys.panic;

use lib "SDL2" as sdl {
    fn SDL_PushEvent(event: ptr): i32;
}

struct Finger {
    ty: u32;
    timestamp: u32;
    touchId: int;
    fingerId: int;
    x: f32;
    y: f32;
    dx: f32;
    dy: f32;
    pressure: f32;
    windowID: u32;
}

struct Key {
    ty: u32;
    timestamp: u32;
    windowID: u32;
    state: u8;
    repeat: u8;
    pad2: u8;
    pad3: u8;
    scancode: i32;
    sym: i32;
}

// SDL_Event is 56 bytes; the buffer is bigger so a push never reads past it.
#[singleton]
let BUF: [8]int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("touch_test");
    }
}

fn near(a: f32, b: f32): bool {
    return abs(a - b) < 0.5;
}

fn finger(ty: u32, id: int, x: f32, y: f32) {
    let i = 0;
    while i < 8 { BUF[i] = 0; i += 1; }
    let e = &BUF[0] as ptr as &Finger;
    e.ty = ty;
    e.fingerId = id;
    e.x = x;
    e.y = y;
    ok(sdl.SDL_PushEvent(&BUF[0] as ptr) == 1, "push finger");
}

fn plain(ty: u32) {
    let i = 0;
    while i < 8 { BUF[i] = 0; i += 1; }
    let e = &BUF[0] as ptr as &Finger;
    e.ty = ty;
    ok(sdl.SDL_PushEvent(&BUF[0] as ptr) == 1, "push event");
}

// SDL_MouseButtonEvent: type, timestamp, windowID, which (4 bytes each), then button at 16.
fn button(ty: u32, b: u8) {
    let i = 0;
    while i < 8 { BUF[i] = 0; i += 1; }
    let e = &BUF[0] as ptr as &Key;
    e.ty = ty;
    let bytes: []u8 = []u8 { ptr: &BUF[0] as ptr as &u8, len: 64 };
    bytes[16] = b;
    ok(sdl.SDL_PushEvent(&BUF[0] as ptr) == 1, "push button");
}

fn back(repeat: u8) {
    let i = 0;
    while i < 8 { BUF[i] = 0; i += 1; }
    let e = &BUF[0] as ptr as &Key;
    e.ty = 0x300;
    e.state = 1;
    e.repeat = repeat;
    e.scancode = 270;
    e.sym = 1073742094;
    ok(sdl.SDL_PushEvent(&BUF[0] as ptr) == 1, "push back");
}

fn main() {
    game.initGlHidden("touch checks", 400, 300);
    game.poll();
    ok(game.fingerCount() == 0 && !game.backgrounded(), "starts empty");
    ok(game.finger(0).id == -1, "no finger 0");

    // down -> held -> up -> gone, one frame each
    finger(0x700, 7, 0.5, 0.5);
    game.poll();
    ok(game.fingerCount() == 1, "one finger down");
    let f = game.finger(0);
    ok(f.id == 7 && f.down && f.held && !f.up, "down frame flags");
    let w = game.windowSize();
    ok(near(f.x, w.x * 0.5) && near(f.y, w.y * 0.5), "unletterboxed position");
    game.poll();
    f = game.finger(0);
    ok(f.id == 7 && !f.down && f.held && !f.up, "held frame flags");
    finger(0x702, 7, 0.25, 0.5);
    game.poll();
    f = game.finger(0);
    ok(f.held && near(f.x, w.x * 0.25), "motion moves it");
    finger(0x701, 7, 0.25, 0.5);
    game.poll();
    f = game.finger(0);
    ok(game.fingerCount() == 1 && f.up && !f.held && !f.down, "up frame flags");
    game.poll();
    ok(game.fingerCount() == 0, "gone after the up frame");

    // two fingers, then ten more: the extra ones are dropped, none crash
    finger(0x700, 1, 0.1, 0.1);
    finger(0x700, 2, 0.9, 0.9);
    game.poll();
    ok(game.fingerCount() == 2 && game.finger(0).id == 1 && game.finger(1).id == 2, "two fingers");
    finger(0x701, 1, 0.1, 0.1);
    game.poll();
    ok(game.fingerCount() == 2 && game.finger(0).up && game.finger(1).held && !game.finger(1).up, "one lifts");
    game.poll();
    ok(game.fingerCount() == 1 && game.finger(0).id == 2, "the other stays");
    let n = 10;
    while n < 22 { finger(0x700, n, 0.5, 0.5); n += 1; }
    game.poll();
    ok(game.fingerCount() == 10, "capacity is 10");
    n = 0;
    while n < 22 { finger(0x701, n, 0.5, 0.5); n += 1; }
    game.poll();
    game.poll();
    ok(game.fingerCount() == 0, "all gone");

    // the same id lifts and goes down again inside one frame: one held finger, not lost
    finger(0x700, 5, 0.5, 0.5);
    game.poll();
    finger(0x701, 5, 0.5, 0.5);
    finger(0x700, 5, 0.2, 0.5);
    game.poll();
    ok(game.fingerCount() == 2, "old slot (up) and the new touch");
    ok(game.finger(0).up && game.finger(1).down && game.finger(1).held && game.finger(1).id == 5, "up then down flags");
    game.poll();
    ok(game.fingerCount() == 1 && game.finger(0).id == 5 && game.finger(0).held && !game.finger(0).down, "one held finger next frame");
    finger(0x701, 5, 0.2, 0.5);
    game.poll();
    game.poll();
    ok(game.fingerCount() == 0, "and it lifts normally");

    // a tap whose down and up land in one pump (adb `input tap`, quick touch-to-mouse) still clicks
    button(0x401, 1);
    button(0x402, 1);
    game.poll();
    ok(game.mousePressed(Mouse.Left) && game.mouseDown(Mouse.Left), "same-pump tap pressed");
    game.poll();
    ok(game.mouseReleased(Mouse.Left) && !game.mouseDown(Mouse.Left), "released the next frame");
    game.poll();
    ok(!game.mouseReleased(Mouse.Left) && !game.mousePressed(Mouse.Left), "then idle");

    // letterbox: 200x100 virtual in 400x300 is 400x200 with bars of 50, scale 2
    game.setVirtualSize(200, 100);
    finger(0x700, 3, 0.5, 0.5);
    game.poll();
    f = game.finger(0);
    ok(near(f.x, 100) && near(f.y, 50), "window center is virtual center");
    finger(0x702, 3, 0.25, 0.5);
    game.poll();
    f = game.finger(0);
    ok(near(f.x, 50) && near(f.y, 50), "quarter across is 50 virtual");
    finger(0x702, 3, 0.5, 0.05);
    game.poll();
    ok(game.finger(0).y < 0, "a finger in the top bar is negative, like the mouse");
    finger(0x701, 3, 0.5, 0.5);
    game.poll();
    game.poll();
    game.setVirtualSize(0, 0);

    // lifecycle
    plain(0x103);
    game.poll();
    ok(game.backgrounded(), "will enter background");
    game.waitBackground();
    ok(game.backgrounded(), "still backgrounded after a wait");
    plain(0x106);
    game.poll();
    ok(!game.backgrounded(), "did enter foreground");
    plain(0x104);
    game.poll();
    ok(game.backgrounded(), "did enter background");
    plain(0x105);
    game.poll();
    ok(!game.backgrounded(), "will enter foreground");
    plain(0x102);
    game.poll();
    ok(!game.quitRequested(), "low memory does not quit");

    // Back off Android is ignored (some desktop keyboards and mice send the scancode)
    game.holdClose(true);
    back(0);
    game.poll();
    ok(!game.closeRequested() && !game.quitRequested(), "back ignored off Android");
    game.holdClose(false);
    game.backKeyAnywhere(true);

    // Back: a close request under holdClose, else quit; a key repeat is ignored
    game.holdClose(true);
    back(1);
    game.poll();
    ok(!game.closeRequested() && !game.quitRequested(), "repeat ignored");
    back(0);
    game.poll();
    ok(game.closeRequested() && !game.quitRequested(), "back asks under holdClose");
    game.poll();
    ok(!game.closeRequested(), "the ask lasts one frame");
    game.holdClose(false);
    back(0);
    game.poll();
    ok(game.quitRequested(), "back quits without holdClose");

    plain(0x101);
    game.poll();
    ok(game.quitRequested(), "terminating quits");
    printLn("touch_test ok");
    game.destroy();
}
