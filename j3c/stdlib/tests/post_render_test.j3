// GL backdrop integration checks. Never opens a visible window:
// SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy J3_STDLIB=$PWD/j3c/stdlib timeout 60 j3c run j3c/stdlib/tests/post_render_test.j3
// Writes /tmp/j3-post-render.png and /tmp/j3-post-resize.png for visual review.
module post_render_test;

use lib "GL" as gl { fn glGetError(): u32; }
use j3.game;
use j3.game.Color;
use j3.gfx.paint;
use j3.gfx.paint.{ Corners, Stop };
use j3.gfx.canvas.{ Canvas, Mode };
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.result.Result;
use j3.sys.panic;

fn ok(b: bool, msg: string) { if !b { panic(msg); } }
fn gi(key: u32): i32 {
    let get = game.glProc("glGetIntegerv") as fn(u32, ptr);
    let v: i32 = 0; get(key, &v as ptr); return v;
}
fn noError() {
    let err = game.glProc("glGetError") as fn(): u32;
    let e = err();
    if e != 0 { printLn(`GL error: {e}`); panic("GL operation failed"); }
}
fn corners(): Corners { return Corners { tl: 24, tr: 24, br: 24, bl: 24 }; }
fn stripes(w: int, h: int) {
    for i in 0..w / 4 {
        let c = Color { r: 240, g: 70, b: 40, a: 255 };
        if i % 2 == 0 { c = Color { r: 20, g: 100, b: 240, a: 255 }; }
        paint.rect(Vec2 { x: f32(i * 4), y: 0 }, Vec2 { x: 4, y: f32(h) }, c);
    }
    paint.flush();
}
fn save(mem: &Arena, path: string, w: int, h: int) {
    let c = Canvas.create(mem, i32(w), i32(h), Mode.Pixel);
    ok(game.readWindow(c.pixels), "read screenshot");
    match c.savePng(path, mem) { Result.Ok(_) {} Result.Err(_) { panic("save screenshot"); } }
}
fn variance(p: []u8, w: int, y: int, x: int): int {
    let lo = 255; let hi = 0;
    for i in 0..64 {
        let v = int(p[(y * w + x + i) * 4]);
        if v < lo { lo = v; } if v > hi { hi = v; }
    }
    return hi - lo;
}
fn main() {
    let mem = Arena.create(8 * 1024 * 1024);
    game.initGlHidden("backdrop checks", 480, 320);
    game.clearTo(Color { r: 10, g: 10, b: 10, a: 255 });
    stripes(480, 320);
    let before = mem.alloc::<u8>(480 * 320 * 4);
    ok(game.readWindow(before), "read sharp frame");
    paint.backdropBlur(Vec2 { x: 16, y: 20 }, Vec2 { x: 200, y: 220 }, corners(), 0);
    paint.backdropBlur(Vec2 { x: 16, y: 20 }, Vec2 { x: 200, y: 220 }, corners(), -1);
    let after = mem.alloc::<u8>(480 * 320 * 4);
    ok(game.readWindow(after), "read zero radius frame");
    for i in 0..after.len { ok(after[i] == before[i], "zero/negative radius is no-op"); }
    paint.backdropBlur(Vec2 { x: 16, y: 20 }, Vec2 { x: 200, y: 220 }, corners(), 12);
    paint.backdropBlur(Vec2 { x: 248, y: 20 }, Vec2 { x: 200, y: 220 }, corners(), 64);
    ok(game.readWindow(after), "read blurred frame");
    ok(variance(before, 480, 100, 64) > 200, "sharp control has contrast");
    ok(variance(after, 480, 100, 64) < 8, "sigma 12 removes stripe contrast");
    ok(variance(after, 480, 100, 280) < 8, "sigma 64 prefilter avoids sparse tap aliasing");
    ok(after[(20 * 480 + 16) * 4] == before[(20 * 480 + 16) * 4], "rounded corner retains backdrop");
    // Crisp foreground geometry, an alpha/clip panel and an affine panel in the sharp strip.
    paint.rect(Vec2 { x: 40, y: 60 }, Vec2 { x: 150, y: 4 }, Color { r: 255, g: 255, b: 255, a: 255 });
    paint.rect(Vec2 { x: 272, y: 60 }, Vec2 { x: 150, y: 4 }, Color { r: 255, g: 255, b: 255, a: 255 });
    paint.pushClip(Vec2 { x: 30, y: 258 }, Vec2 { x: 140, y: 48 });
    paint.pushAlpha(0.5);
    paint.backdropBlur(Vec2 { x: 16, y: 250 }, Vec2 { x: 200, y: 60 }, corners(), 8);
    paint.popAlpha(); paint.popClip();
    paint.pushRotate(Vec2 { x: 350, y: 280 }, 0.12);
    paint.backdropBlur(Vec2 { x: 250, y: 254 }, Vec2 { x: 200, y: 50 }, corners(), 8);
    paint.popTransform(); paint.flush();
    save(&mem, "/tmp/j3-post-render.png", 480, 320);
    noError();
    // A local view samples the same physical backdrop, while its gradient mask controls coverage.
    stripes(480, 320);
    let stops: [4]Stop = [
        Stop { at: 0, color: Color { r: 255, g: 255, b: 255, a: 0 } },
        Stop { at: 0.4, color: Color { r: 255, g: 255, b: 255, a: 0 } },
        Stop { at: 0.6, color: Color { r: 255, g: 255, b: 255, a: 255 } },
        Stop { at: 1, color: Color { r: 255, g: 255, b: 255, a: 255 } }
    ];
    let row = paint.gradient([]Stop { ptr: &stops[0], len: 4 });
    paint.pushView(Vec2 { x: 60, y: 40 }, Vec2 { x: 240, y: 160 });
    paint.pushMask(1, row, 1.5707963, Vec2 { x: 10, y: 10 }, Vec2 { x: 200, y: 120 });
    paint.backdropBlur(Vec2 { x: 10, y: 10 }, Vec2 { x: 200, y: 120 }, corners(), 12);
    paint.popMask(); paint.popView();
    ok(game.readWindow(after), "read masked view");
    ok(variance(after, 480, 100, 76) > 180, "transparent mask retains sharp stripes in subview");
    ok(variance(after, 480, 100, 196) < 8, "opaque mask applies blur in subview");
    ok(variance(after, 480, 100, 330) > 200, "pixels outside subview remain sharp");
    save(&mem, "/tmp/j3-post-mask-view.png", 480, 320);
    noError();
    // A raw caller's viewport, program, VAO, texture unit, scissor, blend and enables survive.
    let vp = game.glProc("glViewport") as fn(i32, i32, i32, i32);
    let sc = game.glProc("glScissor") as fn(i32, i32, i32, i32);
    let en = game.glProc("glEnable") as fn(u32);
    let dis = game.glProc("glDisable") as fn(u32);
    let active = game.glProc("glActiveTexture") as fn(u32);
    let useProg = game.glProc("glUseProgram") as fn(u32);
    let blend = game.glProc("glBlendFuncSeparate") as fn(u32, u32, u32, u32);
    vp(7, 9, 100, 80); sc(11, 13, 60, 40);
    en(0x0C11); en(0x0BE2); en(0x0B90); dis(0x0B71);
    active(0x84C3); useProg(0); blend(1, 0, 0, 1);
    paint.backdropBlur(Vec2 { x: 16, y: 20 }, Vec2 { x: 200, y: 220 }, corners(), 4);
    ok(gi(0x8B8D) == 0 && gi(0x84E0) == 0x84C3, "program and active texture restored");
    ok(gi(0x80C9) == 1 && gi(0x80C8) == 0 && gi(0x80CB) == 0 && gi(0x80CA) == 1, "separate blend factors restored");
    let enabled = game.glProc("glIsEnabled") as fn(u32): u8;
    ok(enabled(0x0C11) != 0 && enabled(0x0BE2) != 0 && enabled(0x0B90) != 0 && enabled(0x0B71) == 0, "GL enables restored");
    let rect: [4]i32 = [0, 0, 0, 0];
    let get = game.glProc("glGetIntegerv") as fn(u32, ptr);
    get(0x0BA2, &rect[0] as ptr);
    ok(rect[0] == 7 && rect[1] == 9 && rect[2] == 100 && rect[3] == 80, "viewport restored");
    get(0x0C10, &rect[0] as ptr);
    ok(rect[0] == 11 && rect[1] == 13 && rect[2] == 60 && rect[3] == 40, "scissor restored");
    dis(0x0C11); dis(0x0BE2); dis(0x0B90); active(0x84C0);
    noError();
    // A user framebuffer is captured and restored, rather than accidentally sampling window 0.
    let gen = game.glProc("glGenTextures") as fn(i32, ptr);
    let tex: u32 = 0; gen(1, &tex as ptr);
    let bindTex = game.glProc("glBindTexture") as fn(u32, u32); bindTex(0x0DE1, tex);
    let image = game.glProc("glTexImage2D") as fn(u32, i32, i32, i32, i32, i32, u32, u32, ptr);
    image(0x0DE1, 0, 0x8058, 480, 320, 0, 0x1908, 0x1401, 0 as ptr);
    let fb: u32 = 0;
    let genFb = game.glProc("glGenFramebuffers") as fn(i32, ptr); genFb(1, &fb as ptr);
    let bindFb = game.glProc("glBindFramebuffer") as fn(u32, u32); bindFb(0x8D40, fb);
    let attach = game.glProc("glFramebufferTexture2D") as fn(u32, u32, u32, u32, i32);
    attach(0x8D40, 0x8CE0, 0x0DE1, tex, 0);
    stripes(480, 320);
    paint.backdropBlur(Vec2 { x: 16, y: 20 }, Vec2 { x: 200, y: 220 }, corners(), 12);
    ok(gi(0x8CA6) == i32(fb) && gi(0x8CAA) == i32(fb), "user framebuffer bindings restored");
    let read = game.glProc("glReadPixels") as fn(i32, i32, i32, i32, u32, u32, ptr);
    read(0, 0, 480, 320, 0x1908, 0x1401, after.ptr as ptr);
    ok(variance(after, 480, 160, 64) < 8, "blur samples current user framebuffer");
    noError();
    // SDL's offscreen window surface has a fixed drawable size. Resize a real user color
    // attachment alongside the cached window dimensions to exercise target reallocation.
    game.setWindowSize(640, 360);
    bindTex(0x0DE1, tex);
    image(0x0DE1, 0, 0x8058, 640, 360, 0, 0x1908, 0x1401, 0 as ptr);
    game.clearTo(Color { r: 10, g: 10, b: 10, a: 255 }); stripes(640, 360);
    paint.backdropBlur(Vec2 { x: 32, y: 24 }, Vec2 { x: 576, y: 312 }, corners(), 12);
    let resized = Canvas.create(&mem, 640, 360, Mode.Pixel);
    read(0, 0, 640, 360, 0x1908, 0x1401, resized.pixels.ptr as ptr);
    ok(variance(resized.pixels, 640, 180, 64) < 8, "resized target blurs new framebuffer dimensions");
    // This fixture is vertically symmetric, so raw GL row order is the same review image.
    match resized.savePng("/tmp/j3-post-resize.png", &mem) { Result.Ok(_) {} Result.Err(_) { panic("save resize"); } }
    bindFb(0x8D40, 0);
    let delFb = game.glProc("glDeleteFramebuffers") as fn(i32, ptr); delFb(1, &fb as ptr);
    let delTex = game.glProc("glDeleteTextures") as fn(i32, ptr); delTex(1, &tex as ptr);
    noError();
    game.destroy();
    mem.destroy();
    printLn("post_render_test: passed (zero radius, blur contrast, rounded edges, multiple panels, transforms, masks, subviews, GL state, user framebuffer, resize, teardown)");
}
