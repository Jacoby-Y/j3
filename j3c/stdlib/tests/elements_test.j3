// Tests for `<br>`, `<progress>`, `<meter>`, `<details>` / `<summary>` through j3.ui.dom: br breaks lines in normal and nowrap text
// (and adds nothing at the end of a block), progress fill fraction and the indeterminate sweep (still under reduced motion), meter
// color regions, details toggled by click and by Enter, bind-style write-back, children kept mounted across close and open, `:open`
// restyle, the a11y roles and states, and idle frames that cost nothing. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/elements_test.j3
// Panics on the first failed check.

module elements_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ contains, same, Text };
use j3.ui.a11y;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.testkit;
use j3.ui.uastyle;
use j3.ui.textsel;

#[singleton]
let CHECKS: int;
#[singleton]
let ID: [16]int;
// br scene: the text before / after / between, and the class of the box
#[singleton]
let BRS: int;
#[singleton]
let BRCLS: string;
// gauges
#[singleton]
let PV: f32;
#[singleton]
let MV: f32;
// the second progress gets a value
#[singleton]
let NOIND: bool;
// details
#[singleton]
let OPEN: bool;
#[singleton]
let TOGGLES: int;
#[singleton]
let BODY: bool;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    CHECKS += 1;
    let diff = a - b;
    if diff < 0.0 { diff = 0.0 - diff; }
    if diff > tol {
        printLn(`FAIL: {msg}: got {a}, want {b}`);
        panic(msg);
    }
}

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, summary, p { font-family: \"T\"; font-size: 16px; } .box { width: 400px; } .nw { white-space: nowrap; } .sel { user-select: text; } .hud { --j3-meter-bad: #ff00aa; } .p { width: 100px; } .m { width: 100px; } details { width: 100px; } details:open { width: 200px; } details:open > summary { width: 77px; } summary { width: 50px; }";

/// The same sheet after a hot reload: the `.hud` meters turn green.
const SHEET2: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, span, summary, p { font-family: \"T\"; font-size: 16px; } .box { width: 400px; } .nw { white-space: nowrap; } .sel { user-select: text; } .hud { --j3-meter-bad: #00ff00; } .p { width: 100px; } .m { width: 100px; } details { width: 100px; } details:open { width: 200px; } details:open > summary { width: 77px; } summary { width: 50px; }";

// ---- br ----------------------------------------------------------------------------------------------

/// 0: `ab cd`; 1: `ab<br>cd`; 2: `ab<br>` ; 3: `ab<br><br>cd`; 4: `<br>`
fn brFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let b = d.open(0, d.tag("div"), 1);
    d.cls(b, "box");
    if BRCLS.len > 0 { d.cls(b, BRCLS); }
    ID[0] = b;
    if BRS == 4 {
        d.open(0, d.tag("br"), 1);
        d.close();
    } else {
        d.text("ab");
        if BRS == 0 {
            d.text(" cd");
        } else {
            d.open(0, d.tag("br"), 1);
            d.close();
            if BRS == 3 {
                d.open(1, d.tag("br"), 1);
                d.close();
            }
            if BRS != 2 {
                d.text("cd");
            }
        }
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn brHeight(d: &Dom, kind: int, cls: string): f32 {
    BRS = kind;
    BRCLS = cls;
    brFrame(d);
    brFrame(d);
    return d.nodes.items[ID[0]].h;
}

fn testBr(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    let one = brHeight(&d, 0, "");
    ok(one > 8.0, "a line has a height");
    near(brHeight(&d, 1, ""), 2.0 * one, 0.6, "br breaks the line in normal text");
    near(brHeight(&d, 1, "nw"), 2.0 * one, 0.6, "br breaks the line under nowrap too");
    near(brHeight(&d, 2, ""), one, 0.6, "a trailing br adds no line");
    near(brHeight(&d, 3, ""), 3.0 * one, 0.6, "two br leave an empty line");
    near(brHeight(&d, 4, ""), one, 0.6, "a lone br is one line");
    // static selection copy gets a newline at the br
    brHeight(&d, 1, "sel");
    d.simKeys("", "C+a");
    brFrame(&d);
    brFrame(&d);
    ok(same(textsel.selected(&d), "ab\ncd"), "copy of a<br>b is a newline");
    brHeight(&d, 3, "sel");
    d.simKeys("", "C+a");
    brFrame(&d);
    brFrame(&d);
    ok(same(textsel.selected(&d), "ab\ncd"), "two br copy as one newline between the texts");
}

// ---- gauges ------------------------------------------------------------------------------------------

fn gaugeFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    let p = d.open(0, d.tag("progress"), 1);
    d.cls(p, "p");
    d.attrValue(p, PV);
    d.attrMax(p, 2.0);
    ID[1] = p;
    d.close();
    let ind = d.open(1, d.tag("progress"), 1);
    d.attrValue(ind, if NOIND { 0.5 } else { -1.0 });
    d.attrMax(ind, 1.0);
    ID[2] = ind;
    d.close();
    let hud = d.open(4, d.tag("div"), 1);
    d.cls(hud, "hud");
    let m2 = d.open(0, d.tag("meter"), 1);
    d.attrValue(m2, 1.0);
    d.attrMax(m2, 10.0);
    d.attrMeter(m2, 0, 3.0);
    d.attrMeter(m2, 1, 7.0);
    d.attrMeter(m2, 2, 10.0);
    ID[8] = m2;
    d.close();
    d.close();
    let m = d.open(2, d.tag("meter"), 1);
    d.cls(m, "m");
    d.attrValue(m, MV);
    d.attrMin(m, 0.0);
    d.attrMax(m, 10.0);
    d.attrMeter(m, 0, 3.0);
    d.attrMeter(m, 1, 7.0);
    d.attrMeter(m, 2, 10.0);
    ID[3] = m;
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn testGauges(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    PV = 0.5;
    MV = 9.0;
    gaugeFrame(&d);
    gaugeFrame(&d);
    near(d.nodes.items[ID[1]].w, 100.0, 0.1, "a progress takes its width");
    near(d.nodes.items[ID[1]].h, 8.0, 0.1, "and the default 8px height");
    near(d.nodes.items[ID[2]].w, 160.0, 0.1, "the default width is 160");
    near(dom.gaugeFrac(&d, ID[1]), 0.25, 0.001, "progress fill is value / max");
    PV = 5.0;
    gaugeFrame(&d);
    near(dom.gaugeFrac(&d, ID[1]), 1.0, 0.001, "and never more than the track");
    near(dom.gaugeFrac(&d, ID[2]), -1.0, 0.001, "no value is indeterminate");
    near(dom.gaugeFrac(&d, ID[3]), 0.9, 0.001, "meter fill is (value - min) / (max - min)");

    // meter: low 3, high 7, optimum 10 (the high region is best)
    ok(dom.meterGrade(&d, ID[3]) == 0, "a value in the optimum region is good");
    MV = 5.0;
    gaugeFrame(&d);
    ok(dom.meterGrade(&d, ID[3]) == 1, "the middle region next to the optimum is ok");
    MV = 1.0;
    gaugeFrame(&d);
    ok(dom.meterGrade(&d, ID[3]) == 2, "the far region is bad");

    // colors: the UA defaults, and a `--j3-meter-bad` set on an ancestor reaches the meter below it only
    ok(dom.meterFill(&d, ID[3], d.nodes.items[ID[3]].style) == 4166076927, "a bad meter has the default bad color");
    ok(dom.meterGrade(&d, ID[8]) == 2, "the scoped meter is bad too");
    ok(dom.meterFill(&d, ID[8], d.nodes.items[ID[8]].style) == 4278233855, "a scoped --j3-meter-bad overrides it");
    MV = 9.0;
    gaugeFrame(&d);
    ok(dom.meterFill(&d, ID[3], d.nodes.items[ID[3]].style) == 1069109503, "a good meter has the default good color");

    // indeterminate: the bar moves with time, and rests under reduced motion
    let x0 = dom.sweepX(&d, 160.0, 64.0);
    gaugeFrame(&d);
    gaugeFrame(&d);
    gaugeFrame(&d);
    let x1 = dom.sweepX(&d, 160.0, 64.0);
    ok(x0 != x1, "the indeterminate bar sweeps");
    ok(d.isLive(), "a visible indeterminate progress keeps the page live");
    d.setReducedMotion(true);
    gaugeFrame(&d);
    gaugeFrame(&d);
    ok(!d.isLive(), "not under reduced motion");
    d.setReducedMotion(false);
    gaugeFrame(&d);
    gaugeFrame(&d);
    ok(d.isLive(), "live again");
    NOIND = true;
    gaugeFrame(&d);
    gaugeFrame(&d);
    ok(!d.isLive(), "idle once the progress has a value");
    NOIND = false;
    gaugeFrame(&d);
    ok(d.isLive(), "and live when it loses it");
    d.setReducedMotion(true);
    gaugeFrame(&d);
    near(dom.sweepX(&d, 160.0, 64.0), 48.0, 0.01, "under reduced motion it sits in the middle");
    gaugeFrame(&d);
    near(dom.sweepX(&d, 160.0, 64.0), 48.0, 0.01, "and stays");
    d.setReducedMotion(false);

    // a11y
    gaugeFrame(&d);
    let t = Text.new(mem);
    a11y.dump(&d, mem, &t);
    let s = t.str();
    ok(contains(s, "progressbar"), "progress has the progressbar role");
    ok(contains(s, "meter"), "meter has the meter role");
    ok(contains(s, "now=1"), "a meter value is exposed");

    // idle frames cost nothing
    gaugeFrame(&d);
    let r0 = d.restyled;
    let l0 = d.laid;
    for i in 0..10 {
        gaugeFrame(&d);
    }
    ok(d.restyled == r0 && d.laid == l0, "idle gauge frames neither restyle nor lay out");

    // hot reload: style ids restart, the cached meter colors must follow the new sheet
    ok(dom.meterFill(&d, ID[8], d.nodes.items[ID[8]].style) == 4278233855, "before the reload");
    css.reset();
    uastyle.load(css);
    parse(css, SHEET2, "elements.css", 1);
    d.restyle();
    gaugeFrame(&d);
    gaugeFrame(&d);
    ok(dom.meterFill(&d, ID[8], d.nodes.items[ID[8]].style) == 16711935, "after the reload the scoped color is the new one");
}

// ---- details -----------------------------------------------------------------------------------------

/// `<details>` with a summary and a body div holding an input; OPEN is bound the way `bind:open` generates it.
fn detailsFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let det = d.open(0, d.tag("details"), 1);
    ID[4] = det;
    if d.userToggled(det) {
        OPEN = d.isOpen(det);
    }
    if d.toggled(det) {
        TOGGLES += 1;
    }
    d.attrOpen(det, OPEN);
    let sm = d.open(0, d.tag("summary"), 1);
    d.attrTabIndex(sm);
    d.attrDraggable(sm, true);
    ID[5] = sm;
    d.text("Sum");
    d.close();
    let body = d.open(1, d.tag("div"), 1);
    ID[6] = body;
    let ip = d.open(0, d.tag("input"), 1);
    d.attrType(ip, "text");
    ID[7] = ip;
    d.close();
    d.text("body text");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn step(d: &Dom, x: f32, y: f32, down: bool) {
    d.simInput(x, y, down, 0.0);
    detailsFrame(d);
}

fn clickSummary(d: &Dom, f0: int) {
    for f in f0..f0 + 3 {
        testkit.click(d, f, f0, ID[5]);
        detailsFrame(d);
    }
}

fn testDetails(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    OPEN = false;
    TOGGLES = 0;
    detailsFrame(&d);
    detailsFrame(&d);
    ok(!d.isOpen(ID[4]), "closed at first");
    ok(d.nodes.items[ID[6]].disp == dom.DP_NONE, "a closed details hides its content");
    ok(d.nodes.items[ID[5]].disp != dom.DP_NONE, "but shows its summary");
    near(d.nodes.items[ID[4]].w, 100.0, 0.1, "closed style");
    ok(d.nodes.items[ID[6]].kind == dom.K_ELEM && d.nodes.items[ID[7]].kind == dom.K_ELEM, "the content stays mounted");

    // a click on the summary opens it, writes OPEN back, and fires the toggle once
    clickSummary(&d, 2);
    detailsFrame(&d);
    ok(d.isOpen(ID[4]) && OPEN, "a click opens it and the bound variable follows");
    ok(TOGGLES == 1, "one toggle event");
    ok(d.nodes.items[ID[6]].disp != dom.DP_NONE, "the content shows");
    near(d.nodes.items[ID[4]].w, 200.0, 0.1, ":open restyles the details");
    near(d.nodes.items[ID[5]].w, 77.0, 0.1, ":open > summary restyles the summary");
    near(d.nodes.items[ID[6]].h, d.nodes.items[ID[7]].h + d.nodes.items[ID[6]].h - d.nodes.items[ID[7]].h, 0.1, "body is laid out");
    ok(d.nodes.items[ID[6]].h > 0.0, "the body has a height once open");

    // the content keeps its state across close and open: same nodes, same text
    let body = ID[6];
    let ip = ID[7];
    OPEN = false;
    detailsFrame(&d);
    ok(!d.isOpen(ID[4]) && d.nodes.items[body].disp == dom.DP_NONE, "the program closes it");
    near(d.nodes.items[ID[4]].w, 100.0, 0.1, "and :open stops matching");
    OPEN = true;
    detailsFrame(&d);
    ok(ID[6] == body && ID[7] == ip, "the same nodes come back");
    ok(d.isOpen(ID[4]) && d.nodes.items[body].disp != dom.DP_NONE, "the program opens it");

    detailsFrame(&d);
    ok(TOGGLES == 3, "the program's close and then its open each fired toggle once, a frame later");
    detailsFrame(&d);
    ok(TOGGLES == 3, "and nothing fires twice");

    // focus the summary, then Enter closes it, Space opens it
    d.focusNode(ID[5]);
    detailsFrame(&d);
    d.simKeys("", "Enter");
    detailsFrame(&d);
    detailsFrame(&d);
    ok(!d.isOpen(ID[4]) && !OPEN, "Enter on the focused summary closes it");
    ok(TOGGLES == 4, "one toggle for the key");
    d.simKeys("", "Space");
    detailsFrame(&d);
    detailsFrame(&d);
    ok(d.isOpen(ID[4]) && OPEN, "Space opens it");
    ok(TOGGLES == 5, "and one for Space");

    // a drag that starts on the summary never toggles it, nor does one that ends back on it
    detailsFrame(&d);
    let t0 = TOGGLES;
    let was = d.isOpen(ID[4]);
    let sx = d.absX(ID[5]) + 3.0;
    let sy = d.absY(ID[5]) + 3.0;
    step(&d, sx, sy, false);
    step(&d, sx, sy, true);
    step(&d, sx + 12.0, sy, true);
    step(&d, 300.0, 300.0, true);
    step(&d, 300.0, 300.0, false);
    step(&d, 300.0, 300.0, false);
    ok(TOGGLES == t0 && d.isOpen(ID[4]) == was, "a drag from the summary to elsewhere does not toggle");
    step(&d, sx, sy, false);
    step(&d, sx, sy, true);
    step(&d, sx + 12.0, sy, true);
    step(&d, sx + 30.0, sy, true);
    step(&d, sx + 30.0, sy, false);
    step(&d, sx + 30.0, sy, false);
    ok(TOGGLES == t0 && d.isOpen(ID[4]) == was, "a drag that ends on the summary does not toggle");
    step(&d, -5.0, -5.0, false);

    // focus: hidden content is not focusable, and closing drops the focus from it
    ok(dom.isFocusable(&d, ID[7]) == d.isOpen(ID[4]), "content is focusable only while open");
    OPEN = true;
    detailsFrame(&d);
    detailsFrame(&d);
    ok(dom.isFocusable(&d, ID[7]), "open: the input takes Tab");
    d.focusNode(ID[7]);
    detailsFrame(&d);
    ok(d.focus == ID[7], "focus is in the content");
    OPEN = false;
    detailsFrame(&d);
    ok(d.focus != ID[7] && !dom.isFocusable(&d, ID[7]), "closing drops the focus from the content at once");
    detailsFrame(&d);
    ok(d.focus < 0 || dom.styleVisible(&d, d.focus), "never a focused invisible node");
    OPEN = true;
    detailsFrame(&d);
    detailsFrame(&d);

    // a11y: summary is a button with its expanded state
    let t = Text.new(mem);
    a11y.dump(&d, mem, &t);
    let s = t.str();
    ok(contains(s, "button") && contains(s, "expanded=true"), "an open summary is an expanded button");
    OPEN = false;
    detailsFrame(&d);
    let t2 = Text.new(mem);
    a11y.dump(&d, mem, &t2);
    ok(contains(t2.str(), "expanded=false"), "a closed one is not expanded");

    // idle frames cost nothing
    detailsFrame(&d);
    let r0 = d.restyled;
    let l0 = d.laid;
    for i in 0..10 {
        detailsFrame(&d);
    }
    ok(d.restyled == r0 && d.laid == l0, "idle details frames neither restyle nor lay out");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "elements.css", 1);
    ok(css.warns.len == 0, "sheet parses without warnings");
    testBr(&mem, &css);
    testGauges(&mem, &css);
    testDetails(&mem, &css);
    printLn(`elements_test: {CHECKS} checks passed`);
}
