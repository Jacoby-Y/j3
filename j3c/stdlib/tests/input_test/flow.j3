// input_test: typing flow through the page and many-option selects.

module input_test;

fn testFlow(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    TXT = "";
    SEARCH = "";
    PICK = "";
    MULTI = "";
    COLOR = "#000000";
    VOL = 3.0;
    LO = 20.0;
    HI = 80.0;
    frame(&d);
    frame(&d);
    ok(d.fontMissing == 0, "font loaded");
    // ---- text box
    click(&d, cx(&d, IDS.tb), cy(&d, IDS.tb));
    ok(d.focused() == IDS.tb, "a press focuses the text box");
    type(&d, "héllo", "");
    ok(same(TXT, "héllo"), "typed text reaches the bound variable");
    type(&d, "", "Left");
    type(&d, "", "Left");
    type(&d, "X", "");
    ok(same(TXT, "hélXlo"), "typing inserts at the caret");
    type(&d, "", "Backspace");
    ok(same(TXT, "héllo"), "backspace removes the X");
    type(&d, "", "C+a");
    type(&d, "ok", "");
    ok(same(TXT, "ok"), "select all then type replaces");
    type(&d, "", "S+Home");
    type(&d, "", "Delete");
    ok(same(TXT, ""), "shift+home selects, delete removes");
    let n0 = INPUTS;
    type(&d, "", "Left");
    ok(INPUTS == n0, "caret keys are not changes");
    type(&d, "abc", "");
    type(&d, "", "Enter");
    ok(SUBMITS == 1, "Enter submits");
    TXT = "set by the program";
    frame(&d);
    ok(same(d.eds.items[d.nodes.items[IDS.tb].edit].str(), "set by the program"), "a changed variable replaces the buffer while focused");
    type(&d, "!", "");
    ok(same(TXT, "set by the program!"), "and typing continues at the end");
    // long text keeps working
    let long = Text.new(mem);
    for i in 0..3000 {
        long.pushStr("lorem ");
    }
    TXT = long.str();
    frame(&d);
    type(&d, "", "C+a");
    type(&d, "", "End");
    type(&d, "Z", "");
    ok(TXT.len == 18001 && TXT[18000] == 90, "a long text takes typing at the end");
    TXT = "";
    frame(&d);
    // ---- tab and the button
    type(&d, "", "Tab");
    ok(d.focused() == IDS.search, "Tab moves to the next input");
    type(&d, "q", "");
    ok(same(SEARCH, "q"), "typing goes to the focused search box");
    type(&d, "", "Escape");
    ok(same(SEARCH, ""), "Escape clears a search box");
    type(&d, "", "S+Tab");
    ok(d.focused() == IDS.tb, "Shift+Tab goes back");
    d.focusNode(IDS.btn);
    frame(&d);
    type(&d, "", "Space");
    ok(CLICKS == 1, "Space clicks the focused button");
    // ---- range
    let span: f32 = 184.0;
    let row: f32 = 26.0;
    let rg = IDS.rg;
    click(&d, d.absX(rg) + 8.0 + span * 0.5, cy(&d, rg));
    near(VOL, 5.0, 0.0001, "click in the middle of a 0..10 step 1 range");
    d.simInput(d.absX(rg) + 20.0, cy(&d, rg), true, 0.0);
    frame(&d);
    d.simInput(d.absX(rg) + 400.0, cy(&d, rg), true, 0.0);
    frame(&d);
    near(VOL, 10.0, 0.0001, "dragging past the end clamps to max");
    d.simInput(d.absX(rg) + 400.0, cy(&d, rg), false, 0.0);
    frame(&d);
    type(&d, "", "Left");
    near(VOL, 9.0, 0.0001, "Left steps down");
    type(&d, "", "S+Left");
    near(VOL, 0.0, 0.0001, "Shift+Left steps ten times and clamps");
    type(&d, "", "End");
    near(VOL, 10.0, 0.0001, "End jumps to max");
    // ---- two thumbs
    let du = IDS.dual;
    let x0 = d.absX(du);
    click(&d, x0 + 8.0 + span * 0.9, cy(&d, du));
    near(HI, 90.0, 0.0001, "a press near the high thumb moves it");
    near(LO, 20.0, 0.0001, "and leaves the low thumb");
    d.simInput(x0 + 8.0 + span * 0.5, cy(&d, du), true, 0.0);
    frame(&d);
    d.simInput(x0 + 8.0 + span * 0.05, cy(&d, du), true, 0.0);
    frame(&d);
    d.simInput(x0 + 8.0 + span * 0.05, cy(&d, du), false, 0.0);
    frame(&d);
    ok(LO <= HI, "thumbs never cross");
    // ---- select
    let sel = IDS.sel;
    click(&d, cx(&d, sel), cy(&d, sel));
    ok(d.pop.kind == popup.SELECT && d.pop.owner == sel, "a press opens the list");
    ok(ly(&d) > d.absY(sel) + d.nodes.items[sel].h - 1.0, "below the select");
    let rowY = ly(&d) + 4.0 + row * 1.5;
    click(&d, lx(&d) + 20.0, rowY);
    ok(same(PICK, "green"), "clicking the second option picks it");
    ok(d.pop.kind == popup.NONE, "and closes the list");
    type(&d, "", "Down");
    ok(same(PICK, "blue"), "Down on a closed select steps the choice");
    type(&d, "", "Down");
    ok(same(PICK, "blue"), "and stops at the last option");
    type(&d, "", "Enter");
    ok(d.pop.kind == popup.SELECT, "Enter opens the list");
    type(&d, "", "Up");
    type(&d, "", "Enter");
    ok(same(PICK, "green") && d.pop.kind == popup.NONE, "arrow keys and Enter pick");
    click(&d, cx(&d, sel), cy(&d, sel));
    click(&d, 590.0, 395.0);
    ok(d.pop.kind == popup.NONE && same(PICK, "green"), "a press outside closes without picking");
    // ---- type-ahead on a focused select
    click(&d, cx(&d, sel), cy(&d, sel));
    type(&d, "", "Escape");
    type(&d, "r", "");
    ok(same(PICK, "red"), "typing a letter on a closed select picks the first option that starts with it");
    type(&d, "b", "");
    ok(same(PICK, "red"), "a second letter within a second extends the prefix (no 'rb' option: unchanged)");
    for i in 0..70 {
        frame(&d);
    }
    type(&d, "B", "");
    ok(same(PICK, "blue"), "after a pause the prefix starts over, and case is ignored");
    for i in 0..70 {
        frame(&d);
    }
    type(&d, "g", "");
    type(&d, "r", "");
    ok(same(PICK, "green"), "a growing prefix 'gr' stays on the match");
    for i in 0..70 {
        frame(&d);
    }
    type(&d, "Ä", "");
    ok(same(PICK, "green"), "a multibyte letter with no match changes nothing");
    type(&d, "", "Enter");
    for i in 0..70 {
        frame(&d);
    }
    type(&d, "b", "");
    ok(d.pop.kind == popup.SELECT && d.pop.hot == 2, "type-ahead moves the highlight of an open list");
    type(&d, "", "Enter");
    ok(same(PICK, "blue") && d.pop.kind == popup.NONE, "and Enter picks it");
    // ---- multiple
    let ms = IDS.multi;
    click(&d, cx(&d, ms), cy(&d, ms));
    click(&d, lx(&d) + 20.0, ly(&d) + 4.0 + 13.0);
    click(&d, lx(&d) + 20.0, ly(&d) + 4.0 + row * 2.5);
    ok(d.pop.kind == popup.SELECT, "a multiple list stays open");
    ok(same(MULTI, "a,c"), "picks accumulate as a comma list");
    click(&d, lx(&d) + 20.0, ly(&d) + 4.0 + 13.0);
    ok(same(MULTI, "c"), "picking a picked option removes it");
    click(&d, lx(&d) + 20.0, ly(&d) + 4.0 + row * 2.5);
    ok(same(MULTI, ""), "removing the last leaves an empty list");
    type(&d, "", "Escape");
    ok(d.pop.kind == popup.NONE, "Escape closes");
    // ---- color
    let co = IDS.color;
    click(&d, cx(&d, co), cy(&d, co));
    ok(d.pop.kind == popup.COLOR, "a press opens the color panel");
    ok(d.ptRoot >= 0 && d.nodes.items[d.ptRoot].rt && d.nodes.items[d.ptRoot].parent == co, "color panel is a runtime DOM child of its input");
    let px = d.pop.x;
    let py = d.pop.y;
    d.simInput(px + 10.0 + 179.9, py + 10.0, true, 0.0);
    frame(&d);
    d.simInput(px + 10.0 + 179.9, py + 10.0, false, 0.0);
    frame(&d);
    ok(same(COLOR, "#ff0000"), "the top right of the square is the pure hue");
    d.simInput(px + 10.0 + 90.0, py + 138.0 + 7.0, true, 0.0);
    frame(&d);
    d.simInput(px + 10.0 + 90.0, py + 138.0 + 7.0, false, 0.0);
    frame(&d);
    ok(same(COLOR, "#00ffff"), "the hue bar changes the hue");
    type(&d, "", "Enter");
    ok(d.pop.kind == popup.NONE && d.ptRoot < 0, "Enter closes and removes the panel subtree");
}

#[singleton]
let MANY: string;

/// Option values: each its own bytes (`attrText` keeps a view, so a shared scratch buffer would change them all).
#[singleton]
let NAMES: []string;

/// The open select list's box (a real node placed by `dropdown.settle`).
fn lx(d: &Dom): f32 {
    return d.nodes.items[d.ptRoot].x;
}

fn ly(d: &Dom): f32 {
    return d.nodes.items[d.ptRoot].y;
}

fn manyFrame(d: &Dom, n: int) {
    d.beginFrame(Vec2 { x: 600.0, y: 300.0 });
    inputs.begin(d);
    let sl = d.open(0, d.tag("select"), 1);
    d.cls(sl, "sl");
    if d.changed(sl) {
        MANY = d.strValue(sl);
    }
    d.attrText(sl, MANY);
    for i in 0..n {
        let o = d.open(i, d.tag("option"), 1);
        d.attrText(o, NAMES[i]);
        d.text(NAMES[i]);
        d.close();
    }
    d.close();
    d.layout();
    dropdown.settle(d);
    d.endFrame();
}

/// A select with hundreds of options: the popup shows 8 rows, keys and the wheel scroll it, End reaches the last.
fn testManyOptions(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    MANY = "";
    NAMES = mem.alloc::<string>(600);
    for i in 0..600 {
        let t = Text.new(mem);
        t.pushStr("o");
        t.pushInt(i);
        NAMES[i] = t.str();
    }
    manyFrame(&d, 600);
    manyFrame(&d, 600);
    let sel = 1;
    d.simInput(d.absX(sel) + 10.0, d.absY(sel) + 10.0, true, 0.0);
    manyFrame(&d, 600);
    d.simInput(d.absX(sel) + 10.0, d.absY(sel) + 10.0, false, 0.0);
    manyFrame(&d, 600);
    ok(d.pop.kind == popup.SELECT, "the long list opens");
    ok(d.nodes.items[d.ptRoot].h < 217.0, "but shows only 8 rows");
    d.simKeys("", "End");
    manyFrame(&d, 600);
    ok(d.pop.hot == 599 && d.nodes.items[d.ptRoot].scrollY > d.nodes.items[d.ptRoot].scrollMax - 2.0, "End goes to the last option and scrolls to it");
    let endY = d.nodes.items[d.ptRoot].scrollY;
    d.simInput(lx(&d) + 10.0, ly(&d) + 20.0, false, 3.0);
    manyFrame(&d, 600);
    ok(d.nodes.items[d.ptRoot].scrollY < endY - 10.0, "the wheel scrolls the list");
    d.simKeys("", "Home");
    manyFrame(&d, 600);
    ok(d.pop.hot == 0 && d.nodes.items[d.ptRoot].scrollY < 1.0, "Home goes back to the top");
    d.simKeys("", "Down");
    manyFrame(&d, 600);
    d.simKeys("", "Enter");
    manyFrame(&d, 600);
    ok(same(MANY, "o1") && d.pop.kind == popup.NONE, "Down then Enter picks the second of 600");
    // the options shrink while it is open: nothing indexes past the end
    d.simKeys("", "Enter");
    manyFrame(&d, 600);
    d.simKeys("", "End");
    manyFrame(&d, 600);
    manyFrame(&d, 3);
    manyFrame(&d, 3);
    ok(d.pop.kind == popup.NONE || d.nodes.items[d.ptRoot].scrollY < 1.0, "fewer options pull the list back");
    d.simKeys("", "Enter");
    manyFrame(&d, 3);
    ok(d.pop.kind == popup.NONE && same(MANY, "o2"), "and a stale highlight falls back to the last option");
    manyFrame(&d, 0);
    d.simKeys("", "Enter");
    manyFrame(&d, 0);
    d.simKeys("", "Enter");
    manyFrame(&d, 0);
    ok(d.pop.kind == popup.NONE || d.pop.kind == popup.SELECT, "a select with no options survives open, keys and close");
}
