// input_test: the text focus / blur hooks (`inputs.setTextFocusHook`, `setTextBlurHook`).

module input_test;

#[singleton]
let HF: int;
#[singleton]
let HB: int;
#[singleton]
let HX: int;
#[singleton]
let HY: int;
#[singleton]
let HW: int;
#[singleton]
let HH: int;
#[singleton]
let HK: int;
#[singleton]
let HIDS: [4]int;
#[singleton]
let HSHOW: bool;

fn onTextFocus(x: int, y: int, w: int, h: int, kind: int) {
    HF += 1;
    HX = x; HY = y; HW = w; HH = h; HK = kind;
}

fn onTextBlur() {
    HB += 1;
}

fn frameH(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    if HSHOW {
        let a = d.open(1, d.tag("input"), 1);
        d.cls(a, "tb");
        d.attrType(a, "text");
        d.attrText(a, "x");
        d.close();
        HIDS[0] = a;
    }
    let b = d.open(2, d.tag("input"), 1);
    d.cls(b, "tb");
    d.attrType(b, "number");
    d.attrText(b, "1");
    d.close();
    let c = d.open(3, d.tag("input"), 1);
    d.attrType(c, "checkbox");
    d.close();
    let t = d.open(4, d.tag("input"), 1);
    d.cls(t, "tb");
    d.attrType(t, "textarea");
    d.close();
    d.close();
    HIDS[1] = b; HIDS[2] = c; HIDS[3] = t;
    d.layout();
    d.endFrame();
}

fn testFocusHook(mem: &Arena, css: &Css) {
    inputs.setTextFocusHook(onTextFocus);
    inputs.setTextBlurHook(onTextBlur);
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    HSHOW = true;
    frameH(&d);
    frameH(&d);
    ok(HF == 0 && HB == 0, "no hook before any focus");
    d.focusNode(HIDS[0]);
    frameH(&d);
    frameH(&d);
    ok(HF == 1 && HB == 0 && HK == 0, "focusing a text box calls the focus hook once, kind 0");
    ok(HW >= 120 && HH > 0 && HX >= 0 && HY >= 0 && HX < 600 && HY < 400, "the rect is the box in window pixels");
    ok(HX == int(d.absX(HIDS[0]) + 0.5) && HY == int(d.absY(HIDS[0]) + 0.5), "and starts at the node's position");
    d.focusNode(HIDS[1]);
    frameH(&d);
    ok(HF == 2 && HB == 0 && HK == 3, "text box to text box: focus hook again (number, kind 3), no blur");
    ok(HY > 0, "the second box is below the first");
    d.focusNode(HIDS[2]);
    frameH(&d);
    ok(HF == 2 && HB == 1, "a checkbox takes the focus: one blur, no focus call");
    d.focusNode(HIDS[3]);
    frameH(&d);
    ok(HF == 3 && HK == 1, "textarea is kind 1");
    d.focusNode(-1);
    frameH(&d);
    frameH(&d);
    ok(HF == 3 && HB == 2, "blur to nothing: one blur, none per frame");
    d.focusNode(HIDS[0]);
    frameH(&d);
    ok(HF == 4, "focus again");
    HSHOW = false;
    frameH(&d);
    frameH(&d);
    ok(HB == 3 && HF == 4, "the focused box leaves the tree: blur fires once");
    frameH(&d);
    ok(HB == 3, "and not again");
    inputs.setTextFocusHook(none5);
    inputs.setTextBlurHook(none0);
}

fn none5(x: int, y: int, w: int, h: int, kind: int) {}

fn none0() {}
