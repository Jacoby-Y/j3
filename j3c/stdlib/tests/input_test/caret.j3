// input_test: caret placement, two boxes, inline-box frames.

module input_test;

// ---- caret popup: on:trigger and popover="caret" ------------------------------------------------------

#[singleton]
let CT: string;

#[singleton]
let CS: []Span;

#[singleton]
let CQ: string;

#[singleton]
let CLO: int;

#[singleton]
let CHI: int;

#[singleton]
let COPEN: bool;

#[singleton]
let CEV: int;

#[singleton]
let CID: int;

#[singleton]
let CPOP: int;

#[singleton]
let CH: f32;

#[singleton]
let CPICK: string;

#[singleton]
let CNONE: bool;

/// One frame of the usual generated shape: a wrapper holding a rich textarea (`triggers="@:"`, `on:trigger`) and a conditional
/// `popover="caret"` with two entries (none when `CNONE`). These frames paint nothing: `caretRect` works from layout.
fn frameC(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: CH });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let ta = d.open(0, d.tag("input"), 1);
    d.cls(ta, "ta");
    d.attrType(ta, "textarea");
    d.attrRich(ta, true);
    d.attrTriggers(ta, "@:");
    if d.changed(ta) {
        CT = d.strValue(ta);
    }
    d.attrText(ta, CT);
    if d.changed(ta) {
        CS = d.spansValue(ta);
    }
    d.attrSpans(ta, CS);
    if d.triggered(ta) {
        CQ = d.triggerText(ta);
        CLO = d.trigLo;
        CHI = d.trigHi;
        COPEN = CQ.len > 0;
        CEV += 1;
    }
    d.close();
    CPOP = -1;
    if COPEN {
        let p = d.open(1, d.tag("div"), 1);
        d.cls(p, "cpop");
        d.attrCaret(p);
        CPOP = p;
        if d.closeRequested(p) {
            COPEN = false;
        }
        if !CNONE {
        let b1 = d.open(0, d.tag("button"), 1);
        d.text("@Jane");
        if d.clicked(b1) {
            d.insertToken(d.trigNode, CLO, CHI, "@Jane", SPAN_MENTION, "u7");
            CPICK = "Jane";
        }
        d.close();
        let b2 = d.open(1, d.tag("button"), 1);
        d.text("@Jack");
        if d.clicked(b2) {
            d.insertToken(d.trigNode, CLO, CHI, "@Jack", SPAN_MENTION, "u8");
            CPICK = "Jack";
        }
        d.close();
        }
        d.close();
    }
    d.close();
    CID = ta;
    d.layout();
    d.endFrame();
}

fn typeC(d: &Dom, text: string, names: string) {
    d.simKeys(text, names);
    frameC(d);
}

/// The text box now holds `t` (as a program set it), the caret at its end, with a few frames to settle.
fn setC(d: &Dom, t: string) {
    CT = t;
    for k in 0..4 {
        frameC(d);
    }
}

#[singleton]
let IT: string;

fn frameI(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let ta = d.open(0, d.tag("input"), 1);
    d.cls(ta, "tb");
    d.attrType(ta, "text");
    d.attrTriggers(ta, "@");
    if d.changed(ta) {
        IT = d.strValue(ta);
    }
    d.attrText(ta, IT);
    if d.triggered(ta) {
        COPEN = d.triggerText(ta).len > 0;
    }
    d.close();
    if COPEN {
        let p = d.open(1, d.tag("div"), 1);
        d.attrCaret(p);
        let b = d.open(0, d.tag("button"), 1);
        d.text("@Jane");
        d.close();
        CPOP = p;
        d.close();
    }
    d.close();
    CID = ta;
    d.layout();
    d.endFrame();
}

#[singleton]
let XTA: string;

#[singleton]
let XTB: string;

#[singleton]
let XTQA: string;

#[singleton]
let XTQB: string;

#[singleton]
let XTEA: int;

#[singleton]
let XTEB: int;

#[singleton]
let XTIDA: int;

#[singleton]
let XTIDB: int;

fn frameT(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let a = d.open(0, d.tag("input"), 1);
    d.cls(a, "tb");
    d.attrType(a, "text");
    d.attrTriggers(a, "@");
    d.attrText(a, XTA);
    if d.triggered(a) {
        XTQA = d.triggerText(a);
        XTEA += 1;
    }
    d.close();
    let b = d.open(1, d.tag("input"), 1);
    d.cls(b, "tb");
    d.attrType(b, "text");
    d.attrTriggers(b, "@");
    d.attrText(b, XTB);
    if d.triggered(b) {
        XTQB = d.triggerText(b);
        XTEB += 1;
    }
    d.close();
    d.close();
    XTIDA = a;
    XTIDB = b;
    d.layout();
    d.endFrame();
}

fn testTwoBoxes(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    XTA = "hi @ja";
    XTB = "yo @bo";
    XTQA = "";
    XTQB = "";
    frameT(&d);
    frameT(&d);
    d.focusNode(XTIDA);
    frameT(&d);
    frameT(&d);
    ok(same(XTQA, "@ja") && XTEA == 1 && XTEB == 0, "box A reports its trigger");
    d.focusNode(XTIDB);
    frameT(&d);
    ok(same(XTQA, "") && XTEA == 2, "moving focus to box B gives A exactly one ended event");
    frameT(&d);
    frameT(&d);
    ok(same(XTQB, "@bo") && XTEB == 1 && XTEA == 2, "and B's trigger starts right after");
}

fn testCaret(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    CT = "";
    CH = 400.0;
    COPEN = false;
    frameC(&d);
    frameC(&d);
    d.focusNode(CID);
    frameC(&d);
    ok(d.trigNode < 0 && CEV == 0, "no trigger before anything is typed");
    typeC(&d, "hi @ja", "");
    frameC(&d);
    ok(CEV >= 1 && same(CQ, "@ja") && CLO == 3 && CHI == 6 && d.trigNode == CID, "typing @ja reports the trigger text and its byte range");
    ok(COPEN && CPOP >= 0 && d.nodes.items[CPOP].ov == 2 && d.nodes.items[CPOP].ovCaret, "the caret popover is open");
    ok(d.focus == CID, "the popover took no focus");
    // starts, only after whitespace or at the start of the text
    setC(&d, "a@ja");
    ok(!COPEN && d.trigNode < 0, "a trigger character in the middle of a word is not a trigger");
    setC(&d, "@ja");
    ok(COPEN && same(CQ, "@ja") && CLO == 0, "a trigger at the start of the text");
    setC(&d, "ok\n:smi");
    ok(COPEN && same(CQ, ":smi") && CLO == 3, "a trigger after a newline, with the other character");
    // ends
    typeC(&d, " ", "");
    frameC(&d);
    ok(!COPEN && CQ.len == 0 && d.trigNode < 0, "a space ends the trigger");
    setC(&d, "go @ab");
    ok(COPEN, "reopened");
    typeC(&d, "", "Left");
    frameC(&d);
    ok(COPEN && same(CQ, "@a"), "the trigger text stops at the caret");
    typeC(&d, "", "Home");
    frameC(&d);
    ok(!COPEN, "the caret before the trigger is not in it");
    typeC(&d, "", "End");
    frameC(&d);
    ok(COPEN && same(CQ, "@ab"), "back at the end of the word: the trigger returns");
    d.focusNode(-1);
    frameC(&d);
    frameC(&d);
    ok(!COPEN && d.trigNode < 0 && d.focus < 0, "losing focus ends the trigger and the box stays blurred");
    ok(game.keysTaken(), "a blurred box keeps the game's keys until the next poll");
    game.poll();
    ok(!game.keysTaken(), "the poll after the blur gives the game its keys back");
    d.focusNode(CID);
    frameC(&d);
    ok(game.keysTaken(), "a focused text box takes the game's keys");
    // tokens never form a trigger
    setC(&d, "x @ja");
    ok(d.insertToken(CID, 2, 5, "@Jane", SPAN_MENTION, "u7"), "a chip replaces the trigger");
    for k in 0..4 {
        frameC(&d);
    }
    ok(!COPEN && same(CT, "x @Jane"), "the caret after a chip is not in a trigger");
    // keys: Up, Down, Enter go to the popup; the caret stays
    setC(&d, "one\ntwo\n@ja");
    let caret0 = d.caret(CID);
    ok(COPEN && d.cpHot >= 0, "the popup is open with an active entry");
    let first = d.cpHot;
    typeC(&d, "", "Down");
    ok(d.cpHot != first && d.caret(CID) == caret0 && same(CT, "one\ntwo\n@ja"), "Down moves the active entry, not the caret");
    typeC(&d, "", "Down");
    ok(d.cpHot == first, "Down wraps");
    typeC(&d, "", "Up");
    ok(d.cpHot != first && d.caret(CID) == caret0, "Up wraps backwards, the caret stays");
    // typing keeps going to the box
    typeC(&d, "n", "");
    ok(same(CT, "one\ntwo\n@jan") && same(CQ, "@jan") && COPEN, "typing reaches the box and updates the trigger");
    // Enter picks the active entry (the second: Jack) and inserts the chip as one undo step
    CPICK = "";
    let evN = CEV;
    typeC(&d, "", "Enter");
    frameC(&d);
    frameC(&d);
    ok(CEV == evN + 1, "the insert ends the trigger with one event");
    ok(same(CPICK, "Jack") && same(CT, "one\ntwo\n@Jack"), "Enter inserts the active entry as a mention");
    ok(CS.len == 1 && CS[0].kind == SPAN_MENTION && same(CS[0].data, "u8"), "the span is bound");
    ok(!COPEN, "the popup closed after the pick");
    typeC(&d, "", "C+z");
    frameC(&d);
    ok(same(CT, "one\ntwo\n@jan"), "undo takes the chip back to the typed text");
    ok(COPEN && same(CQ, "@jan"), "and the caret at the end of a valid trigger reopens the list");
    CS = CS[0..0];
    // Esc closes the list and leaves the text; the same trigger stays quiet, a new one opens
    setC(&d, "@ja");
    ok(COPEN, "open before Escape");
    let ev0 = CEV;
    typeC(&d, "", "Escape");
    frameC(&d);
    ok(!COPEN && same(CT, "@ja") && d.trigNode < 0 && CEV > ev0, "Escape closes the list, ends the trigger and keeps the text");
    typeC(&d, "n", "");
    frameC(&d);
    ok(!COPEN && same(CT, "@jan"), "typing on in the dismissed trigger stays quiet");
    typeC(&d, " @x", "");
    frameC(&d);
    ok(COPEN && same(CQ, "@x"), "a new trigger opens again");
    // a mouse press on an entry keeps focus in the box and picks it
    CPICK = "";
    let b = d.nodes.items[CPOP].first;
    let mx = d.absX(b) + 4.0;
    let my = d.absY(b) + 4.0;
    d.simInput(mx, my, false, 0.0);
    frameC(&d);
    d.simInput(mx, my, true, 0.0);
    frameC(&d);
    d.simInput(mx, my, false, 0.0);
    frameC(&d);
    ok(same(CPICK, "Jane") && d.focus == CID, "a click picks an entry and the box keeps focus");
    d.simInput(-5.0, -5.0, false, 0.0);
    frameC(&d);
    // a click that moves the caret out of the trigger ends it
    setC(&d, "ab @jx");
    ok(COPEN, "open before the click");
    let tx = d.absX(CID) + 8.0;
    let ty = d.absY(CID) + 10.0;
    d.simInput(tx, ty, false, 0.0);
    frameC(&d);
    d.simInput(tx, ty, true, 0.0);
    frameC(&d);
    d.simInput(tx, ty, false, 0.0);
    frameC(&d);
    frameC(&d);
    ok(!COPEN && d.trigNode < 0 && d.focus == CID, "a click into other text ends the trigger and keeps focus");
    d.simInput(-5.0, -5.0, false, 0.0);
    frameC(&d);
    // a popup with no entries leaves Up and Enter to the box
    CNONE = true;
    setC(&d, "one\ntwo\n@ja");
    ok(COPEN && d.cpHot < 0, "an open popup with no entries has no active entry");
    let c1 = d.caret(CID);
    typeC(&d, "", "Up");
    ok(d.caret(CID) < c1, "Up still moves the caret in the box");
    typeC(&d, "", "Down");
    typeC(&d, "", "End");
    typeC(&d, "", "Enter");
    frameC(&d);
    ok(same(CT, "one\ntwo\n@ja\n"), "Enter still inserts a newline");
    CNONE = false;
    // the first frame the popup shows it is already at the caret (no stale or missing rect)
    setC(&d, "x ");
    ok(!COPEN, "closed");
    typeC(&d, "@", "");
    let fc = d.caretRect(CID);
    ok(COPEN && CPOP >= 0 && fc.x > 0.0, "the list opened on the typed trigger character");
    near(d.nodes.items[CPOP].x, fc.x, 1.0, "its first frame is already at the caret column");
    near(d.nodes.items[CPOP].y, fc.y + fc.h + 2.0, 1.0, "and under the caret line");
    // placement: under the caret line after a soft wrap, above when there is no room, inside the window
    setC(&d, "aaaa bbbb cccc dddd eeee @ja");
    ok(COPEN && CPOP >= 0, "open at the end of a wrapped text");
    let cr = d.caretRect(CID);
    ok(cr.x > 0.0 && cr.y > d.absY(CID) + 5.0, "the caret is on a later wrapped line");
    let pn = &d.nodes.items[CPOP];
    near(pn.x, cr.x, 1.0, "the popup is at the caret column");
    ok(pn.y >= cr.y + cr.h && pn.y <= cr.y + cr.h + 4.0, "the popup is under the caret line");
    typeC(&d, " zzzz yyyy", "");
    typeC(&d, " @jx", "");
    frameC(&d);
    let cr2 = d.caretRect(CID);
    ok(COPEN && cr2.x != cr.x, "the caret moved on");
    near(d.nodes.items[CPOP].x, cr2.x, 1.0, "the popup follows the caret column (the view scrolled with it)");
    near(d.nodes.items[CPOP].y, cr2.y + cr2.h + 2.0, 3.0, "and hangs under the new caret line");
    let ph = d.nodes.items[CPOP].h;
    CH = cr2.y + cr2.h + ph * 0.5;
    frameC(&d);
    frameC(&d);
    near(d.nodes.items[CPOP].y + d.nodes.items[CPOP].h, cr2.y - 2.0, 3.0, "with no room below, the popup goes above the caret line");
    ok(d.nodes.items[CPOP].y >= 0.0 && d.nodes.items[CPOP].y + d.nodes.items[CPOP].h <= CH, "and stays inside the window");
    CH = 400.0;
    frameC(&d);
    frameC(&d);
    // steady: nothing changes, nothing is laid out or restyled
    let used = mem.used;
    let laid = d.laid;
    let re = d.restyled;
    for k in 0..300 {
        frameC(&d);
    }
    ok(d.laid == laid && d.restyled == re && mem.used == used, "300 idle frames with an open caret popup: 0 layouts, 0 restyles, no arena growth");
    // a one-line input anchors at its caret too
    let i = Dom.new(mem, css);
    i.setFrameMs(16.0);
    i.simInput(-5.0, -5.0, false, 0.0);
    COPEN = false;
    IT = "";
    frameI(&i);
    frameI(&i);
    i.focusNode(CID);
    i.simKeys("hi @ja", "");
    frameI(&i);
    frameI(&i);
    let ir = i.caretRect(CID);
    ok(COPEN && ir.x > i.absX(CID) + 20.0 && ir.h > 0.0, "a one-line input has a caret rect from its layout");
    near(i.nodes.items[CPOP].x, ir.x, 1.0, "and its popup hangs at the caret column");
    COPEN = false;
    CH = 400.0;
}
