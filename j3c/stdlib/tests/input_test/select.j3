// input_test: text selection and undo.

module input_test;

fn frame3(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let a = d.open(0, d.tag("div"), 1);
    d.cls(a, "sel");
    d.text("hello world");
    d.close();
    let b = d.open(1, d.tag("div"), 1);
    d.cls(b, "sel");
    d.text("second line");
    d.close();
    let c = d.open(2, d.tag("div"), 1);
    d.text("not selectable");
    d.close();
    let t = d.open(3, d.tag("input"), 1);
    d.cls(t, "tb");
    d.attrType(t, "text");
    d.attrText(t, "boxed");
    d.close();
    d.close();
    d.end();
    d.layoutAt(600.0, 400.0);
}

fn mouse3(d: &Dom, x: f32, y: f32, down: bool) {
    d.simInput(x, y, down, 0.0);
    frame3(d);
}

fn testSelect(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    frame3(&d);
    frame3(&d);
    ok(d.fontMissing == 0, "font loaded (select)");
    let n0 = d.nodes.items[2].first;
    let x0 = d.absX(2) + 1.0;
    let y0 = d.absY(2) + 5.0;
    let y1 = d.absY(4) + 5.0;
    // press in the first line, drag into the second, release
    mouse3(&d, x0, y0, false);
    mouse3(&d, x0, y0, true);
    mouse3(&d, x0 + 40.0, y1, true);
    mouse3(&d, x0 + 40.0, y1, false);
    ok(textsel.active(&d), "a drag over user-select:text text selects");
    let got = textsel.selected(&d);
    ok(got.len > 11 && same(got[0..11], "hello world"), "the first line is selected from its start");
    ok(got[11] == 10, "blocks are separated by a newline");
    ok(got.len < 11 + 1 + 11, "the second line is cut where the drag ended");
    // the clipboard only exists with SDL video up (not in a bare test run): then Ctrl+C must fill it
    game.setClipboard("zz");
    let live = same(game.clipboard(), "zz");
    d.simKeys("", "C+c");
    frame3(&d);
    ok(!live || same(game.clipboard(), got), "Ctrl+C copies the selection");
    // a press on text that is not selectable clears it
    mouse3(&d, d.absX(6) + 2.0, d.absY(6) + 5.0, false);
    mouse3(&d, d.absX(6) + 2.0, d.absY(6) + 5.0, true);
    ok(!textsel.active(&d), "a press on non-selectable text drops the selection");
    mouse3(&d, -5.0, -5.0, false);
    // a drag that starts on a text box never selects page text
    mouse3(&d, d.absX(8) + 3.0, d.absY(8) + 5.0, false);
    mouse3(&d, d.absX(8) + 3.0, d.absY(8) + 5.0, true);
    mouse3(&d, x0 + 30.0, y0, true);
    ok(!textsel.active(&d), "a press on an input does not start a selection");
    mouse3(&d, -5.0, -5.0, false);
    ok(n0 >= 0, "tree built");
}

/// Undo and redo: the Edit stacks, then Ctrl+Z / Ctrl+Y / Ctrl+Shift+Z through the focused text boxes.
fn testUndo(mem: &Arena, css: &Css) {
    let e = Edit.new(mem);
    e.insert("a");
    e.insert("b");
    e.insert("c");
    ok(e.un == 1, "a typing run is one undo step");
    ok(e.undo() && same(e.str(), "") && e.cur == 0, "undo takes the whole run back");
    ok(!e.undo(), "nothing left to undo");
    ok(e.redo() && same(e.str(), "abc") && e.cur == 3, "redo brings the run back, caret too");
    ok(!e.redo(), "nothing left to redo");
    // deleting is its own run
    e.deleteBack(false);
    e.deleteBack(false);
    ok(e.un == 2 && same(e.str(), "a"), "typing then deleting are two steps");
    e.undo();
    ok(same(e.str(), "abc"), "undo restores the deleted run");
    e.undo();
    ok(same(e.str(), ""), "and the typed one");
    // paste and selection delete are steps of their own; a caret move ends a run
    e.redo();
    e.redo();
    e.paste("XY");
    e.insert("1");
    e.insert("2");
    ok(same(e.str(), "aXY12") && e.un == 4, "paste is a step, typing after it another");
    e.left(false, false);
    e.insert("_");
    ok(e.un == 5, "a caret move ends a typing run");
    e.selectAll();
    e.deleteSel();
    ok(e.un == 6 && same(e.str(), ""), "deleting a selection is a step");
    e.undo();
    ok(same(e.str(), "aXY1_2") && e.cur == 6 && e.anc == 0, "undo restores the selection too");
    e.undo();
    ok(same(e.str(), "aXY12"), "undo of the inserted underscore");
    e.undo();
    ok(same(e.str(), "aXY"), "undo of the 12 run");
    // a new edit after undo clears redo
    ok(e.rn > 0, "redo has steps");
    e.insert("!");
    ok(e.rn == 0 && !e.redo(), "a new edit clears redo");
    // a program's set is no step and keeps the history (undo can then show older text)
    let n = e.un;
    e.set("zz");
    ok(e.un == n && same(e.str(), "zz"), "set pushes no step");
    e.insert("q");
    ok(e.un == n + 1, "typing after set starts a new step");
    e.undo();
    ok(same(e.str(), "zz"), "undo goes back to the set text");
    // a failed insert (maxlength) leaves no step
    let m = Edit.new(mem);
    m.maxlen = 2;
    m.insert("ab");
    let k = m.un;
    m.paste("cd");
    ok(m.un == k && same(m.str(), "ab"), "a paste that does not fit leaves no step");
    // the cap
    let c = Edit.new(mem);
    for i in 0..150 {
        c.paste("x");
    }
    ok(c.un == UNDO_CAP && c.cps() == 150, "the undo stack is capped");
    let steps = 0;
    while c.undo() {
        steps += 1;
    }
    ok(steps == UNDO_CAP && c.cps() == 150 - UNDO_CAP, "only the last UNDO_CAP steps undo");
    while c.redo() {
    }
    ok(c.cps() == 150 && c.rn == 0, "redo returns to the end");
    // past the cap each surviving step restores its own exact text (no two entries share a buffer)
    let r = Edit.new(mem);
    for i in 0..250 {
        r.paste(`<{i}>`);
    }
    let want = Text.new(mem);
    for i in 0..250 {
        want.pushStr(`<{i}>`);
    }
    ok(r.un == UNDO_CAP, "ring: capped");
    let good = true;
    let upto = 250;
    while r.undo() {
        upto -= 1;
        let w = Text.new(mem);
        for i in 0..upto {
            w.pushStr(`<{i}>`);
        }
        if !same(r.str(), w.str()) {
            good = false;
        }
    }
    ok(good && upto == 150, "undoing past the cap restores each earlier text exactly");
    let again = true;
    while r.redo() {
        upto += 1;
        let w2 = Text.new(mem);
        for i in 0..upto {
            w2.pushStr(`<{i}>`);
        }
        if !same(r.str(), w2.str()) {
            again = false;
        }
    }
    ok(again && same(r.str(), want.str()), "redo walks back through the same texts");
    // the byte budget: big texts drop the oldest steps but keep the newest
    let big = Edit.new(mem);
    let chunk = Text.new(mem);
    for i in 0..(UNDO_BYTES / 2) {
        chunk.push(97);
    }
    big.paste(chunk.str());
    for i in 0..6 {
        big.paste("x");
    }
    ok(big.un >= 1 && big.un <= 3, "the byte budget drops old steps of a big text");
    ok(big.undo() && big.cps() == UNDO_BYTES / 2 + 5, "the newest step survives the budget");
    // through the Dom: textarea, single line, password
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    AT = "";
    PW = "";
    ML = "";
    frame2(&d);
    frame2(&d);
    click2(&d, TA, 20.0);
    type2(&d, "ab", "");
    type2(&d, "cd", "");
    type2(&d, "", "Enter");
    type2(&d, "ef", "");
    ok(same(AT, "abcd\nef"), "typed into the textarea");
    type2(&d, "", "C+z");
    ok(same(AT, ""), "Ctrl+Z undoes the typing run in the textarea and updates the bound value");
    type2(&d, "", "C+y");
    ok(same(AT, "abcd\nef"), "Ctrl+Y redoes");
    type2(&d, "", "C+z");
    type2(&d, "", "C+S+z");
    ok(same(AT, "abcd\nef"), "Ctrl+Shift+Z redoes");
    type2(&d, "", "Backspace");
    type2(&d, "", "Backspace");
    ok(same(AT, "abcd\n"), "backspace");
    type2(&d, "", "C+z");
    ok(same(AT, "abcd\nef"), "undo of a delete run");
    type2(&d, "", "C+y");
    ok(same(AT, "abcd\n"), "redo of a delete run");
    type2(&d, "Z", "");
    type2(&d, "", "C+y");
    ok(same(AT, "abcd\nZ"), "a new edit clears redo, Ctrl+Y does nothing");
    // a bound change from the program is not a step
    let un = edOf(&d, TA).un;
    AT = "program";
    frame2(&d);
    ok(same(d.strValue(TA), "program") && edOf(&d, TA).un == un, "a bound change pushes no step");
    // single line with maxlength
    click2(&d, MLID, 10.0);
    type2(&d, "abc", "");
    type2(&d, "de", "");
    type2(&d, "fg", "");
    ok(same(ML, "abcde"), "maxlength cuts typing");
    type2(&d, "", "C+z");
    ok(same(ML, ""), "Ctrl+Z in a one-line box (the cut-off typing was one run)");
    type2(&d, "", "C+y");
    ok(same(ML, "abcde"), "Ctrl+Y in a one-line box");
    // a focus change ends the typing run, so two sessions are two steps
    click2(&d, MLID, 10.0);
    type2(&d, "", "C+a");
    type2(&d, "", "Backspace");
    type2(&d, "ab", "");
    click2(&d, TA, 20.0);
    click2(&d, MLID, 10.0);
    type2(&d, "", "End");
    type2(&d, "cd", "");
    ok(same(ML, "abcd"), "typed in two focus sessions");
    type2(&d, "", "C+z");
    ok(same(ML, "ab"), "undo takes back only the second session");
    // Ctrl+Z / Ctrl+Y type nothing; plain z and y type letters
    type2(&d, "", "C+y");
    ok(same(ML, "abcd"), "Ctrl+Y typed no letter");
    type2(&d, "zy", "");
    ok(same(ML, "abcdz"), "plain z and y type (maxlength 5 cut the y)");
    type2(&d, "", "C+z");
    ok(same(ML, "abcd"), "and undo as typing");
    // a disabled box ignores undo and redo
    MLOFF = true;
    frame2(&d);
    type2(&d, "", "C+z");
    ok(same(ML, "abcd"), "a disabled box does not undo");
    MLOFF = false;
    frame2(&d);
    type2(&d, "", "C+z");
    ok(same(ML, "ab"), "and undoes again once enabled");
    // the history is per box
    click2(&d, PWID, 10.0);
    type2(&d, "", "C+z");
    ok(same(PW, "") && same(ML, "ab"), "undo in a box with no history does nothing to the others");
}
