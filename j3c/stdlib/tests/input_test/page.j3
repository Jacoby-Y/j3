// input_test: the shared test page, its state and event helpers.

module input_test;

// ---- the whole path ----------------------------------------------------------------------------------

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 14px; } input { font-family: \"T\"; font-size: 14px; color: #ffffff; } select { font-family: \"T\"; font-size: 14px; } .tb { width: 120px; padding: 4px; border: 1px solid #888888; } .rg { width: 200px; } .sl { width: 140px; padding: 4px; } .ta { width: 90px; padding: 4px; border: 1px solid #888888; } .sel { user-select: text; } .tb2 { width: 120px; padding: 4px; } .col { display: flex; flex-direction: column; gap: 10px; }";

#[singleton]
let TXT: string;

#[singleton]
let SEARCH: string;

#[singleton]
let VOL: f32;

#[singleton]
let LO: f32;

#[singleton]
let HI: f32;

#[singleton]
let PICK: string;

#[singleton]
let MULTI: string;

#[singleton]
let COLOR: string;

#[singleton]
let SUBMITS: int;

#[singleton]
let INPUTS: int;

#[singleton]
let CLICKS: int;

struct Ids {
    tb: int;
    search: int;
    rg: int;
    dual: int;
    sel: int;
    multi: int;
    color: int;
    btn: int;
}

#[singleton]
let IDS: Ids;

fn opt(d: &Dom, slot: int, value: string, label: string) {
    d.open(slot, d.tag("option"), 1);
    d.attrText(d.nodes.len - 1, value);
    d.text(label);
    d.close();
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let tb = d.open(0, d.tag("input"), 1);
    d.cls(tb, "tb");
    d.attrType(tb, "text");
    d.attrPlaceholder(tb, "name");
    if d.changed(tb) {
        TXT = d.strValue(tb);
        INPUTS += 1;
    }
    if d.submitted(tb) {
        SUBMITS += 1;
    }
    d.attrText(tb, TXT);
    d.close();
    let se = d.open(1, d.tag("input"), 1);
    d.cls(se, "tb");
    d.attrType(se, "search");
    if d.changed(se) {
        SEARCH = d.strValue(se);
    }
    d.attrText(se, SEARCH);
    d.close();
    let rg = d.open(2, d.tag("input"), 1);
    d.cls(rg, "rg");
    d.attrType(rg, "range");
    d.attrMin(rg, 0.0);
    d.attrMax(rg, 10.0);
    d.attrStep(rg, 1.0);
    if d.changed(rg) {
        VOL = d.value(rg);
    }
    d.attrValue(rg, VOL);
    d.close();
    let du = d.open(3, d.tag("input"), 1);
    d.cls(du, "rg");
    d.attrType(du, "range");
    d.attrMin(du, 0.0);
    d.attrMax(du, 100.0);
    d.attrStep(du, 5.0);
    d.attrMultiple(du, true);
    if d.changed(du) {
        LO = d.value(du);
        HI = d.highValue(du);
    }
    d.attrValue(du, LO);
    d.attrHigh(du, HI);
    d.close();
    let sl = d.open(4, d.tag("select"), 1);
    d.cls(sl, "sl");
    if d.changed(sl) {
        PICK = d.strValue(sl);
    }
    d.attrText(sl, PICK);
    opt(d, 0, "red", "Red");
    opt(d, 1, "green", "Green");
    opt(d, 2, "blue", "Blue");
    d.close();
    let ms = d.open(5, d.tag("select"), 1);
    d.cls(ms, "sl");
    d.attrMultiple(ms, true);
    if d.changed(ms) {
        MULTI = d.strValue(ms);
    }
    d.attrText(ms, MULTI);
    opt(d, 0, "a", "A");
    opt(d, 1, "b", "B");
    opt(d, 2, "c", "C");
    d.close();
    let co = d.open(6, d.tag("input"), 1);
    d.attrType(co, "color");
    if d.changed(co) {
        COLOR = d.strValue(co);
    }
    d.attrText(co, COLOR);
    d.close();
    let bt = d.open(7, d.tag("button"), 1);
    if d.clicked(bt) {
        CLICKS += 1;
    }
    d.close();
    d.close();
    IDS = Ids { tb: tb, search: se, rg: rg, dual: du, sel: sl, multi: ms, color: co, btn: bt };
    d.layout();
    dropdown.settle(d);
    d.endFrame();
}

/// Mouse state for the next frames: a press and release at `x, y` (a click).
fn click(d: &Dom, x: f32, y: f32) {
    d.simInput(x, y, false, 0.0);
    frame(d);
    d.simInput(x, y, true, 0.0);
    frame(d);
    d.simInput(x, y, false, 0.0);
    frame(d);
}

fn cx(d: &Dom, id: int): f32 {
    return d.absX(id) + d.nodes.items[id].w / 2.0;
}

fn cy(d: &Dom, id: int): f32 {
    return d.absY(id) + d.nodes.items[id].h / 2.0;
}

fn type(d: &Dom, text: string, names: string) {
    d.simKeys(text, names);
    frame(d);
}
