// input_test: rich text boxes with spans.

module input_test;

// ---- rich textarea: spans and atomic tokens -----------------------------------------------------------

#[singleton]
let RT: string;

#[singleton]
let RS: []Span;

#[singleton]
let RID: int;

fn frameR(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let ta = d.open(0, d.tag("input"), 1);
    d.cls(ta, "ta");
    d.attrType(ta, "textarea");
    d.attrRich(ta, true);
    if d.changed(ta) {
        RT = d.strValue(ta);
    }
    d.attrText(ta, RT);
    if d.changed(ta) {
        RS = d.spansValue(ta);
    }
    d.attrSpans(ta, RS);
    d.close();
    d.close();
    RID = ta;
    d.layout();
    d.endFrame();
}

fn typeR(d: &Dom, text: string, names: string) {
    d.simKeys(text, names);
    frameR(d);
}

fn clickR(d: &Dom, id: int, dx: f32) {
    let x = d.absX(id) + dx;
    let y = d.absY(id) + 10.0;
    d.simInput(x, y, false, 0.0);
    frameR(d);
    d.simInput(x, y, true, 0.0);
    frameR(d);
    d.simInput(x, y, false, 0.0);
    frameR(d);
}

fn sp1(mem: &Arena, a: int, n: int, kind: int): List<Span> {
    let l = List<Span>.new(mem);
    l.push(Span { start: a, len: n, kind: kind, data: "" });
    return l;
}

fn testRich(mem: &Arena, css: &Css) {
    // span maintenance in one function
    let l = sp1(mem, 2, 3, SPAN_BOLD);
    spanEdit(&l, 0, 0, 4, true);
    ok(l.items[0].start == 6 && l.items[0].len == 3, "an insert before a span shifts it");
    l = sp1(mem, 2, 3, SPAN_BOLD);
    spanEdit(&l, 3, 0, 4, false);
    ok(l.items[0].start == 2 && l.items[0].len == 7, "an insert inside a span grows it");
    l = sp1(mem, 2, 3, SPAN_BOLD);
    spanEdit(&l, 5, 0, 2, true);
    ok(l.items[0].len == 5, "typing at the end of a bold span inherits");
    l = sp1(mem, 2, 3, SPAN_BOLD);
    spanEdit(&l, 5, 0, 2, false);
    ok(l.items[0].len == 3, "an insert at the end without inherit does not grow");
    l = sp1(mem, 2, 3, SPAN_LINK);
    spanEdit(&l, 5, 0, 2, true);
    ok(l.items[0].len == 3, "a link does not inherit at its end");
    l = sp1(mem, 2, 3, SPAN_BOLD);
    spanEdit(&l, 2, 0, 2, true);
    ok(l.items[0].start == 4 && l.items[0].len == 3, "typing at the start of a span stays outside it");
    l = sp1(mem, 2, 3, SPAN_BOLD);
    spanEdit(&l, 0, 3, 0, false);
    ok(l.len == 1 && l.items[0].start == 0 && l.items[0].len == 2, "a delete over the front trims");
    l = sp1(mem, 2, 3, SPAN_BOLD);
    spanEdit(&l, 3, 1, 0, false);
    ok(l.items[0].start == 2 && l.items[0].len == 2, "a delete inside shrinks");
    l = sp1(mem, 2, 3, SPAN_BOLD);
    spanEdit(&l, 1, 6, 0, false);
    ok(l.len == 0, "a delete over all of a span removes it");
    l = sp1(mem, 2, 3, SPAN_MENTION);
    spanEdit(&l, 4, 1, 0, false);
    ok(l.len == 0, "a delete touching a token removes it");
    l = sp1(mem, 2, 0, SPAN_BOLD);
    spanEdit(&l, 9, 0, 1, true);
    ok(l.len == 0, "zero-length spans are dropped");

    // tokens: caret skips, delete is whole, selection snaps
    let e = Edit.new(mem);
    e.rich = true;
    e.set("hi x");
    ok(e.replaceWithToken(3, 4, "@Ann", SPAN_MENTION, "u1"), "a token replaces the trigger text");
    ok(same(e.str(), "hi @Ann") && e.cur == 7 && e.sp.len == 1 && same(e.sp.items[0].data, "u1"), "label is text, data is kept");
    e.insert(" ok");
    ok(e.sp.items[0].start == 3 && e.sp.items[0].len == 4, "typing after the chip leaves it alone");
    e.moveTo(7, false);
    e.left(false, false);
    ok(e.cur == 3, "Left jumps over the whole token");
    e.right(false, false);
    ok(e.cur == 7, "Right jumps over the whole token");
    e.moveTo(5, false);
    ok(e.cur == 3, "a click inside a token goes to the nearer edge");
    e.moveTo(0, false);
    e.moveTo(5, true);
    ok(e.anc == 0 && e.cur == 7, "dragging into a token covers it whole");
    e.moveTo(10, false);
    e.moveTo(5, true);
    ok(e.anc == 10 && e.cur == 3, "and from the right");
    e.moveTo(7, false);
    e.deleteBack(false);
    ok(same(e.str(), "hi  ok") && e.sp.len == 0 && e.cur == 3, "Backspace removes the token whole");
    e.undo();
    ok(same(e.str(), "hi @Ann ok") && e.sp.len == 1 && e.sp.items[0].start == 3, "undo restores the token span");
    e.moveTo(3, false);
    e.deleteFwd(false);
    ok(same(e.str(), "hi  ok") && e.sp.len == 0 && e.cur == 3, "Delete removes the token whole");
    e.undo();
    e.moveTo(0, false);
    e.insert("XY");
    ok(e.sp.items[0].start == 5, "an insert before a token shifts it");
    e.moveTo(4, false);
    e.right(true, false);
    ok(e.anc == 4 && e.cur == 5, "a selection edge before the token stays");
    e.right(true, false);
    ok(e.cur == 9, "extending into the token takes it whole");
    e.deleteSel();
    ok(same(e.str(), "XYhi ok") || same(e.str(), "XYhi  ok"), "deleting a selection over a token removes it");
    ok(e.sp.len == 0, "and its span");
    // a click-selected word inside a token label covers the token
    let w = Edit.new(mem);
    w.rich = true;
    w.set("a b");
    w.replaceWithToken(2, 3, "@Jane Doe", SPAN_EMOJI, "e");
    w.selectWord(6);
    ok(w.lo() == 2 && w.hi() == 11, "word select snaps outward to the token");

    // bold growth and trimming by real edits
    let b = Edit.new(mem);
    b.rich = true;
    b.set("hello world");
    b.anc = 0;
    b.cur = 5;
    ok(b.toggle(SPAN_BOLD) && b.sp.len == 1 && b.sp.items[0].start == 0 && b.sp.items[0].len == 5, "Ctrl+B bolds the selection");
    b.moveTo(3, false);
    b.insert("zz");
    ok(b.sp.items[0].len == 7, "typing inside bold grows it");
    b.moveTo(7, false);
    b.insert("!");
    ok(b.sp.items[0].len == 8, "typing at the end inherits bold");
    b.anc = 3;
    b.cur = 6;
    b.deleteSel();
    ok(b.sp.items[0].start == 0 && b.sp.items[0].len == 5, "deleting inside bold trims it");
    b.anc = 0;
    b.cur = 5;
    ok(b.toggle(SPAN_BOLD) && b.sp.len == 0, "toggling an all-bold selection unbolds");
    b.undo();
    ok(b.sp.len == 1 && b.sp.items[0].len == 5, "undo of the unbold restores the span");
    b.undo();
    ok(b.sp.len == 1 && b.sp.items[0].len == 8, "undo of the delete restores the longer span");
    // partial coverage turns the whole selection bold; italic is separate
    let c = Edit.new(mem);
    c.rich = true;
    c.set("hello world");
    c.anc = 0;
    c.cur = 5;
    c.toggle(SPAN_BOLD);
    c.anc = 2;
    c.cur = 9;
    c.toggle(SPAN_BOLD);
    ok(covered(&c.sp, SPAN_BOLD, 0, 9) && !covered(&c.sp, SPAN_BOLD, 0, 10), "a partly bold selection becomes all bold");
    c.toggle(SPAN_ITALIC);
    ok(covered(&c.sp, SPAN_ITALIC, 2, 9) && !covered(&c.sp, SPAN_ITALIC, 0, 9), "italic toggles on its own");
    let plain = Edit.new(mem);
    plain.set("abc");
    plain.selectAll();
    ok(!plain.toggle(SPAN_BOLD) && plain.sp.len == 0 && plain.un == 0, "a plain box ignores Ctrl+B");
    // a token inside a bold selection stays outside the bold span
    let t = Edit.new(mem);
    t.rich = true;
    t.set("ab c");
    t.replaceWithToken(2, 3, "@X", SPAN_MENTION, "x");
    t.selectAll();
    t.toggle(SPAN_BOLD);
    ok(covered(&t.sp, SPAN_BOLD, 0, 2) && !covered(&t.sp, SPAN_BOLD, 2, 4) && covered(&t.sp, SPAN_BOLD, 4, 5), "bold goes around a token");
    // a plain box never grows a span list
    let q = Edit.new(mem);
    q.insert("abc");
    q.deleteBack(false);
    q.moveTo(0, true);
    ok(q.sp.len == 0 && q.sp.items.len == 0, "a plain box allocates no spans");

    // boundaries: adjacent spans, a delete across several, a replace over an edge
    l = List<Span>.new(mem);
    l.push(Span { start: 0, len: 3, kind: SPAN_BOLD, data: "" });
    l.push(Span { start: 3, len: 3, kind: SPAN_ITALIC, data: "" });
    spanEdit(&l, 3, 0, 2, true);
    ok(l.items[0].len == 5 && l.items[1].start == 5 && l.items[1].len == 3, "typing between bold|italic extends the left one only");
    l = sp1(mem, 0, 3, SPAN_BOLD);
    l.push(Span { start: 3, len: 3, kind: SPAN_MENTION, data: "m" });
    spanEdit(&l, 3, 0, 2, true);
    ok(l.items[0].len == 5 && l.items[1].start == 5 && l.items[1].len == 3, "typing between bold|token shifts the token whole");
    l = sp1(mem, 0, 3, SPAN_BOLD);
    l.push(Span { start: 4, len: 4, kind: SPAN_MENTION, data: "m" });
    l.push(Span { start: 8, len: 4, kind: SPAN_ITALIC, data: "" });
    spanEdit(&l, 2, 4, 0, false);
    ok(l.len == 2 && l.items[0].len == 2 && l.items[1].kind == SPAN_ITALIC && l.items[1].start == 4 && l.items[1].len == 4, "a delete across spans trims, drops the half-hit token whole and shifts the rest");
    let r = Edit.new(mem);
    r.rich = true;
    r.set("hello world");
    r.anc = 0;
    r.cur = 5;
    r.toggle(SPAN_BOLD);
    r.anc = 3;
    r.cur = 8;
    r.insert("XY");
    ok(same(r.str(), "helXYrld") && r.sp.len == 1 && r.sp.items[0].start == 0 && r.sp.items[0].len == 5, "typing over a selection across a span edge");
    // UTF-8 next to and inside a token
    let u = Edit.new(mem);
    u.rich = true;
    u.set("é x");
    u.replaceWithToken(3, 4, "@Zoë", SPAN_MENTION, "z");
    ok(u.sp.items[0].start == 3 && u.sp.items[0].len == 5 && u.cur == 8, "a multibyte label keeps byte offsets");
    u.insert("é");
    u.moveTo(7, false);
    ok(u.cur == 8, "a caret on a continuation byte inside a token lands on its far edge");
    u.moveTo(4, false);
    ok(u.cur == 3, "and on the near edge");
    u.moveTo(10, false);
    u.deleteBack(false);
    ok(same(u.str(), "é @Zoë") && u.cur == 8 && u.sp.len == 1, "Backspace takes the multibyte char after the token");
    u.deleteBack(false);
    ok(same(u.str(), "é ") && u.cur == 3 && u.sp.len == 0, "then the token");
    u.deleteBack(false);
    u.deleteBack(false);
    ok(u.str().len == 0, "then the multibyte char before it");

    // recycling one box with thousands of tokens: span data lives in the box, arena use is flat, undo still has its data
    let am = Arena.create(8 * 1024 * 1024);
    let rb = Edit.new(&am);
    rb.rich = true;
    let tx = Text.new(&am);
    let used0 = 0;
    for i in 0..4000 {
        tx.clear();
        tx.pushStr("user-id-with-some-length-");
        tx.push(u8(48 + (i / 1000) % 10));
        tx.push(u8(48 + (i / 100) % 10));
        tx.push(u8(48 + (i / 10) % 10));
        tx.push(u8(48 + i % 10));
        rb.replaceWithToken(0, rb.text.len(), "@U", SPAN_MENTION, tx.str());
        if i % 200 == 199 && i < 3999 {
            rb.set("x");
        }
        if i == 1000 {
            used0 = am.used;
        }
    }
    ok(am.used == used0, "4000 token inserts into one box: no arena growth after warm-up");
    ok(rb.sp.len == 1 && same(rb.sp.items[0].data, "user-id-with-some-length-3999"), "the live token has its data");
    rb.undo();
    ok(rb.sp.len == 1 && same(rb.sp.items[0].data, "user-id-with-some-length-3998"), "undo restores the previous token's data after compaction");
    let kk = 0;
    let good = true;
    while kk < 30 && rb.undo() {
        kk += 1;
        let want = Text.new(&am);
        want.pushStr("user-id-with-some-length-");
        let n = 3998 - kk;
        want.push(u8(48 + (n / 1000) % 10));
        want.push(u8(48 + (n / 100) % 10));
        want.push(u8(48 + (n / 10) % 10));
        want.push(u8(48 + n % 10));
        if rb.sp.len != 1 || !same(rb.sp.items[0].data, want.str()) {
            good = false;
        }
    }
    ok(good && kk == 30, "30 more undo steps each restore their own token data");

    // through the Dom: Ctrl+B, bound spans, a program-set value
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    RT = "";
    RS = RS[0..0];
    frameR(&d);
    frameR(&d);
    clickR(&d, RID, 20.0);
    frameR(&d);
    typeR(&d, "hello", "");
    typeR(&d, "", "C+a");
    typeR(&d, "", "C+b");
    ok(same(RT, "hello") && RS.len == 1 && RS[0].kind == SPAN_BOLD && RS[0].start == 0 && RS[0].len == 5, "Ctrl+B writes the bound spans");
    typeR(&d, "", "C+z");
    ok(RS.len == 0, "Ctrl+Z takes the bold back and updates the bound spans");
    typeR(&d, "", "C+y");
    ok(RS.len == 1, "Ctrl+Y brings it back");
    typeR(&d, "", "End");
    typeR(&d, "!", "");
    ok(same(RT, "hello!") && RS.len == 1 && RS[0].len == 6, "typed text inherits bold through the bound path");
    // the program sets text and spans: the box takes both and the next frame is steady
    let mine = mem.alloc::<Span>(1);
    mine[0] = Span { start: 1, len: 2, kind: SPAN_ITALIC, data: "" };
    RT = "abcd";
    RS = mine;
    frameR(&d);
    frameR(&d);
    ok(edOf(&d, RID).sp.len == 1 && edOf(&d, RID).sp.items[0].kind == SPAN_ITALIC && edOf(&d, RID).sp.items[0].start == 1, "a program's spans reach the box");
    ok(RS.len == 1 && RS.ptr == mine.ptr, "an unchanged frame does not touch the bound variable");
    // a bad span (past the text, overlapping a token) is dropped
    let bad = mem.alloc::<Span>(3);
    bad[0] = Span { start: 0, len: 99, kind: SPAN_BOLD, data: "" };
    bad[1] = Span { start: 0, len: 2, kind: SPAN_MENTION, data: "m" };
    bad[2] = Span { start: 1, len: 2, kind: SPAN_BOLD, data: "" };
    RS = bad;
    frameR(&d);
    ok(edOf(&d, RID).sp.len == 1 && edOf(&d, RID).sp.items[0].kind == SPAN_MENTION, "out-of-range and token-overlapping spans are dropped");
    // color spans (syntax highlight) are not tokens, may overlap each other, and parse #rgb / #rrggbb / names
    let cs = mem.alloc::<Span>(2);
    cs[0] = Span { start: 0, len: 2, kind: SPAN_COLOR, data: "#ff0000" };
    cs[1] = Span { start: 1, len: 2, kind: SPAN_COLOR, data: "teal" };
    RT = "abcd";
    RS = cs;
    frameR(&d);
    frameR(&d);
    ok(edOf(&d, RID).sp.len == 2 && !isToken(SPAN_COLOR), "color spans reach the box and may overlap");
    ok(rich.parseRgb("#ff0000") == 0xff0000 && rich.parseRgb("#0f8") == 0x00ff88 && rich.parseRgb("teal") == 0x008080 && rich.parseRgb("#zz") == -1, "span colors parse");
    // setSelection: a find match, unfocused
    d.setSelection(RID, 1, 3);
    ok(edOf(&d, RID).anc == 1 && edOf(&d, RID).cur == 3, "setSelection selects lo..hi");
    d.setSelection(RID, 2, 99);
    ok(edOf(&d, RID).anc == 2 && edOf(&d, RID).cur == 4, "setSelection clamps to the text");
    // runtime token insert (what a completion popup does) with the layout and caret rect
    RT = "hi @ja";
    RS = RS[0..0];
    frameR(&d);
    frameR(&d);
    ok(d.insertToken(RID, 3, 6, "@Jane", SPAN_MENTION, "u7"), "insertToken replaces the trigger text");
    frameR(&d);
    ok(same(RT, "hi @Jane") && RS.len == 1 && RS[0].kind == SPAN_MENTION && same(RS[0].data, "u7") && d.caret(RID) == 8, "bound value and spans carry the token");
    ok(!d.insertToken(RID, 5, 99, "@x", SPAN_MENTION, "x"), "a range past the text is refused");
    lay(&d, RID);
    let st = d.nodes.items[RID].style;
    let font = fontOf(&d, st);
    let ed = edOf(&d, RID);
    ok(area.wid(ed, font, isBold(&d, st), ed.str(), 3, 8) > rich_plain(font, isBold(&d, st), "@Jane"), "a chip is wider than its label");
    // the program only echoes its binding while the box edits: spans shift and are not brought back stale
    RT = "ab cd";
    RS = RS[0..0];
    frameR(&d);
    frameR(&d);
    clickR(&d, RID, 20.0);
    typeR(&d, "", "C+a");
    typeR(&d, "", "C+b");
    typeR(&d, "", "Home");
    typeR(&d, "ZZ", "");
    frameR(&d);
    frameR(&d);
    ok(same(RT, "ZZab cd") && RS.len == 1 && RS[0].start == 2 && RS[0].len == 5, "typing before a span shifts the bound span");
    typeR(&d, "", "C+z");
    frameR(&d);
    frameR(&d);
    ok(RS.len == 1 && RS[0].start == 0 && RS[0].len == 5, "an echo frame after undo keeps the box's spans");
    // a program that replaces text and spans, in either order of its own writes, gets both
    RS = mem.alloc::<Span>(1);
    RS[0] = Span { start: 0, len: 2, kind: SPAN_BOLD, data: "" };
    RT = "xyz";
    frameR(&d);
    frameR(&d);
    ok(edOf(&d, RID).sp.len == 1 && edOf(&d, RID).sp.items[0].len == 2 && same(RT, "xyz"), "new text and new spans from the program both land");
    typeR(&d, "", "C+a");
    typeR(&d, "", "C+b");
    ok(RS.len == 1 && RS[0].len == 3 && same(RT, "xyz"), "the box's own edit replaced the bound spans");
    RT = "plain";
    frameR(&d);
    frameR(&d);
    ok(edOf(&d, RID).sp.len == 0, "new text alone drops the old spans and the echo does not bring them back");
    // idle frames with a rich box: no layouts, restyles or arena growth; same for the plain textarea
    typeR(&d, "!", "");
    let used1 = mem.used;
    let laid1 = d.laid;
    let re1 = d.restyled;
    for k in 0..300 {
        frameR(&d);
    }
    ok(d.laid == laid1 && d.restyled == re1 && mem.used == used1, "300 idle frames with a rich box: 0 layouts, 0 restyles, no arena growth");
    let p = Dom.new(mem, css);
    p.setFrameMs(16.0);
    p.simInput(-5.0, -5.0, false, 0.0);
    AT = "plain text";
    frame2(&p);
    frame2(&p);
    click2(&p, TA, 20.0);
    type2(&p, "x", "");
    for k in 0..5 {
        frame2(&p);
    }
    let used2 = mem.used;
    let laid2 = p.laid;
    let re2 = p.restyled;
    for k in 0..300 {
        frame2(&p);
    }
    ok(p.laid == laid2 && p.restyled == re2 && mem.used == used2, "300 idle frames with a plain textarea: unchanged");
    ok(edOf(&p, TA).sp.len == 0 && edOf(&p, TA).sp.items.len == 0 && edOf(&p, TA).dn == 0, "a plain textarea holds no span storage");
}
