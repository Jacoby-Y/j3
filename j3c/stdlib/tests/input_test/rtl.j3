// input_test: emoji, RTL, ligature carets and percentage edges.

module input_test;

fn rich_plain(font: Font, bold: bool, s: string): f32 {
    return game.textWidth(font, []u8 { ptr: s.ptr, len: s.len }, bold);
}

/// An input whose font chain holds a color emoji font: the caret after "a🥳" is `textWidth` of it (scaled strike), not 109 px.
fn testEmojiCaret(mem: &Arena) {
    let ep = "/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf";
    if game.tryLoadFont(ep, 14).raw == 0 {
        printLn("emoji caret: SKIPPED (no Noto Color Emoji)");
        return;
    }
    let css = Css.new(mem);
    parse(&css, "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } @font-face { font-family: \"E\"; src: url(\"/usr/share/fonts/truetype/noto/NotoColorEmoji.ttf\"); } input { font-family: \"T\", \"E\"; font-size: 14px; } .tb { width: 200px; padding: 4px; border: 1px solid #888888; }", "emoji.css", 1);
    ok(css.warns.len == 0, "emoji caret sheet parses");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    IT = "";
    COPEN = false;
    frameI(&d);
    frameI(&d);
    d.focusNode(CID);
    frameI(&d);
    d.simKeys("a🥳", "");
    frameI(&d);
    frameI(&d);
    ok(same(IT, "a🥳"), "the emoji was typed");
    let font = fontOf(&d, d.nodes.items[CID].style);
    let want = game.textWidth(font, []u8 { ptr: IT.ptr, len: IT.len }, false);
    ok(want > 10.0 && want < 40.0, "a + emoji measure well under the 109 px strike");
    let cr = d.caretRect(CID);
    near(cr.x - d.absX(CID) - 5.0, want, 0.5, "the caret after the emoji is textWidth of the text (1px border + 4px padding)");
}

/// A text box with right-to-left text: click puts the caret at the byte under the pointer, a selection across a
/// direction change is two rectangles, and Backspace / Delete / Left / Right stay in logical order.
fn testRtlInput(mem: &Arena) {
    let dv = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";
    if game.tryLoadFont(dv, 16).raw == 0 || !game.textShaping() {
        printLn("rtl input: SKIPPED (no DejaVu or no HarfBuzz)");
        return;
    }
    let css = Css.new(mem);
    parse(&css, "@font-face { font-family: \"T\"; src: url(\"/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf\"); } input { font-family: \"T\"; font-size: 16px; } .tb { width: 300px; padding: 4px; border: 1px solid #888888; }", "rtl.css", 1);
    ok(css.warns.len == 0, "rtl sheet parses");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    IT = "";
    COPEN = false;
    frameI(&d);
    frameI(&d);
    d.focusNode(CID);
    frameI(&d);
    d.simKeys("abc אבג def", "");
    frameI(&d);
    frameI(&d);
    ok(same(IT, "abc אבג def"), "mixed text typed");
    let font = fontOf(&d, d.nodes.items[CID].style);
    let t = []u8 { ptr: IT.ptr, len: IT.len };
    let e = &d.eds.items[d.nodes.items[CID].edit];
    ok(e.cur == IT.len, "caret at the end");
    // caret rect follows the visual x of the end (right edge of 'def' = total width)
    near(d.caretRect(CID).x - d.absX(CID) - 5.0, game.textCaretX(font, t, false, IT.len), 0.5, "caret rect is the visual x");
    // click at each boundary of the hebrew letters (bytes 6 and 8): the caret lands there
    let ids = [6, 8];
    for q in 0..2 {
        let want = ids[q];
        let x = d.absX(CID) + 5.0 + game.textCaretX(font, t, false, want);
        d.simInput(x, d.absY(CID) + 10.0, false, 0.0);
        frameI(&d);
        d.simInput(x, d.absY(CID) + 10.0, true, 0.0);
        frameI(&d);
        d.simInput(x, d.absY(CID) + 10.0, false, 0.0);
        frameI(&d);
        ok(e.cur == want, "click in the rtl run puts the caret at the byte under the pointer");
    }
    // selection across the boundary: two rectangles, made with shift+Left from the end of "abc אבג"
    e.moveTo(8, false);
    d.simKeys("", "S+Left");
    frameI(&d);
    ok(e.cur == 6 && e.anc == 8, "shift+left extends logically");
    ok(game.textSelRects(font, t, false, 2, 6) == 2, "a selection across a direction change is two rectangles");
    // Backspace removes the character before the caret in logical order (the aleph's neighbour), Delete the one after
    e.moveTo(8, false);
    d.simKeys("", "Backspace");
    frameI(&d);
    ok(same(IT, "abc אג def") && e.cur == 6, "backspace is logical");
    d.simKeys("", "Delete");
    frameI(&d);
    ok(same(IT, "abc א def") && e.cur == 6, "delete is logical");
    d.simKeys("", "Left");
    frameI(&d);
    ok(e.cur == 4, "left is logical (one character toward the start of the text)");
    ok(game.textSelRects(font, []u8 { ptr: IT.ptr, len: IT.len }, false, 2, 4) == 1, "a one-letter rtl run next to ltr text merges into one rectangle");
}

/// A rich line with an RTL span: the selection rectangles light the glyphs of the range (not the span between two carets), and a
/// long pasted bidi line is hit tested in linear-ish time.
fn testRtlRich(mem: &Arena) {
    let dv = "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf";
    let font = game.tryLoadFont(dv, 16);
    if font.raw == 0 || !game.textShaping() {
        printLn("rtl rich: SKIPPED (no DejaVu or no HarfBuzz)");
        return;
    }
    let e = Edit.new(mem);
    e.set("abc אבג def");
    e.sp.push(Span { start: 4, len: 6, kind: SPAN_BOLD, data: "" });
    let wa = game.textWidth(font, []u8 { ptr: "abc ".ptr, len: 4 }, false);
    let wb = game.textWidth(font, []u8 { ptr: "אבג".ptr, len: 6 }, true);
    let wal = game.textWidth(font, []u8 { ptr: "א".ptr, len: 2 }, true);
    // bytes 6..10 are the two left-most glyphs of the bold RTL segment
    let n = rich.selRects(&e, font, false, 0, e.text.len(), 6, 10);
    ok(n == 1, "an RTL segment range is one rectangle");
    near(rich.rectX(0), wa, 1.5, "its rectangle starts at the segment's left edge");
    near(rich.rectX(0) + rich.rectW(0), wa + wb - wal, 1.5, "and stops before the first letter, which sits at the right");
    // across three segments: one rectangle each
    n = rich.selRects(&e, font, false, 0, e.text.len(), 2, 12);
    ok(n == 3, "a selection across three segments is three rectangles");
    near(rich.rectX(1), wa, 1.5, "the middle one is the whole RTL segment");
    near(rich.rectW(1), wb, 1.5, "at its full width");
    // plain text (no spans) stays one rectangle per run
    // hit test of a long line: 'a' x 10000, a hebrew word, then 1500 hebrew letters in one run
    let t = Text.new(mem);
    for i in 0..5000 { t.pushStr("ab"); }
    t.pushStr(" אבג ");
    for i in 0..1500 { t.pushStr("ש"); }
    let s = t.str();
    let w = game.textWidth(font, []u8 { ptr: s.ptr, len: s.len }, false);
    let t0 = game.micros();
    let i1 = field.indexAt(font, false, s, 0, 400.0);
    let i2 = field.indexAt(font, false, s, 0, w - 200.0);
    let ms = (game.micros() - t0) / 1000;
    ok(i1 > 0 && i1 < 100, "a click near the start of a long bidi line lands near the start");
    ok(i2 > 10000, "a click near the visual end lands in the rtl tail");
    printLn(`long bidi hit test: {ms} ms for two clicks`);
    ok(ms < 100, "hit testing a 8k-character bidi line is fast");
}

/// Ligature (lam-alef) and joined Arabic: the caret x stays inside the run for every boundary and nothing crashes.
fn testLigatureBounds() {
    let font = game.tryLoadFont("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 24);
    if font.raw == 0 || !game.textShaping() {
        printLn("ligature caret: SKIPPED");
        return;
    }
    let t = "لا سلام";
    let b = []u8 { ptr: t.ptr, len: t.len };
    let w = game.textWidth(font, b, false);
    let i = 0;
    while i <= t.len {
        if i < t.len && int(b[i]) >= 128 && int(b[i]) < 192 { i += 1; continue; }
        let x = game.textCaretX(font, b, false, i);
        ok(x >= -1.0 && x <= w + 1.0, "ligature caret x stays within the line");
        let k = game.textIndexAt(font, b, false, x);
        ok(k >= 0 && k <= t.len, "and maps to a valid byte");
        i += 1;
    }
}

fn edgeFrame(d: &Dom, area: bool): int {
    d.beginFrame(Vec2 { x: 400.0, y: 300.0 });
    inputs.begin(d);
    let id = d.open(0, d.tag("input"), 1);
    d.attrType(id, if area { "textarea" } else { "text" });
    d.attrText(id, "abc");
    d.close(); d.layout(); d.endFrame();
    return id;
}

fn testPercentageEdges(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, "input { box-sizing: border-box; width: 200px; max-width: 150px; height: 150px; padding: 10%; border: 4px solid #888888; border-width: 1%; }", "percentage-edges.css", 0);
    ok(css.warns.len == 0, "percentage input edge sheet parses");
    for type in 0..2 {
        let d = Dom.new(mem, &css);
        d.setFallbackFont("examples/big_ui_test/assets/font.ttf");
        d.simInput(-5.0, -5.0, false, 0.0);
        let id = edgeFrame(&d, type == 1);
        d.focusNode(id);
        edgeFrame(&d, type == 1);
        d.eds.items[d.nodes.items[id].edit].moveTo(0, false);
        let caret = d.caretRect(id);
        near(caret.x, 44.0, 0.01, "caret x uses containing-width padding and border");
        near(caret.y, 44.0, 0.01, "caret y uses containing-width padding and border");
        d.simInput(45.0, 50.0, true, 0.0);
        edgeFrame(&d, type == 1);
        ok(d.caret(id) == 0, "mouse hit uses the same content origin as layout and caret");
    }
}
