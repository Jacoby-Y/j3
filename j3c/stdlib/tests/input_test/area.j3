// input_test: textarea editing.

module input_test;

// ---- textarea, password, maxlength, IME ---------------------------------------------------------------

#[singleton]
let AT: string;

#[singleton]
let PW: string;

#[singleton]
let ML: string;

#[singleton]
let TA: int;

#[singleton]
let PWID: int;

#[singleton]
let MLID: int;

#[singleton]
let ASUBMITS: int;

#[singleton]
let MLOFF: bool;

fn frame2(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let ta = d.open(0, d.tag("input"), 1);
    d.cls(ta, "ta");
    d.attrType(ta, "textarea");
    d.attrRows(ta, 3.0);
    if d.changed(ta) {
        AT = d.strValue(ta);
    }
    if d.submitted(ta) {
        ASUBMITS += 1;
    }
    d.attrText(ta, AT);
    d.close();
    let pw = d.open(1, d.tag("input"), 1);
    d.cls(pw, "tb");
    d.attrType(pw, "password");
    if d.changed(pw) {
        PW = d.strValue(pw);
    }
    d.attrText(pw, PW);
    d.close();
    let ml = d.open(2, d.tag("input"), 1);
    d.cls(ml, "tb");
    d.attrType(ml, "text");
    d.attrMaxLen(ml, 5.0);
    d.attrDisabled(ml, MLOFF);
    if d.changed(ml) {
        ML = d.strValue(ml);
    }
    d.attrText(ml, ML);
    d.close();
    d.close();
    TA = ta;
    PWID = pw;
    MLID = ml;
    d.layout();
    d.endFrame();
}

fn edOf(d: &Dom, id: int): &Edit {
    return &d.eds.items[d.nodes.items[id].edit];
}

/// Lay the textarea's lines out as its paint would (these frames paint nothing).
fn lay(d: &Dom, id: int) {
    let st = d.nodes.items[id].style;
    area.layout(edOf(d, id), fontOf(d, st), isBold(d, st), d.nodes.items[id].w - 10.0);
}

/// What the paint does for the view after a caret move.
fn follow(d: &Dom, id: int) {
    let n = &d.nodes.items[id];
    area.follow(edOf(d, id), true, f32(fontLine(fontOf(d, n.style))), n.h - 10.0);
}

fn type2(d: &Dom, text: string, names: string) {
    d.simKeys(text, names);
    frame2(d);
}

fn click2(d: &Dom, id: int, dx: f32) {
    let x = d.absX(id) + dx;
    let y = d.absY(id) + 10.0;
    d.simInput(x, y, false, 0.0);
    frame2(d);
    d.simInput(x, y, true, 0.0);
    frame2(d);
    d.simInput(x, y, false, 0.0);
    frame2(d);
}

fn testArea(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    AT = "";
    PW = "";
    ML = "";
    frame2(&d);
    frame2(&d);
    ok(d.fontMissing == 0, "font loaded (area)");
    ok(d.nodes.items[TA].h > 40.0, "a textarea of 3 rows is taller than a line");
    // ---- lines
    click2(&d, TA, 20.0);
    ok(d.focused() == TA, "a press focuses the textarea");
    type2(&d, "ab", "");
    type2(&d, "", "Enter");
    type2(&d, "cd", "");
    ok(same(AT, "ab\ncd"), "Enter inserts a newline");
    let e = edOf(&d, TA);
    lay(&d, TA);
    ok(e.ls.len == 2 && area.lineOf(e, e.cur) == 1, "two lines, caret on the second");
    type2(&d, "", "Up");
    ok(e.cur >= 1 && e.cur <= 2, "Up moves to the line above at the same column");
    type2(&d, "", "Down");
    ok(e.cur >= 4 && e.cur <= 5, "Down returns to the column");
    type2(&d, "", "Up");
    type2(&d, "", "Up");
    ok(e.cur == 0, "Up on the first line goes to the start");
    type2(&d, "", "Down");
    type2(&d, "", "Down");
    ok(e.cur == 5, "Down on the last line goes to the end");
    type2(&d, "", "Home");
    ok(e.cur == 3, "Home goes to the start of the line");
    type2(&d, "", "End");
    ok(e.cur == 5, "End goes to the end of the line");
    type2(&d, "", "C+Home");
    ok(e.cur == 0, "Ctrl+Home goes to the start of the text");
    type2(&d, "", "C+End");
    ok(e.cur == 5, "Ctrl+End goes to the end of the text");
    type2(&d, "", "C+Enter");
    ok(ASUBMITS == 1 && same(AT, "ab\ncd"), "Ctrl+Enter submits and adds no newline");
    // trailing newline and empty lines are lines
    AT = "a\n";
    frame2(&d);
    lay(&d, TA);
    ok(e.ls.len == 2, "a trailing newline starts an empty line");
    AT = "a\n\nb";
    frame2(&d);
    lay(&d, TA);
    ok(e.ls.len == 3 && e.ls.items[1] == 2 && e.ls.items[2] == 3, "an empty line between is a line");
    e.moveTo(2, false);
    type2(&d, "", "Down");
    ok(e.cur == 3, "Down from an empty line");
    // words do not cross a newline
    AT = "foo\nbar";
    frame2(&d);
    e.moveTo(7, false);
    type2(&d, "", "C+Left");
    ok(e.cur == 4, "Ctrl+Left stops at the line start");
    // text the box would clean (CRLF) must not be re-set every frame, or the caret could never stay
    AT = "a\r\nb";
    frame2(&d);
    let v0 = e.ver;
    frame2(&d);
    frame2(&d);
    ok(same(e.str(), "a\nb") && e.ver == v0, "a value with CR settles after one set");
    e.moveTo(3, false);
    type2(&d, "X", "");
    ok(same(AT, "a\nbX"), "typing after it works");
    // soft wrap at spaces
    AT = "alpha beta gamma delta epsilon zeta";
    frame2(&d);
    lay(&d, TA);
    ok(e.ls.len > 2, "long text wraps");
    ok(e.ls.items[1] > 0 && AT[e.ls.items[1] - 1] == 32, "a soft break comes after a space");
    // End at a mid-word soft break stays at the end of the visual line
    AT = "WWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWWW";
    frame2(&d);
    lay(&d, TA);
    ok(e.ls.len > 1 && AT[e.ls.items[1] - 1] != 32, "a long word wraps mid-word");
    type2(&d, "", "C+Home");
    type2(&d, "", "End");
    ok(e.cur == e.ls.items[1] && area.caretLine(e) == 0, "End stays on the first visual line");
    type2(&d, "", "End");
    ok(e.cur == e.ls.items[1] && area.caretLine(e) == 0, "End twice stays");
    type2(&d, "", "Home");
    ok(e.cur == 0, "Home goes to the start of that line");
    type2(&d, "", "End");
    type2(&d, "", "Down");
    ok(area.caretLine(e) == 1, "Down leaves it");
    type2(&d, "", "Up");
    ok(area.caretLine(e) == 0, "Up comes back");
    type2(&d, "", "C+Home");
    type2(&d, "", "Right");
    ok(area.caretLine(e) == 0 && e.cur == 1, "a plain caret move drops it");
    // a click past the end of the first visual line keeps the caret on it
    click2(&d, TA, d.nodes.items[TA].w - 2.0);
    ok(e.cur == e.ls.items[1] && area.caretLine(e) == 0, "a click at a mid-word soft break stays on the clicked line");
    type2(&d, "", "Down");
    ok(area.caretLine(e) == 1, "Down from the wrap-boundary caret goes to the next line");
    type2(&d, "", "Up");
    ok(area.caretLine(e) == 0, "Up from line 2 returns to line 1");
    type2(&d, "", "C+Home");
    follow(&d, TA);
    ok(e.ty == 0.0, "scrolled to the top");
    for i in 0..30 {
        frame2(&d);
    }
    let lh2 = f32(fontLine(fontOf(&d, d.nodes.items[TA].style)));
    let cy = d.absY(TA) + 5.0 + lh2 * 1.5 - e.ty;
    d.simInput(d.absX(TA) + 5.0, cy, false, 0.0);
    frame2(&d);
    d.simInput(d.absX(TA) + 5.0, cy, true, 0.0);
    frame2(&d);
    d.simInput(d.absX(TA) + 5.0, cy, false, 0.0);
    frame2(&d);
    ok(e.cur == e.ls.items[1] && area.caretLine(e) == 1, "a click at the start of the line after a mid-word wrap is on that line");
    type2(&d, "", "Up");
    ok(area.caretLine(e) == 0, "Up from it lands on line 1");
    type2(&d, "", "Right");
    ok(e.cur == e.ls.items[1] + 1 && area.caretLine(e) == 1, "Right moves on into the next line");
    type2(&d, "", "Left");
    type2(&d, "", "Left");
    ok(area.caretLine(e) == 0, "Left walks back along the first line");
    // scrolling follows the caret
    let t = Text.new(mem);
    for i in 0..12 {
        t.pushStr("row\n");
    }
    AT = t.str();
    frame2(&d);
    type2(&d, "", "C+End");
    lay(&d, TA);
    follow(&d, TA);
    ok(e.ty > 0.0, "the view scrolls to the caret");
    type2(&d, "", "C+Home");
    follow(&d, TA);
    ok(e.ty == 0.0, "and back to the top");
    type2(&d, "", "PageDown");
    ok(area.lineOf(e, e.cur) >= 2, "PageDown moves several lines");
    type2(&d, "", "PageUp");
    ok(e.cur == 0, "PageUp back to the top");
    // ---- word and line select
    AT = "foo bar\nbaz";
    frame2(&d);
    click2(&d, TA, 40.0);
    click2(&d, TA, 40.0);
    ok(same(e.selected(), "bar") || same(e.selected(), "foo"), "double click selects a word");
    click2(&d, TA, 40.0);
    ok(same(e.selected(), "foo bar"), "triple click selects the line");
    // ---- IME: composition is drawn, not inserted, and keys wait
    AT = "ab";
    frame2(&d);
    e.moveTo(2, false);
    d.simKeys("", "Backspace");
    d.simK.comp = "にほ";
    frame2(&d);
    ok(same(AT, "ab"), "keys are left to the IME while it composes");
    d.simKeys("X", "");
    d.simK.comp = "に";
    frame2(&d);
    ok(same(AT, "abX"), "text committed beside a new composition is kept");
    type2(&d, "日本", "");
    ok(same(AT, "abX日本"), "the committed text is inserted");
    // ---- password: text is real, the mask has one glyph per code point
    click2(&d, PWID, 20.0);
    ok(d.focused() == PWID, "focus the password box");
    type2(&d, "hé日", "");
    ok(same(PW, "hé日"), "a password box edits like a text box");
    let pe = edOf(&d, PWID);
    ok(pe.maskOf("hé日").len == 9, "one mask glyph per code point");
    ok(textedit.toMask("hé日", 3) == 6 && textedit.fromMask("hé日", 6) == 3 && textedit.fromMask("hé日", 99) == 6, "mask positions map back to bytes");
    // ---- maxlength counts code points
    click2(&d, MLID, 20.0);
    type2(&d, "日本語日本語", "");
    ok(same(ML, "日本語日本"), "maxlength cuts at 5 code points");
    type2(&d, "x", "");
    ok(same(ML, "日本語日本"), "a full box takes nothing");
    type2(&d, "", "S+Left");
    type2(&d, "xy", "");
    ok(same(ML, "日本語日x"), "typing over a selection frees room");
    e.set("a");
    ok(same(e.str(), "a"), "set is not capped by maxlen");
}

// ---- PRIMARY selection ----------------------------------------------------------------------------------

/// A middle click at `dx` px into box `id`.
fn middle2(d: &Dom, id: int, dx: f32) {
    let x = d.absX(id) + dx;
    let y = d.absY(id) + 10.0;
    d.simInput(x, y, false, 0.0);
    frame2(d);
    d.simMiddle(true);
    frame2(d);
    d.simMiddle(false);
    frame2(d);
}

fn testPrimary(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simPrimary("");
    d.simInput(-5.0, -5.0, false, 0.0);
    AT = "";
    PW = "";
    ML = "";
    MLOFF = false;
    frame2(&d);
    frame2(&d);
    click2(&d, TA, 20.0);
    type2(&d, "hello world", "");
    let e = edOf(&d, TA);
    // a Shift+caret key settles a selection
    type2(&d, "", "C+Home");
    for i in 0..5 { type2(&d, "", "S+Right"); }
    ok(same(d.primary(), "hello"), "Shift+Right selection becomes PRIMARY");
    d.setSelection(TA, 2, 7);
    let r = d.selection(TA);
    ok(r.lo == 2 && r.hi == 7 && same(d.selectedText(TA), "llo w"), "selection / selectedText after setSelection");
    ok(same(d.primary(), "hello"), "setSelection alone does not set PRIMARY");
    type2(&d, "", "C+a");
    ok(same(d.primary(), "hello world"), "Ctrl+A sets PRIMARY");
    // a mouse drag settles on release
    d.simPrimary("old");
    let x0 = d.absX(TA) + 5.0;
    let y0 = d.absY(TA) + 10.0;
    d.simInput(x0, y0, false, 0.0);
    frame2(&d);
    d.simInput(x0, y0, true, 0.0);
    frame2(&d);
    d.simInput(x0 + 200.0, y0, true, 0.0);
    frame2(&d);
    ok(same(d.primary(), "old"), "nothing is set mid-drag");
    d.simInput(x0 + 200.0, y0, false, 0.0);
    frame2(&d);
    ok(same(d.primary(), e.selected()) && e.hasSel(), "a drag sets PRIMARY on mouse up");
    // middle click pastes at the click point
    AT = "hello world";
    frame2(&d);
    d.simPrimary("XYZ");
    middle2(&d, TA, 5.0);
    let at = d.caret(TA) - 3;
    ok(same(AT, "hXYZello world") || same(AT, "XYZhello world"), "middle click inserts PRIMARY at the click");
    ok(at >= 0 && same(AT[at..at + 3], "XYZ"), "the caret ends after the pasted text");
    type2(&d, "", "C+z");
    ok(same(AT, "hello world"), "one Ctrl+Z removes the middle-click paste");
    // middle click on an unfocused box focuses it; maxlength is honoured
    middle2(&d, MLID, 5.0);
    ok(d.focused() == MLID && same(ML, "XYZ"), "middle click focuses and pastes into another box");
    middle2(&d, MLID, d.nodes.items[MLID].w - 4.0);
    ok(same(ML, "XYZXY"), "a middle-click paste honours maxlength");
    // disabled box ignores it
    MLOFF = true;
    ML = "";
    frame2(&d);
    middle2(&d, MLID, 5.0);
    ok(ML.len == 0, "a disabled box ignores a middle click");
    MLOFF = false;
    frame2(&d);
    // password: never sets PRIMARY
    d.simPrimary("keep");
    click2(&d, PWID, 5.0);
    type2(&d, "secret", "");
    type2(&d, "", "C+a");
    type2(&d, "", "S+Left");
    ok(same(d.primary(), "keep"), "a password box never sets PRIMARY");
    // noprimary: neither sets nor pastes
    d.attrNoPrimary(TA, true);
    click2(&d, TA, 20.0);
    type2(&d, "", "C+a");
    ok(same(d.primary(), "keep"), "a noprimary box does not set PRIMARY");
    middle2(&d, TA, 5.0);
    ok(same(AT, "hello world"), "a noprimary box ignores a middle click");
}
