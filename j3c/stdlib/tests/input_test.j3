// Tests for the input widgets: j3.ui.textedit (UTF-8 caret, selection, delete), keys.parse, csv, slider math,
// colorpick (hex, HSV), popup placement, and the whole path through j3.ui.dom + j3.ui.inputs + j3.ui.dropdown
// with synthetic mouse and keys (text box, search, range and two-thumb range, select, multiple, color, Tab).
// Run from the repo root, headless (SDL_ttf measures text; no window opens):
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/input_test.j3
// Panics on the first failed check.

module input_test;

use j3.game;
use j3.game.fontLine;
use j3.game.Font;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ same, Text };
use j3.ui.colorpick;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.csv;
use j3.ui.dom.{ Dom, fontOf, isBold };
use j3.ui.inputs;
use j3.ui.keys;
use j3.ui.dropdown;
use j3.ui.popup;
use j3.ui.slider;
use j3.ui.area;
use j3.ui.field;
use j3.ui.rich;
use j3.ui.textedit;
use j3.ui.textsel;
use j3.ui.spans.{ covered, isToken, Span, spanEdit, SPAN_BOLD, SPAN_COLOR, SPAN_EMOJI, SPAN_ITALIC, SPAN_LINK, SPAN_MENTION };
use j3.ui.textedit.{ Edit, UNDO_BYTES, UNDO_CAP };
use j3.memory.List;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    let d = a - b;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > tol {
        printLn(`{a} vs {b}`);
    }
    ok(d <= tol, msg);
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    testPercentageEdges(&mem);
    testEdit(&mem);
    testKeys();
    testCsv();
    testSlider();
    testColor(&mem);
    testPopup();
    let css = Css.new(&mem);
    parse(&css, SHEET, "input.css", 1);
    ok(css.warns.len == 0, "the test sheet parses with no warning");
    testFlow(&mem, &css);
    testManyOptions(&mem, &css);
    testArea(&mem, &css);
    testPrimary(&mem, &css);
    testUndo(&mem, &css);
    testRich(&mem, &css);
    testCaret(&mem, &css);
    testTwoBoxes(&mem, &css);
    testFocusHook(&mem, &css);
    testSelect(&mem, &css);
    testEmojiCaret(&mem);
    testRtlInput(&mem);
    testRtlRich(&mem);
    testLigatureBounds();
    printLn(`input_test ok, checks passed: {CHECKS}`);
}
