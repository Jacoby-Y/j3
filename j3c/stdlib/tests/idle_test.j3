// Idle frame skipping (plan 029 chunk 26): the loop's decision (`game.idleSleepMs`) and what a Dom reports (`Dom.idleMs`) with a fake
// clock, no window. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/idle_test.j3 --headless

module idle_test;

use j3.app;
use j3.game;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.dom.Dom;

#[singleton]
let TB: int;
#[singleton]
let CANVAS: bool;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn frame(d: &Dom) {
    d.simKeys("", ""); // fake keys: no window, so no keyboard to poll
    d.beginFrame(Vec2 { x: 300.0, y: 200.0 });
    d.open(0, d.tag("div"), 1);
    TB = d.open(0, d.tag("input"), 1);
    d.attrType(TB, "text");
    d.attrAria(TB, "Box");
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn main() {
    // the decision: sleep only for a hosted UI, when allowed, with something not yet due
    ok(game.idleSleepMs(true, true, 100, 250) == 100, "sleeps until the deadline");
    ok(game.idleSleepMs(true, true, game.IDLE_FOREVER, 250) == 250, "capped");
    ok(game.idleSleepMs(true, true, 0, 250) == 0, "due now: no sleep");
    ok(game.idleSleepMs(false, true, 100, 250) == 0, "no UI hosted: draws every frame");
    ok(game.idleSleepMs(true, false, 100, 250) == 0, "tests and captures never sleep");

    ok(game.idleClampWake(250, 1100, 1000) == 100, "wakeAt shortens the sleep");
    ok(game.idleClampWake(250, 2000, 1000) == 250, "a far wakeAt keeps the cap");
    ok(game.idleClampWake(250, 990, 1000) == 0, "a passed wakeAt runs a frame now");
    ok(game.idleClampWake(0, 1100, 1000) == 0, "wakeAt never makes a busy loop sleep");
    // a 500 ms blink over 5 s idle: wakes land on the edges (cap 250 adds one between)
    let wakes = 0;
    let t = 0;
    let edges = 0;
    while t < 5000 {
        let next = (t / 500 + 1) * 500;
        let ms = game.idleClampWake(game.idleSleepMs(true, true, game.IDLE_FOREVER, 500), next, t);
        t += ms;
        wakes += 1;
        if t % 500 == 0 { edges += 1; }
    }
    ok(wakes == 10 && edges == 10, "blink: 10 wakes in 5 s, each on a 500 ms edge");

    ok(app.idleAllowed(true, 0), "no systems: may sleep");
    ok(!app.idleAllowed(true, 1), "a registered system keeps the loop awake");
    ok(!app.idleAllowed(false, 0), "idleSkip(false)");

    // fake clock: the loop sleeps 4 times in a second of 250 ms ticks and not at all for a moving UI
    let slept = 0;
    let now = 0;
    while now < 1000 {
        let ms = game.idleSleepMs(true, true, game.IDLE_FOREVER, 250);
        if ms > 0 { slept += 1; now += ms; } else { now += 16; }
    }
    ok(slept == 4, "an idle second is 4 wakes, not 60 frames");

    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    frame(&d);
    frame(&d);
    ok(d.idleMs() == game.IDLE_FOREVER, "a still page sleeps until an event");
    d.requestFrame();
    ok(d.idleMs() == 0, "requestFrame asks for a frame");
    ok(d.idleMs() == game.IDLE_FOREVER, "and it is consumed");
    d.simInput(5.0, 5.0, true, 0.0);
    frame(&d);
    ok(d.idleMs() == 0, "a held button keeps frames coming");
    d.simInput(5.0, 5.0, false, 0.0);
    d.simOn = false;
    frame(&d);
    frame(&d);
    ok(d.idleMs() == game.IDLE_FOREVER, "released: idle again");

    printLn("idle_test ok");
}
