// The paint memo (`dom/paintmemo.j3`): boxes painted from it queue exactly what the long way queues, an identical frame queues the
// identical batch and works nothing out again, and a changed box works out only its own new row. Needs GL, no visible window:
// SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/paintmemo_test.j3 --headless
module paintmemo_test;

use j3.game;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

#[singleton]
let CHECKS: int;
/// The frame number: the inline width and `.swap`'s class follow it when `MOVE` is on.
#[singleton]
let STEP: int;
#[singleton]
let MOVE: bool;
/// Box 0 takes the class `.nw`, a row no box had.
#[singleton]
let NEW: bool;

/// One box per case: the plain ones take the memo, the rest its long way (effects, one-sided and dashed borders, shadows,
/// gradients, percentages, a `style:` slot overriding paint).
const SHEET: string = ".page { display: flex; flex-wrap: wrap; gap: 3px; padding: 4px; width: 400px; } .b { width: 40px; height: 30px; } .bg { background: #336699; } .rd { background: #224466; border-radius: 6px; } .bd { border: 2px solid #ff8800; border-radius: 4px; background: #101820; } .bo { border: 2px solid #ff8800; } .one { border-left: 3px solid #00ff00; background: #202020; } .dash { border: 2px dashed #ffffff; } .op { background: #ff0000; opacity: 0.5; } .tf { background: #00ff00; transform: rotate(10deg); } .ol { background: #0000ff; outline: 2px solid #ffff00; } .ov { background: #444444; overflow: hidden; } .sh { background: #555555; box-shadow: 2px 2px 4px #000000; } .gr { background-image: linear-gradient(90deg, #ff0000, #0000ff); } .pc { background: #777777; border-radius: 50%; } .cur { color: #ff00ff; border: 1px solid currentcolor; } .c0 { background: #111111; } .c1 { background: #222222; } .fill { height: 4px; background: #89b4fa; border-radius: 2px; } .nw { background: #123456; } .inner { width: 10px; height: 10px; background: #abcdef; }";

const CLASSES: [16]string = ["bg", "rd", "bd", "bo", "one", "dash", "op", "tf", "ol", "ov", "sh", "gr", "pc", "cur", "c0", "fill"];

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn build(d: &Dom) {
    let page = d.open(0, d.tag("div"), 1);
    d.cls(page, "page");
    for i in 0..16 {
        let b = d.open(i, d.tag("div"), 1);
        d.cls(b, "b");
        d.cls(b, if NEW && i == 0 { "nw" } else { CLASSES[i] });
        if i == 9 {
            let c = d.open(0, d.tag("div"), 1);
            d.cls(c, "inner");
            d.close();
        }
        d.close();
    }
    // a `style:` width paints as its base row; a `style:` background does not
    let f = d.open(16, d.tag("div"), 1);
    d.cls(f, "fill");
    d.styleStr(f, 0, "width", if MOVE { `{10 + STEP % 20}px` } else { "12px" });
    d.close();
    let g = d.open(17, d.tag("div"), 1);
    d.cls(g, "b");
    d.styleStr(g, 0, "background", if MOVE && STEP % 2 == 1 { "#00ffff" } else { "#ff00ff" });
    d.close();
    let s = d.open(18, d.tag("div"), 1);
    d.cls(s, "b");
    d.cls(s, if MOVE && STEP % 2 == 1 { "c1" } else { "c0" });
    d.close();
    d.close();
}

/// One frame; the hash of every instance it queued.
fn frame(d: &Dom): u64 {
    d.beginFrame(Vec2 { x: 420.0, y: 200.0 });
    build(d);
    d.layout();
    game.p2Watch(true);
    d.paintAll();
    let h = game.p2Watched();
    game.p2Watch(false);
    d.endFrame();
    game.p2Flush();
    STEP += 1;
    return h;
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    game.initGlHidden("paint memo", 420, 200);
    let css = Css.new(&mem);
    parse(&css, SHEET, "paintmemo.css", 1);
    ok(css.warns.len == 0, "fixture CSS parses");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    frame(&d);
    let a = frame(&d);
    ok(a != 0, "the frame queued something");
    let built = d.pmBuilt;
    ok(built > 0, "the plain boxes have memo rows");
    let b = frame(&d);
    ok(a == b, "a second identical frame queues a byte-identical batch");
    ok(d.pmBuilt == built, "and works out no memo row again");
    d.pmOn = false;
    let c = frame(&d);
    ok(a == c, "the memo queues exactly what the long way queues");
    d.pmOn = true;
    // moving: the slot width, the slot background and a class flip every frame; each frame matches the long way
    MOVE = true;
    for i in 0..6 {
        let on = frame(&d);
        STEP -= 1;
        d.pmOn = false;
        let off = frame(&d);
        d.pmOn = true;
        ok(on == off, "a changing frame paints the same from the memo as the long way");
    }
    // the class swap's rows are memoized now: another swap works nothing out; a new class on one box works out its row alone
    let before = d.pmBuilt;
    frame(&d);
    frame(&d);
    ok(d.pmBuilt == before, "rows seen before are not worked out again");
    MOVE = false;
    NEW = true;
    frame(&d);
    ok(d.pmBuilt == before + 1, "one box on a new class works out that one row");
    frame(&d);
    ok(d.pmBuilt == before + 1, "and nothing after it");
    printLn(`paintmemo_test ok, checks passed: {CHECKS}`);
    game.destroy();
    mem.destroy();
}
