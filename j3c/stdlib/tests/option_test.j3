// Select visual-option mirrors: no window, SDL_ttf only. Run offscreen/dummy with timeout.
module option_test;
use j3.memory.Arena;
use j3.io.printLn;
use j3.sys.panic;
use j3.text.same;
use j3.math.Vec2;
use j3.ui.css.{ Css, P_COLOR, P_FONT_SIZE };
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.a11y;
use j3.ui.dropdown;
use j3.ui.media;
use j3.ui.uastyle;
#[singleton] let SHOW: bool;
#[singleton] let EXTRA: bool;
#[singleton] let ALT: bool;
#[singleton] let N: int;
#[singleton] let WIDTH: f32;
#[singleton] let EXPLICIT: bool;
#[singleton] let SEL: int;
#[singleton] let OPT: int;
#[singleton] let SPAN: int;
#[singleton] let VALUE: string;
#[singleton] let CHECKS: int;
const SHEET: string = "@font-face { font-family: T; src: url(examples/big_ui_test/assets/font.ttf); } select { font-family: T; width: 180px; height: 30px; --tone: #112233; } select.hot { --tone: #445566; } .piece { color: var(--tone); } select option .name { color: #ff0000;  } select option .name.alt { color: #00ff00; } .icon { width: 14px; height: 14px; } @media (min-width: 500px) { .icon { width: 18px; } }";
fn ok(b: bool, s: string) { CHECKS += 1; if !b { panic(s); } }
fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: WIDTH, y: 300.0 }); inputs.begin(d);
    if SHOW {
        SEL = d.open(0, d.tag("select"), 1);
        if d.changed(SEL) { VALUE = d.strValue(SEL); }
        d.attrText(SEL, VALUE); d.clsIf(SEL, "hot", ALT);
        for i in 0..N {
            let tok = d.enter(i / 4096);
            let o = d.open(i % 4096, d.tag("option"), 1);
            d.attrDisabled(o, i == 1);
            if i == 0 {
                OPT = o; d.attrText(o, if EXPLICIT { "pear-value" } else { "" });
                let svg = d.open(0, d.tag("svg"), 1); d.cls(svg, "icon");
                d.attrMedia(svg, media.M_VIEWBOX, "0 0 10 10");
                let path = d.open(0, d.tag("path"), 1);
                d.attrMedia(path, media.M_D, if ALT { "M0 0 L10 0 L5 10 Z" } else { "M0 0 L10 10 L0 10 Z" });
                d.attrMedia(path, media.M_FILL, "currentColor"); d.close(); d.close();
                d.text("Red ");
                SPAN = d.open(1, d.tag("span"), 1); d.cls(SPAN, "name"); d.clsIf(SPAN, "alt", ALT);
                d.styleNum(SPAN, 0, "font-size", if ALT { 17.0 } else { 14.0 });
                let piece = d.open(0, d.tag("span"), 1); d.cls(piece, "piece");
                d.text(if ALT { "Pear" } else { "Apple" }); d.close(); d.close();
                if EXTRA { let small = d.open(2, d.tag("small"), 1); d.text(" ripe"); d.close(); }
            } else {
                d.attrText(o, if i == 1 { "disabled" } else { "blue" });
                let span = d.open(0, d.tag("span"), 1); d.text(if i == 1 { "Red disabled" } else { "Blue berry" }); d.close();
            }
            d.close(); d.leave(tok);
        }
        d.close();
    }
    d.layout(); dropdown.settle(d); d.endFrame();
}
fn frames(d: &Dom, n: int) { for i in 0..n { frame(d); } }
fn click(d: &Dom, x: f32, y: f32) {
    d.simInput(x,y,false,0.0); frame(d); d.simInput(x,y,true,0.0); frame(d);
    d.simInput(x,y,false,0.0); frames(d,2);
}
fn key(d: &Dom, k: string) { d.simKeys("",k); frames(d,2); }
fn label(d: &Dom): int {
    let row = d.nodes.items[d.ptRoot].first;
    while row >= 0 && d.nodes.items[row].pidx != 0 { row = d.nodes.items[row].next; }
    if row < 0 { return -1; }
    return d.nodes.items[d.nodes.items[row].first].next;
}
fn main() {
    let mem = Arena.create(256 * 1024 * 1024); let css = Css.new(&mem); uastyle.load(&css); parse(&css,SHEET,"option.css",1);
    let d = Dom.new(&mem,&css); d.setFrameMs(16.0); d.simInput(-5.0,-5.0,false,0.0);
    SHOW = true; EXTRA = true; ALT = false; EXPLICIT = false; WIDTH = 400.0; N = 3; VALUE = "Red Apple ripe"; frames(&d,3);
    ok(same(dom.optLabel(&d,OPT),"Red Apple ripe"),"full descendant label");
    ok(same(dom.optValue(&d,OPT),"Red Apple ripe"),"fallback value is full label");
    ok(same(a11y.name(&d,&mem,OPT),"Red Apple ripe"),"accessible option name includes descendant fragments");
    let original = SPAN;
    click(&d,40.0,15.0); ok(d.ptRoot >= 0,"opens custom list");
    let lb = label(&d); let icon = d.nodes.items[lb].first;
    let span = d.nodes.items[d.nodes.items[icon].next].next;
    ok(d.nodes.items[icon].tag == d.tSvg && d.nodes.items[icon].media > 0,"SVG mirror has real media");
    ok(d.nodes.items[span].optionSource == SPAN && d.nodes.items[SPAN].parent == OPT,"mirror preserves source placement and identity");
    ok(css.get(d.nodes.items[span].style,P_COLOR).c == 4278190335,"scoped source ancestor selector reaches mirror");
    ok(d.nodes.items[label(&d)].h >= 14.0 && d.nodes.items[icon].w == 14.0,"visual children participate in layout");
    WIDTH = 600.0; frame(&d); ok(d.nodes.items[icon].w == 18.0,"media query resize restyles visual content");
    WIDTH = 400.0; frame(&d); ok(d.nodes.items[icon].w == 14.0,"resize restores source-scoped icon size");
    ALT = true; EXTRA = false; frame(&d);
    ok(SPAN == original && same(dom.optLabel(&d,OPT),"Red Pear"),"live text and conditional removal retain source identity");
    ok(css.get(d.nodes.items[span].style,P_COLOR).c == 16711935,"class change reaches mirror same frame");
    let child = d.nodes.items[span].first;
    ok(css.get(d.nodes.items[child].style,P_COLOR).c == 1146447615 && css.get(d.nodes.items[child].style,P_FONT_SIZE).f == 17.0,"changed ancestor custom vars and inline inherited size reach nested mirror");
    ok(same(d.textOf(d.nodes.items[d.nodes.items[span].first].first),"Pear") && d.nodes.items[span].next < 0,"mirror text and conditional removal update same frame");
    ok(css.get(d.nodes.items[span].style,P_FONT_SIZE).f == 17.0,"inline font-size reaches owned mirror style");
    EXPLICIT = true; frame(&d); ok(same(dom.optValue(&d,OPT),"pear-value"),"dynamic explicit value overrides full label");
    click(&d,d.absX(icon)+2.0,d.absY(icon)+2.0);
    ok(d.ptRoot < 0 && same(VALUE,"pear-value"),"clicking visual descendant selects updated explicit value");
    EXPLICIT = false; frame(&d);
    click(&d,40.0,15.0); key(&d,"End"); key(&d,"Enter");
    ok(same(VALUE,"blue"),"keyboard preserves explicit value");
    click(&d,40.0,15.0); d.simKeys("Red",""); frames(&d,2); key(&d,"Enter");
    ok(same(VALUE,"Red Pear"),"typeahead uses full label and skips disabled option");
    click(&d,40.0,15.0); css.reset(); uastyle.load(&css); parse(&css,SHEET,"option.css",1); d.restyle(); frames(&d,3);
    lb = label(&d); icon = d.nodes.items[lb].first; span = d.nodes.items[d.nodes.items[icon].next].next;
    ok(css.get(d.nodes.items[span].style,P_COLOR).c == 16711935 && css.get(d.nodes.items[span].style,P_FONT_SIZE).f == 17.0,"CSS reload restores class and inline styles");
    ok(css.get(d.nodes.items[d.nodes.items[span].first].style,P_COLOR).c == 1146447615,"CSS reload preserves inherited custom vars");
    let laid = d.laid; let rest = d.restyled; let used = mem.used; frames(&d,300);
    ok(d.laid == laid && d.restyled == rest && mem.used == used,"open steady frames have zero layouts/restyles/arena growth");
    key(&d,"Escape");
    for i in 0..20 { click(&d,40.0,15.0); key(&d,"Escape"); }
    used = mem.used; for i in 0..1000 { click(&d,40.0,15.0); key(&d,"Escape"); }
    printLn(`reopen growth {mem.used-used}, dyns {d.dyns.len}, free {d.dynFree.len}, media {d.media.len}, nodes {d.nodes.len}`);
    ok(mem.used == used,"1000 custom reopen cycles allocate nothing after warmup");
    click(&d,40.0,15.0); SHOW = false; frames(&d,2); ok(d.ptRoot < 0,"owner removal frees mirror popup");
    SHOW = true; N = 5000; frames(&d,3); let base = d.count(); click(&d,40.0,15.0);
    ok(d.count() - base < 150,"5000 source options keep bounded real visual rows");
    key(&d,"End"); frames(&d,3); ok(d.count()-base < 150,"scrolling retains bounded mirrors");
    key(&d,"Escape"); N = 3; frames(&d,3); click(&d,40.0,15.0); frames(&d,2);
    ok(label(&d) >= 0,"custom content reopens after large list and owner recycle");
    printLn(`option_test ok, checks passed: {CHECKS}`);
}
