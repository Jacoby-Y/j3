// Tests for item drag and drop (`j3.ui.drag`, testkit.drag*): a plain click still clicks, the 4 px slop,
// start / enter / over / leave / drop / end timing, drop outside, Escape, a rejecting target, the payload,
// :dragging / :drop-target restyle, and steady frames.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/drag_test.j3 --headless

module drag_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.drag;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.testkit;

#[singleton]
let CHECKS: int;
#[singleton]
let S: St;

struct St {
    src: int = -1;
    b: int = -1;
    clicks: int = 0;
    starts: int = 0;
    startAt: int = -1;
    enters: int = 0;
    enterAt: int = -1;
    overs: int = 0;
    overAt: int = -1;
    leaves: int = 0;
    leaveAt: int = -1;
    drops: int = 0;
    dropAt: int = -1;
    ends: int = 0;
    endAt: int = -1;
    dropped: bool = false;
    data: string = "";
    dragId: int = 0;
    reject: bool = false;
    seq: int = 0;
    dropSeq: int = 0;
    endSeq: int = 0;
    zEnds: int = 0;
    zEndSeq: int = 0;
    z: int = -1;
    hide: bool = false;
    showX: bool = false;
    x: int = -1;
    old: int = -2;
    xEvents: int = 0;
    scroller: int = -1;
    g: int = -1;
    gDrops: int = 0;
}

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

const SHEET: string = ".item { width: 60px; height: 40px; } .slot { width: 60px; height: 40px; } .item:dragging { height: 50px; } .slot:drop-target { width: 70px; } .wrap { width: 200px; } .scroller { height: 30px; overflow: auto; }";

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let w = d.open(0, d.tag("div"), 1);
    d.cls(w, "wrap");
    if !S.hide {
        let a = d.open(0, d.tag("div"), 1);
        S.src = a;
        d.cls(a, "item");
        d.attrDraggable(a, true);
        d.attrDragData(a, "sword");
        d.attrDragId(a, 7);
        d.text("Sword");
        if d.clicked(a) {
            S.clicks += 1;
        }
        if d.dragStarted(a) {
            S.starts += 1;
            S.startAt = d.frame;
            S.data = d.dragData();
            S.dragId = d.dragIdOf();
        }
        if d.dragEnded(a) {
            S.ends += 1;
            S.endAt = d.frame;
            S.dropped = d.dragDropped();
            S.seq += 1;
            S.endSeq = S.seq;
        }
        d.close();
    } else if S.showX {
        // new elements take the freed ids; each has every drag handler, none may fire
        for k in 0..8 {
            let x = d.open(1 + k, d.tag("div"), 1);
            if x == S.old {
                S.x = x;
            }
            d.attrDraggable(x, true);
            d.attrDragTarget(x, 15);
            if d.dragStarted(x) || d.dragEnded(x) || d.dragEntered(x) || d.dragLeft(x) || d.dragOver(x) || d.dropAt(x) {
                S.xEvents += 1;
            }
            d.close();
        }
    }
    let b = d.open(20, d.tag("div"), 1);
    S.b = b;
    d.cls(b, "slot");
    d.attrDragTarget(b, 1);
    d.attrDragTarget(b, 2);
    d.attrDragTarget(b, 4);
    d.attrDragTarget(b, 8);
    d.text("B");
    if d.dragEntered(b) {
        S.enters += 1;
        S.enterAt = d.frame;
    }
    if d.dragOver(b) {
        S.overs += 1;
        S.overAt = d.frame;
        let accept = !S.reject;
        if !accept {
            d.dragReject(b);
        }
    }
    if d.dragLeft(b) {
        S.leaves += 1;
        S.leaveAt = d.frame;
    }
    if d.dropAt(b) {
        S.drops += 1;
        S.dropAt = d.frame;
        S.data = d.dragData();
        S.seq += 1;
        S.dropSeq = S.seq;
    }
    d.close();
    // C has no drag handler at all: dropping on it is dropping on nothing
    let c = d.open(21, d.tag("div"), 1);
    d.cls(c, "slot");
    d.text("C");
    d.close();
    // Z is a second source AFTER the target in the markup
    let z = d.open(22, d.tag("div"), 1);
    S.z = z;
    d.cls(z, "item");
    d.attrDraggable(z, true);
    d.attrDragData(z, "z");
    d.text("Z");
    if d.dragEnded(z) {
        S.zEnds += 1;
        S.seq += 1;
        S.zEndSeq = S.seq;
    }
    d.close();
    // a scroll box: rows of 40 px in 30, so row 2 is only reachable once it is scrolled
    let sc = d.open(23, d.tag("div"), 1);
    S.scroller = sc;
    d.cls(sc, "scroller");
    let r1 = d.open(0, d.tag("div"), 1);
    d.cls(r1, "slot");
    d.text("R1");
    d.close();
    let g = d.open(1, d.tag("div"), 1);
    S.g = g;
    d.cls(g, "slot");
    d.attrDragTarget(g, 8);
    d.text("G");
    if d.dropAt(g) {
        S.gDrops += 1;
    }
    d.close();
    let r3 = d.open(2, d.tag("div"), 1);
    d.cls(r3, "slot");
    d.text("R3");
    d.close();
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn reset() {
    S = St {};
}

/// Run `n` frames with the pointer at `(x, y)`, button `down`.
fn hold(d: &Dom, x: f32, y: f32, down: bool, n: int) {
    for i in 0..n {
        d.simInput(x, y, down, 0.0);
        frame(d);
    }
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    reset();
    frame(&d);
    frame(&d);
    let src = S.src;
    let bn = S.b;
    let zn = S.z;
    let gn = S.g;
    d.scrollBy(S.scroller, 40.0);
    frame(&d);

    // a click without a drag still clicks, and starts nothing
    let f0 = d.frame + 1;
    for f in 0..5 {
        testkit.click(&d, f0 + f, f0, src);
        frame(&d);
    }
    ok(S.clicks == 1 && S.starts == 0 && S.ends == 0, "plain click: one click, no drag");

    // under the slop (4 px of travel) a press and release is still a click; past it, a drag and no click
    hold(&d, 10.0, 10.0, false, 1);
    hold(&d, 10.0, 10.0, true, 1);
    hold(&d, 12.0, 11.0, true, 2);
    ok(S.starts == 0, "3 px of travel does not start a drag");
    hold(&d, 12.0, 11.0, false, 2);
    ok(S.clicks == 2 && S.starts == 0, "press, small move, release is a click");
    hold(&d, 10.0, 10.0, true, 1);
    hold(&d, 16.0, 10.0, true, 1);
    ok(S.starts == 1 && same(S.data, "sword") && S.dragId == 7, "6 px of travel starts the drag; payload read in dragstart");
    ok(d.size(src).y == 50.0, ":dragging restyles the source");
    hold(&d, 16.0, 10.0, false, 2);
    ok(S.clicks == 2 && S.ends == 1 && !S.dropped, "a drag released over nothing is no click, and ends undropped");
    ok(d.size(src).y == 40.0, ":dragging is gone after the drag");
    hold(&d, -5.0, -5.0, false, 2);

    // a full drag onto B: start, enter and over together, over again, then drop and end together
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.drag(&d, f0 + f, f0, src, bn);
        frame(&d);
        if f == 3 {
            ok(S.enters == 1 && d.size(bn).x == 70.0, ":drop-target on the hovered acceptor");
            ok(d.size(src).y == 50.0, ":dragging while it lasts");
        }
    }
    ok(S.starts == 1 && S.enters == 1 && S.leaves == 0 && S.drops == 1 && S.ends == 1, "start, enter, drop, end once each; no leave on a drop");
    ok(S.enterAt == S.overAt - 0 || S.enterAt < S.overAt, "enter comes with or before the first over");
    ok(S.overs == 2, "over every frame the pointer rests on the target");
    ok(S.endAt == S.dropAt + 1 && S.dropAt > S.overAt, "drop lands on the release frame, dragend on the next");
    ok(S.dropSeq < S.endSeq, "drop before dragend, source before the target in the markup");
    ok(S.startAt < S.enterAt && S.enterAt == S.overAt - 1, "start before enter");
    ok(S.dropped && same(S.data, "sword") && S.clicks == 0, "dropped flag, payload in drop, no click");
    ok(d.size(bn).x == 60.0 && d.size(src).y == 40.0, "pseudo-classes cleared after the drop");

    // dropped on C (no handler) and on empty space: dragend only
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.dragTag(&d, f0 + f, f0, "div", 1, "div", 3);
        frame(&d);
    }
    ok(S.starts == 1 && S.drops == 0 && S.enters == 0 && S.ends == 1 && !S.dropped, "drop on a plain element: dragend only");
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.dragTo(&d, f0 + f, f0, src, 300.0, 300.0);
        frame(&d);
    }
    ok(S.starts == 1 && S.drops == 0 && S.ends == 1 && !S.dropped, "drop outside: dragend only");

    // onto B, away again, release: leave fires, no drop
    reset();
    hold(&d, -5.0, -5.0, false, 1);
    hold(&d, 10.0, 10.0, true, 1);
    hold(&d, 16.0, 10.0, true, 1);
    hold(&d, 10.0, 60.0, true, 2);
    ok(S.enters == 1 && S.leaves == 0, "over B");
    hold(&d, 300.0, 300.0, true, 1);
    ok(S.leaves == 1 && S.leaveAt == d.frame && d.size(bn).x == 60.0, "leaving B: dragleave and :drop-target gone");
    hold(&d, 300.0, 300.0, false, 2);
    ok(S.drops == 0 && S.ends == 1 && !S.dropped, "released away from B: no drop");

    // Escape cancels: leave, end undropped, and the release afterward drops nothing
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.drag(&d, f0 + f, f0, src, bn);
        testkit.simKeys(&d, f0 + f, f0 + 4, "", "Escape");
        frame(&d);
    }
    ok(S.starts == 1 && S.drops == 0 && S.ends == 1 && !S.dropped, "Escape: dragend, no drop");
    ok(S.leaves == 1 && S.endAt == S.leaveAt + 1, "Escape leaves the target, dragend follows next frame");
    ok(d.size(src).y == 40.0 && d.size(bn).x == 60.0, "Escape clears the pseudo-classes");
    ok(S.clicks == 0, "no click after an Escape cancel");
    // a new drag works after a cancel
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.drag(&d, f0 + f, f0, src, bn);
        frame(&d);
    }
    ok(S.drops == 1, "a drag after a cancelled one drops");

    // a target that rejects in dragover is no target for this drag
    reset();
    S.reject = true;
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.drag(&d, f0 + f, f0, src, bn);
        frame(&d);
        if f == 4 {
            ok(S.overs >= 1 && d.size(bn).x == 60.0, "a rejected target is not :drop-target");
        }
    }
    ok(S.drops == 0 && S.ends == 1 && !S.dropped, "a rejected drop is only a dragend");

    // a source AFTER the target in the markup: drop is still seen before its dragend
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.drag(&d, f0 + f, f0, zn, bn);
        frame(&d);
    }
    ok(S.drops == 1 && S.zEnds == 1 && same(S.data, "z"), "drag from the second source drops on B");
    ok(S.dropSeq < S.zEndSeq, "drop before dragend, source after the target in the markup");

    // a target inside a scrolled box takes the drop (same hit test as a click)
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.drag(&d, f0 + f, f0, src, gn);
        frame(&d);
    }
    ok(S.gDrops == 1 && S.ends == 1, "drop on a target inside a scrolled overflow box");
    // ...and scrolled out of view it cannot take one
    d.scrollBy(S.scroller, -40.0);
    frame(&d);
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.dragTo(&d, f0 + f, f0, src, d.absX(gn) + 3.0, d.absY(gn) + 3.0);
        frame(&d);
    }
    ok(S.gDrops == 0 && S.ends == 1 && !S.dropped, "a target clipped away by the scroll box takes no drop");
    d.scrollBy(S.scroller, 40.0);
    frame(&d);

    // the source removed mid-drag: no events, no drop, no stuck flags, and a node reusing its id hears nothing
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.drag(&d, f0 + f, f0, src, bn);
        if f == 3 {
            S.hide = true;
            S.old = src;
        }
        if f == 4 {
            S.showX = true;
        }
        frame(&d);
        if f == 4 {
            ok(S.x == src, "a new node took the removed source's id");
            }
        if f == 3 {
            ok(d.drag.state == 0, "removing the source ends the drag");
        }
    }
    ok(S.starts == 1 && S.drops == 0 && S.ends == 0 && S.xEvents == 0, "no drop, no dragend and nothing on the node that reused the id");
    ok(d.size(bn).x == 60.0, "the target's :drop-target is cleared when the source goes");
    S.hide = false;
    S.showX = false;
    hold(&d, -5.0, -5.0, false, 3);
    src = S.src;
    reset();
    f0 = d.frame + 1;
    for f in 0..9 {
        testkit.drag(&d, f0 + f, f0, src, bn);
        frame(&d);
    }
    ok(S.drops == 1 && S.ends == 1, "drag works again after the source came back");
    ok(d.nodes.items[src].kind == dom.K_ELEM, "source is a live element");

    // painting the ghost leaves the source's box and the layout untouched
    hold(&d, 10.0, 10.0, false, 1);
    hold(&d, 10.0, 10.0, true, 1);
    hold(&d, 40.0, 10.0, true, 2);
    ok(d.drag.state == 2, "dragging");
    let nx = d.nodes.items[src].x;
    let ny = d.nodes.items[src].y;
    let lw = d.laid;
    drag.paint(&d);
    ok(d.nodes.items[src].x == nx && d.nodes.items[src].y == ny && d.laid == lw, "the ghost does not move or dirty the source");
    hold(&d, 40.0, 10.0, false, 2);

    // idle and held drags cost nothing
    reset();
    hold(&d, -5.0, -5.0, false, 3);
    let used = d.mem.used;
    let laid = d.laid;
    let styled = d.restyled;
    hold(&d, -5.0, -5.0, false, 10);
    ok(d.mem.used == used && d.laid == laid && d.restyled == styled, "idle frames do not allocate, lay out or restyle");
    hold(&d, 10.0, 10.0, true, 1);
    hold(&d, 16.0, 10.0, true, 1);
    hold(&d, 10.0, 60.0, true, 2);
    used = d.mem.used;
    laid = d.laid;
    styled = d.restyled;
    hold(&d, 10.0, 60.0, true, 10);
    ok(d.mem.used == used && d.laid == laid && d.restyled == styled, "a drag resting on a target does not allocate, lay out or restyle");
    hold(&d, 10.0, 60.0, false, 2);
    printLn(`all passed ({CHECKS} checks)`);
}
