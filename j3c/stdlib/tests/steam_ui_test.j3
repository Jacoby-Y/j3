// Tests for j3.steam.game.attach with the UI and App: the Deck keyboard on text focus (fake Deck), the overlay pause, and
// j3.steam.ui.feedPad. Run from the repo root, headless (needs the font in examples/big_ui_test):
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 120 j3c run j3c/stdlib/tests/steam_ui_test.j3
// Panics on the first failed check.

module steam_ui_test;

use j3.app.App;
use j3.game;
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.steam;
use j3.steam.game.{ attach, PadMap, pauseOnOverlay };
use j3.steam.ui.feedPad;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.inputs;

struct World {
    n: int;
}

#[singleton]
let D: ptr;
#[singleton]
let PAUSED: ptr;
#[singleton]
let IDS: [3]int;
#[singleton]
let STEP: int;
#[singleton]
let CLOSED: int;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div { font-family: \"T\"; font-size: 14px; } input { font-family: \"T\"; font-size: 14px; } .tb { width: 120px; padding: 4px; } .col { display: flex; flex-direction: column; gap: 10px; }";

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn frameUi(d: &Dom) {
    d.beginFrame(Vec2 { x: 600.0, y: 400.0 });
    inputs.begin(d);
    let col = d.open(0, d.tag("div"), 1);
    d.cls(col, "col");
    let a = d.open(1, d.tag("input"), 1);
    d.cls(a, "tb");
    d.attrType(a, "text");
    d.close();
    let b = d.open(2, d.tag("input"), 1);
    d.cls(b, "tb");
    d.attrType(b, "email");
    d.close();
    let c = d.open(3, d.tag("input"), 1);
    d.attrType(c, "checkbox");
    d.close();
    d.close();
    IDS[0] = a; IDS[1] = b; IDS[2] = c;
    d.layout();
    d.endFrame();
}

fn onClosed() {
    CLOSED += 1;
}

fn paused(): bool {
    return steam.rdBool(PAUSED, 0);
}

fn sys(w: &World, dt: f32) {
    let d = D as &Dom;
    STEP += 1;
    let s = STEP;
    if s == 1 {
        // not on a Deck: focus shows no keyboard
        frameUi(d);
        d.focusNode(IDS[0]);
        frameUi(d);
        ok(steam.fakeKeyboardCalls() == 0, "no keyboard off the Deck");
        d.focusNode(-1);
        frameUi(d);
        ok(steam.fakeKeyboardHides() == 0, "no dismiss off the Deck");
        steam.fakeDeck(true);
        d.focusNode(IDS[0]);
        frameUi(d);
        ok(steam.fakeKeyboardCalls() == 1, "text focus on the Deck shows the keyboard once");
        frameUi(d);
        ok(steam.fakeKeyboardCalls() == 1, "and not per frame");
        d.focusNode(IDS[1]);
        frameUi(d);
        ok(steam.fakeKeyboardCalls() == 2 && steam.fakeKeyboardHides() == 0, "another text box: shown again, no dismiss");
        d.focusNode(IDS[2]);
        frameUi(d);
        ok(steam.fakeKeyboardCalls() == 2 && steam.fakeKeyboardHides() == 1, "a checkbox: dismissed once");
        d.focusNode(-1);
        frameUi(d);
        ok(steam.fakeKeyboardHides() == 1, "already dismissed: no second one");
        // Steam Input into the Dom
        feedPad(d, u64(0), PadMap { menuSet: u64(0), up: u64(0), down: u64(0), left: u64(0), right: u64(0), a: u64(0), b: u64(0), lb: u64(0), rb: u64(0) });
        // overlay opens
        let on: [1]u8 = [u8(1)];
        steam.fakeCallback(331, on[0..1]);
    } else if s == 2 {
        ok(steam.overlayOpen() && paused(), "overlay open pauses the App");
        let off: [1]u8 = [u8(0)];
        steam.fakeCallback(331, off[0..1]);
    } else if s == 3 {
        ok(!steam.overlayOpen() && !paused(), "overlay closed resumes");
        // a game that paused itself stays paused
        steam.wrBool(PAUSED, 0, true);
        let on: [1]u8 = [u8(1)];
        steam.fakeCallback(331, on[0..1]);
    } else if s == 4 {
        ok(paused(), "still paused while open");
        let off: [1]u8 = [u8(0)];
        steam.fakeCallback(331, off[0..1]);
    } else if s == 5 {
        ok(paused(), "the game's own pause is kept after the overlay closes");
        steam.wrBool(PAUSED, 0, false);
        pauseOnOverlay(false);
        let on: [1]u8 = [u8(1)];
        steam.fakeCallback(331, on[0..1]);
    } else if s == 6 {
        ok(steam.overlayOpen() && !paused(), "pauseOnOverlay(false) leaves the App running");
        game.requestQuit();
    }
}

fn boot(mem: &Arena): World {
    return World { n: 0 };
}

fn main() {
    ok(steam.initFake(u32(480)) == steam.Status.Fake, "fake init");
    steam.onTextInputClosed(onClosed);
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "t.css", 1);
    let dom = Dom.new(&mem, &css);
    dom.setFrameMs(16.0);
    dom.simInput(-5.0, -5.0, false, 0.0);
    D = &dom as ptr;
    let app = App<World>.create("steam ui", 320, 240, boot);
    PAUSED = &app.paused as ptr;
    attach(&app);
    app.always(sys);
    app.run();
    ok(STEP >= 6 && CLOSED >= 2, "ran the scenario and Steam closed the fake keyboard");
    printLn("steam_ui_test ok");
}
