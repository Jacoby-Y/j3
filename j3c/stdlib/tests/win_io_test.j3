module win_io_test;

// Windows paths through j3.io: `\` separators, a drive prefix, and Linux-numbered open flags.
// Built for x86_64-pc-windows-gnu and run under wine by `windows_io_runs_under_wine`.

use j3.io;
use j3.sys.panic;
use j3.result.Result;

fn mk(p: string): bool { match io.makeDirs(p) { Result.Ok(_) { return true; } Result.Err(_) { return false; } } }
fn wr(p: string): bool { match io.writeFile(p, "hi" as []u8) { Result.Ok(_) { return true; } Result.Err(_) { return false; } } }

fn ok(c: bool, what: string) {
    if !c { panic(what); }
}

fn main() {
    ok(mk("C:\\j3_win_io_test\\a\\b/c"), "makeDirs mixed separators");
    ok(mk("C:\\j3_win_io_test\\a\\b/c"), "makeDirs again");
    ok(mk("C:\\j3_win_io_test\\d\\e\\"), "makeDirs backslashes");
    ok(wr("C:\\j3_win_io_test\\a\\b/c/f.txt"), "writeFile O_WRONLY+O_CREAT+O_TRUNC");
    ok(io.exists("C:\\j3_win_io_test\\d\\e"), "dir exists");
    ok(io.exists("C:\\j3_win_io_test\\a\\b\\c\\f.txt"), "file exists");
    io.printLn("win_io_test ok");
}
