module win_io_test;

// Windows paths through j3.io: `\` separators, a drive prefix, and Linux-numbered open flags.
// Built for x86_64-pc-windows-gnu and run under wine by `windows_io_runs_under_wine`.

use j3.io;
use j3.io.IoError;
use j3.io.path;
use j3.memory.Arena;
use j3.option.Option;
use j3.proc;
use j3.sys;
use j3.sys.panic;
use j3.result.Result;

fn mk(p: string): bool { match io.makeDirs(p) { Result.Ok(_) { return true; } Result.Err(_) { return false; } } }
fn wr(p: string): bool { match io.writeFile(p, "hi" as []u8) { Result.Ok(_) { return true; } Result.Err(_) { return false; } } }

fn isOk(r: Result<bool, IoError>): bool { match r { Result.Ok(_) { return true; } Result.Err(_) { return false; } } }

fn ok(c: bool, what: string) {
    if !c { panic(what); }
}

fn main() {
    ok(mk("C:\\j3_win_io_test\\a\\b/c"), "makeDirs mixed separators");
    ok(mk("C:\\j3_win_io_test\\a\\b/c"), "makeDirs again");
    ok(mk("C:\\j3_win_io_test\\d\\e\\"), "makeDirs backslashes");
    ok(wr("C:\\j3_win_io_test\\a\\b/c/f.txt"), "writeFile O_WRONLY+O_CREAT+O_TRUNC");
    ok(io.exists("C:\\j3_win_io_test\\d\\e"), "dir exists");
    ok(io.exists("C:\\j3_win_io_test\\a\\b\\c\\f.txt"), "file exists");
    ok(mk("C:/j3_win_io_test/r"), "makeDirs r");
    ok(isOk(io.removeDir("C:/j3_win_io_test/r")) && !io.exists("C:/j3_win_io_test/r"), "removeDir empty");
    ok(!isOk(io.removeDir("C:\\j3_win_io_test\\a")), "removeDir not empty fails");
    ok(!isOk(io.removeDir("C:/j3_win_io_test/none")), "removeDir missing fails");
    let a = Arena.create(1048576);
    let here = io.cwd(&a);
    ok(here.len > 2 && here[1] == 58, "io.cwd has a drive");
    match path.realpath("C:/j3_win_io_test/a/../d", &a) {
        Option.Some(p) { ok(p == "C:\\j3_win_io_test\\d", "realpath"); }
        Option.None { ok(false, "realpath"); }
    }
    let argv: [3]string = ["cmd.exe", "/c", "echo %JZ_TEST%"];
    let env: [1]string = ["JZ_TEST=hello"];
    match proc.runEnv(argv[:], "", env[:], &a) {
        Result.Ok(o) { ok(o.outStr() == "hello\r\n", "runEnv"); }
        Result.Err(_) { ok(false, "runEnv starts"); }
    }
    ok(wr("C:/j3_win_io_test/h.txt"), "write h.txt");
    let attrib: [5]string = ["cmd.exe", "/c", "attrib", "+h", "C:\\j3_win_io_test\\h.txt"];
    proc.run(attrib[:], "", &a);
    match io.stat("C:/j3_win_io_test/h.txt") {
        Result.Ok(e) { ok(e.hidden, "stat hidden"); }
        Result.Err(_) { ok(false, "stat h.txt"); }
    }
    match io.stat("C:/j3_win_io_test/a") {
        Result.Ok(e) { ok(!e.hidden, "stat not hidden"); }
        Result.Err(_) { ok(false, "stat a"); }
    }
    match io.listDir("C:/j3_win_io_test", &a) {
        Result.Ok(es) {
            let seen = false;
            for i in 0..es.len { if es[i].name == "h.txt" { seen = es[i].hidden; } }
            ok(seen, "listDir hidden");
        }
        Result.Err(_) { ok(false, "listDir"); }
    }
    let t0 = sys.monotonicMs();
    while sys.monotonicMs() < t0 + 50 {}
    ok(t0 > 0 && sys.monotonicMs() >= t0 + 40, "monotonicMs");
    match path.exePath(&a) {
        Option.Some(p) {
            let d = sys.exeDir();
            ok(p.len > d.len + 1 && p[0..d.len] == d && p[d.len] == 92 && p[p.len - 4..p.len] == ".exe", "exePath");
        }
        Option.None { ok(false, "exePath"); }
    }
    io.printLn("win_io_test ok");
}
