// Tests for j3.ui.anim (easing, animation phases, blending), the motion CSS (transform, transition,
// animation, @keyframes parsing) and j3.ui.motion (transitions and keyframes over computed styles,
// interruption, holding, the overlay style) and j3.ui.ripple. No window, no font:
//   timeout 60 j3c run j3c/stdlib/tests/motion_test.j3
// Panics on the first failed check.

module motion_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.text.Text;
use j3.sys.panic;
use j3.ui.anim;
use j3.ui.css.{ Css, MatchNode, Value };
use j3.ui.cssmatch.computeStyle;
use j3.ui.cssparse.parse;
use j3.ui.css.{ animAt, animCount, P_ANIM_EASE, P_ANIM_DUR, P_ANIM_ITER, P_BACKGROUND, P_LEFT, P_TRANSLATE, V_CALC, V_PCT, V_COLOR, P_ANIM_NAME, P_BOX_SHADOW, P_OPACITY, P_TRANSFORM, P_TRANS0, P_WIDTH };
use j3.ui.css.{ P_BG_IMAGE, P_BORDER_IMAGE, P_WAVE_AMP, P_WAVE_LEN, P_WAVE_PERIOD, V_ANIM, V_EASE, V_GRAD, V_PX, V_TRANS, V_XFORM };
use j3.ui.gradmix;
use j3.ui.textwave;
use j3.ui.csscalc.calcEval;
use j3.ui.motion;
use j3.ui.motionbase.Motion;
use j3.ui.xform;
use j3.ui.ripple;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    let d = a - b;
    if d < 0.0 {
        d = 0.0 - d;
    }
    if d > tol {
        printLn(`{a} vs {b}`);
    }
    ok(d <= tol, msg);
}

fn style(mem: &Arena, css: &Css, cls: string): int {
    let nodes = mem.alloc::<MatchNode>(1);
    let cs = mem.alloc::<int>(1);
    cs[0] = css.intern(cls);
    nodes[0] = MatchNode { tag: css.intern("div"), classes: cs, parent: -1, prevSibling: -1, flags: 0, type: -1, scope: 0, scope2: 0, id: -1, pe: 0, next: -1, first: -1 };
    return computeStyle(css, nodes, 0, -1);
}

fn gk(css: &Css, st: int, p: int): int {
    let v = css.get(st, p);
    return v.kind;
}

fn gf(css: &Css, st: int, p: int): f32 {
    let v = css.get(st, p);
    return v.f;
}

fn testAnim() {
    let lin = anim.preset(anim.PRESET_LINEAR);
    near(anim.ease(&lin, 0.3), 0.3, 0.002, "linear cubic is identity");
    let e = anim.preset(anim.PRESET_EASE);
    ok(anim.ease(&e, 0.0) == 0.0 && anim.ease(&e, 1.0) == 1.0, "ease endpoints");
    ok(anim.ease(&e, 0.5) > 0.7 && anim.ease(&e, 0.5) < 0.9, "ease is fast early");
    let back = anim.cubic(0.34, 1.56, 0.64, 1.0);
    ok(anim.ease(&back, 0.6) > 1.0, "back easing overshoots");
    let b = anim.preset(anim.PRESET_BOUNCE);
    ok(anim.ease(&b, 0.5) < 1.0 && anim.ease(&b, 1.0) == 1.0, "bounce lands at 1");
    let sp = anim.preset(anim.PRESET_SPRING);
    ok(anim.ease(&sp, 0.2) > 1.0, "spring overshoots");
    let st = anim.steps(4.0, false);
    near(anim.ease(&st, 0.3), 0.25, 0.0001, "steps(4) at 0.3");
    ok(anim.mixColor(0, 255, 0.5) == 255 / 2 || anim.mixColor(0, 255, 0.5) > 0, "mixColor");
    // phase: 100ms, 2 iterations, alternate
    let p = anim.phase(150.0, 0.0, 100.0, 2.0, anim.DIR_ALTERNATE, anim.FILL_NONE);
    ok(p.on && !p.done, "mid second iteration runs");
    near(p.t, 0.5, 0.001, "alternate runs backwards in iteration 2");
    p = anim.phase(250.0, 0.0, 100.0, 2.0, anim.DIR_NORMAL, anim.FILL_NONE);
    ok(!p.on && p.done, "finished without fill: no value");
    p = anim.phase(250.0, 0.0, 100.0, 2.0, anim.DIR_NORMAL, anim.FILL_FORWARDS);
    ok(p.on && p.done && p.t == 1.0, "forwards fill holds the end");
    p = anim.phase(10.0, 50.0, 100.0, 1.0, anim.DIR_NORMAL, anim.FILL_NONE);
    ok(!p.on && !p.done, "before the delay: nothing");
    p = anim.phase(10.0, 50.0, 100.0, 1.0, anim.DIR_NORMAL, anim.FILL_BACKWARDS);
    ok(p.on && p.t == 0.0, "backwards fill shows the first frame");
    p = anim.phase(5.0, 0.0, 0.0, 1.0, anim.DIR_NORMAL, anim.FILL_FORWARDS);
    ok(p.done && p.on, "zero duration is an instant");
    p = anim.phase(1000000.0, 0.0, 100.0, -1.0, anim.DIR_NORMAL, anim.FILL_NONE);
    ok(p.on && !p.done, "infinite never ends");
    let r = ripple.none();
    ripple.add(&r, 3, 1.0, 2.0, 0.0, 100.0, 0);
    ok(r.n == 1 && ripple.progress(&r, 0, 50.0) == 0.5, "ripple progress");
    ripple.prune(&r, 200.0, -1);
    ok(r.n == 0, "finished ripples are dropped");
}

fn testMotion(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ".a { opacity: 0; width: 100px; transform: translateX(10px) rotate(90deg) scale(2); box-shadow: 0 0 0 0 #000000; transition: all 100ms linear; }\n.b { opacity: 1; width: 200px; box-shadow: 0 0 10px 0 #ffffff; transition: all 100ms linear 20ms; }\n@keyframes k { from { opacity: 0; } 50% { opacity: 1; animation-timing-function: linear; } to { opacity: 0.5; } }\n.k { animation: k 100ms linear forwards; }\n.z { animation: k 0s step-end both; transition: opacity 2s cubic-bezier(0.1, 0.7, 1, 0.1) 1s; }\n.bad { transform: rotate(10px); }\n", "m.css", 0);
    ok(css.warns.len == 1, "one warning (bad rotate unit)");
    let sa = style(mem, &css, "a");
    let sb = style(mem, &css, "b");
    let tx = css.get(sa, P_TRANSFORM);
    ok(tx.kind == V_XFORM, "transform parses");
    ok(css.paints.items[tx.i] == 3.0, "three functions");
    near(css.paints.items[tx.i + 2], 10.0, 0.0001, "translateX");
    near(css.paints.items[tx.i + 1 + 8 + 1], 1.5707964, 0.001, "rotate in radians");
    near(css.paints.items[tx.i + 1 + 16 + 1], 2.0, 0.0001, "scale");
    // `translateX(10px) rotate(90deg) scale(2)` on a 100x20 box, about its center C = (50, 10). The off-center point
    // q = (100, 10) goes to C + R90 * 2 * (q - C) = (50, 10) + (0, 100), then the translate of 10 in x: (60, 110).
    // unmap must take (60, 110) back to q; without the translate it would land at x = 50 and miss by 10.
    let xr = xform.of(&css, sa, 100.0, 20.0);
    ok(xr.on, "xform.of");
    let q = Vec2 { x: 0.0, y: 0.0 };
    ok(xform.unmap(&xr, 0.0, 0.0, 60.0, 110.0, &q), "invertible");
    near(q.x, 100.0, 0.01, "hit test inverse x");
    near(q.y, 10.0, 0.01, "hit test inverse y");
    ok(gk(&css, sb, P_TRANS0) == V_TRANS, "transition parses");

    // transition a to b: opacity and width blend, shadow blends; delay 20ms; interrupt mid-way
    let m = motion.fresh();
    motion.onStyle(&m, &css, sa, sb, 0.0);
    ok(motion.live(&m) > 3 && motion.active(&m), "transitions started");
    let r = motion.step(&m, &css, sb, 70.0, 0.0);
    ok(r % 2 == 1 && r / 2 == 1, "live and layout");
    let ov = m.ov;
    near(gf(&css, ov, P_OPACITY), 0.5, 0.02, "opacity halfway (20ms delay)");
    near(gf(&css, ov, P_WIDTH), 150.0, 2.0, "width halfway");
    ok(gk(&css, ov, P_BOX_SHADOW) != 0, "shadow blends");
    // reverse at 70: from 0.5 toward 0 over 100ms (no delay in .a? it has none)
    motion.onStyle(&m, &css, sb, sa, 70.0);
    motion.step(&m, &css, sa, 95.0, 0.0);
    near(gf(&css, m.ov, P_OPACITY), 0.375, 0.03, "interrupted: continues from the current value");
    r = motion.step(&m, &css, sa, 500.0, 0.0);
    ok(r % 2 == 0 && !motion.active(&m), "settled");
    near(gf(&css, m.ov, P_WIDTH), 100.0, 0.001, "ends on the target");
    ok(motion.live(&m) == 0, "no tracks left");

    // keyframes
    let sk = style(mem, &css, "k");
    ok(gk(&css, sk, P_ANIM_NAME) == V_ANIM && gf(&css, sk, P_ANIM_DUR) == 100.0, "animation shorthand");
    let k = motion.fresh();
    motion.onStyle(&k, &css, -1, sk, 0.0);
    ok(css.kfs.len == 1 && css.kfs.items[0].nprop == 1 && css.kfs.items[0].nf == 3, "keyframes parsed and sorted");
    motion.step(&k, &css, sk, 25.0, 0.0);
    near(gf(&css, k.ov, P_OPACITY), 0.5, 0.01, "keyframes sample");
    motion.step(&k, &css, sk, 75.0, 0.0);
    near(gf(&css, k.ov, P_OPACITY), 0.75, 0.01, "second span");
    r = motion.step(&k, &css, sk, 150.0, 0.0);
    ok(r % 2 == 0, "finished");
    near(gf(&css, k.ov, P_OPACITY), 0.5, 0.001, "forwards fill holds the last frame");
    motion.onStyle(&k, &css, sk, sk, 160.0);
    motion.step(&k, &css, sk, 170.0, 0.0);
    near(gf(&css, k.ov, P_OPACITY), 0.5, 0.001, "a restyle keeps the held frame and does not restart");
    motion.step(&m, &css, sa, 1.0, 0.0);
    // stagger: extra delay shifts the start
    let g = motion.fresh();
    motion.onStyle(&g, &css, -1, sk, 0.0);
    motion.step(&g, &css, sk, 25.0, 100.0);
    near(gf(&css, g.ov, P_OPACITY), gf(&css, sk, P_OPACITY), 0.001, "delay holds the base value");
    // zero-duration animation and long transition parse
    let sz = style(mem, &css, "z");
    let z = motion.fresh();
    motion.onStyle(&z, &css, -1, sz, 0.0);
    motion.step(&z, &css, sz, 1.0, 0.0);
    ok(gk(&css, sz, P_TRANS0) == V_TRANS && gf(&css, sz, P_TRANS0) == 2000.0, "ms and s units");
    ok(gf(&css, sz, P_ANIM_ITER) == 1.0, "iteration default");
}

/// Layer `l` stop `i` field `f` (0 at, 1 r, 2 g, 3 b, 4 a) of the single-layer gradient value at `st`.
fn off(css: &Css, st: int, p: int): int {
    let v = css.get(st, p);
    return v.i;
}

fn stop(css: &Css, st: int, p: int, i: int, f: int): f32 {
    return css.paints.items[off(css, st, p) + 4 + i * 5 + f];
}

fn angleOf(css: &Css, st: int, p: int): f32 {
    return css.paints.items[off(css, st, p) + 2];
}

fn stops(css: &Css, st: int, p: int): int {
    return int(css.paints.items[off(css, st, p) + 3]);
}

fn testGradients(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ".ga { background-image: linear-gradient(0deg, #ff0000, #0000ff); border-image: conic-gradient(from 0deg, #ff0000, #0000ff) 1; transition: background-image 100ms linear; }\n.gb { background-image: linear-gradient(180deg, #0000ff, #00ff00 50%, #ffffff); transition: background-image 100ms linear; }\n.gc { background-image: radial-gradient(#ff0000, #0000ff); transition: background-image 100ms linear; }\n.gz { background-image: linear-gradient(90deg, #00ff00, #ffffff); transition: background-image 0s; }\n@keyframes gk { from { background-image: linear-gradient(0deg, #ff0000, #0000ff); border-image: conic-gradient(from 0deg, #ff0000, #0000ff) 1; } to { background-image: linear-gradient(360deg, #ff0000, #0000ff); border-image: conic-gradient(from 360deg, #ff0000, #0000ff) 1; } }\n@keyframes gm { from { background-image: linear-gradient(0deg, #ff0000, #0000ff); } to { background-image: radial-gradient(#ff0000, #0000ff); } }\n.gk { animation: gk 100ms linear infinite; }\n.gm { animation: gm 100ms linear both; }\n.w { text-wave: 6px 80px 1.4s; }\n.w0 { text-wave: none; }\n.wb { text-wave: 6px 80px; }\n", "g.css", 0);
    ok(css.warns.len == 1, "one warning (text-wave without a period)");
    let sa = style(mem, &css, "ga");
    let sb = style(mem, &css, "gb");
    let sc = style(mem, &css, "gc");
    let sz = style(mem, &css, "gz");

    // transition a (2 stops) to b (3 stops): padded with a's last stop, everything blends
    let m = motion.fresh();
    motion.onStyle(&m, &css, sa, sb, 0.0);
    ok(motion.active(&m), "gradient transition starts");
    let r = motion.step(&m, &css, sb, 50.0, 0.0);
    ok(r % 2 == 1, "still moving at the middle");
    ok(gk(&css, m.ov, P_BG_IMAGE) == V_GRAD, "overlay holds a gradient");
    near(angleOf(&css, m.ov, P_BG_IMAGE), 90.0, 0.01, "angle blends");
    ok(stops(&css, m.ov, P_BG_IMAGE) == 3, "stop count is the larger");
    near(stop(&css, m.ov, P_BG_IMAGE, 0, 0), 0.0, 0.001, "first stop at 0");
    near(stop(&css, m.ov, P_BG_IMAGE, 1, 0), 0.75, 0.001, "middle stop moves from 1 to .5");
    near(stop(&css, m.ov, P_BG_IMAGE, 0, 1), 127.5, 1.0, "red fades");
    near(stop(&css, m.ov, P_BG_IMAGE, 2, 4), 255.0, 0.5, "alpha stays opaque");
    // no allocation while it runs
    let len = css.paints.len;
    motion.step(&m, &css, sb, 60.0, 0.0);
    motion.step(&m, &css, sb, 70.0, 0.0);
    ok(css.paints.len == len, "steady blending does not grow paints");
    // retarget back to a at 50: continues from the blended angle
    let m2 = motion.fresh();
    motion.onStyle(&m2, &css, sa, sb, 0.0);
    motion.step(&m2, &css, sb, 50.0, 0.0);
    motion.onStyle(&m2, &css, sb, sa, 50.0);
    motion.step(&m2, &css, sa, 50.0, 0.0);
    near(angleOf(&css, m2.ov, P_BG_IMAGE), 90.0, 0.01, "retarget starts where it was");
    motion.step(&m2, &css, sa, 100.0, 0.0);
    near(angleOf(&css, m2.ov, P_BG_IMAGE), 45.0, 0.01, "and heads for the new target");
    motion.step(&m2, &css, sa, 200.0, 0.0);
    ok(motion.live(&m2) == 0, "done");
    ok(off(&css, m2.ov, P_BG_IMAGE) == off(&css, sa, P_BG_IMAGE), "ends on the target's own list");

    // linear to radial does not blend; zero duration does not start
    let mc = motion.fresh();
    motion.onStyle(&mc, &css, sa, sc, 0.0);
    ok(!motion.active(&mc), "different types jump");
    let mz = motion.fresh();
    motion.onStyle(&mz, &css, sa, sz, 0.0);
    ok(!motion.active(&mz), "zero duration jumps");
    ok(!gradmix.compatible(css.paints.items, off(&css, sa, P_BG_IMAGE), off(&css, sc, P_BG_IMAGE)), "compatible: types differ");
    ok(gradmix.compatible(css.paints.items, off(&css, sa, P_BG_IMAGE), off(&css, sb, P_BG_IMAGE)), "compatible: stops may differ");

    // keyframes: background angle and a conic border start angle, no allocation after the first step
    let sk = style(mem, &css, "gk");
    let k = motion.fresh();
    motion.onStyle(&k, &css, -1, sk, 0.0);
    motion.step(&k, &css, sk, 25.0, 0.0);
    near(angleOf(&css, k.ov, P_BG_IMAGE), 90.0, 0.01, "keyframes angle");
    near(angleOf(&css, k.ov, P_BORDER_IMAGE), 90.0, 0.01, "keyframes conic start");
    len = css.paints.len;
    for q in 0..50 {
        motion.step(&k, &css, sk, 30.0 + f32(q), 0.0);
    }
    ok(css.paints.len == len, "keyframes do not allocate per frame");
    motion.step(&k, &css, sk, 150.0, 0.0);
    near(angleOf(&css, k.ov, P_BG_IMAGE), 180.0, 0.01, "second iteration");
    // incompatible keyframes flip halfway
    let sm = style(mem, &css, "gm");
    let km = motion.fresh();
    motion.onStyle(&km, &css, -1, sm, 0.0);
    motion.step(&km, &css, sm, 20.0, 0.0);
    ok(stops(&css, km.ov, P_BG_IMAGE) == 2 && css.paints.items[off(&css, km.ov, P_BG_IMAGE) + 1] == 0.0, "before the middle: first list");
    motion.step(&km, &css, sm, 70.0, 0.0);
    ok(css.paints.items[off(&css, km.ov, P_BG_IMAGE) + 1] == 1.0, "after the middle: second list");

    // text-wave: shorthand, inheritance, and the lift
    let sw = style(mem, &css, "w");
    near(gf(&css, sw, P_WAVE_AMP), 6.0, 0.001, "wave amplitude");
    near(gf(&css, sw, P_WAVE_LEN), 80.0, 0.001, "wave length");
    near(gf(&css, sw, P_WAVE_PERIOD), 1400.0, 0.001, "wave period in ms");
    ok(gf(&css, style(mem, &css, "w0"), P_WAVE_AMP) == 0.0, "none turns it off");
    ok(!textwave.on(0.0, 80.0, 1400.0) && !textwave.on(6.0, 0.0, 1400.0) && !textwave.on(6.0, 80.0, 0.0) && textwave.on(6.0, 80.0, 1400.0), "on needs all three");
    near(textwave.lift(6.0, 80.0, 1400.0, 0.0, 0.0), 0.0, 0.001, "lift at the origin");
    near(textwave.lift(6.0, 80.0, 1400.0, 350.0, 0.0), 6.0, 0.001, "a crest a quarter period in");
    near(textwave.lift(6.0, 80.0, 1400.0, 0.0, 20.0), -6.0, 0.001, "and a trough a quarter length along");
    near(textwave.lift(6.0, 80.0, 1400.0, 1400.0, 80.0), 0.0, 0.01, "periodic in both");
}

/// Several animations per element, `var()` and `%` in `@keyframes`.
fn testMulti(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, "@keyframes fa { from { opacity: 0; } to { opacity: 1; } }\n@keyframes fo { from { opacity: 1; } to { opacity: 0.5; } }\n@keyframes fw { from { width: 100px; } to { width: 200px; } }\n@keyframes pulse { from { background: #000000; } to { background: var(--accent); } }\n@keyframes mv { from { transform: translate(0px, 0px); } to { transform: translate(var(--dx), 0px); } }\n@keyframes pl { from { left: 0px; width: 10%; } to { left: 100%; width: 50%; } }\n@keyframes tp { from { translate: 10px 0px; } to { translate: 50% 0px; } }\n.i1 { animation: fa 100ms linear forwards; }\n.i2 { animation: fa 100ms linear forwards, fw 100ms linear forwards; }\n.s1 { animation: fa 100ms linear forwards, fo 100ms linear forwards; }\n.s2 { animation: fa 100ms linear forwards, fo 100ms linear 200ms forwards; }\n.c { animation-name: fa, fw, fo; animation-duration: 100ms, 200ms; animation-timing-function: linear; animation-fill-mode: forwards; animation-iteration-count: 1, 2; }\n.many { animation: fa 1s, fw 1s, fo 1s, fa 2s, fw 2s; }\n.manyl { animation-name: fa, fw, fo, fa, fw; }\n.x1 { animation: pulse 100ms linear forwards; --accent: #ff0000; }\n.x2 { animation: pulse 100ms linear forwards; --accent: #0000ff; }\n.y1 { animation: mv 100ms linear forwards; --dx: 40px; }\n.y2 { animation: mv 100ms linear forwards; --dx: 80px; }\n.p { animation: pl 100ms linear forwards; position: absolute; }\n.t { animation: tp 100ms linear forwards; }\n@keyframes ga { from { opacity: 0; } to { opacity: 1; } }\n.q { animation: ga 100ms steps(4, end) 50ms 2 alternate both; }\n.va { --n: 2; animation: fa 100ms linear var(--n), fw 100ms; }\n.vb { --nm: fa; animation: var(--nm) 1s, fw 2s; }\n.tr1 { translate: 10px 0px; transition: all 100ms linear; }\n.tr2 { translate: 50% 0px; transition: all 100ms linear; }\n", "u.css", 0);
    ok(css.warns.len == 3, "warnings: two over the cap, one var() that cannot be written back");
    // comma lists: each longhand cycles over the names
    let sc = style(mem, &css, "c");
    ok(animCount(&css, sc) == 3, "three names");
    ok(animAt(&css, sc, P_ANIM_NAME, 1).i == css.intern("fw"), "name 1");
    ok(animAt(&css, sc, P_ANIM_DUR, 0).f == 100.0 && animAt(&css, sc, P_ANIM_DUR, 1).f == 200.0 && animAt(&css, sc, P_ANIM_DUR, 2).f == 100.0, "durations cycle");
    ok(animAt(&css, sc, P_ANIM_ITER, 1).f == 2.0 && animAt(&css, sc, P_ANIM_ITER, 2).f == 1.0, "counts cycle");
    ok(animAt(&css, sc, P_ANIM_EASE, 2).i == animAt(&css, sc, P_ANIM_EASE, 0).i, "one easing for all");
    ok(animCount(&css, style(mem, &css, "many")) == 4 && animCount(&css, style(mem, &css, "manyl")) == 4, "capped at four");
    ok(animCount(&css, style(mem, &css, "i1")) == 1, "one animation as before");

    // later wins a shared property; different properties run together
    let ss = style(mem, &css, "s1");
    let m = motion.fresh();
    motion.onStyle(&m, &css, -1, ss, 0.0);
    motion.step(&m, &css, ss, 50.0, 0.0);
    near(gf(&css, m.ov, P_OPACITY), 0.75, 0.01, "the later animation wins opacity");
    let s2 = style(mem, &css, "s2");
    let m2 = motion.fresh();
    motion.onStyle(&m2, &css, -1, s2, 0.0);
    motion.step(&m2, &css, s2, 50.0, 0.0);
    near(gf(&css, m2.ov, P_OPACITY), 0.5, 0.01, "a delayed later animation leaves the earlier one");
    let r = motion.step(&m2, &css, s2, 400.0, 0.0);
    near(gf(&css, m2.ov, P_OPACITY), 0.5, 0.01, "both held; the later one wins");
    ok(r % 2 == 0, "held animations are not live");
    let si = style(mem, &css, "i2");
    let mi = motion.fresh();
    motion.onStyle(&mi, &css, -1, si, 0.0);
    motion.step(&mi, &css, si, 50.0, 0.0);
    near(gf(&css, mi.ov, P_OPACITY), 0.5, 0.01, "opacity runs");
    near(gf(&css, mi.ov, P_WIDTH), 150.0, 0.5, "and width with it");

    // an animation added mid-run starts then; the first keeps its timeline
    let s1 = style(mem, &css, "i1");
    let ma = motion.fresh();
    motion.onStyle(&ma, &css, -1, s1, 0.0);
    motion.step(&ma, &css, s1, 50.0, 0.0);
    motion.onStyle(&ma, &css, s1, si, 50.0);
    motion.step(&ma, &css, si, 75.0, 0.0);
    near(gf(&css, ma.ov, P_OPACITY), 0.75, 0.01, "the first animation continues");
    near(gf(&css, ma.ov, P_WIDTH), 125.0, 0.5, "the second started when it was added");
    // and removing the first leaves the second running
    motion.onStyle(&ma, &css, si, s1, 80.0);
    motion.step(&ma, &css, s1, 90.0, 0.0);
    near(gf(&css, ma.ov, P_OPACITY), 0.9, 0.01, "removing a neighbour restarts nothing");

    // var() in a stop: per element
    let sx1 = style(mem, &css, "x1");
    let sx2 = style(mem, &css, "x2");
    let mx1 = motion.fresh();
    let mx2 = motion.fresh();
    motion.onStyle(&mx1, &css, -1, sx1, 0.0);
    motion.onStyle(&mx2, &css, -1, sx2, 0.0);
    motion.step(&mx1, &css, sx1, 100.0, 0.0);
    motion.step(&mx2, &css, sx2, 100.0, 0.0);
    ok(css.get(mx1.ov, P_BACKGROUND).kind == V_COLOR && css.get(mx1.ov, P_BACKGROUND).c == 0xff0000ff, "accent of the first element");
    ok(css.get(mx2.ov, P_BACKGROUND).c == 0x0000ffff, "accent of the second element");
    // a var() inside a compound value (a transform) too
    let sy1 = style(mem, &css, "y1");
    let sy2 = style(mem, &css, "y2");
    let my1 = motion.fresh();
    let my2 = motion.fresh();
    motion.onStyle(&my1, &css, -1, sy1, 0.0);
    motion.onStyle(&my2, &css, -1, sy2, 0.0);
    motion.step(&my1, &css, sy1, 50.0, 0.0);
    motion.step(&my2, &css, sy2, 50.0, 0.0);
    near(xform.of(&css, my1.ov, 100.0, 100.0).e, 20.0, 0.01, "half of --dx 40px");
    near(xform.of(&css, my2.ov, 100.0, 100.0).e, 40.0, 0.01, "half of --dx 80px");
    // steady frames neither parse nor allocate
    let np = css.paints.len;
    let nk = css.kvc.len;
    let nd = css.decls.len;
    let na = css.anx.len;
    for f in 0..20 {
        motion.step(&my1, &css, sy1, 10.0 + f32(f), 0.0);
        motion.step(&my2, &css, sy2, 10.0 + f32(f), 0.0);
        motion.step(&mi, &css, si, 10.0 + f32(f), 0.0);
        motion.step(&mx1, &css, sx1, 10.0 + f32(f), 0.0);
    }
    ok(css.paints.len == np && css.kvc.len == nk && css.decls.len == nd && css.anx.len == na, "no allocation or parsing per frame");

    // % in a stop: left and width mix with px as calc(), % with % stays a %
    let sp = style(mem, &css, "p");
    let mp = motion.fresh();
    motion.onStyle(&mp, &css, -1, sp, 0.0);
    r = motion.step(&mp, &css, sp, 50.0, 0.0);
    ok(r / 2 % 2 == 1, "left and width are layout");
    let lv = css.get(mp.ov, P_LEFT);
    ok(lv.kind == V_CALC, "px to % is a calc");
    let px: f32 = 0.0;
    ok(calcEval(&css, lv, 200.0, &px), "calc resolves");
    near(px, 100.0, 0.01, "left halfway of 200px");
    ok(css.get(mp.ov, P_WIDTH).kind == V_PCT, "% to % stays a %");
    near(gf(&css, mp.ov, P_WIDTH), 30.0, 0.01, "width halfway");
    np = css.paints.len;
    for f in 0..10 {
        motion.step(&mp, &css, sp, 51.0 + f32(f), 0.0);
    }
    ok(css.paints.len == np, "the calc is rewritten in place");
    // translate: px against % at once, resolved against the box
    let st = style(mem, &css, "t");
    let mt = motion.fresh();
    motion.onStyle(&mt, &css, -1, st, 0.0);
    motion.step(&mt, &css, st, 50.0, 0.0);
    near(xform.of(&css, mt.ov, 200.0, 100.0).e, 55.0, 0.01, "5px + 25% of 200");
    near(xform.of(&css, mt.ov, 400.0, 100.0).e, 105.0, 0.01, "tracks the box width");
    // a single animation with every longhand set: steps, delay, count, alternate, both fills
    let sq = style(mem, &css, "q");
    let mq = motion.fresh();
    motion.onStyle(&mq, &css, -1, sq, 0.0);
    motion.step(&mq, &css, sq, 0.0, 0.0);
    near(gf(&css, mq.ov, P_OPACITY), 0.0, 0.001, "backwards fill shows the first frame during the delay");
    motion.step(&mq, &css, sq, 80.0, 0.0);
    near(gf(&css, mq.ov, P_OPACITY), 0.25, 0.001, "steps(4) in the first iteration");
    motion.step(&mq, &css, sq, 160.0, 0.0);
    near(gf(&css, mq.ov, P_OPACITY), 0.75, 0.001, "the second iteration runs backwards");
    r = motion.step(&mq, &css, sq, 400.0, 0.0);
    near(gf(&css, mq.ov, P_OPACITY), 0.0, 0.001, "forwards fill holds the end of the last (reversed) iteration");
    ok(r % 2 == 0, "finished");
    // a var() inside the list: a number resolves per element; a name does not (it warns)
    let sva = style(mem, &css, "va");
    ok(animCount(&css, sva) == 2 && animAt(&css, sva, P_ANIM_ITER, 0).f == 2.0 && animAt(&css, sva, P_ANIM_ITER, 1).f == 1.0, "var() count inside an animation list");
    ok(animAt(&css, sva, P_ANIM_NAME, 1).i == css.intern("fw"), "the other entry is intact");
    let svb = style(mem, &css, "vb");
    ok(animCount(&css, svb) == 1 && gk(&css, svb, P_ANIM_NAME) != V_ANIM, "a var() name is skipped, not half applied");
    // a translate transition between px and %
    let t1 = style(mem, &css, "tr1");
    let t2 = style(mem, &css, "tr2");
    let mtr = motion.fresh();
    motion.onStyle(&mtr, &css, t1, t2, 0.0);
    motion.step(&mtr, &css, t2, 50.0, 0.0);
    near(xform.of(&css, mtr.ov, 200.0, 100.0).e, 55.0, 0.01, "transition: 5px + 25% of 200");
    // many elements with their own custom properties: one cached value each, found without a scan
    let big = Text.new(mem);
    big.pushStr("@keyframes bp { from { transform: translate(0px, 0px); } to { transform: translate(var(--dx), 0px); } }\n");
    for i in 0..200 {
        big.pushStr(".v");
        big.pushInt(i);
        big.pushStr(" { --dx: ");
        big.pushInt(i);
        big.pushStr("px; animation: bp 100ms linear forwards; }\n");
    }
    let cb = Css.new(mem);
    parse(&cb, big.str(), "big.css", 0);
    let ms = mem.alloc::<Motion>(200);
    let sts = mem.alloc::<int>(200);
    for i in 0..200 {
        sts[i] = style(mem, &cb, `v{i}`);
        ms[i] = motion.fresh();
        motion.onStyle(&ms[i], &cb, -1, sts[i], 0.0);
        motion.step(&ms[i], &cb, sts[i], 100.0, 0.0);
    }
    ok(cb.kvc.len == 200 && cb.kslots.len >= 400, "one cached value per element, in a table that grew with them");
    let okc = true;
    for i in 0..200 {
        let dx = xform.of(&cb, ms[i].ov, 100.0, 100.0).e - f32(i);
        if dx > 0.01 || dx < -0.01 {
            okc = false;
        }
    }
    ok(okc, "each element got its own --dx");
    let np2 = cb.paints.len;
    for f in 0..5 {
        for i in 0..200 {
            motion.step(&ms[i], &cb, sts[i], 10.0 + f32(f), 0.0);
        }
    }
    ok(cb.paints.len == np2 && cb.kvc.len == 200, "frames over 200 var sets add nothing");
    // CSS animations keep running under reduced motion
    css.reduced = true;
    motion.step(&mi, &css, si, 50.0, 0.0);
    ok(motion.active(&mi), "reduced motion does not stop CSS animations");
}

fn main() {
    let mem = Arena.create(8 * 1024 * 1024);
    testAnim();
    testMotion(&mem);
    testGradients(&mem);
    testMulti(&mem);
    printLn(`motion_test ok, checks passed: {CHECKS}`);
}
