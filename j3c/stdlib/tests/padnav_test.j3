// Tests for gamepad (and opt-in arrow key) focus navigation, `j3.ui.padnav` + `j3.ui.padin` through j3.ui.dom: spatial moves in a grid and
// around irregular layouts, hidden and disabled skipped, a modal trap and B closing it with focus restored, focus-group wrap and trap, nav-*
// overrides (a missing id warns once), A activating (button, checkbox, details, select whose list the pad navigates), scrolling into view,
// stick repeat timing, triggers, shoulders, the on-screen keyboard hook, ring hidden by a mouse move, hotplug (no pad) and idle frames.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/padnav_test.j3 --headless
// Panics on the first failed check.

module padnav_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.dropdown;
use j3.ui.inputs;
use j3.ui.padin;
use j3.ui.padin.PadRaw;
use j3.ui.padnav;
use j3.ui.popup;
use j3.ui.testkit;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } * { margin: 0; padding: 0; } div, button, input, summary { font-family: \"T\"; font-size: 14px; } button, input { width: 60px; height: 30px; } .wrap { display: flex; gap: 100px; } .big { display: flex; flex-wrap: wrap; width: 1750px; gap: 10px; } .g { display: flex; flex-wrap: wrap; width: 230px; gap: 10px; } .g2 { display: flex; flex-direction: column; gap: 10px; } .inv { visibility: hidden; } .row { display: flex; gap: 10px; margin-top: 20px; } .col { display: flex; flex-direction: column; gap: 10px; margin-top: 20px; } .sc { height: 100px; overflow-y: auto; margin-top: 20px; } .sc button { display: block; margin-bottom: 10px; } dialog { position: fixed; left: 400px; top: 300px; width: 200px; height: 100px; } summary { display: block; width: 60px; height: 20px; }";

// page buttons: 0..8 the 3x3 grid, 9 and 10 the column beside it; focus-group rows; override column; scroll list; extras
#[singleton]
let G: [9]int;
#[singleton]
let C: [2]int;
#[singleton]
let W: [3]int;
#[singleton]
let T: [2]int;
#[singleton]
let AFTER: int;
#[singleton]
let N: [3]int;
#[singleton]
let L: [12]int;
#[singleton]
let SCB: int;
#[singleton]
let MB: [2]int;
#[singleton]
let MODAL: int;
#[singleton]
let EXTRA: int;
#[singleton]
let CHK: int;
#[singleton]
let SEL: int;
#[singleton]
let SUM: int;
#[singleton]
let TXT: int;
#[singleton]
let TA: int;
#[singleton]
let AR: [2]int;
// switches
#[singleton]
let SHOW_MODAL: bool;
#[singleton]
let SHOW_EXTRA: bool;
#[singleton]
let HIDE1: bool;
#[singleton]
let DIS4: bool;
#[singleton]
let SHOW_ALL: bool;
// results
#[singleton]
let CLICKS: int;
#[singleton]
let CHECKED: bool;
#[singleton]
let TOGGLES: int;
#[singleton]
let OPEN: bool;
#[singleton]
let CHOSEN: string;
#[singleton]
let CHOSEN_N: int;

fn btn(d: &Dom, slot: int): int {
    let b = d.open(slot, d.tag("button"), 1);
    if d.clicked(b) { CLICKS += 1; }
    d.close();
    return b;
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    let wrap = d.open(0, d.tag("div"), 1);
    d.cls(wrap, "wrap");
    let g = d.open(0, d.tag("div"), 1);
    d.cls(g, "g");
    for i in 0..9 {
        G[i] = d.open(i, d.tag("button"), 1);
        if i == 1 && HIDE1 { d.cls(G[i], "inv"); }
        d.attrDisabled(G[i], i == 4 && DIS4);
        if d.clicked(G[i]) { CLICKS += 1; }
        d.close();
    }
    d.close();
    let g2 = d.open(1, d.tag("div"), 1);
    d.cls(g2, "g2");
    C[0] = btn(d, 0);
    C[1] = btn(d, 1);
    d.close();
    d.close();
    // a wrapping row
    let r = d.open(1, d.tag("div"), 1);
    d.cls(r, "row");
    d.attrNav(r, 0, "wrap");
    for i in 0..3 { W[i] = btn(d, i); }
    d.close();
    // a trapping row, with a button beside it that Right must not reach
    let tr = d.open(2, d.tag("div"), 1);
    d.cls(tr, "row");
    let tg = d.open(0, d.tag("div"), 1);
    d.cls(tg, "row");
    d.attrNav(tg, 0, "trap");
    T[0] = btn(d, 0);
    T[1] = btn(d, 1);
    d.close();
    AFTER = btn(d, 1);
    d.close();
    // overrides: n0 down -> n2, n2 right -> a missing id
    let nc = d.open(3, d.tag("div"), 1);
    d.cls(nc, "col");
    N[0] = btn(d, 0);
    N[1] = btn(d, 1);
    N[2] = btn(d, 2);
    d.attrNav(N[0], 2, "n2");
    d.attrNav(N[2], 4, "nowhere");
    d.attrId(N[2], "n2");
    d.close();
    // a scrolling list
    SCB = d.open(4, d.tag("div"), 1);
    d.cls(SCB, "sc");
    for i in 0..12 { L[i] = btn(d, i); }
    d.close();
    // activation targets
    let ac = d.open(5, d.tag("div"), 1);
    d.cls(ac, "row");
    CHK = d.open(0, d.tag("input"), 1);
    d.attrType(CHK, "checkbox");
    if d.clicked(CHK) { CHECKED = !CHECKED; }
    d.attrChecked(CHK, CHECKED);
    d.close();
    let det = d.open(1, d.tag("details"), 1);
    if d.userToggled(det) { OPEN = d.isOpen(det); TOGGLES += 1; }
    d.attrOpen(det, OPEN);
    SUM = d.open(0, d.tag("summary"), 1);
    d.attrTabIndex(SUM);
    d.text("S");
    d.close();
    let body = d.open(1, d.tag("div"), 1);
    d.close();
    d.close();
    SEL = d.open(2, d.tag("select"), 1);
    for i in 0..4 {
        let o = d.open(i, d.tag("option"), 1);
        d.text(`Opt {i}`);
        d.close();
    }
    if d.changed(SEL) { CHOSEN = d.strValue(SEL); CHOSEN_N += 1; }
    d.attrText(SEL, CHOSEN);
    d.close();
    TXT = d.open(3, d.tag("input"), 1);
    d.attrType(TXT, "text");
    d.close();
    TA = d.open(4, d.tag("input"), 1);
    d.attrType(TA, "textarea");
    d.close();
    d.close();
    // the arrow-key group: a button, a text box and a button
    let ar = d.open(6, d.tag("div"), 1);
    d.cls(ar, "row");
    d.attrNav(ar, 0, "arrows");
    AR[0] = btn(d, 0);
    let ai = d.open(1, d.tag("input"), 1);
    d.attrType(ai, "text");
    d.close();
    AR[1] = btn(d, 2);
    d.close();
    if SHOW_MODAL {
        MODAL = d.open(7, d.tag("dialog"), 1);
        d.attrOverlay(MODAL, dom.OV_MODAL);
        if d.closeRequested(MODAL) { SHOW_MODAL = false; }
        MB[0] = btn(d, 0);
        MB[1] = btn(d, 1);
        d.close();
    }
    d.close();
    d.layout();
    dropdown.settle(d);
    d.endFrame();
}

fn bigFrame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    let page = d.open(0, d.tag("div"), 1);
    let big = d.open(0, d.tag("div"), 1);
    d.cls(big, "big");
    for i in 0..500 {
        let b = d.open(i, d.tag("button"), 1);
        d.close();
    }
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn fresh(mem: &Arena, css: &Css): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    SHOW_MODAL = false;
    HIDE1 = false;
    DIS4 = false;
    CLICKS = 0;
    CHECKED = false;
    OPEN = false;
    TOGGLES = 0;
    CHOSEN = "";
    CHOSEN_N = 0;
    frame(&d);
    frame(&d);
    return d;
}

/// One pad press (a frame down, a frame up).
fn press(d: &Dom, names: string) {
    d.setPad(padin.parse(names));
    frame(d);
    d.setPad(padin.parse(""));
    frame(d);
}

fn at(d: &Dom, id: int, msg: string) {
    ok(d.focused() == id, msg);
}

fn testGrid(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    ok(d.focused() < 0, "nothing is focused");
    press(&d, "Down");
    at(&d, G[0], "with no focus the first move takes the first focusable");
    ok(d.focusVisible() && d.keyboard(), "pad focus is :focus-visible");
    press(&d, "Down");
    at(&d, G[3], "down in the grid");
    press(&d, "Right");
    at(&d, G[4], "right");
    press(&d, "Up");
    at(&d, G[1], "up");
    press(&d, "Left");
    at(&d, G[0], "left");
    press(&d, "Left");
    at(&d, G[0], "no move off the left edge (no wrap group)");
    press(&d, "Up");
    at(&d, G[0], "nor off the top");
    // across a gap: right from the top-right cell lands on the column beside the grid, level with it
    d.focusNode(G[2]);
    press(&d, "Right");
    at(&d, C[0], "right across a 100 px gap");
    d.focusNode(G[5]);
    press(&d, "Right");
    at(&d, C[1], "right from the middle row: the nearest level one");
    d.focusNode(G[8]);
    press(&d, "Right");
    at(&d, C[1], "right from a row with nothing level: the nearest one by distance");
    press(&d, "Left");
    at(&d, G[5], "and back left (level with the second button)");
    // the left stick moves too
    d.focusNode(G[0]);
    d.setPad(padin.parse("SDown"));
    frame(&d);
    d.setPad(padin.parse(""));
    frame(&d);
    at(&d, G[3], "the left stick moves like the D-pad");
}

fn testSkips(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    HIDE1 = true;
    DIS4 = true;
    frame(&d);
    d.focusNode(G[3]);
    press(&d, "Right");
    at(&d, G[5], "a disabled button is skipped");
    d.focusNode(G[7]);
    press(&d, "Up");
    ok(d.focused() != G[4] && d.focused() != G[1], "neither the disabled nor the hidden one is a target");
    d.focusNode(G[0]);
    press(&d, "Right");
    at(&d, G[2], "a hidden button is skipped");
}

fn testGroups(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(W[2]);
    press(&d, "Right");
    at(&d, W[0], "wrap: right off the end comes round to the first");
    press(&d, "Left");
    at(&d, W[2], "wrap: left off the start goes to the last");
    press(&d, "Right");
    press(&d, "Right");
    at(&d, W[1], "wrap does not stop normal moves");
    d.focusNode(T[1]);
    press(&d, "Right");
    at(&d, T[1], "trap: right stays inside the group even with a button beside it");
    press(&d, "Left");
    at(&d, T[0], "trap: moves inside still work");
    d.focusNode(AFTER);
    press(&d, "Left");
    at(&d, T[1], "a button outside the trap can move into it");
}

fn testOverrides(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(N[0]);
    press(&d, "Down");
    at(&d, N[2], "nav-down names where down goes (skipping the next one)");
    let w0 = css.warns.len;
    press(&d, "Right");
    ok(css.warns.len == w0 + 1, "a missing nav id warns");
    ok(d.focused() != N[2] && d.focused() >= 0, "and the move falls back to position");
    press(&d, "Right");
    press(&d, "Right");
    ok(css.warns.len == w0 + 1, "but only once");
}

fn testActivate(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(G[0]);
    press(&d, "A");
    ok(CLICKS == 1, "A clicks a button");
    d.focusNode(CHK);
    d.setKeyboard(true);
    press(&d, "A");
    ok(CHECKED, "A toggles a checkbox");
    press(&d, "A");
    ok(!CHECKED, "and again");
    d.focusNode(SUM);
    press(&d, "A");
    ok(OPEN && TOGGLES == 1, "A toggles a details through its summary");
    press(&d, "A");
    ok(!OPEN, "and closes it");
    // a select: A opens it, the pad moves the list, A chooses
    d.focusNode(SEL);
    press(&d, "A");
    ok(d.pop.kind != popup.NONE, "A opens a select");
    press(&d, "Down");
    press(&d, "Down");
    ok(d.focused() == SEL, "the pad moved the list, not the focus");
    press(&d, "A");
    ok(d.pop.kind == popup.NONE && CHOSEN_N == 1 && same(CHOSEN, "Opt 2"), "A chooses the highlighted option");
    press(&d, "A");
    ok(d.pop.kind != popup.NONE, "opens again");
    press(&d, "B");
    ok(d.pop.kind == popup.NONE && d.focused() == SEL && CHOSEN_N == 1, "B closes the list and keeps the focus and value");
}

fn testModal(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(G[2]);
    press(&d, "Right");
    SHOW_MODAL = true;
    frame(&d);
    frame(&d);
    frame(&d);
    at(&d, MB[0], "a modal takes focus on open");
    press(&d, "Left");
    press(&d, "Up");
    press(&d, "Down");
    ok(d.focused() == MB[0] || d.focused() == MB[1], "pad moves stay inside the modal");
    press(&d, "Right");
    press(&d, "Right");
    press(&d, "Right");
    press(&d, "Down");
    ok(d.focused() == MB[0] || d.focused() == MB[1], "however far the page buttons are, never out");
    press(&d, "B");
    frame(&d);
    frame(&d);
    frame(&d);
    ok(!SHOW_MODAL, "B closes the modal");
    at(&d, C[0], "and focus returns to the control that had it");
}

fn testScroll(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.setReducedMotion(true);
    d.focusNode(L[0]);
    ok(d.nodes.items[SCB].scrollMax > 0.0, "the list scrolls");
    for i in 0..8 {
        press(&d, "Down");
    }
    at(&d, L[8], "eight moves down");
    let sc = d.nodes.items[SCB].scrollY;
    ok(sc > 0.0, "the list scrolled to keep the focus in view");
    let top = d.absY(L[8]) - d.absY(SCB);
    ok(top >= 0.0 && top + d.nodes.items[L[8]].h <= d.nodes.items[SCB].h + 0.5, "and it is inside the box, instantly under reduced motion");
    // triggers page, right stick scrolls
    let y0 = d.nodes.items[SCB].scrollY;
    press(&d, "LT");
    ok(d.nodes.items[SCB].scrollY < y0, "LT scrolls a page up");
    y0 = d.nodes.items[SCB].scrollY;
    press(&d, "RT");
    ok(d.nodes.items[SCB].scrollY > y0, "RT scrolls a page down");
    y0 = d.nodes.items[SCB].scrollY;
    d.setPad(padin.parse("RUp"));
    frame(&d);
    frame(&d);
    d.setPad(padin.parse(""));
    frame(&d);
    ok(d.nodes.items[SCB].scrollY < y0, "the right stick scrolls the box smoothly");
}

fn testRepeat(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(L[0]);
    let moves = 0;
    let last = d.focused();
    let at25 = -1;
    let movesAt24 = 0;
    d.setPad(padin.parse("Down"));
    for f in 0..40 {
        frame(&d);
        if d.focused() != last {
            moves += 1;
            last = d.focused();
        }
        if f == 24 { movesAt24 = moves; }
        if f == 25 { at25 = moves; }
    }
    d.setPad(padin.parse(""));
    frame(&d);
    ok(movesAt24 == 1, "held: one move at once, none before 400 ms");
    ok(at25 == 2, "the first repeat at 400 ms (frame 25 of 16 ms)");
    ok(moves == 3, "then every 120 ms (the next at frame 33, and not at 40)");
}

fn testMisc(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(G[0]);
    d.setPad(padin.parse("RB"));
    frame(&d);
    ok(d.padShoulder == 1, "RB reads as shoulder +1");
    frame(&d);
    ok(d.padShoulder == 0, "for one frame");
    d.setPad(padin.parse("LB"));
    frame(&d);
    ok(d.padShoulder == -1, "LB reads as -1");
    d.setPad(padin.parse(""));
    frame(&d);
    // the on-screen keyboard hook
    d.focusNode(AR[0]);
    d.setPad(padin.parse("Right"));
    frame(&d);
    ok(d.padText >= 0 && d.padText == d.focused() && d.focused() != AR[0], "moving onto a text box names it in padText (the on-screen keyboard hook)");
    d.setPad(padin.parse(""));
    frame(&d);
    ok(d.padText == -1, "for one frame");
    d.focusNode(G[0]);
    // mouse move hides the ring
    press(&d, "Down");
    ok(d.focusVisible(), "ring shows after a pad move");
    d.simInput(300.0, 500.0, false, 0.0);
    frame(&d);
    ok(!d.focusVisible() && !d.keyboard(), "a mouse move hides the ring again");
    // hotplug: no pad at all, polled
    d.usePad(false);
    for i in 0..5 { frame(&d); }
    ok(d.focused() >= 0, "polling with no pad attached does nothing");
}

fn testArrows(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(AR[0]);
    d.setKeyboard(true);
    d.simKeys("", "Right");
    frame(&d);
    ok(d.focused() != AR[0] && d.focused() >= 0, "an arrow moves focus inside a focus-group with arrows");
    let tb = d.focused();
    d.simKeys("", "Right");
    frame(&d);
    ok(d.focused() == tb, "a text box keeps its arrow keys");
    d.focusNode(G[0]);
    d.simKeys("", "Right");
    frame(&d);
    ok(d.focused() == G[0], "outside such a group the arrows do nothing");
}

fn testHotplug(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(L[0]);
    d.setPad(padin.parse("Down"));
    for f in 0..30 { frame(&d); }
    let held = d.focused();
    ok(held != L[0], "a held direction moves");
    // unplugged while held: nothing repeats, focus stays
    d.setPad(PadRaw { attached: false, mask: 1 + 2 + 16 });
    for f in 0..60 { frame(&d); }
    ok(d.focused() == held, "a pad unplugged mid-hold stops repeating and focus stays");
    ok(CLICKS == 0, "and no button was activated");
    // plugged in again with the direction still down: moves at once, then repeats on the clock
    d.setPad(padin.parse("Down"));
    frame(&d);
    ok(d.focused() != held, "plugged in again: the held direction moves at once");
    let at = d.focused();
    for f in 0..10 { frame(&d); }
    ok(d.focused() == at, "and waits the first-repeat delay");
    d.setPad(PadRaw { attached: false });
    for f in 0..60 { frame(&d); }
    ok(d.focused() == at, "unplugged again: still");
    d.usePad(false);
    for f in 0..5 { frame(&d); }
    ok(d.focused() == at, "back to polling: no crash, no move");
    // two pads at once: any pad's button counts, the larger push wins an axis
    let a = padin.parse("Down SLeft");
    let b = padin.parse("A SRight RT");
    b.lx = 0.9;
    a.lx = -0.4;
    let m = padin.merge(&a, &b);
    ok(padin.has(m.mask, padin.B_DOWN) && padin.has(m.mask, padin.B_A) && m.lx == 0.9 && m.rt == 1.0 && m.attached, "two pads merge: buttons or'd, larger axis wins");
    let off = PadRaw { attached: false };
    let un = padin.merge(&off, &off);
    ok(!un.attached, "two unplugged pads are unplugged");
    let one = padin.merge(&off, &b);
    ok(one.attached && padin.has(one.mask, padin.B_A), "one of two plugged in drives");
    // pad 1 pressing while pad 0 is also held: one move per direction, driven by the merged state
    d.focusNode(L[0]);
    d.setPad(m);
    frame(&d);
    ok(CLICKS == 1 || d.focused() >= 0, "merged input runs");
}

fn testTextareaA(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(TA);
    d.setPad(padin.parse("A"));
    frame(&d);
    ok(d.padText == TA, "A on a textarea asks for the on-screen keyboard");
    d.setPad(padin.parse(""));
    frame(&d);
    frame(&d);
    ok(d.strValue(TA).len == 0, "and types no newline");
    d.focusNode(TXT);
    d.setPad(padin.parse("A"));
    frame(&d);
    ok(d.padText == -1 && d.kin.enter, "A on a single-line box is still Enter (submit)");
}

fn testMouseAfterPad(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    press(&d, "Down");
    press(&d, "Right");
    ok(d.focusVisible() && padnav.usingPad(&d), "pad focus: ring, pad is the last device");
    // a click on the focused button (no focus change, no big move) switches back
    let f = d.focused();
    d.simInput(d.absX(f) + 5.0, d.absY(f) + 5.0, false, 0.0);
    frame(&d);
    ok(!padnav.usingPad(&d), "a mouse move ends pad mode");
    press(&d, "Down");
    ok(d.focusVisible() && padnav.usingPad(&d) && d.keyboard(), "pad input again restores the ring");
    f = d.focused();
    d.simInput(d.absX(f) + 5.0, d.absY(f) + 5.0, false, 0.0);
    frame(&d);
    d.simInput(d.absX(f) + 5.0, d.absY(f) + 5.0, true, 0.0);
    frame(&d);
    ok(!d.keyboard() && !d.focusVisible() && !padnav.usingPad(&d), "a mouse press hides the ring and sets pointer modality");
    d.simInput(d.absX(f) + 5.0, d.absY(f) + 5.0, false, 0.0);
    frame(&d);
    press(&d, "Right");
    ok(d.keyboard() && d.focusVisible() && padnav.usingPad(&d), "and the pad restores it again");
}

fn testIdleCost(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    d.focusNode(G[0]);
    d.usePad(false);
    let v0 = d.padVisits;
    let r0 = d.padReads;
    for i in 0..60 { frame(&d); }
    ok(d.padReads == r0 && d.padVisits == v0, "no pad attached: no pad reads and no geometry in 60 frames");
    // a plugged-in pad that is not touched: read each frame, still no geometry
    d.setPad(padin.parse(""));
    for i in 0..60 { frame(&d); }
    ok(d.padReads == r0 + 60 && d.padVisits == v0, "an idle pad is one read per frame and no search");
}

fn testBig(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    bigFrame(&d);
    bigFrame(&d);
    ok(d.nodes.len > 500, "500 buttons built");
    press2(&d, "Down");
    let first = d.focused();
    ok(first >= 0, "the first move focuses the first button");
    let v0 = d.padVisits;
    press2(&d, "Down");
    let visits = d.padVisits - v0;
    ok(visits <= d.nodes.len && visits > 0, `one move looks at each node at most once ({visits} of {d.nodes.len})`);
    ok(d.absY(d.focused()) > d.absY(first) && d.absX(d.focused()) == d.absX(first), "and moves one row down");
    // 50 moves: linear, not quadratic
    v0 = d.padVisits;
    for i in 0..50 { press2(&d, "Right"); }
    ok(d.padVisits - v0 <= 50 * d.nodes.len, "50 moves cost at most 50 passes");
    ok(d.laid < 100000, "no layout storm");
}

fn press2(d: &Dom, names: string) {
    d.setPad(padin.parse(names));
    bigFrame(d);
    d.setPad(padin.parse(""));
    bigFrame(d);
}

fn testIdle(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    press(&d, "Down");
    press(&d, "Right");
    frame(&d);
    let used = d.mem.used;
    let laid = d.laid;
    let rest = d.restyled;
    for i in 0..30 { frame(&d); }
    ok(d.mem.used == used && d.laid == laid && d.restyled == rest, "idle frames with the pad polled allocate, lay out and restyle nothing");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "padnav.css", 1);
    ok(css.warns.len == 0, "sheet parses without warnings");
    testGrid(&mem, &css);
    testSkips(&mem, &css);
    testGroups(&mem, &css);
    testOverrides(&mem, &css);
    testActivate(&mem, &css);
    testModal(&mem, &css);
    testScroll(&mem, &css);
    testRepeat(&mem, &css);
    testMisc(&mem, &css);
    testArrows(&mem, &css);
    testHotplug(&mem, &css);
    testTextareaA(&mem, &css);
    testMouseAfterPad(&mem, &css);
    testIdleCost(&mem, &css);
    testBig(&mem, &css);
    testIdle(&mem, &css);
    printLn(`padnav_test ok, checks passed: {CHECKS}`);
}
