// Tests for independent `overflow-x` / `overflow-y` (`clip`, the two-value shorthand, visible -> auto coercion, one-axis clipping,
// one-axis scrolling) in `j3.ui.dom`. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 120 j3c run j3c/stdlib/tests/overflow_test.j3 --headless
// Panics on the first failed check.

module overflow_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.{ Dom, SC_START };
use j3.ui.inputs;

const SHEET: string = ".bx { position: absolute; width: 100px; height: 100px; } .big { width: 300px; height: 300px; } .a { left: 0px; top: 0px; overflow: hidden auto; } .b { left: 150px; top: 0px; overflow: auto hidden; } .c { left: 300px; top: 0px; overflow-x: hidden; } .d { left: 0px; top: 400px; overflow-x: clip; overflow-y: visible; } .o { left: 450px; top: 0px; overflow: auto; } .i { width: 100px; height: 100px; overflow: hidden auto; } .e { left: 150px; top: 400px; overflow-x: clip; overflow-y: auto; } .e .t { width: 20px; height: 20px; } .e .sp { height: 250px; } .ng { left: 570px; top: 150px; overflow: auto; } .nx { position: relative; z-index: 1; width: 60px; height: 40px; overflow-x: clip; overflow-y: visible; } .nk { width: 200px; height: 80px; } .yo { left: 570px; top: 300px; overflow-y: auto; overflow-x: hidden; } .sp2 { height: 150px; } .xi { width: 80px; height: 40px; overflow-x: auto; overflow-y: hidden; } .row { display: flex; width: 180px; height: 40px; } .cl { flex-shrink: 0; width: 60px; height: 40px; } .tl { height: 200px; } .rr { position: absolute; left: 300px; top: 560px; width: 100px; height: 40px; box-sizing: border-box; display: flex; overflow-x: auto; border-left: 3px solid #fff; border-right: 5px solid #fff; padding: 0 7px 0 4px; } .rr.rev { left: 450px; flex-direction: row-reverse; } .rr .cl { width: 60px; } .f { position: absolute; left: 300px; top: 400px; width: 150px; height: 60px; display: flex; overflow-x: auto; overflow-y: clip; scroll-snap-type: x mandatory; } .card { flex-shrink: 0; width: 100px; height: 40px; scroll-snap-align: start; }";

#[singleton]
let CHECKS: int;
#[singleton]
let ID: [16]int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn box(d: &Dom, k: int, cls: string): int {
    let b = d.open(k, d.tag("div"), 1);
    d.cls(b, "bx");
    d.cls(b, cls);
    ID[k] = b;
    return b;
}

fn leaf(d: &Dom, k: int, cls: string): int {
    let c = d.open(k, d.tag("div"), 1);
    d.cls(c, cls);
    d.close();
    return c;
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 700.0, y: 700.0 });
    inputs.begin(d);
    box(d, 0, "a");
    ID[8] = leaf(d, 0, "big");
    d.close();
    box(d, 1, "b");
    leaf(d, 0, "big");
    d.close();
    box(d, 2, "c");
    leaf(d, 0, "big");
    d.close();
    box(d, 3, "d");
    ID[9] = leaf(d, 0, "big");
    d.close();
    box(d, 4, "o");
    let i = d.open(0, d.tag("div"), 1);
    d.cls(i, "i");
    ID[5] = i;
    leaf(d, 0, "big");
    d.close();
    leaf(d, 1, "big");
    d.close();
    box(d, 6, "e");
    leaf(d, 0, "sp");
    ID[7] = leaf(d, 1, "t");
    leaf(d, 2, "big");
    d.close();
    let f = d.open(7, d.tag("div"), 1);
    d.cls(f, "f");
    for q in 0..3 { leaf(d, q, "card"); }
    d.close();
    box(d, 8, "ng");
    let nx = d.open(0, d.tag("div"), 1);
    d.cls(nx, "nx");
    ID[10] = leaf(d, 0, "nk");
    d.close();
    d.close();
    box(d, 11, "yo");
    leaf(d, 0, "sp2");
    let xi = d.open(1, d.tag("div"), 1);
    d.cls(xi, "xi");
    ID[12] = xi;
    let row = d.open(0, d.tag("div"), 1);
    d.cls(row, "row");
    for q in 0..3 { let c = leaf(d, q, "cl"); if q == 2 { ID[13] = c; } }
    d.close();
    d.close();
    leaf(d, 2, "tl");
    d.close();
    for q in 0..2 {
        let r = d.open(10 + q, d.tag("div"), 1);
        d.cls(r, "rr");
        if q == 1 { d.cls(r, "rev"); }
        ID[14 + q] = r;
        for k in 0..3 { leaf(d, k, "cl"); }
        d.close();
    }
    d.layout();
    d.endFrame();
}

fn idle(d: &Dom, n: int) {
    for i in 0..n {
        d.simInput(-5.0, -5.0, false, 0.0);
        frame(d);
    }
}

fn wheelAt(d: &Dom, x: f32, y: f32, notches: f32) {
    d.simInput(x, y, false, 0.0 - notches);
    frame(d);
}

fn near(a: f32, b: f32, msg: string) {
    let e = a - b;
    if e < 0.0 { e = 0.0 - e; }
    if e > 0.6 {
        printLn(`{msg}: {a} vs {b}`);
    }
    ok(e <= 0.6, msg);
}

fn sx(d: &Dom, id: int): f32 { return d.nodes.items[id].scrollX; }
fn sy(d: &Dom, id: int): f32 { return d.nodes.items[id].scrollY; }

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "overflow.css", 1);
    ok(css.warns.len == 0, "sheet parses without warnings (clip is a keyword)");
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    idle(&d, 3);

    // `overflow: hidden auto`: x hidden (code only), y auto; `auto hidden` is the other way round
    let a = ID[0];
    let b = ID[1];
    ok(d.nodes.items[a].scrollMax == 200.0 && d.nodes.items[a].scrollMaxX == 200.0, "hidden auto: both axes have a range");
    wheelAt(&d, 50.0, 50.0, 1.0);
    ok(sy(&d, a) > 0.0 && sx(&d, a) == 0.0, "shorthand order: the wheel scrolls the auto axis (y) of `hidden auto`");
    wheelAt(&d, 200.0, 50.0, 1.0);
    ok(sx(&d, b) > 0.0 && sy(&d, b) == 0.0, "shorthand order: the wheel scrolls the auto axis (x) of `auto hidden`");

    // `overflow-x: hidden` alone: y computes to auto, so it scrolls and the wheel moves it
    let c = ID[2];
    ok(d.nodes.items[c].scrollMax == 200.0, "overflow-x: hidden makes visible y auto: it has a range");
    wheelAt(&d, 350.0, 50.0, 1.0);
    ok(sy(&d, c) > 0.0 && sx(&d, c) == 0.0, "the coerced y axis takes the wheel");

    // `clip` + `visible` clips x only and scrolls nowhere
    let dd = ID[3];
    ok(d.nodes.items[dd].scrollMax == 0.0 && d.nodes.items[dd].scrollMaxX == 0.0, "clip and visible: no scroll range");
    d.simInput(50.0, 550.0, false, 0.0);
    frame(&d);
    ok(d.hover == ID[9], "below the box on the visible axis, the child is hit");
    d.simInput(200.0, 450.0, false, 0.0);
    frame(&d);
    ok(d.hover != ID[9], "right of the box on the clipped axis, the child is missed");
    d.simInput(50.0, 450.0, false, 0.0);
    frame(&d);
    ok(d.hover == ID[9], "inside the box the child is hit");

    // shift + wheel over a y-only scroller goes on to the parent's x axis
    let o = ID[4];
    d.simKeys("", "Shift");
    wheelAt(&d, 500.0, 50.0, 1.0);
    ok(sx(&d, ID[5]) == 0.0 && sx(&d, o) > 0.0, "a sideways wheel passes a y-only scroller to the parent");
    idle(&d, 2);
    wheelAt(&d, 500.0, 50.0, 1.0);
    ok(sy(&d, ID[5]) > 0.0 && sy(&d, o) == 0.0, "a plain wheel scrolls the y-only scroller itself");

    // scrollIntoView with the target in view on x moves y only
    let e = ID[6];
    ok(d.nodes.items[e].scrollMaxX == 200.0 && d.nodes.items[e].scrollMax > 0.0, "clip next to auto computes to hidden: x has a range for code");
    d.scrollIntoView(ID[7], SC_START, false);
    idle(&d, 2);
    ok(sy(&d, e) > 0.0 && sx(&d, e) == 0.0, "scrollIntoView moves y, and x stays when the target is in view");

    // snap on an x-only scroller (y clips)
    let f = -1;
    for q in 0..d.nodes.len {
        if d.nodes.items[q].scrollMaxX == 150.0 && d.nodes.items[q].h == 60.0 { f = q; }
    }
    ok(f >= 0 && d.nodes.items[f].scrollMax == 0.0, "x-only snap box found, no y range");
    wheelAt(&d, 350.0, 420.0, 2.0);
    idle(&d, 20);
    ok(sx(&d, f) == 100.0 && sy(&d, f) == 0.0, "snap settles on the x axis");

    // nested chain (a lifted z-index box inside a scroller): hit on the unclipped axis, miss on the clipped one
    d.simInput(590.0, 210.0, false, 0.0);
    frame(&d);
    ok(d.hover == ID[10], "stacking-context chain: a child past the box on the visible axis is hit");
    d.simInput(650.0, 160.0, false, 0.0);
    frame(&d);
    ok(d.hover != ID[10], "stacking-context chain: a child past the box on the clipped axis is missed");

    // an x-only scroller nested in a y-only scroller: x goes to the inner, y to the outer
    let yo = ID[11];
    ok(d.nodes.items[ID[12]].scrollMaxX == 100.0 && d.nodes.items[ID[12]].scrollMax == 0.0, "inner x range 100, no y range");
    d.scrollIntoView(ID[13], SC_START, false);
    idle(&d, 2);
    ok(sx(&d, ID[12]) > 0.0 && sy(&d, ID[12]) == 0.0, "intoView scrolls the inner x-only box on x");
    ok(sy(&d, yo) > 0.0 && sx(&d, yo) == 0.0, "intoView scrolls the outer y-only box on y");

    // the x range counts the borders and padding: border-box 100, border 3 + 5, padding 4 + 7, three 60px items
    near(d.nodes.items[ID[14]].scrollMaxX, 99.0, "row: padding on both sides, borders not content");
    near(d.nodes.items[ID[15]].scrollMaxX, 0.0, "row-reverse overflows to the start: no range");

    let used = d.mem.used;
    let laid = d.laid;
    idle(&d, 30);
    ok(d.mem.used == used && d.laid == laid && !d.isLive(), "idle frames allocate and lay out nothing");
    printLn(`overflow_test ok, checks passed: {CHECKS}`);
}
