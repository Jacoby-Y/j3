// css_test: value parsing for flex, sizes, text, snap, color-mix, transforms, grid areas.

module css_test;

fn testMaxWidth(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, ".a { max-width: none; } .b { max-width: 25%; } .c { max-width: calc(50% - 2em); } .d { max-width: 3rem; transition: max-width 100ms; }", "limits.css", 0);
    ok(c.warns.len == 0, "max-width lengths, none, calc, units and transition parse");
    let prop = propId("max-width");
    ok(prop == P_MAX_WIDTH, "max-width property exposed");
    ok(animKind(prop) == CK_LEN, "max-width animates as a length");
    ok(initial(prop).kind == V_AUTO, "max-width defaults to none");
}

fn testFlexProps(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, ".reverse { flex-direction: row-reverse; flex-wrap: wrap-reverse; } .column { flex-direction: column-reverse; flex-wrap: wrap; }", "reverse.css", 0);
    ok(c.warns.len == 0, "reverse directions and wrap reverse parse");
    let rn = mem.alloc::<MatchNode>(3);
    node(mem, &c, rn, 0, "div", "reverse", -1, 0, 0);
    node(mem, &c, rn, 1, "div", "column", -1, 0, 0);
    node(mem, &c, rn, 2, "div", "", -1, 0, 0);
    let rs = computeStyle(&c, rn, 0, -1);
    let cs = computeStyle(&c, rn, 1, -1);
    let ds = computeStyle(&c, rn, 2, -1);
    ok(gi(&c, rs, propId("flex-direction")) == 2 && gi(&c, rs, propId("flex-wrap")) == 2, "row reverse and wrap reverse keyword indices");
    ok(gi(&c, cs, propId("flex-direction")) == 3 && gi(&c, cs, propId("flex-wrap")) == 1, "column reverse and ordinary wrapping keyword indices");
    ok(gi(&c, ds, propId("flex-direction")) == 0 && gi(&c, ds, propId("flex-wrap")) == 0, "ordinary row nowrap defaults preserved");
    parse(&c, ".a { flex-basis: auto; flex-shrink: 0; align-self: auto; order: -2; } .b { flex-basis: calc(50% - 1em); flex-shrink: 0.5; align-self: baseline; order: 2; } .c { flex-basis: 2rem; align-self: stretch; }", "flex.css", 0);
    ok(c.warns.len == 0, "flex longhands support auto calc units factors and signed order");
    ok(propId("flex-basis") == P_FLEX_BASIS && propId("flex-shrink") == P_FLEX_SHRINK && propId("align-self") == P_ALIGN_SELF && propId("order") == P_ORDER, "flex property table exposure");
    ok(initial(P_FLEX_SHRINK).f == 1.0 && initial(P_ORDER).f == 0.0 && initial(P_ALIGN_SELF).i == 0, "flex item initial values");
    ok(animKind(P_FLEX_BASIS) == CK_LEN, "basis animation uses length units");
    parse(&c, ".bad { flex-shrink: -1; order: 1.5; align-self: sideways; flex-basis: -2px; } .decimal { order: 2.0; }", "bad-flex.css", 0);
    ok(c.warns.len == 5, "negative shrink/basis fractional order and invalid alignment rejected");
}

// :not(), :nth-child(), :last-child, and the properties that came with them
fn testNewCss(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, "li:not(.on) { width: 1px; } li:nth-child(2) { height: 2px; } li:nth-child(odd) { opacity: 0.25; } li:nth-child(-n+2) { gap: 3px; } li:nth-child( 2n + 2 ) { order: 5; } li:last-child { flex-shrink: 4; } li:not(.on, .zz):nth-child(3) { row-gap: 6px; } li:nth-child(n+3) { max-width: 8px; } li:nth-child(x) { color: #fff; } li:not(li li) { color: #fff; }", "new.css", 0);
    ok(c.warns.len == 2, "bad :nth-child() and :not() with a combinator are dropped");
    ok(c.rules.items[0].spec == 101 && c.rules.items[1].spec == 101, ":not(.on) and :nth-child count as a class");
    ok(c.rules.items[6].spec == 201, ":not(.on, .zz):nth-child(3): :not counts its most specific argument (0,2,1)");
    ok(c.sibMode == 2, ":nth-child restyles the following siblings");
    let n = mem.alloc::<MatchNode>(5);
    node(mem, &c, n, 0, "ul", "", -1, 0, 0);
    sib(mem, &c, n, 1, "", "", -1);
    sib(mem, &c, n, 2, "on", "", 1);
    sib(mem, &c, n, 3, "", "", 2);
    sib(mem, &c, n, 4, "", "", 3);
    n[4].flags = FL_LAST_CHILD;
    let wd = propId("width");
    ok(gf(&c, computeStyle(&c, n, 1, -1), wd) == 1.0 && gf(&c, computeStyle(&c, n, 3, -1), wd) == 1.0 && gf(&c, computeStyle(&c, n, 4, -1), wd) == 1.0, ":not(.on) matches the others");
    ok(gkind(&c, computeStyle(&c, n, 2, -1), wd) == V_AUTO, ":not(.on) skips .on");
    let ht = propId("height");
    ok(gf(&c, computeStyle(&c, n, 2, -1), ht) == 2.0 && gkind(&c, computeStyle(&c, n, 3, -1), ht) == V_AUTO, ":nth-child(2)");
    ok(gf(&c, computeStyle(&c, n, 1, -1), P_OPACITY) == 0.25 && gf(&c, computeStyle(&c, n, 3, -1), P_OPACITY) == 0.25, "odd");
    ok(gf(&c, computeStyle(&c, n, 2, -1), P_OPACITY) == 1.0 && gf(&c, computeStyle(&c, n, 4, -1), P_OPACITY) == 1.0, "not even");
    ok(gf(&c, computeStyle(&c, n, 1, -1), P_GAP) == 3.0 && gf(&c, computeStyle(&c, n, 2, -1), P_GAP) == 3.0 && gf(&c, computeStyle(&c, n, 3, -1), P_GAP) == 0.0, "-n+2 is the first two");
    ok(gf(&c, computeStyle(&c, n, 2, -1), P_ORDER) == 5.0 && gf(&c, computeStyle(&c, n, 4, -1), P_ORDER) == 5.0 && gf(&c, computeStyle(&c, n, 3, -1), P_ORDER) == 0.0, "2n + 2 is the even ones");
    ok(gf(&c, computeStyle(&c, n, 4, -1), P_FLEX_SHRINK) == 4.0 && gf(&c, computeStyle(&c, n, 3, -1), P_FLEX_SHRINK) == 1.0, ":last-child follows the flag");
    ok(gf(&c, computeStyle(&c, n, 3, -1), propId("row-gap")) == 6.0 && gf(&c, computeStyle(&c, n, 4, -1), propId("row-gap")) == 0.0, ":not(a, b) with :nth-child(3)");
    ok(gf(&c, computeStyle(&c, n, 3, -1), P_MAX_WIDTH) == 8.0 && gf(&c, computeStyle(&c, n, 4, -1), P_MAX_WIDTH) == 8.0 && gkind(&c, computeStyle(&c, n, 2, -1), P_MAX_WIDTH) == V_AUTO, "n+3 is the third on");
    let p = Css.new(mem);
    parse(&p, "b { text-decoration: underline; font-style: italic; cursor: pointer; aspect-ratio: 16 / 9; outline: 2px dashed #f00; outline-offset: -3px; } i { text-decoration: line-through #f00; aspect-ratio: 2; outline: none; } u { aspect-ratio: auto; text-decoration-line: overline; outline-style: dotted; }", "props.css", 0);
    ok(p.warns.len == 0, "the new properties parse");
    let q = mem.alloc::<MatchNode>(4);
    node(mem, &p, q, 0, "b", "", -1, 0, 0);
    node(mem, &p, q, 1, "i", "", 0, 0, 0);
    node(mem, &p, q, 2, "u", "", -1, 0, 0);
    node(mem, &p, q, 3, "s", "", 0, 0, 0);
    let sb = computeStyle(&p, q, 0, -1);
    ok(gi(&p, sb, P_TEXT_DECORATION) == 1 && gi(&p, sb, P_FONT_STYLE) == 1 && gi(&p, sb, P_CURSOR) == 2, "decoration, italic, cursor");
    ok(gf(&p, sb, P_ASPECT_RATIO) > 1.77 && gf(&p, sb, P_ASPECT_RATIO) < 1.78, "16 / 9");
    ok(gf(&p, sb, P_OUTLINE_WIDTH) == 2.0 && gi(&p, sb, P_OUTLINE_STYLE) == 1 && gc(&p, sb, P_OUTLINE_COLOR) == rgba(255, 0, 0, 255) && gf(&p, sb, P_OUTLINE_OFFSET) == -3.0, "outline shorthand and offset");
    let si = computeStyle(&p, q, 1, sb);
    ok(gi(&p, si, P_TEXT_DECORATION) == 2 && gf(&p, si, P_ASPECT_RATIO) == 2.0 && gi(&p, si, P_OUTLINE_STYLE) == 3, "line-through, ratio 2, outline none");
    ok(gi(&p, si, P_CURSOR) == 2 && gi(&p, si, P_FONT_STYLE) == 1, "cursor and font-style inherit");
    ok(gkind(&p, si, P_ASPECT_RATIO) == V_NUM && gkind(&p, computeStyle(&p, q, 3, sb), P_ASPECT_RATIO) == V_AUTO, "aspect-ratio does not inherit");
    let su = computeStyle(&p, q, 2, -1);
    ok(gkind(&p, su, P_ASPECT_RATIO) == V_AUTO && gi(&p, su, P_TEXT_DECORATION) == 3 && gi(&p, su, P_OUTLINE_STYLE) == 2, "auto, overline, dotted");
    ok(gi(&p, computeStyle(&p, q, 3, sb), P_OUTLINE_STYLE) == 3, "outline-style does not inherit");
}

// font-variant-numeric: keyword values, inherited, an unknown word warns
fn testNumericCss(mem: &Arena) {
    let p = Css.new(mem);
    parse(&p, "b { font-variant-numeric: tabular-nums; } i { font-variant-numeric: normal; } u { font-variant-numeric: slashed-zero; } s { font-variant-numeric: proportional-nums; }", "num.css", 0);
    ok(p.warns.len == 0, "font-variant-numeric keywords parse");
    let q = mem.alloc::<MatchNode>(5);
    node(mem, &p, q, 0, "b", "", -1, 0, 0);
    node(mem, &p, q, 1, "x", "", 0, 0, 0);
    node(mem, &p, q, 2, "i", "", 0, 0, 0);
    node(mem, &p, q, 3, "u", "", -1, 0, 0);
    node(mem, &p, q, 4, "s", "", -1, 0, 0);
    let sb = computeStyle(&p, q, 0, -1);
    ok(gi(&p, sb, P_FONT_VARIANT_NUMERIC) == 1, "tabular-nums is index 1");
    ok(gi(&p, computeStyle(&p, q, 1, sb), P_FONT_VARIANT_NUMERIC) == 1, "font-variant-numeric inherits");
    ok(gi(&p, computeStyle(&p, q, 2, sb), P_FONT_VARIANT_NUMERIC) == 0, "normal switches it off under a tabular parent");
    ok(gi(&p, computeStyle(&p, q, 3, -1), P_FONT_VARIANT_NUMERIC) == 5 && gi(&p, computeStyle(&p, q, 4, -1), P_FONT_VARIANT_NUMERIC) == 2, "other keywords parse");
    ok(gi(&p, computeStyle(&p, q, 1, -1), P_FONT_VARIANT_NUMERIC) == 0, "initial is normal");
    let w = Css.new(mem);
    parse(&w, "b { font-variant-numeric: bogus-nums; }", "bad.css", 0);
    ok(w.warns.len == 1, "an unknown font-variant-numeric value warns");
}

// letter-spacing, word-spacing, text-transform, text-indent: units, normal, negatives, percentages, inheritance, warnings
fn testSpacingCss(mem: &Arena) {
    let p = Css.new(mem);
    parse(&p, "b { font-size: 20px; letter-spacing: 0.5em; word-spacing: -2px; text-indent: 25%; text-transform: uppercase; } i { letter-spacing: normal; word-spacing: 0; text-transform: none; text-indent: 1.5em; } u { letter-spacing: 1rem; text-indent: -10px; text-transform: capitalize; } s { text-transform: lowercase; letter-spacing: -0.1em; }", "sp.css", 0);
    ok(p.warns.len == 0, "spacing, transform and indent values parse");
    let q = mem.alloc::<MatchNode>(5);
    node(mem, &p, q, 0, "b", "", -1, 0, 0);
    node(mem, &p, q, 1, "x", "", 0, 0, 0);
    node(mem, &p, q, 2, "i", "", 0, 0, 0);
    node(mem, &p, q, 3, "u", "", -1, 0, 0);
    node(mem, &p, q, 4, "s", "", -1, 0, 0);
    let sb = computeStyle(&p, q, 0, -1);
    ok(gkind(&p, sb, P_LETTER_SPACING) == V_PX && gf(&p, sb, P_LETTER_SPACING) == 10.0, "0.5em at 20px is 10px");
    ok(gf(&p, sb, P_WORD_SPACING) == -2.0, "word-spacing may be negative");
    ok(gkind(&p, sb, P_TEXT_INDENT) == V_PCT && gf(&p, sb, P_TEXT_INDENT) == 25.0, "text-indent keeps a percentage");
    ok(gi(&p, sb, P_TEXT_TRANSFORM) == 1, "uppercase is index 1");
    let sx = computeStyle(&p, q, 1, sb);
    ok(gf(&p, sx, P_LETTER_SPACING) == 10.0 && gf(&p, sx, P_WORD_SPACING) == -2.0 && gf(&p, sx, P_TEXT_INDENT) == 25.0 && gi(&p, sx, P_TEXT_TRANSFORM) == 1, "all four inherit");
    let si = computeStyle(&p, q, 2, sb);
    ok(gf(&p, si, P_LETTER_SPACING) == 0.0 && gf(&p, si, P_WORD_SPACING) == 0.0 && gi(&p, si, P_TEXT_TRANSFORM) == 0, "normal, 0 and none reset them");
    ok(gkind(&p, si, P_TEXT_INDENT) == V_PX && gf(&p, si, P_TEXT_INDENT) == 30.0, "text-indent in em is px of the element font size (20px inherited)");
    let su = computeStyle(&p, q, 3, -1);
    ok(gf(&p, su, P_LETTER_SPACING) == 16.0 && gf(&p, su, P_TEXT_INDENT) == -10.0 && gi(&p, su, P_TEXT_TRANSFORM) == 3, "rem, negative indent, capitalize");
    ok(gf(&p, computeStyle(&p, q, 4, -1), P_LETTER_SPACING) == -1.6, "negative em");
    ok(gi(&p, computeStyle(&p, q, 4, -1), P_TEXT_TRANSFORM) == 2, "lowercase is index 2");
    let sn = computeStyle(&p, q, 1, -1);
    ok(gf(&p, sn, P_LETTER_SPACING) == 0.0 && gf(&p, sn, P_TEXT_INDENT) == 0.0 && gi(&p, sn, P_TEXT_TRANSFORM) == 0, "initial values");
    ok(animKind(P_LETTER_SPACING) == CK_LEN && animKind(P_WORD_SPACING) == CK_LEN, "spacing animates as a length");
    let w = Css.new(mem);
    parse(&w, "b { letter-spacing: 5%; } i { word-spacing: auto; } u { text-transform: bogus; } s { text-indent: auto; } p { letter-spacing: 3; }", "bad.css", 0);
    ok(w.warns.len == 5, "a percentage spacing, auto, an unknown transform, auto indent and a bare number warn");
}

// scroll-snap-type / -align / -stop, scroll-padding, scroll-margin: values, shorthands, invalid values with positions
fn testSnapCss(mem: &Arena) {
    let p = Css.new(mem);
    parse(&p, "a { scroll-snap-type: x mandatory; scroll-snap-align: start; scroll-snap-stop: always; scroll-padding: 4px 8px; scroll-margin: 1px 2px 3px 4px; } b { scroll-snap-type: both; scroll-snap-align: center end; } c { scroll-snap-type: block proximity; scroll-snap-align: none; scroll-padding-left: 5px; scroll-margin-top: -6px; } d { scroll-snap-type: none; }", "snap.css", 0);
    ok(p.warns.len == 0, "snap values parse");
    let q = mem.alloc::<MatchNode>(4);
    node(mem, &p, q, 0, "a", "", -1, 0, 0);
    node(mem, &p, q, 1, "b", "", -1, 0, 0);
    node(mem, &p, q, 2, "c", "", -1, 0, 0);
    node(mem, &p, q, 3, "d", "", -1, 0, 0);
    let sa = computeStyle(&p, q, 0, -1);
    ok(gi(&p, sa, P_SNAP_TYPE) == 1 + 4, "x mandatory is axis 1 + 4");
    ok(gi(&p, sa, P_SNAP_ALIGN) == 1 + 4 * 1, "one align value sets block and inline");
    ok(gi(&p, sa, P_SNAP_STOP) == 1, "always");
    ok(gf(&p, sa, P_SCROLL_PAD) == 4.0 && gf(&p, sa, P_SCROLL_PAD + 1) == 8.0 && gf(&p, sa, P_SCROLL_PAD + 2) == 4.0 && gf(&p, sa, P_SCROLL_PAD + 3) == 8.0, "scroll-padding takes 1 to 4 values");
    ok(gf(&p, sa, P_SCROLL_MARGIN) == 1.0 && gf(&p, sa, P_SCROLL_MARGIN + 1) == 2.0 && gf(&p, sa, P_SCROLL_MARGIN + 2) == 3.0 && gf(&p, sa, P_SCROLL_MARGIN + 3) == 4.0, "scroll-margin four values");
    let sb = computeStyle(&p, q, 1, -1);
    ok(gi(&p, sb, P_SNAP_TYPE) == 3, "both without strictness is proximity");
    ok(gi(&p, sb, P_SNAP_ALIGN) == 2 + 4 * 3, "two align values are block then inline");
    ok(gi(&p, sb, P_SNAP_STOP) == 0, "stop starts normal");
    let sc = computeStyle(&p, q, 2, -1);
    ok(gi(&p, sc, P_SNAP_TYPE) == 2 && gi(&p, sc, P_SNAP_ALIGN) == 0, "block is the y axis; none");
    ok(gf(&p, sc, P_SCROLL_PAD + 3) == 5.0 && gf(&p, sc, P_SCROLL_MARGIN) == -6.0, "longhands, negative margin");
    ok(gi(&p, computeStyle(&p, q, 3, -1), P_SNAP_TYPE) == 0, "none");
    let w = Css.new(mem);
    parse(&w, "a { scroll-snap-type: diagonal; }\nb { scroll-snap-type: x sometimes; }\nc { scroll-snap-align: left; }\nd { scroll-snap-stop: sometimes; }\ne { scroll-padding: 1px 2px 3px 4px 5px; }", "bad.css", 0);
    ok(w.warns.len == 5, "bad snap values warn");
    ok(w.warns.items[0].line == 1 && w.warns.items[1].line == 2 && w.warns.items[4].line == 5 && w.warns.items[0].col > 1, "each warning has its position");
}

fn testColorMix(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, ".c1 { color: color-mix(in srgb, red, blue); }\n.c2 { color: color-mix(in srgb, red 25%, blue); }\n.c3 { color: color-mix(in srgb, red 20%, blue 20%); }\n.c4 { color: color-mix(in srgb, red 0%, blue 0%); }\n.c5 { color: color-mix(in srgb, red 60%, blue 60%); }\n.c6 { color: color-mix(in srgb, transparent, red); }\n.c7 { color: color-mix(in oklab, red, blue); }\n.c8 { color: color-mix(in srgb, red 150%, blue); }\n.c9 { color: color-mix(in srgb, 30% white, black); }\n.c10 { color: color-mix(in srgb, red, blue 100%); }\n.c11 { color: color-mix(in srgb, red); }\n.c12 { background-image: linear-gradient(color-mix(in srgb, red, blue) 20%, white); }\n", "mix.css", 0);
    ok(c.warns.len == 4, "c4, c7, c8, c11 are invalid");
    let nodes = mem.alloc::<MatchNode>(12);
    for q in 0..12 {
        node(mem, &c, nodes, q, "div", ["c1", "c2", "c3", "c4", "c5", "c6", "c7", "c8", "c9", "c10", "c11", "c12"][q], -1, 0, 0);
    }
    ok(gc(&c, computeStyle(&c, nodes, 0, -1), P_COLOR) == rgba(128, 0, 128, 255), "equal mix of red and blue");
    ok(gc(&c, computeStyle(&c, nodes, 1, -1), P_COLOR) == rgba(64, 0, 191, 255), "a missing percentage is 100 minus the other");
    ok(gc(&c, computeStyle(&c, nodes, 2, -1), P_COLOR) == rgba(128, 0, 128, 102), "a sum under 100 scales the alpha");
    ok(gc(&c, computeStyle(&c, nodes, 3, -1), P_COLOR) == rgba(0, 0, 0, 255), "a sum of 0 is invalid (initial color)");
    ok(gc(&c, computeStyle(&c, nodes, 4, -1), P_COLOR) == rgba(128, 0, 128, 255), "a sum over 100 is normalised, alpha kept");
    ok(gc(&c, computeStyle(&c, nodes, 5, -1), P_COLOR) == rgba(255, 0, 0, 128), "premultiplied: mixing with transparent keeps the hue");
    ok(gc(&c, computeStyle(&c, nodes, 6, -1), P_COLOR) == rgba(0, 0, 0, 255), "oklab is not supported");
    ok(gc(&c, computeStyle(&c, nodes, 7, -1), P_COLOR) == rgba(0, 0, 0, 255), "a percentage over 100 is invalid");
    ok(gc(&c, computeStyle(&c, nodes, 8, -1), P_COLOR) == rgba(77, 77, 77, 255), "the percentage may come before the color");
    ok(gc(&c, computeStyle(&c, nodes, 9, -1), P_COLOR) == rgba(0, 0, 255, 255), "blue 100% leaves 0 for red");
    ok(gc(&c, computeStyle(&c, nodes, 10, -1), P_COLOR) == rgba(0, 0, 0, 255), "one color is invalid");
    let g = gi(&c, computeStyle(&c, nodes, 11, -1), P_BG_IMAGE);
    ok(c.paints.items[g + 5] == 128.0 && c.paints.items[g + 7] == 128.0, "color-mix() is a gradient stop color");
}

// transform: every 2D function, transform-origin forms, translate / rotate / scale, and what is rejected (with the position)
fn testTransformCss(mem: &Arena) {
    let p = Css.new(mem);
    parse(&p, "a { transform: translate(1px, 2px) translateX(3px) translateY(4px) rotate(90deg) scale(2) scale(2, 3) scaleX(2) scaleY(3) } b { transform: skew(10deg, 20deg) skewX(5deg) skewY(5deg) matrix(1, 0, 0, 1, 5, 6) } c { transform: translate(50%, 10px) rotate(0.5turn) rotate(1rad) }\nd { transform-origin: left top } e { transform-origin: 10px 20%; translate: 5px; rotate: 45deg; scale: 2 3 } f { transform-origin: bottom } g { transform-origin: top right } h { transform-origin: center; transform: none }", "tf.css", 0);
    ok(p.warns.len == 0, "every transform function parses");
    let q = mem.alloc::<MatchNode>(8);
    let names: [8]string = ["a", "b", "c", "d", "e", "f", "g", "h"];
    for i in 0..8 {
        node(mem, &p, q, i, names[i], "", -1, 0, 0);
    }
    let sa = computeStyle(&p, q, 0, -1);
    let va = p.get(sa, P_TRANSFORM);
    ok(va.kind == V_XFORM && p.paints.items[va.i] == 8.0, "eight functions stored");
    ok(p.paints.items[va.i + 1 + 8 + 1] == 3.0 && p.paints.items[va.i + 1 + 2 * 8 + 1] == 0.0, "translateX then translateY fill their own slot");
    let sb = computeStyle(&p, q, 1, -1);
    ok(p.paints.items[p.get(sb, P_TRANSFORM).i] == 4.0, "skew, skewX, skewY and matrix");
    let sc = computeStyle(&p, q, 2, -1);
    let vc = p.get(sc, P_TRANSFORM);
    ok(p.paints.items[vc.i + 1 + 7] == 1.0, "a percentage translate is flagged");
    ok(p.get(computeStyle(&p, q, 3, -1), P_ORIGIN).kind == V_XFORM, "transform-origin parses");
    let se = computeStyle(&p, q, 4, -1);
    let oe = p.get(se, P_ORIGIN).i;
    ok(p.paints.items[oe] == 10.0 && p.paints.items[oe + 1] == 0.0 && p.paints.items[oe + 2] == 20.0 && p.paints.items[oe + 3] == 1.0, "10px 20%");
    ok(p.get(se, P_TRANSLATE).kind == V_XFORM && p.get(se, P_ROTATE).kind == V_XFORM && p.get(se, P_SCALE).kind == V_XFORM, "individual properties parse");
    let of = p.get(computeStyle(&p, q, 5, -1), P_ORIGIN).i;
    ok(p.paints.items[of] == 50.0 && p.paints.items[of + 2] == 100.0, "one keyword leaves the other axis centered");
    let og = p.get(computeStyle(&p, q, 6, -1), P_ORIGIN).i;
    ok(p.paints.items[og] == 100.0 && p.paints.items[og + 2] == 0.0, "`top right` swaps to x right, y top");
    ok(p.get(computeStyle(&p, q, 7, -1), P_TRANSFORM).kind == V_NONE, "none");
    let w = Css.new(mem);
    parse(&w, "a { transform: rotate(10px) }\nb { transform: scale(1, 2, 3) }\nc { transform: matrix(1, 2) }\nd { transform: spin(2deg) }\ne { transform-origin: left right }\nf { translate: 1deg }\ng { transform-origin: 1px 2px 3px }\nh { transform: skew() }\ni { transform: translate(calc(1em + 2px)) }", "bad.css", 0);
    ok(w.warns.len == 9, "nine bad transforms warn");
    for i in 0..9 {
        ok(w.warns.items[i].line == i + 1 && same(w.warns.items[i].file, "bad.css"), "each warning has its line");
    }
    let m = Css.new(mem);
    parse(&m, "a { transform: translate(1px) rotate(1deg) translate(1px) rotate(1deg) translate(1px) rotate(1deg) translate(1px) rotate(1deg) translate(1px) }", "many.css", 0);
    ok(m.warns.len == 1, "more than eight functions warn");
}

fn testGridAreas(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, ".a { grid-template-areas: \"head head\" \"side main\"; }\n.b { grid-template-areas: \"a . b\" \"... . b\"; }\n.n { grid-template-areas: none; }\n.e { grid-area: main; }\n.f { grid-area: 1 / 2 / 3 / 4; }\n.g { grid-area: 2 / span 2; }\n.h { grid-column: main; grid-row: top / bottom; }\n.i { justify-self: end; align-self: start; justify-items: center; align-items: flex-end; }\n.j { place-items: center end; }\n.k { place-self: center; }\n.l { grid-area: a / b / c; }\n", "ga.css", 0);
    ok(c.warns.len == 0, "areas and placement parse without warnings");
    let nodes = mem.alloc::<MatchNode>(11);
    let names = ["a", "b", "n", "e", "f", "g", "h", "i", "j", "k", "l"];
    for q in 0..11 {
        node(mem, &c, nodes, q, "div", names[q], -1, 0, 0);
    }
    let sa = computeStyle(&c, nodes, 0, -1);
    let sb = computeStyle(&c, nodes, 1, -1);
    let sn = computeStyle(&c, nodes, 2, -1);
    let o = gi(&c, sa, P_GRID_AREAS);
    ok(gkind(&c, sa, P_GRID_AREAS) == V_LIST && c.paints.items[o] == 2.0 && c.paints.items[o + 1] == 2.0, "grid-template-areas: 2 rows, 2 columns");
    ok(c.paints.items[o + 2] == c.paints.items[o + 3] && c.paints.items[o + 4] != c.paints.items[o + 5] && c.paints.items[o + 2] != c.paints.items[o + 4], "grid-template-areas: names intern to one id each");
    let ob = gi(&c, sb, P_GRID_AREAS);
    ok(c.paints.items[ob + 1] == 3.0 && c.paints.items[ob + 3] == -1.0 && c.paints.items[ob + 5] == -1.0 && c.paints.items[ob + 6] == -1.0 && c.paints.items[ob + 7] == c.paints.items[ob + 4], "grid-template-areas: '.' and '...' are empty cells");
    ok(gkind(&c, sn, P_GRID_AREAS) == V_NONE, "grid-template-areas: none");
    let se = computeStyle(&c, nodes, 3, -1);
    ok(gkind(&c, se, P_GRID_CS) == V_STR && gi(&c, se, P_GRID_CS) == gi(&c, se, P_GRID_CE) && gi(&c, se, P_GRID_CS) == gi(&c, se, P_GRID_RS) && gi(&c, se, P_GRID_CS) == gi(&c, se, P_GRID_RE), "grid-area: name sets all four lines");
    let sf = computeStyle(&c, nodes, 4, -1);
    ok(gf(&c, sf, P_GRID_RS) == 1.0 && gf(&c, sf, P_GRID_CS) == 2.0 && gf(&c, sf, P_GRID_RE) == 3.0 && gf(&c, sf, P_GRID_CE) == 4.0, "grid-area: rs / cs / re / ce");
    let sg = computeStyle(&c, nodes, 5, -1);
    ok(gf(&c, sg, P_GRID_RS) == 2.0 && gf(&c, sg, P_GRID_CS) == 2.0 && gi(&c, sg, P_GRID_CS) == 1 && gkind(&c, sg, P_GRID_RE) == V_AUTO && gkind(&c, sg, P_GRID_CE) == V_AUTO, "grid-area: two values, the rest auto");
    let sh = computeStyle(&c, nodes, 6, -1);
    ok(gkind(&c, sh, P_GRID_CS) == V_STR && gi(&c, sh, P_GRID_CS) == gi(&c, sh, P_GRID_CE) && gi(&c, sh, P_GRID_RS) != gi(&c, sh, P_GRID_RE), "grid-column: name, grid-row: a / b");
    let si = computeStyle(&c, nodes, 7, -1);
    ok(gi(&c, si, P_JUSTIFY_SELF) == 3 && gi(&c, si, P_ALIGN_SELF) == 2 && gi(&c, si, P_JUSTIFY_ITEMS) == 3 && gi(&c, si, P_ALIGN_ITEMS) == 2, "justify-self / align-self / justify-items / align-items values (start and end alias flex-)");
    let sj = computeStyle(&c, nodes, 8, -1);
    ok(gi(&c, sj, P_ALIGN_ITEMS) == 3 && gi(&c, sj, P_JUSTIFY_ITEMS) == 2, "place-items: align then justify");
    let sk = computeStyle(&c, nodes, 9, -1);
    ok(gi(&c, sk, P_ALIGN_SELF) == 4 && gi(&c, sk, P_JUSTIFY_SELF) == 4, "place-self: one value sets both");
    let sl = computeStyle(&c, nodes, 10, -1);
    ok(gkind(&c, sl, P_GRID_RS) == V_STR && gi(&c, sl, P_GRID_CE) == gi(&c, sl, P_GRID_CS) && gi(&c, sl, P_GRID_RE) != gi(&c, sl, P_GRID_RS), "grid-area: three names, the end column repeats the column");
    ok(gkind(&c, sl, P_GRID_CS) == V_STR, "grid-area: names in each slot");
    // invalid areas: positioned warnings, nothing set
    let w = Css.new(mem);
    parse(&w, ".a {\n  grid-template-areas: \"a b\" \"a\";\n  grid-template-areas: \"a b\" \"b a\";\n  grid-template-areas: \"a\" \"b\" \"a\";\n  grid-template-areas: \"\";\n  grid-template-areas: \"a#\";\n  grid-template-areas: a b;\n}\n", "gw.css", 0);
    ok(w.warns.len == 6, "every bad grid-template-areas warns");
    for q in 0..6 {
        ok(w.warns.items[q].line == q + 2 && (w.warns.items[q].col == 3 || w.warns.items[q].col > 3), "bad areas warn at the declaration or its string");
    }
    ok(contains(w.warns.items[0].msg, "different numbers") && contains(w.warns.items[1].msg, "rectangle") && contains(w.warns.items[2].msg, "rectangle"), "bad areas say why");
    // past 64 columns or 1024 cells: a warning at the declaration, nothing stored
    let big = Text.new(mem);
    big.pushStr(".a {\n  grid-template-areas: \"");
    for q in 0..65 { big.pushStr("a "); }
    big.pushStr("\";\n  grid-template-areas:");
    for r in 0..33 {
        big.pushStr(" \"");
        for q in 0..32 { big.pushStr(if q == 0 { "x" } else { " x" }); }
        big.pushStr("\"");
    }
    big.pushStr(";\n}\n");
    let wb = Css.new(mem);
    parse(&wb, big.str(), "big.css", 0);
    ok(wb.warns.len == 2 && wb.warns.items[0].line == 2 && wb.warns.items[1].line == 3 && contains(wb.warns.items[0].msg, "too big") && contains(wb.warns.items[1].msg, "too big"), "oversized areas warn at their line");
    let wn = mem.alloc::<MatchNode>(1);
    node(mem, &w, wn, 0, "div", "a", -1, 0, 0);
    ok(gkind(&w, computeStyle(&w, wn, 0, -1), P_GRID_AREAS) == V_NONE, "a bad area declaration changes nothing");
}
