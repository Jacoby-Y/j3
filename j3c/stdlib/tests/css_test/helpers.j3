// css_test: shared getters, node/sheet loaders and small helpers.

module css_test;

fn micros(): int {
    let ts: [2]int = [0, 0];
    @syscall(228, 1, &ts[0]);
    return ts[0] * 1000000 + ts[1] / 1000;
}

fn gkind(css: &Css, s: int, p: int): int { let v = css.get(s, p); return v.kind; }

fn gf(css: &Css, s: int, p: int): f32 { let v = css.get(s, p); return v.f; }

fn gi(css: &Css, s: int, p: int): int { let v = css.get(s, p); return v.i; }

fn gc(css: &Css, s: int, p: int): int { let v = css.get(s, p); return v.c; }

// grid tracks in Css.paints: [fill, n, (minKind, min, maxKind, max) per track]
fn gtn(css: &Css, s: int, p: int): int { return int(css.paints.items[gi(css, s, p) + 1]); }

fn gtfill(css: &Css, s: int, p: int): int { return int(css.paints.items[gi(css, s, p)]); }

fn gtv(css: &Css, s: int, p: int, t: int, k: int): f32 { return css.paints.items[gi(css, s, p) + 2 + t * 4 + k]; }

fn gtk(css: &Css, s: int, p: int, t: int, k: int): int { return int(gtv(css, s, p, t, k)); }

fn rgba(r: int, g: int, b: int, a: int): int {
    return r * 16777216 + g * 65536 + b * 256 + a;
}

fn load(mem: &Arena, path: string): string {
    match readFile(path, mem) {
        Result.Ok(bytes) { return bytes as string; }
        Result.Err(_) { panic(`cannot read {path}`); }
    }
}

// one node of a hand-built tree
fn node(mem: &Arena, css: &Css, nodes: []MatchNode, id: int, tag: string, cls: string, parent: int, flags: int, scope: int) {
    let n = 0;
    if cls.len > 0 {
        n = 1;
    }
    let cs = mem.alloc::<int>(n);
    if n == 1 {
        cs[0] = css.intern(cls);
    }
    nodes[id] = MatchNode { tag: css.intern(tag), classes: cs, parent: parent, prevSibling: -1, flags: flags, type: -1, scope: scope, scope2: 0, id: -1, pe: 0, next: -1, first: -1 };
}

fn loadAll(css: &Css, mem: &Arena, dir: string, files: []string, styles: []string): int {
    let theme = load(mem, `{dir}theme.css`);
    parse(css, theme, "ui/theme.css", 0);
    for i in 0..9 {
        let name = files[i];
        let src = load(mem, `{dir}{name}.j3ui`);
        let a = find(src, "<style>");
        let b = find(src, "</style>");
        ok(a >= 0 && b > a, "style block found");
        styles[i] = src[a + 7..b];
        parse(css, styles[i], `ui/{name}.j3ui`, i + 1);
    }
    return theme.len;
}

fn warnText(css: &Css) {
    for i in 0..css.warns.len {
        let w = css.warns.items[i];
        printLn(`  warning {w.file}:{w.line}:{w.col}: {w.msg}`);
    }
}

fn pf4(c: &Css, o: int, k: int): int { return int(c.paints.items[o + k]); }

// siblings 1..4 under parent 0, set by hand: node `id` with class and id name
fn sib(mem: &Arena, css: &Css, nodes: []MatchNode, id: int, cls: string, name: string, prev: int) {
    node(mem, css, nodes, id, "li", cls, 0, 0, 0);
    nodes[id].prevSibling = prev;
    if name.len > 0 {
        nodes[id].id = css.intern(name);
    }
}

// n floats of the paint data of property `p` in styles `a` and `b` are equal
fn samePaint(css: &Css, a: int, b: int, p: int, n: int): bool {
    let pa = gi(css, a, p);
    let pb = gi(css, b, p);
    for i in 0..n {
        if css.paints.items[pa + i] != css.paints.items[pb + i] {
            return false;
        }
    }
    return true;
}

fn pv(css: &Css, st: int, name: string): Value {
    return varValue(css, css.varsOf(st), css.intern(name));
}

fn median(xs: []int): int {
    // insertion sort a copy-free view is fine: the caller does not reuse the order
    for i in 1..xs.len {
        let x = xs[i];
        let j = i - 1;
        while j >= 0 && xs[j] > x {
            xs[j + 1] = xs[j];
            j -= 1;
        }
        xs[j + 1] = x;
    }
    return xs[xs.len / 2];
}
