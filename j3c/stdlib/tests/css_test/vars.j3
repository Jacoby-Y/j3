// css_test: nesting, @property, var() and wide keywords, revert.

module css_test;

/// CSS nesting: relative and `&` selectors, lists, declarations after nested rules, nested `@media`, the depth cap, recovery.
fn testNesting(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, ".card { width: 1px; &:hover { height: 2px; } .title { gap: 3px; } > p { order: 4; } & + & { opacity: 0.5; } &.active { width: 5px; } .dark & { height: 6px; } }", "nest.css", 0);
    ok(c.warns.len == 0, "nesting forms parse without warnings");
    ok(c.rules.len == 7, "the parent and six nested rules");
    ok(c.rules.items[1].spec == 200 && c.rules.items[2].spec == 200 && c.rules.items[3].spec == 101, "flat specificity of the joined selectors");
    let n = mem.alloc::<MatchNode>(8);
    node(mem, &c, n, 0, "div", "dark", -1, 0, 0);
    node(mem, &c, n, 1, "div", "card", 0, 0, 0);
    node(mem, &c, n, 2, "span", "title", 1, 0, 0);
    node(mem, &c, n, 3, "p", "", 1, 0, 0);
    node(mem, &c, n, 4, "div", "card", 0, 0, 0);
    n[4].prevSibling = 1;
    node(mem, &c, n, 5, "div", "card", 0, 0, 0);
    n[5].classes = mem.alloc::<int>(2);
    n[5].classes[0] = c.intern("card");
    n[5].classes[1] = c.intern("active");
    node(mem, &c, n, 6, "div", "card", -1, FL_HOVER, 0);
    node(mem, &c, n, 7, "p", "", 6, 0, 0);
    ok(gf(&c, computeStyle(&c, n, 1, -1), P_WIDTH) == 1.0, "the parent rule");
    ok(gf(&c, computeStyle(&c, n, 6, -1), P_HEIGHT) == 2.0, "&:hover");
    ok(gf(&c, computeStyle(&c, n, 1, -1), P_HEIGHT) == 6.0, ".dark & puts the parent after the ancestor");
    ok(gf(&c, computeStyle(&c, n, 2, -1), P_GAP) == 3.0, "no & is a descendant");
    ok(gf(&c, computeStyle(&c, n, 3, -1), P_ORDER) == 4.0 && gf(&c, computeStyle(&c, n, 7, -1), P_ORDER) == 4.0, "> p is relative to &");
    ok(gf(&c, computeStyle(&c, n, 4, -1), P_OPACITY) == 0.5 && gf(&c, computeStyle(&c, n, 1, -1), P_OPACITY) == 1.0, "& + & joins two copies");
    ok(gf(&c, computeStyle(&c, n, 5, -1), P_WIDTH) == 5.0, "&.active");
    ok(gf(&c, computeStyle(&c, n, 2, -1), P_ORDER) == 0.0, "a descendant rule does not hit the parent's other children");

    // lists multiply; the empty parent segment makes no rule
    let l = Css.new(mem);
    parse(&l, "a, b { &:hover, .x & { width: 1px; } }", "list.css", 0);
    ok(l.warns.len == 0 && l.rules.len == 4, "(a, b) x (&:hover, .x &) is four rules");
    ok(l.rules.items[0].spec == 101 && l.rules.items[1].spec == 101, "a:hover and .x a");

    // declarations after a nested rule are a later rule of the parent
    let a = Css.new(mem);
    parse(&a, ".p { width: 1px; .c { width: 2px; } width: 3px; height: 4px; }", "after.css", 0);
    ok(a.rules.len == 3 && a.rules.items[0].ndecl == 1 && a.rules.items[2].ndecl == 2, "parent, nested, parent again");
    ok(a.rules.items[2].order > a.rules.items[1].order && a.rules.items[2].spec == 100, "the late rule keeps the parent's specificity");
    let an = mem.alloc::<MatchNode>(2);
    node(mem, &a, an, 0, "div", "p", -1, 0, 0);
    node(mem, &a, an, 1, "span", "c", 0, 0, 0);
    ok(gf(&a, computeStyle(&a, an, 0, -1), P_WIDTH) == 3.0, "a late declaration beats the earlier one");
    ok(gf(&a, computeStyle(&a, an, 1, -1), P_WIDTH) == 2.0, "the nested rule (0,2,0) beats the parent (0,1,0)");

    // the pseudo-element and :not() keep their parts
    let q = Css.new(mem);
    parse(&q, ".a { &:not(.b, .c) { width: 1px; } &::before { content: \"x\"; } }", "q.css", 0);
    ok(q.warns.len == 0 && q.rules.len == 2 && q.peRules.len == 1, ":not(a, b) and ::before survive the join");

    // @media in a rule, in @media, and both
    let m = Css.new(mem);
    parse(&m, ".panel { width: 10px; @media (max-width: 600px) { width: 4px; &.s { height: 8px; } } }\n@media (min-width: 300px) { @media (max-width: 600px) { .q { width: 7px; } } .r { width: 6px; } }\n.z { @media (min-width: 300px) { @media (max-width: 600px) { width: 9px; } } }\n@media (max-width: 100px) { @media (min-width: 200px) { .never { width: 1px; } } }", "m.css", 0);
    ok(m.warns.len == 0, "nested @media parses");
    let mn = mem.alloc::<MatchNode>(5);
    node(mem, &m, mn, 0, "div", "panel", -1, 0, 0);
    node(mem, &m, mn, 1, "div", "q", -1, 0, 0);
    node(mem, &m, mn, 2, "div", "z", -1, 0, 0);
    node(mem, &m, mn, 3, "div", "never", -1, 0, 0);
    node(mem, &m, mn, 4, "div", "r", -1, 0, 0);
    m.setViewport(800.0, 600.0);
    ok(gf(&m, computeStyle(&m, mn, 0, -1), P_WIDTH) == 10.0 && gkind(&m, computeStyle(&m, mn, 1, -1), P_WIDTH) == V_AUTO, "wide: neither nested condition holds");
    ok(gf(&m, computeStyle(&m, mn, 4, -1), P_WIDTH) == 6.0 && gkind(&m, computeStyle(&m, mn, 2, -1), P_WIDTH) == V_AUTO, "wide: the outer @media alone");
    m.setViewport(500.0, 600.0);
    ok(gf(&m, computeStyle(&m, mn, 0, -1), P_WIDTH) == 4.0, "narrow: @media inside a rule");
    ok(gf(&m, computeStyle(&m, mn, 1, -1), P_WIDTH) == 7.0, "@media in @media (both hold)");
    ok(gf(&m, computeStyle(&m, mn, 2, -1), P_WIDTH) == 9.0, "@media in @media in a rule");
    ok(gkind(&m, computeStyle(&m, mn, 3, -1), P_WIDTH) == V_AUTO, "contradicting conditions never hold");
    m.setViewport(200.0, 600.0);
    ok(gkind(&m, computeStyle(&m, mn, 1, -1), P_WIDTH) == V_AUTO && gf(&m, computeStyle(&m, mn, 0, -1), P_WIDTH) == 4.0, "narrow: the outer bound fails");

    // depth cap: a rule nested more than 8 deep is skipped at its position
    let d = Css.new(mem);
    parse(&d, ".a { .b { .c { .d { .e { .f { .g { .h { .i { width: 1px;\n    .j { width: 2px; } } } } } } } } } }", "deep.css", 0);
    ok(d.warns.len == 1 && contains(d.warns.items[0].msg, "8 deep") && d.warns.items[0].line == 2 && d.warns.items[0].col == 5, "ninth level warns at its line:col");
    ok(d.rules.len == 1, "only the ninth rule is kept");

    // a bad nested selector drops that rule only
    let b = Css.new(mem);
    parse(&b, ".ok { width: 1px;\n  &:bogus { height: 2px; }\n  .good { gap: 3px; }\n  height: 5px;\n}\n.after { order: 2; }", "bad.css", 0);
    ok(b.warns.len == 1 && b.warns.items[0].line == 2 && b.warns.items[0].col == 3, "positioned at the nested rule");
    ok(b.rules.len == 4, ".ok, .ok .good, the late .ok, .after");
    let bn = mem.alloc::<MatchNode>(2);
    node(mem, &b, bn, 0, "div", "ok", -1, 0, 0);
    node(mem, &b, bn, 1, "div", "good", 0, 0, 0);
    ok(gf(&b, computeStyle(&b, bn, 0, -1), P_HEIGHT) == 5.0 && gf(&b, computeStyle(&b, bn, 1, -1), P_GAP) == 3.0, "the parent and siblings survive");

    // `&` with a complex parent only leads; a type selector moves to the front; 9 and 72 joined selectors
    let x = Css.new(mem);
    parse(&x, ".a .b { width: 1px; &:hover { height: 2px; } &.x > li { gap: 1px; } & + & { order: 1; } }\n.a > .c { .dark & { order: 2; } .dark > & { order: 6; } .m .n & { order: 10; } & ~ .g & { order: 7; } .h.& { order: 8; } }\ndiv { .x& { width: 1px; } &div { order: 3; } }\nspan { div& { order: 4; } }\n.k { .y& { order: 5; } }", "amp.css", 0);
    ok(x.warns.len == 6, "six joins need :is() or two types");
    ok(x.warns.items[0].line == 1 && contains(x.warns.items[0].msg, ":is()") && x.warns.items[1].line == 2 && contains(x.warns.items[1].msg, ":is()") && contains(x.warns.items[2].msg, ":is()"), "complex parent: `& + &`, `.dark > &`, `& ~ .g &` and `.h.&` are dropped with a position");
    ok(contains(x.warns.items[4].msg, "followed by a name") && contains(x.warns.items[5].msg, "two type selectors"), "`&div` and `div&` on a tag");
    ok(x.rules.len == 7, ".a .b, :hover, .x > li, .dark .a > .c, .m .n .a > .c, div.x, .k.y");
    ok(x.rules.items[1].spec == 300 && x.rules.items[2].spec == 301 && x.rules.items[3].spec == 300 && x.rules.items[4].spec == 400 && x.rules.items[5].spec == 101 && x.rules.items[6].spec == 200, "`.a .b:hover`, `.a .b.x > li`, `div.x`, `.y.k`");
    let nine = Css.new(mem);
    parse(&nine, "a, b, c { &.x, &.y, &.z { width: 1px; } }", "nine.css", 0);
    ok(nine.warns.len == 0 && nine.rules.len == 9, "nine joined selectors, none lost");
    let big = Css.new(mem);
    parse(&big, "a, b, c, d, e, f, g, h, i { &.a, &.b, &.c, &.d, &.e, &.f, &.g, &.h { width: 1px; } }", "big.css", 0);
    ok(big.warns.len == 1 && contains(big.warns.items[0].msg, "64 selectors") && big.rules.len == 0, "72 joined selectors warn and drop the rule");

    // declarations that look odd but are not rules, and a missing `;` before a nested rule
    let t = Css.new(mem);
    parse(&t, ".t { content: \"a{b\"; background: url(x.png); --x: 1px; grid-template-areas: \"a b\"; width: 5px; }", "odd.css", 0);
    ok(t.rules.len == 1 && t.rules.items[0].ndecl >= 3, "braces in strings and url() are not rules");
    let ty = Css.new(mem);
    parse(&ty, ".t { color: red .b { x: y } width: 3px; }", "typo.css", 0);
    ok(ty.warns.len >= 1 && ty.warns.items[0].line == 1, "a missing ; before a nested rule warns once, positioned");
    let tn = mem.alloc::<MatchNode>(1);
    node(mem, &ty, tn, 0, "div", "t", -1, 0, 0);
    ok(gf(&ty, computeStyle(&ty, tn, 0, -1), P_WIDTH) == 3.0, "and the parent keeps its later declarations");

    // hot reload: a live HotFile text replaces the sheet on the next parse
    let h = Css.new(mem);
    parse(&h, ".a { width: 1px; &:hover { width: 2px; } }", "hot.css", 0);
    ok(h.rules.len == 2, "before the reload");
    h.reset();
    h.hot.push(HotFile { path: "hot.css", style: ".a { width: 7px; .b { width: 8px; } &.c { width: 9px; } @media (max-width: 10px) { width: 1px; } }", rest: 0, live: true });
    parse(&h, ".a { width: 1px; }", "hot.css", 0);
    ok(h.warns.len == 0 && h.rules.len == 4, "the reloaded nested sheet parses");
    h.setViewport(800.0, 600.0);
    let hn = mem.alloc::<MatchNode>(2);
    node(mem, &h, hn, 0, "div", "a", -1, 0, 0);
    node(mem, &h, hn, 1, "div", "b", 0, 0, 0);
    ok(gf(&h, computeStyle(&h, hn, 0, -1), P_WIDTH) == 7.0 && gf(&h, computeStyle(&h, hn, 1, -1), P_WIDTH) == 8.0, "the new values apply");

    // scoped sheets keep the scope on every joined rule
    let s = Css.new(mem);
    parse(&s, ".a { .b { width: 1px; } &:hover { height: 2px; } }", "scoped.css", 3);
    ok(s.rules.len == 2 && s.rules.items[0].scope == 3 && s.rules.items[1].scope == 3 && s.rules.items[0].spec == 300, "scope class counted on nested rules");
}

/// `@property`: descriptors (valid and every missing or invalid one), type-checked declarations, `inherits`, `initial-value`.
fn testProperty(mem: &Arena) {
    let w = Css.new(mem);
    parse(&w, "@property --nosyn { inherits: true; initial-value: 1; }\n@property --noinh { syntax: '<number>'; initial-value: 1; }\n@property --noinit { syntax: '<number>'; inherits: false; }\n@property --star { syntax: '*'; inherits: true; }\n@property --badsyn { syntax: 'banana'; inherits: true; initial-value: 1; }\n@property --badinit { syntax: '<length>'; inherits: true; initial-value: red; }\n@property --badinh { syntax: '<number>'; inherits: maybe; initial-value: 1; }\n@property nameless { syntax: '*'; inherits: true; }\n@property --extra { syntax: '*'; inherits: true; color: red; }\n@property --ok { syntax: '<length>'; inherits: true; initial-value: 5px; }\n", "pw.css", 0);
    ok(w.regs.len == 3, "only --star, --extra and --ok register");
    ok(w.warns.len == 11, "every missing or invalid descriptor warns");
    ok(w.warns.items[0].line == 1 && w.warns.items[0].col == 1 && contains(w.warns.items[0].msg, "syntax"), "no syntax: warned at the rule");
    ok(w.warns.items[1].line == 2 && contains(w.warns.items[1].msg, "inherits"), "no inherits");
    ok(w.warns.items[2].line == 3 && contains(w.warns.items[2].msg, "initial-value"), "no initial-value unless syntax is *");
    ok(w.warns.items[3].line == 5 && w.warns.items[3].col > 1 && contains(w.warns.items[3].msg, "syntax must"), "a bad syntax warns at its descriptor");
    ok(w.warns.items[4].line == 5 && w.warns.items[4].col == 1, "and the rule is ignored");
    ok(w.warns.items[5].line == 6 && w.warns.items[5].col > 1 && contains(w.warns.items[5].msg, "initial-value"), "an initial-value of the wrong type");
    ok(w.warns.items[7].line == 7 && w.warns.items[7].col > 1 && contains(w.warns.items[7].msg, "inherits must"), "a bad inherits");
    ok(w.warns.items[9].line == 8 && contains(w.warns.items[9].msg, "custom property name"), "a rule without a --name");
    ok(w.warns.items[10].line == 9 && contains(w.warns.items[10].msg, "unknown @property descriptor"), "an unknown descriptor");
    ok(w.warns.items[10].msg.len > 0 && w.regs.items[2].syn != 0 && w.regs.items[2].init.f == 5.0, "the valid rule keeps its initial value");

    let c = Css.new(mem);
    parse(&c, "@property --len { syntax: '<length>'; inherits: true; initial-value: 5px; }\n@property --ni { syntax: '<number>'; inherits: false; initial-value: 3; }\n@property --col { syntax: '<color>'; inherits: true; initial-value: #112233; }\n@property --ang { syntax: '<angle>'; inherits: true; initial-value: 45deg; }\n@property --pct { syntax: '<percentage>'; inherits: true; initial-value: 50%; }\n@property --lp { syntax: '<length-percentage>'; inherits: true; initial-value: 10px; }\n.bad { --len: red; --ni: 4; --col: 10px; --ang: 5; --pct: 3px; --lp: 2; }\n.good { --len: 12px; --ni: 7; --col: #ff0000; --ang: 0.5turn; --pct: 20%; --lp: 30%; }\n.viabad { --len: var(--col); }\n.zero { --len: 0; }\n", "pc.css", 0);
    ok(c.warns.len == 0 && c.regs.len == 6 && c.noInh == 1, "six properties register");
    let nodes = mem.alloc::<MatchNode>(6);
    node(mem, &c, nodes, 0, "div", "", -1, 0, 0);
    node(mem, &c, nodes, 1, "div", "bad", 0, 0, 0);
    node(mem, &c, nodes, 2, "div", "good", 0, 0, 0);
    node(mem, &c, nodes, 3, "div", "", 2, 0, 0);
    node(mem, &c, nodes, 4, "div", "viabad", 0, 0, 0);
    node(mem, &c, nodes, 5, "div", "zero", 0, 0, 0);
    let s0 = computeStyle(&c, nodes, 0, -1);
    ok(pv(&c, s0, "--len").kind == V_PX && pv(&c, s0, "--len").f == 5.0, "unset: the initial length");
    ok(pv(&c, s0, "--ni").f == 3.0 && pv(&c, s0, "--col").c == rgba(17, 34, 51, 255), "initial number and color");
    ok(pv(&c, s0, "--ang").kind == V_ANG && pv(&c, s0, "--ang").f == 45.0, "initial angle");
    let s1 = computeStyle(&c, nodes, 1, s0);
    ok(pv(&c, s1, "--len").f == 5.0 && pv(&c, s1, "--col").c == rgba(17, 34, 51, 255), "a value of the wrong type is dropped: initial");
    ok(pv(&c, s1, "--ni").f == 4.0, "the valid declaration of the same rule stands");
    ok(pv(&c, s1, "--ang").f == 45.0 && pv(&c, s1, "--pct").f == 50.0 && pv(&c, s1, "--lp").f == 10.0, "a bare number is no angle, 3px no percentage, 2 no length-percentage");
    let s2 = computeStyle(&c, nodes, 2, s0);
    ok(pv(&c, s2, "--len").f == 12.0 && pv(&c, s2, "--ni").f == 7.0 && pv(&c, s2, "--col").c == rgba(255, 0, 0, 255), "typed values");
    ok(pv(&c, s2, "--ang").f == 180.0 && pv(&c, s2, "--pct").kind == V_PCT && pv(&c, s2, "--lp").kind == V_PCT, "angle in turns, percentages");
    let s3 = computeStyle(&c, nodes, 3, s2);
    ok(pv(&c, s3, "--len").f == 12.0 && pv(&c, s3, "--col").c == rgba(255, 0, 0, 255), "inherits: true passes the value down");
    ok(pv(&c, s3, "--ni").f == 3.0, "inherits: false gives the child the initial value");
    let s4 = computeStyle(&c, nodes, 4, s0);
    ok(pv(&c, s4, "--len").f == 5.0, "a var() of the wrong type is invalid too");
    let s5 = computeStyle(&c, nodes, 5, s0);
    ok(pv(&c, s5, "--len").kind == V_PX && pv(&c, s5, "--len").f == 0.0, "0 is a length");
}

fn testVarCompound(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, ":root { --a: #ff0000; --b: #0000ff; --blur: 8px; --w: 3px; }\n.dark { --a: #00ff00; }\n.alt { --a: #808080; }\n.g1 { background-image: linear-gradient(var(--a), var(--b) 50%); }\n.g1l { background-image: linear-gradient(#ff0000, #0000ff 50%); }\n.g1d { background-image: linear-gradient(#00ff00, #0000ff 50%); }\n.g2 { background-image: linear-gradient(to right, var(--zz, #123456), blue); }\n.g2l { background-image: linear-gradient(to right, #123456, blue); }\n.g3 { background-image: linear-gradient(var(--zz), blue); }\n.s1 { box-shadow: 0 4px var(--blur) var(--a); text-shadow: 1px 1px 2px var(--b); }\n.s1l { box-shadow: 0 4px 8px #ff0000; text-shadow: 1px 1px 2px #0000ff; }\n.m1 { background: color-mix(in srgb, var(--a) 50%, var(--b)); color: color-mix(in srgb, var(--a) 30%, white); }\n.b1 { border: var(--w) solid var(--a); outline: 1px solid var(--b); }\n.cy { --x: var(--y); --y: var(--x); background-image: linear-gradient(var(--x), red); }\n.inh { background-image: linear-gradient(var(--a), var(--b)); }\n.pd { padding: var(--w) 4px; }\n.typo { background-image: linear-gradient(var(--a), bleu); }\n.undef { box-shadow: 0 0 4px var(--nope); }\n.unc { box-shadow: 0 0 4px var(--nope, #1234567 }\n", "vc.css", 0);
    ok(c.warns.len == 0, "var() inside compound values is not a warning");
    let nodes = mem.alloc::<MatchNode>(20);
    node(mem, &c, nodes, 0, "div", "", -1, 0, 0);
    node(mem, &c, nodes, 1, "div", "dark", 0, 0, 0);
    node(mem, &c, nodes, 2, "div", "alt", 0, 0, 0);
    let names = ["g1", "g1l", "g1d", "g2", "g2l", "g3", "s1", "s1l", "m1", "b1", "cy", "inh", "pd"];
    let sty = mem.alloc::<int>(32);
    sty[0] = computeStyle(&c, nodes, 0, -1);
    sty[1] = computeStyle(&c, nodes, 1, sty[0]);
    sty[2] = computeStyle(&c, nodes, 2, sty[0]);
    for q in 0..13 {
        node(mem, &c, nodes, 3 + q, "div", names[q], 0, 0, 0);
        sty[3 + q] = computeStyle(&c, nodes, 3 + q, sty[0]);
    }
    ok(gkind(&c, sty[3], P_BG_IMAGE) == V_GRAD && samePaint(&c, sty[3], sty[4], P_BG_IMAGE, 15), "var() in gradient stops");
    ok(gkind(&c, sty[6], P_BG_IMAGE) == V_GRAD && samePaint(&c, sty[6], sty[7], P_BG_IMAGE, 15), "a var() fallback is a stop color");
    ok(gkind(&c, sty[8], P_BG_IMAGE) == V_NONE, "an undefined var() without fallback makes the declaration invalid");
    ok(samePaint(&c, sty[9], sty[10], P_BOX_SHADOW, 10), "var() in a box-shadow color and blur");
    ok(samePaint(&c, sty[9], sty[10], P_TEXT_SHADOW, 10), "var() in a text-shadow color");
    ok(gc(&c, sty[11], P_BACKGROUND) == rgba(128, 0, 128, 255), "var() as both color-mix() arguments");
    ok(gc(&c, sty[11], P_COLOR) == rgba(255, 179, 179, 255), "color-mix(in srgb, var(--a) 30%, white)");
    ok(gc(&c, sty[12], P_BORDER_TOP_COLOR) == rgba(255, 0, 0, 255) && gf(&c, sty[12], P_BORDER_TOP_WIDTH) == 3.0 && gi(&c, sty[12], P_BORDER_STYLE) == BORDER_SOLID, "var() in the border shorthand (width and color)");
    ok(gc(&c, sty[12], P_OUTLINE_COLOR) == rgba(0, 0, 255, 255), "var() in the outline shorthand");
    ok(gkind(&c, sty[13], P_BG_IMAGE) == V_NONE, "a var() cycle is invalid");
    ok(gf(&c, sty[15], P_PADDING_TOP) == 3.0 && gf(&c, sty[15], P_PADDING_TOP + 1) == 4.0, "var() in a box shorthand");
    // custom properties of the element's own ancestors decide: a different --accent gives a different gradient
    node(mem, &c, nodes, 17, "div", "inh", 1, 0, 0);
    node(mem, &c, nodes, 18, "div", "inh", 2, 0, 0);
    let darkInh = computeStyle(&c, nodes, 17, sty[1]);
    let altInh = computeStyle(&c, nodes, 18, sty[2]);
    ok(gkind(&c, darkInh, P_BG_IMAGE) == V_GRAD && darkInh != altInh && sty[14] != darkInh, "styles under different --a differ");
    ok(c.paints.items[gi(&c, darkInh, P_BG_IMAGE) + 5] == 0.0 && c.paints.items[gi(&c, darkInh, P_BG_IMAGE) + 6] == 255.0, "dark --a: green first stop");
    ok(c.paints.items[gi(&c, altInh, P_BG_IMAGE) + 5] == 128.0, "--a from .alt: grey first stop");
    // a typo or an undefined var() inside a deferred value warns once, at the declaration, then stays quiet
    node(mem, &c, nodes, 19, "div", "typo", 0, 0, 0);
    let w0 = c.warns.len;
    let ty = computeStyle(&c, nodes, 19, sty[0]);
    ok(gkind(&c, ty, P_BG_IMAGE) == V_NONE && c.warns.len == w0 + 1, "a typo in a deferred value warns");
    ok(contains(c.warns.items[w0].msg, "background-image") && same(c.warns.items[w0].file, "vc.css") && c.warns.items[w0].line == 17, "the warning names the property and the sheet position");
    ty = computeStyle(&c, nodes, 19, sty[1]);
    ok(c.warns.len == w0 + 1, "and only once");
    node(mem, &c, nodes, 3, "div", "undef", 0, 0, 0);
    computeStyle(&c, nodes, 3, sty[0]);
    computeStyle(&c, nodes, 3, sty[2]);
    ok(c.warns.len == w0 + 2, "an undefined var() warns once too");
    w0 = c.warns.len;
    node(mem, &c, nodes, 3, "div", "unc", 0, 0, 0);
    ok(gkind(&c, computeStyle(&c, nodes, 3, sty[0]), P_BOX_SHADOW) == V_NONE, "an unclosed var( is invalid, its fallback is not trimmed");
    // style: text cannot defer
    let wi = c.warns.len;
    ok(inlineDecl(&c, "background-image", "linear-gradient(var(--a), red)") == 0 && c.warns.len == wi + 1 && contains(c.warns.items[wi].msg, "not supported"), "var() in compound style: text is a clear warning");
    ok(inlineDecl(&c, "background-image", "var(--tile)") == 0 && c.warns.len == wi + 2 && contains(c.warns.items[wi + 1].msg, "class"), "a whole var() image in style: text warns and names the class workaround");
    // the same inputs hit the cache: same id, no new paint data
    let np = c.paints.len;
    ok(computeStyle(&c, nodes, 17, sty[1]) == darkInh && c.paints.len == np, "a repeated cascade is cached");
}

/// `initial`, `unset`, `revert`, `inherit` and `all`: longhands, shorthands, tag defaults, custom properties, `var()` fallbacks, `@keyframes`, `style:` text.
fn testWideKeywords(mem: &Arena) {
    let c = Css.new(mem);
    uastyle.load(&c);
    parse(&c, ".p { color: #ff0000; padding: 5px; letter-spacing: 3px; width: 50px; font-weight: 300; --a: 5px; --r: 9px; --u: 8px; }\n@property --r { syntax: '<length>'; inherits: false; initial-value: 4px; }\n.ini { color: initial; width: initial; letter-spacing: initial; }\n.uns { color: unset; width: unset; letter-spacing: unset; padding: 9px; padding: unset; }\nstrong.rv { font-weight: revert; }\nstrong.un { font-weight: unset; }\n.rev { color: revert; width: revert; }\n.all { all: unset; }\n.alli { all: initial; }\n.alln { all: unset; color: #0000ff; }\n.alli2 { color: #0000ff; all: initial; }\n.sh { border: 3px solid #123456; border: initial; font: unset; }\n.pad { padding: 7px; padding: initial; margin: 4px; margin: inherit; }\n.alinh { all: inherit; }\n.alrev { all: revert; }\n.c1 { --a: initial; width: var(--a, 11px); }\n.c2 { --a: unset; width: var(--a, 11px); }\n.c3 { --a: inherit; width: var(--a, 11px); }\n.c4 { --r: inherit; width: var(--r, 1px); }\n.c5 { --r: initial; width: var(--r, 1px); }\n.c6 { --r: unset; width: var(--r, 1px); }\n.fb { width: var(--nope, inherit); height: var(--nope, initial); }\n.c7 { --u: initial; width: var(--u, 12px); }\n@keyframes k { from { width: initial; opacity: 0; } to { opacity: 1; all: unset; } }\n", "wide.css", 0);
    ok(c.warns.len == 2, "initial and all in @keyframes warn once each");
    ok(contains(c.warns.items[0].msg, "@keyframes"), "the warning names @keyframes");
    ok(c.kfs.len == 1 && c.kfs.items[0].nprop == 1, "only opacity animates");
    let N = 24;
    let nodes = mem.alloc::<MatchNode>(N);
    node(mem, &c, nodes, 0, "div", "", -1, 0, 0);
    node(mem, &c, nodes, 1, "div", "p", 0, 0, 0);
    let cls = ["ini", "uns", "rev", "all", "all", "alli", "alln", "alli2", "sh", "pad", "alinh", "alrev", "c1", "c2", "c3", "c4", "c5", "c6", "fb", "c7"];
    for i in 0..20 {
        node(mem, &c, nodes, 2 + i, "div", cls[i], 1, 0, 0);
    }
    node(mem, &c, nodes, 22, "strong", "rv", 1, 0, 0);
    node(mem, &c, nodes, 23, "strong", "un", 1, 0, 0);
    let st = mem.alloc::<int>(N);
    st[0] = computeStyle(&c, nodes, 0, -1);
    for i in 1..N {
        st[i] = computeStyle(&c, nodes, i, st[nodes[i].parent]);
    }
    let red = rgba(255, 0, 0, 255);
    let blue = rgba(0, 0, 255, 255);
    let black = rgba(0, 0, 0, 255);
    ok(gc(&c, st[1], P_COLOR) == red && gf(&c, st[1], P_WIDTH) == 50.0, "the parent");
    ok(gc(&c, st[2], P_COLOR) == black && gkind(&c, st[2], P_WIDTH) == V_AUTO && gf(&c, st[2], P_LETTER_SPACING) == 0.0, "initial: the initial value, inherited property too");
    ok(gc(&c, st[3], P_COLOR) == red && gf(&c, st[3], P_LETTER_SPACING) == 3.0, "unset: inherited property inherits");
    ok(gkind(&c, st[3], P_WIDTH) == V_AUTO && gf(&c, st[3], P_PADDING_TOP) == 0.0, "unset: non-inherited property is initial, a shorthand too");
    ok(gc(&c, st[4], P_COLOR) == red && gkind(&c, st[4], P_WIDTH) == V_AUTO, "revert with no tag default is unset");
    ok(gf(&c, st[22], P_FONT_WEIGHT) == 700.0, "revert returns to the tag default (strong is bold)");
    ok(gf(&c, st[23], P_FONT_WEIGHT) == 300.0, "unset on strong inherits, the tag default is gone");
    ok(gc(&c, st[5], P_COLOR) == red && gkind(&c, st[5], P_WIDTH) == V_AUTO && gkind(&c, st[5], P_DISPLAY) == initial(P_DISPLAY).kind, "all: unset");
    ok(st[5] == st[6], "two elements with all: unset share one style");
    ok(gc(&c, st[7], P_COLOR) == black && gf(&c, st[7], P_LETTER_SPACING) == 0.0 && gf(&c, st[7], P_FONT_WEIGHT) == 400.0, "all: initial resets inherited properties too");
    ok(gc(&c, st[8], P_COLOR) == blue && gkind(&c, st[8], P_WIDTH) == V_AUTO, "a declaration after all wins");
    ok(gc(&c, st[9], P_COLOR) == black, "all after a declaration wins over it");
    ok(gf(&c, st[10], P_BORDER_TOP_WIDTH) == initial(P_BORDER_TOP_WIDTH).f && gkind(&c, st[10], P_BORDER_STYLE) == initial(P_BORDER_STYLE).kind, "border: initial");
    ok(gf(&c, st[10], P_FONT_WEIGHT) == 300.0, "font: unset inherits");
    ok(gf(&c, st[11], P_PADDING_TOP) == 0.0 && gf(&c, st[11], P_MARGIN_TOP) == 0.0, "padding: initial, margin: inherit of a parent without margin");
    ok(gf(&c, st[12], P_WIDTH) == 50.0 && gf(&c, st[12], P_PADDING_TOP) == 5.0 && gc(&c, st[12], P_COLOR) == red, "all: inherit");
    ok(gkind(&c, st[13], P_WIDTH) == V_AUTO && gc(&c, st[13], P_COLOR) == red, "all: revert is all: unset here");
    ok(gf(&c, st[14], P_WIDTH) == 11.0, "--a: initial is invalid: the var() fallback applies");
    ok(gf(&c, st[15], P_WIDTH) == 5.0, "--a: unset inherits an unregistered property");
    ok(gf(&c, st[16], P_WIDTH) == 5.0, "--a: inherit");
    ok(gf(&c, st[17], P_WIDTH) == 9.0, "--r: inherit takes the parent value of a property that does not inherit");
    ok(gf(&c, st[18], P_WIDTH) == 4.0, "--r: initial is the registered initial-value");
    ok(gf(&c, st[19], P_WIDTH) == 4.0, "--r: unset of a non-inheriting property is initial");
    ok(gf(&c, st[20], P_WIDTH) == 50.0 && gkind(&c, st[20], P_HEIGHT) == V_AUTO, "keywords as var() fallbacks");
    ok(gf(&c, st[21], P_WIDTH) == 12.0, "--u: initial, unregistered: fallback");
    // mixed with other values: invalid, with a positioned warning
    let w0 = c.warns.len;
    parse(&c, "a { padding: 1px initial; }\nb { color: red;\n  width: inherit 5px; }\nc { animation-name: initial; animation-duration: unset; }\nd { text-decoration: underline inherit; }", "mixed.css", 0);
    ok(c.warns.len == w0 + 3, "mixed keywords warn (padding, width, text-decoration), a lone one on animation-* does not");
    ok(c.warns.items[w0].line == 1 && c.warns.items[w0 + 1].line == 3 && c.warns.items[w0 + 1].col == 3 && contains(c.warns.items[w0 + 1].msg, "whole value"), "the warning is at the declaration");
    // the keyframe warnings sit at their declarations
    ok(c.warns.items[1].line == 24 && c.warns.items[0].line == 24 && c.warns.items[0].col > 1 && c.warns.items[1].col > c.warns.items[0].col, "keyframe warnings point at the declaration");
    // style: text
    let d0 = c.decls.len;
    ok(inlineDecl(&c, "animation-name", "initial") == 1, "a lone keyword on an animation longhand");
    ok(inlineDecl(&c, "padding", "1px inherit") == 0, "inherit mixed in is invalid");
    ok(inlineDecl(&c, "all", "unset") == 1, "style:all is one declaration");
    ok(inlineDecl(&c, "padding", "initial") == 4, "style:padding=initial is four");
    ok(inlineDecl(&c, "color", "revert") == 1 && inlineDecl(&c, "border", "unset") == 9, "style: color, border");
    ok(inlineDecl(&c, "width", "initial 5px") == 0, "a keyword with more tokens is invalid");
    ok(inlineDecl(&c, "transition", "unset") == 4 && inlineDecl(&c, "animation", "initial") == 7, "transition and animation take the keywords");
    c.decls.len = d0;
}

/// `revert` in the cascade with `@property` registered: computeStyle and `rebuildReaders` (the inline-rule / animation path) both reach the tag default.
fn testRevertRegistered(mem: &Arena) {
    let c = Css.new(mem);
    uastyle.load(&c);
    parse(&c, "@property --z { syntax: '<number>'; inherits: false; initial-value: 1; }\n.r { font-weight: revert; --z: 2; }\n.v { font-weight: revert; all: unset; font-style: revert; }", "rr.css", 0);
    let nodes = mem.alloc::<MatchNode>(3);
    node(mem, &c, nodes, 0, "div", "", -1, 0, 0);
    node(mem, &c, nodes, 1, "strong", "r", 0, 0, 0);
    node(mem, &c, nodes, 2, "em", "v", 0, 0, 0);
    let s0 = computeStyle(&c, nodes, 0, -1);
    let s1 = computeStyle(&c, nodes, 1, s0);
    let s2 = computeStyle(&c, nodes, 2, s0);
    ok(gf(&c, s1, P_FONT_WEIGHT) == 700.0 && pv(&c, s1, "--z").f == 2.0, "revert to the tag default with @property registered");
    ok(gi(&c, s2, P_FONT_STYLE) == 1, "revert after all: unset still finds em italic");
    ok(rebuildReaders(&c, s1, c.varsOf(s1)) && c.out[P_FONT_WEIGHT].f == 700.0, "rebuildReaders (inline-rule path) reverts too");
}

/// `Css.reset` forgets the built-in range: author rules parsed after it are never taken for tag defaults.
fn testRevertAfterReset(mem: &Arena) {
    let c = Css.new(mem);
    uastyle.load(&c);
    c.reset();
    ok(c.uaLo == 0 && c.uaHi == 0, "reset clears the built-in rule range");
    parse(&c, "strong { font-weight: revert; }", "rs.css", 0);
    let nodes = mem.alloc::<MatchNode>(2);
    node(mem, &c, nodes, 0, "div", "", -1, 0, 0);
    node(mem, &c, nodes, 1, "strong", "", 0, 0, 0);
    let s0 = computeStyle(&c, nodes, 0, -1);
    ok(gf(&c, computeStyle(&c, nodes, 1, s0), P_FONT_WEIGHT) == 400.0, "before load, revert is unset");
}
