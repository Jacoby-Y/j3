// css_test: selector matching, focus and :has() checks.

module css_test;

fn testSelectors(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, "#a { color: #111; } .x #a { color: #222; } li + li { opacity: 0.5; } .on ~ li { width: 7px; } .on + li + li { height: 9px; } li > li { gap: 1px; } a::before { content: \"[\"; } .k::after { content: none; } li:hover::after { content: \"x\"; } li::before::after { color: #f00; } .b:first-child + .c { z-index: 3; } a:before { content: \"<\"; }", "sel.css", 0);
    ok(c.warns.len == 1, "only the double pseudo-element is rejected");
    ok(c.rules.len == 11, "eleven rules compiled");
    ok(c.rules.items[0].spec == 10000, "#id specificity is 1,0,0");
    ok(c.rules.items[1].spec == 10100, "#id plus class");
    ok(c.rules.items[2].spec == 2, "li + li is 0,0,2");
    ok(c.rules.items[3].spec == 101, ".on ~ li is 0,1,1");
    ok(c.sibMode == 2, "~ and chained + set the all-following mode");
    ok(c.peRules.len == 4, "four pseudo-element rules");
    ok(c.rules.items[c.peRules.items[0]].pe == 1 && c.rules.items[c.peRules.items[1]].pe == 2, "before / after kinds");
    ok(c.rules.items[c.peRules.items[0]].spec == 2 && c.rules.items[c.peRules.items[2]].spec == 102, "pseudo-element counts as a type selector");
    let c1 = Css.new(mem);
    parse(&c1, "li + li { opacity: 0.5; }", "one.css", 0);
    ok(c1.sibMode == 1, "a lone + needs only the next sibling");
    let pc = Css.new(mem);
    parse(&pc, ".a::before { content: \"hi\"; } .b::after { content: none; } .c::after { content: 5px; }", "content.css", 0);
    ok(pc.warns.len == 1, "content takes a string or none");
    // matching: ul(0) > li1 li2.on li3 li4 ; p(5)
    let n = mem.alloc::<MatchNode>(8);
    node(mem, &c, n, 0, "ul", "x", -1, 0, 0);
    sib(mem, &c, n, 1, "", "a", -1);
    sib(mem, &c, n, 2, "on", "", 1);
    sib(mem, &c, n, 3, "", "", 2);
    sib(mem, &c, n, 4, "", "", 3);
    n[5] = n[3];
    n[5].pe = -1;
    n[5].tag = c.intern("#text");
    n[5].prevSibling = 3;
    n[4].prevSibling = 5;
    node(mem, &c, n, 6, "li", "", 0, 0, 0);
    n[6].prevSibling = 4;
    n[6].pe = 1;
    n[7] = n[4];
    n[7].prevSibling = 6;
    let pid = propId("color");
    let s1 = computeStyle(&c, n, 1, -1);
    ok(gc(&c, s1, pid) == rgba(34, 34, 34, 255), "#a under .x beats #a");
    ok(gi(&c, computeStyle(&c, n, 1, -1), P_OPACITY) == 0, "first li has no li before it");
    let op = propId("opacity");
    ok(gf(&c, computeStyle(&c, n, 1, -1), op) == 1.0, "the first li is not styled by li + li");
    ok(gf(&c, computeStyle(&c, n, 2, -1), op) == 0.5, "li + li styles the second");
    ok(gf(&c, computeStyle(&c, n, 4, -1), op) == 0.5, "text nodes between siblings are skipped");
    ok(gf(&c, computeStyle(&c, n, 7, -1), op) == 0.5, "pseudo-element boxes between siblings are skipped");
    let wd = propId("width");
    ok(gf(&c, computeStyle(&c, n, 3, -1), wd) == 7.0 && gf(&c, computeStyle(&c, n, 4, -1), wd) == 7.0, "~ reaches every later sibling");
    ok(gkind(&c, computeStyle(&c, n, 2, -1), wd) == V_AUTO && gkind(&c, computeStyle(&c, n, 1, -1), wd) == V_AUTO, "~ skips the .on itself and earlier ones");
    let ht = propId("height");
    ok(gf(&c, computeStyle(&c, n, 4, -1), ht) == 9.0, ".on + li + li reaches the second after .on");
    ok(gkind(&c, computeStyle(&c, n, 3, -1), ht) == V_AUTO, ".on + li + li skips the first");
    ok(gkind(&c, computeStyle(&c, n, 3, -1), propId("gap")) != V_PX || gf(&c, computeStyle(&c, n, 3, -1), propId("gap")) == 0.0, "li > li needs a li parent");
    // pseudo-element boxes are styled by the rules of their kind against the host
    let ph = mem.alloc::<MatchNode>(2);
    node(mem, &c, ph, 0, "a", "k", -1, 0, 0);
    node(mem, &c, ph, 1, "a", "k", 0, 0, 0);
    ph[1].pe = 1;
    let hs = computeStyle(&c, ph, 0, -1);
    let bs = computeStyle(&c, ph, 1, hs);
    ok(gkind(&c, bs, propId("content")) == V_STR && same(c.name(gi(&c, bs, propId("content"))), "<"), "::before content: the later one-colon rule of equal specificity wins");
    ph[1].pe = 2;
    ok(gkind(&c, computeStyle(&c, ph, 1, hs), propId("content")) == V_NONE, "::after content: none");
    ok(gkind(&c, hs, propId("content")) == V_NONE, "the host element itself has no content");
}

// :checked :empty :enabled :placeholder-shown :nth-last-child :nth-of-type :nth-last-of-type :only-child :first/last/only-of-type
fn testSelectors2(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, "li:nth-last-child(2) { width: 1px; } li:nth-of-type(2n) { height: 2px; } li:nth-last-of-type(1) { gap: 3px; } li:first-of-type { order: 4; } p:only-of-type { opacity: 0.5; } li:only-child { flex-shrink: 6; } div:empty { max-width: 7px; } li:not(:last-of-type) { padding-top: 8px; } input:checked:enabled { order: 9; } input:placeholder-shown { min-width: 10px; } li:nth-of-type(x) { color: #fff; } li:nth-last-child() { color: #fff; }", "s2.css", 0);
    ok(c.warns.len == 2, "bad :nth-of-type() and :nth-last-child() arguments warn");
    ok(c.warns.items[0].line == 1 && c.warns.items[0].col > 1 && c.warns.items[1].line == 1 && c.warns.items[1].col > c.warns.items[0].col, "each warning has its position");
    ok(c.rules.len == 10 && c.structMode == 1, "ten rules kept, structural mode on");
    ok(c.rules.items[0].spec == 101 && c.rules.items[3].spec == 101 && c.rules.items[6].spec == 101 && c.rules.items[7].spec == 101, "each structural pseudo-class counts as a class, also inside :not()");
    ok(c.rules.items[8].spec == 201 && c.rules.items[9].spec == 101, ":checked:enabled is two classes (:enabled is :not(:disabled)), :placeholder-shown one");
    let plain = Css.new(mem);
    parse(&plain, "li:nth-child(2) { width: 1px; } input:checked { height: 2px; }", "p.css", 0);
    ok(plain.structMode == 0, "no structural rule: structMode stays 0");
    // ul > [li, li, p, li], div (empty), div with text, div with an element
    let n = mem.alloc::<MatchNode>(9);
    node(mem, &c, n, 0, "ul", "", -1, 0, 0);
    node(mem, &c, n, 1, "li", "", 0, 0, 0);
    node(mem, &c, n, 2, "li", "", 0, 0, 0);
    node(mem, &c, n, 3, "p", "", 0, 0, 0);
    node(mem, &c, n, 4, "li", "", 0, 0, 0);
    node(mem, &c, n, 5, "div", "", -1, 0, 0);
    node(mem, &c, n, 6, "div", "", -1, 0, 0);
    node(mem, &c, n, 7, "div", "", -1, 0, 0);
    node(mem, &c, n, 8, "span", "", 7, 0, 0);
    n[0].first = 1;
    n[1].next = 2; n[2].prevSibling = 1;
    n[2].next = 3; n[3].prevSibling = 2;
    n[3].next = 4; n[4].prevSibling = 3;
    n[7].first = 8;
    let wd = propId("width");
    let ht = propId("height");
    ok(gkind(&c, computeStyle(&c, n, 1, -1), wd) == V_AUTO && gkind(&c, computeStyle(&c, n, 2, -1), wd) == V_AUTO && gkind(&c, computeStyle(&c, n, 4, -1), wd) == V_AUTO, ":nth-last-child(2) of 4 is the p, not a li");
    ok(gf(&c, computeStyle(&c, n, 1, -1), P_GAP) == 0.0 && gf(&c, computeStyle(&c, n, 4, -1), P_GAP) == 3.0, ":nth-last-of-type(1): the last li only");
    ok(gf(&c, computeStyle(&c, n, 2, -1), ht) == 2.0 && gkind(&c, computeStyle(&c, n, 1, -1), ht) == V_AUTO && gkind(&c, computeStyle(&c, n, 4, -1), ht) == V_AUTO, ":nth-of-type(2n): the 2nd li; the p does not count");
    ok(gf(&c, computeStyle(&c, n, 1, -1), propId("order")) == 4.0 && gf(&c, computeStyle(&c, n, 2, -1), propId("order")) == 0.0, ":first-of-type");
    ok(gf(&c, computeStyle(&c, n, 3, -1), P_OPACITY) == 0.5, ":only-of-type: the lone p among li");
    ok(gf(&c, computeStyle(&c, n, 1, -1), propId("padding-top")) == 8.0 && gf(&c, computeStyle(&c, n, 4, -1), propId("padding-top")) == 0.0, ":not(:last-of-type)");
    ok(gf(&c, computeStyle(&c, n, 1, -1), propId("flex-shrink")) == 1.0, ":only-child is false with siblings");
    ok(gf(&c, computeStyle(&c, n, 5, -1), propId("max-width")) == 7.0 && gf(&c, computeStyle(&c, n, 7, -1), propId("max-width")) != 7.0, ":empty: no children yes, an element child no");
    n[6].first = 8;
    n[8].parent = 6;
    n[6].flags = 0;
    ok(gf(&c, computeStyle(&c, n, 6, -1), propId("max-width")) != 7.0, ":empty: an element child");
    n[8].pe = -1;
    ok(gf(&c, computeStyle(&c, n, 6, -1), propId("max-width")) == 7.0, ":empty: a whitespace-only text node counts as empty (Selectors 4)");
    n[8].flags = FL_NONBLANK;
    ok(gf(&c, computeStyle(&c, n, 6, -1), propId("max-width")) != 7.0, ":empty: text with content is not empty");
    n[8].pe = 1;
    ok(gf(&c, computeStyle(&c, n, 6, -1), propId("max-width")) == 7.0, ":empty ignores ::before boxes");
    // :checked:enabled and :placeholder-shown follow the flags
    node(mem, &c, n, 5, "input", "", -1, 0, 0);
    ok(gf(&c, computeStyle(&c, n, 5, -1), propId("order")) == 0.0, "unchecked: no rule");
    n[5].flags = FL_CHECKED;
    ok(gf(&c, computeStyle(&c, n, 5, -1), propId("order")) == 9.0, ":checked and enabled");
    n[5].flags = FL_CHECKED + FL_DISABLED;
    ok(gf(&c, computeStyle(&c, n, 5, -1), propId("order")) == 0.0, "disabled is not :enabled");
    n[5].flags = FL_PH_SHOWN;
    ok(gf(&c, computeStyle(&c, n, 5, -1), propId("min-width")) == 10.0, ":placeholder-shown");
    // nested (joined) selectors take the same pseudo-classes
    let nest = Css.new(mem);
    parse(&nest, ".l { li { &:nth-last-child(1) { width: 1px; } &:empty { height: 2px; } } }", "n.css", 0);
    ok(nest.warns.len == 0 && nest.rules.len == 2 && nest.structMode == 1, "nested :nth-last-child and :empty parse");
}

// :focus-within and :focus-visible: parse, specificity (a class each), :not(), matching follows the flags
fn testFocusCss(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, "div:focus-within { width: 1px; } button:focus-visible { height: 2px; } button:not(:focus-visible) { gap: 3px; } #x:focus-within { order: 4; } div:focus-within:focus-visible { opacity: 0.5; } p:focus-bogus { color: #fff; }", "focus.css", 0);
    ok(c.warns.len == 1, "only the unknown pseudo-class warns");
    ok(c.rules.items[0].spec == 101 && c.rules.items[1].spec == 101 && c.rules.items[2].spec == 101, "each focus pseudo-class counts as a class, :not(:focus-visible) too");
    ok(c.rules.items[4].spec == 201, "two pseudo-classes");
    let n = mem.alloc::<MatchNode>(2);
    node(mem, &c, n, 0, "div", "", -1, 0, 0);
    node(mem, &c, n, 1, "button", "", 0, 0, 0);
    let wd = propId("width");
    let ht = propId("height");
    ok(gkind(&c, computeStyle(&c, n, 0, -1), wd) == V_AUTO, "no :focus-within without the flag");
    n[0].flags = FL_FOCUS_WITHIN;
    ok(gf(&c, computeStyle(&c, n, 0, -1), wd) == 1.0, ":focus-within matches its flag");
    ok(gf(&c, computeStyle(&c, n, 0, -1), P_OPACITY) == 1.0, "both flags are needed");
    ok(gf(&c, computeStyle(&c, n, 1, -1), P_GAP) == 3.0 && gkind(&c, computeStyle(&c, n, 1, -1), ht) == V_AUTO, ":not(:focus-visible) while unfocused");
    n[1].flags = FL_FOCUS + FL_FOCUS_VIS;
    ok(gf(&c, computeStyle(&c, n, 1, -1), ht) == 2.0 && gf(&c, computeStyle(&c, n, 1, -1), P_GAP) == 0.0, ":focus-visible matches, :not() stops");
    n[1].flags = FL_FOCUS;
    ok(gkind(&c, computeStyle(&c, n, 1, -1), ht) == V_AUTO, ":focus alone is not :focus-visible");
}

// :has(): the supported forms, specificity, matching against a hand-built tree, unsupported forms warn with a position
fn testHasCss(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, "div:has(> a) { width: 1px; } div:has(a, .b) { height: 2px; } div:has(+ p) { gap: 3px; } div:has(~ #x) { order: 4; } .c:has(:checked) .d { opacity: 0.5; } div:has(.a .b) { color: #fff; } div:has(:has(a)) { color: #fff; } div:has() { color: #fff; } div:has(a):has(b) { color: #fff; }", "has.css", 0);
    ok(c.warns.len == 4, "complex, nested, empty and doubled :has() are dropped with a warning");
    ok(c.warns.items[0].line == 1 && c.warns.items[0].col > 1, "the warning has a position");
    ok(c.rules.len == 5 && c.hasMode == 15, "the five supported rules load and use every relation");
    ok(c.rules.items[0].spec == 2, "div:has(> a) is (0,0,2) via its argument");
    ok(c.rules.items[1].spec == 101, "div:has(a, .b): the most specific argument, a class");
    ok(c.rules.items[3].spec == 10001, "div:has(~ #x): an id argument");
    ok(c.rules.items[4].spec == 300, ".c:has(:checked) .d: two classes and a class");
    // nested parens: the scan is balanced, so the rule drops with the positioned warning and no stray `)` error
    let nest = Css.new(mem);
    parse(&nest, "div:has(:nth-child(2)) { width: 1px; } div:not(:has(a)) { width: 2px; } p { width: 3px; }", "hn.css", 0);
    ok(nest.warns.len == 2 && nest.rules.len == 1, "unsupported nested functions in :has() and :not() drop only their rule");
    ok(nest.warns.items[0].line == 1 && nest.warns.items[1].line == 1, "each warning is positioned");
    let nm = Css.new(mem);
    parse(&nm, "div { width: 1px; }", "n.css", 0);
    ok(nm.hasMode == 0 && nm.hasSubj.len == 0, "no :has() rule, no has mode");
}
