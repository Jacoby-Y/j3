// css_test: background/border images, gradients, shadows.

module css_test;

/// Chunk 24: border-image-* longhands and shorthand, layered backgrounds with url() layers and cycling lists.
fn testImagery(mem: &Arena) {
    let c = Css.new(mem);
    parse(&c, ".a { border-image: url(p.png) 12 fill / 8px 4px / 2 round space; } .b { border-image: url(p.png) 25% 10 stretch; } .c { border-image-source: url(q.png); border-image-slice: 5 6 7 8 fill; border-image-width: 2 10px auto 5%; border-image-outset: 1 3px; border-image-repeat: repeat; } .d { background: url(a.png) center / 20px 10px no-repeat, linear-gradient(#f00, #00f), url(b.png) repeat-x #123456; } .e { background-image: url(a.png), url(b.png), none; background-size: 10px, 20px 30px; background-position: left top, right 5px; background-repeat: space round, repeat-x; } .f { background-image: url(a.png); background-repeat: round; } .g { background-image: url(1.png), url(2.png), url(3.png), url(4.png), url(5.png), url(6.png), url(7.png), url(8.png), url(9.png), url(10.png); }", "imagery.css", 0);
    warnText(&c);
    ok(c.warns.len == 1, "every new image form parses; only the 10-layer list warns");
    ok(c.warns.items[0].msg.len > 0 && contains(c.warns.items[0].msg, "8 background layers"), "the layer cap warning names the cap");
    let n = mem.alloc::<MatchNode>(7);
    let cls = ["a", "b", "c", "d", "e", "f", "g"];
    for q in 0..7 {
        node(mem, &c, n, q, "div", cls[q], -1, 0, 0);
    }
    let a = computeStyle(&c, n, 0, -1);
    let pa = c.paints.items;
    ok(gkind(&c, a, P_BORDER_IMAGE) == V_URL, "border-image takes a url source");
    let s = gi(&c, a, P_BORDER_SLICE);
    ok(pa[s] == 12.0 && pa[s + 3] == 12.0 && pa[s + 4] == 1.0 && pa[s + 5] == 0.0, "slice 12 fill, no percentages");
    let w = gi(&c, a, P_BORDER_IMG_W);
    ok(pa[w] == 8.0 && pa[w + 1] == 1.0 && pa[w + 2] == 4.0 && pa[w + 6] == 4.0, "width 8px 4px copies to four sides");
    let o = gi(&c, a, P_BORDER_OUTSET);
    ok(pa[o] == 2.0 && pa[o + 1] == 0.0, "outset is a number");
    let r = gi(&c, a, P_BORDER_REPEAT);
    ok(pa[r] == 3.0 && pa[r + 1] == 2.0, "repeat round space is x round, y space");
    let b = computeStyle(&c, n, 1, -1);
    let sb = gi(&c, b, P_BORDER_SLICE);
    ok(pa[sb] == 25.0 && pa[sb + 1] == 10.0 && pa[sb + 5] == 5.0, "25% 10: top and bottom are percentages (mask bits 0 and 2)");
    ok(gkind(&c, b, P_BORDER_REPEAT) == V_LIST && pa[gi(&c, b, P_BORDER_REPEAT)] == 1.0 && pa[gi(&c, b, P_BORDER_REPEAT) + 1] == 1.0, "one stretch word sets both axes");
    let cc = computeStyle(&c, n, 2, -1);
    let sc = gi(&c, cc, P_BORDER_SLICE);
    ok(pa[sc] == 5.0 && pa[sc + 3] == 8.0 && pa[sc + 4] == 1.0, "slice longhand with four sides and fill");
    let wc = gi(&c, cc, P_BORDER_IMG_W);
    ok(pa[wc + 1] == 0.0 && pa[wc + 2] == 10.0 && pa[wc + 3] == 1.0 && pa[wc + 5] == 3.0 && pa[wc + 7] == 2.0, "width: number, px, auto, percent");
    let oc = gi(&c, cc, P_BORDER_OUTSET);
    ok(pa[oc] == 1.0 && pa[oc + 2] == 3.0 && pa[oc + 3] == 1.0, "outset: number then px");
    ok(pa[gi(&c, cc, P_BORDER_REPEAT)] == 0.0, "repeat keyword");
    // layered shorthand: url, gradient, url + color
    let d = computeStyle(&c, n, 3, -1);
    ok(gkind(&c, d, P_BG_IMAGE) == V_GRAD, "a mixed layer list is a V_GRAD");
    let io = gi(&c, d, P_BG_IMAGE);
    ok(pa[io] == 3.0 && pa[io + 1] == 9.0, "three layers, the first a url layer");
    ok(gc(&c, d, P_BACKGROUND) == rgba(0x12, 0x34, 0x56, 255), "the last layer holds the base color");
    let dz = c.get(d, P_BG_SIZE);
    ok(dz.c == 3 && pa[dz.i + 1] == 20.0 && pa[dz.i + 3] == 10.0 && pa[dz.i + 5 + 2] == 2.0, "size: 20px 10px for layer 0, auto for the gradient");
    let dp = c.get(d, P_BG_POS);
    ok(pa[dp.i] == 50.0 && pa[dp.i + 4] == 0.0, "position: center for layer 0, the default for layer 1");
    let dr = c.get(d, P_BG_REPEAT);
    ok(dr.c == 3 && pa[dr.i] == 1.0 && pa[dr.i + 1] == 1.0 && pa[dr.i + 2] == 0.0 && pa[dr.i + 4] == 0.0 && pa[dr.i + 5] == 1.0, "repeat per layer: no-repeat, repeat, repeat-x");
    // longhand lists
    let e = computeStyle(&c, n, 4, -1);
    let ei = gi(&c, e, P_BG_IMAGE);
    ok(pa[ei] == 3.0 && pa[ei + 4] == 9.0 && pa[ei + 7] == 9.0 && pa[ei + 8] == -1.0, "url, url, none layers (none is id -1)");
    let es = c.get(e, P_BG_SIZE);
    ok(es.c == 2 && pa[es.i + 1] == 10.0 && pa[es.i + 5 + 1] == 20.0 && pa[es.i + 5 + 3] == 30.0, "size list of two entries (cycles over three layers)");
    let er = c.get(e, P_BG_REPEAT);
    ok(er.c == 2 && pa[er.i] == 2.0 && pa[er.i + 1] == 3.0 && pa[er.i + 2] == 0.0 && pa[er.i + 3] == 1.0, "repeat: space round, then repeat-x");
    let f = computeStyle(&c, n, 5, -1);
    ok(gkind(&c, f, P_BG_IMAGE) == V_URL, "a lone url stays a V_URL (the identity path)");
    let fr = c.get(f, P_BG_REPEAT);
    ok(pa[fr.i] == 3.0 && pa[fr.i + 1] == 3.0, "round on both axes");
    let g = computeStyle(&c, n, 6, -1);
    ok(pa[gi(&c, g, P_BG_IMAGE)] == 10.0, "all ten layers are kept (painting stops at eight)");
    // var() inside a layered background: the deferred value is parsed again with the url layer intact
    let vc = Css.new(mem);
    parse(&vc, ".v { --c: #ff0000; background: url(a.png) 0 0 / 8px, linear-gradient(var(--c), #000000); }", "imagery-var.css", 0);
    ok(vc.warns.len == 0, "a deferred layered background parses");
    let vn = mem.alloc::<MatchNode>(1);
    node(mem, &vc, vn, 0, "div", "v", -1, 0, 0);
    let vst = computeStyle(&vc, vn, 0, -1);
    ok(gkind(&vc, vst, P_BG_IMAGE) == V_GRAD, "the substituted value is a layer list");
    let vo = gi(&vc, vst, P_BG_IMAGE);
    ok(vc.paints.items[vo] == 2.0 && vc.paints.items[vo + 1] == 9.0 && vc.paints.items[vo + 4] == 0.0, "url layer then the gradient with the var() color");
    ok(vc.paints.items[vo + 4 + 3 + 1] == 255.0, "the var() stop is red");
    // url() in custom properties: kept as written (images resolve a path the same way everywhere), written back where var() is used
    let vu = Css.new(mem);
    parse(&vu, ":root { --bg: url(a.png); --q: url('dir/b.png'); --g: #00ff00; }", "theme.css", 0);
    parse(&vu, ".a { background-image: var(--bg); } .b { background-image: var(--bg), linear-gradient(#f00, #00f); } .c { border-image-source: var(--q); } .d { border-image: var(--bg) 12 fill / 8px; } .e { background-image: var(--missing, url(c.png)); } .f { background: var(--bg) center / 20px no-repeat, var(--g); } .g { background-image: linear-gradient(#000, #fff), var(--q); } .h { background-image: var(--missing); }", "comp.j3ui", 1);
    warnText(&vu);
    ok(vu.warns.len == 0, "url() in a custom property and var() in image declarations parse clean");
    let un = mem.alloc::<MatchNode>(9);
    node(mem, &vu, un, 0, "html", "", -1, 0, 0);
    let ucls = ["a", "b", "c", "d", "e", "f", "g", "h"];
    for q in 0..8 {
        node(mem, &vu, un, q + 1, "div", ucls[q], 0, 0, 1);
    }
    let root = computeStyle(&vu, un, 0, -1);
    ok(pv(&vu, root, "--bg").kind == V_URL && same(vu.name(pv(&vu, root, "--bg").i), "a.png"), "the custom property keeps the path as written");
    let ua = computeStyle(&vu, un, 1, root);
    ok(gkind(&vu, ua, P_BG_IMAGE) == V_URL && same(vu.name(vu.get(ua, P_BG_IMAGE).i), "a.png"), "background-image: var(--bg) is the url");
    let ub = computeStyle(&vu, un, 2, root);
    let ubo = gi(&vu, ub, P_BG_IMAGE);
    ok(gkind(&vu, ub, P_BG_IMAGE) == V_GRAD && vu.paints.items[ubo] == 2.0 && vu.paints.items[ubo + 1] == 9.0, "a layer list: the var() url layer then the gradient");
    ok(same(vu.name(int(vu.paints.items[ubo + 2])), "a.png"), "the url layer holds the path");
    let uc = computeStyle(&vu, un, 3, root);
    ok(gkind(&vu, uc, P_BORDER_IMAGE) == V_URL && same(vu.name(vu.get(uc, P_BORDER_IMAGE).i), "dir/b.png"), "border-image-source: var() with a quoted path");
    let ud = computeStyle(&vu, un, 4, root);
    ok(gkind(&vu, ud, P_BORDER_IMAGE) == V_URL && same(vu.name(vu.get(ud, P_BORDER_IMAGE).i), "a.png"), "the border-image shorthand takes the var() url");
    let ue = computeStyle(&vu, un, 5, root);
    ok(gkind(&vu, ue, P_BG_IMAGE) == V_URL && same(vu.name(vu.get(ue, P_BG_IMAGE).i), "c.png"), "the var() fallback holds a url()");
    let uf = computeStyle(&vu, un, 6, root);
    ok(gkind(&vu, uf, P_BG_IMAGE) == V_URL && same(vu.name(vu.get(uf, P_BG_IMAGE).i), "a.png") && gc(&vu, uf, P_BACKGROUND) != 0, "background shorthand: var() url layer and a var() color");
    let ug = computeStyle(&vu, un, 7, root);
    ok(gkind(&vu, ug, P_BG_IMAGE) == V_GRAD, "gradient then a var() url layer");
    let uh = computeStyle(&vu, un, 8, root);
    ok(gkind(&vu, uh, P_BG_IMAGE) == V_NONE, "an undefined var() with no fallback is skipped");
    // @property with syntax <url> (<image> is rejected)
    let vp = Css.new(mem);
    parse(&vp, "@property --pic { syntax: '<url>'; inherits: true; initial-value: url(init.png); } @property --bad { syntax: '<image>'; inherits: false; initial-value: url(x.png); } @property --bad2 { syntax: '<url>'; inherits: false; initial-value: red; } .p { background-image: var(--pic); } .q { --pic: url(q.png); background-image: var(--pic); } .r { --pic: red; background-image: var(--pic); }", "prop.css", 0);
    ok(vp.warns.len == 4, "<image> and a color initial-value for <url> each warn twice");
    let pn = mem.alloc::<MatchNode>(3);
    let pcls = ["p", "q", "r"];
    for q in 0..3 {
        node(mem, &vp, pn, q, "div", pcls[q], -1, 0, 0);
    }
    let pp = computeStyle(&vp, pn, 0, -1);
    ok(gkind(&vp, pp, P_BG_IMAGE) == V_URL && same(vp.name(vp.get(pp, P_BG_IMAGE).i), "init.png"), "a registered <url> property starts at its initial value");
    let pq = computeStyle(&vp, pn, 1, -1);
    ok(same(vp.name(vp.get(pq, P_BG_IMAGE).i), "q.png"), "and takes a url()");
    let pr = computeStyle(&vp, pn, 2, -1);
    ok(same(vp.name(vp.get(pr, P_BG_IMAGE).i), "init.png"), "a color is not a <url>: back to the initial value");
    // the old form `var(--x, gradient)` gives the same paint data as the gradient written directly; a var cannot hold a gradient
    let gf = Css.new(mem);
    parse(&gf, ".d { background-image: linear-gradient(#ff0000, #0000ff); } .f { background-image: var(--none, linear-gradient(#ff0000, #0000ff)); } .h { --g: linear-gradient(#000, #fff); }", "grad.css", 0);
    ok(gf.warns.len == 1, "a gradient custom property is invalid, as before");
    let gn = mem.alloc::<MatchNode>(2);
    node(mem, &gf, gn, 0, "div", "d", -1, 0, 0);
    node(mem, &gf, gn, 1, "div", "f", -1, 0, 0);
    let gd = computeStyle(&gf, gn, 0, -1);
    let gff = computeStyle(&gf, gn, 1, -1);
    let go1 = gi(&gf, gd, P_BG_IMAGE);
    let go2 = gi(&gf, gff, P_BG_IMAGE);
    let gsame = gkind(&gf, gd, P_BG_IMAGE) == gkind(&gf, gff, P_BG_IMAGE);
    for k in 0..13 {
        if gf.paints.items[go1 + k] != gf.paints.items[go2 + k] { gsame = false; }
    }
    ok(gsame, "var(--x, gradient) equals the gradient written directly");
    // escaping when a path is written back: a space and ')' are fine quoted, '\"' picks the other quote, both quotes cannot be written
    let esc = Css.new(mem);
    parse(&esc, ":root { --a: url('my dir/a (1).png'); --b: url('q\"x.png'); --c: url(a\"b'c.png); } .a { background-image: var(--a), none; } .b { background-image: var(--b), none; } .c { background-image: var(--c), none; }", "esc.css", 0);
    let enn = mem.alloc::<MatchNode>(4);
    node(mem, &esc, enn, 0, "html", "", -1, 0, 0);
    let ecls = ["a", "b", "c"];
    for q in 0..3 {
        node(mem, &esc, enn, q + 1, "div", ecls[q], 0, 0, 0);
    }
    let er0 = computeStyle(&esc, enn, 0, -1);
    let ea = computeStyle(&esc, enn, 1, er0);
    ok(same(esc.name(int(esc.paints.items[gi(&esc, ea, P_BG_IMAGE) + 2])), "my dir/a (1).png"), "a path with a space and parentheses survives");
    let eb = computeStyle(&esc, enn, 2, er0);
    ok(same(esc.name(int(esc.paints.items[gi(&esc, eb, P_BG_IMAGE) + 2])), "q\"x.png"), "a path with a double quote is written back single-quoted");
    let ec = computeStyle(&esc, enn, 3, er0);
    ok(gkind(&esc, ec, P_BG_IMAGE) == V_NONE, "an unquoted path with both quotes cannot be written back: the declaration is skipped");
    // invalid forms
    let bad = Css.new(mem);
    parse(&bad, ".a { border-image: url(p.png) 12 / ; } .b { border-image-repeat: tile; } .c { background-repeat: repeat-x repeat; } .d { border-image-width: -1; } .e { background: url(a.png) 10px / ; } .f { border-image: url(p.png) 12px; } .g { background-size: 10px, ; }", "imagery-bad.css", 0);
    ok(bad.warns.len == 7, "seven malformed image declarations warn");
    for i in 0..bad.warns.len {
        ok(bad.warns.items[i].line == 1 && bad.warns.items[i].col > 0, "each warning has a position");
    }
}
