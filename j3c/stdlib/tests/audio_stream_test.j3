// Tests for j3.game.AudioStream: queue, real-time drain, clear, close. Passes (skips) with no audio device.
//   SDL_AUDIODRIVER=dummy timeout 30 j3c run j3c/stdlib/tests/audio_stream_test.j3
// Panics on the first failed check.

module audio_stream_test;

use j3.game;
use j3.io.printLn;
use j3.memory.Arena;
use j3.sys.panic;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic("audio_stream_test");
    }
}

fn main() {
    let s = game.openAudioStream(48000, 2);
    if s.raw == 0 {
        printLn("skip: no audio device");
        return;
    }
    let arena = Arena.create(1024 * 1024);
    let buf = arena.alloc::<f32>(48000);
    s.queue(buf);
    let q0 = s.queued();
    ok(q0 > 20000 && q0 <= 24000, `queued {q0} after 0.5 s`);
    let t0 = game.ticks();
    while game.ticks() - t0 < 200 {}
    let q1 = s.queued();
    printLn(`queued {q0} -> {q1} after 200 ms`);
    ok(q0 - q1 > 4800 && q0 - q1 < 16000, "drains in real time");
    s.pause(true);
    s.clear();
    ok(s.queued() == 0, "clear empties the queue");
    s.close();
    ok(s.raw == 0, "close empties the stream");
    s.queue(buf[0..2]); // no-op on a closed stream
    printLn("ok");
}
