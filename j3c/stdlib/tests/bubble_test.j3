// `on:mousedown` / `on:mouseup` / `on:contextmenu` bubble from the hit node to its ancestors, and `|stop` (`attrFlag`
// 8 / 16 / 32) ends the walk. Three nested boxes, no text, so no font. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/bubble_test.j3

module bubble_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

#[singleton]
let IDS: [3]int;

const SHEET: string = ".a { width: 200px; height: 200px; } .b { width: 100px; height: 100px; } .c { width: 50px; height: 50px; }";

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

/// outer `.a` > middle `.b` > inner `.c`; `stop` is the middle box's `|stop` bits.
fn frame(d: &Dom, stop: int) {
    d.beginFrame(Vec2 { x: 400.0, y: 400.0 });
    let a = d.open(0, d.tag("div"), 1);
    d.cls(a, "a");
    let b = d.open(0, d.tag("div"), 1);
    d.cls(b, "b");
    if stop != 0 { d.attrFlag(b, stop); }
    let c = d.open(0, d.tag("div"), 1);
    d.cls(c, "c");
    d.close();
    d.close();
    d.close();
    IDS[0] = a;
    IDS[1] = b;
    IDS[2] = c;
    d.layout();
    d.endFrame();
}

fn main() {
    let mem = Arena.create(8 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "test.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    d.simInput(10.0, 10.0, false, 0.0);
    frame(&d, 0);
    frame(&d, 0);
    d.simInput(10.0, 10.0, true, 0.0);
    frame(&d, 0);
    ok(d.mouseDown(IDS[2]) && d.mouseDown(IDS[1]) && d.mouseDown(IDS[0]), "a press on the inner box reaches every ancestor");
    ok(d.downBtn == 0, "left button");
    d.simInput(10.0, 10.0, false, 0.0);
    frame(&d, 0);
    ok(d.mouseUp(IDS[2]) && d.mouseUp(IDS[0]), "release bubbles");
    ok(!d.mouseDown(IDS[0]), "the press is one frame");
    // a press outside the inner box but inside the middle one does not reach the inner box
    d.simInput(80.0, 80.0, true, 0.0);
    frame(&d, 0);
    ok(!d.mouseDown(IDS[2]) && d.mouseDown(IDS[1]) && d.mouseDown(IDS[0]), "only the hit node and its ancestors");
    d.simInput(80.0, 80.0, false, 0.0);
    frame(&d, 0);
    // |stop on the middle box: the outer box hears nothing
    d.simInput(10.0, 10.0, false, 0.0);
    frame(&d, 8 | 16 | 32);
    d.simInput(10.0, 10.0, true, 0.0);
    frame(&d, 8 | 16 | 32);
    ok(d.mouseDown(IDS[2]) && d.mouseDown(IDS[1]) && !d.mouseDown(IDS[0]), "mousedown|stop ends the walk at the middle box");
    d.simInput(10.0, 10.0, false, 0.0);
    frame(&d, 8 | 16 | 32);
    ok(d.mouseUp(IDS[1]) && !d.mouseUp(IDS[0]), "mouseup|stop");
    d.simRight(true);
    frame(&d, 8 | 16 | 32);
    ok(d.contextAt(IDS[2]) && d.contextAt(IDS[1]) && !d.contextAt(IDS[0]), "contextmenu|stop");
    ok(d.mouseDown(IDS[1]) && d.downBtn == 2, "a right press bubbles with button 2");
    printLn("bubble_test ok");
}
