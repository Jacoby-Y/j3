module win_os_test;

// The Windows twins of j3.proc, j3.term.pty, j3.io.watch and j3.instance. Built for x86_64-pc-windows-gnu and run under
// wine by `windows_os_runs_under_wine`, inside `script` so wine gives the pty child a console. Prints one line per
// check and `win_os_test ok` at the end. `client` mode is the second copy for the instance request.

use j3.instance;
use j3.io;
use j3.io.printLn;
use j3.io.watch;
use j3.io.watch.{ Event, Watcher };
use j3.memory.{ Arena, List };
use j3.option.Option;
use j3.proc;
use j3.result.Result;
use j3.sys;
use j3.sys.panic;
use j3.term.pty;
use j3.winsys;

fn has(s: string, w: string): bool {
    if w.len > s.len { return false; }
    for i in 0..s.len - w.len + 1 {
        if s[i..i + w.len] == w { return true; }
    }
    return false;
}

fn ok(c: bool, what: string) {
    printLn(`{what}: {c}`);
    if !c { panic(what); }
}

fn main() {
    let arena = Arena.create(1 << 24);
    if sys.arg(1) == "client" {
        let a: [2]string = ["win_os_test", "ping"];
        match instance.request("j3winostest", a[:], 10000) {
            Option.Some(r) { printLn(`reply=[{r}]`); }
            Option.None { printLn("reply none"); }
        }
        return;
    }

    let argv: [4]string = ["cmd", "/c", "echo", "x"];
    let out = "";
    match proc.run(argv[:], "", &arena) {
        Result.Ok(o) { out = o.outStr(); ok(o.code == 0, "proc code"); }
        Result.Err(_) { ok(false, "proc run"); }
    }
    ok(out.len >= 1 && out[0] == 120, "proc out x");
    let bad: [1]string = ["no_such_program_j3"];
    match proc.run(bad[:], "", &arena) {
        Result.Ok(_) { ok(false, "proc NotFound"); }
        Result.Err(e) { ok(e == proc.ProcError.NotFound, "proc NotFound"); }
    }
    let exit5: [3]string = ["cmd", "/c", "exit 5"];
    match proc.start(exit5[:], &arena) {
        Result.Ok(c) { ok(c.wait() == 5, "proc exit code"); }
        Result.Err(_) { ok(false, "proc start"); }
    }

    let env: [1]string = ["J3TEST=bar"];
    let pa: [1]string = ["cmd.exe"];
    match pty.spawn(pa[:], "C:\\", env[:], 80, 24, &arena) {
        Result.Ok(p) {
            let buf = arena.alloc::<u8>(65536);
            p.write("echo hi%J3TEST%\r" as []u8);
            let seen = false;
            for i in 0..200 {
                if p.waitReadable(50) && has(p.tryRead(buf), "hibar") { seen = true; break; }
            }
            ok(seen, "pty echo");
            // ponytail: wine 9's ResizePseudoConsole is E_NOTIMPL, so `resize` is only called, not checked
            p.resize(120, 40);
            p.write("exit 3\r" as []u8);
            for i in 0..200 {
                if p.eof { break; }
                if p.waitReadable(50) { p.tryRead(buf); }
            }
            ok(p.eof, "pty eof");
            ok(p.wait() == 3, "pty exit code");
        }
        Result.Err(_) { ok(false, "pty spawn"); }
    }

    let dir = "C:\\j3_win_os_test";
    io.makeDirs(dir);
    io.remove("C:\\j3_win_os_test\\a.txt");
    let w = Watcher.create(&arena);
    let got = false;
    match w.add(dir) {
        Result.Ok(_) {
            io.writeFile("C:\\j3_win_os_test\\a.txt", "x" as []u8);
            let evs = List<Event>.new(&arena);
            for i in 0..200 {
                w.poll(&evs);
                for e in evs.items[0..evs.len] {
                    if e.kind == watch.Kind.Create && e.name == "a.txt" { got = true; }
                }
                evs.len = 0;
                if got { break; }
                winsys.sleepMs(10);
            }
        }
        Result.Err(_) { }
    }
    w.close();
    io.remove("C:\\j3_win_os_test\\a.txt");
    ok(got, "watch create");

    ok(instance.claim("j3winostest"), "instance claim");
    let ca: [2]string = [sys.arg(0), "client"];
    match proc.start(ca[:], &arena) {
        Result.Ok(c) {
            for i in 0..1000 {
                let done = false;
                match instance.nextRequest() {
                    Option.Some(r) { r.reply(`pong {r.args()[1]}`); done = true; }
                    Option.None { }
                }
                if done { break; }
                winsys.sleepMs(10);
            }
            let o = c.collect("" as []u8, &arena);
            ok(has(o.outStr(), "reply=[pong ping]"), "instance request");
        }
        Result.Err(_) { ok(false, "instance client start"); }
    }
    printLn("win_os_test ok");
}
