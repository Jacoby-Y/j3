// Tests for the j3.text utilities: shortest float printing and exact parsing (1M random f64 bit
// patterns round-trip), integer parsing with overflow, UTF-8 decoding of invalid sequences,
// split/lines edge cases, trim, replace. Run from the repo root (cargo runs it on both backends):
//   timeout 120 j3c run --opt 2 j3c/stdlib/tests/text_utils_test.j3

module text_utils_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.option.Option;
use j3.sys.panic;
use j3.text;
use j3.text.{ Text, runes };

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

/// The bits `parseF64(s)` gives, or 1 for None (never a result here: 1 is a subnormal printed `5e-324`).
fn parsedBits(s: string): u64 {
    match text.parseF64(s) {
        Option.Some(v) { return text.f64Bits(v); }
        Option.None { return 1; }
    }
}

fn printed(t: &Text, bits: u64): string {
    t.clear();
    t.pushF64(text.f64FromBits(bits));
    return t.str();
}

fn intIs(s: string, base: int, want: int): bool {
    match text.parseInt(s, base) {
        Option.Some(v) { return v == want; }
        Option.None { return false; }
    }
}

fn intNone(s: string, base: int): bool {
    match text.parseInt(s, base) {
        Option.Some(v) { return false; }
        Option.None { return true; }
    }
}

fn u64Is(s: string, base: int, want: u64): bool {
    match text.parseU64(s, base) {
        Option.Some(v) { return v == want; }
        Option.None { return false; }
    }
}

fn u64None(s: string): bool {
    match text.parseU64(s, 10) {
        Option.Some(v) { return false; }
        Option.None { return true; }
    }
}

/// The code points of `s` and their byte lengths, as "cp/len cp/len".
fn decoded(t: &Text, s: string): string {
    t.clear();
    let i = 0;
    while i < s.len {
        let (cp, n) = text.decodeRune(s, i);
        if i > 0 { t.push(' '); }
        t.pushHex(u64(cp));
        t.push('/');
        t.pushInt(n);
        i += n;
    }
    return t.str();
}

/// The pieces of `split(s, sep)` joined with `|`.
fn pieces(t: &Text, s: string, sep: string): string {
    t.clear();
    let first = true;
    for part in text.split(s, sep) {
        if !first { t.push('|'); }
        first = false;
        t.pushStr(part);
    }
    return t.str();
}

fn lineList(t: &Text, s: string): string {
    t.clear();
    for line in text.lines(s) {
        t.push('[');
        t.pushStr(line);
        t.push(']');
    }
    return t.str();
}

fn floats(t: &Text) {
    // fixed outputs: shortest digits, `%g` layout
    let cases: [15]u64 = [
        0x3FB999999999999A, 0x3FD5555555555555, 0x0000000000000001, 0x7FEFFFFFFFFFFFFF,
        0x0010000000000000, 0x000FFFFFFFFFFFFF, 0x0000000000000000,
        0x7FF0000000000000, 0x4340000000000000, 0x3F1A36E2EB1C432D, 0x4415AF1D78B58C40,
        0x4330000000000000, 0x3FF0000000000001, 0x44B52D02C7E14AF6, 0x3EB0C6F7A0B5ED8D,
    ];
    let want: [15]string = [
        "0.1", "0.3333333333333333", "5e-324", "1.7976931348623157e+308",
        "2.2250738585072014e-308", "2.225073858507201e-308", "0",
        "inf", "9007199254740992", "0.0001", "1e+20",
        "4503599627370496", "1.0000000000000002", "1e+23", "1e-06",
    ];
    for i in 0..cases.len {
        ok(printed(t, cases[i]) == want[i], `prints {want[i]}`);
        ok(parsedBits(want[i]) == cases[i], `parses {want[i]}`);
    }
    ok(printed(t, 0x7FF8000000000000) == "nan", "nan prints");
    let sign = u64(1) << 63;
    ok(printed(t, sign | 0x7FF0000000000000) == "-inf", "-inf prints");
    ok(printed(t, sign) == "-0" && parsedBits("-0") == sign, "-0");

    // every power-of-two boundary (the narrow gap below) and its neighbours
    for e in 1..2047 {
        let b = u64(e) << 52;
        ok(parsedBits(printed(t, b)) == b, "binade start round-trips");
        ok(parsedBits(printed(t, b - 1)) == b - 1, "binade end round-trips");
    }

    // 1M random bit patterns: print, parse, same bits
    let s: u64 = 0x2545F4914F6CDD1D;
    for i in 0..1000000 {
        s = s ^ (s << 13);
        s = s ^ (s >> 7);
        s = s ^ (s << 17);
        if ((s >> 52) & 0x7FF) == 0x7FF {
            continue;
        }
        if parsedBits(printed(t, s)) != s {
            t.pushStr(" did not round-trip");
            ok(false, t.str());
        }
    }

    // f32: shortest for the f32, and parse + narrow gives it back
    t.clear();
    t.pushF32(f32(0.1));
    ok(t.str() == "0.1", "f32 0.1");
    t.clear();
    t.pushF32(text.f32FromBits(1));
    ok(t.str() == "1e-45", "f32 smallest");
    t.clear();
    t.pushF32(text.f32FromBits(0x7F7FFFFF));
    ok(t.str() == "3.4028235e+38", "f32 max");
    let r: u32 = 0x9E3779B9;
    for i in 0..200000 {
        r = r ^ (r << 13);
        r = r ^ (r >> 17);
        r = r ^ (r << 5);
        if ((r >> 23) & 0xFF) == 0xFF { continue; }
        t.clear();
        t.pushF32(text.f32FromBits(r));
        let back = text.f32Bits(f32(text.f64FromBits(parsedBits(t.str()))));
        ok(back == r, "f32 round-trips");
    }

    // parse: exactness beyond 19 digits, ties, overflow, underflow, grammar
    ok(parsedBits("9007199254740993") == 0x4340000000000000, "tie to even");
    ok(parsedBits("9007199254740993.000000000000000000001") == 0x4340000000000001, "past the tie");
    ok(parsedBits("2.4703282292062327e-324") == 0, "below half the smallest subnormal");
    ok(parsedBits("2.4703282292062328e-324") == 1, "above half the smallest subnormal");
    ok(parsedBits("1e400") == 0x7FF0000000000000, "overflow is inf");
    ok(parsedBits("-1e-400") == u64(1) << 63, "underflow is -0");
    ok(parsedBits(".5") == 0x3FE0000000000000 && parsedBits("5.") == 0x4014000000000000, "bare dot");
    ok(parsedBits("+1E+2") == 0x4059000000000000, "signs and E");
    ok(parsedBits("-Infinity") == ((u64(1) << 63) | 0x7FF0000000000000) && parsedBits("NaN") == 0x7FF8000000000000, "words");
    let bad: [12]string = ["", "+", "-", ".", "e5", "1e", "1e+", "1.2.3", " 1", "1 ", "0x10", "1_0"];
    for i in 0..bad.len {
        ok(parsedBits(bad[i]) == 1, `rejects "{bad[i]}"`);
    }
}

fn ints() {
    ok(intIs("0", 10, 0) && intIs("-42", 10, -42) && intIs("+7", 10, 7), "small ints");
    ok(intIs("9223372036854775807", 10, 9223372036854775807), "i64 max");
    ok(intIs("-9223372036854775808", 10, -9223372036854775807 - 1), "i64 min");
    ok(intNone("9223372036854775808", 10) && intNone("-9223372036854775809", 10), "i64 overflow");
    ok(intNone("99999999999999999999999", 10), "far overflow");
    ok(intIs("ff", 16, 255) && intIs("-FF", 16, -255) && intIs("z", 36, 35) && intIs("1010", 2, 10), "bases");
    ok(intNone("", 10) && intNone("-", 10) && intNone("+", 10), "empty and lone sign");
    ok(intNone("0x10", 16) && intNone("12a", 10) && intNone("2", 2) && intNone(" 1", 10) && intNone("1_000", 10), "bad digits");
    ok(u64Is("18446744073709551615", 10, ~u64(0)), "u64 max");
    ok(u64None("18446744073709551616") && u64None("-1") && u64None("+1") && u64None(""), "u64 rejects");
    ok(u64Is("ffffffffffffffff", 16, ~u64(0)), "u64 hex");
}

fn utf8(t: &Text, a: &Arena) {
    ok(decoded(t, "aé€😀") == "61/1 e9/2 20ac/3 1f600/4", "valid sequences");
    let cases: [12]string = [
        raw(a, "C0 AF"), // overlong '/'
        raw(a, "E0 80 AF"), // overlong 3-byte
        raw(a, "F0 80 80 AF"), // overlong 4-byte
        raw(a, "ED A0 80"), // surrogate U+D800
        raw(a, "F4 90 80 80"), // U+110000
        raw(a, "F5 80 80 80"), // lead byte past F4
        raw(a, "80"), // lone continuation
        raw(a, "E2 82"), // cut off at the end
        raw(a, "E2 28 A1"), // bad continuation
        raw(a, "FF"),
        raw(a, "C2"),
        raw(a, "F0 9F 98"),
    ];
    let want: [12]string = [
        "fffd/1 fffd/1", "fffd/1 fffd/1 fffd/1", "fffd/1 fffd/1 fffd/1 fffd/1", "fffd/1 fffd/1 fffd/1",
        "fffd/1 fffd/1 fffd/1 fffd/1", "fffd/1 fffd/1 fffd/1 fffd/1", "fffd/1", "fffd/1 fffd/1",
        "fffd/1 28/1 fffd/1", "fffd/1", "fffd/1", "fffd/1 fffd/1 fffd/1",
    ];
    for i in 0..cases.len {
        ok(decoded(t, cases[i]) == want[i], `invalid case {i}`);
        ok(!text.isValidUtf8(cases[i]), `invalid case {i} is invalid`);
    }
    ok(text.isValidUtf8("") && text.isValidUtf8(raw(a, "61 C3 A9 E2 82 AC F0 9F 98 80 EF BF BD")), "valid strings");
    ok(text.isValidUtf8(raw(a, "ED 9F BF EE 80 80 F4 8F BF BF")), "edges U+D7FF U+E000 U+10FFFF");
    t.clear();
    text.encodeRune(t, 0x10FFFF);
    text.encodeRune(t, 0xD800);
    ok(t.str() == raw(a, "F4 8F BF BF EF BF BD"), "encodeRune");
    let r = raw(a, "61 E2 82 AC FF 62").runes();
    let n = 0;
    let sum: u32 = 0;
    let ats = 0;
    for cp in &r {
        n += 1;
        sum += cp;
        ats += r.at;
    }
    ok(n == 4 && sum == 0x61 + 0x20AC + 0xFFFD + 0x62 && ats == 0 + 1 + 4 + 5, "runes");
}

/// The bytes written as hex pairs ("C0 AF"), as a string on `a`.
fn raw(a: &Arena, hex: string): string {
    let t = Text.new(a);
    for part in text.split(hex, " ") {
        match text.parseInt(part, 16) {
            Option.Some(v) { t.push(u8(v)); }
            Option.None { panic("raw: bad hex"); }
        }
    }
    return t.str();
}

fn strs(t: &Text) {
    ok(pieces(t, "a,b,c", ",") == "a|b|c", "split");
    ok(pieces(t, "", ",") == "", "split empty gives one empty piece");
    ok(pieces(t, ",a,", ",") == "|a|", "split leading and trailing");
    ok(pieces(t, "a,,b", ",") == "a||b", "split adjacent");
    ok(pieces(t, "a::b::", "::") == "a|b|", "split long sep");
    ok(pieces(t, "abc", "abcd") == "abc", "split sep longer than s");
    let count = 0;
    for _p in text.split("", ",") { count += 1; }
    ok(count == 1, "split empty count");
    ok(lineList(t, "a\nb\n") == "[a][b]" && lineList(t, "a\r\nb") == "[a][b]", "lines");
    ok(lineList(t, "") == "" && lineList(t, "\n") == "[]" && lineList(t, "\n\nx") == "[][][x]", "lines edges");
    ok(text.startsWith("hello", "he") && text.startsWith("x", "") && !text.startsWith("h", "he"), "startsWith");
    ok(text.endsWith("hello", "lo") && text.endsWith("", "") && !text.endsWith("o", "lo"), "endsWith");
    ok(text.trim(" \t a b \r\n") == "a b" && text.trim("   ") == "" && text.trimStart("  x ") == "x " && text.trimEnd(" x  ") == " x", "trim");
    ok(text.lastIndexOf("abcabc", "bc") == 4 && text.lastIndexOf("abc", "x") == -1 && text.lastIndexOf("abc", "") == 3, "lastIndexOf");
    t.clear();
    ok(text.replace(t, "a-b--c", "-", "+") == "a+b++c", "replace");
    ok(text.replace(t, "aaa", "aa", "b") == "ba", "replace no overlap");
    ok(text.replace(t, "abc", "", "x") == "abc", "replace empty old");
    ok(t.str() == "a+b++cbaabc", "replace appends");
}

fn main() {
    let a = Arena.create(1024 * 1024);
    let t = Text.new(&a);
    ints();
    utf8(&t, &a);
    strs(&t);
    floats(&t);
    printLn("text_utils_test ok");
}
