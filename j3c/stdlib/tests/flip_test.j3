// Tests for `animate:flip` (Dom.flip, stepFlips): a keyed row that lands somewhere else paints from its old place and
// glides there; offset at t=0 / mid (eased) / end, an interrupted flight, hit testing, a removed row, a resize, idle frames.
// Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/flip_test.j3 --headless

module flip_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.ui.anim;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.testkit;

#[singleton]
let CLICKED: int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, msg: string) {
    if a - b > 0.01 || b - a > 0.01 {
        printLn(`FAIL: {msg}: {a} vs {b}`);
        panic(msg);
    }
}

const SHEET: string = ".list { display: flex; flex-wrap: wrap; } .row { width: 100px; height: 20px; }";

/// Rows `ord[0..n]` (keyed by `uids`), each with `animate:flip={ms}` and easing `ease` (-1: no flip); `vw` wide.
fn frame(d: &Dom, ord: []int, n: int, uids: []int, rows: []int, ms: f32, ease: int, vw: f32) {
    d.beginFrame(Vec2 { x: vw, y: 400.0 });
    let l = d.open(0, d.tag("div"), 1);
    d.cls(l, "list");
    CLICKED = -1;
    for i in 0..n {
        let r = ord[i];
        if uids[r] < 0 {
            uids[r] = d.groupNew(-1);
        }
        d.keyBegin(uids[r]);
        let e = d.open(0, d.tag("div"), 1);
        d.cls(e, "row");
        if ease >= 0 {
            d.flip(e, ms, ease);
        }
        rows[r] = e;
        if d.clicked(e) {
            CLICKED = r;
        }
        d.close();
        d.keyEnd();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn run(d: &Dom, ord: []int, n: int, uids: []int, rows: []int, ms: f32, ease: int, vw: f32, frames: int) {
    for i in 0..frames {
        d.simInput(-5.0, -5.0, false, 0.0);
        frame(d, ord, n, uids, rows, ms, ease, vw);
    }
}

fn click(d: &Dom, ord: []int, n: int, uids: []int, rows: []int, x: f32, y: f32): int {
    let hit = -1;
    d.simInput(x, y, false, 0.0);
    frame(d, ord, n, uids, rows, 200.0, 1, 220.0);
    d.simInput(x, y, true, 0.0);
    frame(d, ord, n, uids, rows, 200.0, 1, 220.0);
    d.simInput(x, y, false, 0.0);
    frame(d, ord, n, uids, rows, 200.0, 1, 220.0);
    return CLICKED;
}

#[singleton]
let DROP_TO: int;

/// Like `frame`, but every row is a draggable source and drop target (its index is the drag id).
fn dframe(d: &Dom, ord: []int, n: int, uids: []int, rows: []int) {
    d.beginFrame(Vec2 { x: 220.0, y: 400.0 });
    inputs.begin(d);
    let l = d.open(0, d.tag("div"), 1);
    d.cls(l, "list");
    DROP_TO = -1;
    for i in 0..n {
        let r = ord[i];
        if uids[r] < 0 {
            uids[r] = d.groupNew(-1);
        }
        d.keyBegin(uids[r]);
        let e = d.open(0, d.tag("div"), 1);
        d.cls(e, "row");
        d.flip(e, 200.0, 1);
        d.attrDraggable(e, true);
        d.attrDragId(e, r);
        d.attrDragTarget(e, 8);
        rows[r] = e;
        if d.dropAt(e) {
            DROP_TO = r;
            DROP_FROM = d.dragIdOf();
        }
        d.close();
        d.keyEnd();
    }
    d.close();
    d.layout();
    d.endFrame();
}

#[singleton]
let DROP_FROM: int;

/// Dragging a flipping row, and dropping it (which reorders keyed rows), flips the rows that moved.
fn dragFlip(mem: &Arena, css: &Css) {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    let ord = mem.alloc::<int>(4);
    let uids = mem.alloc::<int>(4);
    let rows = mem.alloc::<int>(4);
    for i in 0..4 {
        ord[i] = i;
        uids[i] = -1;
        rows[i] = -1;
    }
    d.simInput(-5.0, -5.0, false, 0.0);
    dframe(&d, ord, 4, uids, rows);
    dframe(&d, ord, 4, uids, rows);
    let fr = d.frame + 1;
    for k in 0..9 {
        testkit.drag(&d, fr + k, fr, rows[0], rows[3]);
        dframe(&d, ord, 4, uids, rows);
        if DROP_TO >= 0 {
            break;
        }
    }
    ok(DROP_TO == 3 && DROP_FROM == 0, "the drop reached row 3 carrying row 0's drag id");
    ok(d.flipLive == 0, "dragging alone starts no flight");
    // the drop reorders: 0 goes after 3
    ord[0] = 1;
    ord[1] = 2;
    ord[2] = 3;
    ord[3] = 0;
    d.simInput(-5.0, -5.0, false, 0.0);
    dframe(&d, ord, 4, uids, rows);
    ok(d.flipLive == 4, "the drop's reorder flips every row that moved");
    near(d.flipDx(rows[0]), -100.0, "dropped row starts from its old x");
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "a.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    let ord = mem.alloc::<int>(8);
    let uids = mem.alloc::<int>(8);
    let rows = mem.alloc::<int>(8);
    for i in 0..8 {
        ord[i] = i;
        uids[i] = -1;
        rows[i] = -1;
    }
    // rows 0,1 on the first line (x 0 and 100), rows 2,3 on the second; linear, 200 ms
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 3);
    ok(d.flips.len == 4 && d.flipLive == 0, "four listed, none flying");
    for i in 0..4 {
        near(d.flipDx(rows[i]), 0.0, "no offset before any move");
    }
    ok(d.nodes.items[rows[0]].x == 0.0 && d.nodes.items[rows[1]].x == 100.0, "layout as expected");

    // swap rows 0 and 1: the layout jumps at once, the paint offset starts at old - new
    ord[0] = 1;
    ord[1] = 0;
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 1);
    let r0 = &d.nodes.items[rows[0]];
    let r1 = &d.nodes.items[rows[1]];
    let f0 = &d.flips.items[r0.flip];
    let f1 = &d.flips.items[r1.flip];
    ok(r0.x == 100.0 && r1.x == 0.0, "layout moved at once");
    near(f0.ox, -100.0, "t=0: row 0 paints at its old x");
    near(f1.ox, 100.0, "t=0: row 1 paints at its old x");
    near(f0.oy, 0.0, "no y offset");
    near(d.flipDx(rows[2]), 0.0, "rows that stayed do not move");
    ok(d.flipLive == 2, "two flights");

    // reduced motion turned on mid flight: both flights end in the same call
    d.setReducedMotion(true);
    ok(d.flipLive == 0, "turning it on ends the flights");
    near(d.flipDx(rows[0]), 0.0, "offset 0 at once");
    d.setReducedMotion(false);
    ord[0] = 0;
    ord[1] = 1;
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 20);
    ord[0] = 1;
    ord[1] = 0;
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 1);
    ok(d.flipLive == 2, "flips work again once it is off");

    // reduced motion: the same swap moves layout and flips nothing
    d.setReducedMotion(true);
    ord[0] = 0;
    ord[1] = 1;
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 2);
    ord[0] = 1;
    ord[1] = 0;
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 1);
    ok(r0.x == 100.0 && d.flipLive == 0, "reduced motion: moved, no flight");
    near(d.flipDx(rows[0]), 0.0, "reduced motion: offset 0");
    d.setReducedMotion(false);
    ord[0] = 0;
    ord[1] = 1;
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 20);
    ord[0] = 1;
    ord[1] = 0;
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 1);

    // mid flight, linear: a flight only repaints, so no layout or restyle runs while it glides
    let laidF = d.laid;
    let restF = d.restyled;
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 6);
    ok(d.laid == laidF && d.restyled == restF, "mid flight frames neither lay out nor restyle");
    let t = (d.now - f0.t0) / 200.0;
    ok(t > 0.3 && t < 0.7, "mid flight");
    near(f0.ox, -100.0 * (1.0 - t), "linear mid: row 0 offset");
    near(f1.ox, 100.0 * (1.0 - t), "linear mid: row 1 offset");
    // hit testing follows the paint: at x=170 layout says row 0 (100..200), the glide has it left of 150
    ok(click(&d, ord, 4, uids, rows, 170.0, 10.0) != 0, "mid flight: the click does not land on row 0's layout slot");

    // interrupt: swap back mid flight; the visual position must not jump
    let vis0 = r0.x + f0.ox;
    let vis1 = r1.x + f1.ox;
    ord[0] = 0;
    ord[1] = 1;
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d, ord, 4, uids, rows, 200.0, 1, 220.0);
    ok(r0.x == 0.0 && r1.x == 100.0, "swapped back");
    ok(f0.ox > 0.0, "interrupt: row 0 keeps part of the old flight (offset is now to the right)");
    near(r0.x + f0.ox, vis0, "interrupt: row 0 starts from where it was drawn");
    near(r1.x + f1.ox, vis1, "interrupt: row 1 starts from where it was drawn");

    // end: everything settles at 0 and the hit goes to the layout slot
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 20);
    ok(d.flipLive == 0, "all flights ended");
    for i in 0..4 {
        near(d.flipDx(rows[i]), 0.0, "end offset x");
        near(d.flipDy(rows[i]), 0.0, "end offset y");
    }
    ok(click(&d, ord, 4, uids, rows, 170.0, 10.0) == 1, "after the flight row 1 holds its slot");

    // an easing curve: ease-out (preset 3) is ahead of linear mid flight
    ord[0] = 1;
    ord[1] = 0;
    run(&d, ord, 4, uids, rows, 200.0, 3, 220.0, 1);
    run(&d, ord, 4, uids, rows, 200.0, 3, 220.0, 5);
    let e = anim.preset(anim.PRESET_OUT);
    let t2 = (d.now - f0.t0) / 200.0;
    near(f0.ox, -100.0 * (1.0 - anim.ease(&e, t2)), "ease-out mid: row 0 offset");
    ok(f0.ox > -100.0 * (1.0 - t2), "ease-out is ahead of linear");
    run(&d, ord, 4, uids, rows, 200.0, 3, 220.0, 20);
    ok(d.flipLive == 0, "eased flights ended");

    // a resize reflows the rows (one per line) but does not flip them
    run(&d, ord, 4, uids, rows, 200.0, 1, 120.0, 1);
    ok(d.nodes.items[rows[0]].y == 20.0 || d.nodes.items[rows[0]].y == 0.0, "resized layout");
    ok(d.flipLive == 0, "resize starts no flight");
    near(d.flipDy(rows[3]), 0.0, "resize: no offset");
    run(&d, ord, 4, uids, rows, 200.0, 1, 220.0, 2);
    ok(d.flipLive == 0, "resize back starts no flight either");

    // a removed row frees its state: swap-remove keeps the others listed, a recycled node starts clean
    let before = d.flips.len;
    d.groupFree(uids[3]);
    uids[3] = -1;
    run(&d, ord, 3, uids, rows, 200.0, 1, 220.0, 3);
    ok(d.flips.len == before - 1, "removed row leaves the flip list");
    for i in 0..d.flips.len {
        ok(d.nodes.items[d.flips.items[i].node].flip == i, "flip index stays in step");
    }
    ord[2] = 4;
    run(&d, ord, 3, uids, rows, 200.0, -1, 220.0, 3);
    let reuse = &d.nodes.items[rows[4]];
    ok(reuse.flip == -1, "a recycled node carries no flip state");

    dragFlip(&mem, &css);

    // idle: no layout, restyle or allocation
    run(&d, ord, 3, uids, rows, 200.0, 1, 220.0, 5);
    let used0 = mem.used;
    let laid0 = d.laid;
    let re0 = d.restyled;
    run(&d, ord, 3, uids, rows, 200.0, 1, 220.0, 300);
    ok(mem.used == used0 && d.laid == laid0 && d.restyled == re0, "300 idle frames: no allocation, layout or restyle");
    printLn("flip_test ok");
}
