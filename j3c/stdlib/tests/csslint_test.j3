// Tests for j3.ui.csslint. Run: j3c run j3c/stdlib/tests/csslint_test.j3
// Parses sheets with `lintOn`, hand-builds the element facts the compiler would write, and checks the rule names reported.

module csslint_test;

use j3.io.printLn;
use j3.memory.{ Arena, List };
use j3.sys.panic;
use j3.text.{ contains, same };
use j3.ui.css.{ Css, Warning };
use j3.ui.csslint.{ ElFact, lint };
use j3.ui.cssparse.parse;

#[singleton]
let CHECKS: int = 0;

fn ok(c: bool, what: string) {
    CHECKS += 1;
    if !c {
        panic(`FAILED: {what}`);
    }
}

fn el(mem: &Arena, css: &Css, els: &List<ElFact>, tag: string, ws: []string) {
    let words = List<string>.new(mem);
    for i in 0..ws.len {
        words.push(ws[i]);
    }
    els.push(ElFact { scope: 1, tag: if same(tag, "*") { -1 } else { css.intern(tag) }, words: words });
}

fn run(mem: &Arena, src: string, build: fn(&Arena, &Css, &List<ElFact>)): List<Warning> {
    let css = Css.new(mem);
    css.lintOn = true;
    parse(&css, src, "t.css", 1);
    let els = List<ElFact>.new(mem);
    build(mem, &css, &els);
    let out = List<Warning>.new(mem);
    lint(&css, &els, &out);
    return out;
}

fn count(out: &List<Warning>, rule: string): int {
    let n = 0;
    for i in 0..out.len {
        if contains(out.items[i].msg, rule) {
            n += 1;
        }
    }
    return n;
}

fn facts(mem: &Arena, css: &Css, els: &List<ElFact>) {
    let a: [2]string = ["card", "r*"];
    el(mem, css, els, "div", a[0..2]);
    let b: [1]string = ["*"];
    el(mem, css, els, "span", b[0..1]);
}

fn main() {
    let mem = Arena.create(16 * 1024 * 1024);
    let out = run(&mem, ".card { color: red; color: blue; } .r7 { top: 1px; } div.nope { color: red; } p { color: red; } .card:hover { color: red; }", facts);
    // span carries a wildcard class, so `.r7` and `div.nope` (a div) are judged on the div: `.r7` matches r*, `div.nope` cannot
    ok(count(&out, "[duplicate-decl]") == 1, "duplicate-decl");
    ok(count(&out, "[never-matches]") == 2, "never-matches: div.nope and p");
    ok(count(&out, "[offset-without-position]") == 1, "offset-without-position");
    out = run(&mem, ".card { position: absolute; top: 1px; text-overflow: ellipsis; overflow: hidden; } .card { left: 0 }", facts);
    ok(out.len == 0, "no findings when position and overflow are set");
    out = run(&mem, ".card { background: var(--a); color: var(--b, red); } :root { --b: 1 }", facts);
    ok(count(&out, "[undefined-var]") == 1, "undefined-var only without fallback");
    out = run(&mem, "div:has(.x) { color: red; } .card:has(.x) .y { color: red; }", facts);
    ok(count(&out, "[broad-has]") == 1, "broad-has");
    ok(count(&out, "[has-before-combinator]") == 1, "has-before-combinator");
    printLn(`csslint_test: {CHECKS} checks passed`);
}
