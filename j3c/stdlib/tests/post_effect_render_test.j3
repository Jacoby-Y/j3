// SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy J3_STDLIB=$PWD/j3c/stdlib timeout 60 j3c run j3c/stdlib/tests/post_effect_render_test.j3
module post_effect_render_test;
use lib "GL" as gl {
    fn glGetError(): u32;
}
use j3.game;
use j3.game.Color;
use j3.gfx.paint;
use j3.gfx.paint.Effects;
use j3.gfx.canvas.{
    Canvas, Mode
};
use j3.math.Vec2;
use j3.memory.Arena;
use j3.io.printLn;
use j3.result.Result;
use j3.sys.panic;
fn ok(b: bool, msg: string) {
    if !b {
        panic(msg);
    }
}
fn near(v: int, w: int, msg: string) {
    let d = v -w;
    if d < 0 {
        d = 0 -d;
    }
    if d > 3 {
        printLn(`{msg}: {v} vs {w}`);
        panic(msg);
    }
}
fn rect(x: f32, y: f32, w: f32, h: f32, r: u8, g: u8, b: u8) {
    paint.rect(Vec2 {
        x: x, y: y
    }
    , Vec2 {
        x: w, y: h
    }
    , Color {
        r: r, g: g, b: b, a: 255
    }
    );
}
fn pixel(p:[] u8, x: int, y: int, c: int): int {
    return int(p[(y *480 + x) *4 + c]);
}
fn read(p:[] u8) {
    ok(game.readWindow(p), "read frame");
    let e = gl.glGetError();
    if e != 0 {
        printLn(`GL error {e}`);
        panic("effect GL error");
    }
}
fn end(f: Effects) {
    paint.endLayer(Vec2 {
        x: 0, y: 0
    }
    , Vec2 {
        x: 480, y: 320
    }
    , f);
}
fn main() {
    let mem = Arena.create(16 *1024 *1024);
    let p = mem.alloc::< u8 >(480 *320 *4);
    let reference = mem.alloc::< u8 >(480 *320 *4);
    game.initGlHidden("post effect checks", 480, 320);

    // A neutral isolated group must match overlapping translucent draws into an opaque destination.
    game.clearTo(Color {
        r: 20, g: 40, b: 60, a: 255
    }
    );
    paint.rect(Vec2 {
        x: 20, y: 20
    }
    , Vec2 {
        x: 140, y: 140
    }
    , Color {
        r: 255, g: 20, b: 40, a: 128
    }
    );
    paint.rect(Vec2 {
        x: 80, y: 60
    }
    , Vec2 {
        x: 140, y: 140
    }
    , Color {
        r: 30, g: 40, b: 255, a: 128
    }
    );
    read(reference);
    game.clearTo(Color {
        r: 20, g: 40, b: 60, a: 255
    }
    );
    paint.beginLayer();
    paint.rect(Vec2 {
        x: 20, y: 20
    }
    , Vec2 {
        x: 140, y: 140
    }
    , Color {
        r: 255, g: 20, b: 40, a: 128
    }
    );
    paint.rect(Vec2 {
        x: 80, y: 60
    }
    , Vec2 {
        x: 140, y: 140
    }
    , Color {
        r: 30, g: 40, b: 255, a: 128
    }
    );
    end(Effects {
    }
    );
    read(p);
    for i in 0.. p.len {
        near(int(p[i]), int(reference[i]), "neutral transparent group equivalence");
    }
    game.clearTo(Color {
        r: 255, g: 255, b: 255, a: 255
    }
    );
    paint.beginLayer();
    rect(100, 80, 100, 100, 255, 0, 0);
    end(Effects {
        blur: 8
    }
    );
    read(p);
    near(pixel(p, 95, 120, 0), 255, "transparent blur retains saturated edge on white");
    ok(pixel(p, 95, 120, 1) > 100 && pixel(p, 95, 120, 1) < 250, "blur spreads smoothly beyond content");
    game.clearTo(Color {
        r: 0, g: 0, b: 0, a: 255
    }
    );
    paint.beginLayer();
    rect(100, 80, 30, 30, 255, 255, 255);
    end(Effects {
        bloom: 1
    }
    );
    read(p);
    ok(pixel(p, 90, 95, 0) > 0, "bloom reaches outside source");
    game.clearTo(Color {
        r: 128, g: 64, b: 192, a: 255
    }
    );
    paint.beginLayer();
    rect(20, 20, 200, 200, 128, 128, 128);
    end(Effects {
        blend: 1
    }
    );
    read(p);
    near(pixel(p, 80, 80, 0), 64, "multiply red");
    near(pixel(p, 80, 80, 1), 32, "multiply green");
    near(pixel(p, 80, 80, 2), 96, "multiply blue");
    game.clearTo(Color {
        r: 0, g: 0, b: 0, a: 255
    }
    );
    paint.beginLayer();
    rect(0, 0, 480, 320, 255, 0, 0);
    end(Effects {
        grayscale: 1
    }
    );
    read(p);
    near(pixel(p, 80, 80, 0), pixel(p, 80, 80, 1), "grayscale red/green");
    near(pixel(p, 80, 80, 1), pixel(p, 80, 80, 2), "grayscale green/blue");
    paint.beginLayer();
    rect(0, 0, 480, 320, 128, 128, 128);
    end(Effects {
        grain: 0.5
    }
    );
    read(p);
    let lo = 255;
    let hi = 0;
    for i in 0.. 60 {
        let c = pixel(p, 50 + i, 80, 0);
        if c < lo {
            lo = c;
        }
        if c > hi {
            hi = c;
        }
    }
    ok(hi -lo > 50, "grain changes pixels");
    paint.beginLayer();
    rect(0, 0, 480, 320, 200, 200, 200);
    end(Effects {
        scanlines: 0.5
    }
    );
    read(p);
    ok(pixel(p, 80, 80, 0) != pixel(p, 80, 81, 0), "scanlines alternate rows");
    let sh = paint.shader("vec4 effect(vec2 uv,vec4 color){return vec4(0.0,1.0,0.0,color.a);}");
    ok(sh > 0, "custom shader compiles");
    paint.beginLayer();
    rect(20, 20, 200, 200, 255, 0, 0);
    end(Effects {
        shader: sh
    }
    );
    read(p);
    near(pixel(p, 80, 80, 1), 255, "custom shader applies");
    near(pixel(p, 80, 80, 0), 0, "custom shader red removed");
    let bad = paint.shader("vec4 effect(vec2 uv,vec4 c){return undefined_symbol;}");
    ok(bad == 0, "bad shader returns zero");
    paint.beginLayer();
    rect(20, 20, 200, 200, 255, 0, 0);
    end(Effects {
        shader: sh
    }
    );
    read(p);
    near(pixel(p, 80, 80, 1), 255, "failed shader leaves existing shader working");
    let target = paint.target(160, 100);
    paint.beginTarget(target);
    let activeSize = game.windowSize();
    ok(activeSize.x == 160, "target dimensions active");
    rect(0, 0, 160, 50, 255, 0, 0);
    rect(0, 50, 160, 50, 0, 255, 0);
    paint.beginLayer();
    rect(0, 40, 160, 20, 0, 0, 255);
    paint.endLayer(Vec2 {
        x: 0, y: 0
    }
    , Vec2 {
        x: 160, y: 100
    }
    , Effects {
        brightness: 1
    }
    );
    paint.endTarget();
    let parentSize = game.windowSize();
    ok(parentSize.x == 480, "target dimensions restored");
    game.clearTo(Color {
        r: 0, g: 0, b: 0, a: 255
    }
    );
    let tex = paint.targetTexture(target);
    paint.projectTexture(tex, Vec2 {
        x: 20, y: 20
    }
    , Vec2 {
        x: 160, y: 100
    }
    , 0, 0, 0);
    read(p);
    near(pixel(p, 80, 40, 0), 255, "target top orientation");
    near(pixel(p, 80, 100, 1), 255, "target bottom orientation");
    near(pixel(p, 80, 70, 2), 255, "layer inside small target");
    paint.projectTexture(tex, Vec2 {
        x: 260, y: 80
    }
    , Vec2 {
        x: 160, y: 160
    }
    , 20, 35, 300);
    read(p);
    ok(pixel(p, 340, 160, 2) > 100, "perspective plane preserves center content");

    // Cover remaining color branches and orthographic projection without invalid values/feedback.
    paint.beginLayer();
    rect(20, 180, 200, 100, 255, 100, 30);
    paint.endLayer(Vec2 {
        x: 20, y: 180
    }
    , Vec2 {
        x: 200, y: 100
    }
    , Effects {
        brightness: 1.1, contrast: 1.2, saturation: 0.8, sepia: 0.2, invert: 0.1, hue: 35, crt: 0.3, blend: 2, rotateY: 20
    }
    );
    read(p);
    let capture = Canvas.create(&mem, 480, 320, Mode.Pixel);
    for i in 0.. p.len {
        capture.pixels[i] = p[i];
    }
    match capture.savePng("/tmp/j3-post-features.png", &mem) {
        Result.Ok(_) {
        }
        Result.Err(_) {
            panic("save features");
        }
    }

    // GL state survives layer and projection passes, including the final paint composite.
    let vp = game.glProc("glViewport") as fn(i32, i32, i32, i32);
    vp(7, 9, 100, 80);
    let useProg = game.glProc("glUseProgram") as fn(u32);
    useProg(0);
    let active = game.glProc("glActiveTexture") as fn(u32);
    active(0x84C3);
    let blend = game.glProc("glBlendFuncSeparate") as fn(u32, u32, u32, u32);
    blend(1, 0, 0, 1);
    let mask = game.glProc("glColorMask") as fn(u8, u8, u8, u8);
    mask(1, 0, 1, 0);
    let en = game.glProc("glEnable") as fn(u32);
    en(0x0C11);
    paint.beginLayer();
    rect(20, 20, 100, 100, 255, 255, 255);
    end(Effects {
        blur: 4
    }
    );
    let gi = game.glProc("glGetIntegerv") as fn(u32, ptr);
    let v: i32 = 0;
    gi(0x8B8D, &v as ptr);
    ok(v == 0, "layer program restored");
    gi(0x84E0, &v as ptr);
    ok(v == 0x84C3, "layer active unit restored");
    gi(0x80C9, &v as ptr);
    ok(v == 1, "layer blend source restored");
    gi(0x80CB, &v as ptr);
    ok(v == 0, "layer alpha blend source restored");
    let values:[4] i32 =[0, 0, 0, 0];
    gi(0x0BA2, &values[0] as ptr);
    ok(values[0] == 7 && values[1] == 9 && values[2] == 100 && values[3] == 80, "layer viewport restored");
    gi(0x0C23, &values[0] as ptr);
    ok(values[0] == 1 && values[1] == 0 && values[2] == 1 && values[3] == 0, "layer color mask restored");
    mask(1, 1, 1, 1);
    let dis = game.glProc("glDisable") as fn(u32);
    dis(0x0C11);
    active(0x84C0);

    // Count all raw passes as well as the content and final composite draws.
    game.present();
    game.clearTo(Color {
        r: 0, g: 0, b: 0, a: 255
    }
    );
    paint.beginLayer();
    rect(20, 20, 100, 100, 255, 255, 255);
    end(Effects {
    }
    );
    game.present();
    let plainStats = game.lastFrameStats();
    ok(plainStats.draws == 3, "neutral group reports content, FX and composite draws");
    paint.beginLayer();
    rect(20, 20, 100, 100, 255, 255, 255);
    paint.endLayer(Vec2 {
        x: 20, y: 20
    }
    , Vec2 {
        x: 100, y: 100
    }
    , Effects {
        blur: 4, bloom: 1, shader: sh, rotateY: 10, perspective: 300
    }
    );
    game.present();
    let allStats = game.lastFrameStats();
    ok(allStats.draws == 10, "all effect passes counted in frame stats");
    paint.destroyShader(sh);
    paint.destroyTarget(target);
    game.destroy();
    mem.destroy();
    printLn("post_effect_render_test: passed (premultiplied blur, bloom, blend, filters, grain, scanlines, shader success/failure, target nesting, perspective, GL state, transparent equivalence, draw stats, teardown)");
}
