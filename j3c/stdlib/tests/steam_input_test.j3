// Tests for j3.steam Steam Input: absent no-ops, capacity checks, fake mode (pads, actions, held state, callbacks),
// the before-frame hook, name caches, and the struct layouts for both pack rules. The real by-value struct returns
// are proven against C stubs by hand (see the chunk report). Run from j3c/:
//   timeout 120 target/release/j3c run stdlib/tests/steam_input_test.j3
// Panics on the first failed check.

module steam_input_test;

use j3.io.printLn;
use j3.memory.Arena;
use j3.steam;
use j3.sys.panic;

#[singleton]
let CONN: u64;
#[singleton]
let CONN_N: int;
#[singleton]
let DISC: u64;
#[singleton]
let CFG_H: u64;
#[singleton]
let CFG_API: bool;
#[singleton]
let CFG_GP: bool;
#[singleton]
let SLOT_H: u64;
#[singleton]
let SLOT_OLD: i32;
#[singleton]
let SLOT_NEW: i32;
#[singleton]
let HOOKS: int;

fn ok(cond: bool, msg: string) {
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn onConn(h: u64) {
    CONN = h;
    CONN_N += 1;
}

fn onDisc(h: u64) {
    DISC = h;
}

fn onCfg(h: u64, api: bool, gp: bool) {
    CFG_H = h;
    CFG_API = api;
    CFG_GP = gp;
}

fn onSlot(h: u64, o: i32, n: i32) {
    SLOT_H = h;
    SLOT_OLD = o;
    SLOT_NEW = n;
}

fn hook() {
    HOOKS += 1;
}

fn absent(mem: &Arena) {
    let ids = mem.alloc::<u64>(16);
    ok(!steam.inputInit(true), "absent init");
    ok(steam.controllers(ids) == 0 && steam.inputType(u64(1)) == steam.INPUT_UNKNOWN, "absent controllers");
    ok(steam.actionSet("menu") == u64(0) && steam.digitalAction("jump") == u64(0) && steam.analogAction("move") == u64(0), "absent names");
    ok(!steam.digital(u64(1), u64(1)).state && !steam.analog(u64(1), u64(1)).active, "absent state");
    ok(steam.motion(u64(1)).qw == 0.0, "absent motion");
    ok(steam.glyphPng(1, steam.GLYPH_SMALL, u32(0)).len == 0 && steam.originName(1).len == 0, "absent strings");
    ok(!steam.showBindingPanel(u64(1)) && !steam.bindingRevision(u64(1)).ok, "absent binding");
    ok(steam.controllerForGamepad(i32(0)) == u64(0) && steam.gamepadForController(u64(1)) == i32(-1), "absent slots");
    steam.activateSet(steam.INPUT_ALL_CONTROLLERS, u64(1));
    steam.vibrate(u64(1), u16(1), u16(2));
    steam.led(u64(1), u8(1), u8(2), u8(3), steam.LED_SET);
    steam.inputFrame();
    steam.inputShutdown();
    HOOKS = 0;
    steam.onBeforeFrame(hook);
    steam.frame();
    ok(HOOKS == 0, "hooks do not run when Steam is absent");
}

fn capacity(mem: &Arena) {
    let small = mem.alloc::<u64>(15);
    let origins = mem.alloc::<i32>(7);
    let w0 = steam.warned();
    ok(steam.controllers(small) == 0 && steam.activeLayers(u64(1), small) == 0, "small slices refused");
    ok(steam.digitalOrigins(u64(1), u64(1), u64(1), origins) == 0 && steam.analogOrigins(u64(1), u64(1), u64(1), origins) == 0, "small origins refused");
    ok(steam.warned() == w0 + 4, "each refusal is logged once");
    steam.controllers(small);
    ok(steam.warned() == w0 + 4, "a repeated refusal is not logged again");
}

fn layouts() {
    for v in 0..2 {
        let large = v == 1;
        let c = "SteamInputConfigurationLoaded_t";
        ok(steam.layAt(c, steam.SIZE, large) == [32, 40][v], "config size");
        ok(steam.layAt(c, "appID", large) == 0 && steam.layAt(c, "deviceHandle", large) == [4, 8][v], "config handle");
        ok(steam.layAt(c, "mappingCreator", large) == [12, 16][v], "config creator");
        ok(steam.layAt(c, "majorRevision", large) == [20, 24][v] && steam.layAt(c, "minorRevision", large) == [24, 28][v], "config revision");
        ok(steam.layAt(c, "usesSteamInputAPI", large) == [28, 32][v] && steam.layAt(c, "usesGamepadAPI", large) == [29, 33][v], "config flags");
        let s = "SteamInputGamepadSlotChange_t";
        ok(steam.layAt(s, steam.SIZE, large) == [24, 32][v], "slot size");
        ok(steam.layAt(s, "deviceHandle", large) == [4, 8][v] && steam.layAt(s, "deviceType", large) == [12, 16][v], "slot handle and type");
        ok(steam.layAt(s, "oldGamepadSlot", large) == [16, 20][v] && steam.layAt(s, "newGamepadSlot", large) == [20, 24][v], "slot numbers");
        ok(steam.layAt("SteamInputDeviceConnected_t", "deviceHandle", large) == 0 && steam.layAt("SteamInputDeviceConnected_t", steam.SIZE, large) == 8, "connected");
        ok(steam.layAt("InputDigitalActionData_t", steam.SIZE, large) == 2 && steam.layAt("InputDigitalActionData_t", "bActive", large) == 1, "digital data");
        let a = "InputAnalogActionData_t";
        ok(steam.layAt(a, steam.SIZE, large) == 13 && steam.layAt(a, "x", large) == 4 && steam.layAt(a, "y", large) == 8 && steam.layAt(a, "bActive", large) == 12, "analog data");
        ok(steam.layAt("InputMotionData_t", steam.SIZE, large) == 40 && steam.layAt("InputMotionData_t", "rotVelZ", large) == 36, "motion data");
    }
}

fn fakeCfg(): []u8 {
    let c = "SteamInputConfigurationLoaded_t";
    let d = Arena.create(256).alloc::<u8>(steam.lay(c, steam.SIZE));
    for i in 0..d.len {
        d[i] = u8(0);
    }
    steam.wrU64(d.ptr as ptr, steam.lay(c, "deviceHandle"), u64(2));
    steam.wrBool(d.ptr as ptr, steam.lay(c, "usesSteamInputAPI"), true);
    steam.wrBool(d.ptr as ptr, steam.lay(c, "usesGamepadAPI"), false);
    return d;
}

fn fakeSlot(): []u8 {
    let c = "SteamInputGamepadSlotChange_t";
    let d = Arena.create(256).alloc::<u8>(steam.lay(c, steam.SIZE));
    for i in 0..d.len {
        d[i] = u8(0);
    }
    steam.wrU64(d.ptr as ptr, steam.lay(c, "deviceHandle"), u64(1));
    steam.wrI32(d.ptr as ptr, steam.lay(c, "oldGamepadSlot"), i32(0));
    steam.wrI32(d.ptr as ptr, steam.lay(c, "newGamepadSlot"), i32(3));
    return d;
}

fn fakeMode(mem: &Arena) {
    ok(steam.initFake(u32(480)) == steam.Status.Fake, "fake init");
    steam.onPadConnected(onConn);
    steam.onPadDisconnected(onDisc);
    steam.onPadConfig(onCfg);
    steam.onPadSlot(onSlot);
    ok(steam.inputType(steam.FAKE_PAD_A) == steam.INPUT_UNKNOWN, "no pads before inputInit");
    ok(steam.inputInit(true) && steam.inputInit(true), "fake input init");
    steam.frame();
    ok(CONN_N == 2 && CONN == steam.FAKE_PAD_B, "two connect callbacks");
    ok(HOOKS == 1, "the before-frame hook ran for the frame");
    steam.frame();
    ok(HOOKS == 2, "and again");
    let ids = mem.alloc::<u64>(16);
    ok(steam.controllers(ids) == 2 && ids[0] == steam.FAKE_PAD_A && ids[1] == steam.FAKE_PAD_B, "two fake pads");
    ok(steam.inputType(ids[0]) == steam.INPUT_XBOX_ONE && steam.inputType(ids[1]) == steam.INPUT_STEAM_DECK, "pad types");
    ok(steam.controllerForGamepad(i32(1)) == ids[1] && steam.gamepadForController(ids[0]) == i32(0) && steam.gamepadForController(u64(9)) == i32(-1), "slots");
    ok(steam.showBindingPanel(ids[0]) && !steam.showBindingPanel(u64(9)), "binding panel");
    ok(steam.bindingRevision(ids[0]).ok && !steam.bindingRevision(u64(9)).ok, "binding revision");
    // names: stable handles, no growth on repeats, distinct per name
    let menu = steam.actionSet("menu");
    let game = steam.actionSet("game");
    ok(menu != u64(0) && game != u64(0) && menu != game, "set handles differ");
    let w0 = steam.warned();
    for i in 0..2000 {
        ok(steam.actionSet("menu") == menu && steam.digitalAction("jump") == steam.digitalAction("jump"), "cached names are stable");
    }
    ok(steam.warned() == w0, "no warnings from cached names");
    let jump = steam.digitalAction("jump");
    let fire = steam.digitalAction("fire");
    let move = steam.analogAction("move");
    ok(jump != fire && jump != u64(0) && move != u64(0), "action handles");
    ok(steam.digitalAction("") == u64(0), "empty name is 0");
    for i in 0..100 {
        steam.digitalAction(`a{i}`);
    }
    ok(steam.digitalAction("a57") != u64(0) && steam.digitalAction("jump") == jump && steam.digitalAction("a99") != steam.digitalAction("a98"), "table grows and keeps old names");
    // sets
    steam.activateSet(ids[0], menu);
    ok(steam.currentSet(ids[0]) == menu && steam.currentSet(ids[1]) == u64(0), "current set");
    steam.activateSet(steam.INPUT_ALL_CONTROLLERS, game);
    ok(steam.currentSet(ids[0]) == game && steam.currentSet(ids[1]) == game, "set on all controllers");
    steam.activateLayer(ids[0], menu);
    steam.deactivateLayer(ids[0], menu);
    steam.deactivateAllLayers(ids[0]);
    ok(steam.activeLayers(ids[0], mem.alloc::<u64>(16)) == 0, "no fake layers");
    // held state
    ok(!steam.digital(ids[0], jump).state && steam.digital(ids[0], jump).active, "released but active");
    steam.fakePress(ids[0], jump, true);
    ok(steam.digital(ids[0], jump).state && !steam.digital(ids[1], jump).state && !steam.digital(ids[0], fire).state, "press is per pad and action");
    steam.fakePress(ids[0], jump, false);
    ok(!steam.digital(ids[0], jump).state, "release");
    ok(!steam.digital(u64(9), jump).active, "unknown pad is inactive");
    steam.fakeAnalog(ids[0], move, 0.5, -1.0);
    let an = steam.analog(ids[0], move);
    ok(an.x == 0.5 && an.y == -1.0 && an.active, "analog value");
    ok(!steam.digital(ids[0], move).state, "digital and analog handles do not mix");
    // origins and names
    let origins = mem.alloc::<i32>(8);
    ok(steam.digitalOrigins(ids[0], menu, jump, origins) == 1 && origins[0] == steam.ORIGIN_FAKE, "digital origin");
    ok(steam.analogOrigins(ids[0], menu, move, origins) == 1, "analog origin");
    ok(steam.glyphPng(steam.ORIGIN_FAKE, steam.GLYPH_LARGE, steam.GLYPH_DARK + steam.GLYPH_KNOCKOUT) == "" && steam.glyphSvg(steam.ORIGIN_FAKE, u32(0)) == "", "no glyph files");
    ok(steam.originName(steam.ORIGIN_FAKE).len > 0 && steam.digitalName(jump).len > 0, "names");
    // haptics log only
    steam.vibrate(ids[0], u16(100), u16(200));
    steam.vibrateEx(ids[0], u16(1), u16(2), u16(3), u16(4));
    steam.hapticEvent(ids[1], i32(0), u8(100), i8(-3), u8(0), i8(0));
    steam.led(ids[0], u8(255), u8(0), u8(0), steam.LED_SET);
    ok(steam.inputManifest("/tmp/manifest.vdf"), "manifest");
    steam.inputEnableDeviceCallbacks();
    ok(steam.motion(ids[0]).qw == 0.0 && steam.remotePlaySession(ids[0]) == u32(0), "fake motion and session");
    // callbacks decoded from hand-written structs
    steam.fakeCallback(2803, fakeCfg());
    steam.fakeCallback(2804, fakeSlot());
    let gone = mem.alloc::<u8>(8);
    steam.wrU64(gone.ptr as ptr, 0, u64(2));
    steam.fakeCallback(2802, gone);
    steam.frame();
    ok(CFG_H == u64(2) && CFG_API && !CFG_GP, "config callback");
    ok(SLOT_H == u64(1) && SLOT_OLD == i32(0) && SLOT_NEW == i32(3), "slot callback");
    ok(DISC == u64(2), "disconnect callback");
}

fn main() {
    let mem = Arena.create(65536);
    absent(&mem);
    capacity(&mem);
    layouts();
    fakeMode(&mem);
    steam.shutdown();
    ok(!steam.digital(steam.FAKE_PAD_A, u64(1)).active && steam.actionSet("menu") == u64(0), "absent again after shutdown");
    ok(steam.initFake(u32(480)) == steam.Status.Fake && steam.inputInit(false), "fake again");
    ok(steam.digitalAction("jump") == u64(1), "name caches are cleared at shutdown");
    ok(!steam.digital(steam.FAKE_PAD_A, u64(1)).state, "held state is cleared at shutdown");
    steam.shutdown();
    printLn("steam_input_test ok");
}
