// Tests for layout and panels: `@media` conditions (parse, viewport changes restyle only when one flips),
// `position: sticky` (j3.ui.sticky: push, limit by the parent, nested hit test), the pure math of
// j3.ui.panelmath, and draggable / resizable / dockable panels through the whole path j3.ui.dom +
// j3.ui.inputs + j3.ui.panels with synthetic mouse input (move, clamp, dock preview and release, undock,
// resize to the CSS minimum, a workspace that shrinks under a floating and a docked panel).
// Run from the repo root, headless (SDL_ttf measures text; no window opens):
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/layout_test.j3
// Panics on the first failed check.

module layout_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.css.{ Css, FL_LAST_CHILD };
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.panelmath;
use j3.ui.sticky;

#[singleton]
let CHECKS: int;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn near(a: f32, b: f32, tol: f32, msg: string) {
    CHECKS += 1;
    let diff = a - b;
    if diff < 0.0 {
        diff = 0.0 - diff;
    }
    if diff > tol {
        printLn(`FAIL: {msg}: {a} vs {b}`);
        panic(msg);
    }
}

// ---- pure math -------------------------------------------------------------------------------------------

fn testMath() {
    near(sticky.offset(150.0, 120.0, 0.0, 100.0), 30.0, 0.001, "sticky: pushed by the scroll past its place");
    near(sticky.offset(100.0, 120.0, 0.0, 100.0), 0.0, 0.001, "sticky: not before it reaches the edge");
    near(sticky.offset(230.0, 120.0, 0.0, 100.0), 100.0, 0.001, "sticky: stops at the parent's bottom");
    near(sticky.offset(150.0, 120.0, 8.0, 100.0), 38.0, 0.001, "sticky: top inset");
    near(sticky.offset(500.0, 0.0, 0.0, -5.0), 0.0, 0.001, "sticky: a negative limit is no push");
    near(panelmath.clampPos(-10.0, 50.0, 200.0), 0.0, 0.001, "pos: not left of 0");
    near(panelmath.clampPos(180.0, 50.0, 200.0), 150.0, 0.001, "pos: not past the edge");
    near(panelmath.clampPos(10.0, 300.0, 200.0), 0.0, 0.001, "pos: bigger than the workspace sits at 0");
    near(panelmath.clampSize(10.0, 80.0, 200.0), 80.0, 0.001, "size: minimum");
    near(panelmath.clampSize(500.0, 80.0, 200.0), 200.0, 0.001, "size: workspace");
    near(panelmath.clampSize(500.0, 80.0, 50.0), 80.0, 0.001, "size: minimum beats a tiny workspace");
    ok(panelmath.zoneAt(5.0, 100.0, 400.0, 300.0) == panelmath.DOCK_LEFT, "zone left");
    ok(panelmath.zoneAt(395.0, 100.0, 400.0, 300.0) == panelmath.DOCK_RIGHT, "zone right");
    ok(panelmath.zoneAt(200.0, 295.0, 400.0, 300.0) == panelmath.DOCK_BOTTOM, "zone bottom");
    ok(panelmath.zoneAt(200.0, 5.0, 400.0, 300.0) == panelmath.DOCK_NONE, "no top zone");
    ok(panelmath.zoneAt(-3.0, 100.0, 400.0, 300.0) == panelmath.DOCK_NONE, "outside the workspace is no zone");
    let r = panelmath.dockRect(panelmath.DOCK_BOTTOM, 150.0, 90.0, 400.0, 300.0, 60.0, 30.0);
    ok(r.x == 0.0 && r.w == 400.0 && r.h == 90.0 && r.y == 210.0, "bottom dock: full width");
    let q = panelmath.dockRect(panelmath.DOCK_RIGHT, 150.0, 90.0, 400.0, 300.0, 60.0, 30.0);
    ok(q.x == 250.0 && q.w == 150.0 && q.h == 300.0, "right dock: full height");
    let g = panelmath.dockRect(panelmath.DOCK_LEFT, 900.0, 90.0, 400.0, 300.0, 60.0, 30.0);
    near(g.w, 320.0, 0.001, "dock width is capped at 80% of the workspace");
    let rf = panelmath.resized(panelmath.DOCK_NONE, 10.0, 20.0, 100.0, 50.0);
    near(rf.h, 70.0, 0.001, "floating resize grows both");
    let rr = panelmath.resized(panelmath.DOCK_RIGHT, 10.0, 20.0, 100.0, 50.0);
    near(rr.w, 90.0, 0.001, "right dock resizes from its inner edge");
    let rb = panelmath.resized(panelmath.DOCK_BOTTOM, 10.0, 20.0, 100.0, 50.0);
    near(rb.h, 30.0, 0.001, "bottom dock resizes from its top");
    ok(!panelmath.pastSlop(2.0, 1.0) && panelmath.pastSlop(3.0, 3.0), "slop");
}

// ---- @media ----------------------------------------------------------------------------------------------

fn testMedia(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, "div { width: 100px; } @media screen and (max-width: 500px) { div { width: 50px; } .a { height: 7px; } } @media (min-width: 501px) and (max-width: 900px) { div { width: 70px; } } @media (max-width: 500px) { .b { height: 9px; } } div { height: 3px; }", "m.css", 0);
    ok(css.warns.len == 0, "media sheet parses without a warning");
    ok(css.media.len == 2, "equal conditions share an entry");
    ok(css.rules.items[1].mq == 0 && css.rules.items[0].mq == -1 && css.rules.items[css.rules.len - 1].mq == -1, "rules inside carry the condition, rules after do not");
    ok(css.setViewport(800.0, 600.0), "the first viewport counts as a change");
    ok(!css.setViewport(800.0, 600.0), "the same size is no change");
    ok(!css.setViewport(850.0, 500.0), "a resize that flips no condition is no change");
    ok(css.setViewport(400.0, 500.0), "crossing a breakpoint is a change");
    ok(css.setViewport(501.0, 500.0), "and back");
    ok(css.mediaHolds(1) && !css.mediaHolds(0), "which conditions hold at 501");
    let n = Css.new(mem);
    parse(&n, "div { width: 1px; } @media not screen and (max-width: 500px) { div { width: 2px; } } @media (max-width: 300px), (min-width: 900px) { .a { height: 5px; } } @media (max-width: 100px) or (min-width: 1000px) { .b { height: 6px; } }", "n.css", 0);
    ok(n.warns.len == 0, "not, comma and or lists parse");
    let mn = n.rules.items[1].mq;
    let ml = n.rules.items[2].mq;
    let mo = n.rules.items[3].mq;
    n.setViewport(400.0, 300.0);
    ok(!n.mediaHolds(mn) && !n.mediaHolds(ml) && !n.mediaHolds(mo), "400 wide: not (max 500) fails, no alternative holds");
    n.setViewport(800.0, 300.0);
    ok(n.mediaHolds(mn) && !n.mediaHolds(ml), "800 wide: not (max 500) holds");
    n.setViewport(250.0, 300.0);
    ok(n.mediaHolds(ml) && !n.mediaHolds(mo), "250 wide: the first alternative of a comma list");
    n.setViewport(1200.0, 300.0);
    ok(n.mediaHolds(ml) && n.mediaHolds(mo), "1200 wide: the second alternative, in both list spellings");
    let d = Css.new(mem);
    parse(&d, "@media print { div { width: 1px; } } @media (max-width: 10em) { div { width: 1px; } }", "bad.css", 0);
    ok(d.warns.len == 2, "unsupported conditions warn once each (nested @media is fine now)");
}

// ---- the tree --------------------------------------------------------------------------------------------

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, button { font-family: \"T\"; font-size: 14px; } .page { display: flex; flex-direction: column; } .stage { position: relative; width: 50%; height: 300px; } .win { position: absolute; left: 20px; top: 20px; width: 150px; height: 100px; min-width: 60px; } .bar { height: 20px; } .grip { position: absolute; right: 0; bottom: 0; width: 16px; height: 16px; } .list { height: 100px; width: 200px; overflow-y: auto; } .group { } .head { position: sticky; top: 0; z-index: 2; height: 20px; } .row { height: 20px; } .resp { width: 100px; height: 10px; } @media (max-width: 500px) { .resp { width: 50px; } }";

#[singleton]
let VW: f32;
#[singleton]
let VH: f32;

struct Ids {
    stage: int;
    win: int;
    bar: int;
    grip: int;
    list: int;
    head0: int;
    head1: int;
    head2: int;
    resp: int;
}

#[singleton]
let IDS: Ids;

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: VW, y: VH });
    inputs.begin(d);
    let ids = Ids { stage: -1, win: -1, bar: -1, grip: -1, list: -1, head0: -1, head1: -1, head2: -1, resp: -1 };
    let page = d.open(0, d.tag("div"), 1);
    d.cls(page, "page");
    ids.stage = d.open(0, d.tag("div"), 1);
    d.cls(ids.stage, "stage");
    ids.win = d.open(0, d.tag("div"), 1);
    d.cls(ids.win, "win");
    d.attrPanel(ids.win, "dock");
    ids.bar = d.open(0, d.tag("div"), 1);
    d.cls(ids.bar, "bar");
    d.attrPanelRole(ids.bar, dom.PK_HANDLE);
    d.close();
    ids.grip = d.open(1, d.tag("div"), 1);
    d.cls(ids.grip, "grip");
    d.attrPanelRole(ids.grip, dom.PK_GRIP);
    d.close();
    d.close();
    d.close();
    ids.list = d.open(1, d.tag("div"), 1);
    d.cls(ids.list, "list");
    for g in 0..3 {
        let grp = d.open(g, d.tag("div"), 1);
        d.cls(grp, "group");
        let h = d.open(0, d.tag("div"), 1);
        d.cls(h, "head");
        if g == 0 {
            ids.head0 = h;
        } else if g == 1 {
            ids.head1 = h;
        } else {
            ids.head2 = h;
        }
        d.close();
        for r in 0..5 {
            let row = d.open(1 + r, d.tag("div"), 1);
            d.cls(row, "row");
            d.close();
        }
        d.close();
    }
    d.close();
    ids.resp = d.open(2, d.tag("div"), 1);
    d.cls(ids.resp, "resp");
    d.close();
    d.close();
    IDS = ids;
    d.layout();
    d.endFrame();
}

fn fresh(mem: &Arena, css: &Css): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    VW = 800.0;
    VH = 600.0;
    frame(&d);
    frame(&d);
    frame(&d);
    return d;
}

fn at(d: &Dom, x: f32, y: f32, down: bool) {
    d.simInput(x, y, down, 0.0);
    frame(d);
}

/// Press at `(x0, y0)`, drag through `(x1, y1)`, and let go there (one frame at each step).
fn drag(d: &Dom, x0: f32, y0: f32, x1: f32, y1: f32) {
    at(d, x0, y0, false);
    at(d, x0, y0, true);
    at(d, (x0 + x1) / 2.0, (y0 + y1) / 2.0, true);
    at(d, x1, y1, true);
    at(d, x1, y1, false);
}

fn testResponsive(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    near(d.nodes.items[IDS.resp].w, 100.0, 0.01, "wide: the base rule");
    let laid = d.laid;
    frame(&d);
    ok(d.laid == laid, "a steady frame lays out nothing");
    VW = 700.0;
    frame(&d);
    near(d.nodes.items[IDS.resp].w, 100.0, 0.01, "a resize over no breakpoint keeps the style");
    VW = 400.0;
    frame(&d);
    near(d.nodes.items[IDS.resp].w, 50.0, 0.01, "narrow: the media rule wins");
    near(d.nodes.items[IDS.stage].w, 200.0, 0.01, "percent widths follow the window");
    VW = 800.0;
    frame(&d);
    near(d.nodes.items[IDS.resp].w, 100.0, 0.01, "and back");
}

fn testSticky(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    let l = IDS.list;
    near(d.nodes.items[l].scrollMax, 260.0, 0.01, "list range");
    near(d.nodes.items[IDS.head1].sy, 0.0, 0.001, "nothing is pushed at the top");
    d.scrollBy(l, 150.0);
    frame(&d);
    near(d.nodes.items[IDS.head1].sy, 30.0, 0.01, "the second header is pushed to the top edge");
    near(d.absY(IDS.head1) - d.absY(l), 0.0, 0.01, "and sits at the scroll box's top");
    near(d.absY(IDS.head0) - d.absY(l), -50.0, 0.01, "the first header stops at the bottom of its own group, scrolled away");
    near(d.nodes.items[IDS.head2].sy, 0.0, 0.001, "the third is not there yet");
    d.scrollBy(l, 60.0);
    frame(&d);
    near(d.nodes.items[IDS.head1].sy, 90.0, 0.01, "pushed on, until it leaves with its group");
    near(d.nodes.items[IDS.head2].sy, 0.0, 0.01, "the next header takes over from its own place");
    d.scrollBy(l, 100.0);
    frame(&d);
    near(d.nodes.items[IDS.head2].sy, 20.0, 0.01, "the last header at the end of the scroll range is at the top");
    near(d.absY(IDS.head2) - d.absY(l), 0.0, 0.01, "(shown at the scroll box's top)");
    // a pointer over the shown header hits it, not the row that sits there unmoved
    d.scrollBy(l, -1000.0);
    d.scrollBy(l, 150.0);
    frame(&d);
    at(&d, d.absX(l) + 10.0, d.absY(l) + 5.0, false);
    ok(d.hover == IDS.head1, "hit testing follows the pushed header");
}

fn testPanels(mem: &Arena, css: &Css) {
    let d = fresh(mem, css);
    let w = IDS.win;
    near(d.nodes.items[w].x, 20.0, 0.01, "panel starts where the CSS put it");
    ok(d.panelDock(w) == 0, "and floats");
    // a click on the handle does not move it
    at(&d, 50.0, 30.0, false);
    at(&d, 50.0, 30.0, true);
    at(&d, 51.0, 31.0, true);
    at(&d, 51.0, 31.0, false);
    near(d.nodes.items[w].x, 20.0, 0.01, "a click is not a drag");
    // move
    drag(&d, 50.0, 30.0, 150.0, 130.0);
    near(d.nodes.items[w].x, 120.0, 0.01, "the handle drags the panel by the grab point (x)");
    near(d.nodes.items[w].y, 120.0, 0.01, "(y)");
    near(d.nodes.items[w].w, 150.0, 0.01, "its size is kept");
    // off the workspace: clamped (stage is 400 by 300)
    drag(&d, 160.0, 130.0, 900.0, 700.0);
    near(d.nodes.items[w].x, 250.0, 0.01, "kept inside the workspace (right)");
    near(d.nodes.items[w].y, 200.0, 0.01, "(bottom)");
    // a press on the body does not drag
    drag(&d, 300.0, 280.0, 100.0, 100.0);
    near(d.nodes.items[w].x, 250.0, 0.01, "only the handle drags");
    // the workspace shrinks under a floating panel
    // the workspace is read from the previous layout: the panel follows one frame after the window
    VW = 500.0;
    frame(&d);
    frame(&d);
    near(d.nodes.items[IDS.stage].w, 250.0, 0.01, "the workspace follows the window");
    near(d.nodes.items[w].x, 100.0, 0.01, "a floating panel is pulled back inside");
    VW = 800.0;
    frame(&d);
    frame(&d);
    near(d.nodes.items[w].x, 250.0, 0.01, "and returns when there is room again");
    // dock to the left edge
    let bx = d.absX(IDS.bar) + 10.0;
    let by = d.absY(IDS.bar) + 5.0;
    at(&d, bx, by, false);
    at(&d, bx, by, true);
    at(&d, bx - 100.0, by, true);
    at(&d, 6.0, 150.0, true);
    ok(d.pans.items[0].zone == panelmath.DOCK_LEFT, "near the edge a zone is offered");
    near(d.nodes.items[w].x, 0.0, 0.01, "the panel follows the pointer meanwhile");
    at(&d, 6.0, 150.0, false);
    ok(d.panelDock(w) == panelmath.DOCK_LEFT, "released in the zone: docked");
    near(d.nodes.items[w].x, 0.0, 0.01, "docked: left edge");
    near(d.nodes.items[w].h, 300.0, 0.01, "docked: full height");
    near(d.nodes.items[w].w, 150.0, 0.01, "docked: its width");
    // the workspace changes while docked
    VH = 500.0;
    frame(&d);
    frame(&d);
    near(d.nodes.items[w].h, 300.0, 0.01, "stage height is CSS, so the dock keeps it");
    VW = 400.0;
    frame(&d);
    frame(&d);
    near(d.nodes.items[w].w, 150.0, 0.01, "narrower workspace still holds the dock");
    VW = 800.0;
    VH = 600.0;
    frame(&d);
    frame(&d);
    // resize the docked panel by its grip: along the dock axis only
    let gx = d.absX(IDS.grip) + 8.0;
    let gy = d.absY(IDS.grip) + 8.0;
    drag(&d, gx, gy, gx + 50.0, gy + 40.0);
    near(d.nodes.items[w].w, 200.0, 0.01, "a left dock grows wider");
    near(d.nodes.items[w].h, 300.0, 0.01, "and keeps its height");
    gx = d.absX(IDS.grip) + 8.0;
    gy = d.absY(IDS.grip) + 8.0;
    drag(&d, gx, gy, gx - 190.0, gy);
    near(d.nodes.items[w].w, 60.0, 0.01, "never below the CSS min-width");
    // undock by dragging the handle away
    bx = d.absX(IDS.bar) + 10.0;
    by = d.absY(IDS.bar) + 5.0;
    drag(&d, bx, by, 220.0, 160.0);
    ok(d.panelDock(w) == 0, "dragging a docked panel's handle floats it");
    near(d.nodes.items[w].w, 60.0, 0.01, "it gets its floating size back (the width the dock was resized to)");
    near(d.nodes.items[w].h, 100.0, 0.01, "(and the height it had before docking)");
    ok(d.nodes.items[w].x > 100.0 && d.nodes.items[w].y > 100.0, "and follows the pointer");
    // resize a floating panel to the minimum and the workspace
    gx = d.absX(IDS.grip) + 8.0;
    gy = d.absY(IDS.grip) + 8.0;
    drag(&d, gx, gy, gx - 300.0, gy - 300.0);
    near(d.nodes.items[w].w, 60.0, 0.01, "floating: minimum width");
    near(d.nodes.items[w].h, panelmath.MIN_H, 0.01, "floating: default minimum height");
    gx = d.absX(IDS.grip) + 8.0;
    gy = d.absY(IDS.grip) + 8.0;
    drag(&d, gx, gy, gx + 900.0, gy + 900.0);
    ok(d.nodes.items[w].x + d.nodes.items[w].w <= 400.5 && d.nodes.items[w].y + d.nodes.items[w].h <= 300.5, "never grows past the workspace");
}

// ---- flex-wrap, calc(), viewport units ---------------------------------------------------------------

const WSHEET: string = ".wr { display: flex; flex-wrap: wrap; width: 300px; gap: 10px 20px; } .tall { height: 200px; } .mid { align-content: center; } .it { width: 100px; height: 40px; } .big { width: 400px; height: 40px; } .nw { display: flex; width: 300px; } .nw .it { } .c1 { width: calc(100% - 20px); height: 10px; } .c2 { width: clamp(50px, 20vw, 150px); height: 10px; } .c3 { width: min(50%, 120px); height: 10px; } .c4 { width: calc(100% / 0); height: 10px; } .c5 { width: calc(10px + 2 * 5px); height: calc(100vh / 10); } .box { width: 300px; }";

#[singleton]
let WIDS: [16]int;

fn wframe(d: &Dom, kind: int) {
    d.beginFrame(Vec2 { x: VW, y: VH });
    let page = d.open(0, d.tag("div"), 1);
    let n = if kind == 3 { 0 } else { 5 };
    let w = d.open(0, d.tag("div"), 1);
    d.cls(w, "wr");
    if kind == 1 || kind == 2 { d.cls(w, "tall"); }
    if kind == 2 { d.cls(w, "mid"); }
    WIDS[0] = w;
    for i in 0..n {
        let it = d.open(1 + i, d.tag("div"), 1);
        d.cls(it, if kind == 4 && i == 1 { "big" } else { "it" });
        WIDS[1 + i] = it;
        d.close();
    }
    d.close();
    let b = d.open(1, d.tag("div"), 1);
    d.cls(b, "box");
    for i in 0..5 {
        let c = d.open(i, d.tag("div"), 1);
        if i == 4 { d.cls(c, "c5"); }
        if i == 0 { d.cls(c, "c1"); }
        if i == 1 { d.cls(c, "c2"); }
        if i == 2 { d.cls(c, "c3"); }
        if i == 3 { d.cls(c, "c4"); }
        WIDS[8 + i] = c;
        d.close();
    }
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn wfresh(mem: &Arena, css: &Css, kind: int): Dom {
    let d = Dom.new(mem, css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    wframe(&d, kind);
    wframe(&d, kind);
    return d;
}

fn testWrapCalc(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, WSHEET, "w.css", 0);
    ok(css.warns.len == 0, "wrap sheet parses without a warning");
    VW = 800.0;
    VH = 600.0;
    let d = wfresh(mem, &css, 0);
    let it = &d.nodes.items;
    near(it[WIDS[1]].x, 0.0, 0.01, "wrap: first item");
    near(it[WIDS[2]].x, 120.0, 0.01, "wrap: column gap between items on a line");
    near(it[WIDS[3]].y, 50.0, 0.01, "wrap: third item starts line two, row gap below");
    near(it[WIDS[3]].x, 0.0, 0.01, "wrap: back at the left edge");
    near(it[WIDS[5]].y, 100.0, 0.01, "wrap: the odd item is alone on line three");
    near(it[WIDS[0]].h, 140.0, 0.01, "wrap: auto height is three lines plus two row gaps");
    let d1 = wfresh(mem, &css, 1);
    near(d1.nodes.items[WIDS[3]].y, 70.0, 0.01, "align-content: stretch shares the spare height between lines");
    near(d1.nodes.items[WIDS[5]].y, 140.0, 0.01, "(third line)");
    let d2 = wfresh(mem, &css, 2);
    near(d2.nodes.items[WIDS[1]].y, 30.0, 0.01, "align-content: center");
    let d3 = wfresh(mem, &css, 3);
    near(d3.nodes.items[WIDS[0]].h, 0.0, 0.01, "wrap: no items, no height");
    let d4 = wfresh(mem, &css, 4);
    ok(d4.nodes.items[WIDS[2]].w <= 300.01, "wrap: an oversized item shrinks to its own line");
    near(d4.nodes.items[WIDS[3]].y, 100.0, 0.01, "(and the next item starts below it)");
    // calc, min, max, clamp, viewport units
    near(it[WIDS[8]].w, 280.0, 0.01, "calc(100% - 20px) of a 300px parent");
    near(it[WIDS[9]].w, 150.0, 0.01, "clamp: the maximum at 800 wide");
    near(it[WIDS[10]].w, 120.0, 0.01, "min(50%, 120px)");
    near(it[WIDS[11]].w, 300.0, 0.01, "a divide by zero is auto");
    near(it[WIDS[12]].w, 20.0, 0.01, "calc(10px + 2 * 5px)");
    near(it[WIDS[12]].h, 60.0, 0.01, "calc(100vh / 10) at 600 high");
    VW = 400.0;
    wframe(&d, 0);
    near(d.nodes.items[WIDS[9]].w, 80.0, 0.01, "clamp follows a resize: 20vw of 400");
    VW = 100.0;
    wframe(&d, 0);
    near(d.nodes.items[WIDS[9]].w, 50.0, 0.01, "clamp: the minimum at 100 wide");
    let steady = d.laid;
    wframe(&d, 0);
    ok(d.laid == steady, "viewport units: a steady frame lays out nothing");
    VW = 800.0;
    let bad = Css.new(mem);
    parse(&bad, ".a { width: calc(10px + 5); } .b { width: calc(10px * 2px); } .c { width: calc(10px / 2px); } .d { width: calc(100% - ); } .e { width: min(); } .f { width: clamp(1px, 2px); } .g { width: calc(2 * 3); } .h { font-size: calc(10px + 5); } .i { width: calc(1px + 2vw + 3%); }", "bad.css", 0);
    ok(bad.warns.len == 8, "ill-typed calc on font-size and unsupported properties warn once each");
}

// ---- em / rem ----------------------------------------------------------------------------------------

const ESHEET: string = ":root { font-size: 20px; } .a { font-size: 2em; } .a2 { font-size: 1.5em; width: 1em; height: 1rem; } .b { padding: 1.5em; } .in { width: 10px; height: 10px; } .w { width: 10em; height: 2rem; } .d { width: calc(1rem + 4px); height: calc(2em + 1px); } .e { font-size: 2rem; width: 1em; height: 10px; } .f { --gap: 0.5rem; width: var(--gap); height: 10px; } .g { width: 100px; line-height: 1.5em; } .h { margin-left: 2em; width: 10px; height: 10px; } .fc { font-size: calc(1rem + 2px); width: 1em; height: 10px; } .fp { font-size: calc(50% + 2px); width: 1em; height: 10px; } .bw { border-width: 0.25em; border-style: solid; width: 10px; }";

#[singleton]
let EIDS: [12]int;

fn eframe(d: &Dom, px: string) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    d.styleStr(0, 0, "font-size", px);
    let page = d.open(0, d.tag("div"), 1);
    let b = d.open(0, d.tag("div"), 1);
    d.cls(b, "b");
    let inn = d.open(0, d.tag("div"), 1);
    d.cls(inn, "in");
    EIDS[0] = b;
    EIDS[1] = inn;
    d.close();
    d.close();
    let w = d.open(1, d.tag("div"), 1);
    d.cls(w, "w");
    EIDS[2] = w;
    d.close();
    let a = d.open(2, d.tag("div"), 1);
    d.cls(a, "a");
    EIDS[3] = a;
    let a2 = d.open(0, d.tag("div"), 1);
    d.cls(a2, "a2");
    EIDS[4] = a2;
    d.close();
    let fp = d.open(2, d.tag("div"), 1);
    d.cls(fp, "fp");
    EIDS[11] = fp;
    d.close();
    let dd = d.open(1, d.tag("div"), 1);
    d.cls(dd, "d");
    EIDS[5] = dd;
    d.close();
    d.close();
    let e = d.open(3, d.tag("div"), 1);
    d.cls(e, "e");
    EIDS[6] = e;
    d.close();
    let f = d.open(4, d.tag("div"), 1);
    d.cls(f, "f");
    EIDS[7] = f;
    d.close();
    let h = d.open(5, d.tag("div"), 1);
    d.cls(h, "h");
    EIDS[8] = h;
    d.close();
    let fc = d.open(6, d.tag("div"), 1);
    d.cls(fc, "fc");
    EIDS[9] = fc;
    d.close();
    let j = d.open(7, d.tag("div"), 1);
    d.styleStr(j, 0, "padding", "1.5rem");
    let ji = d.open(0, d.tag("div"), 1);
    d.cls(ji, "in");
    EIDS[10] = ji;
    d.close();
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn testEmRem(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ESHEET, "em.css", 0);
    ok(css.warns.len == 0, "em/rem sheet parses without a warning");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    eframe(&d, "");
    eframe(&d, "");
    let it = &d.nodes.items;
    near(it[EIDS[1]].x, 30.0, 0.01, "padding: 1.5em is 30px at a 20px font");
    near(it[EIDS[2]].w, 200.0, 0.01, "width: 10em of the inherited root size");
    near(it[EIDS[2]].h, 40.0, 0.01, "height: 2rem");
    near(it[EIDS[4]].w, 60.0, 0.01, "nested em compounds: 2em then 1.5em is 60px, and width: 1em is that");
    near(it[EIDS[4]].h, 20.0, 0.01, "rem ignores the parent's font size");
    near(it[EIDS[5]].w, 24.0, 0.01, "calc(1rem + 4px)");
    near(it[EIDS[5]].h, 81.0, 0.01, "calc(2em + 1px) of the element's own 40px");
    near(it[EIDS[6]].w, 40.0, 0.01, "font-size: 2rem, then width: 1em of it");
    near(it[EIDS[7]].w, 10.0, 0.01, "var(--gap) holding 0.5rem");
    near(it[EIDS[8]].x, 40.0, 0.01, "margin-left: 2em");
    near(it[EIDS[9]].w, 22.0, 0.01, "font-size: calc(1rem + 2px), width: 1em of it");
    near(it[EIDS[11]].w, 22.0, 0.01, "font-size: calc(50% + 2px) is of the parent's 40px");
    near(it[EIDS[10]].x, 30.0, 0.01, "a style: padding in rem");
    let steady = d.laid;
    eframe(&d, "");
    ok(d.laid == steady, "em/rem: a steady frame lays out nothing");
    eframe(&d, "40px");
    eframe(&d, "40px");
    near(it[EIDS[1]].x, 60.0, 0.01, "root font-size 40px: padding doubles");
    near(it[EIDS[2]].w, 400.0, 0.01, "(width 10em)");
    near(it[EIDS[4]].w, 120.0, 0.01, "(nested em: 2em * 1.5em)");
    near(it[EIDS[4]].h, 40.0, 0.01, "(rem)");
    near(it[EIDS[5]].w, 44.0, 0.01, "(calc with rem)");
    near(it[EIDS[7]].w, 20.0, 0.01, "(var with rem)");
    near(it[EIDS[9]].w, 42.0, 0.01, "(font-size calc with rem)");
    near(it[EIDS[10]].x, 60.0, 0.01, "(a style: padding in rem is rebuilt when the root changes)");
    steady = d.laid;
    eframe(&d, "40px");
    eframe(&d, "40px");
    ok(d.laid == steady, "em/rem: unchanged root size costs no layout");
    eframe(&d, "");
    near(it[EIDS[1]].x, 30.0, 0.01, "root size back to the stylesheet's: padding back");
}

// ---- min/max sizing through every box layout path --------------------------------------------------------
const LIMITS: string = " * { box-sizing: border-box; margin: 0; padding: 0; } :root { font-size: 20px; } .host { width: 400px; height: 300px; position: relative; } .box { width: 300px; height: 200px; max-width: 50%; max-height: calc(50% - 10px); } .conflict { width: 10px; height: 10px; max-width: 30px; min-width: 70px; max-height: 20px; min-height: 60px; } .content { box-sizing: content-box; width: 300px; height: 100px; padding: 5px; border: 2px solid #ff0000; max-width: 4em; max-height: 2rem; } .floor { width: 0; height: 0; padding: 10px; max-width: 2px; max-height: 2px; } .auto { max-width: 120px; max-height: 40px; overflow-y: auto; } .tall { height: 90px; } .inline { display: inline; width: 300px; max-width: 90px; min-height: 30px; } .abs { position: absolute; right: 0; bottom: 0; width: 300px; height: 200px; max-width: 25%; max-height: 25%; } .row { display: flex; width: 300px; height: 80px; } .grow { flex: 1; min-width: 0; } .cap { max-width: 60px; max-height: 30px; } .shrink { width: 200px; min-width: 0; } .minimum { min-width: 180px; } .column { display: flex; flex-direction: column; width: 100px; height: 300px; } .vertical { flex: 1; min-height: 0; max-width: 50%; } .vcap { max-height: 60px; } .grid { display: grid; grid-template-columns: 200px 200px; } .naturalcontent { height: 200px; } .natural { min-height: 0; } .naturalcap { max-height: 60px; } .shortcolumn { height: 200px; } .wraplimit { width: 150px; flex-wrap: wrap; } .flexconflict { min-width: 70px; } .narrow { width: 200px; } .minunit { width: 0; height: 0; min-width: calc(10% + 1em); min-height: 10%; } .intrinsic { max-width: 40px; } .wide { width: 100px; height: 10px; } .autopct { max-height: 20%; } .cell { width: 100%; max-width: 50%; height: 100px; max-height: 40px; } "; 

fn limitNode(d: &Dom, key: int, cls: string): int {
    let id = d.open(key, d.tag("div"), 1);
    d.clsDyn(id, cls);
    return id;
}

fn limitFrame(d: &Dom, width: f32, cap: string) {
    d.beginFrame(Vec2 { x: width, y: 600.0 });
    let host = limitNode(d, 0, "host");
    d.styleStr(host, 0, "width", "100%");
    d.styleStr(host, 1, "height", if width == 200.0 { "200px" } else { "" });
    let box = limitNode(d, 0, "box");
    d.styleStr(box, 0, "max-width", if same(cap, "number") { "" } else { cap });
    if same(cap, "number") { d.styleNum(box, 1, "max-width", 55.0); } else { d.styleStr(box, 1, "max-width", ""); }
    d.close();
    limitNode(d, 1, "conflict"); d.close();
    limitNode(d, 2, "content"); d.close();
    limitNode(d, 3, "floor"); d.close();
    limitNode(d, 4, "auto");
    limitNode(d, 0, "tall"); d.close(); d.close();
    let inline = d.open(5, d.tag("button"), 1); d.cls(inline, "inline"); d.close();
    limitNode(d, 6, "abs"); d.close();
    limitNode(d, 7, "row");
    limitNode(d, 0, "grow cap"); d.close();
    limitNode(d, 1, "grow"); d.close(); d.close();
    limitNode(d, 8, "row");
    limitNode(d, 0, "shrink minimum"); d.close();
    limitNode(d, 1, "shrink"); d.close(); d.close();
    limitNode(d, 9, "column");
    limitNode(d, 0, "vertical vcap"); d.close();
    limitNode(d, 1, "vertical"); d.close(); d.close();
    limitNode(d, 10, "grid");
    limitNode(d, 0, "cell"); d.close();
    limitNode(d, 1, "cell"); d.close(); d.close();
    limitNode(d, 11, "minunit"); d.close();
    let intrinsic = d.open(12, d.tag("button"), 1); d.cls(intrinsic, "intrinsic");
    limitNode(d, 0, "wide"); d.close(); d.close();
    limitNode(d, 13, "wrapper");
    limitNode(d, 0, "autopct");
    limitNode(d, 0, "tall"); d.close(); d.close(); d.close();
    limitNode(d, 14, "row narrow");
    limitNode(d, 0, "shrink cap"); d.close();
    limitNode(d, 1, "shrink"); d.close(); d.close();
    limitNode(d, 15, "row");
    limitNode(d, 0, "grow conflict flexconflict"); d.close();
    limitNode(d, 1, "grow"); d.close(); d.close();
    limitNode(d, 16, "column shortcolumn");
    limitNode(d, 0, "natural naturalcap");
    limitNode(d, 0, "naturalcontent"); d.close(); d.close();
    limitNode(d, 1, "natural");
    limitNode(d, 0, "naturalcontent"); d.close(); d.close(); d.close();
    limitNode(d, 17, "row wraplimit");
    limitNode(d, 0, "shrink cap"); d.close();
    limitNode(d, 1, "shrink cap"); d.close(); d.close();
    d.close();
    d.layout(); d.endFrame();
}

fn testLimits(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, LIMITS, "limits.css", 0);
    ok(css.warns.len == 0, "limit properties parse");
    let d = Dom.new(mem, &css);
    d.simInput(-5.0, -5.0, false, 0.0);
    limitFrame(&d, 400.0, "");
    limitFrame(&d, 400.0, "");
    let ns = &d.nodes.items;
    let host = ns[0].first;
    let box = ns[host].first;
    near(ns[box].w, 200.0, 0.01, "block percent max width");
    near(ns[box].h, 140.0, 0.01, "block calc percent max height with definite parent");
    let conflict = ns[box].next;
    near(ns[conflict].w, 70.0, 0.01, "minimum width beats maximum");
    near(ns[conflict].h, 60.0, 0.01, "minimum height beats maximum");
    let content = ns[conflict].next;
    near(ns[content].w, 94.0, 0.01, "content-box em max includes padding and border");
    near(ns[content].h, 54.0, 0.01, "content-box rem max includes padding and border");
    let floor = ns[content].next;
    near(ns[floor].w, 0.0, 0.01, "border-box width keeps existing padding overflow behavior");
    near(ns[floor].h, 0.0, 0.01, "border-box height keeps existing padding overflow behavior");
    let auto = ns[floor].next;
    near(ns[auto].w, 120.0, 0.01, "auto block width limited before contents");
    near(ns[auto].h, 40.0, 0.01, "auto height maximum");
    near(ns[auto].scrollMax, 50.0, 0.01, "limited auto height scroll extent");
    let inline = ns[auto].next;
    near(ns[inline].w, 90.0, 0.01, "atomic inline width limit");
    near(ns[inline].h, 30.0, 0.01, "atomic inline minimum height");
    let abs = ns[inline].next;
    near(ns[abs].w, 100.0, 0.01, "absolute percent width limit");
    near(ns[abs].h, 75.0, 0.01, "absolute percent height limit");
    near(ns[abs].x, 300.0, 0.01, "right inset uses limited width");
    near(ns[abs].y, 225.0, 0.01, "bottom inset uses limited height");
    let row = ns[abs].next;
    let first = ns[row].first;
    near(ns[first].w, 60.0, 0.01, "flex grow freezes at maximum");
    near(ns[ns[first].next].w, 240.0, 0.01, "remaining flex grow redistributed");
    near(ns[first].h, 30.0, 0.01, "flex stretch respects cross maximum");
    let shrink = ns[row].next;
    first = ns[shrink].first;
    near(ns[first].w, 180.0, 0.01, "flex shrink freezes at minimum");
    near(ns[ns[first].next].w, 120.0, 0.01, "remaining flex shrink redistributed");
    let column = ns[shrink].next;
    first = ns[column].first;
    near(ns[first].h, 60.0, 0.01, "column flex maximum");
    near(ns[ns[first].next].h, 240.0, 0.01, "column flex redistribution");
    near(ns[first].w, 50.0, 0.01, "column cross percent maximum");
    let grid = ns[column].next;
    first = ns[grid].first;
    near(ns[first].w, 100.0, 0.01, "grid percent maximum uses track");
    near(ns[first].h, 40.0, 0.01, "grid maximum height");
    let minunit = ns[grid].next;
    near(ns[minunit].w, 60.0, 0.01, "calc percent/em minimum width");
    near(ns[minunit].h, 30.0, 0.01, "percent minimum height");
    let intrinsic = ns[minunit].next;
    near(ns[intrinsic].w, 40.0, 0.01, "intrinsic atomic width respects maximum");
    let wrapper = ns[intrinsic].next;
    near(ns[ns[wrapper].first].h, 90.0, 0.01, "percent maximum height ignored with indefinite parent height");
    let capped = ns[wrapper].next;
    first = ns[capped].first;
    near(ns[first].w, 60.0, 0.01, "shrinking item freezes at maximum");
    near(ns[ns[first].next].w, 140.0, 0.01, "shrink redistributes after maximum freeze");
    let conflicting = ns[capped].next;
    first = ns[conflicting].first;
    near(ns[first].w, 70.0, 0.01, "flex minimum beats conflicting maximum");
    near(ns[ns[first].next].w, 230.0, 0.01, "flex grow accounts for conflicting limit");
    let natural = ns[conflicting].next;
    first = ns[natural].first;
    near(ns[first].h, 60.0, 0.01, "column natural flex base ignores its maximum");
    near(ns[ns[first].next].h, 140.0, 0.01, "column natural shrink redistribution");
    let wrapped = ns[natural].next;
    first = ns[wrapped].first;
    near(ns[first].w, 60.0, 0.01, "wrapped flex item maximum");
    near(ns[ns[first].next].x, 60.0, 0.01, "wrap uses clamped hypothetical widths");
    near(ns[ns[first].next].y, 0.0, 0.01, "two capped items fit one line");
    let steady = d.laid;
    let restyled = d.restyled;
    let used = mem.used;
    for i in 0..100 { limitFrame(&d, 400.0, ""); }
    ok(d.laid == steady && d.restyled == restyled && mem.used == used, "limits steady frames have no layout, restyle or arena growth");
    limitFrame(&d, 200.0, "");
    near(ns[box].w, 100.0, 0.01, "resize updates percent limits");
    near(ns[minunit].w, 40.0, 0.01, "resize updates percent minimums");
    near(ns[box].h, 90.0, 0.01, "parent height change updates cached percentage maximum");
    near(ns[minunit].h, 20.0, 0.01, "parent height change updates cached percentage minimum");
    limitFrame(&d, 200.0, "calc(25% + 1rem)");
    near(ns[box].w, 70.0, 0.01, "dynamic calc percent rem maximum");
    limitFrame(&d, 200.0, "none");
    near(ns[box].w, 300.0, 0.01, "dynamic none removes maximum");
    limitFrame(&d, 200.0, "");
    near(ns[box].w, 100.0, 0.01, "dynamic removal restores rule limit");
    limitFrame(&d, 200.0, "number");
    near(ns[box].w, 55.0, 0.01, "numeric style max-width is px");
    limitFrame(&d, 200.0, "2em");
    near(ns[box].w, 40.0, 0.01, "style max-width resolves em");
    limitFrame(&d, 200.0, "3rem");
    near(ns[box].w, 60.0, 0.01, "style max-width resolves rem");
}

fn testLimitEdges(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, LIMITS, "limit-edges.css", 0);
    let d = Dom.new(mem, &css);
    d.simInput(-5.0, -5.0, false, 0.0);
    d.beginFrame(Vec2 { x: 400.0, y: 600.0 });
    let rows: [5]int = [0, 0, 0, 0, 0];
    for i in 0..4 {
        rows[i] = limitNode(&d, i, "row");
        if i == 1 { d.styleStr(rows[i], 0, "justify-content", "flex-end"); }
        if i == 3 { d.styleNum(rows[i], 0, "width", 100.0); }
        let count = if i == 1 || i == 2 { 3 } else { 2 };
        for j in 0..count {
            let item = limitNode(&d, j, if i == 3 { "shrink" } else { "grow" });
            if i == 0 { d.styleNum(item, 0, "flex", 0.0); }
            if i == 1 || (i == 2 && j < 2) { d.styleNum(item, 0, "max-width", if i == 1 { 60.0 } else { 30.0 }); }
            if i == 3 && j == 0 { d.styleNum(item, 0, "min-width", 70.0); d.styleNum(item, 1, "max-width", 30.0); }
            d.close();
        }
        d.close();
    }
    rows[4] = limitNode(&d, 4, "conflict");
    d.styleStr(rows[4], 0, "width", "auto"); d.styleStr(rows[4], 1, "height", "auto"); d.close();
    let grid = limitNode(&d, 5, "grid");
    for j in 0..2 {
        let cell = limitNode(&d, j, "cell");
        d.styleStr(cell, 0, "margin-left", "10%"); d.close();
    }
    d.close();
    d.layout(); d.endFrame();
    let ns = &d.nodes.items;
    let first = ns[rows[0]].first;
    near(ns[first].w, 0.0, 0.01, "zero flex factors leave zero basis unchanged");
    near(ns[ns[first].next].w, 0.0, 0.01, "zero-factor sibling stays finite");
    first = ns[rows[1]].first;
    near(ns[first].w, 60.0, 0.01, "all capped items stop growing");
    near(ns[first].x, 120.0, 0.01, "unused space after all caps goes to justify-content");
    first = ns[rows[2]].first;
    near(ns[first].w, 30.0, 0.01, "first simultaneous maximum");
    first = ns[first].next;
    near(ns[first].w, 30.0, 0.01, "second simultaneous maximum");
    near(ns[ns[first].next].w, 240.0, 0.01, "remaining grow receives both frozen shares");
    first = ns[rows[3]].first;
    near(ns[first].w, 70.0, 0.01, "shrink minimum wins conflicting maximum");
    near(ns[ns[first].next].w, 30.0, 0.01, "shrink redistribution with conflicting limits");
    near(ns[rows[4]].w, 70.0, 0.01, "auto width minimum wins maximum");
    near(ns[rows[4]].h, 60.0, 0.01, "auto height minimum wins maximum");
    first = ns[grid].first;
    near(ns[first].x, 20.0, 0.01, "grid placement percent margin uses track basis");
    near(ns[ns[first].next].x, 220.0, 0.01, "second grid placement uses its track basis");
    d.beginFrame(Vec2 { x: 400.0, y: 600.0 });
    d.styleNum(0, 0, "max-width", 200.0);
    d.styleNum(0, 1, "max-height", 100.0);
    d.layout(); d.endFrame();
    near(ns[0].w, 200.0, 0.01, "root maximum width");
    near(ns[0].h, 100.0, 0.01, "root maximum height");
    let laid = d.laid;
    let styles = d.restyled;
    let used = mem.used;
    for i in 0..100 { d.layoutAt(400.0, 600.0); }
    ok(d.laid == laid && d.restyled == styles && mem.used == used, "clamped root cache stays idle");
}

// Flex item longhands share the same row/column/wrap solver and containing-block units.
fn testFlexItems(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ":root { font-size: 16px; } .row { display: flex; width: 200px; height: 100px; align-items: flex-start; } .item { width: 200px; height: 20px; min-width: 0; min-height: 0; } .col { flex-direction: column; } .wrap { flex-wrap: wrap; width: 160px; height: auto; }", "flex.css", 0);
    let d = Dom.new(mem, &css);
    d.simInput(-100.0, -100.0, false, 0.0);
    let hosts = mem.alloc::<int>(12);
    let aa = mem.alloc::<int>(12);
    let bb = mem.alloc::<int>(12);
    d.beginFrame(Vec2 { x: 400.0, y: 1800.0 });
    for i in 0..12 {
        hosts[i] = limitNode(&d, i, if i == 8 { "row col" } else if i == 9 { "row wrap" } else { "row" });
        aa[i] = limitNode(&d, 0, "item");
        if i == 0 { d.styleNum(aa[i], 0, "flex-basis", 80.0); }
        if i == 1 { d.styleNum(aa[i], 0, "flex", 1.0); d.styleStr(aa[i], 1, "flex-basis", "auto"); d.styleNum(aa[i], 2, "width", 80.0); }
        if i == 3 { d.styleNum(aa[i], 0, "min-width", 170.0); }
        if i == 4 { d.styleNum(aa[i], 0, "flex-shrink", 0.0); }
        if i == 5 { d.styleNum(aa[i], 0, "flex-shrink", 0.25); }
        if i == 6 { d.styleNum(aa[i], 0, "max-width", 60.0); }
        if i == 7 { d.styleNum(aa[i], 0, "font-size", 20.0); d.styleStr(aa[i], 1, "flex-basis", "calc(50% - 1em)"); }
        if i == 8 { d.styleNum(aa[i], 0, "flex-basis", 80.0); d.styleNum(aa[i], 1, "flex-shrink", 0.0); d.styleStr(aa[i], 2, "width", "auto"); d.styleStr(aa[i], 3, "align-self", "center"); }
        if i == 9 { d.styleNum(aa[i], 0, "flex-basis", 80.0); d.styleNum(aa[i], 1, "order", 2.0); }
        if i == 10 { d.styleNum(aa[i], 0, "width", 20.0); d.styleStr(aa[i], 1, "align-self", "flex-end"); }
        if i == 11 { d.styleStr(aa[i], 0, "box-sizing", "content-box"); d.styleStr(aa[i], 1, "padding", "0 10px"); }
        d.close();
        bb[i] = limitNode(&d, 1, "item");
        if i == 0 { d.styleNum(bb[i], 0, "width", 40.0); }
        if i == 1 { d.styleNum(bb[i], 0, "flex", 1.0); }
        if i == 2 || i == 3 { d.styleNum(bb[i], 0, "flex-shrink", 3.0); }
        if i == 4 { d.styleNum(bb[i], 0, "flex-shrink", 0.0); }
        if i == 5 { d.styleNum(bb[i], 0, "flex-shrink", 0.25); }
        if i == 7 { d.styleStr(bb[i], 0, "flex-basis", "2rem"); }
        if i == 8 { d.styleStr(bb[i], 0, "flex-basis", "50%"); d.styleStr(bb[i], 1, "width", "auto"); d.styleStr(bb[i], 2, "align-self", "stretch"); }
        if i == 9 { d.styleNum(bb[i], 0, "flex-basis", 80.0); d.styleNum(bb[i], 1, "order", -1.0); }
        if i == 10 { d.styleNum(bb[i], 0, "width", 20.0); d.styleStr(bb[i], 1, "height", "auto"); d.styleStr(bb[i], 2, "align-self", "stretch"); }
        if i == 11 { d.styleNum(bb[i], 0, "width", 100.0); }
        d.close();
        if i == 9 { let cc = limitNode(&d, 2, "item"); d.styleNum(cc, 0, "flex-basis", 80.0); d.styleNum(cc, 1, "order", -1.0); d.close(); }
        d.close();
    }
    let natural = limitNode(&d, 12, "row col");
    d.styleStr(natural, 0, "height", "auto");
    let pct = limitNode(&d, 0, "item");
    d.styleNum(pct, 0, "height", 90.0); d.styleStr(pct, 1, "flex-basis", "50%");
    let content = limitNode(&d, 0, "item"); d.styleNum(content, 0, "height", 24.0); d.close(); d.close();
    let auto = limitNode(&d, 1, "item"); d.styleStr(auto, 0, "flex-basis", "auto"); d.close(); d.close();
    let baselines = limitNode(&d, 13, "row");
    let ba = limitNode(&d, 0, "item"); d.styleStr(ba, 0, "height", "auto"); d.styleStr(ba, 1, "align-self", "baseline"); d.styleNum(ba, 2, "width", 40.0);
    let ca = limitNode(&d, 0, "item"); d.styleNum(ca, 0, "height", 30.0); d.close(); d.close();
    let bbline = limitNode(&d, 1, "item"); d.styleStr(bbline, 0, "height", "auto"); d.styleStr(bbline, 1, "align-self", "baseline"); d.styleNum(bbline, 2, "width", 40.0);
    let cb = limitNode(&d, 0, "item"); d.styleNum(cb, 0, "height", 50.0); d.close(); d.close(); d.close();
    d.layout(); d.endFrame();
    let ns = &d.nodes.items;
    near(ns[pct].h, 24.0, 0.01, "indefinite percentage basis uses content rather than specified height");
    near(ns[auto].h, 20.0, 0.01, "auto basis uses specified height");
    near(ns[natural].h, 44.0, 0.01, "indefinite column sizes to its basis contents");
    near(ns[ba].y + ns[ba].baseline, ns[bbline].y + ns[bbline].baseline, 0.01, "align-self baseline shares ascent across participating items");
    near(ns[aa[0]].w, 80.0, 0.01, "basis overrides width");
    near(ns[bb[0]].x, 80.0, 0.01, "basis determines next item position");
    near(ns[aa[1]].w, 140.0, 0.01, "explicit auto basis uses width before growth");
    near(ns[bb[1]].w, 60.0, 0.01, "numeric flex keeps zero basis");
    near(ns[aa[2]].w, 150.0, 0.01, "weighted shrink first factor");
    near(ns[bb[2]].w, 50.0, 0.01, "weighted shrink triple factor");
    near(ns[aa[3]].w, 170.0, 0.01, "shrink freezes at minimum");
    near(ns[bb[3]].w, 30.0, 0.01, "shrink redistributes after freezing");
    near(ns[aa[4]].w, 200.0, 0.01, "zero shrink keeps width");
    near(ns[bb[4]].w, 200.0, 0.01, "all zero factors overflow without division");
    near(ns[aa[5]].w, 150.0, 0.01, "fractional shrink factors can leave overflow");
    near(ns[bb[5]].w, 150.0, 0.01, "fractional sibling shrink");
    near(ns[aa[6]].w, 60.0, 0.01, "shrink maximum freezes first");
    near(ns[bb[6]].w, 140.0, 0.01, "maximum frozen share redistributes");
    near(ns[aa[7]].w, 80.0, 0.01, "basis calc percent and element em");
    near(ns[bb[7]].w, 32.0, 0.01, "basis root rem");
    near(ns[aa[8]].h, 80.0, 0.01, "column basis overrides height");
    near(ns[bb[8]].h, 20.0, 0.01, "column percentage basis shrinks");
    near(ns[aa[8]].w, 0.0, 0.01, "column align-self center uses intrinsic width");
    near(ns[aa[8]].x, 100.0, 0.01, "column self center");
    near(ns[bb[8]].w, 200.0, 0.01, "column self stretch");
    near(ns[bb[9]].x, 0.0, 0.01, "negative order starts first line");
    near(ns[ns[bb[9]].next].x, 80.0, 0.01, "tied order remains source stable");
    near(ns[aa[9]].y, 20.0, 0.01, "order participates in wrapping");
    ok(ns[hosts[9]].first == aa[9] && ns[aa[9]].next == bb[9], "visual order preserves DOM links");
    near(ns[aa[10]].y, 80.0, 0.01, "row align-self end");
    near(ns[bb[10]].h, 100.0, 0.01, "row align-self stretch overrides start");
    near(ns[aa[11]].w, 140.0, 0.01, "shrink weights exclude padding");
    near(ns[bb[11]].w, 60.0, 0.01, "padding is retained outside weighted content");
    d.styleStr(aa[0], 0, "flex-basis", "50%");
    d.styleNum(hosts[0], 0, "width", 300.0);
    d.styleNum(aa[9], 1, "order", -2.0);
    d.layoutAt(400.0, 1800.0);
    near(ns[aa[0]].w, 150.0, 0.01, "basis percent follows resized containing width");
    near(ns[aa[9]].x, 0.0, 0.01, "dynamic order rebuilds visual links and geometry");
    d.styleStr(aa[0], 0, "flex-basis", "");
    d.styleStr(aa[9], 1, "order", "");
    d.styleStr(bb[9], 1, "order", "");
    d.styleStr(ns[bb[9]].next, 1, "order", "");
    d.layoutAt(400.0, 1800.0);
    near(ns[aa[0]].w, 200.0, 0.01, "removing basis restores width");
    ok(!ns[hosts[9]].ordered, "removing order restores ordinary paint path");
    d.styleNum(aa[0], 0, "flex-basis", -1.0);
    d.styleNum(aa[9], 1, "order", 0.5);
    d.styleNum(aa[2], 0, "flex-shrink", -1.0);
    d.layoutAt(400.0, 1800.0);
    ok(css.warns.len == 3, "invalid numeric flex longhands warn and clear overrides");
    near(ns[aa[0]].w, 200.0, 0.01, "negative numeric basis is ignored");
    ok(!ns[hosts[9]].ordered, "fractional numeric order is ignored");
    let laid = d.laid;
    let styles = d.restyled;
    let used = mem.used;
    for j in 0..100 { d.layoutAt(400.0, 1800.0); }
    ok(d.laid == laid && d.restyled == styles && mem.used == used, "flex longhands steady frame has zero layout restyle or growth");
}

fn testFixedOrder(mem: &Arena) {
    for mode in 0..6 {
        let css = Css.new(mem);
        parse(&css, ".flex { display: flex; width: 100px; height: 100px; flex-direction: row-reverse; flex-wrap: wrap-reverse; } .fixed { position: fixed; left: 0; top: 0; width: 80px; height: 80px; } .absolute { position: absolute; left: 0; top: 0; width: 70px; height: 70px; } .clip { width: 10px; height: 10px; overflow: hidden; }", "fixed-order.css", 0);
        let d = Dom.new(mem, &css);
        d.simInput(20.0, 20.0, false, 0.0);
        d.beginFrame(Vec2 { x: 100.0, y: 100.0 });
        let host = limitNode(&d, 0, if mode == 2 { "" } else if mode == 5 { "flex clip" } else { "flex" });
        let inner = -1;
        if mode == 2 { inner = limitNode(&d, 0, "flex"); }
        let pa = -1;
        if mode == 1 { pa = limitNode(&d, 0, ""); d.styleNum(pa, 0, "order", 2.0); }
        let a = limitNode(&d, 0, "fixed");
        d.styleNum(a, 0, "order", 2.0);
        if mode == 4 { d.styleNum(a, 1, "z-index", 1.0); }
        let absolute = -1;
        if mode == 3 { absolute = limitNode(&d, 0, "absolute"); d.close(); }
        d.close();
        if mode == 1 { d.close(); }
        let pb = -1;
        if mode == 1 { pb = limitNode(&d, 1, ""); d.styleNum(pb, 0, "order", 1.0); }
        let b = limitNode(&d, 1, "fixed");
        d.styleNum(b, 0, "order", 1.0);
        if mode == 4 { d.styleNum(b, 1, "z-index", 2.0); }
        d.close();
        if mode == 1 { d.close(); }
        if mode == 2 { d.close(); }
        d.close(); d.layout(); d.endFrame();
        d.beginFrame(Vec2 { x: 100.0, y: 100.0 });
        ok(d.hover == (if mode == 3 { absolute } else if mode == 4 { b } else { a }), "fixed hits follow visual ancestry, descendants and layer priority");
        if mode == 1 { d.styleNum(pa, 0, "order", 0.0); } else { d.styleNum(a, 0, "order", 0.0); }
        d.layoutAt(100.0, 100.0);
        d.beginFrame(Vec2 { x: 100.0, y: 100.0 });
        ok(d.hover == b, "dynamic order updates fixed hit priority");
        if mode == 3 {
            d.styleNum(absolute, 0, "z-index", 3.0);
            d.layoutAt(100.0, 100.0);
            d.beginFrame(Vec2 { x: 100.0, y: 100.0 });
            ok(d.hover == b, "z-index inside a fixed box is relative to it: it does not outrank a later fixed sibling");
        }
        let pop = d.popRoot(a, d.tag("div"));
        d.clsDyn(pop, "fixed");
        d.layoutAt(100.0, 100.0);
        d.beginFrame(Vec2 { x: 100.0, y: 100.0 });
        ok(d.hover == pop, "runtime overlay layer stays above ordered fixed nodes");
        d.dropRoot();
        d.layoutAt(100.0, 100.0);
        d.beginFrame(Vec2 { x: 100.0, y: 100.0 });
        ok(d.hover == b, "closing overlay restores visual fixed priority");
        ok(d.nodes.items[a].next == (if mode == 1 { -1 } else { b }), "fixed hit ordering preserves source links");
    }
}

// Physical gaps/margins are not reversed; flex start/end and line progression are.
fn testFlexReverse(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ".host { display: flex; box-sizing: border-box; width: 220px; height: 120px; padding: 7px 11px 13px 9px; gap: 6px 10px; align-items: flex-start; align-content: flex-start; } .item { width: 40px; height: 30px; margin: 2px 3px 4px 5px; flex-shrink: 0; min-width: 0; min-height: 0; }", "reverse.css", 0);
    ok(css.warns.len == 0, "reverse fixture parses");
    let d = Dom.new(mem, &css);
    d.simInput(-100.0, -100.0, false, 0.0);
    let hosts = mem.alloc::<int>(16);
    let items = mem.alloc::<int>(48);
    d.beginFrame(Vec2 { x: 500.0, y: 2000.0 });
    for i in 0..16 {
        hosts[i] = limitNode(&d, i, "host");
        if i == 0 || i == 2 || i == 15 { d.styleStr(hosts[i], 0, "flex-direction", "row-reverse"); }
        if i >= 3 && i != 15 { d.styleStr(hosts[i], 0, "flex-direction", if i == 3 || i == 6 { "column-reverse" } else { "column" }); }
        if i == 1 || i == 2 || i >= 4 { d.styleStr(hosts[i], 1, "flex-wrap", if i == 2 || i == 5 || i == 6 || i == 15 { "wrap-reverse" } else { "wrap" }); }
        if i == 1 || i == 2 { d.styleNum(hosts[i], 2, "width", 126.0); }
        if i == 7 { d.styleStr(hosts[i], 2, "height", "auto"); }
        if i == 8 { d.styleStr(hosts[i], 2, "align-content", "space-between"); }
        if i == 9 { d.styleStr(hosts[i], 2, "align-content", "stretch"); }
        if i == 10 { d.styleNum(hosts[i], 2, "height", 20.0); }
        if i == 14 { d.styleStr(hosts[i], 0, "flex-direction", "row"); d.styleStr(hosts[i], 1, "flex-wrap", "wrap-reverse"); d.styleNum(hosts[i], 2, "width", 126.0); d.styleStr(hosts[i], 3, "align-items", "baseline"); }
        if i == 13 { d.styleNum(hosts[i], 2, "height", 20.0); }
        for j in 0..(if i == 12 { 0 } else if i == 15 { 1 } else { 3 }) {
            items[i * 3 + j] = limitNode(&d, j, "item");
            let it = items[i * 3 + j];
            if i == 6 { d.styleNum(it, 0, "order", 2.0 - f32(j)); }
            if i == 9 { d.styleStr(it, 0, "width", "auto"); d.styleStr(it, 1, "align-self", "stretch"); }
            if i == 14 && j < 2 { let inner = limitNode(&d, 0, ""); d.styleNum(inner, 0, "height", if j == 0 { 10.0 } else { 20.0 }); d.close(); }
            if i == 13 { d.styleNum(it, 0, "width", 0.0); d.styleNum(it, 1, "height", 0.0); d.styleStr(it, 2, "margin", "0"); }
            if i == 11 { d.styleStr(it, 0, "flex-basis", "calc(50% - 14px)"); }
            d.close();
        }
        d.close();
    }
    d.layout(); d.endFrame();
    let ns = &d.nodes.items;
    near(ns[items[0]].x, 166.0, 0.01, "row reverse right margin and padding");
    near(ns[items[1]].x, 108.0, 0.01, "row reverse physical column gap");
    near(ns[items[3]].y, 9.0, 0.01, "wrap first row");
    near(ns[items[5]].y, 51.0, 0.01, "wrap last row uses row gap");
    near(ns[items[6]].y, 73.0, 0.01, "wrap reverse first row from bottom");
    near(ns[items[8]].y, 31.0, 0.01, "wrap reverse second row");
    near(ns[items[9]].y, 73.0, 0.01, "column reverse bottom margin and padding");
    near(ns[items[10]].y, 31.0, 0.01, "column reverse row gap");
    near(ns[items[12]].x, 14.0, 0.01, "column wrap first column");
    near(ns[items[14]].x, 72.0, 0.01, "column wrap next column gap");
    near(ns[items[15]].x, 166.0, 0.01, "column wrap reverse right edge");
    near(ns[items[17]].x, 108.0, 0.01, "column wrap reverse column gap");
    near(ns[items[20]].y, 73.0, 0.01, "order before column reverse placement");
    near(ns[items[18]].x, 108.0, 0.01, "order before wrap reverse placement");
    ok(ns[items[18]].next == items[19], "reverse keeps source links");
    near(ns[items[23]].x, 14.0, 0.01, "indefinite column does not wrap");
    near(ns[hosts[7]].h, 140.0, 0.01, "indefinite column natural height");
    near(ns[items[26]].x, 166.0, 0.01, "column align content space between");
    near(ns[items[27]].w, 87.0, 0.01, "column stretch shares cross space");
    near(ns[items[29]].x, 119.0, 0.01, "column stretch second column");
    near(ns[items[30]].y, 9.0, 0.01, "oversized first item starts first line");
    near(ns[items[31]].x, 72.0, 0.01, "oversized item starts next column without empty line");
    near(ns[items[33]].h, 36.0, 0.01, "column percentage calc basis");
    near(ns[hosts[12]].h, 120.0, 0.01, "empty wrapped column keeps definite height");
    near(ns[items[39]].h, 0.0, 0.01, "zero height item stays finite");
    near(ns[items[40]].x, 19.0, 0.01, "zero items wrap only at physical positive row gaps");
    near(ns[items[42]].y + ns[items[42]].baseline, ns[items[43]].y + ns[items[43]].baseline, 0.01, "wrap reverse keeps physical baselines aligned");
    near(ns[items[42]].baseline, 10.0, 0.01, "baseline comes from shorter inner content");
    near(ns[items[43]].baseline, 20.0, 0.01, "baseline comes from taller inner content");
    near(ns[items[42]].y, 73.0, 0.01, "wrap reverse baseline includes ascent and descent");
    near(ns[items[43]].y, 63.0, 0.01, "wrap reverse unequal baseline ascent");
    near(ns[items[45]].x, 166.0, 0.01, "single reverse item uses main start");
    near(ns[items[45]].y, 73.0, 0.01, "single wrap reverse line uses cross start");
    near(ns[items[11]].y, -11.0, 0.01, "negative free space overflows reversed column start");
    near(ns[items[11]].h, 30.0, 0.01, "negative free space retains zero shrink item height");
    d.styleStr(hosts[10], 3, "overflow-y", "auto");
    d.layoutAt(500.0, 2000.0);
    near(ns[hosts[10]].contentH, 56.0, 0.01, "oversized wrapped column preserves main content extent");
    near(ns[hosts[10]].scrollMax, 36.0, 0.01, "oversized wrapped column keeps vertical scroll range");
    d.styleStr(hosts[14], 4, "align-content", "stretch");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[42]].y, 73.0, 0.01, "stretched reversed first line anchors full baseline group at bottom");
    near(ns[items[43]].y, 63.0, 0.01, "stretched reversed unequal ascent keeps shared baseline");
    near(ns[items[44]].y, 15.0, 0.01, "stretched reversed second line anchors its baseline group");
    d.styleNum(hosts[14], 2, "width", 200.0);
    d.styleNum(hosts[14], 5, "height", 100.0);
    d.styleStr(hosts[14], 6, "padding", "0");
    d.styleStr(hosts[14], 7, "gap", "0");
    for i in 42..45 { d.styleStr(items[i], 2, "margin", "0"); }
    d.styleStr(items[44], 3, "display", "none");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[42]].y, 70.0, 0.01, "100px reversed stretched line short ascent matches browser");
    near(ns[items[43]].y, 60.0, 0.01, "100px reversed stretched line tall ascent matches browser");
    near(ns[items[42]].y + ns[items[42]].baseline, 80.0, 0.01, "reversed stretched group baseline is 80px");
    d.styleStr(hosts[14], 1, "flex-wrap", "wrap");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[42]].y, 10.0, 0.01, "normal stretched baseline group remains at physical top");
    near(ns[items[43]].y, 0.0, 0.01, "normal unequal ascent keeps original baseline alignment");
    d.styleStr(hosts[14], 1, "flex-wrap", "wrap-reverse");
    d.styleStr(hosts[14], 4, "align-content", "flex-start");
    d.styleStr(items[44], 3, "display", "block");
    d.styleNum(items[44], 4, "height", 80.0);
    d.styleStr(items[44], 5, "align-self", "flex-start");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[42]].y, 70.0, 0.01, "tall nonbaseline sibling leaves reversed baseline group at cross start");
    near(ns[items[43]].y, 60.0, 0.01, "tall nonbaseline sibling preserves baseline sharing");
    near(ns[items[44]].y, 20.0, 0.01, "nonbaseline sibling enlarges reversed line independently");
    d.styleNum(items[6], 0, "height", 10.0);
    d.styleStr(items[6], 1, "align-self", "center");
    d.styleNum(items[16], 0, "width", 20.0);
    d.styleStr(items[16], 1, "align-self", "center");
    d.styleStr(hosts[0], 3, "justify-content", "flex-end");
    d.styleStr(hosts[7], 3, "flex-direction", "column-reverse");
    d.styleStr(items[27], 2, "max-width", "calc(50% - 40px)");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[6]].y, 83.0, 0.01, "row wrap reverse align self center uses physical vertical margins");
    near(ns[items[16]].x, 176.0, 0.01, "wrap reverse align self center keeps physical margins");
    near(ns[items[0]].x, 130.0, 0.01, "row reverse justify end uses reversed main start");
    near(ns[items[21]].y, 93.0, 0.01, "indefinite column reverse uses natural main extent");
    near(ns[items[27]].w, 60.0, 0.01, "wrapped column stretch honors percentage calc maximum");
    d.styleStr(items[16], 1, "align-self", "flex-end");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[16]].x, 166.0, 0.01, "wrap reverse align self end uses reversed cross start");
    d.styleStr(hosts[5], 4, "align-items", "baseline");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[15]].x, 166.0, 0.01, "column baseline fallback keeps reversed physical cross start");
    d.styleStr(hosts[5], 3, "align-content", "flex-end");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[15]].x, 72.0, 0.01, "wrap reverse align content end moves lines toward physical left");
    d.styleNum(hosts[4], 3, "height", 60.0);
    d.layoutAt(500.0, 2000.0);
    near(ns[items[13]].x, 72.0, 0.01, "resized definite column rewraps");
    d.styleStr(hosts[4], 3, "height", "auto");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[14]].x, 14.0, 0.01, "removing definite height unwraps column");
    d.styleNum(hosts[4], 3, "height", 120.0);
    d.styleNum(hosts[4], 4, "max-height", 60.0);
    d.layoutAt(500.0, 2000.0);
    near(ns[items[14]].x, 130.0, 0.01, "max height change invalidates column wrap cache");
    d.styleStr(hosts[4], 4, "max-height", "none");
    d.styleStr(items[12], 0, "flex-basis", "60%");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[13]].x, 72.0, 0.01, "dynamic percentage basis changes line membership");
    d.styleStr(items[12], 0, "flex-basis", "auto");
    d.styleStr(hosts[4], 1, "flex-wrap", "nowrap");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[14]].x, 14.0, 0.01, "dynamic nowrap clears column offsets");
    d.styleStr(hosts[4], 0, "flex-direction", "row-reverse");
    d.styleStr(hosts[4], 1, "flex-wrap", "wrap-reverse");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[12]].x, 166.0, 0.01, "dynamic direction replaces stale column main coordinate");
    near(ns[items[12]].y, 73.0, 0.01, "dynamic wrap reverse replaces stale column cross coordinate");
    d.styleStr(hosts[0], 3, "justify-content", "flex-start");
    d.styleStr(hosts[0], 4, "border-width", "1px 2px 3px 4px");
    d.styleNum(hosts[2], 2, "width", 132.0);
    d.styleStr(hosts[2], 4, "border-width", "1px 2px 3px 4px");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[0]].x, 164.0, 0.01, "row reverse unequal right border");
    near(ns[items[0]].y, 10.0, 0.01, "row reverse unequal top border");
    near(ns[items[6]].y, 80.0, 0.01, "wrap reverse unequal bottom border and center margins");
    d.styleStr(items[0], 0, "margin", "auto");
    d.layoutAt(500.0, 2000.0);
    near(ns[items[0]].x, 148.0, 0.01, "reverse: auto margins split the free space, so the item leaves the start edge");
    d.styleNum(hosts[0], 2, "width", 100.0);
    d.layoutAt(500.0, 2000.0);
    near(ns[items[2]].x, -64.0, 0.01, "negative row free space overflows without reversing paint order");
    let laid = d.laid; let styled = d.restyled; let used = mem.used;
    for i in 0..100 { d.layoutAt(500.0, 2000.0); }
    ok(d.laid == laid && d.restyled == styled && mem.used == used, "reverse and wrapping caches stay idle");
}

// ---- margin auto, aspect-ratio, :last-child ----------------------------------------------------------

const ASHEET: string = ".box { width: 100px; height: 20px; margin: 0 auto; } .row { display: flex; width: 300px; height: 100px; } .row .c { width: 50px; height: 20px; margin: auto; } .row2 { display: flex; width: 300px; } .row2 div { width: 50px; height: 10px; } .row2 .r { margin-left: auto; } .rel { position: relative; width: 200px; height: 100px; } .rel .p { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: 40px; height: 20px; margin: auto; } .ar { width: 200px; aspect-ratio: 2; } .arh { height: 50px; aspect-ratio: 2; } .col { display: flex; flex-direction: column; width: 300px; height: 100px; } .col .f { margin-top: auto; height: 10px; } .rowc { display: flex; width: 300px; height: 100px; } .rowc .g { margin: auto; } .rowc .g div { width: 20px; height: 10px; }";

#[singleton]
let AM: [16]int;

#[singleton]
let AMN: int;

fn aframe(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    let page = d.open(0, d.tag("div"), 1);
    let box = d.open(0, d.tag("div"), 1);
    d.cls(box, "box");
    AM[0] = box;
    d.close();
    let row = d.open(1, d.tag("div"), 1);
    d.cls(row, "row");
    let c = d.open(0, d.tag("div"), 1);
    d.cls(c, "c");
    AM[1] = c;
    d.close();
    d.close();
    let row2 = d.open(2, d.tag("div"), 1);
    d.cls(row2, "row2");
    let ra = d.open(0, d.tag("div"), 1);
    AM[2] = ra;
    d.close();
    let rb = d.open(1, d.tag("div"), 1);
    d.cls(rb, "r");
    AM[3] = rb;
    d.close();
    d.close();
    let rel = d.open(3, d.tag("div"), 1);
    d.cls(rel, "rel");
    let p = d.open(0, d.tag("div"), 1);
    d.cls(p, "p");
    AM[4] = p;
    d.close();
    d.close();
    let ar = d.open(4, d.tag("div"), 1);
    d.cls(ar, "ar");
    AM[5] = ar;
    d.close();
    let arh = d.open(5, d.tag("div"), 1);
    d.cls(arh, "arh");
    AM[6] = arh;
    d.close();
    let col = d.open(6, d.tag("div"), 1);
    d.cls(col, "col");
    let f = d.open(0, d.tag("div"), 1);
    d.cls(f, "f");
    AM[7] = f;
    d.close();
    d.close();
    let rowc = d.open(7, d.tag("div"), 1);
    d.cls(rowc, "rowc");
    let g = d.open(0, d.tag("div"), 1);
    d.cls(g, "g");
    AM[8] = g;
    let gi = d.open(0, d.tag("div"), 1);
    AM[9] = gi;
    d.close();
    d.close();
    d.close();
    let list = d.open(8, d.tag("div"), 1);
    AM[10] = list;
    for i in 0..AMN {
        let it = d.open(i, d.tag("div"), 1);
        AM[11 + i] = it;
        d.close();
    }
    d.close();
    d.close();
    d.layout();
    d.endFrame();
}

fn testAutoMargin(mem: &Arena) {
    let css = Css.new(mem);
    parse(&css, ASHEET, "auto.css", 0);
    ok(css.warns.len == 0, "margin / aspect-ratio sheet parses without a warning");
    let d = Dom.new(mem, &css);
    d.setFrameMs(16.0);
    d.simInput(-5.0, -5.0, false, 0.0);
    AMN = 3;
    aframe(&d);
    aframe(&d);
    let it = &d.nodes.items;
    near(it[AM[0]].x, 350.0, 0.01, "block: width 100 and margin 0 auto centers in 800");
    near(it[AM[1]].x, 125.0, 0.01, "flex: margin auto centers on the main axis");
    near(it[AM[1]].y, 40.0, 0.01, "flex: margin auto centers on the cross axis");
    near(it[AM[2]].x, 0.0, 0.01, "flex: the first item stays at the start");
    near(it[AM[3]].x, 250.0, 0.01, "flex: margin-left auto pushes the item to the end");
    near(it[AM[4]].x, 80.0, 0.01, "absolute: left/right 0 with margin auto centers");
    near(it[AM[4]].y, 40.0, 0.01, "absolute: top/bottom 0 with margin auto centers");
    near(it[AM[5]].h, 100.0, 0.01, "aspect-ratio 2 with width 200 is 100 high");
    near(it[AM[6]].w, 100.0, 0.01, "aspect-ratio 2 with height 50 is 100 wide");
    near(it[AM[7]].y, 90.0, 0.01, "column flex: margin-top auto pushes the item to the bottom");
    near(it[AM[8]].x, 140.0, 0.01, "flex item with auto size and margin auto is centered, not stretched (x)");
    near(it[AM[8]].y, 45.0, 0.01, "(y)");
    ok((d.mnodes.items[AM[13]].flags / FL_LAST_CHILD) % 2 == 1, ":last-child flag on the last element");
    ok((d.mnodes.items[AM[12]].flags / FL_LAST_CHILD) % 2 == 0 && (d.mnodes.items[AM[11]].flags / FL_LAST_CHILD) % 2 == 0, "and not on the others");
    AMN = 4;
    aframe(&d);
    ok((d.mnodes.items[AM[14]].flags / FL_LAST_CHILD) % 2 == 1 && (d.mnodes.items[AM[13]].flags / FL_LAST_CHILD) % 2 == 0, "appending moves :last-child");
    AMN = 2;
    aframe(&d);
    ok((d.mnodes.items[AM[12]].flags / FL_LAST_CHILD) % 2 == 1, "removing the tail hands :last-child back");
}

fn main() {
    let mem = Arena.create(256 * 1024 * 1024);
    testAutoMargin(&mem);
    testFlexReverse(&mem);
    testFixedOrder(&mem);
    testFlexItems(&mem);
    testLimits(&mem);
    testLimitEdges(&mem);
    testMath();
    testMedia(&mem);
    testWrapCalc(&mem);
    testEmRem(&mem);
    let css = Css.new(&mem);
    parse(&css, SHEET, "layout.css", 1);
    ok(css.warns.len == 0, "the test sheet parses with no warning");
    testResponsive(&mem, &css);
    testSticky(&mem, &css);
    testPanels(&mem, &css);
    printLn(`layout_test ok, checks passed: {CHECKS}`);
}
