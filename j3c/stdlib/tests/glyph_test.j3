// Tests for `<glyph>` input prompts through j3.ui.dom (`d.glyph`, the way generated code calls it) with j3.ui.padnav's last-used-device flag:
// the label per device (Enter / A), the pad styles (xbox, playstation, nintendo, generic), the live switch from synthetic pad input to a
// mouse move and back, explicit key / pad attributes, a game's own binding replacing the table, a dynamic action, the accessible name and
// role, the layout width changing on a switch, only the glyphs restyling on a switch and nothing on idle frames. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/glyph_test.j3 --headless
// Panics on the first failed check.

module glyph_test;

use j3.game.{ fontHas, tryLoadFont };
use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.same;
use j3.ui.a11y;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.padin;
use j3.ui.uastyle;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, p, button, glyph { font-family: \"T\"; font-size: 16px; } @font-face { font-family: \"O\"; src: url(\"/usr/share/fonts/truetype/open-sans/OpenSans-Regular.ttf\"); } .os { font-family: \"O\"; } * { margin: 0; }";

#[singleton]
let CHECKS: int;
#[singleton]
let ID: [9]int;
#[singleton]
let ACT: string;
#[singleton]
let SHOW: bool;

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

fn glyph(d: &Dom, k: int, action: string, key: string, pad: string) {
    let g = d.open(k, d.tag("glyph"), 1);
    d.glyph(g, action, key, pad);
    ID[k] = g;
    d.close();
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    d.open(0, d.tag("p"), 1);
    d.text("Press ");
    glyph(d, 0, "confirm", "", "");
    d.text(" or ");
    glyph(d, 1, "back", "", "");
    d.close();
    d.open(1, d.tag("div"), 1);
    glyph(d, 2, "", "Space", "x");
    glyph(d, 3, "jump", "", "");
    glyph(d, 4, ACT, "", "");
    glyph(d, 5, "", "", "rt");
    glyph(d, 6, "page-down", "", "");
    d.close();
    let o = d.open(3, d.tag("glyph"), 1);
    d.cls(o, "os");
    d.glyph(o, "", "", "a");
    ID[8] = o;
    d.close();
    let b = d.open(2, d.tag("button"), 1);
    ID[7] = b;
    d.text("Plain");
    d.close();
    d.layout();
    d.endFrame();
}

fn label(d: &Dom, k: int): string {
    let f = d.nodes.items[ID[k]].first;
    return if f >= 0 { d.textOf(f) } else { "" };
}

fn dev(d: &Dom, k: int): string {
    return d.css.name(d.mnodes.items[ID[k]].type);
}

fn press(d: &Dom, names: string) {
    d.setPad(padin.parse(names));
    frame(d);
    d.setPad(padin.parse(""));
    frame(d);
}

fn mouse(d: &Dom) {
    d.simInput(100.0, 300.0, false, 0.0);
    frame(d);
    d.simInput(300.0, 500.0, false, 0.0);
    frame(d);
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    uastyle.load(&css);
    parse(&css, SHEET, "glyph.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    a11y.enable(&d);
    ACT = "next";
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(&d);
    frame(&d);

    // keyboard: keycaps
    ok(same(label(&d, 0), "Enter") && same(dev(&d, 0), "key"), "confirm shows Enter with the keyboard");
    ok(same(label(&d, 1), "Esc"), "back shows Esc");
    ok(same(label(&d, 2), "Space"), "an explicit key shows as written");
    ok(same(label(&d, 3), "jump"), "an action nobody knows shows its name");
    ok(same(label(&d, 4), "Tab"), "a dynamic action");
    ok(same(label(&d, 5), "RT") && same(dev(&d, 5), "pad"), "pad= alone has no key: it shows the pad label even on the keyboard");
    ok(same(label(&d, 6), "PgDn"), "page-down is PgDn");
    ok(d.nodes.items[ID[0]].w > 20.0 && d.nodes.items[ID[0]].h > 10.0, "a glyph is a laid-out box");
    let wKey = d.nodes.items[ID[0]].w;
    ok(same(a11y.role(&d, ID[0]), "img"), "role img");
    ok(same(a11y.name(&d, &mem, ID[0]), "Enter"), "name is the key label");
    ok(same(d.ariaOf(ID[0]), "Enter"), "aria-label is the key label");

    // to the pad: xbox labels, pill type, narrower box
    press(&d, "LB");
    ok(same(label(&d, 0), "A") && same(dev(&d, 0), "pad"), "confirm shows A once the pad is used");
    ok(same(label(&d, 1), "B"), "back shows B");
    ok(same(label(&d, 2), "X"), "an explicit pad button wins on the pad");
    ok(same(label(&d, 3), "jump"), "an unknown action with nothing bound still shows its name");
    ok(same(label(&d, 4), "RB") && same(label(&d, 5), "RT") && same(label(&d, 6), "RT"), "shoulders and triggers");
    ok(d.nodes.items[ID[0]].w < wKey, "the pad box is narrower than the Enter keycap");
    ok(same(a11y.name(&d, &mem, ID[0]), "A button") && same(d.ariaOf(ID[1]), "B button"), "the pad name is 'A button'");

    // back to the keyboard by a mouse move
    mouse(&d);
    ok(same(label(&d, 0), "Enter") && same(dev(&d, 0), "key") && d.nodes.items[ID[0]].w == wKey, "a mouse move brings the keyboard prompts back");
    ok(same(label(&d, 2), "Space"), "explicit key again");
    press(&d, "B");
    ok(same(label(&d, 0), "A"), "and the pad again");

    // styles
    d.setGlyphStyle("playstation");
    frame(&d);
    ok(same(label(&d, 0), "✕") && same(label(&d, 1), "○") && same(label(&d, 2), "□") && same(label(&d, 4), "R1") && same(label(&d, 6), "R2"), "playstation labels");
    // a glyph in a font without the symbols (Open Sans, when installed and when SDL_ttf can say) names the face buttons instead
    let os = tryLoadFont("/usr/share/fonts/truetype/open-sans/OpenSans-Regular.ttf", 12);
    if os.raw != 0 && !fontHas(os, 10005) {
        ok(same(label(&d, 8), "Cross"), "a font without the symbols falls back to a name");
    } else {
        printLn("glyph_test: no font without the PlayStation symbols here, fallback left to golden 69 psplain");
    }
    d.setGlyphStyle("nintendo");
    frame(&d);
    ok(same(label(&d, 0), "B") && same(label(&d, 1), "A") && same(label(&d, 2), "Y") && same(label(&d, 4), "R") && same(label(&d, 6), "ZR"), "nintendo swaps A and B");
    d.setGlyphStyle("generic");
    frame(&d);
    ok(same(label(&d, 0), "South") && same(label(&d, 4), "R1"), "generic labels");
    let w0 = css.warns.len;
    d.setGlyphStyle("sega");
    ok(css.warns.len == w0 + 1, "an unknown style warns");
    frame(&d);
    ok(same(label(&d, 0), "A"), "and falls back to xbox");

    // the keyboard is unaffected by the pad style
    mouse(&d);
    d.setGlyphStyle("playstation");
    frame(&d);
    ok(same(label(&d, 0), "Enter"), "a pad style does not change key labels");
    d.setGlyphStyle("xbox");

    // a game's own binding replaces the table (and a rebinding screen can call it again)
    d.setGlyphBinding("confirm", "Return", "x");
    d.setGlyphBinding("jump", "Space", "y");
    frame(&d);
    ok(same(label(&d, 0), "Return") && same(label(&d, 3), "Space"), "bindings replace the keyboard table");
    press(&d, "A");
    ok(same(label(&d, 0), "X") && same(label(&d, 3), "Y") && same(label(&d, 1), "B"), "bindings replace the pad table; other actions keep theirs");
    d.setGlyphBinding("confirm", "Enter", "");
    frame(&d);
    ok(same(label(&d, 0), "A"), "an empty button keeps the built-in for that device");
    mouse(&d);
    ok(same(label(&d, 0), "Enter"), "rebound again");
    d.setGlyphBinding("confirm", "", "");

    // a key press (no mouse move) after pad use brings the keyboard back, and the pad again on a button
    press(&d, "A");
    ok(same(dev(&d, 0), "pad"), "pad in use");
    d.simKeys("", "Tab");
    frame(&d);
    frame(&d);
    ok(same(dev(&d, 0), "key") && same(label(&d, 0), "Enter"), "a key press switches to the keyboard glyphs");
    press(&d, "A");
    ok(same(dev(&d, 0), "pad"), "and a pad button back");

    // pad names beyond the face buttons: start, select, ls, rs, per style
    d.setGlyphBinding("jump", "Space", "start");
    d.setGlyphBinding("page-down", "PgDn", "select");
    frame(&d);
    ok(same(label(&d, 3), "Menu") && same(label(&d, 6), "View"), "start and select on xbox");
    d.setGlyphStyle("playstation");
    frame(&d);
    ok(same(label(&d, 3), "Options") && same(label(&d, 6), "Share"), "start and select on playstation");
    d.setGlyphStyle("nintendo");
    frame(&d);
    ok(same(label(&d, 3), "+") && same(label(&d, 6), "-"), "start and select on nintendo");
    d.setGlyphStyle("xbox");
    d.setGlyphBinding("jump", "Space", "ls");
    frame(&d);
    ok(same(label(&d, 3), "LS"), "left stick press");
    d.setGlyphBinding("jump", "", "");
    d.setGlyphBinding("page-down", "", "");
    mouse(&d);

    // switching devices over and over keeps the arena flat
    // after a warm-up (each buffer reaches its size once)
    let used0 = 0;
    for i in 0..10100 {
        if i == 100 { used0 = mem.used; }
        if i % 2 == 0 { d.setPad(padin.parse("LB")); } else { d.simKeys("", "Tab"); }
        frame(&d);
        d.setGlyphBinding("confirm", "Enter", "a");
    }
    d.setPad(padin.parse(""));
    ok(mem.used == used0, "10000 device switches allocate nothing");
    mouse(&d);

    // a dynamic action
    ACT = "scroll";
    frame(&d);
    ok(same(label(&d, 4), "Wheel"), "the action expression is re-read");

    // only glyphs restyle on a switch
    frame(&d);
    let r0 = d.restyled;
    let l0 = d.laid;
    for i in 0..5 { frame(&d); }
    ok(d.restyled == r0 && d.laid == l0, "idle frames neither restyle nor lay out");
    d.setPad(padin.parse("A"));
    frame(&d);
    d.setPad(padin.parse(""));
    let r1 = d.restyled;
    ok(same(label(&d, 0), "A"), "switched");
    ok(r1 - r0 >= 1 && r1 - r0 <= 14 && d.laid - l0 <= 9, "a switch restyles and lays out only the glyph boxes, their text and the two lines holding them");
    frame(&d);
    let r2 = d.restyled;
    let l2 = d.laid;
    for i in 0..5 { frame(&d); }
    ok(d.restyled == r2 && d.laid == l2, "steady again after the switch");
    ok(d.nodes.items[ID[7]].w > 0.0, "the plain button is untouched");

    printLn(`glyph_test: {CHECKS} checks passed`);
}
