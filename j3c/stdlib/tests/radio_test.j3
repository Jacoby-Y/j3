// Tests for `<input type="radio">` through j3.ui.dom + j3.ui.inputs, driving the dom the way the generated code does (`attrRadio`, `changed`,
// `userToggled`): clicks and `<label>` clicks check one radio of a `name` group and uncheck the rest, `on:change` fires on the newly checked one
// only, two groups with one name in different `role="radiogroup"` scopes are independent, arrows move focus and the check (wrapping, skipping
// disabled), Space checks the focused one, Tab has one stop per group (Shift+Tab too), `bind:group` goes both ways for strings and ints,
// `bind:checked` sees every flip, and the a11y tree has role, checked, group and events. Run from the repo root, headless:
//   SDL_VIDEODRIVER=offscreen SDL_AUDIODRIVER=dummy timeout 60 j3c run j3c/stdlib/tests/radio_test.j3 --headless
// Panics on the first failed check.

module radio_test;

use j3.io.printLn;
use j3.math.Vec2;
use j3.memory.Arena;
use j3.sys.panic;
use j3.text.{ contains, same, Text };
use j3.ui.a11y;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom;
use j3.ui.dom.Dom;
use j3.ui.inputs;
use j3.ui.testkit;

const SHEET: string = "@font-face { font-family: \"T\"; src: url(\"examples/big_ui_test/assets/font.ttf\"); } div, label, button, span { font-family: \"T\"; font-size: 16px; } label { display: block; } .sc { display: block; height: 40px; overflow-y: auto; } .sp { display: block; height: 200px; }";

#[singleton]
let CHECKS: int;
#[singleton]
let G1: string;      // group 1 (string), scope A
#[singleton]
let G2: string;      // the same name in scope B
#[singleton]
let N: int;          // int group
#[singleton]
let SHOW_D: bool;     // radio 3 is in the tree
#[singleton]
let FORCE_A: bool;    // the program writes G1 = "a" right after group A built, as a handler would
#[singleton]
let ZN: bool;         // radio 10 is named z2
#[singleton]
let Z: [2]bool;      // bind:checked radios, name "z"
#[singleton]
let CHG: [20]int;    // on:change counts per radio slot
#[singleton]
let WB: [20]int;     // userToggled counts per radio slot
#[singleton]
let ID: [20]int;
#[singleton]
let AR: int;         // the radios in the scroll box     // node ids per slot: 0..3 scope A a b c(disabled) d, 4..5 scope B x y, 6..8 ints 1 2 3, 9..10 z, 11 pre, 12 post, 13 and 16 buttons around the scroll box, 14 and 15 its radios

fn ok(cond: bool, msg: string) {
    CHECKS += 1;
    if !cond {
        printLn(`FAIL: {msg}`);
        panic(msg);
    }
}

/// A radio the way `bind:group` generates it: the checked one writes its value, the variable checks it.
fn sradio(d: &Dom, k: int, name: string, val: string, off: bool, g: bool) {
    let c = d.open(k, d.tag("input"), 1);
    d.attrType(c, "radio");
    d.attrName(c, name);
    if off { d.attrDisabled(c, true); }
    ID[k] = c;
    if d.changed(c) {
        CHG[k] += 1;
        if g { G1 = val; } else { G2 = val; }
    }
    d.attrGroup(c, d.textIs(if g { G1 } else { G2 }, val));
    d.close();
}

fn iradio(d: &Dom, k: int, v: int) {
    let c = d.open(k, d.tag("input"), 1);
    d.attrType(c, "radio");
    d.attrName(c, "n");
    ID[k] = c;
    if d.changed(c) { CHG[k] += 1; N = v; }
    d.attrGroup(c, N == v);
    d.close();
}

fn zradio(d: &Dom, k: int, z: int) {
    let c = d.open(k, d.tag("input"), 1);
    d.attrType(c, "radio");
    d.attrName(c, if k == 10 && ZN { "z2" } else { "z" });
    ID[k] = c;
    if d.userToggled(c) { Z[z] = d.isChecked(c); WB[k] += 1; }
    d.attrRadio(c, Z[z]);
    d.close();
}

fn frame(d: &Dom) {
    d.beginFrame(Vec2 { x: 800.0, y: 600.0 });
    inputs.begin(d);
    d.open(0, d.tag("div"), 1);
    let pre = d.open(11, d.tag("button"), 1);
    ID[11] = pre;
    d.text("Pre");
    d.close();
    let ga = d.open(0, d.tag("div"), 1);
    d.attrRole(ga, "radiogroup");
    d.open(0, d.tag("label"), 1);
    sradio(d, 0, "g", "a", false, true);
    d.text("One");
    d.close();
    sradio(d, 1, "g", "b", false, true);
    d.attrId(ID[1], "rb");
    let l2 = d.open(1, d.tag("label"), 1);
    d.attrFor(l2, "rb");
    d.text("Two");
    d.close();
    d.open(2, d.tag("div"), 1);
    sradio(d, 2, "g", "c", true, true);
    d.close();
    if SHOW_D {
        d.open(3, d.tag("div"), 1);
        sradio(d, 3, "g", "d", false, true);
        d.close();
    }
    d.close();
    if FORCE_A { G1 = "a"; }
    let gb = d.open(1, d.tag("div"), 1);
    d.attrRole(gb, "radiogroup");
    d.open(4, d.tag("div"), 1);
    sradio(d, 4, "g", "x", false, false);
    d.close();
    d.open(5, d.tag("div"), 1);
    sradio(d, 5, "g", "y", false, false);
    d.close();
    d.close();
    d.open(2, d.tag("div"), 1);
    for k in 0..3 {
        d.open(6 + k, d.tag("div"), 1);
        iradio(d, 6 + k, k + 1);
        d.close();
    }
    d.close();
    d.open(3, d.tag("div"), 1);
    zradio(d, 9, 0);
    zradio(d, 10, 1);
    d.close();
    let post = d.open(12, d.tag("button"), 1);
    ID[12] = post;
    d.text("Post");
    d.close();
    let fg = d.open(4, d.tag("div"), 1);
    d.attrNav(fg, 0, "arrows");
    ID[13] = d.open(0, d.tag("button"), 1);
    d.text("AB");
    d.close();
    let sc = d.open(1, d.tag("div"), 1);
    d.cls(sc, "sc");
    ID[17] = sc;
    d.attrRole(sc, "radiogroup");
    for k in 0..2 {
        let c = d.open(k, d.tag("input"), 1);
        d.attrType(c, "radio");
        d.attrName(c, "ar");
        ID[14 + k] = c;
        if d.changed(c) { AR = k; }
        d.attrGroup(c, AR == k);
        d.close();
    }
    let sp = d.open(2, d.tag("div"), 1);
    d.cls(sp, "sp");
    d.close();
    d.close();
    ID[16] = d.open(2, d.tag("button"), 1);
    d.text("AC");
    d.close();
    d.close();
    // two radios of one name in different "keyed rows" (the row id is set by hand here), with no radiogroup between them
    for k in 0..2 {
        let w = d.open(5 + k, d.tag("input"), 1);
        d.attrType(w, "radio");
        d.attrName(w, "w");
        d.nodes.items[w].gk = k + 1;
        ID[18 + k] = w;
        d.close();
    }
    d.close();
    d.layout();
    d.endFrame();
}

fn clickNode(d: &Dom, id: int) {
    for f in 0..4 {
        testkit.click(d, f, 0, id);
        frame(d);
    }
}

fn clickText(d: &Dom, text: string) {
    for f in 0..4 {
        testkit.clickText(d, f, 0, text);
        frame(d);
    }
}

fn idle(d: &Dom) {
    d.simInput(-5.0, -5.0, false, 0.0);
    frame(d);
}

fn key(d: &Dom, names: string) {
    d.simKeys("", names);
    frame(d);
    frame(d);
}

fn on(d: &Dom, k: int): bool {
    return d.nodes.items[ID[k]].checked;
}

fn picks(d: &Dom, want: string): bool {
    // want: one char per slot 0..3, '1' checked
    for i in 0..4 {
        if on(d, i) != (want[i] == 49) { return false; }
    }
    return true;
}

fn main() {
    let mem = Arena.create(64 * 1024 * 1024);
    let css = Css.new(&mem);
    parse(&css, SHEET, "radio.css", 1);
    let d = Dom.new(&mem, &css);
    d.setFrameMs(16.0);
    a11y.enable(&d);
    G1 = "b";
    G2 = "";
    N = 2;
    AR = 0;
    SHOW_D = true;
    idle(&d);
    idle(&d);
    ok(picks(&d, "0100"), "the variable checks its radio");
    ok(on(&d, 7) && !on(&d, 6) && !on(&d, 8), "an int group checks the one equal to the variable");
    ok(!on(&d, 4) && !on(&d, 5), "a variable that matches nothing checks nothing");

    // clicks: exclusive, on:change on the new one only
    clickNode(&d, ID[0]);
    ok(same(G1, "a") && picks(&d, "1000"), "a click checks it and unchecks the other of its group");
    ok(CHG[0] == 1 && CHG[1] == 0, "on:change fires on the newly checked radio only");
    clickNode(&d, ID[0]);
    ok(CHG[0] == 1, "a click on the checked radio is no change");
    ok(d.focus == ID[0], "a click focuses the radio");
    clickText(&d, "Two");
    ok(same(G1, "b") && picks(&d, "0100") && CHG[1] == 1, "a label with for= checks its radio");
    clickText(&d, "One");
    ok(same(G1, "a") && picks(&d, "1000") && CHG[0] == 2, "a wrapping label checks its radio");
    clickNode(&d, ID[2]);
    ok(same(G1, "a") && picks(&d, "1000") && CHG[2] == 0, "a disabled radio can not be checked");
    ok(!on(&d, 4) && !on(&d, 5) && G2.len == 0, "the same name in another scope is untouched");

    // scopes
    clickNode(&d, ID[4]);
    ok(same(G2, "x") && on(&d, 4) && picks(&d, "1000"), "scope B checks its own radio, scope A keeps its choice");
    clickNode(&d, ID[5]);
    ok(same(G2, "y") && !on(&d, 4) && on(&d, 5) && picks(&d, "1000"), "and exclusivity holds inside scope B");

    // ints
    clickNode(&d, ID[8]);
    ok(N == 3 && on(&d, 8) && !on(&d, 7), "bind:group with ints writes the int");
    // code changes the variable
    G1 = "d";
    N = 1;
    idle(&d);
    idle(&d);
    ok(picks(&d, "0001") && on(&d, 6) && !on(&d, 8), "setting the variable checks the radio and unchecks the rest");
    ok(CHG[3] == 0, "a program change is no on:change");

    // bind:checked: every flip is seen
    clickNode(&d, ID[9]);
    ok(Z[0] && !Z[1] && on(&d, 9), "bind:checked sets its variable");
    clickNode(&d, ID[10]);
    ok(!Z[0] && Z[1] && WB[9] == 2, "bind:checked on the radio that lost the check sees it too");

    // keys
    d.focusNode(ID[0]);
    d.setKeyboard(true);
    G1 = "a";
    idle(&d);
    ok(picks(&d, "1000"), "start of the key tests");
    key(&d, "Down");
    ok(d.focus == ID[1] && same(G1, "b") && picks(&d, "0100"), "Down moves focus and the check to the next");
    key(&d, "Down");
    ok(d.focus == ID[3] && same(G1, "d") && picks(&d, "0001"), "Down skips the disabled radio");
    key(&d, "Right");
    ok(d.focus == ID[0] && same(G1, "a"), "Right wraps to the first");
    key(&d, "Up");
    ok(d.focus == ID[3] && same(G1, "d"), "Up wraps to the last");
    key(&d, "Left");
    ok(d.focus == ID[1] && same(G1, "b"), "Left goes back, skipping the disabled radio");
    ok(CHG[1] >= 2, "arrow checks fire on:change");
    d.focusNode(ID[0]);
    ok(!on(&d, 0), "focus alone checks nothing");
    key(&d, "Space");
    ok(on(&d, 0) && same(G1, "a"), "Space checks the focused radio");
    key(&d, "Down");
    key(&d, "Up");
    ok(d.focus == ID[0] && on(&d, 0), "arrows come back");
    // a group of two wraps both ways
    d.focusNode(ID[9]);
    key(&d, "Down");
    ok(d.focus == ID[10] && Z[1] && !Z[0], "Down in a pair moves to the other");
    key(&d, "Down");
    ok(d.focus == ID[9] && Z[0], "and wraps back");

    // Tab: one stop per group
    ok(dom.tabbable(&d, ID[0]) && !dom.tabbable(&d, ID[1]) && !dom.tabbable(&d, ID[3]), "the checked radio is the group's tab stop");
    ok(dom.padReach(&d, ID[1]), "the pad can still reach the other radios");
    d.focusNode(ID[11]);
    let seq = Text.new(&mem);
    for i in 0..12 {
        key(&d, "Tab");
        seq.pushInt(d.focus);
        seq.push(32);
    }
    // pre, then A (checked a), B (y is checked), ints (the checked one), the z pair (checked), post, the arrows group's button, its radio, its other button, the row radios, wrap to pre
    let want = Text.new(&mem);
    let order = [ID[0], ID[5], ID[6], ID[9], ID[12], ID[13], ID[14], ID[16], ID[18], ID[11], ID[0], ID[5]];
    for i in 0..12 {
        want.pushInt(order[i]);
        want.push(32);
    }
    ok(same(seq.str(), want.str()), `Tab visits one radio per group: {seq.str()} vs {want.str()}`);
    d.focusNode(ID[12]);
    let back = [ID[9], ID[6], ID[5], ID[0], ID[11]];
    for i in 0..5 {
        key(&d, "S+Tab");
        ok(d.focus == back[i], "Shift+Tab visits one radio per group");
    }
    // a group spread over keyed rows is reported once
    clickNode(&d, ID[18]);
    clickNode(&d, ID[19]);
    clickNode(&d, ID[18]);
    let ws = 0;
    for i in 0..css.warns.len {
        if contains(css.warns.items[i].msg, "radio group \"w\" spans several") { ws += 1; }
    }
    ok(ws == 1 && on(&d, 18) && !on(&d, 19), "radios of one name in different keyed rows warn once");
    // arrows: a radio group wins over `focus-group=\"arrows\"`, and the arrow does not scroll the box around it
    d.focusNode(ID[14]);
    key(&d, "Down");
    ok(d.focus == ID[15] && AR == 1, "a radio group takes the arrow inside a focus-group with arrows");
    key(&d, "Down");
    ok(d.focus == ID[14] && AR == 0, "and wraps instead of leaving the group");
    ok(d.nodes.items[ID[17]].scrollY == 0.0 && d.nodes.items[ID[17]].scrollMax > 0.0, "the arrow keys do not scroll the box around the radios");
    d.focusNode(ID[13]);
    key(&d, "Down");
    ok(d.focus != ID[13] && d.focus >= 0, "outside the radios the focus-group arrows still move focus");
    // nothing checked: the first enabled radio is the stop
    G2 = "";
    idle(&d);
    ok(!on(&d, 4) && !on(&d, 5), "variable cleared");
    ok(dom.tabbable(&d, ID[4]) && !dom.tabbable(&d, ID[5]), "with none checked the first radio is the stop");
    // a disabled checked radio does not hide the group from Tab
    G1 = "c";
    idle(&d);
    ok(on(&d, 2) && dom.tabbable(&d, ID[0]) && !dom.tabbable(&d, ID[3]), "a checked but disabled radio leaves the first enabled one as the stop");

    // bind:group never desyncs: a value no radio has unchecks all; the variable wins over a pick it did not take
    G1 = "zzz";
    idle(&d);
    idle(&d);
    ok(picks(&d, "0000"), "a variable no radio has unchecks them all");
    G1 = "b";
    idle(&d);
    idle(&d);
    ok(picks(&d, "0100"), "back to b");
    FORCE_A = true;
    G1 = "a";
    idle(&d);
    clickNode(&d, ID[3]);
    idle(&d);
    FORCE_A = false;
    ok(same(G1, "a") && picks(&d, "1000"), "the program writing the old value again wins over the user's pick");
    // a radio renamed into another group takes the check from it
    clickNode(&d, ID[10]);
    ok(Z[1] && on(&d, 10) && !on(&d, 9), "start of the rename test");
    ZN = true;
    idle(&d);
    clickNode(&d, ID[9]);
    ok(on(&d, 9) && on(&d, 10), "a radio renamed to z2 is exclusive with its new group only");
    ZN = false;
    idle(&d);
    ok(!on(&d, 9) && on(&d, 10), "renamed back into a group with a checked radio: the renamed one keeps the check");
    // removing the checked radio: none is checked, Tab's stop is the first enabled one
    G1 = "d";
    idle(&d);
    idle(&d);
    ok(on(&d, 3) && dom.tabbable(&d, ID[3]) && !dom.tabbable(&d, ID[0]), "d is checked and the stop");
    a11y.events(&d, &mem);
    SHOW_D = false;
    idle(&d);
    idle(&d);
    ok(on(&d, 0) == false && on(&d, 1) == false && dom.tabbable(&d, ID[0]) && !dom.tabbable(&d, ID[1]), "the checked radio is gone: the first enabled one is the stop");
    let gone = a11y.events(&d, &mem);
    for i in 0..gone.len {
        if gone.items[i].kind == a11y.EV_CHECKED { ok(d.alive(gone.items[i].h), "no checked event for a removed radio"); }
    }
    SHOW_D = true;
    G1 = "b";
    idle(&d);
    idle(&d);

    // a11y
    G1 = "b";
    idle(&d);
    let tx = Text.new(&mem);
    a11y.dump(&d, &mem, &tx);
    let s = tx.str();
    ok(contains(s, "radio \"One\" checked=false group=\"g\"") && contains(s, "radio \"Two\" checked=true group=\"g\""), "the a11y tree has role, checked, group and the label name");
    a11y.events(&d, &mem);
    clickNode(&d, ID[0]);
    let ev = a11y.events(&d, &mem);
    let a0 = false;
    let b0 = false;
    for i in 0..ev.len {
        if ev.items[i].kind == a11y.EV_CHECKED && ev.items[i].h == d.handle(ID[0]) { a0 = true; }
        if ev.items[i].kind == a11y.EV_CHECKED && ev.items[i].h == d.handle(ID[1]) { b0 = true; }
    }
    ok(a0 && b0, "checked events for the radio that got checked and the one that lost it");
    ok(a11y.perform(&d, ID[1], a11y.A_CLICK, 0.0, ""), "a screen reader can activate a radio");
    idle(&d);
    idle(&d);
    ok(on(&d, 1) && same(G1, "b"), "and that checks it");
    // the pad's A is Enter on the focused radio
    d.focusNode(ID[0]);
    testkit.padPress(&d, 0, 0, "A");
    frame(&d);
    testkit.padPress(&d, 1, 0, "A");
    frame(&d);
    frame(&d);
    ok(on(&d, 0) && G1.len == 1 && G1[0] == 97, "the pad's A checks the focused radio");
    printLn(`radio_test: {CHECKS} checks passed`);
}
