// Generated from ui/BallCard.j3ui by hand (plan 022 stage 05); stage 06 emits this shape. Source:
// <!-- One ball kind: what it does, how many you own, and the buy button. -->
//
// <script>
//     use bench2d.sim.{ Sim, Shop, MAX_BALLS };
//
//     props {
//         sim: &Sim;
//         kind: int;
//     }
//
//     // Plain functions are fine; markup re-reads them every frame, so there is
//     // nothing to mark reactive.
//     fn shop(): &Shop {
//         return &sim.shop[kind];
//     }
//     fn canBuy(): bool {
//         return sim.gold >= shop().cost && sim.ballCount < MAX_BALLS;
//     }
// </script>
//
// <div class="card" class:locked={!canBuy()}>
//     <div class="top">
//         <span class="name">{shop().name}</span>
//         <span class="owned">x{shop().owned}</span>
//     </div>
//     <small>{shop().blurb}</small>
//     <div class="stats">
//         <span>dmg {shop().damage}</span>
//         <span>spd {int(shop().speed)}</span>
//     </div>
//     <button disabled={!canBuy()} on:click={sim.buyBall(kind)}>
//         Buy · <span class="price">{shop().cost}</span>
//     </button>
// </div>
//
// <style>
//     .card {
//         display: flex;
//         flex-direction: column;
//         gap: 6px;
//         padding: 12px;
//         background: var(--raised);
//         border-radius: var(--radius);
//         border: 1px solid transparent;
//         transition: border-color 150ms;
//     }
//     .card:hover { border-color: var(--accent); }
//     .card.locked { opacity: 0.7; }
//     .top { display: flex; justify-content: space-between; }
//     .name { font-weight: bold; }
//     .owned { color: var(--muted); }
//     .stats { display: flex; gap: 12px; font-size: 13px; color: var(--muted); }
//     button { margin-top: 4px; }
//     .price { color: var(--gold); }
// </style>
module bench2d.ui.BallCard;

use bench2d.sim.{ Sim, Shop, MAX_BALLS };
use j3.memory.Arena;
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

pub const SCOPE: int = 2;
const CSS: string = "    .card {\n        display: flex;\n        flex-direction: column;\n        gap: 6px;\n        padding: 12px;\n        background: var(--raised);\n        border-radius: var(--radius);\n        border: 1px solid transparent;\n        transition: border-color 150ms;\n    }\n    .card:hover { border-color: var(--accent); }\n    .card.locked { opacity: 0.7; }\n    .top { display: flex; justify-content: space-between; }\n    .name { font-weight: bold; }\n    .owned { color: var(--muted); }\n    .stats { display: flex; gap: 12px; font-size: 13px; color: var(--muted); }\n    button { margin-top: 4px; }\n    .price { color: var(--gold); }";

pub struct BallCardProps {
    sim: &Sim;
    kind: int;
}

pub struct BallCardEvents {
}

pub struct BallCard {
    mem: &Arena;
    ready: bool;
    p: BallCardProps;
    tag_div: int;
    tag_span: int;
    tag_small: int;
    tag_button: int;
    cls_card: int;
    cls_locked: int;
    cls_top: int;
    cls_name: int;
    cls_owned: int;
    cls_stats: int;
    cls_price: int;

    fn new(mem: &Arena): BallCard {
        return BallCard {
            mem: mem, ready: false,
            p: BallCardProps { sim: 0 as &Sim, kind: 0 },
            tag_div: 0, tag_span: 0, tag_small: 0, tag_button: 0,
            cls_card: 0, cls_locked: 0, cls_top: 0, cls_name: 0, cls_owned: 0, cls_stats: 0, cls_price: 0,
        };
    }

    fn styles(css: &Css) {
        parse(css, CSS, "ui/BallCard.j3ui", SCOPE);
    }

    fn init(this: &BallCard, d: &Dom) {
        this.ready = true;
        this.tag_div = d.tag("div");
        this.tag_span = d.tag("span");
        this.tag_small = d.tag("small");
        this.tag_button = d.tag("button");
        this.cls_card = d.css.intern("card");
        this.cls_locked = d.css.intern("locked");
        this.cls_top = d.css.intern("top");
        this.cls_name = d.css.intern("name");
        this.cls_owned = d.css.intern("owned");
        this.cls_stats = d.css.intern("stats");
        this.cls_price = d.css.intern("price");
    }

    // script fns are methods; each re-binds the props it reads
    fn shop(this: &BallCard): &Shop {
        let sim = this.p.sim;
        let kind = this.p.kind;
        return &sim.shop[kind];
    }

    fn canBuy(this: &BallCard): bool {
        let sim = this.p.sim;
        let s = this.shop();
        return sim.gold >= s.cost && sim.ballCount < MAX_BALLS;
    }

    fn update(this: &BallCard, d: &Dom, p: BallCardProps): BallCardEvents {
        if !this.ready {
            this.init(d);
        }
        this.p = p;
        let sim = p.sim;
        let kind = p.kind;
        // `f().field` is not a place in J3: a call used for its fields is hoisted into a local
        let sh = this.shop();
        let ev = BallCardEvents { };
        let n1 = d.open(0, this.tag_div, SCOPE);
        d.clsId(n1, this.cls_card);
        d.clsIfId(n1, this.cls_locked, !this.canBuy());
        let n2 = d.open(0, this.tag_div, SCOPE);
        d.clsId(n2, this.cls_top);
        let n3 = d.open(0, this.tag_span, SCOPE);
        d.clsId(n3, this.cls_name);
        d.text(sh.name);
        d.close();
        let n4 = d.open(1, this.tag_span, SCOPE);
        d.clsId(n4, this.cls_owned);
        d.text(`x{sh.owned}`);
        d.close();
        d.close();
        let n5 = d.open(1, this.tag_small, SCOPE);
        d.text(sh.blurb);
        d.close();
        let n6 = d.open(2, this.tag_div, SCOPE);
        d.clsId(n6, this.cls_stats);
        let n7 = d.open(0, this.tag_span, SCOPE);
        d.text(`dmg {sh.damage}`);
        d.close();
        let n8 = d.open(1, this.tag_span, SCOPE);
        d.text(`spd {int(sh.speed)}`);
        d.close();
        d.close();
        let n9 = d.open(3, this.tag_button, SCOPE);
        d.attrDisabled(n9, !this.canBuy());
        if d.clicked(n9) {
            sim.buyBall(kind);
        }
        d.text("Buy · ");
        let n10 = d.open(0, this.tag_span, SCOPE);
        d.clsId(n10, this.cls_price);
        d.text(`{sh.cost}`);
        d.close();
        d.close();
        d.close();
        return ev;
    }

    fn paint(this: &BallCard, d: &Dom) {
        let n1 = d.paintNext(0);
        if n1 >= 0 {
            d.paintBox(n1);
            let n2 = d.paintNext(0);
            if n2 >= 0 {
                d.paintBox(n2);
                let n3 = d.paintNext(0);
                if n3 >= 0 {
                    d.paintBox(n3);
                    d.paintEnd(n3);
                }
                let n4 = d.paintNext(1);
                if n4 >= 0 {
                    d.paintBox(n4);
                    d.paintEnd(n4);
                }
                d.paintEnd(n2);
            }
            let n5 = d.paintNext(1);
            if n5 >= 0 {
                d.paintBox(n5);
                d.paintEnd(n5);
            }
            let n6 = d.paintNext(2);
            if n6 >= 0 {
                d.paintBox(n6);
                let n7 = d.paintNext(0);
                if n7 >= 0 {
                    d.paintBox(n7);
                    d.paintEnd(n7);
                }
                let n8 = d.paintNext(1);
                if n8 >= 0 {
                    d.paintBox(n8);
                    d.paintEnd(n8);
                }
                d.paintEnd(n6);
            }
            let n9 = d.paintNext(3);
            if n9 >= 0 {
                d.paintBox(n9);
                let n10 = d.paintNext(0);
                if n10 >= 0 {
                    d.paintBox(n10);
                    d.paintEnd(n10);
                }
                d.paintEnd(n9);
            }
            d.paintEnd(n1);
        }
    }
}
