// Generated from ui/theme.css (global; scope 0).
module bench2d.ui.theme;

pub const THEME: string = "/* Global tokens and base rules. Every component sees these; a component's own\n   <style> is scoped to it, like Svelte. This file is plain CSS: the same tree\n   rendered in a browser should match, so nothing leans on browser defaults. */\n\n@font-face {\n  font-family: \"Ui\";\n  src: url(\"../../../examples/idle-breakout/assets/font.ttf\");\n}\n\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\n:root {\n  --bg: #11111b;\n  --panel: #1e1e2e;\n  --raised: #313244;\n  --hover: #45475a;\n  --active: #585b70;\n  --line: #45475a;\n  --text: #cdd6f4;\n  --muted: #a6adc8;\n  --gold: #f9e2af;\n  --crystal: #cba6f7;\n  --good: #a6e3a1;\n  --bad: #f38ba8;\n  --accent: #89b4fa;\n  --radius: 10px;\n  --gap: 8px;\n  font-family: \"Ui\";\n  font-size: 15px;\n  color: var(--text);\n}\n\nh1 { font-size: 22px; font-weight: bold; }\nh2 { font-size: 17px; font-weight: bold; color: var(--muted); }\nsmall { font-size: 12px; color: var(--muted); }\n\nbutton {\n  padding: 8px 14px;\n  border: none;\n  border-radius: var(--radius);\n  background: var(--hover);\n  color: var(--text);\n  font: inherit;\n  transition: background 120ms;\n}\nbutton:hover { background: var(--active); }\nbutton:active { transform: scale(0.97); }\nbutton:disabled { opacity: 0.4; }";
