// Root for the `ui N` scene: the BallShop grid (div.grid, {#each 0..n} <BallCard/>) in the shape stage 06 emits.
module bench2d.ui.BenchGrid;

use bench2d.sim.Sim;
use bench2d.ui.BallCard.{ BallCard, BallCardProps };
use bench2d.ui.theme.THEME;
use j3.math.Vec2;
use j3.memory.{ Arena, List };
use j3.ui.css.Css;
use j3.ui.cssparse.parse;
use j3.ui.dom.Dom;

pub const SCOPE: int = 20;
const CSS: string = ".grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gap); padding: 16px; }";

pub struct BenchGrid {
    mem: &Arena;
    ready: bool;
    css: &Css;
    dom: Dom;
    tag_div: int;
    cls_grid: int;
    c1: List<BallCard>;
    cnt1: int;

    fn new(mem: &Arena): BenchGrid {
        let cs = mem.alloc::<Css>(1);
        cs[0] = Css.new(mem);
        let css = &cs[0];
        parse(css, THEME, "ui/theme.css", 0);
        parse(css, CSS, "ui/BenchGrid.j3ui", SCOPE);
        BallCard.styles(css);
        return BenchGrid { mem: mem, ready: false, css: css, dom: Dom.new(mem, css), tag_div: 0, cls_grid: 0, c1: List<BallCard>.new(mem), cnt1: 0 };
    }

    fn render(this: &BenchGrid, size: Vec2, sim: &Sim, n: int) {
        let d = &this.dom;
        d.beginFrame(size);
        this.update(d, sim, n);
        d.layout();
        d.paintAll(); // boxes are painted from the tree; no <canvas>, so no hook
        d.endFrame();
    }

    fn update(this: &BenchGrid, d: &Dom, sim: &Sim, n: int) {
        if !this.ready {
            this.ready = true;
            this.tag_div = d.tag("div");
            this.cls_grid = d.css.intern("grid");
        }
        let n1 = d.open(0, this.tag_div, SCOPE);
        d.clsId(n1, this.cls_grid);
        let s2 = d.enter(0);
        this.cnt1 = n;
        for k in 0..n {
            while this.c1.len <= k {
                this.c1.push(BallCard.new(this.mem));
            }
            let s3 = d.enter(k * 1 + 0);
            let e3 = this.c1.items[k].update(d, BallCardProps { sim: sim, kind: k % 4 });
            d.leave(s3);
        }
        if this.c1.len > n {
            this.c1.len = n;
        }
        d.leave(s2);
        d.close();
    }
}
