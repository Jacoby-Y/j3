// 2D draw baseline: prints `scene=rects n=10000 cpu_ms=median/p95 gpu_ms=... draws=...`.
// `bench2d rects N | text N | mixed | paint-rects N | paint-text N | paint-mixed | shapes`. 300 frames (optional 3rd arg: run that many, to watch memory), first 30 skipped.
// cpu_ms is the draw system alone (submit time). gpu_ms is the profiler's GL_TIME_ELAPSED
// zone for 2D draws (-1 when the driver gave none). draws counts hud quads per frame.

module bench2d;

use j3.app.App;
use j3.game;
use j3.game.{ Font, Texture, rgb, rgba };
use j3.math.Vec2;
use j3.gfx.canvas;
use j3.gfx.paint;
use j3.gfx.paint.Corners;
use j3.gfx.canvas.{ Canvas, Mode };
use j3.memory.Arena;
use j3.rand.Rng;
use j3.io;
use j3.sys;
use bench2d.sim.Sim;
use bench2d.ui.BenchGrid.BenchGrid;

const FRAMES: int = 300;
const SKIP: int = 30;
const W: int = 1280;
const H: int = 720;

struct World {
    scene: int = 0;
    n: int = 0;
    font: Font;
    frame: int = 0;
    gpu: f32 = 0.0;
    gpuN: int = 0;
    draws: int = 0;
    total: int = 300;
    sim: Sim;
    grid: BenchGrid;
}

#[singleton]
let TEXS: [200]Texture;
#[singleton]
let CPU: [300]f32;
#[singleton]
let DIGITS: [32]u8;

fn parse(s: string): int {
    let n = 0;
    let k = 0;
    while k < s.len && s[k] >= 48 && s[k] <= 57 {
        n = n * 10 + int(s[k]) - 48;
        k += 1;
    }
    return n;
}

fn boot(mem: &Arena): World {
    let w = World { font: Font { raw: 0 }, sim: Sim.new(mem), grid: BenchGrid.new(mem) };
    let name = sys.arg(1);
    w.n = parse(sys.arg(2));
    let t = parse(sys.arg(3));
    if t > FRAMES { w.total = t; }
    // paint-rects | paint-text | paint-mixed use j3.gfx.paint (scenes 3..5).
    let off = 0;
    let k = 0;
    if name.len == 2 && name[0] == 117 { w.scene = 7; return w; }
    if name.len > 6 && name[0] == 112 { off = 3; k = 6; }
    if name.len > k && name[k] == 114 { w.scene = off; }
    else if name.len > k && name[k] == 116 { w.scene = off + 1; }
    else if name.len > 0 && name[0] == 115 { w.scene = 6; }
    else { w.scene = off + 2; w.n = 5000; }
    return w;
}

fn load(w: &World) {
    w.grid.dom.setFrameMs(16.0);
    w.font = game.loadFont("../../examples/big_ui_test/assets/font.ttf", 16);
    let mem = Arena.create(1024 * 1024);
    let r = Rng.new(7);
    let i = 0;
    while i < 200 {
        let c = Canvas.create(&mem, 16, 16, Mode.Pixel);
        c.clear(canvas.rgb(u8(r.intRange(40, 255)), u8(r.intRange(40, 255)), u8(r.intRange(40, 255))));
        TEXS[i] = game.textureFromCanvas(c);
        i += 1;
    }
}

fn rects(w: &World, r: &Rng, n: int) {
    let i = 0;
    while i < n {
        game.setColor(rgb(u8(r.intRange(0, 256)), u8(r.intRange(0, 256)), u8(r.intRange(0, 256))));
        game.drawRect(
            Vec2 { x: f32(r.intRange(0, W)), y: f32(r.intRange(0, H)) },
            Vec2 { x: f32(r.intRange(1, 41)), y: f32(r.intRange(1, 41)) });
        i += 1;
    }
}

fn texts(w: &World, r: &Rng, n: int) {
    let i = 0;
    while i < n {
        // "gold " + 5 digits
        let v = r.intRange(0, 100000);
        DIGITS[0] = 103; DIGITS[1] = 111; DIGITS[2] = 108; DIGITS[3] = 100; DIGITS[4] = 32;
        let d = 9;
        while d >= 5 { DIGITS[d] = u8(48 + v - (v / 10) * 10); v = v / 10; d -= 1; }
        let msg = []u8 { ptr: &DIGITS[0], len: 10 } as string;
        game.setColor(rgb(u8(r.intRange(100, 256)), 255, 255));
        game.drawText(w.font, Vec2 { x: f32(r.intRange(0, W - 90)), y: f32(r.intRange(0, H - 20)) }, msg);
        i += 1;
    }
}

fn paintRects(r: &Rng, n: int) {
    let i = 0;
    while i < n {
        paint.rect(
            Vec2 { x: f32(r.intRange(0, W)), y: f32(r.intRange(0, H)) },
            Vec2 { x: f32(r.intRange(1, 41)), y: f32(r.intRange(1, 41)) },
            rgb(u8(r.intRange(0, 256)), u8(r.intRange(0, 256)), u8(r.intRange(0, 256))));
        i += 1;
    }
}

fn paintTexts(w: &World, r: &Rng, n: int) {
    let i = 0;
    while i < n {
        let v = r.intRange(0, 100000);
        DIGITS[0] = 103; DIGITS[1] = 111; DIGITS[2] = 108; DIGITS[3] = 100; DIGITS[4] = 32;
        let d = 9;
        while d >= 5 { DIGITS[d] = u8(48 + v - (v / 10) * 10); v = v / 10; d -= 1; }
        let msg = []u8 { ptr: &DIGITS[0], len: 10 } as string;
        paint.text(w.font, Vec2 { x: f32(r.intRange(0, W - 90)), y: f32(r.intRange(0, H - 20)) }, msg,
            rgb(u8(r.intRange(100, 256)), 255, 255));
        i += 1;
    }
}

fn v(x: int, y: int): Vec2 { return Vec2 { x: f32(x), y: f32(y) }; }

// Golden page: every paint primitive and its edge cases. `bench2d shapes`; the checked-in
// golden/shapes.png is `J3_CAPTURE=golden/shapes.png:3 J3_FIXED_DT=0.016` of this scene.
fn shapes(w: &World) {
    let bg = rgb(30, 30, 46);
    let panel = rgb(49, 50, 68);
    let red = rgb(243, 139, 168);
    let green = rgb(166, 227, 161);
    let blue = rgb(137, 180, 250);
    let white = rgb(255, 255, 255);
    paint.rect(v(0, 0), v(1280, 720), bg);
    // Row 1: rect, round rect, per-corner radii, radius larger than half the size, zero size.
    paint.rect(v(20, 20), v(100, 60), panel);
    paint.roundRect(v(140, 20), v(100, 60), 10, panel);
    paint.roundRectEx(v(260, 20), v(100, 60), Corners { tl: 20, tr: 0, br: 20, bl: 5 }, blue, 0, bg);
    paint.roundRect(v(380, 20), v(100, 60), 200, green);
    paint.roundRect(v(500, 20), v(0, 60), 10, red);
    paint.rect(v(520, 20), v(60, 0), red);
    paint.roundRect(v(600, 20), v(1, 1), 4, white);
    // Row 2: borders, a border wider than the radius, wider than half the size, transparent border.
    paint.roundRectEx(v(20, 100), v(100, 60), Corners { tl: 10, tr: 10, br: 10, bl: 10 }, panel, 2, blue);
    paint.roundRectEx(v(140, 100), v(100, 60), Corners { tl: 4, tr: 4, br: 4, bl: 4 }, panel, 12, red);
    paint.roundRectEx(v(260, 100), v(100, 60), Corners { tl: 10, tr: 10, br: 10, bl: 10 }, panel, 40, green);
    paint.roundRectEx(v(380, 100), v(100, 60), Corners { tl: 14, tr: 14, br: 14, bl: 14 }, red, 6, rgba(0, 0, 0, 0));
    paint.roundRectEx(v(500, 100), v(100, 60), Corners { tl: 0, tr: 0, br: 0, bl: 0 }, panel, 3, white);
    // Row 3: circle, ring, lines (horizontal, diagonal, thick, zero length).
    paint.circle(v(70, 220), 30, red);
    paint.ring(v(190, 220), 30, 4, green);
    paint.ring(v(310, 220), 30, 40, blue);
    paint.line(v(380, 190), v(480, 250), 6, white);
    paint.line(v(500, 190), v(600, 190), 1, red);
    paint.line(v(620, 250), v(700, 190), 14, green);
    paint.line(v(730, 220), v(730, 220), 12, blue);
    // Row 4: clips (nested, and a shape cut by its clip), a scaled transform.
    paint.pushClip(v(20, 300), v(120, 80));
    paint.circle(v(40, 320), 50, red);
    paint.pushClip(v(60, 330), v(120, 30));
    paint.roundRect(v(20, 300), v(300, 200), 20, blue);
    paint.popClip();
    paint.popClip();
    paint.roundRect(v(160, 300), v(60, 60), 8, green);
    paint.pushTranslate(v(260, 300));
    paint.pushScale(v(0, 0), 2);
    paint.roundRectEx(v(0, 0), v(40, 30), Corners { tl: 6, tr: 6, br: 6, bl: 6 }, panel, 1, blue);
    paint.circle(v(20, 15), 8, red);
    paint.line(v(5, 25), v(35, 5), 2, white);
    paint.popTransform();
    paint.popTransform();
    // Alpha stack.
    paint.pushAlpha(0.5);
    paint.roundRect(v(400, 300), v(80, 80), 12, red);
    paint.pushAlpha(0.5);
    paint.circle(v(470, 370), 30, blue);
    paint.popAlpha();
    paint.popAlpha();
    // Images: whole, sub-rect, tinted, scaled.
    paint.image(TEXS[0], v(560, 300), v(64, 64));
    paint.imageSrc(TEXS[1], v(4, 4), v(8, 8), v(640, 300), v(64, 64), white);
    paint.imageSrc(TEXS[2], v(0, 0), v(16, 16), v(720, 300), v(64, 64), rgba(255, 128, 128, 200));
    // Text on top of shapes: big, small, tinted, alpha, scaled.
    paint.roundRect(v(20, 420), v(420, 60), 8, panel);
    paint.text(w.font, v(30, 432), "gold 120 / Hello, paint! {}[]~", white);
    paint.text(w.font, v(30, 452), "tinted red 0123456789", red);
    paint.pushAlpha(0.5);
    paint.text(w.font, v(460, 432), "half alpha", white);
    paint.popAlpha();
    paint.pushScale(v(460, 460), 2);
    paint.text(w.font, v(460, 460), "x2", green);
    paint.popTransform();
    // A view: (0,0) is its corner, content past its edge is cut.
    paint.pushView(v(700, 420), v(200, 100));
    paint.rect(v(0, 0), v(200, 100), panel);
    paint.roundRect(v(10, 10), v(300, 40), 10, blue);
    paint.text(w.font, v(14, 60), "inside a view", white);
    paint.popView();
    // game.drawRect shares the batch and the order.
    game.setColor(red);
    game.drawRect(v(940, 420), v(40, 40));
    paint.circle(v(960, 440), 10, white);
    game.drawText(w.font, v(940, 470), "game.drawText");
}

fn draw(w: &World) {
    let t0 = game.micros();
    let r = Rng.new(1234 + w.frame);
    game.setColor(rgb(20, 20, 30));
    game.clear();
    if w.scene == 0 { rects(w, &r, w.n); }
    else if w.scene == 1 { texts(w, &r, w.n); }
    else if w.scene == 6 { shapes(w); }
    else if w.scene == 7 {
        w.grid.dom.simInput(-10.0, -10.0, false, 0.0);
        w.grid.render(Vec2 { x: f32(W), y: f32(H) }, &w.sim, w.n);
    }
    else if w.scene == 3 { paintRects(&r, w.n); }
    else if w.scene == 4 { paintTexts(w, &r, w.n); }
    else if w.scene == 5 {
        paintRects(&r, 5000);
        paintTexts(w, &r, 1000);
        let j = 0;
        while j < 200 {
            paint.image(TEXS[j], Vec2 { x: f32(r.intRange(0, W)), y: f32(r.intRange(0, H)) }, Vec2 { x: 16, y: 16 });
            j += 1;
        }
    }
    else {
        rects(w, &r, 5000);
        texts(w, &r, 1000);
        let i = 0;
        while i < 200 {
            game.drawTexture(TEXS[i], Vec2 { x: f32(r.intRange(0, W)), y: f32(r.intRange(0, H)) });
            i += 1;
        }
    }
    paint.flush(); // submit queued draws inside the timed region
    let ms = f32(game.micros() - t0) / 1000.0;
    if w.frame >= SKIP && w.frame < FRAMES {
        CPU[w.frame] = ms;
        let s = game.lastFrameStats();
        w.draws = s.draws;
        if s.uiMs >= 0.0 { w.gpu += s.uiMs; w.gpuN += 1; }
    }
    w.frame += 1;
    if w.frame >= w.total { game.requestQuit(); }
}


#[singleton]
let LINE: [256]u8;
#[singleton]
let LINE_N: int;

fn put(s: string) {
    let k = 0;
    while k < s.len { LINE[LINE_N] = s[k]; LINE_N += 1; k += 1; }
}

fn putInt(v: int) {
    if v >= 10 { putInt(v / 10); }
    LINE[LINE_N] = u8(48 + v - (v / 10) * 10);
    LINE_N += 1;
}

fn flush() {
    io.printLn([]u8 { ptr: &LINE[0], len: LINE_N } as string);
    LINE_N = 0;
}

#[singleton]
let SORTED: [300]f32;

fn fmt(x: f32) {
    let v = int(x * 1000.0 + 0.5);
    let whole = v / 1000;
    let frac = v - whole * 1000;
    putInt(whole);
    put(".");
    if frac < 100 { put("0"); }
    if frac < 10 { put("0"); }
    putInt(frac);
}

fn main() {
    let app = App<World>.createSized("bench2d", W, H, 64 * 1024 * 1024, boot);
    app.idleSkip(false); // paints outside the Dom (rects, text scenes) with no system
    app.useGl();
    app.startup(load);
    app.draw(draw);
    app.run();
    let w = &app.world;
    // Median and p95 of the measured frames, by insertion sort.
    let a = SORTED;
    let n = 0;
    let i = SKIP;
    while i < FRAMES {
        let v = CPU[i];
        let j = n;
        while j > 0 && a[j - 1] > v { a[j] = a[j - 1]; j -= 1; }
        a[j] = v;
        n += 1;
        i += 1;
    }
    let name = "rects";
    if w.scene == 1 { name = "text"; } else if w.scene == 2 { name = "mixed"; }
    else if w.scene == 3 { name = "paint-rects"; } else if w.scene == 4 { name = "paint-text"; }
    else if w.scene == 5 { name = "paint-mixed"; } else if w.scene == 6 { name = "shapes"; } else if w.scene == 7 { name = "ui"; }
    put("scene=");
    put(name);
    put(" n=");
    putInt(w.n);
    put(" cpu_ms=");
    fmt(a[n / 2]);
    put("/");
    fmt(a[n * 95 / 100]);
    put(" gpu_ms=");
    if w.gpuN > 0 { fmt(w.gpu / f32(w.gpuN)); } else { put("-1"); }
    put(" draws=");
    putInt(w.draws);
    flush();
}
