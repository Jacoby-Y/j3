// Just enough Sim for the BallCard in the `ui N` scene.
module bench2d.sim;

use j3.memory.Arena;

pub const MAX_BALLS = 200;

pub struct Shop {
    name: string;
    blurb: string;
    owned: int;
    cost: int;
    damage: int;
    speed: f32;
}

pub struct Sim {
    gold: int;
    ballCount: int;
    shop: []Shop;

    fn new(mem: &Arena): Sim {
        let shop = mem.alloc::<Shop>(4);
        shop[0] = Shop { name: "Basic", blurb: "Bounces. Hits.", owned: 3, cost: 25, damage: 1, speed: 260.0 };
        shop[1] = Shop { name: "Fast", blurb: "Twice the speed, half the punch.", owned: 0, cost: 200, damage: 1, speed: 520.0 };
        shop[2] = Shop { name: "Heavy", blurb: "Slow and brutal.", owned: 1, cost: 1500, damage: 8, speed: 160.0 };
        shop[3] = Shop { name: "Splash", blurb: "Hits the neighbours too.", owned: 0, cost: 8000, damage: 3, speed: 240.0 };
        return Sim { gold: 300, ballCount: 4, shop: shop };
    }

    fn buyBall(this: &Sim, kind: int) {
        this.gold -= this.shop[kind].cost;
        this.shop[kind].owned += 1;
    }
}
