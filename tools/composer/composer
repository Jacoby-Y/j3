#!/usr/bin/env bash
# Build the composer when its sources changed, then run it from the caller's directory.
# composer [FILE]               the window
# composer run FILE "commands" ... headless, for agents (composer help)
here="$(cd "$(dirname "$0")" && pwd)"
bin="$here/target/composer"
if [ ! -x "$bin" ] || [ -n "$(find "$here/src" "$here/j3.toml" -newer "$bin" -print -quit)" ]; then
  j3c build "$here" >&2 || exit 1
fi
exec "$bin" "$@"
