// The command language: `composer run`, the window's console, and agents all go through `run`.
// A failed command changes nothing (it undoes its own snapshot) and says what to fix.

module composer.cmd;

use j3.math.floor;
use j3.memory.Arena;
use j3.rand.Rng;
use j3.text.{ Text, same };
use composer.format;
use composer.mix;
use composer.mix.Stats;
use composer.song;
use composer.song.{ Note, Song };
use composer.synth;
use composer.theory;
use composer.theory.Chord;
use composer.util.{ cut, db, endsWith, own, parseI, parseNum, pushNum, trim, valueOf, words };

pub fn helpText(out: &Text) {
    out.pushStr("song:   song tempo=96 meter=4 key=Am bars=16 swing=0.5 noise=0   (any of them)   tempo 96   key Am\n");
    out.pushStr("                 swing 0.5 straight .. 0.75 delays the off-beat 8ths when played; noise 0..1 tape hiss\n");
    out.pushStr("        chords Am F C G [at=BAR]   one chord per bar from bar 1 (or BAR); `-` keeps the last;\n");
    out.pushStr("                 C Am F#m7 Gmaj7 Bdim Caug Dsus4 A5 C6 G9 Cadd9 Bm7b5 G/B\n");
    out.pushStr("tracks: track NAME [synth=sine|lead|pad|bass|pluck|keys|drums] [vol=0.8] [pan=0] [tone=0.6]\n");
    out.pushStr("                 [reverb=0..1] [drive=0..1]   reverb send and saturation\n");
    out.pushStr("        deltrack NAME   rename OLD NEW   mute NAME   unmute NAME   solo NAME   unsolo\n");
    out.pushStr("notes:  note TRACK POS LEN PITCH [VEL]     POS is BAR:BEAT (3:1, 3:2.5) or a beat from 0;\n");
    out.pushStr("                 LEN in beats (1, 1/2, 3/4); PITCH A2 F#4 Bb3 60 or kick snare clap hat ohat tom crash\n");
    out.pushStr("        notes TRACK POS STEP P P - P _ ...  a line of notes STEP apart: `-` rest, `_` holds the last\n");
    out.pushStr("                 [v=VEL]\n");
    out.pushStr("        fill TRACK STYLE [bars=A-B] [step=1/2] [oct=N] [v=VEL]   from the chords, replacing those bars:\n");
    out.pushStr("                 root fifths (oct 2)  block stab arp arpdown arpupdown (oct 4)\n");
    out.pushStr("        fill TRACK voiced [rhythm=x__..x_.] [bars=] [oct=3] [v=]   4 voice-led chord voices on a rhythm:\n");
    out.pushStr("                 x hit, _ hold, . rest, spread across the bar\n");
    out.pushStr("        beat TRACK DRUM x...x...x...x... [bars=A-B] [v=VEL]   one bar, steps spread evenly;\n");
    out.pushStr("                 x hit, X accent, 1-9 velocity (9 loud), . rest; replaces that drum in those bars\n");
    out.pushStr("        clear TRACK|all [bars=A-B]   copy TRACK|all bars=A-B to=C [times=N]\n");
    out.pushStr("        transpose TRACK|all SEMITONES [bars=A-B]   undo\n");
    out.pushStr("        humanize TRACK|all [bars=A-B] [v=8] [time=0.02]   nudge velocities (+-v) and starts (+-time beats;\n");
    out.pushStr("                 drums default to time=0)\n");
    out.pushStr("form:   section NAME bars=A-B   section NAME off   then bars=NAME and to=NAME work anywhere\n");
    out.pushStr("        notes past the last bar are refused: `bars 16` first (copy and chords grow the song)\n");
    out.pushStr("look:   info   dump TRACK [bars=A-B]   analyze (clashes, levels per track, ranges, repeats, loudness)   help\n");
}

/// Commands that only look at the song.
fn looking(head: string): bool {
    return same(head, "info") || same(head, "dump") || same(head, "analyze") || same(head, "help");
}

/// Run one command. Output and errors go to `out`.
pub fn run(s: &Song, line: string, out: &Text): bool {
    let mem = Arena.create(256 * 1024);
    defer mem.destroy();
    let w = words(line, &mem);
    if w.len == 0 { return true; }
    let head = w[0];
    let a = Args { w: w, at: 1, err: out };
    if same(head, "undo") {
        if !song.undo(s) { problem(&a, "nothing to undo"); return false; }
        return true;
    }
    if looking(head) { return look(s, head, &a, out); }
    song.snapshot(s);
    let before = s.dirty;
    let bars = s.bars;
    s.dirty = true;
    if edit(s, head, &a) {
        if s.bars > bars && !same(head, "song") && !same(head, "bars") {
            out.pushStr("(the song is now ");
            out.pushInt(s.bars);
            out.pushStr(" bars)\n");
        }
        return true;
    }
    song.undo(s);
    s.dirty = before;
    return false;
}

fn look(s: &Song, head: string, a: &Args, out: &Text): bool {
    if same(head, "help") { helpText(out); return true; }
    if same(head, "info") { info(s, out); return true; }
    if same(head, "analyze") { analyze(s, out); return true; }
    let t = trackArg(s, a, false);
    if t < 0 { return false; }
    let o = noOpts();
    if !opts(s, a, &o) { return false; }
    dump(s, t, &o, out);
    return true;
}

fn edit(s: &Song, head: string, a: &Args): bool {
    let o = noOpts();
    if same(head, "song") {
        for i in 1..a.w.len {
            if !format.songWord(s, a.w[i], a.err) { a.err.push(10); return false; }
        }
        return true;
    }
    if same(head, "tempo") || same(head, "key") || same(head, "meter") || same(head, "bars") {
        if a.w.len != 2 { problem(a, "like `tempo 96`, `key Am`, `meter 3`, `bars 16`"); return false; }
        let t = Text.new(a.err.arena);
        t.pushStr(head);
        t.push(61);
        t.pushStr(a.w[1]);
        if !format.songWord(s, t.str(), a.err) { a.err.push(10); return false; }
        return true;
    }
    if same(head, "chords") {
        let syms = 0;
        let at = 1;
        for i3 in 1..a.w.len {
            let v = valueOf(a.w[i3], "at");
            if v.len > 0 {
                if !parseI(v, &at) || at < 1 { problem2(a, "at is a bar", a.w[i3]); return false; }
            }
        }
        let c = blank();
        for i3 in 1..a.w.len {
            let w = a.w[i3];
            if valueOf(w, "at").len > 0 { continue; }
            let bar = at + syms;
            if bar > song.MAXBARS { problem(a, "past bar 256"); return false; }
            if same(w, "-") { s.chords[bar - 1] = ""; }
            else if theory.parseChord(w, &c) { s.chords[bar - 1] = own(s.mem, w); }
            else { problem2(a, "not a chord", w); return false; }
            syms += 1;
        }
        if syms == 0 { problem(a, "chords wants symbols, like `chords Am F C G`"); return false; }
        growBars(s, at + syms - 1);
        return true;
    }
    if same(head, "section") {
        if a.w.len != 3 { problem(a, "section NAME bars=A-B, or section NAME off"); return false; }
        let sname = a.w[1];
        if same(a.w[2], "off") {
            let si = song.findSection(s, sname);
            if si < 0 { problem2(a, "no section", sname); return false; }
            song.delSection(s, si);
            return true;
        }
        let c0 = sname[0];
        if !((c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122)) || valueOf(sname, "bars").len > 0 || same(sname, "all") {
            problem2(a, "a section name starts with a letter, not", sname);
            return false;
        }
        if valueOf(a.w[2], "bars").len == 0 { problem(a, "section NAME bars=A-B"); return false; }
        a.at = 2;
        if !opts(s, a, &o) { return false; }
        if !fits(s, a, o.b) { return false; }
        if !song.setSection(s, sname, o.a, o.b) { problem(a, "32 sections is the most"); return false; }
        return true;
    }
    if same(head, "humanize") {
        let th = trackArg(s, a, true);
        if th < -1 { return false; }
        if !opts(s, a, &o) { return false; }
        humanize(s, th, &o);
        return true;
    }
    if same(head, "track") {
        if a.w.len < 2 { problem(a, "track wants a name: `track Bass synth=bass`"); return false; }
        let name = a.w[1];
        if valueOf(name, "synth").len > 0 || same(name, "all") { problem2(a, "a track name, not", name); return false; }
        let t4 = song.findTrack(s, name);
        if t4 < 0 {
            t4 = song.addTrack(s, name, synth.SINE);
            if t4 < 0 { problem(a, "16 tracks is the most"); return false; }
            // A new track named like an instrument gets that instrument.
            for k in 0..synth.COUNT {
                if startsWithCi(name, synth.name(k)) { s.tracks[t4].synth = k; }
            }
        }
        for i4 in 2..a.w.len {
            if !format.trackWord(&s.tracks[t4], a.w[i4], a.err) { a.err.push(10); return false; }
        }
        return true;
    }
    if same(head, "deltrack") {
        let t5 = trackArg(s, a, false);
        if t5 < 0 { return false; }
        song.delTrack(s, t5);
        return true;
    }
    if same(head, "rename") {
        let t6 = trackArg(s, a, false);
        if t6 < 0 { return false; }
        if a.at >= a.w.len || song.findTrack(s, a.w[a.at]) >= 0 { problem(a, "rename OLD NEW, with a NEW name not in use"); return false; }
        s.tracks[t6].name = own(s.mem, a.w[a.at]);
        return true;
    }
    if same(head, "mute") || same(head, "unmute") || same(head, "solo") {
        let t7 = trackArg(s, a, false);
        if t7 < 0 { return false; }
        if same(head, "solo") { s.tracks[t7].solo = true; }
        else { s.tracks[t7].mute = same(head, "mute"); }
        return true;
    }
    if same(head, "unsolo") {
        for i8 in 0..s.trackCount { s.tracks[i8].solo = false; }
        return true;
    }
    if same(head, "note") {
        let t9 = trackArg(s, a, false);
        if t9 < 0 { return false; }
        if a.w.len < 5 || a.w.len > 6 { problem(a, "note TRACK POS LEN PITCH [VEL]"); return false; }
        let at9: f32 = 0;
        let len: f32 = 0;
        let vel = 100;
        if !parsePos(s, a.w[2], &at9) { problem2(a, "bad position (BAR:BEAT or a beat)", a.w[2]); return false; }
        if !parseNum(a.w[3], &len) || len <= 0 { problem2(a, "bad length", a.w[3]); return false; }
        let p = theory.parsePitch(a.w[4]);
        if p < 0 { problem2(a, "bad pitch", a.w[4]); return false; }
        if a.w.len == 6 && (!parseI(a.w[5], &vel) || vel < 1 || vel > 127) { problem2(a, "velocity is 1..127", a.w[5]); return false; }
        if !fits(s, a, barOf(s, at9)) { return false; }
        if !song.addNote(s, t9, at9, len, p, vel) { problem(a, "the song is full"); return false; }
        return true;
    }
    if same(head, "notes") {
        let t10 = trackArg(s, a, false);
        if t10 < 0 { return false; }
        return notesCmd(s, t10, a);
    }
    if same(head, "fill") {
        let t11 = trackArg(s, a, false);
        if t11 < 0 { return false; }
        if a.at >= a.w.len { problem(a, "fill TRACK STYLE (root fifths block stab arp arpdown arpupdown)"); return false; }
        let style = a.w[a.at];
        a.at += 1;
        if !opts(s, a, &o) { return false; }
        return fill(s, t11, style, &o, a);
    }
    if same(head, "beat") {
        let t12 = trackArg(s, a, false);
        if t12 < 0 { return false; }
        if a.at + 2 > a.w.len { problem(a, "beat TRACK DRUM PATTERN, like `beat Drums kick x...x...x...x...`"); return false; }
        let drum = theory.parsePitch(a.w[a.at]);
        if drum < 0 { problem2(a, "not a drum or pitch", a.w[a.at]); return false; }
        let pat = a.w[a.at + 1];
        a.at += 2;
        if !opts(s, a, &o) { return false; }
        return beat(s, t12, drum, pat, &o, a);
    }
    if same(head, "clear") {
        let t13 = trackArg(s, a, true);
        if t13 < -1 { return false; }
        if !opts(s, a, &o) { return false; }
        let w13 = 0;
        for i13 in 0..s.noteCount {
            if !inBars(s, &s.notes[i13], t13, &o) {
                s.notes[w13] = s.notes[i13];
                w13 += 1;
            }
        }
        s.noteCount = w13;
        return true;
    }
    if same(head, "copy") {
        let t14 = trackArg(s, a, true);
        if t14 < -1 { return false; }
        if !opts(s, a, &o) { return false; }
        return copy(s, t14, &o, a);
    }
    if same(head, "transpose") {
        let t15 = trackArg(s, a, true);
        if t15 < -1 { return false; }
        let by = 0;
        if a.at >= a.w.len || !parseI(a.w[a.at], &by) { problem(a, "transpose TRACK SEMITONES, like `transpose Lead 12`"); return false; }
        a.at += 1;
        if !opts(s, a, &o) { return false; }
        for i15 in 0..s.noteCount {
            let n = &s.notes[i15];
            if inBars(s, n, t15, &o) && s.tracks[n.track].synth != synth.DRUMS {
                n.pitch += by;
                if n.pitch < 0 || n.pitch > 127 { problem(a, "that moves a note out of 0..127"); return false; }
            }
        }
        return true;
    }
    problem2(a, "unknown command (`help` lists them)", head);
    return false;
}

/// `name` starts with `p`, ignoring case: a track called "Bass2" or "bass" gets the bass synth.
fn startsWithCi(name: string, p: string): bool {
    if name.len < p.len { return false; }
    for i in 0..p.len {
        let c = name[i];
        if c >= 65 && c <= 90 { c += 32; }
        if c != p[i] { return false; }
    }
    return true;
}

/// Run commands split by `;` and newlines. `#` starts a comment. Stops at the first failure.
pub fn runAll(s: &Song, text: string, out: &Text): bool {
    let at = 0;
    let n = 0;
    while at <= text.len {
        let end = at;
        while end < text.len && text[end] != 59 && text[end] != 10 {
            if text[end] == 35 {
                while end < text.len && text[end] != 10 { end += 1; }
                break;
            }
            end += 1;
        }
        let one = trim(cut(text, at, end));
        if one.len > 0 {
            n += 1;
            if !run(s, one, out) {
                out.pushStr("stopped at command ");
                out.pushInt(n);
                out.pushStr(": ");
                out.pushStr(one);
                out.push(10);
                return false;
            }
        }
        at = end + 1;
    }
    return true;
}

/// `songs/x` -> `songs/x.j3song`.
pub fn fileName(path: string, mem: &Arena): string {
    if path.len == 0 || endsWith(path, ".j3song") { return path; }
    let t = Text.new(mem);
    t.pushStr(path);
    t.pushStr(".j3song");
    return t.str();
}
