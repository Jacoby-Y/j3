// `composer selftest`: theory, commands, the file format, and rendering. Prints `ok` or what failed.

module composer.selftest;

use j3.io.printLn;
use j3.memory.Arena;
use j3.text.{ Text, same };
use composer.cmd;
use composer.format;
use composer.mix;
use composer.mix.Stats;
use composer.song;
use composer.song.Song;
use composer.theory;
use composer.theory.Chord;
use composer.util.cut;

fn contains(h: string, n: string): bool {
    for i in 0..h.len - n.len + 1 {
        if same(cut(h, i, i + n.len), n) { return true; }
    }
    return false;
}

fn check(ok: bool, what: string, bad: &int) {
    if !ok {
        printLn(what);
        *bad += 1;
    }
}

fn run(s: &Song, line: string, bad: &int) {
    let out = Text.new(s.mem);
    if !cmd.runAll(s, line, &out) {
        printLn(out.str());
        *bad += 1;
    }
}

fn refuses(s: &Song, line: string, bad: &int) {
    let out = Text.new(s.mem);
    let before = s.noteCount;
    if cmd.runAll(s, line, &out) || s.noteCount != before {
        printLn(line);
        *bad += 1;
    }
}

pub fn selftest(): int {
    let mem = Arena.create(256 * 1024 * 1024);
    let bad = 0;
    check(theory.parsePitch("C4") == 60, "C4", &bad);
    check(theory.parsePitch("A2") == 45, "A2", &bad);
    check(theory.parsePitch("Bb3") == 58, "Bb3", &bad);
    check(theory.parsePitch("Cb4") == 59, "Cb4", &bad);
    check(theory.parsePitch("B#3") == 60, "B#3", &bad);
    check(theory.parsePitch("kick") == 36, "kick", &bad);
    check(theory.parsePitch("H2") == -1, "H2", &bad);
    let c = Chord { root: 0, bass: 0, count: 0, tones: [0, 0, 0, 0, 0, 0] };
    check(theory.parseChord("F#m7", &c) && c.root == 6 && c.tones[1] == 3 && c.tones[3] == 10, "F#m7", &bad);
    check(theory.parseChord("G/B", &c) && c.root == 7 && c.bass == 11, "G/B", &bad);
    check(!theory.parseChord("Xm", &c), "Xm", &bad);
    check(theory.inKey(7, 9, true) && !theory.inKey(8, 9, true), "A minor has G, not G#", &bad);

    let s = song.create(&mem);
    run(&s, "song tempo=100 key=Am bars=4; chords Am F C G", &bad);
    run(&s, "track Bass; fill Bass root step=1/2", &bad);
    check(s.tracks[0].synth == 3, "a track named Bass gets the bass synth", &bad);
    check(s.noteCount == 32, "fill root step=1/2 over 4 bars is 32 notes", &bad);
    run(&s, "track Drums; beat Drums kick x...x...x...x...", &bad);
    check(s.noteCount == 32 + 16, "beat kick: 4 per bar", &bad);
    run(&s, "track Lead synth=lead; notes Lead 1:1 1/2 A4 C5 E5 _ - G4", &bad);
    check(s.noteCount == 48 + 4, "notes: three plus one, the third held", &bad);
    run(&s, "copy all bars=1-4 to=5", &bad);
    check(s.bars == 8 && same(s.chords[4], "Am"), "copy all brings the chords", &bad);
    check(s.noteCount == 52 * 2, "copy doubles the notes", &bad);
    refuses(&s, "note Lead 1:1 1 H9", &bad);
    refuses(&s, "fill Bass sideways", &bad);
    refuses(&s, "nonsense", &bad);
    refuses(&s, "notes Lead 9:1 1/2 C5", &bad);
    refuses(&s, "fill Bass root bars=7-12", &bad);
    check(s.bars == 8, "a refused note does not grow the song", &bad);
    run(&s, "section Verse bars=1-4; section Chorus bars=5-8", &bad);
    run(&s, "copy all bars=Chorus to=9", &bad);
    check(s.bars == 12 && same(song.chordAt(&s, 8), "Am"), "copy by section name", &bad);
    refuses(&s, "section 2nd bars=1-2", &bad);
    run(&s, "humanize all v=20 time=0.05", &bad);
    let moved = false;
    for i in 0..s.noteCount {
        if s.notes[i].vel != 100 || s.notes[i].beat - f32(int(s.notes[i].beat * 4.0)) * 0.25 > 0.001 { moved = true; }
        check(s.notes[i].vel >= 1 && s.notes[i].vel <= 127, "humanize keeps velocities in 1..127", &bad);
    }
    check(moved, "humanize changes notes", &bad);
    run(&s, "undo", &bad);
    let n = s.noteCount;
    run(&s, "clear Lead", &bad);
    run(&s, "undo", &bad);
    check(s.noteCount == n, "undo puts the notes back", &bad);

    // The newer features, each on a fresh song.
    let v = song.create(&mem);
    run(&v, "song tempo=90 key=C bars=2; chords Dm9 G9; track Keys synth=keys", &bad);
    run(&v, "fill Keys voiced rhythm=x_.x", &bad);
    check(v.noteCount == 16, "fill voiced: four voices on two hits a bar", &bad);
    let moves = 0;
    let lo = 0;
    let hi = 0;
    for i in 0..v.noteCount {
        let vn = &v.notes[i];
        if vn.beat < 4 { lo += vn.pitch; } else { hi += vn.pitch; }
        if vn.beat < 0.01 { check(vn.len > 1.9 && vn.len < 2.1, "fill voiced: _ holds the hit", &bad); }
    }
    moves = hi - lo;
    check(moves > -12 && moves < 12, "fill voiced: Dm9 to G9 moves little (voice leading)", &bad);
    run(&v, "track Drums; beat Drums hat 9.1.x... v=100", &bad);
    let vels = 0;
    for i in 0..v.noteCount {
        if v.notes[i].pitch == theory.HAT { vels += v.notes[i].vel; }
    }
    check(vels == (127 + 15 + 100) * 2, "beat digits: 9 is 127, 1 is 15", &bad);
    let dumped = Text.new(&mem);
    cmd.run(&v, "dump Drums bars=1", &dumped);
    check(contains(dumped.str(), "X...1...x......."), "dump prints velocity digits back", &bad);
    run(&v, "track Drums2 synth=drums; beat Drums2 kick x.x.x.x.; humanize Drums2", &bad);
    let onGrid = true;
    for i in 0..v.noteCount {
        let dn = &v.notes[i];
        if dn.track == 2 && dn.beat * 2.0 != f32(int(dn.beat * 2.0)) { onGrid = false; }
    }
    check(onGrid, "humanize keeps drum timing unless time= is given", &bad);
    run(&v, "track Pad; notes Pad 1:1 1/4 C4 C4 C4 C4 C4 C4 C4 C4; humanize Pad v=1 time=0.1", &bad);
    let over = Text.new(&mem);
    cmd.run(&v, "analyze", &over);
    check(!contains(over.str(), "overlapping"), "humanize makes no same-pitch overlaps", &bad);
    run(&v, "note Pad 1:1 2 E4; note Pad 1:2 1 E4", &bad);
    let over2 = Text.new(&mem);
    cmd.run(&v, "analyze", &over2);
    check(contains(over2.str(), "Pad bar 1:2 E4 starts while"), "analyze says where notes overlap", &bad);
    run(&v, "song swing=0.66 noise=0.3; track Keys reverb=0.4 drive=0.2", &bad);
    let vt = Text.new(&mem);
    format.write(&v, &vt);
    let v2 = song.create(&mem);
    let verr = Text.new(&mem);
    check(format.parse(vt.str(), &v2, &verr) && v2.swing == v.swing && v2.noise == v.noise && v2.tracks[0].reverb == v.tracks[0].reverb && v2.tracks[0].drive == v.tracks[0].drive, "swing, noise, reverb, drive are saved", &bad);
    let vst = Stats { peak: 0, rms: 0, hot: 0, seconds: 0, loud: 0 };
    // Parsed twice, so both have the notes in file order (each note's index seeds its drum noise).
    let v3 = song.create(&mem);
    format.parse(vt.str(), &v3, &verr);
    let r1 = mix.render(&v3, &mem, &vst);
    let r2 = mix.render(&v2, &mem, &vst);
    let fxSame = r1.len == r2.len;
    for i in 0..r1.len {
        if fxSame && r1[i] != r2[i] { fxSame = false; }
    }
    check(fxSame, "effects render the same samples every time", &bad);
    let lp = mix.renderLoop(&v, &mem, &vst);
    check(lp.len == mix.loopFrames(&v) * 2 && lp.len < r1.len, "--loop cuts at bars * meter beats", &bad);

    let t = Text.new(&mem);
    format.write(&s, &t);
    let s2 = song.create(&mem);
    let err = Text.new(&mem);
    check(format.parse(t.str(), &s2, &err), err.str(), &bad);
    let t2 = Text.new(&mem);
    format.write(&s2, &t2);
    check(same(t.str(), t2.str()), "the file format round-trips", &bad);

    let st = Stats { peak: 0, rms: 0, hot: 0, seconds: 0, loud: 0 };
    let a = mix.render(&s, &mem, &st);
    let b = mix.render(&s2, &mem, &st);
    let sameSamples = a.len == b.len;
    for i in 0..a.len {
        if sameSamples && a[i] != b[i] { sameSamples = false; }
    }
    check(sameSamples, "the same song renders the same samples", &bad);
    check(st.peak > 0.05 && st.peak <= 1.0, "the render is audible and inside -1..1", &bad);
    if bad == 0 { printLn("ok"); }
    return bad;
}
