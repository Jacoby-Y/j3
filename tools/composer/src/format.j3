// `.j3song` text: one line per thing, notes indented under their track.
//
//   # j3song 1
//   song tempo=96 meter=4 key=Am bars=8
//   chords Am F C G Am F E E
//   track Bass synth=bass vol=0.8 pan=0 tone=0.5
//     n 0 0.5 A2 100            # beat (from the song start), length in beats, pitch, velocity

module composer.format;

use j3.io;
use j3.memory.Arena;
use j3.result.Result;
use j3.text.{ Text, same };
use composer.song;
use composer.song.{ Song, Track };
use composer.synth;
use composer.theory;
use composer.theory.Chord;
use composer.util.{ cut, own, parseF, parseI, parseNum, pushNum, trim, valueOf, words };

pub fn write(s: &Song, out: &Text) {
    out.pushStr("# j3song 1\nsong tempo=");
    pushNum(out, s.tempo);
    out.pushStr(" meter=");
    out.pushInt(s.meter);
    out.pushStr(" key=");
    theory.pushKey(out, s.key, s.minor);
    out.pushStr(" bars=");
    out.pushInt(s.bars);
    if s.swing != 0.5 { out.pushStr(" swing="); pushNum(out, s.swing); }
    if s.noise > 0 { out.pushStr(" noise="); pushNum(out, s.noise); }
    out.pushStr("\nchords");
    let last = s.bars;
    for b in s.bars..song.MAXBARS {
        if s.chords[b].len > 0 { last = b + 1; }
    }
    for b in 0..last {
        out.push(32);
        out.pushStr(if s.chords[b].len > 0 { s.chords[b] } else { "-" });
    }
    out.push(10);
    for i in 0..s.sectionCount {
        let sec = &s.sections[i];
        out.pushStr("section ");
        out.pushStr(sec.name);
        out.pushStr(" bars=");
        out.pushInt(sec.a);
        out.push(45);
        out.pushInt(sec.b);
        out.push(10);
    }
    let mem = Arena.create(song.MAXNOTES * 16 + 1024);
    defer mem.destroy();
    let ord = song.order(s, &mem);
    let k = 0;
    for t in 0..s.trackCount {
        let tr = &s.tracks[t];
        out.pushStr("track ");
        out.pushStr(tr.name);
        out.pushStr(" synth=");
        out.pushStr(synth.name(tr.synth));
        out.pushStr(" vol=");
        pushNum(out, tr.vol);
        out.pushStr(" pan=");
        pushNum(out, tr.pan);
        out.pushStr(" tone=");
        pushNum(out, tr.tone);
        if tr.reverb > 0 { out.pushStr(" reverb="); pushNum(out, tr.reverb); }
        if tr.drive > 0 { out.pushStr(" drive="); pushNum(out, tr.drive); }
        if tr.mute { out.pushStr(" mute"); }
        if tr.solo { out.pushStr(" solo"); }
        out.push(10);
        let drums = tr.synth == synth.DRUMS;
        while k < ord.len && s.notes[ord[k]].track == t {
            let n = &s.notes[ord[k]];
            out.pushStr("  n ");
            pushNum(out, n.beat);
            out.push(32);
            pushNum(out, n.len);
            out.push(32);
            theory.pushPitch(out, n.pitch, drums);
            out.push(32);
            out.pushInt(n.vel);
            out.push(10);
            k += 1;
        }
    }
}

pub fn save(path: string, s: &Song, err: &Text): bool {
    let mem = Arena.create(4 * 1024 * 1024);
    defer mem.destroy();
    let t = Text.new(&mem);
    write(s, &t);
    match io.writeFile(path, t.bytes[0..t.len()]) {
        Result.Ok(_) {
            s.dirty = false;
            return true;
        }
        Result.Err(_) {
            err.pushStr("cannot write ");
            err.pushStr(path);
            err.pushStr(" (does its folder exist?)");
            return false;
        }
    }
}

fn bad(err: &Text, line: int, msg: string, what: string) {
    err.pushStr("line ");
    err.pushInt(line);
    err.pushStr(": ");
    err.pushStr(msg);
    if what.len > 0 {
        err.pushStr(" `");
        err.pushStr(what);
        err.pushStr("`");
    }
}

fn onLine(err: &Text, line: int) {
    err.pushStr(" on line ");
    err.pushInt(line);
}

/// Track settings from `key=value` words (synth, vol, pan, tone) and the flags mute/solo. Shared with
/// the `track` command.
pub fn trackWord(tr: &Track, w: string, err: &Text): bool {
    let v = valueOf(w, "synth");
    if v.len > 0 {
        let id = synth.find(v);
        if id < 0 {
            err.pushStr("unknown synth ");
            err.pushStr(v);
            err.pushStr(" (sine lead pad bass pluck keys drums)");
            return false;
        }
        tr.synth = id;
        return true;
    }
    let f: f32 = 0;
    v = valueOf(w, "vol");
    if v.len > 0 && parseF(v, &f) && f >= 0 && f <= 1.5 { tr.vol = f; return true; }
    v = valueOf(w, "pan");
    if v.len > 0 && parseF(v, &f) && f >= -1 && f <= 1 { tr.pan = f; return true; }
    v = valueOf(w, "tone");
    if v.len > 0 && parseF(v, &f) && f >= 0 && f <= 1 { tr.tone = f; return true; }
    v = valueOf(w, "reverb");
    if v.len > 0 && parseF(v, &f) && f >= 0 && f <= 1 { tr.reverb = f; return true; }
    v = valueOf(w, "drive");
    if v.len > 0 && parseF(v, &f) && f >= 0 && f <= 1 { tr.drive = f; return true; }
    if same(w, "mute") { tr.mute = true; return true; }
    if same(w, "solo") { tr.solo = true; return true; }
    err.pushStr("bad track setting ");
    err.pushStr(w);
    err.pushStr(" (synth=NAME vol=0..1.5 pan=-1..1 tone=0..1 reverb=0..1 drive=0..1 mute solo)");
    return false;
}

/// Song settings from `key=value` words. Shared with the `song` command.
pub fn songWord(s: &Song, w: string, err: &Text): bool {
    let f: f32 = 0;
    let i = 0;
    let v = valueOf(w, "tempo");
    if v.len > 0 && parseF(v, &f) && f >= 20 && f <= 400 { s.tempo = f; return true; }
    v = valueOf(w, "swing");
    if v.len > 0 && parseF(v, &f) && f >= 0.5 && f <= 0.75 { s.swing = f; return true; }
    v = valueOf(w, "noise");
    if v.len > 0 && parseF(v, &f) && f >= 0 && f <= 1 { s.noise = f; return true; }
    v = valueOf(w, "meter");
    if v.len > 0 && parseI(v, &i) && i >= 1 && i <= 16 { s.meter = i; return true; }
    v = valueOf(w, "bars");
    if v.len > 0 && parseI(v, &i) && i >= 1 && i <= song.MAXBARS { s.bars = i; return true; }
    v = valueOf(w, "key");
    if v.len > 0 && theory.parseKey(v, &s.key, &s.minor) { return true; }
    err.pushStr("bad song setting ");
    err.pushStr(w);
    err.pushStr(" (tempo=20..400 meter=1..16 bars=1..256 key=Am|C|F#m swing=0.5..0.75 noise=0..1)");
    return false;
}

/// Replace `s` with the song in `src`.
pub fn parse(src: string, s: &Song, err: &Text): bool {
    song.clearAll(s);
    let mem = Arena.create(64 * 1024);
    defer mem.destroy();
    let track = -1;
    let at = 0;
    let line = 0;
    while at < src.len {
        let end = at;
        while end < src.len && src[end] != 10 { end += 1; }
        line += 1;
        let text = trim(cut(src, at, end));
        at = end + 1;
        if text.len == 0 { continue; }
        mem.rewind(0);
        let w = words(text, &mem);
        let head = w[0];
        if same(head, "song") {
            for i in 1..w.len {
                if !songWord(s, w[i], err) { onLine(err, line); return false; }
            }
        } else if same(head, "chords") {
            for i in 1..w.len {
                if i > song.MAXBARS { bad(err, line, "more than 256 bars", ""); return false; }
                let c = Chord { root: 0, bass: 0, count: 0, tones: [0, 0, 0, 0, 0, 0] };
                if same(w[i], "-") { s.chords[i - 1] = ""; }
                else if theory.parseChord(w[i], &c) { s.chords[i - 1] = own(s.mem, w[i]); }
                else { bad(err, line, "not a chord", w[i]); return false; }
            }
        } else if same(head, "section") {
            let a = 0;
            let b = 0;
            if w.len != 3 || !parseBars(valueOf(w[2], "bars"), &a, &b) { bad(err, line, "section NAME bars=A-B", ""); return false; }
            if !song.setSection(s, w[1], a, b) { bad(err, line, "too many sections (32)", ""); return false; }
        } else if same(head, "track") {
            if w.len < 2 { bad(err, line, "track wants a name", ""); return false; }
            track = song.addTrack(s, w[1], synth.SINE);
            if track < 0 { bad(err, line, "too many tracks (16)", ""); return false; }
            for i in 2..w.len {
                if !trackWord(&s.tracks[track], w[i], err) { onLine(err, line); return false; }
            }
        } else if same(head, "n") {
            if track < 0 { bad(err, line, "a note before any track", ""); return false; }
            if w.len < 4 { bad(err, line, "n wants BEAT LEN PITCH [VEL]", ""); return false; }
            let beat: f32 = 0;
            let len: f32 = 0;
            let vel = 100;
            if !parseNum(w[1], &beat) || beat < 0 { bad(err, line, "bad beat", w[1]); return false; }
            if !parseNum(w[2], &len) || len <= 0 { bad(err, line, "bad length", w[2]); return false; }
            let p = theory.parsePitch(w[3]);
            if p < 0 { bad(err, line, "bad pitch", w[3]); return false; }
            if w.len > 4 && (!parseI(w[4], &vel) || vel < 1 || vel > 127) { bad(err, line, "velocity is 1..127", w[4]); return false; }
            if !song.addNote(s, track, beat, len, p, vel) { bad(err, line, "too many notes", ""); return false; }
        } else {
            bad(err, line, "unknown line", head);
            return false;
        }
    }
    s.dirty = false;
    return true;
}

/// `A-B` or `A` (then `b` is `a`), 1..256 with A <= B.
pub fn parseBars(v: string, a: &int, b: &int): bool {
    if v.len == 0 { return false; }
    let dash = -1;
    for i in 0..v.len { if v[i] == 45 { dash = i; } }
    let ok = if dash < 0 { parseI(v, a) } else { parseI(cut(v, 0, dash), a) && parseI(cut(v, dash + 1, v.len), b) };
    if dash < 0 { *b = *a; }
    return ok && *a >= 1 && *b >= *a && *b <= song.MAXBARS;
}

pub fn load(path: string, s: &Song, err: &Text): bool {
    let mem = Arena.create(64 * 1024 * 1024);
    defer mem.destroy();
    match io.readFile(path, &mem) {
        Result.Ok(bytes) { return parse(bytes as string, s, err); }
        Result.Err(_) {
            err.pushStr("cannot read ");
            err.pushStr(path);
            return false;
        }
    }
}
