// gui: screen rectangles, fit and playback position.

module composer.gui;

// ---- layout ----

fn timeX(): f32 {
    return LEFT + KEYS;
}

fn chordRect(win: Vec2): Rect {
    return rect(timeX(), TOP, win.x - timeX(), CHORD_H);
}

fn rulerRect(win: Vec2): Rect {
    return rect(timeX(), TOP + CHORD_H, win.x - timeX(), RULER_H);
}

fn arrangeH(w: &World): f32 {
    let h = f32(w.s.trackCount) * ROW_H;
    if h < ROW_H * 2 { h = ROW_H * 2; }
    if h > ROW_H * 8 { h = ROW_H * 8; }
    return h;
}

fn arrangeRect(w: &World, win: Vec2): Rect {
    return rect(timeX(), TOP + CHORD_H + RULER_H, win.x - timeX(), arrangeH(w));
}

/// The roll, keyboard included (its notes start `KEYS` in).
fn rollRect(w: &World, win: Vec2): Rect {
    let y = TOP + CHORD_H + RULER_H + arrangeH(w) + 4;
    return rect(LEFT, y, win.x - LEFT, win.y - BOTTOM - VEL_H - y);
}

fn notesRect(w: &World, win: Vec2): Rect {
    let r = rollRect(w, win);
    return rect(r.x + KEYS, r.y, r.w - KEYS, r.h);
}

fn velRect(w: &World, win: Vec2): Rect {
    return rect(LEFT, win.y - BOTTOM - VEL_H, win.x - LEFT, VEL_H);
}

/// Show the whole song across the view.
fn fitTime(w: &World, win: Vec2) {
    let beats = f32(w.s.bars * w.s.meter);
    w.cam.ppb = (win.x - timeX() - 20) / beats;
    if w.cam.ppb < 4 { w.cam.ppb = 4; }
    w.cam.left = 0;
}

// ---- audio ----

fn heardBeat(w: &World): f32 {
    let f = stream.position(&w.player);
    return f32(f) / f32(mix.RATE) / song.secondsPerBeat(&w.s);
}

fn beatFrame(w: &World, beat: f32): int {
    return int(beat * song.secondsPerBeat(&w.s) * f32(mix.RATE));
}
