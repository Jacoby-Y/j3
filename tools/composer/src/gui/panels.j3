// gui: save, theme, top and bottom bars, track panel, console and log card.

module composer.gui;

fn save(w: &World) {
    let err = Text.new(scratch(0));
    if format.save(w.path, &w.s, &err) {
        w.closeWarned = false;
        let t = Text.new(scratch(0));
        t.pushStr("Saved ");
        t.pushStr(w.path);
        say(w, t.str());
    } else {
        say(w, err.str());
    }
}

// ---- panels ----

fn theme(): Theme {
    return Theme {
        text: rgb(222, 226, 234),
        button: rgb(52, 56, 66),
        buttonHot: rgb(68, 74, 88),
        buttonDown: rgb(40, 43, 51),
        panel: rgb(34, 37, 44),
        edge: rgb(60, 64, 76),
        accent: rgb(72, 128, 220),
    };
}

fn toggleButton(ui: &Ui, msg: string, on: bool, c: Color): bool {
    let keep = ui.theme.button;
    if on { ui.theme.button = c; }
    let hit = ui.button(msg);
    ui.theme.button = keep;
    return hit;
}

fn section(ui: &Ui, msg: string) {
    ui.gap(6);
    let keep = ui.theme.text;
    ui.theme.text = rgb(140, 170, 230);
    ui.labelBold(msg);
    ui.theme.text = keep;
}

fn topBar(ui: &Ui, w: &World, win: Vec2) {
    fill(0, 0, win.x, TOP, rgb(30, 33, 40));
    ui.x = 10;
    ui.y = 8;
    ui.h = 28;
    ui.space = 6;
    ui.row();
    if toggleButton(ui, if w.player.playing { "  Stop  " } else { "  Play  " }, w.player.playing, rgb(60, 140, 90)) { togglePlay(w); }
    if toggleButton(ui, " Loop ", w.player.loop, ui.theme.accent) { w.player.loop = !w.player.loop; setLoop(w); }
    let st = Text.new(scratch(0));
    st.pushStr(" Snap ");
    st.pushStr(SNAP_NAMES[w.snapAt]);
    st.pushStr(" ");
    if ui.button(st.str()) { w.snapAt = (w.snapAt + 1) % 6; }
    if ui.button(" Fit ") { fitTime(w, win); }
    if ui.button(" Save ") { save(w); }
    ui.end();
    let t = Text.new(scratch(0));
    t.pushStr(w.path);
    if w.s.dirty { t.pushStr(" *"); }
    t.pushStr("    ");
    view.pushWhere(&t, &w.s, if w.player.playing { heardBeat(w) } else { w.cursor });
    t.pushStr("    ");
    pushNum(&t, w.s.tempo);
    t.pushStr(" bpm  ");
    t.pushInt(w.s.meter);
    t.pushStr("/4  key ");
    theory.pushKey(&t, w.s.key, w.s.minor);
    text(w.font, 470, 14, t.str(), rgb(200, 204, 214));
}

fn trackPanel(ui: &Ui, w: &World, win: Vec2) {
    fill(0, TOP, LEFT, win.y - TOP - BOTTOM, rgb(34, 37, 44));
    fill(LEFT - 2, TOP, 2, win.y - TOP - BOTTOM, rgb(52, 56, 66));
    ui.x = 10;
    ui.y = TOP + 4;
    ui.w = LEFT - 20;
    ui.h = 26;
    ui.space = 3;
    section(ui, "Tracks");
    let s = &w.s;
    for t in 0..s.trackCount {
        let tr = &s.tracks[t];
        ui.pushId(t);
        ui.row();
        let name = Text.new(scratch(0));
        name.pushStr(tr.name);
        while name.len() < 12 { name.push(32); }
        if toggleButton(ui, name.str(), t == w.sel, view.hue(t)) {
            if w.sel != t {
                w.sel = t;
                w.chosen = -1;
                shot.fitPitch(s, t, &w.cam, rollRect(w, win).h);
            }
        }
        if toggleButton(ui, " M ", tr.mute, rgb(170, 90, 60)) { song.snapshot(s); tr.mute = !tr.mute; edited(w); }
        if toggleButton(ui, " S ", tr.solo, rgb(180, 160, 60)) { song.snapshot(s); tr.solo = !tr.solo; edited(w); }
        ui.end();
        ui.popId();
    }
    ui.row();
    if ui.button(" + Track ") { addTrack(w); }
    if w.sel < s.trackCount && ui.button(" Delete ") {
        song.snapshot(s);
        song.delTrack(s, w.sel);
        if w.sel >= s.trackCount && w.sel > 0 { w.sel -= 1; }
        w.chosen = -1;
        edited(w);
    }
    ui.end();
    if w.sel < s.trackCount {
        let cur = &s.tracks[w.sel];
        section(ui, cur.name);
        let before = *cur;
        let changed = false;
        let sy = Text.new(scratch(0));
        sy.pushStr("Synth: ");
        sy.pushStr(synth.name(cur.synth));
        if ui.button(sy.str()) {
            song.snapshot(s);
            cur.synth = (cur.synth + 1) % synth.COUNT;
            edited(w);
            audition(w, 60);
        }
        if ui.slider("Volume", &cur.vol, 0, 1.5) { changed = true; }
        if ui.slider("Pan", &cur.pan, -1, 1) { changed = true; }
        if ui.slider("Tone", &cur.tone, 0, 1) { changed = true; }
        if changed && !w.sliding {
            // One undo step per drag: snapshot the values from before it started.
            let now = *cur;
            *cur = before;
            song.snapshot(s);
            *cur = now;
            w.sliding = true;
        }
        if changed { s.dirty = true; }
    }
    section(ui, "Song");
    let tempo = s.tempo;
    if ui.number("Tempo", &tempo, 0.25) && tempo >= 20 && tempo <= 400 {
        if !w.sliding { song.snapshot(s); w.sliding = true; }
        s.tempo = f32(int(tempo));
        s.dirty = true;
    }
    let bars = s.bars;
    if ui.stepper("Bars", &bars, 1, song.MAXBARS) { song.snapshot(s); s.bars = bars; edited(w); }
    let meter = s.meter;
    if ui.stepper("Beats/bar", &meter, 1, 16) { song.snapshot(s); s.meter = meter; edited(w); }
    let kt = Text.new(scratch(0));
    kt.pushStr(" Key ");
    theory.pushKey(&kt, s.key, s.minor);
    kt.pushStr(" ");
    ui.row();
    if ui.button(" < ") { song.snapshot(s); s.key = (s.key + 11) % 12; edited(w); }
    ui.label(kt.str());
    if ui.button(" > ") { song.snapshot(s); s.key = (s.key + 1) % 12; edited(w); }
    if toggleButton(ui, " minor ", s.minor, ui.theme.accent) { song.snapshot(s); s.minor = !s.minor; edited(w); }
    ui.end();
    let pst = w.player.stats;
    if !w.stale {
        let pt = Text.new(scratch(0));
        pt.pushStr("peak ");
        pt.pushInt(int(pst.peak * 100.0));
        pt.pushStr("%");
        if pst.hot > 1000 { pt.pushStr("  (too loud)"); }
        ui.label(pt.str());
    }
}

fn addTrack(w: &World) {
    let name = Text.new(w.mem);
    let k = w.s.trackCount + 1;
    name.pushStr("Track");
    name.pushInt(k);
    while song.findTrack(&w.s, name.str()) >= 0 {
        k += 1;
        name.clear();
        name.pushStr("Track");
        name.pushInt(k);
    }
    song.snapshot(&w.s);
    let t = song.addTrack(&w.s, name.str(), synth.KEYS);
    if t < 0 { say(w, "16 tracks is the most."); return; }
    w.sel = t;
    w.chosen = -1;
    edited(w);
    say(w, "New track: pick its synth on the left; `rename` in the console names it.");
}

fn bottomBar(ui: &Ui, w: &World, win: Vec2): string {
    fill(0, win.y - BOTTOM, win.x, BOTTOM, rgb(28, 30, 36));
    text(w.font, 12, win.y - BOTTOM + 10, w.status.str(), rgb(200, 204, 214));
    ui.x = win.x - 620;
    ui.y = win.y - BOTTOM + 6;
    ui.w = 608;
    ui.h = 26;
    ui.space = 0;
    ui.field("cmd", &w.console);
    if ui.focused("cmd") && game.keyPressed(Key.Enter) {
        let line = Text.new(scratch(0));
        line.pushStr(w.console.str());
        w.console.clear();
        return line.str();
    }
    return "";
}

fn console(w: &World, line: string) {
    if line.len == 0 { return; }
    let out = Text.new(scratch(0));
    let before = w.s.dirty;
    w.s.dirty = false;
    let ok = cmd.runAll(&w.s, line, &out);
    let changed = w.s.dirty;
    w.s.dirty = before || changed;
    w.log.clear();
    w.log.pushStr(out.str());
    if changed { w.chosen = -1; edited(w); }
    if w.sel >= w.s.trackCount && w.s.trackCount > 0 { w.sel = w.s.trackCount - 1; }
    say(w, if !ok { "That command failed; the details are above (Esc hides them)." } else if out.len() > 0 { "Done (Esc hides the output)." } else { "Done." });
}

fn logCard(w: &World, win: Vec2) {
    if w.log.len() == 0 || w.font.raw == 0 { return; }
    let s = w.log.str();
    let rows = 1;
    for i in 0..s.len {
        if s[i] == 10 && i + 1 < s.len { rows += 1; }
    }
    if rows > 30 { rows = 30; }
    let top = win.y - BOTTOM - 10 - f32(rows) * 18;
    fill(LEFT + 8, top - 6, win.x - LEFT - 16, f32(rows) * 18 + 12, rgba(16, 18, 24, 236));
    let at = 0;
    let row = 0;
    while at < s.len && row < rows {
        let end = at;
        while end < s.len && s[end] != 10 { end += 1; }
        text(w.font, LEFT + 16, top + f32(row) * 18, cut(s, at, end), rgb(214, 218, 228));
        row += 1;
        at = end + 1;
    }
}
