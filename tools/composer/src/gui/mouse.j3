// gui: wheel, hit tests, press, drag, release and per-frame input.

module composer.gui;

/// Wheel: over the roll it scrolls pitches (Shift: time); anywhere Ctrl zooms time around the mouse.
fn wheel(w: &World, mp: Vec2, win: Vec2) {
    let d = game.mouseWheel();
    if d == 0 || mp.x < LEFT { return; }
    let nr = notesRect(w, win);
    if game.keyDown(Key.Ctrl) {
        let at = view.xBeat(&w.cam, nr, mp.x);
        w.cam.ppb *= if d > 0 { 1.2 } else { 0.8333 };
        if w.cam.ppb < 3 { w.cam.ppb = 3; }
        if w.cam.ppb > 600 { w.cam.ppb = 600; }
        w.cam.left = at - (mp.x - nr.x) / w.cam.ppb;
        return;
    }
    if view.inside(rollRect(w, win), mp) && !game.keyDown(Key.Shift) {
        w.cam.top += d * 3;
        if w.cam.top > 127 { w.cam.top = 127; }
        if w.cam.top < 12 { w.cam.top = 12; }
        return;
    }
    w.cam.left -= d * 40 / w.cam.ppb;
}

fn snapped(w: &World, beat: f32): f32 {
    let g = snap(w);
    let b = floor(beat / g + 0.5) * g;
    return if b < 0 { 0 } else { b };
}

fn snappedDown(w: &World, beat: f32): f32 {
    let g = snap(w);
    let b = floor(beat / g) * g;
    return if b < 0 { 0 } else { b };
}

/// The note of the selected track under `mp`, or -1. Later notes win (they draw on top).
fn noteAt(w: &World, nr: Rect, mp: Vec2): int {
    let found = -1;
    for i in 0..w.s.noteCount {
        let n = &w.s.notes[i];
        if n.track != w.sel { continue; }
        let x = view.beatX(&w.cam, nr, n.beat);
        let y = view.pitchY(&w.cam, nr, n.pitch);
        if mp.x >= x && mp.x < x + n.len * w.cam.ppb && mp.y >= y && mp.y < y + w.cam.rowH { found = i; }
    }
    return found;
}

fn barAt(w: &World, r: Rect, x: f32): int {
    let b = int(floor(view.xBeat(&w.cam, r, x) / f32(w.s.meter))) + 1;
    if b < 1 { b = 1; }
    if b > song.MAXBARS { b = song.MAXBARS; }
    return b;
}

fn press(w: &World, mp: Vec2, win: Vec2) {
    let nr = notesRect(w, win);
    let cr = chordRect(win);
    let rr = rulerRect(win);
    let ar = arrangeRect(w, win);
    if view.inside(rr, mp) {
        w.drag = SEEK;
        return;
    }
    if view.inside(cr, mp) || view.inside(ar, mp) {
        if view.inside(ar, mp) {
            let t = int((mp.y - ar.y) / ROW_H);
            if t < w.s.trackCount && t != w.sel {
                w.sel = t;
                w.chosen = -1;
                shot.fitPitch(&w.s, t, &w.cam, rollRect(w, win).h);
            }
        }
        w.drag = BARS;
        w.barGrab = barAt(w, cr, mp.x);
        w.selA = w.barGrab;
        w.selB = w.barGrab;
        if view.inside(cr, mp) {
            w.console.clear();
            w.console.pushStr("chords at=");
            w.console.pushInt(w.barGrab);
            w.console.push(32);
            say(w, "Type chords for this bar on (Enter), like: Am F C G");
        }
        return;
    }
    if view.inside(velRect(w, win), mp) && mp.x > LEFT + KEYS {
        song.snapshot(&w.s);
        w.drag = VEL;
        return;
    }
    if !view.inside(nr, mp) || w.sel >= w.s.trackCount { return; }
    let hit = noteAt(w, nr, mp);
    let beat = view.xBeat(&w.cam, nr, mp.x);
    let pitch = view.yPitch(&w.cam, nr, mp.y);
    song.snapshot(&w.s);
    if hit >= 0 {
        let n = &w.s.notes[hit];
        let right = view.beatX(&w.cam, nr, n.beat + n.len);
        w.drag = if right - mp.x < 7 && n.len * w.cam.ppb > 10 { RESIZE } else { MOVE };
        w.note = hit;
        w.chosen = hit;
        w.origBeat = n.beat;
        w.origPitch = n.pitch;
        w.origLen = n.len;
        if w.drag == MOVE { audition(w, n.pitch); }
    } else {
        if pitch < 0 || pitch > 127 { return; }
        let at = snappedDown(w, beat);
        if !song.addNote(&w.s, w.sel, at, w.noteLen, pitch, 100) { say(w, "The song is full."); return; }
        w.note = w.s.noteCount - 1;
        w.chosen = w.note;
        w.drag = RESIZE;
        w.origBeat = at;
        w.origPitch = pitch;
        w.origLen = w.noteLen;
        audition(w, pitch);
    }
    w.grabBeat = beat;
    w.grabPitch = pitch;
}

fn dragging(w: &World, mp: Vec2, win: Vec2) {
    let nr = notesRect(w, win);
    let beat = view.xBeat(&w.cam, nr, mp.x);
    if w.drag == SEEK {
        w.cursor = snapped(w, beat);
        if w.player.playing { stream.play(&w.player, beatFrame(w, w.cursor)); }
    } else if w.drag == BARS {
        let b = barAt(w, nr, mp.x);
        w.selA = if b < w.barGrab { b } else { w.barGrab };
        w.selB = if b < w.barGrab { w.barGrab } else { b };
    } else if w.drag == MOVE {
        let n = &w.s.notes[w.note];
        let nb = snapped(w, w.origBeat + beat - w.grabBeat);
        let np = w.origPitch + view.yPitch(&w.cam, nr, mp.y) - w.grabPitch;
        if np < 0 { np = 0; }
        if np > 127 { np = 127; }
        if np != n.pitch { audition(w, np); }
        n.beat = nb;
        n.pitch = np;
    } else if w.drag == RESIZE {
        let rn = &w.s.notes[w.note];
        let rend = snapped(w, beat);
        let rlen = rend - rn.beat;
        if rlen < snap(w) { rlen = snap(w); }
        rn.len = rlen;
    } else if w.drag == VEL {
        let vr = velRect(w, win);
        let vv = int(127.0 * (vr.y + vr.h - mp.y) / (vr.h - 6));
        if vv < 1 { vv = 1; }
        if vv > 127 { vv = 127; }
        let x0 = if w.lastMouse.x < mp.x { w.lastMouse.x } else { mp.x };
        let x1 = if w.lastMouse.x < mp.x { mp.x } else { w.lastMouse.x };
        for i in 0..w.s.noteCount {
            let vn = &w.s.notes[i];
            if vn.track != w.sel { continue; }
            let vx = view.beatX(&w.cam, nr, vn.beat);
            if vx >= x0 - 3 && vx <= x1 + 3 { vn.vel = vv; }
        }
    } else if w.drag == PAN {
        let pd = mp - w.lastMouse;
        w.cam.left -= pd.x / w.cam.ppb;
        w.cam.top += pd.y / w.cam.rowH;
    }
}

fn release(w: &World) {
    if w.drag == MOVE || w.drag == RESIZE || w.drag == VEL {
        if w.drag == RESIZE { w.noteLen = w.s.notes[w.note].len; }
        if w.drag != VEL {
            let n = &w.s.notes[w.note];
            let bar = int(floor((n.beat + n.len - 0.001) / f32(w.s.meter))) + 1;
            if bar > w.s.bars { w.s.bars = bar; }
            let t = Text.new(scratch(0));
            theory.pushPitch(&t, n.pitch, w.s.tracks[w.sel].synth == synth.DRUMS);
            t.pushStr(" at ");
            view.pushWhere(&t, &w.s, n.beat);
            t.pushStr(", ");
            pushNum(&t, n.len);
            t.pushStr(" beats");
            say(w, t.str());
        }
        edited(w);
    }
    if w.drag == BARS {
        setLoop(w);
        if w.selA > 0 {
            w.cursor = f32((w.selA - 1) * w.s.meter);
            let bt = Text.new(scratch(0));
            bt.pushStr("Bars ");
            bt.pushInt(w.selA);
            if w.selB > w.selA { bt.push(45); bt.pushInt(w.selB); }
            bt.pushStr(" selected: L loops them, Ctrl+D duplicates, Delete clears (Shift: every track).");
            say(w, bt.str());
        }
    }
    w.drag = NONE;
}

fn input(w: &World, dt: f32) {
    stream.pump(&w.player);
    let mp = game.mousePos();
    let win = game.windowSize();
    if game.closeRequested() {
        if w.s.dirty && !w.closeWarned {
            w.closeWarned = true;
            say(w, "Unsaved changes: Ctrl+S saves, close again to throw them away.");
        } else {
            game.requestQuit();
        }
    }
    if !typing() { shortcuts(w); }
    wheel(w, mp, win);
    if game.mousePressed(Mouse.Left) && mp.x > LEFT && mp.y > TOP && mp.y < win.y - BOTTOM { press(w, mp, win); }
    if game.mousePressed(Mouse.Middle) && mp.x > LEFT { w.drag = PAN; }
    if game.mousePressed(Mouse.Right) && w.drag == NONE {
        let hit = noteAt(w, notesRect(w, win), mp);
        if hit >= 0 && view.inside(notesRect(w, win), mp) {
            song.snapshot(&w.s);
            song.delNote(&w.s, hit);
            w.chosen = -1;
            edited(w);
        }
    }
    if w.drag != NONE { dragging(w, mp, win); }
    if w.drag != NONE && !game.mouseDown(Mouse.Left) && !game.mouseDown(Mouse.Middle) { release(w); }
    if !game.mouseDown(Mouse.Left) && w.sliding {
        w.sliding = false;
        edited(w);
    }
    w.lastMouse = mp;
}
