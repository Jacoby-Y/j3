// gui: loop, play, edit bookkeeping, shortcuts and quiet commands.

module composer.gui;

fn setLoop(w: &World) {
    let p = &w.player;
    if w.selA > 0 {
        p.from = beatFrame(w, f32((w.selA - 1) * w.s.meter));
        p.to = beatFrame(w, f32(w.selB * w.s.meter));
    } else {
        p.from = 0;
        p.to = beatFrame(w, f32(w.s.bars * w.s.meter));
    }
    if p.to > p.frames { p.to = p.frames; }
}

fn togglePlay(w: &World) {
    if w.player.playing {
        stream.stop(&w.player);
        return;
    }
    if w.stale {
        stream.load(&w.player, &w.s);
        w.stale = false;
    }
    setLoop(w);
    let start = beatFrame(w, w.cursor);
    if w.player.loop && (start < w.player.from || start >= w.player.to) { start = w.player.from; }
    if !stream.play(&w.player, start) { say(w, "No audio device (SDL could not open one)."); }
}

/// After an edit: render again now when playing, else on the next play.
fn edited(w: &World) {
    w.s.dirty = true;
    if w.player.playing {
        stream.refresh(&w.player, &w.s);
        setLoop(w);
        w.stale = false;
    } else {
        w.stale = true;
    }
}

/// Hear one note now (when not playing).
fn audition(w: &World, pitch: int) {
    if w.player.playing || w.sel < 0 || w.sel >= w.s.trackCount { return; }
    let tr = &w.s.tracks[w.sel];
    stream.preview(&w.player, pitch, tr.synth, tr.tone, tr.vol);
}

// ---- input ----

fn shortcuts(w: &World) {
    let ctrl = game.keyDown(Key.Ctrl);
    let shift = game.keyDown(Key.Shift);
    if ctrl && game.keyPressed(Key.S) { save(w); }
    if ctrl && game.keyPressed(Key.Z) {
        if song.undo(&w.s) { w.chosen = -1; edited(w); say(w, "Undone."); } else { say(w, "Nothing to undo."); }
    }
    if ctrl && game.keyPressed(Key.D) && w.selA > 0 { duplicate(w, shift); }
    if ctrl { return; }
    if game.keyPressed(Key.Space) { togglePlay(w); }
    if game.keyPressed(Key.Home) { w.cursor = 0; w.cam.left = -0.25; }
    if game.keyPressed(Key.L) {
        w.player.loop = !w.player.loop;
        setLoop(w);
        say(w, if w.player.loop { "Loop on (the selected bars, or the whole song)." } else { "Loop off." });
    }
    if game.keyPressed(Key.F) { fitTime(w, game.windowSize()); }
    if game.keyPressed(Key.F2) { w.log.clear(); cmd.helpText(&w.log); }
    if game.keyPressed(Key.Escape) { w.log.clear(); w.chosen = -1; w.selA = 0; w.selB = 0; setLoop(w); }
    if game.keyPressed(Key.Delete) || game.keyPressed(Key.Backspace) {
        if w.chosen >= 0 {
            song.snapshot(&w.s);
            song.delNote(&w.s, w.chosen);
            w.chosen = -1;
            edited(w);
        } else if w.selA > 0 && w.sel < w.s.trackCount {
            runQuiet(w, "clear", shift);
        }
    }
    if w.chosen >= 0 {
        let n = &w.s.notes[w.chosen];
        let dp = 0;
        let db: f32 = 0;
        if game.keyPressed(Key.Up) { dp = if shift { 12 } else { 1 }; }
        if game.keyPressed(Key.Down) { dp = if shift { -12 } else { -1 }; }
        if game.keyPressed(Key.Right) { db = snap(w); }
        if game.keyPressed(Key.Left) { db = 0 - snap(w); }
        if dp != 0 || db != 0 {
            if n.pitch + dp >= 0 && n.pitch + dp <= 127 && n.beat + db >= 0 {
                song.snapshot(&w.s);
                n.pitch += dp;
                n.beat += db;
                edited(w);
                if dp != 0 { audition(w, n.pitch); }
            }
        }
    }
}

/// `clear` or a duplicate of the selected bars, through the command language.
fn runQuiet(w: &World, what: string, all: bool) {
    let line = Text.new(scratch(0));
    line.pushStr(what);
    line.push(32);
    line.pushStr(if all { "all" } else { w.s.tracks[w.sel].name });
    line.pushStr(" bars=");
    line.pushInt(w.selA);
    line.push(45);
    line.pushInt(w.selB);
    if same(what, "copy") {
        line.pushStr(" to=");
        line.pushInt(w.selB + 1);
    }
    let out = Text.new(scratch(0));
    if cmd.run(&w.s, line.str(), &out) {
        w.chosen = -1;
        edited(w);
        say(w, line.str());
    } else {
        w.log.clear();
        w.log.pushStr(out.str());
    }
}

fn duplicate(w: &World, all: bool) {
    if w.sel >= w.s.trackCount && !all { return; }
    runQuiet(w, "copy", all);
    let span = w.selB - w.selA + 1;
    w.selA += span;
    w.selB += span;
}
