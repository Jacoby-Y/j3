// cmd: the Args cursor over a command line and its parse helpers.

module composer.cmd;

struct Args {
    w: []string;
    at: int;
    err: &Text;
}

fn problem(a: &Args, msg: string) {
    a.err.pushStr("error: ");
    a.err.pushStr(msg);
    a.err.push(10);
}

fn problem2(a: &Args, msg: string, what: string) {
    a.err.pushStr("error: ");
    a.err.pushStr(msg);
    a.err.pushStr(" `");
    a.err.pushStr(what);
    a.err.pushStr("`\n");
}

fn trackArg(s: &Song, a: &Args, allowAll: bool): int {
    if a.at >= a.w.len { problem(a, "this command wants a track name (`info` lists them)"); return -2; }
    let name = a.w[a.at];
    a.at += 1;
    if allowAll && same(name, "all") { return -1; }
    let t = song.findTrack(s, name);
    if t < 0 { problem2(a, "no track", name); return -2; }
    return t;
}

/// BAR:BEAT (1-based) or a beat from the song start.
fn parsePos(s: &Song, w: string, out: &f32): bool {
    for i in 0..w.len {
        if w[i] == 58 {
            let bar = 0;
            let beat: f32 = 0;
            if !parseI(cut(w, 0, i), &bar) || bar < 1 { return false; }
            if !parseNum(cut(w, i + 1, w.len), &beat) || beat < 1 { return false; }
            *out = f32((bar - 1) * s.meter) + beat - 1.0;
            return true;
        }
    }
    return parseNum(w, out) && *out >= 0;
}

/// Options shared by the pattern commands, read from `key=value` words anywhere after the fixed ones.
struct Opts {
    a: int;
    b: int;
    step: f32;
    oct: int;
    vel: int;
    to: int;
    times: int;
    at: int;
    time: f32;
    /// `rhythm=` for `fill voiced`, "" when not given.
    pat: string;
    hasStep: bool;
    hasOct: bool;
    hasVel: bool;
    hasTime: bool;
}

fn noOpts(): Opts {
    return Opts { a: 0, b: 0, step: 0, oct: 0, vel: 0, to: 0, times: 0, at: 0, time: 0, pat: "", hasStep: false, hasOct: false, hasVel: false, hasTime: false };
}

/// `bars=` value: A-B, one bar, or a section name.
fn barsOf(s: &Song, v: string, a: &int, b: &int): bool {
    if format.parseBars(v, a, b) { return true; }
    let i = song.findSection(s, v);
    if i < 0 { return false; }
    *a = s.sections[i].a;
    *b = s.sections[i].b;
    return true;
}

fn opts(s: &Song, a: &Args, o: &Opts): bool {
    o.a = 1;
    o.b = s.bars;
    o.step = 1;
    o.oct = -99;
    o.vel = 100;
    o.to = 0;
    o.times = 1;
    o.at = 1;
    o.time = 0;
    o.pat = "";
    o.hasStep = false;
    o.hasOct = false;
    o.hasVel = false;
    o.hasTime = false;
    while a.at < a.w.len {
        let w = a.w[a.at];
        a.at += 1;
        let v = valueOf(w, "bars");
        if v.len > 0 {
            if !barsOf(s, v, &o.a, &o.b) { problem2(a, "bars is A-B, one bar, or a section name, like bars=1-4", w); return false; }
            continue;
        }
        v = valueOf(w, "step");
        if v.len > 0 {
            if !parseNum(v, &o.step) || o.step < 0.0625 { problem2(a, "step is in beats, like step=1/2", w); return false; }
            o.hasStep = true;
            continue;
        }
        v = valueOf(w, "oct");
        if v.len > 0 {
            if !parseI(v, &o.oct) || o.oct < 0 || o.oct > 8 { problem2(a, "oct is 0..8", w); return false; }
            o.hasOct = true;
            continue;
        }
        v = valueOf(w, "v");
        if v.len > 0 {
            if !parseI(v, &o.vel) || o.vel < 1 || o.vel > 127 { problem2(a, "v is a velocity 1..127", w); return false; }
            o.hasVel = true;
            continue;
        }
        v = valueOf(w, "to");
        if v.len > 0 {
            let sec = song.findSection(s, v);
            if sec >= 0 { o.to = s.sections[sec].a; continue; }
            if !parseI(v, &o.to) || o.to < 1 || o.to > song.MAXBARS { problem2(a, "to is a bar or a section, like to=5", w); return false; }
            continue;
        }
        v = valueOf(w, "time");
        if v.len > 0 {
            if !parseNum(v, &o.time) || o.time < 0 || o.time > 0.25 { problem2(a, "time is in beats, 0..0.25, like time=0.02", w); return false; }
            o.hasTime = true;
            continue;
        }
        v = valueOf(w, "rhythm");
        if v.len > 0 {
            for i in 0..v.len {
                if v[i] != 120 && v[i] != 95 && v[i] != 46 { problem2(a, "rhythm is x (hit) _ (hold) . (rest), like rhythm=x__..x_.", w); return false; }
            }
            o.pat = v;
            continue;
        }
        v = valueOf(w, "times");
        if v.len > 0 {
            if !parseI(v, &o.times) || o.times < 1 || o.times > 64 { problem2(a, "times is 1..64", w); return false; }
            continue;
        }
        v = valueOf(w, "at");
        if v.len > 0 {
            if !parseI(v, &o.at) || o.at < 1 || o.at > song.MAXBARS { problem2(a, "at is a bar, like at=5", w); return false; }
            continue;
        }
        problem2(a, "unknown option", w);
        return false;
    }
    return true;
}
