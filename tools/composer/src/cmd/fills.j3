// cmd: bar helpers, fill, voiced chords and drum beats.

module composer.cmd;

fn barStart(s: &Song, bar: int): f32 {
    return f32((bar - 1) * s.meter);
}

fn growBars(s: &Song, bar: int) {
    if bar > s.bars { s.bars = bar; }
}

/// Notes go inside the song. A position past the end is more often a typo than a plan.
fn fits(s: &Song, a: &Args, bar: int): bool {
    if bar <= s.bars { return true; }
    a.err.pushStr("error: bar ");
    a.err.pushInt(bar);
    a.err.pushStr(" is past the end of the song (");
    a.err.pushInt(s.bars);
    a.err.pushStr(" bars); `bars ");
    a.err.pushInt(bar);
    a.err.pushStr("` makes it longer\n");
    return false;
}

fn chordOf(s: &Song, bar: int, c: &Chord): bool {
    let sym = song.chordAt(s, bar - 1);
    return sym.len > 0 && theory.parseChord(sym, c);
}

fn blank(): Chord {
    return Chord { root: 0, bass: 0, count: 0, tones: [0, 0, 0, 0, 0, 0] };
}

fn fill(s: &Song, t: int, style: string, o: &Opts, a: &Args): bool {
    if same(style, "voiced") { return voiced(s, t, o, a); }
    let block = same(style, "block");
    let low = same(style, "root") || same(style, "fifths");
    if !low && !block && !same(style, "stab") && !same(style, "arp") && !same(style, "arpdown") && !same(style, "arpupdown") {
        problem2(a, "fill style is root fifths block stab arp arpdown arpupdown voiced, not", style);
        return false;
    }
    if !fits(s, a, o.b) { return false; }
    let oct = if o.hasOct { o.oct } else if low { 2 } else { 4 };
    let step = if o.hasStep { o.step } else if block { f32(s.meter) } else { 1 };
    song.clearRange(s, t, barStart(s, o.a), barStart(s, o.b + 1));
    let c = blank();
    let k = 0;
    for bar in o.a..=o.b {
        if !chordOf(s, bar, &c) { continue; }
        let x: f32 = 0;
        while x < f32(s.meter) - 0.001 {
            let len = step;
            if x + len > f32(s.meter) { len = f32(s.meter) - x; }
            let at = barStart(s, bar) + x;
            let p = -1;
            if same(style, "root") { p = theory.chordBass(&c, oct); }
            else if same(style, "fifths") { p = theory.chordBass(&c, oct) + if k % 2 == 1 { 7 } else { 0 }; }
            else if same(style, "arp") { p = theory.chordTone(&c, k % c.count, oct); }
            else if same(style, "arpdown") { p = theory.chordTone(&c, c.count - 1 - k % c.count, oct); }
            else if same(style, "arpupdown") {
                let period = if c.count > 1 { c.count * 2 - 2 } else { 1 };
                let i = k % period;
                if i >= c.count { i = period - i; }
                p = theory.chordTone(&c, i, oct);
            } else {
                for ti in 0..c.count {
                    if !song.addNote(s, t, at, len, theory.chordTone(&c, ti, oct), o.vel) { problem(a, "the song is full"); return false; }
                }
            }
            if p >= 0 && !song.addNote(s, t, at, len, p, o.vel) { problem(a, "the song is full"); return false; }
            x += step;
            k += 1;
        }
    }
    return true;
}

const VOICES: int = 4;

/// The chord's pitch classes for four voices: a 9th chord drops its root (the bass has it), a triad
/// doubles its root.
fn voicePcs(c: &Chord, pcs: []int) {
    for k in 0..VOICES {
        let i = if c.count >= 5 { k + 1 } else if k < c.count { k } else { 0 };
        pcs[k] = (c.root + c.tones[i]) % 12;
    }
}

/// The pitch with class `pc` nearest `p` (up on a tie).
fn nearest(p: int, pc: int): int {
    let up = ((pc - p % 12) % 12 + 12) % 12;
    return if up <= 6 { p + up } else { p + up - 12 };
}

/// Chord tones on a rhythm, voice-led: each voice moves to the nearest tone of the next chord,
/// trying every way of giving the four voices the four tones and keeping the one that moves least
/// (and drifts least from where the first bar sat: the sum of the four pitches counts as much as the moves).
fn voiced(s: &Song, t: int, o: &Opts, a: &Args): bool {
    if !fits(s, a, o.b) { return false; }
    let pat = if o.pat.len > 0 { o.pat } else { "x" };
    let oct = if o.hasOct { o.oct } else { 3 };
    let step = f32(s.meter) / f32(pat.len);
    song.clearRange(s, t, barStart(s, o.a), barStart(s, o.b + 1));
    let c = blank();
    let mem = Arena.create(4096);
    defer mem.destroy();
    let v = mem.alloc::<int>(VOICES);
    let pcs = mem.alloc::<int>(VOICES);
    let best = mem.alloc::<int>(VOICES);
    let started = false;
    let center = 0;
    for bar in o.a..=o.b {
        if !chordOf(s, bar, &c) { continue; }
        voicePcs(&c, pcs);
        if !started {
            // The first bar: closed position up from the root in `oct`.
            let base = (oct + 1) * 12 + c.root;
            for k in 0..VOICES {
                let ti = if c.count >= 5 { k + 1 } else if k < c.count { k } else { c.count };
                v[k] = if ti < c.count { base + c.tones[ti] } else { base + 12 };
                center += v[k];
            }
            started = true;
        } else {
            let cost = 1000000;
            for p0 in 0..VOICES {
                for p1 in 0..VOICES {
                    for p2 in 0..VOICES {
                        let p3 = 6 - p0 - p1 - p2;
                        if p0 == p1 || p0 == p2 || p1 == p2 || p3 < 0 || p3 >= VOICES || p3 == p0 || p3 == p1 || p3 == p2 { continue; }
                        let q0 = nearest(v[0], pcs[p0]);
                        let q1 = nearest(v[1], pcs[p1]);
                        let q2 = nearest(v[2], pcs[p2]);
                        let q3 = nearest(v[3], pcs[p3]);
                        let drift = q0 + q1 + q2 + q3 - center;
                        let c2 = iabs(q0 - v[0]) + iabs(q1 - v[1]) + iabs(q2 - v[2]) + iabs(q3 - v[3]) + iabs(drift);
                        if c2 < cost {
                            cost = c2;
                            best[0] = q0;
                            best[1] = q1;
                            best[2] = q2;
                            best[3] = q3;
                        }
                    }
                }
            }
            for k in 0..VOICES { v[k] = best[k]; }
        }
        let held = -1;
        for i in 0..pat.len {
            let at = barStart(s, bar) + f32(i) * step;
            if pat[i] == 120 {
                held = s.noteCount;
                for k in 0..VOICES {
                    if !song.addNote(s, t, at, step, v[k], o.vel) { problem(a, "the song is full"); return false; }
                }
            } else if pat[i] == 95 && held >= 0 {
                for k in 0..VOICES { s.notes[held + k].len += step; }
            } else {
                held = -1;
            }
        }
    }
    return true;
}

fn iabs(x: int): int {
    return if x < 0 { 0 - x } else { x };
}

/// A beat pattern digit's velocity: 1 is 15, 9 is 127.
fn digitVel(d: int): int {
    return 15 + (d - 1) * 14;
}

fn beat(s: &Song, t: int, drum: int, pat: string, o: &Opts, a: &Args): bool {
    if pat.len == 0 { problem(a, "beat wants a pattern like x...x...x...x..."); return false; }
    if !fits(s, a, o.b) { return false; }
    for i in 0..pat.len {
        let digit = pat[i] >= 49 && pat[i] <= 57;
        if pat[i] != 120 && pat[i] != 88 && pat[i] != 46 && !digit { problem2(a, "a beat pattern is x X . and velocity digits 1-9 only, not", pat); return false; }
    }
    let step = f32(s.meter) / f32(pat.len);
    let w = 0;
    let from = barStart(s, o.a);
    let to = barStart(s, o.b + 1);
    for i in 0..s.noteCount {
        let n = s.notes[i];
        if n.track != t || n.pitch != drum || n.beat < from - 0.0001 || n.beat >= to - 0.0001 {
            s.notes[w] = n;
            w += 1;
        }
    }
    s.noteCount = w;
    for bar in o.a..=o.b {
        for i in 0..pat.len {
            if pat[i] == 46 { continue; }
            let v = if pat[i] == 88 { 127 } else if pat[i] >= 49 && pat[i] <= 57 { digitVel(int(pat[i]) - 48) } else { o.vel };
            if !song.addNote(s, t, barStart(s, bar) + f32(i) * step, step, drum, v) { problem(a, "the song is full"); return false; }
        }
    }
    return true;
}
