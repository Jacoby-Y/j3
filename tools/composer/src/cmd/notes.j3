// cmd: notes, copy and humanize.

module composer.cmd;

fn notesCmd(s: &Song, t: int, a: &Args): bool {
    if a.at + 2 > a.w.len { problem(a, "notes wants TRACK POS STEP PITCH..."); return false; }
    let at: f32 = 0;
    let step: f32 = 0;
    if !parsePos(s, a.w[a.at], &at) { problem2(a, "bad position (BAR:BEAT or a beat)", a.w[a.at]); return false; }
    if !parseNum(a.w[a.at + 1], &step) || step <= 0 { problem2(a, "bad step (beats, like 1/2)", a.w[a.at + 1]); return false; }
    a.at += 2;
    let vel = 100;
    for i in a.at..a.w.len {
        let v = valueOf(a.w[i], "v");
        if v.len > 0 && (!parseI(v, &vel) || vel < 1 || vel > 127) { problem2(a, "v is 1..127", a.w[i]); return false; }
    }
    let last = -1;
    while a.at < a.w.len {
        let w = a.w[a.at];
        a.at += 1;
        if valueOf(w, "v").len > 0 { continue; }
        if same(w, "-") { last = -1; }
        else if same(w, "_") {
            if last < 0 { problem(a, "`_` holds the note before it, but there is none"); return false; }
            s.notes[last].len += step;
        } else {
            let p = theory.parsePitch(w);
            if p < 0 { problem2(a, "bad pitch", w); return false; }
            if !song.addNote(s, t, at, step, p, vel) { problem(a, "the song is full"); return false; }
            last = s.noteCount - 1;
        }
        at += step;
    }
    return fits(s, a, barOf(s, at - 0.001));
}

fn inBars(s: &Song, n: &Note, t: int, o: &Opts): bool {
    if t >= 0 && n.track != t { return false; }
    return n.beat >= barStart(s, o.a) - 0.0001 && n.beat < barStart(s, o.b + 1) - 0.0001;
}

fn copy(s: &Song, t: int, o: &Opts, a: &Args): bool {
    if o.to < 1 { problem(a, "copy wants to=BAR"); return false; }
    // Copy the source first: clearing the destination moves notes around.
    let mem = Arena.create(song.MAXNOTES * 32 + 1024);
    defer mem.destroy();
    let src = mem.alloc::<Note>(s.noteCount);
    let count = 0;
    for i in 0..s.noteCount {
        if inBars(s, &s.notes[i], t, o) { src[count] = s.notes[i]; count += 1; }
    }
    let chords = mem.alloc::<string>(o.b - o.a + 1);
    for b in o.a..=o.b { chords[b - o.a] = s.chords[b - 1]; }
    let width = o.b - o.a + 1;
    for r in 0..o.times {
        let first = o.to + r * width;
        let last = first + width - 1;
        if last > song.MAXBARS { problem(a, "that copy runs past bar 256"); return false; }
        let shift = barStart(s, first) - barStart(s, o.a);
        for tr in 0..s.trackCount {
            if t < 0 || t == tr { song.clearRange(s, tr, barStart(s, first), barStart(s, last + 1)); }
        }
        for i in 0..count {
            let n = src[i];
            if !song.addNote(s, n.track, n.beat + shift, n.len, n.pitch, n.vel) { problem(a, "the song is full"); return false; }
        }
        // Chords travel with a copy of every track.
        if t < 0 {
            for k in 0..width { s.chords[first - 1 + k] = chords[k]; }
        }
        growBars(s, last);
    }
    return true;
}

/// Velocities up or down by up to `v` (8), starts early or late by up to `time` beats (0.02), never
/// across the bar line before them. Seeded by the song, so the same script gives the same song.
/// Drums keep their timing unless `time=` is given. A note never starts before the previous note of
/// its pitch on its track ends (when it did not already), so humanize makes no overlaps.
fn humanize(s: &Song, t: int, o: &Opts) {
    let rng = Rng.new(s.noteCount * 31 + o.a * 7 + 17);
    let dv = if o.hasVel { o.vel } else { 8 };
    let mem = Arena.create(song.MAXNOTES * 16 + 4096);
    defer mem.destroy();
    let ord = song.order(s, &mem);
    // The end of the last note per pitch on this track, as it was and as it is now.
    let was = mem.alloc::<f32>(128);
    let now = mem.alloc::<f32>(128);
    let track = -1;
    for k in 0..ord.len {
        let n = &s.notes[ord[k]];
        if n.track != track {
            track = n.track;
            for p in 0..128 { was[p] = -1; now[p] = -1; }
        }
        let start = n.beat;
        let prevWas = was[n.pitch];
        was[n.pitch] = n.beat + n.len;
        if inBars(s, n, t, o) {
            n.vel += rng.intRange(0 - dv, dv + 1);
            if n.vel < 1 { n.vel = 1; }
            if n.vel > 127 { n.vel = 127; }
            let dt = if o.hasTime { o.time } else if s.tracks[n.track].synth == synth.DRUMS { 0 } else { 0.02 };
            if dt > 0 {
                let line = barStart(s, barOf(s, n.beat));
                let moved = n.beat + rng.floatRange(0 - dt, dt);
                if moved < line { moved = n.beat + (n.beat - moved); }
                if start >= prevWas - 0.001 && moved < now[n.pitch] { moved = now[n.pitch]; }
                n.beat = moved;
            }
        }
        now[n.pitch] = n.beat + n.len;
    }
}
