// cmd: info, dump and the drum grid (read-only views).

module composer.cmd;

fn barOf(s: &Song, beat: f32): int {
    return int(floor(beat / f32(s.meter) + 0.0001)) + 1;
}

fn info(s: &Song, out: &Text) {
    out.pushStr(s.name);
    out.pushStr(": tempo ");
    pushNum(out, s.tempo);
    out.pushStr(", ");
    out.pushInt(s.meter);
    out.pushStr("/4, key ");
    theory.pushKey(out, s.key, s.minor);
    out.pushStr(", ");
    out.pushInt(s.bars);
    out.pushStr(" bars, ");
    pushNum(out, f32(int(song.lengthBeats(s) * song.secondsPerBeat(s) * 10.0)) / 10.0);
    out.pushStr(" s");
    if s.swing != 0.5 { out.pushStr(", swing "); pushNum(out, s.swing); }
    if s.noise > 0 { out.pushStr(", noise "); pushNum(out, s.noise); }
    out.pushStr("\nchords:");
    for b in 0..s.bars {
        if b % 8 == 0 && b > 0 { out.pushStr(" |"); }
        out.push(32);
        out.pushStr(if s.chords[b].len > 0 { s.chords[b] } else { "-" });
    }
    out.push(10);
    if s.sectionCount > 0 {
        out.pushStr("sections:");
        for si in 0..s.sectionCount {
            let sec = &s.sections[si];
            out.push(32);
            out.pushStr(sec.name);
            out.push(32);
            out.pushInt(sec.a);
            out.push(45);
            out.pushInt(sec.b);
        }
        out.push(10);
    }
    for t in 0..s.trackCount {
        let tr = &s.tracks[t];
        let count = 0;
        let lo = 128;
        let hi = -1;
        for i in 0..s.noteCount {
            if s.notes[i].track == t {
                count += 1;
                if s.notes[i].pitch < lo { lo = s.notes[i].pitch; }
                if s.notes[i].pitch > hi { hi = s.notes[i].pitch; }
            }
        }
        out.pushStr("track ");
        out.pushStr(tr.name);
        out.pushStr(" synth=");
        out.pushStr(synth.name(tr.synth));
        out.pushStr(" vol=");
        pushNum(out, tr.vol);
        out.pushStr(" pan=");
        pushNum(out, tr.pan);
        out.pushStr(" tone=");
        pushNum(out, tr.tone);
        if tr.reverb > 0 { out.pushStr(" reverb="); pushNum(out, tr.reverb); }
        if tr.drive > 0 { out.pushStr(" drive="); pushNum(out, tr.drive); }
        if tr.mute { out.pushStr(" mute"); }
        if tr.solo { out.pushStr(" solo"); }
        out.pushStr(": ");
        out.pushInt(count);
        out.pushStr(" notes");
        if count > 0 && tr.synth != synth.DRUMS {
            out.push(32);
            theory.pushPitch(out, lo, false);
            out.pushStr("..");
            theory.pushPitch(out, hi, false);
        }
        out.push(10);
    }
    if s.trackCount == 0 { out.pushStr("no tracks yet: `track Bass synth=bass`\n"); }
}

fn dump(s: &Song, t: int, o: &Opts, out: &Text) {
    let mem = Arena.create(song.MAXNOTES * 16 + 1024);
    defer mem.destroy();
    let ord = song.order(s, &mem);
    let tr = &s.tracks[t];
    let drums = tr.synth == synth.DRUMS;
    out.pushStr(tr.name);
    out.pushStr(" (");
    out.pushStr(synth.name(tr.synth));
    out.pushStr(")  position:pitch/length, v when not 100\n");
    for bar in o.a..=o.b {
        let from = barStart(s, bar);
        let to = barStart(s, bar + 1);
        out.pushStr("bar ");
        out.pushInt(bar);
        let sym = song.chordAt(s, bar - 1);
        if sym.len > 0 {
            out.pushStr(" [");
            out.pushStr(sym);
            out.pushStr("]");
        }
        out.push(58);
        if drums && drumGrid(s, t, from, to, out) { continue; }
        let any = false;
        for k in 0..ord.len {
            let n = &s.notes[ord[k]];
            if n.track != t || n.beat < from - 0.0001 || n.beat >= to - 0.0001 { continue; }
            any = true;
            out.push(32);
            pushNum(out, n.beat - from + 1.0);
            out.push(58);
            theory.pushPitch(out, n.pitch, drums);
            out.push(47);
            pushNum(out, n.len);
            if n.vel != 100 {
                out.pushStr("v");
                out.pushInt(n.vel);
            }
        }
        if !any { out.pushStr(" (rest)"); }
        out.push(10);
    }
}

const DRUMS: [7]int = [36, 38, 39, 42, 46, 45, 49];

/// One `x...` line per drum when every hit in the bar is on a 16th. False (prints nothing) otherwise.
fn drumGrid(s: &Song, t: int, from: f32, to: f32, out: &Text): bool {
    let steps = s.meter * 4;
    for i in 0..s.noteCount {
        let n = &s.notes[i];
        if n.track != t || n.beat < from - 0.0001 || n.beat >= to - 0.0001 { continue; }
        // Within 0.15 of a 16th still counts, so humanized hits keep their grid.
        let q = (n.beat - from) * 4.0;
        let off = q - floor(q + 0.5);
        if off > 0.15 || off < -0.15 || theory.drumName(n.pitch).len == 0 { return false; }
    }
    let any = false;
    for d in DRUMS {
        let line = false;
        for i in 0..s.noteCount {
            let m = &s.notes[i];
            if m.track == t && m.pitch == d && m.beat >= from - 0.0001 && m.beat < to - 0.0001 { line = true; }
        }
        if !line { continue; }
        any = true;
        out.pushStr("\n  ");
        out.pushStr(theory.drumName(d));
        for k in theory.drumName(d).len..6 { out.push(32); }
        for st in 0..steps {
            let ch: u8 = 46;
            for i in 0..s.noteCount {
                let h = &s.notes[i];
                if h.track == t && h.pitch == d && int(floor((h.beat - from) * 4.0 + 0.5)) == st && h.beat >= from - 0.0001 && h.beat < to - 0.0001 {
                    // x around the default 100 (and humanized near it), X loud, a digit otherwise.
                    let dg = (h.vel - 15 + 7) / 14 + 1;
                    if dg < 1 { dg = 1; }
                    ch = if h.vel >= 120 { 88 } else if h.vel >= 92 && h.vel <= 108 { 120 } else { u8(48 + dg) };
                }
            }
            out.push(ch);
        }
    }
    if !any { out.pushStr(" (rest)"); }
    out.push(10);
    return true;
}
