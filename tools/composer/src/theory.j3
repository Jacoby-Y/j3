// Music theory: note names, keys, scales, and chord symbols. Pitches are MIDI numbers (C4 = 60).

module composer.theory;

use j3.text.{ Text, same };
use composer.util.{ cut, parseI };

const NAMES: [12]string = ["C", "C#", "D", "D#", "E", "F", "F#", "G", "G#", "A", "A#", "B"];
const MAJOR: [7]int = [0, 2, 4, 5, 7, 9, 11];
const MINOR: [7]int = [0, 2, 3, 5, 7, 8, 10];

/// General MIDI drum notes the `drums` synth plays.
pub const KICK: int = 36;
pub const SNARE: int = 38;
pub const CLAP: int = 39;
pub const HAT: int = 42;
pub const TOM: int = 45;
pub const OHAT: int = 46;
pub const CRASH: int = 49;

/// A chord symbol, parsed. `tones` are semitones above `root` (0 first); `bass` is a pitch class.
pub struct Chord {
    root: int;
    bass: int;
    count: int;
    tones: [6]int;
}

pub fn pcName(pc: int): string {
    return NAMES[((pc % 12) + 12) % 12];
}

/// "A2", "F#4". Drum pitches print as their names when `drums`.
pub fn pushPitch(out: &Text, p: int, drums: bool) {
    if drums {
        let d = drumName(p);
        if d.len > 0 { out.pushStr(d); return; }
    }
    out.pushStr(pcName(p));
    out.pushInt(p / 12 - 1);
}

pub fn drumName(p: int): string {
    if p == KICK { return "kick"; }
    if p == SNARE { return "snare"; }
    if p == CLAP { return "clap"; }
    if p == HAT { return "hat"; }
    if p == TOM { return "tom"; }
    if p == OHAT { return "ohat"; }
    if p == CRASH { return "crash"; }
    return "";
}

/// Pitch class of a leading note letter (`C`, `F#`, `Bb`) and how many bytes it took, or -1.
fn letter(s: string, used: &int): int {
    if s.len == 0 { return -1; }
    let c = int(s[0]);
    if c >= 97 && c <= 103 { c -= 32; }
    let pc = -1;
    if c == 67 { pc = 0; }
    else if c == 68 { pc = 2; }
    else if c == 69 { pc = 4; }
    else if c == 70 { pc = 5; }
    else if c == 71 { pc = 7; }
    else if c == 65 { pc = 9; }
    else if c == 66 { pc = 11; }
    if pc < 0 { return -1; }
    *used = 1;
    if s.len > 1 && s[1] == 35 { pc += 1; *used = 2; }
    else if s.len > 1 && s[1] == 98 { pc -= 1; *used = 2; }
    return (pc + 12) % 12;
}

/// "A2", "F#4", "Bb3", "60", or a drum name ("kick", "snare", "hat", ...). -1 when it is none.
pub fn parsePitch(s: string): int {
    if same(s, "kick") { return KICK; }
    if same(s, "snare") { return SNARE; }
    if same(s, "clap") { return CLAP; }
    if same(s, "hat") { return HAT; }
    if same(s, "tom") { return TOM; }
    if same(s, "ohat") { return OHAT; }
    if same(s, "crash") { return CRASH; }
    let n = 0;
    if parseI(s, &n) {
        return if n >= 0 && n < 128 { n } else { -1 };
    }
    let used = 0;
    let pc = letter(s, &used);
    if pc < 0 { return -1; }
    let oct = 0;
    if !parseI(cut(s, used, s.len), &oct) { return -1; }
    // Bb3 is A#3, but Cb4 is B3: the octave belongs to the letter.
    let p = (oct + 1) * 12 + pc;
    if (s[0] == 67 || s[0] == 99) && used == 2 && s[1] == 98 { p -= 12; }
    if (s[0] == 66 || s[0] == 98) && used == 2 && s[1] == 35 { p += 12; }
    return if p >= 0 && p < 128 { p } else { -1 };
}

/// "Am", "C", "F#m", "Ebm" (also "A minor", written "Amin"). False when it is not a key.
pub fn parseKey(s: string, root: &int, minor: &bool): bool {
    let used = 0;
    let pc = letter(s, &used);
    if pc < 0 { return false; }
    let rest = cut(s, used, s.len);
    if rest.len == 0 || same(rest, "maj") || same(rest, "major") { *root = pc; *minor = false; return true; }
    if same(rest, "m") || same(rest, "min") || same(rest, "minor") { *root = pc; *minor = true; return true; }
    return false;
}

pub fn pushKey(out: &Text, root: int, minor: bool) {
    out.pushStr(pcName(root));
    if minor { out.push(109); }
}

/// Is pitch class `pc` in the key?
pub fn inKey(pc: int, root: int, minor: bool): bool {
    let rel = ((pc - root) % 12 + 12) % 12;
    for i in 0..7 {
        let step = if minor { MINOR[i] } else { MAJOR[i] };
        if step == rel { return true; }
    }
    return false;
}

/// Scale degree `deg` (0 = tonic, may be negative or past 6) as a pitch near octave `oct`.
pub fn degree(root: int, minor: bool, deg: int, oct: int): int {
    let o = deg / 7;
    let d = deg % 7;
    if d < 0 { d += 7; o -= 1; }
    let step = if minor { MINOR[d] } else { MAJOR[d] };
    return (oct + 1 + o) * 12 + root + step;
}

/// Parse a chord symbol: C, Am, F#m7, Gmaj7, Bdim, Caug, Dsus4, Esus2, A5, C6, Am6, G9, Cadd9,
/// C7, Bm7b5, G/B. False when it is not one.
pub fn parseChord(s: string, c: &Chord): bool {
    let used = 0;
    let pc = letter(s, &used);
    if pc < 0 { return false; }
    let rest = cut(s, used, s.len);
    let bass = pc;
    for i in 0..rest.len {
        if rest[i] == 47 {
            let bu = 0;
            bass = letter(cut(rest, i + 1, rest.len), &bu);
            if bass < 0 || bu != rest.len - i - 1 { return false; }
            rest = cut(rest, 0, i);
            break;
        }
    }
    c.root = pc;
    c.bass = bass;
    c.count = 3;
    c.tones = [0, 4, 7, 0, 0, 0];
    if rest.len == 0 { return true; }
    if same(rest, "m") || same(rest, "min") { c.tones[1] = 3; return true; }
    if same(rest, "dim") { c.tones[1] = 3; c.tones[2] = 6; return true; }
    if same(rest, "aug") || same(rest, "+") { c.tones[2] = 8; return true; }
    if same(rest, "sus2") { c.tones[1] = 2; return true; }
    if same(rest, "sus4") || same(rest, "sus") { c.tones[1] = 5; return true; }
    if same(rest, "5") { c.count = 2; c.tones[1] = 7; return true; }
    c.count = 4;
    if same(rest, "7") { c.tones[3] = 10; return true; }
    if same(rest, "maj7") || same(rest, "M7") { c.tones[3] = 11; return true; }
    if same(rest, "m7") || same(rest, "min7") { c.tones[1] = 3; c.tones[3] = 10; return true; }
    if same(rest, "m7b5") { c.tones[1] = 3; c.tones[2] = 6; c.tones[3] = 10; return true; }
    if same(rest, "dim7") { c.tones[1] = 3; c.tones[2] = 6; c.tones[3] = 9; return true; }
    if same(rest, "6") { c.tones[3] = 9; return true; }
    if same(rest, "m6") { c.tones[1] = 3; c.tones[3] = 9; return true; }
    if same(rest, "add9") { c.tones[3] = 14; return true; }
    if same(rest, "9") { c.count = 5; c.tones[3] = 10; c.tones[4] = 14; return true; }
    if same(rest, "maj9") { c.count = 5; c.tones[3] = 11; c.tones[4] = 14; return true; }
    if same(rest, "m9") { c.count = 5; c.tones[1] = 3; c.tones[3] = 10; c.tones[4] = 14; return true; }
    return false;
}

/// Does the chord hold pitch class `pc`?
pub fn chordHas(c: &Chord, pc: int): bool {
    let p = ((pc % 12) + 12) % 12;
    if p == c.bass { return true; }
    for i in 0..c.count {
        if (c.root + c.tones[i]) % 12 == p { return true; }
    }
    return false;
}

/// Chord tone `i` (wrapping up an octave past the last) with the root in octave `oct`.
pub fn chordTone(c: &Chord, i: int, oct: int): int {
    let o = i / c.count;
    let k = i % c.count;
    if k < 0 { k += c.count; o -= 1; }
    return (oct + 1 + o) * 12 + c.root + c.tones[k];
}

/// The bass note of the chord in octave `oct`.
pub fn chordBass(c: &Chord, oct: int): int {
    return (oct + 1) * 12 + c.bass;
}
