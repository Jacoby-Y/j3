// The song: tempo, meter, key, a chord per bar, tracks, and notes. Edits call `snapshot` first
// (one command, or one gesture in the window) so `undo` can put the song back.

module composer.song;

use j3.memory.Arena;
use j3.text.same;
use composer.util.own;

pub const MAXTRACKS: int = 16;
pub const MAXNOTES: int = 16384;
pub const MAXBARS: int = 256;
pub const MAXSECTIONS: int = 32;
const UNDOS: int = 32;

/// A named run of bars (`section Chorus bars=9-16`), 1-based and inclusive.
pub struct Section {
    name: string;
    a: int;
    b: int;
}

/// `beat` counts from the start of the song (bar 1 beat 1 is 0); `len` is in beats.
pub struct Note {
    track: int;
    beat: f32;
    len: f32;
    pitch: int;
    vel: int;
}

/// `synth` indexes `synth.NAMES`. `tone` is filter brightness 0..1, `vol` 0..1.5, `pan` -1..1,
/// `reverb` the send to the song's reverb 0..1, `drive` saturation 0..1.
pub struct Track {
    name: string;
    synth: int;
    vol: f32;
    pan: f32;
    tone: f32;
    reverb: f32;
    drive: f32;
    mute: bool;
    solo: bool;
}

struct Snap {
    tempo: f32;
    swing: f32;
    noise: f32;
    meter: int;
    key: int;
    minor: bool;
    bars: int;
    chords: []string;
    sections: []Section;
    sectionCount: int;
    tracks: []Track;
    trackCount: int;
    notes: []Note;
    noteCount: int;
}

pub struct Song {
    mem: &Arena;
    name: string;
    tempo: f32;
    /// Where the off-beat 8th lands, 0.5 (straight) .. 0.75; applied when rendering.
    swing: f32;
    /// Tape hiss and vinyl crackle under the mix, 0..1.
    noise: f32;
    /// Beats per bar.
    meter: int;
    key: int;
    minor: bool;
    bars: int;
    /// Chord symbol per bar (index 0 is bar 1), "" for none.
    chords: []string;
    sections: []Section;
    sectionCount: int;
    tracks: []Track;
    trackCount: int;
    notes: []Note;
    noteCount: int;
    dirty: bool;
    snaps: []Snap;
    undoAt: int;
    undoCount: int;
}

fn blankSnap(mem: &Arena): Snap {
    return Snap {
        tempo: 120, swing: 0.5, noise: 0, meter: 4, key: 0, minor: false, bars: 8,
        chords: mem.alloc::<string>(MAXBARS),
        sections: mem.alloc::<Section>(MAXSECTIONS), sectionCount: 0,
        tracks: mem.alloc::<Track>(MAXTRACKS), trackCount: 0,
        notes: mem.alloc::<Note>(MAXNOTES), noteCount: 0,
    };
}

pub fn create(mem: &Arena): Song {
    let s = Song {
        mem: mem, name: "song", tempo: 120, swing: 0.5, noise: 0, meter: 4, key: 9, minor: true, bars: 8,
        chords: mem.alloc::<string>(MAXBARS),
        sections: mem.alloc::<Section>(MAXSECTIONS), sectionCount: 0,
        tracks: mem.alloc::<Track>(MAXTRACKS), trackCount: 0,
        notes: mem.alloc::<Note>(MAXNOTES), noteCount: 0,
        dirty: false,
        snaps: mem.alloc::<Snap>(UNDOS), undoAt: 0, undoCount: 0,
    };
    for i in 0..MAXBARS { s.chords[i] = ""; }
    for i in 0..UNDOS { s.snaps[i] = blankSnap(mem); }
    return s;
}

/// Empty the song (keeps undo history).
pub fn clearAll(s: &Song) {
    s.tempo = 120;
    s.swing = 0.5;
    s.noise = 0;
    s.meter = 4;
    s.key = 9;
    s.minor = true;
    s.bars = 8;
    for i in 0..MAXBARS { s.chords[i] = ""; }
    s.sectionCount = 0;
    s.trackCount = 0;
    s.noteCount = 0;
}

/// Remember the song as it is now, for `undo`. Call before each edit.
pub fn snapshot(s: &Song) {
    let n = &s.snaps[s.undoAt];
    n.tempo = s.tempo;
    n.swing = s.swing;
    n.noise = s.noise;
    n.meter = s.meter;
    n.key = s.key;
    n.minor = s.minor;
    n.bars = s.bars;
    for i in 0..MAXBARS { n.chords[i] = s.chords[i]; }
    for i in 0..s.sectionCount { n.sections[i] = s.sections[i]; }
    n.sectionCount = s.sectionCount;
    for i in 0..s.trackCount { n.tracks[i] = s.tracks[i]; }
    n.trackCount = s.trackCount;
    for i in 0..s.noteCount { n.notes[i] = s.notes[i]; }
    n.noteCount = s.noteCount;
    s.undoAt = (s.undoAt + 1) % UNDOS;
    if s.undoCount < UNDOS { s.undoCount += 1; }
}

/// Step back one snapshot. False when there is none.
pub fn undo(s: &Song): bool {
    if s.undoCount == 0 { return false; }
    s.undoAt = (s.undoAt + UNDOS - 1) % UNDOS;
    s.undoCount -= 1;
    let n = &s.snaps[s.undoAt];
    s.tempo = n.tempo;
    s.swing = n.swing;
    s.noise = n.noise;
    s.meter = n.meter;
    s.key = n.key;
    s.minor = n.minor;
    s.bars = n.bars;
    for i in 0..MAXBARS { s.chords[i] = n.chords[i]; }
    for i in 0..n.sectionCount { s.sections[i] = n.sections[i]; }
    s.sectionCount = n.sectionCount;
    for i in 0..n.trackCount { s.tracks[i] = n.tracks[i]; }
    s.trackCount = n.trackCount;
    for i in 0..n.noteCount { s.notes[i] = n.notes[i]; }
    s.noteCount = n.noteCount;
    s.dirty = true;
    return true;
}

pub fn findSection(s: &Song, name: string): int {
    for i in 0..s.sectionCount {
        if same(s.sections[i].name, name) { return i; }
    }
    return -1;
}

/// Set (or move) section `name` to bars `a`..`b`. False when there are `MAXSECTIONS`.
pub fn setSection(s: &Song, name: string, a: int, b: int): bool {
    let i = findSection(s, name);
    if i < 0 {
        if s.sectionCount >= MAXSECTIONS { return false; }
        i = s.sectionCount;
        s.sectionCount += 1;
        s.sections[i].name = own(s.mem, name);
    }
    s.sections[i].a = a;
    s.sections[i].b = b;
    s.dirty = true;
    return true;
}

pub fn delSection(s: &Song, i: int) {
    for k in i..s.sectionCount - 1 { s.sections[k] = s.sections[k + 1]; }
    s.sectionCount -= 1;
    s.dirty = true;
}

pub fn findTrack(s: &Song, name: string): int {
    for i in 0..s.trackCount {
        if same(s.tracks[i].name, name) { return i; }
    }
    return -1;
}

/// A new track, or -1 when there are `MAXTRACKS`.
pub fn addTrack(s: &Song, name: string, synthId: int): int {
    if s.trackCount >= MAXTRACKS { return -1; }
    let i = s.trackCount;
    s.tracks[i] = Track { name: own(s.mem, name), synth: synthId, vol: 0.8, pan: 0, tone: 0.6, reverb: 0, drive: 0, mute: false, solo: false };
    s.trackCount += 1;
    s.dirty = true;
    return i;
}

/// Remove track `t` and its notes.
pub fn delTrack(s: &Song, t: int) {
    let w = 0;
    for i in 0..s.noteCount {
        let n = s.notes[i];
        if n.track != t {
            if n.track > t { n.track -= 1; }
            s.notes[w] = n;
            w += 1;
        }
    }
    s.noteCount = w;
    for i in t..s.trackCount - 1 { s.tracks[i] = s.tracks[i + 1]; }
    s.trackCount -= 1;
    s.dirty = true;
}

/// Add a note. False when the song is full.
pub fn addNote(s: &Song, track: int, beat: f32, len: f32, pitch: int, vel: int): bool {
    if s.noteCount >= MAXNOTES { return false; }
    s.notes[s.noteCount] = Note { track: track, beat: beat, len: len, pitch: pitch, vel: vel };
    s.noteCount += 1;
    s.dirty = true;
    return true;
}

pub fn delNote(s: &Song, i: int) {
    s.noteCount -= 1;
    s.notes[i] = s.notes[s.noteCount];
    s.dirty = true;
}

/// Delete the notes of track `t` starting in beats [a, b).
pub fn clearRange(s: &Song, t: int, a: f32, b: f32) {
    let w = 0;
    for i in 0..s.noteCount {
        let n = s.notes[i];
        if n.track != t || n.beat < a - 0.0001 || n.beat >= b - 0.0001 {
            s.notes[w] = n;
            w += 1;
        }
    }
    if w != s.noteCount { s.dirty = true; }
    s.noteCount = w;
}

/// Is any track soloed? Then only soloed tracks play.
pub fn audible(s: &Song, t: int): bool {
    let tr = &s.tracks[t];
    if tr.mute { return false; }
    for i in 0..s.trackCount {
        if s.tracks[i].solo { return tr.solo; }
    }
    return true;
}

pub fn secondsPerBeat(s: &Song): f32 {
    return 60.0 / s.tempo;
}

/// Beats in the song (`bars` bars), or up to the last note end when notes run past it.
pub fn lengthBeats(s: &Song): f32 {
    let end = f32(s.bars * s.meter);
    for i in 0..s.noteCount {
        let e = s.notes[i].beat + s.notes[i].len;
        if e > end { end = e; }
    }
    return end;
}

/// The chord sounding in `bar` (0-based): the last one set at or before it.
pub fn chordAt(s: &Song, bar: int): string {
    let b = bar;
    if b >= MAXBARS { b = MAXBARS - 1; }
    while b >= 0 {
        if s.chords[b].len > 0 { return s.chords[b]; }
        b -= 1;
    }
    return "";
}

fn before(s: &Song, a: int, b: int): bool {
    let x = &s.notes[a];
    let y = &s.notes[b];
    if x.track != y.track { return x.track < y.track; }
    if x.beat != y.beat { return x.beat < y.beat; }
    return x.pitch < y.pitch;
}

/// Note indices sorted by track, then beat, then pitch (a merge sort, so equal notes keep their order).
pub fn order(s: &Song, mem: &Arena): []int {
    let n = s.noteCount;
    let a = mem.alloc::<int>(n);
    let b = mem.alloc::<int>(n);
    for i in 0..n { a[i] = i; }
    let width = 1;
    while width < n {
        let lo = 0;
        while lo < n {
            let mid = lo + width;
            if mid > n { mid = n; }
            let hi = lo + width * 2;
            if hi > n { hi = n; }
            let i = lo;
            let j = mid;
            let k = lo;
            while k < hi {
                if i < mid && (j >= hi || !before(s, a[j], a[i])) { b[k] = a[i]; i += 1; }
                else { b[k] = a[j]; j += 1; }
                k += 1;
            }
            lo = hi;
        }
        let t = a;
        a = b;
        b = t;
        width *= 2;
    }
    return a;
}
