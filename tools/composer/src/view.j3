// Drawing the song: chord lane, ruler, arrangement, piano roll, velocity lane. The window and
// `--render` both draw through here, so an agent's PNG is what the person sees.

module composer.view;

use j3.game;
use j3.game.{ Color, Font, rgb, rgba };
use j3.math.{ Vec2, floor };
use j3.memory.scratch;
use j3.text.Text;
use composer.song;
use composer.song.Song;
use composer.synth;
use composer.theory;
use composer.theory.Chord;
use composer.util.pushNum;

/// What part of the song is on screen: `left` is the beat at the left edge, `top` the pitch of the top
/// roll row.
pub struct Cam {
    left: f32;
    ppb: f32;
    top: f32;
    rowH: f32;
}

/// A screen rectangle.
pub struct Rect {
    x: f32;
    y: f32;
    w: f32;
    h: f32;
}

pub fn rect(x: f32, y: f32, w: f32, h: f32): Rect {
    return Rect { x: x, y: y, w: w, h: h };
}

pub fn inside(r: Rect, p: Vec2): bool {
    return p.x >= r.x && p.x < r.x + r.w && p.y >= r.y && p.y < r.y + r.h;
}

pub fn bg(): Color {
    return rgb(24, 26, 32);
}

const HUES: [8]Color = [
    Color { r: 92, g: 156, b: 236, a: 255 },
    Color { r: 236, g: 128, b: 92, a: 255 },
    Color { r: 120, g: 204, b: 120, a: 255 },
    Color { r: 212, g: 116, b: 204, a: 255 },
    Color { r: 232, g: 196, b: 84, a: 255 },
    Color { r: 92, g: 204, b: 204, a: 255 },
    Color { r: 236, g: 104, b: 128, a: 255 },
    Color { r: 168, g: 148, b: 236, a: 255 },
];

pub fn hue(t: int): Color {
    return HUES[t % 8];
}

pub fn fill(x: f32, y: f32, w: f32, h: f32, c: Color) {
    if w <= 0 || h <= 0 { return; }
    game.setColor(c);
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: w, y: h });
}

/// `fill`, cut to `r`.
fn fillIn(r: Rect, x: f32, y: f32, w: f32, h: f32, c: Color) {
    let x0 = if x < r.x { r.x } else { x };
    let y0 = if y < r.y { r.y } else { y };
    let x1 = if x + w > r.x + r.w { r.x + r.w } else { x + w };
    let y1 = if y + h > r.y + r.h { r.y + r.h } else { y + h };
    fill(x0, y0, x1 - x0, y1 - y0, c);
}

pub fn text(font: Font, x: f32, y: f32, s: string, c: Color) {
    if font.raw == 0 || s.len == 0 { return; }
    game.setColor(c);
    game.drawText(font, Vec2 { x: x, y: y }, s);
}

pub fn beatX(cam: &Cam, r: Rect, beat: f32): f32 {
    return r.x + (beat - cam.left) * cam.ppb;
}

pub fn xBeat(cam: &Cam, r: Rect, x: f32): f32 {
    return cam.left + (x - r.x) / cam.ppb;
}

pub fn pitchY(cam: &Cam, r: Rect, p: int): f32 {
    return r.y + (cam.top - f32(p)) * cam.rowH;
}

pub fn yPitch(cam: &Cam, r: Rect, y: f32): int {
    return int(floor(cam.top - (y - r.y) / cam.rowH + 1.0));
}

fn blank(): Chord {
    return Chord { root: 0, bass: 0, count: 0, tones: [0, 0, 0, 0, 0, 0] };
}

const MAJOR_RN: [12]string = ["I", "bII", "II", "bIII", "III", "IV", "#IV", "V", "bVI", "VI", "bVII", "VII"];
const MINOR_RN: [12]string = ["I", "bII", "II", "III", "#III", "IV", "#IV", "V", "VI", "#VI", "VII", "#VII"];

/// The chord's Roman numeral in the song's key: i, iv, V7, VI, ii°...
pub fn pushNumeral(out: &Text, s: &Song, c: &Chord) {
    let rel = ((c.root - s.key) % 12 + 12) % 12;
    let rn = if s.minor { MINOR_RN[rel] } else { MAJOR_RN[rel] };
    let lower = c.count >= 3 && c.tones[1] == 3;
    for i in 0..rn.len {
        let b = rn[i];
        out.push(if lower && b >= 65 && b <= 90 { b + 32 } else { b });
    }
    if c.count >= 3 && c.tones[1] == 3 && c.tones[2] == 6 { out.pushStr("o"); }
    if c.count >= 3 && c.tones[2] == 8 { out.pushStr("+"); }
    if c.count >= 4 && c.tones[3] == 10 { out.pushStr("7"); }
    if c.count >= 4 && c.tones[3] == 11 { out.pushStr("maj7"); }
}

/// One cell per bar: the chord symbol, its numeral, and (when `tall`) its notes.
pub fn chordLane(s: &Song, cam: &Cam, r: Rect, font: Font, tall: bool, selA: int, selB: int) {
    fill(r.x, r.y, r.w, r.h, rgb(30, 33, 41));
    let bw = cam.ppb * f32(s.meter);
    let first = int(floor(cam.left / f32(s.meter)));
    let c = blank();
    let bar = if first < 0 { 0 } else { first };
    while bar < song.MAXBARS {
        let x = beatX(cam, r, f32(bar * s.meter));
        if x > r.x + r.w { break; }
        let sym = s.chords[bar];
        let on = sym.len > 0 && theory.parseChord(sym, &c);
        let shade = if bar >= s.bars { rgb(26, 28, 34) } else if bar % 2 == 0 { rgb(40, 44, 54) } else { rgb(36, 40, 49) };
        if bar + 1 >= selA && bar + 1 <= selB { shade = rgb(52, 64, 92); }
        fillIn(r, x + 1, r.y + 1, bw - 2, r.h - 2, shade);
        if on && x + 4 >= r.x {
            text(font, x + 6, r.y + 4, sym, rgb(240, 236, 214));
            let t = Text.new(scratch(0));
            pushNumeral(&t, s, &c);
            if tall {
                text(font, x + 6, r.y + 24, t.str(), rgb(150, 170, 210));
                let notes = Text.new(scratch(0));
                for i in 0..c.count {
                    if i > 0 { notes.push(32); }
                    notes.pushStr(theory.pcName(c.root + c.tones[i]));
                }
                text(font, x + 6, r.y + 44, notes.str(), rgb(130, 140, 160));
            } else if bw > 90 {
                text(font, x + bw - game.textSize(font, t.str()).x - 6, r.y + 4, t.str(), rgb(130, 150, 190));
            }
        } else if sym.len == 0 && bar < s.bars && x + 4 >= r.x && bw > 30 {
            text(font, x + 6, r.y + 4, "-", rgb(90, 96, 110));
        }
        bar += 1;
    }
}

/// Bar numbers, beat ticks, and the loop range.
pub fn ruler(s: &Song, cam: &Cam, r: Rect, font: Font, selA: int, selB: int) {
    fill(r.x, r.y, r.w, r.h, rgb(30, 33, 41));
    if selA > 0 {
        let x0 = beatX(cam, r, f32((selA - 1) * s.meter));
        let x1 = beatX(cam, r, f32(selB * s.meter));
        fillIn(r, x0, r.y, x1 - x0, r.h, rgb(60, 80, 130));
    }
    let b = int(floor(cam.left));
    if b < 0 { b = 0; }
    let step = if cam.ppb < 8 { s.meter } else { 1 };
    while true {
        let x = beatX(cam, r, f32(b));
        if x > r.x + r.w { break; }
        let isBar = b % s.meter == 0;
        if isBar || b % step == 0 {
            fillIn(r, x, r.y + if isBar { 0 } else { r.h * 0.6 }, 1, r.h, rgb(90, 96, 112));
        }
        if isBar && (cam.ppb * f32(s.meter) > 24 || (b / s.meter) % 4 == 0) {
            let t = Text.new(scratch(0));
            t.pushInt(b / s.meter + 1);
            text(font, x + 4, r.y + 2, t.str(), rgb(170, 176, 190));
        }
        b += 1;
    }
}

/// Bar and beat lines over `r`.
fn grid(s: &Song, cam: &Cam, r: Rect, snap: f32) {
    let b = int(floor(cam.left / snap));
    if b < 0 { b = 0; }
    while true {
        let beat = f32(b) * snap;
        let x = beatX(cam, r, beat);
        if x > r.x + r.w { break; }
        let isBar = beat - floor(beat / f32(s.meter)) * f32(s.meter) < 0.001;
        let isBeat = beat - floor(beat) < 0.001;
        let c = if isBar { rgb(78, 84, 100) } else if isBeat { rgb(50, 54, 66) } else { rgb(38, 41, 50) };
        if isBar || isBeat || snap * cam.ppb >= 6 { fillIn(r, x, r.y, 1, r.h, c); }
        b += 1;
    }
    // The end of the song.
    let e = beatX(cam, r, f32(s.bars * s.meter));
    fillIn(r, e, r.y, 2, r.h, rgb(140, 70, 70));
}

/// Track rows, each with its notes squeezed to the row. `sel` is the selected track.
pub fn arrange(s: &Song, cam: &Cam, r: Rect, rowH: f32, font: Font, sel: int) {
    fill(r.x, r.y, r.w, r.h, bg());
    grid(s, cam, r, f32(s.meter));
    for t in 0..s.trackCount {
        let y = r.y + f32(t) * rowH;
        if y > r.y + r.h { break; }
        let tr = &s.tracks[t];
        let audible = song.audible(s, t);
        if t == sel { fillIn(r, r.x, y, r.w, rowH, rgba(255, 255, 255, 14)); }
        fillIn(r, r.x, y + rowH - 1, r.w, 1, rgb(44, 48, 58));
        let lo = 127;
        let hi = 0;
        for i in 0..s.noteCount {
            let m = &s.notes[i];
            if m.track != t { continue; }
            if m.pitch < lo { lo = m.pitch; }
            if m.pitch > hi { hi = m.pitch; }
        }
        let span = f32(hi - lo + 1);
        if span < 12 { span = 12; }
        let c = hue(t);
        if !audible { c = rgb(80, 84, 92); }
        for i in 0..s.noteCount {
            let n = &s.notes[i];
            if n.track != t { continue; }
            let x = beatX(cam, r, n.beat);
            let w = n.len * cam.ppb;
            if x > r.x + r.w || x + w < r.x { continue; }
            let ny = y + 3 + (rowH - 8) * (1.0 - f32(n.pitch - lo + 1) / span);
            fillIn(r, x, ny, if w > 2 { w - 1 } else { 1 }, 3, c);
        }
        text(font, r.x + 6, y + 4, tr.name, if audible { rgb(220, 224, 232) } else { rgb(110, 114, 124) });
    }
}

fn isBlackKey(p: int): bool {
    let pc = p % 12;
    return pc == 1 || pc == 3 || pc == 6 || pc == 8 || pc == 10;
}

/// The piano roll for track `t`: rows tinted for the key and the chord of each bar, notes as boxes.
/// `keysW` pixels on the left are the keyboard. `chosen` marks a note (-1 none).
pub fn roll(s: &Song, t: int, cam: &Cam, r: Rect, keysW: f32, font: Font, snap: f32, chosen: int) {
    let area = rect(r.x + keysW, r.y, r.w - keysW, r.h);
    fill(r.x, r.y, r.w, r.h, bg());
    if t < 0 || t >= s.trackCount {
        text(font, area.x + 20, area.y + 20, "No track yet: type `track Lead synth=lead` below, or press + Track.", rgb(160, 166, 180));
        return;
    }
    let drums = s.tracks[t].synth == synth.DRUMS;
    let topP = int(floor(cam.top));
    let rows = int(r.h / cam.rowH) + 2;
    let c = blank();
    // Rows: black keys darker, the key's notes lighter, and each bar's chord tones tinted.
    for k in 0..rows {
        let p = topP - k;
        if p < 0 || p > 127 { continue; }
        let y = pitchY(cam, area, p);
        let shade = if isBlackKey(p) { rgb(26, 28, 34) } else { rgb(31, 34, 42) };
        if !drums && !theory.inKey(p % 12, s.key, s.minor) { shade = rgb(22, 23, 28); }
        fillIn(area, area.x, y, area.w, cam.rowH, shade);
        if !drums {
            let bar = int(floor(cam.left / f32(s.meter)));
            if bar < 0 { bar = 0; }
            while bar < song.MAXBARS {
                let x = beatX(cam, area, f32(bar * s.meter));
                if x > area.x + area.w { break; }
                let sym = song.chordAt(s, bar);
                if sym.len > 0 && theory.parseChord(sym, &c) && theory.chordHas(&c, p % 12) {
                    let root = (p % 12) == c.root;
                    fillIn(area, x, y, cam.ppb * f32(s.meter), cam.rowH, if root { rgba(120, 150, 230, 46) } else { rgba(120, 150, 230, 24) });
                }
                bar += 1;
            }
        }
        if p % 12 == 0 && !drums { fillIn(area, area.x, y + cam.rowH - 1, area.w, 1, rgb(54, 58, 70)); }
    }
    grid(s, cam, area, snap);
    let col = hue(t);
    for i in 0..s.noteCount {
        let n = &s.notes[i];
        if n.track != t { continue; }
        let nx = beatX(cam, area, n.beat);
        let nw = n.len * cam.ppb;
        let ny = pitchY(cam, area, n.pitch);
        if nx > area.x + area.w || nx + nw < area.x || ny > area.y + area.h || ny + cam.rowH < area.y { continue; }
        // Louder notes are brighter.
        let kk = 0.45 + 0.55 * f32(n.vel) / 127.0;
        let nc = rgb(u8(f32(col.r) * kk), u8(f32(col.g) * kk), u8(f32(col.b) * kk));
        if i == chosen { nc = rgb(250, 250, 250); }
        fillIn(area, nx, ny + 1, nw - 1, cam.rowH - 2, nc);
        fillIn(area, nx, ny + 1, 2, cam.rowH - 2, rgba(255, 255, 255, 120));
        if cam.rowH >= 13 && nw > 28 {
            let label = Text.new(scratch(0));
            theory.pushPitch(&label, n.pitch, drums);
            if nx + 4 >= area.x { text(font, nx + 4, ny + (cam.rowH - 15) * 0.5, label.str(), rgb(16, 18, 22)); }
        }
    }
    // The keyboard.
    for kr in 0..rows {
        let kp = topP - kr;
        if kp < 0 || kp > 127 { continue; }
        let ky = pitchY(cam, area, kp);
        if ky + cam.rowH < r.y || ky > r.y + r.h { continue; }
        let kc = if isBlackKey(kp) { rgb(40, 42, 48) } else { rgb(200, 202, 208) };
        fillIn(r, r.x, ky, keysW - 2, cam.rowH - 1, kc);
        let name = if drums { theory.drumName(kp) } else { "" };
        if drums && name.len > 0 {
            text(font, r.x + 3, ky + (cam.rowH - 15) * 0.5, name, if isBlackKey(kp) { rgb(220, 222, 230) } else { rgb(20, 20, 24) });
        } else if !drums && kp % 12 == 0 && cam.rowH >= 10 {
            let t2 = Text.new(scratch(0));
            theory.pushPitch(&t2, kp, false);
            text(font, r.x + 3, ky + (cam.rowH - 15) * 0.5, t2.str(), rgb(20, 20, 24));
        }
    }
}

/// A bar per note, as tall as its velocity.
pub fn velLane(s: &Song, t: int, cam: &Cam, r: Rect, keysW: f32, font: Font, chosen: int) {
    fill(r.x, r.y, r.w, r.h, rgb(28, 30, 37));
    text(font, r.x + 4, r.y + 4, "vel", rgb(130, 136, 150));
    if t < 0 || t >= s.trackCount { return; }
    let area = rect(r.x + keysW, r.y + 4, r.w - keysW, r.h - 6);
    for i in 0..s.noteCount {
        let n = &s.notes[i];
        if n.track != t { continue; }
        let x = beatX(cam, area, n.beat);
        let h = area.h * f32(n.vel) / 127.0;
        fillIn(area, x, area.y + area.h - h, 3, h, if i == chosen { rgb(250, 250, 250) } else { hue(t) });
    }
}

/// The play position across `r`.
pub fn playhead(cam: &Cam, r: Rect, beat: f32) {
    let x = beatX(cam, r, beat);
    if x >= r.x && x <= r.x + r.w { fill(x, r.y, 2, r.h, rgb(250, 220, 90)); }
}

/// "bar 3 beat 2.5" for a beat from the start.
pub fn pushWhere(out: &Text, s: &Song, beat: f32) {
    let bar = int(floor(beat / f32(s.meter)));
    out.pushStr("bar ");
    out.pushInt(bar + 1);
    out.pushStr(" beat ");
    pushNum(out, f32(int((beat - f32(bar * s.meter) + 1.0) * 100.0)) / 100.0);
}
