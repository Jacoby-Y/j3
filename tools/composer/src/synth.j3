// The built-in instruments. Each note is rendered on its own and added into a stereo buffer, so the
// same song always gives the same samples.

module composer.synth;

use j3.math.{ exp, floor };
use j3.text.same;
use composer.theory;

pub const SINE: int = 0;
pub const LEAD: int = 1;
pub const PAD: int = 2;
pub const BASS: int = 3;
pub const PLUCK: int = 4;
pub const KEYS: int = 5;
pub const DRUMS: int = 6;
pub const COUNT: int = 7;
const NAMES: [7]string = ["sine", "lead", "pad", "bass", "pluck", "keys", "drums"];

pub fn name(id: int): string {
    return NAMES[id];
}

pub fn find(word: string): int {
    for i in 0..COUNT {
        if same(NAMES[i], word) { return i; }
    }
    return -1;
}

pub fn freq(pitch: int): f32 {
    return 440.0 * exp(f32(pitch - 69) * 0.05776227);
}

/// sin(2 pi p), p in cycles. A parabola with one correction step: close enough to hear as a sine.
fn fsin(p: f32): f32 {
    let x = p - floor(p);
    let y: f32 = 0;
    if x < 0.5 { y = 16.0 * x * (0.5 - x); } else { y = -16.0 * (x - 0.5) * (1.0 - x); }
    let ay = if y < 0 { 0 - y } else { y };
    return 0.225 * (y * ay - y) + y;
}

/// The step that removes the click at a saw or square edge (`t` phase, `dt` phase per sample).
fn blep(t: f32, dt: f32): f32 {
    if t < dt {
        let u = t / dt;
        return u + u - u * u - 1.0;
    }
    if t > 1.0 - dt {
        let w = (t - 1.0) / dt;
        return w * w + w + w + 1.0;
    }
    return 0;
}

fn saw(t: f32, dt: f32): f32 {
    return 2.0 * t - 1.0 - blep(t, dt);
}

fn square(t: f32, dt: f32): f32 {
    let v: f32 = if t < 0.5 { 1 } else { -1 };
    let h = t + 0.5;
    if h >= 1.0 { h -= 1.0; }
    return v + blep(t, dt) - blep(h, dt);
}

/// Attack, decay (seconds), sustain level, release (seconds) at time `t` of a note held `held` seconds.
fn adsr(t: f32, held: f32, a: f32, d: f32, s: f32, r: f32): f32 {
    if t < held { return level(t, a, d, s); }
    let start = level(held, a, d, s);
    let k = 1.0 - (t - held) / r;
    return if k > 0 { start * k } else { 0 };
}

fn level(t: f32, a: f32, d: f32, s: f32): f32 {
    if t < a { return t / a; }
    if t < a + d { return 1.0 - (1.0 - s) * (t - a) / d; }
    return s;
}

/// Seconds a note keeps sounding after it is released (or in all, for a drum).
pub fn tail(kind: int, pitch: int): f32 {
    if kind == DRUMS {
        if pitch == theory.CRASH { return 1.6; }
        if pitch == theory.OHAT { return 0.5; }
        return 0.45;
    }
    if kind == PAD { return 0.7; }
    if kind == KEYS { return 0.35; }
    if kind == LEAD { return 0.15; }
    return 0.1;
}

struct Lcg {
    s: u32;
    fn next(this: &Lcg): f32 {
        this.s = this.s * 1664525 + 1013904223;
        return f32(int(this.s / 256)) / 8388608.0 - 1.0;
    }
}

/// Add one note into `out` (stereo, interleaved) at frame `at`. `sec` is how long it is held, `tone`
/// the track's brightness 0..1, `gl`/`gr` the left and right gain.
pub fn voice(out: []f32, rate: int, at: int, sec: f32, pitch: int, vel: int, kind: int, tone: f32, gl: f32, gr: f32, seed: int) {
    let frames = out.len / 2;
    let fr = f32(rate);
    let held: f32 = if kind == DRUMS { 0 } else { sec };
    let total = int((held + tail(kind, pitch)) * fr);
    if at + total > frames { total = frames - at; }
    if total <= 0 || at < 0 { return; }
    let v = f32(vel) / 127.0;
    let amp = v * v * 0.5;
    if kind == DRUMS {
        drum(out, rate, at, total, pitch, amp, tone, gl, gr, seed);
        return;
    }
    let f = freq(pitch);
    let dt = f / fr;
    // Two one-pole low-passes: cutoff from 150 Hz (tone 0) to ~15 kHz (tone 1).
    let cut = 150.0 * exp(tone * 4.6);
    if kind == BASS { cut *= 0.35; }
    if kind == PAD { cut *= 0.5; }
    let ka = 1.0 - exp(-6.2831853 * cut / fr);
    if ka > 1.0 { ka = 1.0; }
    let y1: f32 = 0;
    let y2: f32 = 0;
    let p1: f32 = 0;
    let p2: f32 = 0.33;
    let p3: f32 = 0.66;
    let sub: f32 = 0;
    let up: f32 = 1.003;
    let down: f32 = 0.997;
    if kind == PAD { up = 1.007; down = 0.993; }
    for i in 0..total {
        let t = f32(i) / fr;
        let x: f32 = 0;
        let e: f32 = 0;
        let k = ka;
        if kind == SINE {
            x = fsin(p1);
            e = adsr(t, sec, 0.005, 0.1, 0.8, 0.1);
        } else if kind == LEAD {
            x = 0.5 * (saw(p1, dt) + saw(p2, dt * up));
            e = adsr(t, sec, 0.01, 0.2, 0.6, 0.15);
        } else if kind == PAD {
            x = 0.4 * (saw(p1, dt) + saw(p2, dt * up) + saw(p3, dt * down));
            e = adsr(t, sec, 0.3, 0.5, 0.8, 0.7);
        } else if kind == BASS {
            x = 0.5 * square(p1, dt) + 0.7 * fsin(sub);
            e = adsr(t, sec, 0.005, 0.15, 0.7, 0.08);
        } else if kind == PLUCK {
            x = 1.8 * saw(p1, dt);
            e = adsr(t, sec, 0.002, 0.35, 0.0, 0.1);
            k = ka * (0.08 + e);
            if k > 1.0 { k = 1.0; }
        } else {
            x = fsin(p1) + 0.3 * fsin(p1 * 2.0) + 0.12 * fsin(p1 * 3.0);
            e = adsr(t, sec, 0.004, 1.2, 0.15, 0.35);
        }
        y1 += k * (x - y1);
        y2 += k * (y1 - y2);
        let s = y2 * e * amp;
        out[(at + i) * 2] += s * gl;
        out[(at + i) * 2 + 1] += s * gr;
        p1 += dt;
        if p1 >= 1.0 { p1 -= 1.0; }
        p2 += dt * up;
        if p2 >= 1.0 { p2 -= 1.0; }
        sub += dt * 0.5;
        if sub >= 1.0 { sub -= 1.0; }
        p3 += dt * down;
        if p3 >= 1.0 { p3 -= 1.0; }
    }
}

/// One drum hit: kick, snare, clap, hat, open hat, tom, crash (anything else plays as a tom at its pitch).
fn drum(out: []f32, rate: int, at: int, total: int, pitch: int, amp: f32, tone: f32, gl: f32, gr: f32, seed: int) {
    let fr = f32(rate);
    let rng = Lcg { s: u32(seed * 7919 + pitch * 104729 + 1) };
    let env: f32 = 1;
    let decay: f32 = 0;
    let sweep: f32 = 1;
    let f0: f32 = 0;
    let f1: f32 = 0;
    let noise: f32 = 0;
    let body: f32 = 0;
    let hp: f32 = 0;
    if pitch == theory.KICK { decay = 7; f0 = 160; f1 = 45; body = 1.6; }
    else if pitch == theory.SNARE { decay = 18; f0 = 220; f1 = 180; body = 0.5; noise = 0.8; }
    else if pitch == theory.CLAP { decay = 16; noise = 1.0; hp = 0.6; }
    else if pitch == theory.HAT { decay = 55; noise = 0.55; hp = 0.95; }
    else if pitch == theory.OHAT { decay = 7; noise = 0.45; hp = 0.95; }
    else if pitch == theory.CRASH { decay = 2.5; noise = 0.5; hp = 0.9; }
    else { decay = 9; f0 = freq(pitch) * 1.5; f1 = freq(pitch); body = 1.2; }
    let dk = exp(0 - decay / fr);
    let sk = exp(-40.0 / fr);
    let lp: f32 = 0;
    let lpk = 0.05 + tone * 0.3;
    let ph: f32 = 0;
    for i in 0..total {
        let n = rng.next();
        lp += lpk * (n - lp);
        let nz = n - lp * hp;
        let f = f1 + (f0 - f1) * sweep;
        ph += f / fr;
        if ph >= 1.0 { ph -= 1.0; }
        let e = env;
        // A clap is three quick slaps before its tail.
        if pitch == theory.CLAP && i < rate / 30 {
            e = 1.0 - f32((i * 90) % rate) / fr;
        }
        let s = (body * fsin(ph) + noise * nz) * e * amp;
        out[(at + i) * 2] += s * gl;
        out[(at + i) * 2 + 1] += s * gr;
        env *= dk;
        sweep *= sk;
    }
}
