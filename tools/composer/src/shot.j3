// `composer run ... --render out.png`: draw a view of the song without showing a window.

module composer.shot;

use j3.game;
use j3.game.{ Font, rgb };
use j3.math.floor;
use j3.text.{ Text, same };
use composer.song;
use composer.song.Song;
use composer.util.{ cut, startsWith };
use composer.view;
use composer.view.{ Cam, rect };

pub fn fontPath(): string {
    let f = game.env("J3_COMPOSER_FONT");
    return if f.len > 0 { f } else { "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf" };
}

/// Fit the roll's camera to track `t`'s notes (a few rows of margin) in `h` pixels.
pub fn fitPitch(s: &Song, t: int, cam: &Cam, h: f32) {
    let lo = 127;
    let hi = 0;
    for i in 0..s.noteCount {
        if s.notes[i].track != t { continue; }
        if s.notes[i].pitch < lo { lo = s.notes[i].pitch; }
        if s.notes[i].pitch > hi { hi = s.notes[i].pitch; }
    }
    if hi < lo { lo = 48; hi = 72; }
    let rows = f32(hi - lo + 5);
    if rows < 14 { rows = 14; }
    cam.rowH = h / rows;
    if cam.rowH > 22 { cam.rowH = 22; }
    cam.top = floor(f32(lo + hi) * 0.5 + h / cam.rowH * 0.5);
}

/// View is arrange (chords, ruler, every track), chords (one tall lane), or roll:TRACK.
pub fn render(s: &Song, path: string, viewName: string, w: int, h: int, err: &Text): bool {
    let t = -1;
    if startsWith(viewName, "roll:") {
        t = song.findTrack(s, cut(viewName, 5, viewName.len));
        if t < 0 {
            err.pushStr("--view roll:TRACK names a track; `info` lists them");
            return false;
        }
    } else if !same(viewName, "arrange") && !same(viewName, "chords") {
        err.pushStr("--view is arrange, chords, or roll:TRACK");
        return false;
    }
    game.initGlHidden("composer render", w, h);
    let font = game.tryLoadFont(fontPath(), 14);
    let fw = f32(w);
    let fh = f32(h);
    let beats = f32(s.bars * s.meter);
    let cam = Cam { left: 0, ppb: (fw - 16) / beats, top: 84, rowH: 12 };
    game.clearTo(view.bg());
    let title = Text.new(s.mem);
    title.pushStr(s.name);
    title.pushStr("   ");
    title.pushStr(viewName);
    view.text(font, 8, 6, title.str(), rgb(200, 204, 214));
    if same(viewName, "chords") {
        view.chordLane(s, &cam, rect(8, 30, fw - 16, 66), font, true, 0, 0);
        view.ruler(s, &cam, rect(8, 98, fw - 16, 18), font, 0, 0);
    } else if t < 0 {
        view.chordLane(s, &cam, rect(8, 30, fw - 16, 24), font, false, 0, 0);
        view.ruler(s, &cam, rect(8, 56, fw - 16, 18), font, 0, 0);
        let rowH = (fh - 84) / f32(if s.trackCount > 0 { s.trackCount } else { 1 });
        if rowH > 60 { rowH = 60; }
        view.arrange(s, &cam, rect(8, 76, fw - 16, fh - 84), rowH, font, -1);
    } else {
        let keys: f32 = 44;
        cam.ppb = (fw - 16 - keys) / beats;
        let rollH = fh - 84 - 70;
        fitPitch(s, t, &cam, rollH);
        view.chordLane(s, &cam, rect(8 + keys, 30, fw - 16 - keys, 24), font, false, 0, 0);
        view.ruler(s, &cam, rect(8 + keys, 56, fw - 16 - keys, 18), font, 0, 0);
        view.roll(s, t, &cam, rect(8, 76, fw - 16, rollH), keys, font, 0.25, -1);
        view.velLane(s, t, &cam, rect(8, 80 + rollH, fw - 16, 62), keys, font, -1);
    }
    let ok = game.captureFrame(path);
    game.destroy();
    if !ok {
        err.pushStr("cannot write ");
        err.pushStr(path);
    }
    return ok;
}
