#!/usr/bin/env bash
# Build the voxel editor when its sources changed, then run it from the caller's directory.
# vox [FILE]                    the window
# vox run FILE "commands" ...   headless, for agents (vox help)
here="$(cd "$(dirname "$0")" && pwd)"
bin="$here/target/voxel_editor"
if [ ! -x "$bin" ] || [ -n "$(find "$here/src" "$here/j3.toml" -newer "$bin" -print -quit)" ]; then
  j3c build "$here" >&2 || exit 1
fi
exec "$bin" "$@"
