// j3rig: lookups, poses, clip sampling, joint matrices.

module voxrig.j3rig;

/// Part number named `name`, or 0.
pub fn find(r: &Rig, name: string): int {
    for i in 1..=r.count {
        if same(r.names[i], name) { return i; }
    }
    return 0;
}

/// Saved pose number named `name`, or 0.
pub fn findPose(r: &Rig, name: string): int {
    for i in 1..=r.poseCount {
        if same(r.poseNames[i], name) { return i; }
    }
    return 0;
}

/// Clip number named `name`, or 0.
pub fn findClip(r: &Rig, name: string): int {
    for i in 1..=r.clipCount {
        if same(r.clipNames[i], name) { return i; }
    }
    return 0;
}

/// Room for one pose: `(count + 1) * 3` degrees, all zero (the rest pose).
pub fn newAngles(r: &Rig, mem: &Arena): []f32 {
    return mem.alloc::<f32>((r.count + 1) * 3);
}

pub fn newMats(r: &Rig, mem: &Arena): []Mat4 {
    return mem.alloc::<Mat4>(r.count + 1);
}

/// Copy a saved pose into `angles`. False for an unknown name.
pub fn pose(r: &Rig, name: string, angles: []f32): bool {
    let slot = findPose(r, name);
    if slot == 0 { return false; }
    let n = (r.count + 1) * 3;
    for i in 0..n { angles[i] = r.poses[slot * n + i]; }
    return true;
}

/// Set one part's angles (degrees about x, y, z). False for an unknown part.
pub fn setAngle(r: &Rig, angles: []f32, name: string, rx: f32, ry: f32, rz: f32): bool {
    let id = find(r, name);
    if id == 0 { return false; }
    angles[id * 3] = rx;
    angles[id * 3 + 1] = ry;
    angles[id * 3 + 2] = rz;
    return true;
}

/// Pose between two saved poses (`t` 0 is `a`, 1 is `b`) into `angles`.
pub fn blend(r: &Rig, a: int, b: int, t: f32, angles: []f32) {
    let n = (r.count + 1) * 3;
    for i in 0..n { angles[i] = r.poses[a * n + i] + (r.poses[b * n + i] - r.poses[a * n + i]) * t; }
}

/// The clip `id` at `t` seconds into `angles`: its saved poses at their times (a loop goes from the last pose back to the first and
/// wraps; a one-shot holds its ends).
pub fn sample(r: &Rig, id: int, t: f32, angles: []f32) {
    if id < 1 || id > r.clipCount || r.clipLen[id] == 0 || r.clipSeconds[id] <= 0 { return; }
    let n = r.clipLen[id];
    let base = id * CLIP_KEYS;
    let secs = r.clipSeconds[id];
    let tt = t;
    if r.clipLoop[id] {
        let turns = t / secs;
        tt = (turns - floor(turns)) * secs;
    }
    let a = 0;
    for k in 0..n { if r.clipTimes[base + k] <= tt { a = k; } }
    let b = a;
    let ta = r.clipTimes[base + a];
    let tb = ta;
    if r.clipLoop[id] && tt < r.clipTimes[base] {
        a = n - 1;
        b = 0;
        ta = r.clipTimes[base + a] - secs;
        tb = r.clipTimes[base];
    } else if a < n - 1 {
        b = a + 1;
        tb = r.clipTimes[base + b];
    } else if r.clipLoop[id] {
        b = 0;
        tb = secs + r.clipTimes[base];
    }
    let u: f32 = 0;
    if tb - ta > 0.00001 { u = (tt - ta) / (tb - ta); }
    if u < 0 { u = 0; }
    if u > 1 { u = 1; }
    blend(r, r.clipKeys[base + a], r.clipKeys[base + b], u, angles);
}

fn clampDeg(v: f32, lo: f32, hi: f32): f32 {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

fn turn(r: &Rig, angles: []f32, id: int): Mat4 {
    let k = PI / 180;
    let rx = clampDeg(angles[id * 3], r.limit[id * 6], r.limit[id * 6 + 1]) * k;
    let ry = clampDeg(angles[id * 3 + 1], r.limit[id * 6 + 2], r.limit[id * 6 + 3]) * k;
    let rz = clampDeg(angles[id * 3 + 2], r.limit[id * 6 + 4], r.limit[id * 6 + 5]) * k;
    let px = r.pivot[id * 3];
    let py = r.pivot[id * 3 + 1];
    let pz = r.pivot[id * 3 + 2];
    let spin = Mat4.rotate(Vec3.xyz(0, 1, 0), ry).mul(Mat4.rotate(Vec3.xyz(1, 0, 0), rx)).mul(Mat4.rotate(Vec3.xyz(0, 0, 1), rz));
    return Mat4.translate(px, py, pz).mul(spin).mul(Mat4.translate(0 - px, 0 - py, 0 - pz));
}

fn worldOf(r: &Rig, angles: []f32, id: int, depth: int): Mat4 {
    if id == 0 || depth > r.count { return Mat4.identity(); }
    return worldOf(r, angles, r.parent[id], depth + 1).mul(turn(r, angles, id));
}

/// Matrix per part (index 0 is identity) taking the rest model to the posed one, in model units.
pub fn matrices(r: &Rig, angles: []f32, mats: []Mat4) {
    mats[0] = Mat4.identity();
    for i in 1..=r.count { mats[i] = worldOf(r, angles, i, 0); }
}

/// Where part `name`'s joint is in the posed model (model units, before `base`).
pub fn jointAt(r: &Rig, angles: []f32, name: string): Vec3 {
    let id = find(r, name);
    let at = Vec3.xyz(r.pivot[id * 3], r.pivot[id * 3 + 1], r.pivot[id * 3 + 2]);
    return worldOf(r, angles, r.parent[id], 0).transformPoint(at);
}
