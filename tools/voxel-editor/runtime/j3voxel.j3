// Load a `.j3voxel` model in a game. Copy this file into your project's src/ (rename the
// module line to match, e.g. `module mygame.j3voxel;`). No other dependencies than the stdlib.
//
//   let v = j3voxel.load("assets/robot.j3voxel", mem);
//   if v.sx == 0 { panic("missing model"); }
//   let verts = j3voxel.mesh(&v, mem, 0.1);   // x/z centered, bottom at y = 0, 0.1 per voxel
//   let robot = gfx.upload(verts);            // draw with gfx.draw(robot, model)
//
// The format is text, one item per line (see tools/voxel-editor/README.md):
//   size SX SY SZ      p INDEX RRGGBB [name]      v X Y Z INDEX [RUN]

module j3voxel;

use j3.gfx;
use j3.gfx.voxel;
use j3.io;
use j3.memory.Arena;
use j3.result.Result;

pub struct Voxels {
    sx: int;
    sy: int;
    sz: int;
    /// `sx * sy * sz` palette indices, 0 is air; `voxel.index(x, y, z, sx, sz)` finds one.
    cells: []u8;
    /// Color `i` (1..255) is `pal[i * 3 .. i * 3 + 3]`, 0..255 each.
    pal: []u8;
}

fn isDigit(b: u8): bool {
    return b >= 48 && b <= 57;
}

fn isHex(line: []u8, from: int, to: int): bool {
    for i in from..to {
        let ch = line[i];
        if !((ch >= 48 && ch <= 57) || (ch >= 97 && ch <= 102) || (ch >= 65 && ch <= 70)) { return false; }
    }
    return true;
}

fn hex(b: u8): int {
    if b >= 48 && b <= 57 { return int(b) - 48; }
    if b >= 97 && b <= 102 { return int(b) - 87; }
    if b >= 65 && b <= 70 { return int(b) - 55; }
    return 0;
}

/// Read the next whitespace-separated word of `line` from `at`; returns where it ended.
fn word(line: []u8, at: int, start: &int): int {
    let i = at;
    while i < line.len && (line[i] == 32 || line[i] == 9 || line[i] == 13) { i += 1; }
    *start = i;
    while i < line.len && !(line[i] == 32 || line[i] == 9 || line[i] == 13) { i += 1; }
    return i;
}

fn number(line: []u8, from: int, to: int): int {
    let n = 0;
    for i in from..to {
        if isDigit(line[i]) { n = n * 10 + int(line[i]) - 48; }
    }
    return n;
}

/// Parse `.j3voxel` text. `sx` is 0 when there is no usable `size` line.
pub fn parse(src: []u8, mem: &Arena): Voxels {
    let v = Voxels { sx: 0, sy: 0, sz: 0, cells: mem.alloc::<u8>(0), pal: mem.alloc::<u8>(256 * 3) };
    let pos = 0;
    while pos < src.len {
        let end = pos;
        while end < src.len && src[end] != 10 { end += 1; }
        let line = src[pos..end];
        pos = end + 1;
        let s0 = 0;
        let e0 = word(line, 0, &s0);
        if e0 == s0 || line[s0] == 35 { continue; }
        let key = line[s0];
        let a = 0;
        let b = 0;
        let c = 0;
        let d = 0;
        let e = 0;
        let ea = word(line, e0, &a);
        let eb = word(line, ea, &b);
        let ec = word(line, eb, &c);
        let ed = word(line, ec, &d);
        let ee = word(line, ed, &e);
        if key == 115 {
            v.sx = number(line, a, ea);
            v.sy = number(line, b, eb);
            v.sz = number(line, c, ec);
            if v.sx < 1 || v.sy < 1 || v.sz < 1 { return Voxels { sx: 0, sy: 0, sz: 0, cells: v.cells, pal: v.pal }; }
            v.cells = mem.alloc::<u8>(v.sx * v.sy * v.sz);
        } else if key == 112 && eb - b == 6 && isHex(line, b, eb) {
            let i = number(line, a, ea);
            if i >= 1 && i <= 255 {
                v.pal[i * 3] = u8(hex(line[b]) * 16 + hex(line[b + 1]));
                v.pal[i * 3 + 1] = u8(hex(line[b + 2]) * 16 + hex(line[b + 3]));
                v.pal[i * 3 + 2] = u8(hex(line[b + 4]) * 16 + hex(line[b + 5]));
            }
        } else if key == 118 && e0 - s0 == 1 && v.sx > 0 { // "v", not "vp"
            let x = number(line, a, ea);
            let y = number(line, b, eb);
            let z = number(line, c, ec);
            let id = number(line, d, ed);
            let run = 1;
            if ee > e { run = number(line, e, ee); }
            for k in 0..run {
                if x + k < v.sx && y < v.sy && z < v.sz { v.cells[voxel.index(x + k, y, z, v.sx, v.sz)] = u8(id); }
            }
        }
    }
    return v;
}

/// Read and parse a file; `sx` is 0 when it is missing or has no `size`.
pub fn load(path: string, mem: &Arena): Voxels {
    match io.readFile(path, mem) {
        Result.Ok(bytes) { return parse(bytes, mem); }
        Result.Err(_) { return Voxels { sx: 0, sy: 0, sz: 0, cells: mem.alloc::<u8>(0), pal: mem.alloc::<u8>(0) }; }
    }
}

/// The palette index at `(x, y, z)`; 0 outside.
pub fn at(v: &Voxels, x: int, y: int, z: int): int {
    return int(voxel.get(v.cells, v.sx, v.sy, v.sz, x, y, z));
}

/// Triangles for `gfx.upload` (10 floats per vertex), one lit face per exposed voxel side with
/// ambient occlusion. A voxel is `scale` units; x and z are centered on 0 and the bottom is y = 0.
pub fn mesh(v: &Voxels, mem: &Arena, scale: f32): []f32 {
    let faces = 0;
    for y in 0..v.sy {
        for z in 0..v.sz {
            for x in 0..v.sx {
                if at(v, x, y, z) == 0 { continue; }
                for f in 0..6 { if open(v, x, y, z, f) { faces += 1; } }
            }
        }
    }
    let out = mem.alloc::<f32>(faces * 60);
    let n = 0;
    for y in 0..v.sy {
        for z in 0..v.sz {
            for x in 0..v.sx {
                let id = at(v, x, y, z);
                if id == 0 { continue; }
                for f in 0..6 {
                    if !open(v, x, y, z, f) { continue; }
                    let c = voxel.corners(v.cells, v.sx, v.sy, v.sz, x, y, z, f);
                    n = gfx.emitFaceAo(out, n, f32(x), f32(y), f32(z), f, f32(v.pal[id * 3]) / 255,
                        f32(v.pal[id * 3 + 1]) / 255, f32(v.pal[id * 3 + 2]) / 255, 0,
                        voxel.shade(c.a), voxel.shade(c.b), voxel.shade(c.c), voxel.shade(c.d));
                }
            }
        }
    }
    let i = 0;
    while i < n {
        out[i] = (out[i] - f32(v.sx) / 2) * scale;
        out[i + 1] = out[i + 1] * scale;
        out[i + 2] = (out[i + 2] - f32(v.sz) / 2) * scale;
        i += 10;
    }
    return out[0..n];
}

fn open(v: &Voxels, x: int, y: int, z: int, face: int): bool {
    let nx = x;
    let ny = y;
    let nz = z;
    if face == gfx.FACE_NX { nx -= 1; }
    if face == gfx.FACE_PX { nx += 1; }
    if face == gfx.FACE_NY { ny -= 1; }
    if face == gfx.FACE_PY { ny += 1; }
    if face == gfx.FACE_NZ { nz -= 1; }
    if face == gfx.FACE_PZ { nz += 1; }
    return at(v, nx, ny, nz) == 0;
}
