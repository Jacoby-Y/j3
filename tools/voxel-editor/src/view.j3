// Drawing a model with `j3.gfx`: the mesh, the floor grid, and a camera pass shared by the
// window and the headless renderer.

module voxel_editor.view;

use j3.gfx;
use j3.gfx.{ Mesh, Orbit };
use j3.math.{ Mat4, Vec3 };
use j3.memory.Arena;
use voxel_editor.mesh;
use voxel_editor.model.Model;
use voxel_editor.model;
use voxel_editor.rig;

pub struct View {
    mesh: Mesh;
    /// The model revision `mesh` was built from.
    rev: int;
    ao: bool;
    /// Color voxels by part, not palette.
    tint: bool;
    /// Draw joints and bones over the model.
    joints: bool;
    /// Draw overlay pixels.
    overlays: bool;
}

pub fn create(): View {
    return View { mesh: Mesh {}, rev: 0, ao: true, tint: false, joints: true, overlays: true };
}

/// Rebuild the mesh when the model changed since the last call.
pub fn remesh(v: &View, m: &Model) {
    if v.rev == m.rev { return; }
    v.rev = m.rev;
    let n = mesh.floatCount(m, m.partCount > 0, v.overlays);
    if n == 0 {
        gfx.free(&v.mesh);
        return;
    }
    let mem = Arena.create(n * 4 + 4096);
    defer mem.destroy();
    let verts = mem.alloc::<f32>(n);
    let mats = mem.alloc::<Mat4>(model.MAXPARTS + 1);
    if m.partCount > 0 { rig.matrices(m, 0, mats); }
    else { mats = mats[0..0]; }
    mesh.build(m, verts, v.ao, mats, v.tint, v.overlays);
    if v.mesh.vao == 0 { v.mesh = gfx.upload(verts); }
    else { gfx.update(&v.mesh, verts); }
}

pub fn release(v: &View) {
    gfx.free(&v.mesh);
}

/// Where the sun is (toward it). Chosen so the x and z faces differ.
pub fn sun(): Vec3 {
    return Vec3.xyz(0.55, 0.8, 0.35);
}

pub fn sky(): Vec3 {
    return Vec3.xyz(0.5, 0.54, 0.62);
}

pub fn line(a: Vec3, b: Vec3, c: Vec3) {
    gfx.drawLine(a, b, c);
}

/// A wire box from corner `a` to `b`.
pub fn wireBox(a: Vec3, b: Vec3, c: Vec3) {
    line(Vec3.xyz(a.x, a.y, a.z), Vec3.xyz(b.x, a.y, a.z), c);
    line(Vec3.xyz(b.x, a.y, a.z), Vec3.xyz(b.x, a.y, b.z), c);
    line(Vec3.xyz(b.x, a.y, b.z), Vec3.xyz(a.x, a.y, b.z), c);
    line(Vec3.xyz(a.x, a.y, b.z), Vec3.xyz(a.x, a.y, a.z), c);
    line(Vec3.xyz(a.x, b.y, a.z), Vec3.xyz(b.x, b.y, a.z), c);
    line(Vec3.xyz(b.x, b.y, a.z), Vec3.xyz(b.x, b.y, b.z), c);
    line(Vec3.xyz(b.x, b.y, b.z), Vec3.xyz(a.x, b.y, b.z), c);
    line(Vec3.xyz(a.x, b.y, b.z), Vec3.xyz(a.x, b.y, a.z), c);
    line(Vec3.xyz(a.x, a.y, a.z), Vec3.xyz(a.x, b.y, a.z), c);
    line(Vec3.xyz(b.x, a.y, a.z), Vec3.xyz(b.x, b.y, a.z), c);
    line(Vec3.xyz(b.x, a.y, b.z), Vec3.xyz(b.x, b.y, b.z), c);
    line(Vec3.xyz(a.x, a.y, b.z), Vec3.xyz(a.x, b.y, b.z), c);
}

/// The floor grid, the model's bounding box, and colored axes at the origin (x red, y green,
/// z blue). Call inside the camera pass.
pub fn drawGuides(m: &Model, grid: bool) {
    let sx = f32(m.sx);
    let sy = f32(m.sy);
    let sz = f32(m.sz);
    if grid {
        let tint = Vec3.xyz(0.34, 0.37, 0.43);
        for x in 0..=m.sx {
            tint = if x % 8 == 0 { Vec3.xyz(0.22, 0.25, 0.31) } else { Vec3.xyz(0.36, 0.39, 0.46) };
            line(Vec3.xyz(f32(x), 0, 0), Vec3.xyz(f32(x), 0, sz), tint);
        }
        for z in 0..=m.sz {
            tint = if z % 8 == 0 { Vec3.xyz(0.22, 0.25, 0.31) } else { Vec3.xyz(0.36, 0.39, 0.46) };
            line(Vec3.xyz(0, 0, f32(z)), Vec3.xyz(sx, 0, f32(z)), tint);
        }
    }
    wireBox(Vec3.xyz(0, 0, 0), Vec3.xyz(sx, sy, sz), Vec3.xyz(0.3, 0.33, 0.4));
    line(Vec3.xyz(0, 0, 0), Vec3.xyz(sx, 0, 0), Vec3.xyz(0.9, 0.25, 0.25));
    line(Vec3.xyz(0, 0, 0), Vec3.xyz(0, sy, 0), Vec3.xyz(0.3, 0.8, 0.3));
    line(Vec3.xyz(0, 0, 0), Vec3.xyz(0, 0, sz), Vec3.xyz(0.3, 0.45, 0.95));
}

/// The model's center, where cameras look.
pub fn center(m: &Model): Vec3 {
    return Vec3.xyz(f32(m.sx) / 2, f32(m.sy) / 2, f32(m.sz) / 2);
}

/// Draw the mesh into the current output: a shadow pass, then the lit camera pass, left open so
/// the caller can add lines. `ortho` is the half height of an orthographic view (0 for
/// perspective).
pub fn pass(v: &View, m: &Model, cam: Orbit, ortho: f32, grid: bool) {
    gfx.setFog(100000, 100001);
    gfx.setOrtho(ortho);
    gfx.setFov(0);
    gfx.setClip(0.05, 2000);
    gfx.shadowPass(sun(), Vec3.xyz(-4, -4, -4), Vec3.xyz(f32(m.sx) + 4, f32(m.sy) + 4, f32(m.sz) + 4));
    // No shadow casters: ambient occlusion alone reads cleaner on voxels than shadow-map acne.
    gfx.light(0, cam.eye(), Vec3.xyz(0.18, 0.18, 0.2), cam.radius * 4 + 40);
    gfx.cameraPass(cam, sun(), sky(), Vec3.xyz(1, 0.96, 0.88));
    if v.mesh.vao != 0 { gfx.draw(v.mesh, Mat4.identity()); }
    drawGuides(m, grid);
    if v.joints { drawJoints(m); }
}

/// A cross at every joint (the active part's is yellow) and a line from each joint to its parent's.
pub fn drawJoints(m: &Model) {
    for i in 1..=m.partCount {
        let at = rig.pivotWorld(m, 0, i);
        let up = m.parts[i].parent;
        let c = if i == m.active { Vec3.xyz(1, 0.9, 0.1) } else { Vec3.xyz(1, 0.25, 0.9) };
        let r: f32 = 0.6;
        line(Vec3.xyz(at.x - r, at.y, at.z), Vec3.xyz(at.x + r, at.y, at.z), c);
        line(Vec3.xyz(at.x, at.y - r, at.z), Vec3.xyz(at.x, at.y + r, at.z), c);
        line(Vec3.xyz(at.x, at.y, at.z - r), Vec3.xyz(at.x, at.y, at.z + r), c);
        if up != 0 { line(at, rig.pivotWorld(m, 0, up), Vec3.xyz(0.9, 0.9, 0.95)); }
    }
}
