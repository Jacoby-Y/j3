// rig: `rig check`.

module voxel_editor.rig;

// ------------------------------------------------------------------------------------------ check

fn issue(out: &Text, level: string, part: string, msg: string) {
    out.pushStr(level);
    out.pushStr(": ");
    if part.len > 0 {
        out.pushStr(part);
        out.pushStr(": ");
    }
    out.pushStr(msg);
    out.push(10);
}

/// Rig problems as `error: ` / `warning: ` lines in `out`. Returns the number of errors.
pub fn check(m: &Model, out: &Text): int {
    let errors = 0;
    if m.partCount == 0 {
        issue(out, "warning", "", "no parts yet (`part new NAME`, or `rig humanoid`)");
        return 0;
    }
    for i in 1..=m.partCount {
        let nm = m.parts[i].name;
        let up = m.parts[i].parent;
        if up < 0 || up > m.partCount || up == i {
            issue(out, "error", nm, "parent is not another part");
            errors += 1;
        } else if up != 0 {
            // A cycle never reaches a root within MAXPARTS steps.
            let at = up;
            let steps = 0;
            while at != 0 && steps <= MAXPARTS {
                at = m.parts[at].parent;
                steps += 1;
            }
            if at != 0 {
                issue(out, "error", nm, "parent chain loops");
                errors += 1;
            }
        }
        for j in 1..i {
            if same(m.parts[j].name, nm) {
                issue(out, "error", nm, "name used twice");
                errors += 1;
            }
        }
        let a: [3]int = [0, 0, 0];
        let b: [3]int = [0, 0, 0];
        if !bounds(m, i, &a, &b) {
            issue(out, "warning", nm, "has no voxels");
        } else {
            let px = m.parts[i].px;
            let py = m.parts[i].py;
            let pz = m.parts[i].pz;
            if px < f32(a[0]) - 1 || px > f32(b[0] + 1) + 1 || py < f32(a[1]) - 1 || py > f32(b[1] + 1) + 1
                || pz < f32(a[2]) - 1 || pz > f32(b[2] + 1) + 1 {
                issue(out, "warning", nm, "pivot is more than a voxel outside the part (`part pivot-auto` puts it at the joint)");
            }
        }
        if m.parts[i].lx0 > m.parts[i].lx1 || m.parts[i].ly0 > m.parts[i].ly1 || m.parts[i].lz0 > m.parts[i].lz1 {
            issue(out, "error", nm, "a rotation limit has min above max");
            errors += 1;
        }
    }
    if m.overlayCount > 0 {
        let ovMem = Arena.create(m.sx * m.sy * m.sz + 64 * 1024);
        defer ovMem.destroy();
        let ovCells = ovMem.alloc::<u8>(m.sx * m.sy * m.sz);
        for o in 1..=m.overlayCount {
            let ovState = overlay.cells(m, o, ovCells);
            let ovName = m.overlays[o].name;
            if ovState == 2 {
                issue(out, "error", ovName, "overlay shell leaves the grid (`size` bigger or `shift` the model, or lower its grow)");
                errors += 1;
            } else if ovState == 1 {
                issue(out, "warning", ovName, "overlay's part has no voxels");
            } else {
                let nc = 0;
                let nf = 0;
                let np = 0;
                let ns = 0;
                overlay.counts(m, o, ovCells, &nc, &nf, &np, &ns);
                if ns > 0 {
                    let st = Text.new(out.arena);
                    st.pushInt(ns);
                    st.pushStr(" painted faces are no longer on its surface (`overlay prune NAME` drops them)");
                    issue(out, "warning", ovName, st.str());
                }
            }
        }
    }
    let loose = voxels(m, 0);
    if loose > 0 {
        let t = Text.new(out.arena);
        t.pushInt(loose);
        t.pushStr(" voxels belong to no part (`part assign-rest NAME`)");
        issue(out, "warning", "", t.str());
    }
    return errors;
}
