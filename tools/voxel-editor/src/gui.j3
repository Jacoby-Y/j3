// The editor window: boot, input, and the draw loop.

module voxel_editor.gui;

use j3.app.App;
use j3.game;
use j3.game.{ Font, Key, Mouse };
use j3.gfx;
use j3.gfx.Orbit;
use j3.io.{ exists, printLn };
use j3.math.{ Vec2, Vec3 };
use j3.memory.{ Arena, scratch };
use j3.sys;
use j3.text.Text;
use j3.ui.{ Ui, typing };
use voxel_editor.cmd;
use voxel_editor.edit;
use voxel_editor.edit.{ cancel, frame, hoverPick, overView, say, viewOrigin, viewSize };
use voxel_editor.files;
use voxel_editor.hostio;
use voxel_editor.model;
use voxel_editor.panels;
use voxel_editor.pick;
use voxel_editor.view;
use voxel_editor.world;
use voxel_editor.world.{ BOTTOM, BOX, CYLINDER, FILL, LEFT, LINE, PENCIL, PICKER, RIGHT, SPHERE, TOP, World };

fn boot(mem: &Arena): World {
    let given = sys.arg(1);
    let w = World {
        mem: mem, m: model.create(mem, 16, 16, 16), view: view.create(), font: Font { raw: 0 },
        cam: Orbit.create(Vec3.xyz(8, 8, 8), 0.7, 0.5, 40), ortho: false, grid: true, shaded: true,
        path: Text.new(mem), stamp: 0, pollTicks: 0, tool: PENCIL, mode: model.ADD, color: 4, brush: 1, depth: 1,
        hollow: false, layerFill: false, hover: pick.none(), active: false, anchor: [0, 0, 0], cur: [0, 0, 0],
        last: [0, 0, 0], axis: 1, sign: 1, lock: -1, lastMouse: Vec2 { x: 0, y: 0 }, status: Text.new(mem),
        console: Text.new(mem), hexEdit: Text.new(mem), nameEdit: Text.new(mem), palFile: Text.new(mem),
        palTop: 0, palEditing: false, closeWarned: false, showHelp: false, log: Text.new(mem),
        rigTab: false, partTop: 0, partDrag: false, partTint: false, ovActive: 0, ovCells: mem.alloc::<u8>(model.MAX * model.MAX * model.MAX), ovRev: -1, ovDrag: false,
        ovFile: Text.new(mem), ovGrow: 1, partName: Text.new(mem), poseName: Text.new(mem),
    };
    w.path.pushStr(if given.len > 0 { given } else { "models/untitled.j3voxel" });
    w.palFile.pushStr("mine");
    w.ovFile.pushStr("overlay.png");
    say(&w, "Left-drag draws. Right-drag orbits. F2 shows every key.");
    if exists(files.pathNow(&w)) { files.open(&w); }
    else { w.m.name = "untitled"; }
    return w;
}

fn startup(w: &World) {
    gfx.init();
    game.setMinSize(1000, 660);
    game.holdClose(true);
    w.font = game.tryLoadFont(hostio.envValue("J3_VOXEL_FONT", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf"), 15);
    if w.font.raw == 0 { printLn("voxel editor: could not load a UI font; set J3_VOXEL_FONT to a .ttf file"); }
    frame(w);
}

fn setTool(w: &World, tool: int) {
    if w.active { return; }
    w.tool = tool;
}

fn toggleLock(w: &World, axis: int) {
    if w.lock == axis { w.lock = -1; say(w, "Plane: auto (follows the face you point at)"); return; }
    w.lock = axis;
    if axis == 0 { say(w, "Plane locked to X (red): drawing on the YZ wall"); }
    if axis == 1 { say(w, "Plane locked to Y (green): drawing flat, left/right/front/back"); }
    if axis == 2 { say(w, "Plane locked to Z (blue): drawing on the XY wall"); }
}

fn shortcuts(w: &World) {
    let ctrl = game.keyDown(Key.Ctrl);
    if ctrl && game.keyPressed(Key.S) { files.save(w); }
    if ctrl && game.keyPressed(Key.Z) && !w.active {
        if game.keyDown(Key.Shift) { model.redo(&w.m); } else { model.undo(&w.m); }
    }
    if ctrl && game.keyPressed(Key.Y) && !w.active { model.redo(&w.m); }
    if game.keyPressed(Key.F2) { w.showHelp = !w.showHelp; }
    if game.keyPressed(Key.Escape) {
        if w.active { cancel(w); }
        else { w.log.clear(); }
    }
    if ctrl { return; }
    if game.keyPressed(Key.B) { setTool(w, PENCIL); }
    if game.keyPressed(Key.U) { setTool(w, BOX); }
    if game.keyPressed(Key.O) { setTool(w, SPHERE); }
    if game.keyPressed(Key.C) { setTool(w, CYLINDER); }
    if game.keyPressed(Key.L) { setTool(w, LINE); }
    if game.keyPressed(Key.G) { setTool(w, FILL); }
    if game.keyPressed(Key.I) { setTool(w, PICKER); }
    if game.keyPressed(Key.Num1) { w.mode = model.ADD; }
    if game.keyPressed(Key.Num2) { w.mode = model.ERASE; }
    if game.keyPressed(Key.Num3) { w.mode = model.PAINT; }
    if !ctrl && !w.active {
        if game.keyPressed(Key.X) { toggleLock(w, 0); }
        if game.keyPressed(Key.Y) { toggleLock(w, 1); }
        if game.keyPressed(Key.Z) { toggleLock(w, 2); }
    }
    if game.keyPressed(Key.H) { w.hollow = !w.hollow; }
    if game.keyPressed(Key.F) { frame(w); }
}

fn camera(w: &World, mp: Vec2) {
    let delta = mp - w.lastMouse;
    if game.mouseDown(Mouse.Right) && !game.keyDown(Key.Shift) {
        w.cam.orbit(0 - delta.x * 0.01, delta.y * 0.01);
    }
    if game.mouseDown(Mouse.Middle) || (game.mouseDown(Mouse.Right) && game.keyDown(Key.Shift)) {
        let forward = (w.cam.target - w.cam.eye()).normalize();
        let right = forward.cross(Vec3.up()).normalize();
        let up = right.cross(forward);
        let k = w.cam.radius * 0.0016;
        w.cam.target = w.cam.target - right * (delta.x * k) + up * (delta.y * k);
    }
    let wheel = game.mouseWheel();
    if wheel != 0 {
        if game.keyDown(Key.Ctrl) {
            w.depth += if wheel > 0 { 1 } else { -1 };
            if w.depth < 1 { w.depth = 1; }
            if w.depth > 64 { w.depth = 64; }
        } else if game.keyDown(Key.Shift) {
            w.brush += if wheel > 0 { 1 } else { -1 };
            if w.brush < 1 { w.brush = 1; }
            if w.brush > 8 { w.brush = 8; }
        } else {
            w.cam.zoom(0 - wheel * w.cam.radius * 0.1, 3, 600);
        }
    }
}

fn input(w: &World, dt: f32) {
    let mp = game.mousePos();
    if game.closeRequested() {
        if w.m.dirty && !w.closeWarned {
            w.closeWarned = true;
            say(w, "Unsaved changes. Ctrl+S saves; close the window again to quit anyway.");
        } else {
            game.requestQuit();
        }
    }
    if !typing() { shortcuts(w); }
    files.watch(w);
    let inView = overView(mp);
    if inView { camera(w, mp); }
    let orbiting = game.mouseDown(Mouse.Right) || game.mouseDown(Mouse.Middle);
    if inView && !orbiting { hoverPick(w); } else if !w.active { w.hover = pick.none(); }
    if inView && !orbiting && game.mousePressed(Mouse.Left) { edit.press(w); }
    if game.mouseDown(Mouse.Left) { edit.drag(w); }
    if game.mouseReleased(Mouse.Left) {
        edit.release(w);
        edit.partRelease(w);
        edit.ovRelease(w);
    }
    if w.ovDrag && game.mouseDown(Mouse.Left) { edit.ovStamp(w); }
    if w.partDrag && game.mouseDown(Mouse.Left) { edit.partStamp(w); }
    w.lastMouse = mp;
}

fn drawScene(w: &World) {
    view.remesh(&w.view, &w.m);
    let o = viewOrigin();
    let s = viewSize();
    gfx.setViewRect(o.x, o.y, s.x, s.y);
    let half: f32 = 0;
    if w.ortho { half = w.cam.radius * 0.5774; }
    view.pass(&w.view, &w.m, w.cam, half, w.grid);
    edit.drawMirrors(w);
    edit.drawCursor(w);
}

/// Run what was typed in the console box; show its output.
fn console(w: &World, line: string) {
    if line.len == 0 { return; }
    let out = Text.new(scratch(0));
    let ok = cmd.runAll(&w.m, line, &out);
    w.log.clear();
    w.log.pushStr(out.str());
    if out.len() == 0 { say(w, "ok"); }
    else if !ok { say(w, "That command failed; the details are above the bar.");  }
    else { say(w, "Done; the output is above the bar (Esc hides it)."); }
    if out.len() == 0 { w.log.clear(); }
}

fn draw(w: &World) {
    drawScene(w);
    let win = game.windowSize();
    let ui = Ui.begin(w.font, 0, 0);
    ui.theme = panels.theme();
    panels.leftPanel(&ui, w);
    panels.rightPanel(&ui, w);
    panels.topBar(&ui, w);
    panels.helpCard(w);
    panels.logCard(w);
    let line = panels.bottomBar(&ui, w);
    console(w, line);
    // The cell under the pointer, bottom left of the view.
    if w.font.raw != 0 && w.hover.ok {
        let t = Text.new(scratch(0));
        let at = if w.hover.solid { w.hover.x } else { w.hover.px };
        t.pushInt(at);
        t.pushStr(", ");
        t.pushInt(if w.hover.solid { w.hover.y } else { w.hover.py });
        t.pushStr(", ");
        t.pushInt(if w.hover.solid { w.hover.z } else { w.hover.pz });
        game.setColor(game.rgb(230, 232, 240));
        game.drawText(w.font, Vec2 { x: LEFT + 12, y: win.y - BOTTOM - 26 }, t.str());
    }
}

/// Open the editor window on the model named by the first argument (or a new one).
pub fn run() {
    let app = App<World>.createSized("J3 Voxel Editor", 1400, 860, 192 * 1024 * 1024, boot);
    app.useGl();
    app.startup(startup);
    app.always(input);
    app.draw(draw);
    app.run();
}
