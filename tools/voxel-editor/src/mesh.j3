// Model to triangles: one lit, ambient-occluded face per exposed voxel side.

module voxel_editor.mesh;

use j3.gfx;
use j3.gfx.mesh.emit;
use j3.gfx.voxel;
use j3.io;
use j3.math.{ Mat4, Vec3 };
use j3.memory.Arena;
use j3.result.Result;
use j3.text.Text;
use voxel_editor.model;
use voxel_editor.model.Model;
use voxel_editor.overlay;
use voxel_editor.util.hexValue;

const FLOATS_PER_FACE: int = 60;

/// Whether `face` of the voxel at `(x, y, z)` is drawn: its neighbor is air, or (when `split`) a
/// voxel of another part, so a part that turns still has its skin at the joint.
fn neighborAir(m: &Model, x: int, y: int, z: int, face: int, split: bool): bool {
    let nx = x;
    let ny = y;
    let nz = z;
    if face == gfx.FACE_NX { nx -= 1; }
    if face == gfx.FACE_PX { nx += 1; }
    if face == gfx.FACE_NY { ny -= 1; }
    if face == gfx.FACE_PY { ny += 1; }
    if face == gfx.FACE_NZ { nz -= 1; }
    if face == gfx.FACE_PZ { nz += 1; }
    if model.get(m, nx, ny, nz) == 0 { return true; }
    if !split { return false; }
    return m.part[voxel.index(nx, ny, nz, m.sx, m.sz)] != m.part[voxel.index(x, y, z, m.sx, m.sz)];
}

fn neighborSolid(m: &Model, x: int, y: int, z: int, face: int): bool {
    let nx = x;
    let ny = y;
    let nz = z;
    if face == gfx.FACE_NX { nx -= 1; }
    if face == gfx.FACE_PX { nx += 1; }
    if face == gfx.FACE_NY { ny -= 1; }
    if face == gfx.FACE_PY { ny += 1; }
    if face == gfx.FACE_NZ { nz -= 1; }
    if face == gfx.FACE_PZ { nz += 1; }
    return model.get(m, nx, ny, nz) != 0;
}

fn faceConst(f: int): int {
    if f == 0 { return gfx.FACE_PX; }
    if f == 1 { return gfx.FACE_NX; }
    if f == 2 { return gfx.FACE_PY; }
    if f == 3 { return gfx.FACE_NY; }
    if f == 4 { return gfx.FACE_PZ; }
    return gfx.FACE_NZ;
}

/// The visible painted pixels of every shown overlay, one face each: written into `out` from `at`
/// when `emit` (moved by the owning part's matrix), only counted otherwise. Returns the next index.
fn overlayPass(m: &Model, out: []f32, at0: int, mats: []Mat4, emit: bool): int {
    let at = at0;
    let ovMem = Arena.create(m.sx * m.sy * m.sz * 12 + 1024 * 1024);
    defer ovMem.destroy();
    let ovCells = ovMem.alloc::<u8>(m.sx * m.sy * m.sz);
    for o in 1..=m.overlayCount {
        if !m.overlays[o].visible || overlay.cells(m, o, ovCells) != 0 { continue; }
        let first = 0;
        let end = 0;
        model.texRange(m, o, &first, &end);
        for i in first..end {
            let key = model.texKeyOf(m.texels[i]);
            let x = model.texX(key);
            let y = model.texY(key);
            let z = model.texZ(key);
            let f = model.texFace(key);
            if !model.inside(m, x, y, z) || ovCells[voxel.index(x, y, z, m.sx, m.sz)] == 0 || !overlay.exposed(m, ovCells, x, y, z, f) { continue; }
            if !emit {
                at += FLOATS_PER_FACE;
                continue;
            }
            let rgb = model.texRgb(m.texels[i]);
            at = gfx.emitFace(out, at, f32(x), f32(y), f32(z), faceConst(f), f32(rgb / 65536) / 255,
                f32((rgb / 256) % 256) / 255, f32(rgb % 256) / 255, 0);
            if mats.len > 0 && m.overlays[o].part > 0 { pose(out, at - FLOATS_PER_FACE, mats[m.overlays[o].part]); }
        }
    }
    return at;
}

/// How many floats `build` writes.
pub fn floatCount(m: &Model, split: bool, overlays: bool): int {
    let faces = 0;
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                if model.get(m, x, y, z) == 0 { continue; }
                for f in 0..6 {
                    if neighborAir(m, x, y, z, f, split) { faces += 1; }
                }
            }
        }
    }
    let total = faces * FLOATS_PER_FACE;
    if overlays && m.overlayCount > 0 {
        let none = Arena.create(4096);
        defer none.destroy();
        let nof = none.alloc::<f32>(1);
        let nom = none.alloc::<Mat4>(1);
        total = overlayPass(m, nof[0..0], total, nom[0..0], false);
    }
    return total;
}

const TINTS: string = "e6194b 3cb44b ffe119 4363d8 f58231 911eb4 46f0f0 f032e6 bcf60c fabebe 008080 e6beff";

/// A part's debug color channel (0..1): twelve distinct hues, gray for no part.
fn tintOf(part: int, ch: int): f32 {
    if part == 0 { return 0.6; }
    let at = ((part - 1) % 12) * 7 + ch * 2;
    let hex = TINTS;
    return f32(hexValue(hex[at]) * 16 + hexValue(hex[at + 1])) / 255;
}

/// Move the six vertices written at `from..from + 60` by `t` (positions and normals).
fn pose(out: []f32, from: int, t: Mat4) {
    let origin = t.transformPoint(Vec3.xyz(0, 0, 0));
    for k in 0..6 {
        let v = from + k * 10;
        let p = t.transformPoint(Vec3.xyz(out[v], out[v + 1], out[v + 2]));
        let n = t.transformPoint(Vec3.xyz(out[v + 3], out[v + 4], out[v + 5]));
        out[v] = p.x;
        out[v + 1] = p.y;
        out[v + 2] = p.z;
        out[v + 3] = n.x - origin.x;
        out[v + 4] = n.y - origin.y;
        out[v + 5] = n.z - origin.z;
    }
}

/// Write the faces into `out` (room for `floatCount`). `ao` shades corners. A part's faces move
/// by its matrix in `mats` (empty: rest pose), and `tint` colors by part instead of palette.
pub fn build(m: &Model, out: []f32, ao: bool, mats: []Mat4, tint: bool, overlays: bool): int {
    let at = 0;
    let split = mats.len > 0;
    let passes = if split { m.partCount + 1 } else { 1 };
    for part in 0..passes {
        // A rigged model shades each part alone: another part's voxels are not ambient occluders,
        // since that part may turn away.
        let solid = m.cells;
        if split {
            for i in 0..m.sx * m.sy * m.sz { m.tmp[i] = if int(m.part[i]) == part { m.cells[i] } else { 0 }; }
            solid = m.tmp;
        }
        for y in 0..m.sy {
            for z in 0..m.sz {
                for x in 0..m.sx {
                    let id = model.get(m, x, y, z);
                    if id == 0 { continue; }
                    let pid = int(m.part[voxel.index(x, y, z, m.sx, m.sz)]);
                    if split && pid != part { continue; }
                    let r = f32(model.color(m, id, 0)) / 255;
                    let g = f32(model.color(m, id, 1)) / 255;
                    let b = f32(model.color(m, id, 2)) / 255;
                    if tint {
                        r = tintOf(pid, 0);
                        g = tintOf(pid, 1);
                        b = tintOf(pid, 2);
                    }
                    for f in 0..6 {
                        if !neighborAir(m, x, y, z, f, split) { continue; }
                        // A face against another part is seen only where a joint opens: light it
                        // like skin instead of leaving a black wedge.
                        let emi: f32 = if neighborSolid(m, x, y, z, f) { 0.55 } else { 0 };
                        if ao {
                            let c = voxel.corners(solid, m.sx, m.sy, m.sz, x, y, z, f);
                            at = gfx.emitFaceAo(out, at, f32(x), f32(y), f32(z), f, r, g, b, emi,
                                voxel.shade(c.a), voxel.shade(c.b), voxel.shade(c.c), voxel.shade(c.d));
                        } else {
                            at = gfx.emitFace(out, at, f32(x), f32(y), f32(z), f, r, g, b, emi);
                        }
                        if split && pid > 0 { pose(out, at - FLOATS_PER_FACE, mats[pid]); }
                    }
                }
            }
        }
    }
    if overlays && m.overlayCount > 0 { at = overlayPass(m, out, at, mats, true); }
    return at;
}

/// Write a `.j3mesh` for the scene editor: voxels `scale` units wide, centered on x and z with
/// the model's bottom at y = 0.
pub fn exportMesh(m: &Model, path: string, scale: f32, err: &Text): bool {
    let n = floatCount(m, false, false);
    if n == 0 {
        err.pushStr("the model is empty, so there is no mesh to export");
        return false;
    }
    let mem = Arena.create(n * 4 + 1024 * 1024);
    defer mem.destroy();
    let verts = mem.alloc::<f32>(n);
    let rest = mem.alloc::<Mat4>(1);
    build(m, verts, true, rest[0..0], false, false);
    let cx = f32(m.sx) / 2;
    let cz = f32(m.sz) / 2;
    let i = 0;
    while i < n {
        verts[i] = (verts[i] - cx) * scale;
        verts[i + 1] = verts[i + 1] * scale;
        verts[i + 2] = (verts[i + 2] - cz) * scale;
        i += 10;
    }
    let bytes = emit(&mem, verts);
    match io.writeFile(path, bytes) {
        Result.Ok(_) { return true; }
        Result.Err(_) {
            err.pushStr("cannot write ");
            err.pushStr(path);
            return false;
        }
    }
}
