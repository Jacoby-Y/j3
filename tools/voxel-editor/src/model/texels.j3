// model: overlay texel keys and storage.

module voxel_editor.model;

// ------------------------------------------------------------------------------ overlay pixels

/// Sort key of the pixel on `face` (0 px, 1 nx, 2 py, 3 ny, 4 pz, 5 nz) of cell `(x, y, z)` in
/// overlay `ov` (1..8). Pixels sort by overlay, face, y, z, x, so a run along +x is adjacent.
pub fn texKey(ov: int, face: int, x: int, y: int, z: int): int {
    return ((((ov - 1) * 6 + face) * 64 + y) * 64 + z) * 64 + x;
}

pub fn texOverlay(key: int): int { return key / KEYS_PER_OVERLAY + 1; }

pub fn texFace(key: int): int { return (key / (64 * 64 * 64)) % 6; }

pub fn texY(key: int): int { return (key / (64 * 64)) % 64; }

pub fn texZ(key: int): int { return (key / 64) % 64; }

pub fn texX(key: int): int { return key % 64; }

pub fn texRgb(packed: int): int { return packed % RGB_RANGE; }

pub fn texKeyOf(packed: int): int { return packed / RGB_RANGE; }

/// Index of the first pixel whose key is `key` or more (`texelCount` when none).
pub fn texFind(m: &Model, key: int): int {
    let a = 0;
    let b = m.texelCount;
    while a < b {
        let mid = (a + b) / 2;
        if texKeyOf(m.texels[mid]) < key { a = mid + 1; } else { b = mid; }
    }
    return a;
}

/// The rgb painted at `key`, or -1.
pub fn texGet(m: &Model, key: int): int {
    let at = texFind(m, key);
    if at < m.texelCount && texKeyOf(m.texels[at]) == key { return texRgb(m.texels[at]); }
    return -1;
}

/// Paint (or recolor) one pixel. False when the pixel pool is full.
pub fn texSet(m: &Model, key: int, rgb: int): bool {
    let at = texFind(m, key);
    if at < m.texelCount && texKeyOf(m.texels[at]) == key {
        m.texels[at] = key * RGB_RANGE + rgb;
        touch(m);
        return true;
    }
    if m.texelCount >= MAXTEXELS { return false; }
    let i = m.texelCount;
    while i > at {
        m.texels[i] = m.texels[i - 1];
        i -= 1;
    }
    m.texels[at] = key * RGB_RANGE + rgb;
    m.texelCount += 1;
    touch(m);
    return true;
}

/// Clear one pixel; true when there was one.
pub fn texDel(m: &Model, key: int): bool {
    let at = texFind(m, key);
    if at >= m.texelCount || texKeyOf(m.texels[at]) != key { return false; }
    for i in at..m.texelCount - 1 { m.texels[i] = m.texels[i + 1]; }
    m.texelCount -= 1;
    touch(m);
    return true;
}

/// Pixels of overlay `ov`: first index and one past the last.
pub fn texRange(m: &Model, ov: int, first: &int, end: &int) {
    *first = texFind(m, (ov - 1) * KEYS_PER_OVERLAY);
    *end = texFind(m, ov * KEYS_PER_OVERLAY);
}

/// Delete overlay `ov` and its pixels; later overlays move down a number.
pub fn removeOverlay(m: &Model, ov: int) {
    let n = 0;
    for i in 0..m.texelCount {
        let key = texKeyOf(m.texels[i]);
        let o = texOverlay(key);
        if o == ov { continue; }
        m.texels[n] = if o > ov { (key - KEYS_PER_OVERLAY) * RGB_RANGE + texRgb(m.texels[i]) } else { m.texels[i] };
        n += 1;
    }
    m.texelCount = n;
    for i in ov..m.overlayCount { m.overlays[i] = m.overlays[i + 1]; }
    m.overlayCount -= 1;
    touch(m);
}

/// Unit normal of face 0..5 along `axis` (0 x, 1 y, 2 z), +1 or -1, 0 elsewhere.
fn faceComp(f: int, axis: int): int {
    if f / 2 != axis { return 0; }
    return if f % 2 == 0 { 1 } else { -1 };
}

fn faceOfVec(a: int, b: int, c: int): int {
    if a == 1 { return 0; }
    if a == -1 { return 1; }
    if b == 1 { return 2; }
    if b == -1 { return 3; }
    if c == 1 { return 4; }
    return 5;
}

fn sortTexels(m: &Model) {
    let gap = m.texelCount / 2;
    while gap > 0 {
        for i in gap..m.texelCount {
            let v = m.texels[i];
            let j = i;
            while j >= gap && m.texels[j - gap] > v {
                m.texels[j] = m.texels[j - gap];
                j -= gap;
            }
            m.texels[j] = v;
        }
        gap = gap / 2;
    }
}

/// Move pixels along with an edit: kind 0 shift `(p, q, r)`, 1 flip across axis `p`, 2 quarter turn
/// about axis `p` (call before the sizes change), 3 keep only what fits a `p x q x r` grid.
pub fn texRemap(m: &Model, kind: int, p: int, q: int, r: int) {
    let n = 0;
    for i in 0..m.texelCount {
        let key = texKeyOf(m.texels[i]);
        let x = texX(key);
        let y = texY(key);
        let z = texZ(key);
        let f = texFace(key);
        let nx = x;
        let ny = y;
        let nz = z;
        let nf = f;
        let keep = true;
        if kind == 0 {
            nx = x + p;
            ny = y + q;
            nz = z + r;
            keep = nx >= 0 && ny >= 0 && nz >= 0 && nx < m.sx && ny < m.sy && nz < m.sz;
        } else if kind == 1 {
            if p == 0 { nx = m.sx - 1 - x; }
            if p == 1 { ny = m.sy - 1 - y; }
            if p == 2 { nz = m.sz - 1 - z; }
            if f / 2 == p { nf = if f % 2 == 0 { f + 1 } else { f - 1 }; }
        } else if kind == 2 {
            let a = faceComp(f, 0);
            let b = faceComp(f, 1);
            let c = faceComp(f, 2);
            if p == 0 { ny = z; nz = m.sy - 1 - y; nf = faceOfVec(a, c, 0 - b); }
            if p == 1 { nx = z; nz = m.sx - 1 - x; nf = faceOfVec(c, b, 0 - a); }
            if p == 2 { nx = y; ny = m.sx - 1 - x; nf = faceOfVec(b, 0 - a, c); }
        } else {
            keep = x < p && y < q && z < r;
        }
        if keep {
            m.texels[n] = texKey(texOverlay(key), nf, nx, ny, nz) * RGB_RANGE + texRgb(m.texels[i]);
            n += 1;
        }
    }
    m.texelCount = n;
    sortTexels(m);
}
