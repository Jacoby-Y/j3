// model: palette lookups, presets, trim.

module voxel_editor.model;

pub fn setColor(m: &Model, i: int, r: int, g: int, b: int) {
    if i < 1 || i > 255 { return; }
    m.pal[i * 3] = u8(r);
    m.pal[i * 3 + 1] = u8(g);
    m.pal[i * 3 + 2] = u8(b);
    if i > m.palLen {
        // A gap stays black until set.
        m.palLen = i;
    }
    touch(m);
}

pub fn nameColor(m: &Model, i: int, name: string) {
    if i < 1 || i > m.palLen { return; }
    m.names[i] = own(m.mem, name);
    touch(m);
}

/// Palette index with exactly this color, or 0.
pub fn findColor(m: &Model, r: int, g: int, b: int): int {
    for i in 1..=m.palLen {
        if color(m, i, 0) == r && color(m, i, 1) == g && color(m, i, 2) == b { return i; }
    }
    return 0;
}

/// Palette index named `name`, or 0.
pub fn findName(m: &Model, name: string): int {
    for i in 1..=m.palLen {
        if m.names[i].len > 0 && same(m.names[i], name) { return i; }
    }
    return 0;
}

/// The index of this color, adding it when the palette lacks it. 0 when the palette is full.
pub fn addColor(m: &Model, r: int, g: int, b: int): int {
    let at = findColor(m, r, g, b);
    if at != 0 { return at; }
    if m.palLen >= 255 { return 0; }
    setColor(m, m.palLen + 1, r, g, b);
    return m.palLen;
}

/// `rrggbb`, `#rrggbb`, `rgb`, or `#rgb`.
pub fn parseHex(s: string, r: &int, g: &int, b: &int): bool {
    let a = 0;
    if s.len > 0 && s[0] == 35 { a = 1; }
    let n = s.len - a;
    if n != 6 && n != 3 { return false; }
    let v = mem6(s, a, n);
    if v < 0 { return false; }
    if n == 6 {
        *r = v / 65536;
        *g = (v / 256) % 256;
        *b = v % 256;
    } else {
        *r = (v / 256) * 17;
        *g = ((v / 16) % 16) * 17;
        *b = (v % 16) * 17;
    }
    return true;
}

fn mem6(s: string, a: int, n: int): int {
    let v = 0;
    for i in 0..n {
        let d = hexValue(s[a + i]);
        if d < 0 { return -1; }
        v = v * 16 + d;
    }
    return v;
}

/// Replace the palette with a built-in one. Voxels keep their indices.
pub fn loadPreset(m: &Model, name: string): bool {
    let hex = "";
    if same(name, "default") {
        hex = "1a1c2c 5d275d b13e53 ef7d57 ffcd75 a7f070 38b764 257179 29366f 3b5dc9 41a6f6 73eff7 f4f4f4 94b0c2 566c86 333c57";
    } else if same(name, "earth") {
        hex = "2b1d14 4a3426 6b4a35 8c6a4a b08d62 d2b48c e8d5b0 3d5a3a 5b7f45 86a35a b5c97a 7a8a8f 55646b 3a4147 a3472f d07a3a";
    } else if same(name, "pastel") {
        hex = "ffb3ba ffdfba ffffba baffc9 bae1ff d5baff ffbaf0 f4f4f4 c9c9d9 9a9ab0 6b6b85 45455c e8c7a9 b5e8d4 f7d6e0 cfd8ff";
    } else if same(name, "gray") {
        hex = "000000 111111 222222 333333 444444 555555 666666 777777 888888 999999 aaaaaa bbbbbb cccccc dddddd eeeeee ffffff";
    } else if same(name, "neon") {
        hex = "0d0221 261447 541388 f1e9da ff2a6d d1f7ff 05d9e8 01012b ff9f1c ffe74c 7ae582 00a896 7209b7 3a0ca3 4cc9f0 f72585";
    } else {
        return false;
    }
    m.palLen = 0;
    let i = 0;
    let slot = 1;
    while i < hex.len {
        let r = 0;
        let g = 0;
        let b = 0;
        if i + 6 <= hex.len && parseHex(sub(hex, i, i + 6), &r, &g, &b) {
            m.names[slot] = "";
            setColor(m, slot, r, g, b);
            slot += 1;
        }
        i += 7;
    }
    return true;
}

fn sub(s: string, a: int, b: int): string {
    return []u8 { ptr: (s.ptr as int + a) as &u8, len: b - a } as string;
}

/// Common color words, so `box ... red` works without defining red first.
pub fn namedColor(name: string, r: &int, g: &int, b: &int): bool {
    let hex = "";
    if same(name, "red") { hex = "e63946"; }
    else if same(name, "green") { hex = "3fb950"; }
    else if same(name, "blue") { hex = "3b82f6"; }
    else if same(name, "yellow") { hex = "ffd23f"; }
    else if same(name, "orange") { hex = "f77f00"; }
    else if same(name, "purple") { hex = "8e44ad"; }
    else if same(name, "pink") { hex = "ff8fab"; }
    else if same(name, "brown") { hex = "7b4b2a"; }
    else if same(name, "white") { hex = "f4f4f4"; }
    else if same(name, "black") { hex = "16181d"; }
    else if same(name, "gray") || same(name, "grey") { hex = "8a8f98"; }
    else if same(name, "cyan") { hex = "2ec4b6"; }
    else if same(name, "tan") { hex = "d2b48c"; }
    else if same(name, "skin") { hex = "e8b894"; }
    else { return false; }
    return parseHex(hex, r, g, b);
}

pub fn presetNames(): string {
    return "default earth pastel gray neon";
}

/// Remove palette entries no voxel uses, renumbering the voxels. Returns how many went.
pub fn trimPalette(m: &Model): int {
    let used = m.work;
    for i in 0..256 { used[i] = 0; }
    for i in 0..m.sx * m.sy * m.sz { used[int(m.cells[i])] = 1; }
    let map = m.work[256..512];
    let next = 1;
    for i in 1..=m.palLen {
        if used[i] != 0 {
            map[i] = next;
            m.pal[next * 3] = m.pal[i * 3];
            m.pal[next * 3 + 1] = m.pal[i * 3 + 1];
            m.pal[next * 3 + 2] = m.pal[i * 3 + 2];
            m.names[next] = m.names[i];
            next += 1;
        } else {
            map[i] = 0;
        }
    }
    let removed = m.palLen - (next - 1);
    for i in 0..m.sx * m.sy * m.sz {
        if m.cells[i] != 0 { m.cells[i] = u8(map[int(m.cells[i])]); }
    }
    for i in next..=m.palLen { m.names[i] = ""; }
    m.palLen = next - 1;
    touch(m);
    return removed;
}
