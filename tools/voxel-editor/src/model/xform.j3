// model: whole-model edits (replace, shift, flip, rotate, resize, crop, copy, merge).

module voxel_editor.model;

/// Every voxel of color `from` becomes `to` (0 deletes them). Returns how many.
pub fn replace(m: &Model, from: int, to: int): int {
    let n = 0;
    for i in 0..m.sx * m.sy * m.sz {
        if int(m.cells[i]) == from {
            m.cells[i] = u8(to);
            if to == 0 { m.part[i] = 0; }
            n += 1;
        }
    }
    touch(m);
    return n;
}

pub fn clear(m: &Model) {
    for i in 0..m.sx * m.sy * m.sz { m.cells[i] = 0; m.part[i] = 0; }
    touch(m);
}

// -------------------------------------------------------------------------------- transforms

/// Slide everything by `(dx, dy, dz)`; what leaves the grid is lost.
pub fn shift(m: &Model, dx: int, dy: int, dz: int) {
    stash(m);
    for i in 0..m.sx * m.sy * m.sz { m.cells[i] = 0; m.part[i] = 0; }
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                let at = voxel.index(x, y, z, m.sx, m.sz);
                if m.tmp[at] != 0 { put(m, x + dx, y + dy, z + dz, int(m.tmp[at]), int(m.ptmp[at])); }
            }
        }
    }
    for i in 1..=m.partCount {
        m.parts[i].px += f32(dx);
        m.parts[i].py += f32(dy);
        m.parts[i].pz += f32(dz);
    }
    texRemap(m, 0, dx, dy, dz);
    touch(m);
}

/// Mirror the whole model across `axis`.
pub fn flip(m: &Model, axis: int) {
    stash(m);
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                let ox = if axis == 0 { m.sx - 1 - x } else { x };
                let oy = if axis == 1 { m.sy - 1 - y } else { y };
                let oz = if axis == 2 { m.sz - 1 - z } else { z };
                m.cells[voxel.index(x, y, z, m.sx, m.sz)] = m.tmp[voxel.index(ox, oy, oz, m.sx, m.sz)];
                m.part[voxel.index(x, y, z, m.sx, m.sz)] = m.ptmp[voxel.index(ox, oy, oz, m.sx, m.sz)];
            }
        }
    }
    for i in 1..=m.partCount {
        if axis == 0 { m.parts[i].px = f32(m.sx) - m.parts[i].px; }
        if axis == 1 { m.parts[i].py = f32(m.sy) - m.parts[i].py; }
        if axis == 2 { m.parts[i].pz = f32(m.sz) - m.parts[i].pz; }
    }
    texRemap(m, 1, axis, 0, 0);
    touch(m);
}

/// Copy the low half over the high half along `axis` (`fromHigh` copies the other way), so the
/// model is symmetric.
pub fn mirror(m: &Model, axis: int, fromHigh: bool) {
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                let ox = if axis == 0 { m.sx - 1 - x } else { x };
                let oy = if axis == 1 { m.sy - 1 - y } else { y };
                let oz = if axis == 2 { m.sz - 1 - z } else { z };
                let here = if axis == 0 { x } else { if axis == 1 { y } else { z } };
                let there = if axis == 0 { ox } else { if axis == 1 { oy } else { oz } };
                // Visit each pair once, from the side that is the source.
                let source = if fromHigh { here > there } else { here < there };
                if source {
                    m.cells[voxel.index(ox, oy, oz, m.sx, m.sz)] = m.cells[voxel.index(x, y, z, m.sx, m.sz)];
                    m.part[voxel.index(ox, oy, oz, m.sx, m.sz)] = m.part[voxel.index(x, y, z, m.sx, m.sz)];
                }
            }
        }
    }
    touch(m);
}

/// Turn the model 90 degrees about `axis`, `turns` times.
pub fn rotate(m: &Model, axis: int, turns: int) {
    let t = ((turns % 4) + 4) % 4;
    for step in 0..t {
        stash(m);
        let nsx = m.sx;
        let nsy = m.sy;
        let nsz = m.sz;
        if axis == 0 { nsy = m.sz; nsz = m.sy; }
        if axis == 1 { nsx = m.sz; nsz = m.sx; }
        if axis == 2 { nsx = m.sy; nsy = m.sx; }
        for y in 0..m.sy {
            for z in 0..m.sz {
                for x in 0..m.sx {
                    let nx = x;
                    let ny = y;
                    let nz = z;
                    if axis == 0 { ny = z; nz = m.sy - 1 - y; }
                    if axis == 1 { nx = z; nz = m.sx - 1 - x; }
                    if axis == 2 { nx = y; ny = m.sx - 1 - x; }
                    m.cells[voxel.index(nx, ny, nz, nsx, nsz)] = m.tmp[voxel.index(x, y, z, m.sx, m.sz)];
                    m.part[voxel.index(nx, ny, nz, nsx, nsz)] = m.ptmp[voxel.index(x, y, z, m.sx, m.sz)];
                }
            }
        }
        for i in 1..=m.partCount {
            let opx = m.parts[i].px;
            let opy = m.parts[i].py;
            let opz = m.parts[i].pz;
            if axis == 0 { m.parts[i].py = opz; m.parts[i].pz = f32(m.sy) - opy; }
            if axis == 1 { m.parts[i].px = opz; m.parts[i].pz = f32(m.sx) - opx; }
            if axis == 2 { m.parts[i].px = opy; m.parts[i].py = f32(m.sx) - opx; }
        }
        texRemap(m, 2, axis, 0, 0);
        m.sx = nsx;
        m.sy = nsy;
        m.sz = nsz;
    }
    touch(m);
}

/// New grid size; voxels keep their coordinates and those outside are lost.
pub fn resize(m: &Model, sx: int, sy: int, sz: int) {
    let nsx = clampSide(sx);
    let nsy = clampSide(sy);
    let nsz = clampSide(sz);
    stash(m);
    let osx = m.sx;
    let osy = m.sy;
    let osz = m.sz;
    for i in 0..nsx * nsy * nsz { m.cells[i] = 0; m.part[i] = 0; }
    for y in 0..lo(osy, nsy) {
        for z in 0..lo(osz, nsz) {
            for x in 0..lo(osx, nsx) {
                m.cells[voxel.index(x, y, z, nsx, nsz)] = m.tmp[voxel.index(x, y, z, osx, osz)];
                m.part[voxel.index(x, y, z, nsx, nsz)] = m.ptmp[voxel.index(x, y, z, osx, osz)];
            }
        }
    }
    m.sx = nsx;
    m.sy = nsy;
    m.sz = nsz;
    texRemap(m, 3, nsx, nsy, nsz);
    touch(m);
}

/// Corners of the box around every voxel; false when the model is empty.
pub fn bounds(m: &Model, lo3: &[3]int, hi3: &[3]int): bool {
    let any = false;
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                if m.cells[voxel.index(x, y, z, m.sx, m.sz)] == 0 { continue; }
                if !any {
                    lo3[0] = x; lo3[1] = y; lo3[2] = z;
                    hi3[0] = x; hi3[1] = y; hi3[2] = z;
                    any = true;
                }
                if x < lo3[0] { lo3[0] = x; }
                if y < lo3[1] { lo3[1] = y; }
                if z < lo3[2] { lo3[2] = z; }
                if x > hi3[0] { hi3[0] = x; }
                if y > hi3[1] { hi3[1] = y; }
                if z > hi3[2] { hi3[2] = z; }
            }
        }
    }
    return any;
}

/// Shrink the grid to the voxels' bounding box (plus `pad` empty voxels around it).
pub fn crop(m: &Model, pad: int): bool {
    let a: [3]int = [0, 0, 0];
    let b: [3]int = [0, 0, 0];
    if !bounds(m, &a, &b) { return false; }
    shift(m, pad - a[0], pad - a[1], pad - a[2]);
    resize(m, b[0] - a[0] + 1 + pad * 2, b[1] - a[1] + 1 + pad * 2, b[2] - a[2] + 1 + pad * 2);
    return true;
}

/// Empty the inside of solid shapes, leaving voxels that touch air.
pub fn hollowAll(m: &Model) {
    stash(m);
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                if m.tmp[voxel.index(x, y, z, m.sx, m.sz)] == 0 { continue; }
                let skin = voxel.get(m.tmp, m.sx, m.sy, m.sz, x - 1, y, z) == 0 || voxel.get(m.tmp, m.sx, m.sy, m.sz, x + 1, y, z) == 0
                    || voxel.get(m.tmp, m.sx, m.sy, m.sz, x, y - 1, z) == 0 || voxel.get(m.tmp, m.sx, m.sy, m.sz, x, y + 1, z) == 0
                    || voxel.get(m.tmp, m.sx, m.sy, m.sz, x, y, z - 1) == 0 || voxel.get(m.tmp, m.sx, m.sy, m.sz, x, y, z + 1) == 0;
                if !skin { m.cells[voxel.index(x, y, z, m.sx, m.sz)] = 0; m.part[voxel.index(x, y, z, m.sx, m.sz)] = 0; }
            }
        }
    }
    touch(m);
}

/// Copy the solid voxels of a box to another place (`dx, dy, dz` away). `move` clears the source.
pub fn copyBox(m: &Model, x0: int, y0: int, z0: int, x1: int, y1: int, z1: int, dx: int, dy: int, dz: int, move: bool) {
    let ax = hi(lo(x0, x1), 0);
    let ay = hi(lo(y0, y1), 0);
    let az = hi(lo(z0, z1), 0);
    let bx = lo(hi(x0, x1), m.sx - 1);
    let by = lo(hi(y0, y1), m.sy - 1);
    let bz = lo(hi(z0, z1), m.sz - 1);
    stash(m);
    for y in ay..=by {
        for z in az..=bz {
            for x in ax..=bx {
                if move && m.tmp[voxel.index(x, y, z, m.sx, m.sz)] != 0 {
                    m.cells[voxel.index(x, y, z, m.sx, m.sz)] = 0;
                    m.part[voxel.index(x, y, z, m.sx, m.sz)] = 0;
                }
            }
        }
    }
    for y in ay..=by {
        for z in az..=bz {
            for x in ax..=bx {
                let at = voxel.index(x, y, z, m.sx, m.sz);
                if m.tmp[at] != 0 { put(m, x + dx, y + dy, z + dz, int(m.tmp[at]), int(m.ptmp[at])); }
            }
        }
    }
    touch(m);
}

/// Stamp `other` into `m` at `(dx, dy, dz)`, adding its colors to the palette. Returns the
/// number of voxels placed.
pub fn merge(m: &Model, other: &Model, dx: int, dy: int, dz: int): int {
    let map = m.work[0..256];
    for i in 0..256 { map[i] = 0; }
    for i in 1..=other.palLen {
        let at = addColor(m, color(other, i, 0), color(other, i, 1), color(other, i, 2));
        map[i] = at;
        if at != 0 && other.names[i].len > 0 && m.names[at].len == 0 && findName(m, other.names[i]) == 0 {
            m.names[at] = own(m.mem, other.names[i]);
        }
    }
    let placed = 0;
    for y in 0..other.sy {
        for z in 0..other.sz {
            for x in 0..other.sx {
                let v = int(other.cells[voxel.index(x, y, z, other.sx, other.sz)]);
                if v == 0 || !inside(m, x + dx, y + dy, z + dz) { continue; }
                one(m, x + dx, y + dy, z + dz, ADD, map[v]);
                placed += 1;
            }
        }
    }
    touch(m);
    return placed;
}
