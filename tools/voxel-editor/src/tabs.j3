// Workspace tabs: several models open at once. `w.m` is the active one; the others wait in `w.tabs`.

module voxel_editor.tabs;

use j3.game;
use j3.game.Key;
use j3.gfx.Orbit;
use j3.math.Vec3;
use j3.io;
use j3.io.{ exists, readFile };
use j3.memory.scratch;
use j3.result.Result;
use j3.text.{ Text, same };
use voxel_editor.edit;
use voxel_editor.edit.{ say, say2 };
use voxel_editor.files;
use voxel_editor.format;
use voxel_editor.hostio;
use voxel_editor.model;
use voxel_editor.model.Model;
use voxel_editor.util.{ cut, endsWith, parseF, parseI, words };
use voxel_editor.world.{ Tab, World };

pub const MAX: int = 8;
/// Where the open tabs are remembered (in the folder the editor started in), one path per line, then `@active`.
const WORKSPACE: string = ".vox-workspace";


/// Make slot 0 hold the model `boot` built.
pub fn init(w: &World) {
    w.tabs[0] = Tab { m: w.m, path: Text.new(w.mem), stamp: 0, cam: w.cam, clip: 0, playT: 0, key: -1 };
    w.tabCount = 1;
    w.tab = 0;
}

/// Copy the live editor state into the active tab's slot.
fn stash(w: &World) {
    let t = &w.tabs[w.tab];
    t.m = w.m;
    t.stamp = w.stamp;
    t.cam = w.cam;
    t.clip = w.clip;
    t.playT = w.playT;
    t.key = w.key;
    t.path.clear();
    t.path.pushStr(w.path.str());
}

pub fn switchTo(w: &World, i: int) {
    if i == w.tab || i < 0 || i >= w.tabCount { return; }
    edit.cancel(w);
    stash(w);
    show(w, i);
    remember(w);
}

fn show(w: &World, i: int) {
    let t = &w.tabs[i];
    w.tab = i;
    w.m = t.m;
    w.stamp = t.stamp;
    w.cam = t.cam;
    w.clip = t.clip;
    w.playT = t.playT;
    w.key = t.key;
    w.path.clear();
    w.path.pushStr(t.path.str());
    w.view.rev = 0; // the mesh belongs to the other model
    w.ovActive = 0;
    w.ovRev = -1;
    w.playing = false;
    w.closeWarned = false;
}

fn indexOf(w: &World, path: string): int {
    for i in 0..w.tabCount {
        let p = if i == w.tab { w.path.str() } else { w.tabs[i].path.str() };
        if same(p, path) { return i; }
    }
    return -1;
}

/// Open `path` in its own tab (or jump to the tab that has it). Empty path: a blank model.
pub fn open(w: &World, path: string) {
    let at = indexOf(w, path);
    if at >= 0 { switchTo(w, at); return; }
    if w.tabCount == MAX { say(w, "All 8 tabs are in use; close one first (Ctrl+W)"); return; }
    edit.cancel(w);
    stash(w);
    let slot = w.tabCount;
    let t = &w.tabs[slot];
    if t.m.cells.len == 0 {
        t.m = model.create(w.mem, 16, 16, 16);
        t.path = Text.new(w.mem);
    }
    w.tabCount += 1;
    show(w, slot);
    w.path.clear();
    w.path.pushStr(if path.len > 0 { path } else { "models/untitled.j3voxel" });
    blank(w);
    if path.len > 0 && exists(files.pathNow(w)) { files.open(w); }
    else { w.m.name = "untitled"; edit.frame(w); }
    remember(w);
}

/// Reset the active model to an empty 16 cube (a reused slot still holds its last model).
fn blank(w: &World) {
    let err = Text.new(scratch(0));
    format.read("size 16 16 16\n", &w.m, &err);
    w.stamp = 0;
}

pub fn close(w: &World) {
    if w.m.dirty && !w.closeWarned {
        w.closeWarned = true;
        say(w, "Unsaved changes in this tab. Close it again to drop them.");
        return;
    }
    edit.cancel(w);
    if w.tabCount == 1 {
        blank(w);
        w.m.name = "untitled";
        w.path.clear();
        w.path.pushStr("models/untitled.j3voxel");
        w.view.rev = 0;
        w.closeWarned = false;
        return;
    }
    // Rotate the closed slot to the end (its memory is reused by the next new tab).
    let gone = w.tabs[w.tab];
    for j in w.tab..w.tabCount - 1 { w.tabs[j] = w.tabs[j + 1]; }
    w.tabs[w.tabCount - 1] = gone;
    w.tabCount -= 1;
    show(w, if w.tab >= w.tabCount { w.tabCount - 1 } else { w.tab });
    remember(w);
}

/// Ctrl+Tab cycles (Shift goes back), Ctrl+W closes. Call while no text field has focus.
pub fn keys(w: &World) {
    if !game.keyDown(Key.Ctrl) { return; }
    if game.keyPressed(Key.Tab) && w.tabCount > 1 && !w.active {
        let step = if game.keyDown(Key.Shift) { w.tabCount - 1 } else { 1 };
        switchTo(w, (w.tab + step) % w.tabCount);
    }
    if game.keyPressed(Key.W) && !w.active { close(w); }
}

const DRAFTS: string = ".vox-drafts/";

fn draftPath(i: int): string {
    let t = Text.new(scratch(0));
    t.pushStr(DRAFTS);
    t.pushInt(i);
    t.pushStr(".j3voxel");
    return t.str();
}

/// Write the workspace file: every tab (path, draft of unsaved edits, camera, clip, playhead) and the window's modes. The
/// next `vox` with no arguments brings it all back. Call it whenever the tabs change and when the window closes.
pub fn remember(w: &World) {
    stash(w);
    let t = Text.new(scratch(0));
    for i in 0..w.tabCount {
        let tab = &w.tabs[i];
        let draft = "-";
        if tab.m.dirty {
            draft = draftPath(i);
            hostio.makeFolders(draft, scratch(0));
            let keep = tab.m;
            let err = Text.new(scratch(0));
            if !format.save(draft, &keep, &err) { draft = "-"; }
        }
        t.pushStr("tab ");
        t.pushStr(tab.path.str());
        t.push(32);
        t.pushStr(draft);
        t.push(32);
        t.pushInt(tab.clip);
        t.push(32);
        t.pushFloat(tab.playT);
        t.push(32);
        t.pushInt(tab.key);
        t.push(32);
        t.pushFloat(tab.cam.yaw);
        t.push(32);
        t.pushFloat(tab.cam.pitch);
        t.push(32);
        t.pushFloat(tab.cam.radius);
        t.push(32);
        t.pushFloat(tab.cam.target.x);
        t.push(32);
        t.pushFloat(tab.cam.target.y);
        t.push(32);
        t.pushFloat(tab.cam.target.z);
        t.push(10);
    }
    t.pushStr("ui ");
    t.pushInt(w.tab);
    t.push(32);
    t.pushInt(w.tool);
    t.push(32);
    t.pushInt(if w.rigTab { 1 } else { 0 });
    t.push(32);
    t.pushInt(if w.ortho { 1 } else { 0 });
    t.push(32);
    t.pushInt(if w.grid { 1 } else { 0 });
    t.push(32);
    t.pushFloat(w.left);
    t.push(32);
    t.pushFloat(w.right);
    t.push(32);
    t.pushFloat(w.tl);
    t.push(10);
    io.writeFile(WORKSPACE, t.bytes[0..t.len()]);
}

fn num(word: string): f32 {
    let v: f32 = 0;
    parseF(word, &v);
    return v;
}

fn whole(word: string): int {
    let v = 0;
    parseI(word, &v);
    return v;
}

/// One `tab` line: open the file (or its unsaved draft) and put the camera and clip back.
fn restoreTab(w: &World, f: []string, first: bool) {
    if first { w.path.clear(); w.path.pushStr(f[1]); files.open(w); }
    else { open(w, f[1]); }
    if f[2][0] != 45 && exists(f[2]) {
        let err = Text.new(scratch(0));
        if format.load(f[2], &w.m, &err) { w.m.dirty = true; }
    }
    w.clip = if whole(f[3]) <= w.m.clipCount { whole(f[3]) } else { 0 };
    w.playT = num(f[4]);
    w.key = whole(f[5]);
    w.cam.yaw = num(f[6]);
    w.cam.pitch = num(f[7]);
    w.cam.radius = num(f[8]);
    w.cam.target = Vec3.xyz(num(f[9]), num(f[10]), num(f[11]));
}

/// Reopen the workspace the last session left. False when there is no workspace file.
pub fn restore(w: &World): bool {
    if !exists(WORKSPACE) { return false; }
    let text = "";
    match readFile(WORKSPACE, scratch(0)) {
        Result.Ok(bytes) { text = bytes as string; }
        Result.Err(_) { return false; }
    }
    let active = 0;
    let opened = 0;
    let a = 0;
    for i in 0..text.len + 1 {
        if i < text.len && text[i] != 10 { continue; }
        let f = words(cut(text, a, i), scratch(0));
        a = i + 1;
        if f.len == 12 && same(f[0], "tab") && opened < MAX && (exists(f[1]) || f[2][0] != 45) {
            restoreTab(w, f, opened == 0);
            opened += 1;
        } else if f.len == 9 && same(f[0], "ui") {
            active = whole(f[1]);
            w.tool = whole(f[2]);
            w.rigTab = whole(f[3]) == 1;
            w.ortho = whole(f[4]) == 1;
            w.grid = whole(f[5]) == 1;
            w.left = num(f[6]);
            w.right = num(f[7]);
            w.tl = num(f[8]);
        }
    }
    if opened == 0 { return false; }
    stash(w);
    switchTo(w, if active < w.tabCount { active } else { 0 });
    return true;
}

/// A command-line argument: a model file, or a folder of them.
pub fn openArg(w: &World, a: string) {
    if endsWith(a, ".j3voxel") { open(w, a); } else { openFolder(w, a); }
}

/// Open every `.j3voxel` in a folder, one tab each.
pub fn openFolder(w: &World, dir: string) {
    let names = hostio.listModels(dir, scratch(0));
    let a = 0;
    for i in 0..names.len + 1 {
        if i < names.len && names[i] != 10 { continue; }
        let line = cut(names, a, i);
        a = i + 1;
        if line.len == 0 { continue; }
        if w.tabCount == 1 && w.m.name.len > 0 && !exists(files.pathNow(w)) && !w.m.dirty {
            w.path.clear();
            w.path.pushStr(line);
            files.open(w);
        } else { open(w, line); }
    }
}

pub fn label(w: &World, i: int): string {
    let m = if i == w.tab { &w.m } else { &w.tabs[i].m };
    let t = Text.new(scratch(0));
    t.pushStr(m.name);
    if m.dirty { t.pushStr(" *"); }
    return t.str();
}
