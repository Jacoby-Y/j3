// cmd: the Args cursor over a command line and its parse helpers.

module voxel_editor.cmd;

/// Words of one command and where we are in them.
struct Args {
    w: []string;
    i: int;
    out: &Text;
    ok: bool;
    mode: int;
    hollow: bool;
}

fn problem(a: &Args, msg: string) {
    if !a.ok { return; }
    a.ok = false;
    a.out.pushStr("error: ");
    a.out.pushStr(msg);
    a.out.push(10);
}

fn more(a: &Args): bool {
    return a.i < a.w.len;
}

fn problem3(a: &Args, p1: string, p2: string, p3: string) {
    if !a.ok { return; }
    let t = Text.new(a.out.arena);
    t.pushStr(p1);
    t.pushStr(p2);
    t.pushStr(p3);
    problem(a, t.str());
}

fn nextInt(a: &Args, what: string): int {
    let v = 0;
    if a.i >= a.w.len {
        problem3(a, "missing ", what, " (`help` shows the arguments)");
        return 0;
    }
    if !parseI(a.w[a.i], &v) { problem3(a, what, " must be a whole number, got ", a.w[a.i]); }
    a.i += 1;
    return v;
}

fn nextFloat(a: &Args, what: string): f32 {
    let v: f32 = 0;
    if a.i >= a.w.len {
        problem3(a, "missing ", what, "");
        return 0;
    }
    if !parseF(a.w[a.i], &v) { problem3(a, what, " must be a number, got ", a.w[a.i]); }
    a.i += 1;
    return v;
}

fn nextWord(a: &Args, what: string): string {
    if a.i >= a.w.len {
        problem3(a, "missing ", what, "");
        return "";
    }
    a.i += 1;
    return a.w[a.i - 1];
}

fn axisOf(a: &Args, s: string): int {
    if same(s, "x") { return 0; }
    if same(s, "y") { return 1; }
    if same(s, "z") { return 2; }
    problem(a, "an axis is x, y, or z");
    return 0;
}

/// A color argument: index, name, `air`, or `#rrggbb` (added to the palette when new).
fn colorOf(m: &Model, a: &Args, s: string): int {
    let v = 0;
    if same(s, "air") { return 0; }
    if parseI(s, &v) {
        if v < 0 || v > m.palLen { problem3(a, "the palette has no color ", s, "; `color INDEX #rrggbb` defines one"); }
        return v;
    }
    let r = 0;
    let g = 0;
    let b = 0;
    if s.len > 0 && s[0] == 35 && model.parseHex(s, &r, &g, &b) {
        let at = model.addColor(m, r, g, b);
        if at == 0 { problem(a, "the palette is full (255 colors)"); }
        return at;
    }
    let named = model.findName(m, s);
    if named != 0 { return named; }
    if model.namedColor(s, &r, &g, &b) {
        named = model.addColor(m, r, g, b);
        if named == 0 { problem(a, "the palette is full (255 colors)"); }
        else if model.findName(m, s) == 0 { model.nameColor(m, named, s); }
        return named;
    }
    problem3(a, "unknown color ", s, ": use a palette index, a name from `palette`, or #rrggbb");
    return 0;
}

/// Take `hollow`, `erase`, and `paint` words off the end so the positional ones stay.
fn flags(a: &Args) {
    a.mode = model.ADD;
    a.hollow = false;
    let n = a.w.len;
    while n > a.i {
        let s = a.w[n - 1];
        if same(s, "hollow") { a.hollow = true; }
        else if same(s, "erase") { a.mode = model.ERASE; }
        else if same(s, "paint") { a.mode = model.PAINT; }
        else { break; }
        n -= 1;
    }
    a.w = a.w[0..n];
}

fn needColor(m: &Model, a: &Args): int {
    if a.mode == model.ERASE { return 0; }
    return colorOf(m, a, nextWord(a, "a color"));
}

fn extra(a: &Args) {
    if a.ok && a.i < a.w.len { problem3(a, "unexpected ", a.w[a.i], " (`help` shows the arguments)"); }
}

/// Read `count` whole numbers into `v`; `names` says what they are in the error.
fn ints(a: &Args, v: &[10]int, count: int, names: string) {
    for i in 0..count {
        if a.i >= a.w.len {
            problem3(a, "missing numbers: wants ", names, "");
            return;
        }
        let one = 0;
        if !parseI(a.w[a.i], &one) {
            problem3(a, "expected whole numbers for ", names, "");
            return;
        }
        v[i] = one;
        a.i += 1;
    }
}
