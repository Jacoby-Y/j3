// cmd: list, info and dump (read-only views of the model).

module voxel_editor.cmd;

fn list(m: &Model, out: &Text) {
    out.pushStr("palette (");
    out.pushInt(m.palLen);
    out.pushStr(" colors):\n");
    for i in 1..=m.palLen {
        out.pushStr("  ");
        out.pushInt(i);
        out.pushStr("  #");
        pushHex2(out, model.color(m, i, 0));
        pushHex2(out, model.color(m, i, 1));
        pushHex2(out, model.color(m, i, 2));
        if m.names[i].len > 0 {
            out.push(32);
            out.pushStr(m.names[i]);
        }
        out.push(10);
    }
}

fn info(m: &Model, out: &Text) {
    out.pushStr("name ");
    out.pushStr(m.name);
    out.pushStr("  size ");
    out.pushInt(m.sx);
    out.push(32);
    out.pushInt(m.sy);
    out.push(32);
    out.pushInt(m.sz);
    out.pushStr("  voxels ");
    out.pushInt(model.count(m));
    out.pushStr("  colors ");
    out.pushInt(m.palLen);
    if m.symX || m.symY || m.symZ {
        out.pushStr("  sym");
        if m.symX { out.pushStr(" x"); }
        if m.symY { out.pushStr(" y"); }
        if m.symZ { out.pushStr(" z"); }
    }
    out.push(10);
    let lo: [3]int = [0, 0, 0];
    let hi: [3]int = [0, 0, 0];
    if model.bounds(m, &lo, &hi) {
        out.pushStr("bounds x ");
        out.pushInt(lo[0]);
        out.pushStr("..");
        out.pushInt(hi[0]);
        out.pushStr("  y ");
        out.pushInt(lo[1]);
        out.pushStr("..");
        out.pushInt(hi[1]);
        out.pushStr("  z ");
        out.pushInt(lo[2]);
        out.pushStr("..");
        out.pushInt(hi[2]);
        out.push(10);
    } else {
        out.pushStr("empty\n");
    }
    if m.partCount > 0 {
        out.pushStr("parts ");
        out.pushInt(m.partCount);
        out.pushStr("  overlays ");
        out.pushInt(m.overlayCount);
        out.pushStr("  clips ");
        out.pushInt(m.clipCount);
        out.pushStr("  poses ");
        out.pushInt(m.poseCount);
        out.pushStr("  active ");
        out.pushStr(if m.active == 0 { "none" } else { m.parts[m.active].name });
        out.pushStr("  (`rig tree` lists them)\n");
    }
    // Voxels per color.
    let counts = m.work[0..256];
    for i in 0..256 { counts[i] = 0; }
    for i in 0..m.sx * m.sy * m.sz { counts[int(m.cells[i])] += 1; }
    let unused = 0;
    for i in 1..=m.palLen {
        if counts[i] == 0 {
            unused += 1;
            continue;
        }
        out.pushStr("  ");
        out.push(glyph(i));
        out.pushStr(" ");
        out.pushInt(i);
        out.pushStr("  #");
        pushHex2(out, model.color(m, i, 0));
        pushHex2(out, model.color(m, i, 1));
        pushHex2(out, model.color(m, i, 2));
        if m.names[i].len > 0 {
            out.push(32);
            out.pushStr(m.names[i]);
        }
        out.pushStr("  x");
        out.pushInt(counts[i]);
        out.push(10);
    }
    if unused > 0 {
        out.pushStr("  (");
        out.pushInt(unused);
        out.pushStr(" palette colors unused; `palette` lists them)\n");
    }
}

/// Layers as characters: `.` is air, 1-9 a-z A-Z the palette index (`#` above 61).
/// y layers print top first, rows are z (front, +z, at the bottom), columns are x.
fn dump(m: &Model, axis: int, only: int, out: &Text) {
    let n = if axis == 0 { m.sx } else { if axis == 1 { m.sy } else { m.sz } };
    let letters = ["x", "y", "z"];
    let first = 0;
    let last = n - 1;
    if only >= 0 { first = only; last = only; }
    if only >= n {
        out.pushStr("error: layer ");
        out.pushInt(only);
        out.pushStr(" is past the model (0..");
        out.pushInt(n - 1);
        out.pushStr(")\n");
        return;
    }
    let k = last;
    while k >= first {
        out.pushStr(letters[axis]);
        out.push(61);
        out.pushInt(k);
        if axis == 1 { out.pushStr("  (columns x, rows z)"); }
        else if axis == 0 { out.pushStr("  (columns z, rows y, top first)"); }
        else { out.pushStr("  (columns x, rows y, top first)"); }
        out.push(10);
        if axis == 1 {
            for z in 0..m.sz {
                for x in 0..m.sx { out.push(glyph(model.get(m, x, k, z))); }
                out.push(10);
            }
        } else {
            let row = m.sy - 1;
            while row >= 0 {
                if axis == 0 {
                    for z in 0..m.sz { out.push(glyph(model.get(m, k, row, z))); }
                } else {
                    for x in 0..m.sx { out.push(glyph(model.get(m, x, row, k))); }
                }
                out.push(10);
                row -= 1;
            }
        }
        k -= 1;
    }
}
