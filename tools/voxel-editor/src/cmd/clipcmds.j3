// cmd: clip command.

module voxel_editor.cmd;

/// A clip word's pose name: the text before an `@`.
fn cutAt(word: string): string {
    let at = word.len;
    for i in 0..word.len { if word[i] == 64 { at = i; } }
    return cut(word, 0, at);
}

/// `clip ...` commands.
fn clipCmd(m: &Model, a: &Args, out: &Text) {
    let sub = nextWord(a, "new, rm, list, or at");
    let id = 0;
    let name = "";
    let secs: f32 = 0;
    let word = "";
    let slot = 0;
    if !a.ok { return; }
    if same(sub, "new") {
        name = nextWord(a, "a clip name");
        secs = nextFloat(a, "SECONDS");
        word = nextWord(a, "loop or once");
        if a.ok && secs <= 0 { problem(a, "SECONDS must be above 0"); }
        if a.ok && !same(word, "loop") && !same(word, "once") { problem(a, "a clip is `loop` or `once`"); }
        if a.ok { id = rig.addClip(m, name, secs, same(word, "loop")); }
        if a.ok && id == 0 { problem(a, "a model holds 8 clips at most"); }
        while a.ok && more(a) {
            word = nextWord(a, "a pose name");
            if a.ok && rig.findPose(m, cutAt(word)) == 0 { problem3(a, "no pose named ", cutAt(word), "; save it with `pose save NAME` first"); }
            if a.ok && !rig.clipKeyWord(m, id, word) { problem(a, "a clip holds 16 poses at most, and a time is POSE@SECONDS"); }
        }
        if a.ok { rig.settleClip(m, id); }
    } else if same(sub, "rm") {
        name = nextWord(a, "a clip name");
        extra(a);
        if a.ok { id = rig.findClip(m, name); }
        if a.ok && id == 0 { problem3(a, "no clip named ", name, "; `clip list` lists them"); }
        if a.ok { rig.removeClip(m, id); }
    } else if same(sub, "list") {
        extra(a);
        if a.ok {
            if m.clipCount == 0 { out.pushStr("no clips\n"); }
            for i in 1..=m.clipCount {
                out.pushStr("  ");
                out.pushStr(m.clips[i].name);
                out.push(32);
                out.pushFloat(m.clips[i].seconds);
                out.pushStr(if m.clips[i].loop { "s loop:" } else { "s once:" });
                for j in 0..m.clips[i].count {
                    out.push(32);
                    out.pushStr(m.clips[i].keys[j]);
                    out.push(64);
                    out.pushFloat(m.clips[i].times[j]);
                }
                out.push(10);
            }
        }
    } else if same(sub, "at") {
        name = nextWord(a, "a clip name");
        secs = nextFloat(a, "T");
        extra(a);
        if a.ok { id = rig.findClip(m, name); }
        if a.ok && id == 0 { problem3(a, "no clip named ", name, "; `clip list` lists them"); }
        if a.ok && !rig.sampleClip(m, id, secs) { problem(a, "that clip names a pose that no longer exists"); }
    } else {
        problem3(a, "unknown clip command ", sub, "; `help` lists them");
    }
}
