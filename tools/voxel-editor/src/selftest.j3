// `vox selftest`: checks model edits, the file format, and picking. Prints `ok` or what failed.

module voxel_editor.selftest;

use j3.io.printLn;
use j3.math.Vec3;
use j3.memory.{ Arena, scratch };
use j3.text.{ Text, same };
use voxel_editor.cmd;
use voxel_editor.format;
use voxel_editor.model;
use j3.gfx.voxel;
use voxel_editor.model.Model;
use voxel_editor.pick;
use voxel_editor.overlay;
use voxel_editor.overlaypng;
use j3.gfx.canvas.loadPng;
use voxel_editor.rig;
use voxel_editor.ik;

fn run(m: &Model, line: string, bad: &int) {
    let out = Text.new(m.mem);
    if !cmd.runAll(m, line, &out) {
        printLn(out.str());
        *bad += 1;
    }
}

/// A command that must be refused.
fn refuses(m: &Model, line: string, bad: &int) {
    let out = Text.new(m.mem);
    if cmd.runAll(m, line, &out) {
        printLn(line);
        *bad += 1;
    }
}

fn tenths(v: f32): int {
    if v < 0 { return 0 - int(0 - v * 10 + 0.5); }
    return int(v * 10 + 0.5);
}

fn expect(what: string, got: int, want: int, bad: &int) {
    if got != want {
        let t = Text.new(scratchArena());
        t.pushStr("FAIL ");
        t.pushStr(what);
        t.pushStr(": got ");
        t.pushInt(got);
        t.pushStr(", wanted ");
        t.pushInt(want);
        printLn(t.str());
        *bad += 1;
    }
}

fn scratchArena(): &Arena {
    return scratch(0);
}

/// A shoulder, an elbow hinge and a wrist, posed, then reached for from rest: the wrist must land where it was.
fn reachCheck(mem: &Arena, bad: &int) {
    let a = model.create(mem, 8, 16, 8);
    run(&a, "part new Torso pivot 4 14 4; part new Upper parent Torso pivot 4 12 4; part new Lower parent Upper pivot 4 7 4; part new Hand parent Lower pivot 4 3 5", bad);
    run(&a, "part limit Upper x -180 90; part limit Lower x -150 0; part limit Lower y 0 0; part limit Lower z 0 0", bad);
    let up = rig.find(&a, "Upper");
    let low = rig.find(&a, "Lower");
    let hand = rig.find(&a, "Hand");
    expect("hinge", if ik.shoulder(&a, hand) == up { 1 } else { 0 }, 1, bad);
    rig.setPose(&a, up, -50, 20, 0);
    rig.setPose(&a, low, -70, 0, 0);
    let goal = rig.pivotWorld(&a, 0, hand);
    rig.resetPose(&a);
    ik.reach(&a, hand, goal);
    let got = rig.pivotWorld(&a, 0, hand);
    expect("reach lands", tenths((got - goal).length()), 0, bad);
    ik.reach(&a, hand, Vec3.xyz(40, 40, 40));
    expect("far reach keeps the hinge", if inside(a.poses[low * 3], -150, 0) { 1 } else { 0 }, 1, bad);
}

/// Clip keys sit at their own times: a pose at its key, the middle of a gap halfway, and the loop's gap back to the first key.
fn clipCheck(mem: &Arena, bad: &int) {
    let k = model.create(mem, 4, 4, 4);
    run(&k, "part new P pivot 2 2 2; pose set P 0 0 0; pose save a; pose set P 90 0 0; pose save b", bad);
    run(&k, "clip new c 1.0 loop a@0 b@0.25", bad);
    let p = rig.find(&k, "P");
    rig.sampleClip(&k, 1, 0.25);
    expect("key pose", tenths(k.poses[p * 3]), 900, bad);
    rig.sampleClip(&k, 1, 0.625);
    expect("loop gap halfway", tenths(k.poses[p * 3]), 450, bad);
    rig.sampleClip(&k, 1, 0.125);
    expect("first gap halfway", tenths(k.poses[p * 3]), 450, bad);
    run(&k, "clip new e 2.0 once a b", bad);
    expect("even spread", tenths(k.clips[2].times[1]), 20, bad);
    let err = Text.new(mem);
    format.save("/tmp/voxel_editor_selftest_clip.j3voxel", &k, &err);
    let back = model.create(mem, 4, 4, 4);
    format.load("/tmp/voxel_editor_selftest_clip.j3voxel", &back, &err);
    expect("times survive a save", tenths(back.clips[1].times[1]), 3, bad);
}

fn inside(v: f32, lo: f32, hi: f32): bool {
    return v >= lo - 0.01 && v <= hi + 0.01;
}

pub fn selftest(): int {
    let mem = Arena.create(160 * 1024 * 1024);
    let bad = 0;
    let m = model.create(&mem, 8, 8, 8);
    run(&m, "box 0 0 0 3 3 3 1", &bad);
    expect("box count", model.count(&m), 64, &bad);
    run(&m, "box 0 0 0 3 3 3 2 hollow paint", &bad);
    expect("paint keeps count", model.count(&m), 64, &bad);
    expect("skin painted", model.get(&m, 0, 0, 0), 2, &bad);
    expect("core kept", model.get(&m, 1, 1, 1), 1, &bad);
    run(&m, "hollow", &bad);
    expect("hollow count", model.count(&m), 56, &bad);
    run(&m, "undo", &bad);
    expect("undo restores", model.count(&m), 64, &bad);
    run(&m, "redo", &bad);
    expect("redo again", model.count(&m), 56, &bad);
    run(&m, "clear; box 0 0 0 1 0 0 1; box 0 0 0 0 0 0 2; undo", &bad);
    expect("recolor undo", model.get(&m, 0, 0, 0), 1, &bad);
    run(&m, "redo", &bad);
    expect("recolor redo", model.get(&m, 0, 0, 0), 2, &bad);
    run(&m, "clear; sphere 4 4 4 2 3", &bad);
    expect("sphere r2 count", model.count(&m), 81, &bad);
    run(&m, "clear; sym x; set 1 1 1 5", &bad);
    expect("mirrored set", model.count(&m), 2, &bad);
    expect("mirror cell", model.get(&m, 6, 1, 1), 5, &bad);
    run(&m, "sym off; clear; box 0 0 0 1 1 1 4; rotate y; size 8 8 8", &bad);
    expect("rotate keeps count", model.count(&m), 8, &bad);
    run(&m, "clear; box 0 0 0 2 0 0 3; fill 0 0 0 6", &bad);
    expect("fill recolors", model.get(&m, 2, 0, 0), 6, &bad);
    run(&m, "clear; box 1 1 1 2 2 2 3; crop; shift 2 0 0", &bad);
    expect("crop size", m.sx, 2, &bad);
    run(&m, "clear; size 8 8 8; line 0 0 0 7 0 0 3", &bad);
    expect("line count", model.count(&m), 8, &bad);
    // File round trip.
    run(&m, "clear; size 5 6 7; color 9 #112233 teal; box 0 0 0 4 0 0 9; set 2 3 4 2", &bad);
    let text = Text.new(&mem);
    format.write(&m, &text);
    let m2 = model.create(&mem, 1, 1, 1);
    let err = Text.new(&mem);
    if !format.read(text.str(), &m2, &err) {
        printLn(err.str());
        bad += 1;
    }
    expect("roundtrip count", model.count(&m2), 6, &bad);
    expect("roundtrip size", m2.sz, 7, &bad);
    expect("roundtrip voxel", model.get(&m2, 2, 3, 4), 2, &bad);
    expect("roundtrip palette", model.findName(&m2, "teal"), 9, &bad);
    // Picking: straight down onto the floor, onto a voxel's top, and from the side.
    let n = model.create(&mem, 8, 8, 8);
    let p0 = pick.cast(&n, Vec3.xyz(3.5, 20, 3.5), Vec3.xyz(0, -1, 0));
    expect("floor hit", if p0.ok && !p0.solid && p0.px == 3 && p0.py == 0 && p0.pz == 3 { 1 } else { 0 }, 1, &bad);
    run(&n, "set 3 0 3 1", &bad);
    let p1 = pick.cast(&n, Vec3.xyz(3.5, 20, 3.5), Vec3.xyz(0, -1, 0));
    expect("top hit", if p1.solid && p1.x == 3 && p1.axis == 1 && p1.sign == 1 && p1.py == 1 { 1 } else { 0 }, 1, &bad);
    let p2 = pick.cast(&n, Vec3.xyz(-5, 0.5, 3.5), Vec3.xyz(1, 0, 0));
    expect("side hit", if p2.solid && p2.x == 3 && p2.axis == 0 && p2.sign == -1 && p2.px == 2 { 1 } else { 0 }, 1, &bad);
    let p3 = pick.cast(&n, Vec3.xyz(20, 4, 20), Vec3.xyz(0, 1, 0));
    expect("miss", if p3.ok { 1 } else { 0 }, 0, &bad);
    // Rigging: parts, joints, undo, the file, and a humanoid split.
    let r = model.create(&mem, 8, 10, 4);
    run(&r, "part new Body; box 0 0 0 3 4 3 1; part new Arm parent Body; box 4 0 0 5 4 3 2; part pivot-auto Arm", &bad);
    expect("part count", r.partCount, 2, &bad);
    expect("body voxels", rig.voxels(&r, 1), 80, &bad);
    expect("arm voxels", rig.voxels(&r, 2), 40, &bad);
    expect("arm parent", r.parts[2].parent, 1, &bad);
    expect("joint x", tenths(r.parts[2].px), 40, &bad);
    expect("joint y", tenths(r.parts[2].py), 25, &bad);
    expect("joint z", tenths(r.parts[2].pz), 20, &bad);
    run(&r, "undo", &bad);
    expect("pivot undo", tenths(r.parts[2].px), 0, &bad);
    run(&r, "redo; shift 1 0 0", &bad);
    expect("shift moves joint", tenths(r.parts[2].px), 50, &bad);
    expect("shift keeps part", int(r.part[voxel.index(5, 0, 0, r.sx, r.sz)]), 2, &bad);
    refuses(&r, "part parent Body Arm", &bad);
    refuses(&r, "part new Body", &bad);
    refuses(&r, "part assign Nope rest", &bad);
    run(&r, "rig check; pose set Arm 0 0 -90; pose save wave; pose reset; part limit Arm x -10 20", &bad);
    let rt = Text.new(&mem);
    format.write(&r, &rt);
    let r2 = model.create(&mem, 1, 1, 1);
    if !format.read(rt.str(), &r2, &err) {
        printLn(err.str());
        bad += 1;
    }
    expect("rig roundtrip parts", r2.partCount, 2, &bad);
    expect("rig roundtrip parent", r2.parts[2].parent, 1, &bad);
    expect("rig roundtrip layer", rig.voxels(&r2, 2), 40, &bad);
    expect("rig roundtrip joint", tenths(r2.parts[2].px), 50, &bad);
    expect("rig roundtrip limit", tenths(r2.parts[2].lx1), 200, &bad);
    expect("rig roundtrip pose count", r2.poseCount, 1, &bad);
    expect("rig roundtrip pose", tenths(r2.poses[1 * model.POSE + 2 * 3 + 2]), -900, &bad);
    run(&r, "part rm Body", &bad);
    expect("rm parts", r.partCount, 1, &bad);
    expect("rm reparent", r.parts[1].parent, 0, &bad);
    expect("rm unassigns", rig.voxels(&r, 0), 80, &bad);
    expect("rm shifts ids", int(r.part[voxel.index(5, 0, 0, r.sx, r.sz)]), 1, &bad);
    // Posing: the arm turned 90 degrees about z around its joint (4, 2.5, 2).
    run(&r, "undo", &bad);
    let pr = model.create(&mem, 8, 10, 4);
    run(&pr, "part new Body; box 0 0 0 3 4 3 1; part new Arm parent Body; box 4 0 0 5 4 3 2; part pivot-auto Arm; pose set Arm 0 0 90", &bad);
    let moved = rig.worldMatrix(&pr, 0, 2, 0).transformPoint(Vec3.xyz(5, 2.5, 2));
    expect("posed x", tenths(moved.x), 40, &bad);
    expect("posed y", tenths(moved.y), 35, &bad);
    expect("posed z", tenths(moved.z), 20, &bad);
    let still = rig.worldMatrix(&pr, 0, 1, 0).transformPoint(Vec3.xyz(1, 1, 1));
    expect("parent unmoved", tenths(still.x), 10, &bad);
    refuses(&pr, "part limit Arm z 0 45; pose set Arm 0 0 90", &bad);
    // Clips: two poses blended, and the loop wrapping back.
    run(&pr, "part limit Arm z -180 180; pose reset; pose save rest; pose set Arm 0 0 90; pose save up", &bad);
    run(&pr, "clip new wave 2 loop rest up; clip at wave 0.5", &bad);
    expect("clip halfway", tenths(pr.poses[2 * 3 + 2]), 450, &bad);
    run(&pr, "clip at wave 1.5", &bad);
    expect("clip loops back", tenths(pr.poses[2 * 3 + 2]), 450, &bad);
    run(&pr, "clip at wave 1", &bad);
    expect("clip at second key", tenths(pr.poses[2 * 3 + 2]), 900, &bad);
    run(&pr, "clip new once1 1 once rest up; clip at once1 5", &bad);
    expect("once holds the end", tenths(pr.poses[2 * 3 + 2]), 900, &bad);
    refuses(&pr, "clip new bad 1 loop nosuchpose", &bad);
    let ct = Text.new(&mem);
    format.write(&pr, &ct);
    let pr2 = model.create(&mem, 1, 1, 1);
    if !format.read(ct.str(), &pr2, &err) {
        printLn(err.str());
        bad += 1;
    }
    expect("clip roundtrip", pr2.clipCount, 2, &bad);
    expect("clip keys roundtrip", pr2.clips[1].count, 2, &bad);
    // Overlays: a one-voxel shell around a 2x2x2 part.
    let ov = model.create(&mem, 8, 8, 8);
    run(&ov, "part new P; box 3 3 3 4 4 4 1; overlay new o P grow 1", &bad);
    let ovCells = mem.alloc::<u8>(512);
    let nc = 0;
    let nf = 0;
    let np = 0;
    let ns = 0;
    expect("shell state", overlay.cells(&ov, 1, ovCells), 0, &bad);
    overlay.counts(&ov, 1, ovCells, &nc, &nf, &np, &ns);
    expect("shell cells", nc, 56, &bad);
    expect("shell faces", nf, 96, &bad);
    run(&ov, "overlay box o 0 0 0 7 7 7 all #ff0000", &bad);
    expect("painted all", ov.texelCount, 96, &bad);
    run(&ov, "undo", &bad);
    expect("undo unpaints", ov.texelCount, 0, &bad);
    run(&ov, "redo; overlay clear o; overlay paint o 5 3 3 px #ff0000; overlay paint o 2 3 3 nx #00ff00", &bad);
    expect("two pixels", ov.texelCount, 2, &bad);
    refuses(&ov, "overlay paint o 3 3 3 px red", &bad);
    refuses(&ov, "overlay paint o 4 3 3 px red", &bad);
    refuses(&ov, "overlay new bad P grow 9", &bad);
    refuses(&ov, "overlay new wide P grow 4", &bad);
    run(&ov, "flip x", &bad);
    expect("flip moves the pixel", model.texGet(&ov, model.texKey(1, 1, 2, 3, 3)), 16711680, &bad);
    expect("flip swaps the face", model.texGet(&ov, model.texKey(1, 0, 5, 3, 3)), 65280, &bad);
    run(&ov, "shift 1 0 0", &bad);
    expect("shift moves the pixel", model.texGet(&ov, model.texKey(1, 1, 3, 3, 3)), 16711680, &bad);
    run(&ov, "shift -1 0 0", &bad);
    // A neighbor's voxel takes a shell cell, strands the pixel on it, and prune drops it.
    run(&ov, "part new Q; box 2 3 3 2 3 3 2", &bad);
    overlay.cells(&ov, 1, ovCells);
    overlay.counts(&ov, 1, ovCells, &nc, &nf, &np, &ns);
    expect("carved cells", nc, 55, &bad);
    expect("stranded pixel", ns, 1, &bad);
    run(&ov, "overlay prune o", &bad);
    expect("pruned", ov.texelCount, 1, &bad);
    let ot = Text.new(&mem);
    format.write(&ov, &ot);
    let ov2 = model.create(&mem, 1, 1, 1);
    if !format.read(ot.str(), &ov2, &err) {
        printLn(err.str());
        bad += 1;
    }
    expect("overlay roundtrip", ov2.overlayCount, 1, &bad);
    expect("overlay pixel roundtrip", ov2.texelCount, 1, &bad);
    expect("overlay grow roundtrip", ov2.overlays[1].grow, 1, &bad);
    // PNG net: a 4x4x4 shell is 16 x 8; the front panel starts at (4, 4) and its first pixel is x low, y high.
    run(&ov, "undo; overlay clear o; overlay box o 0 0 0 7 7 7 all #102030; overlay paint o 2 5 5 pz #0000ff", &bad);
    let pngPath = "/tmp/voxel_editor_selftest_overlay.png";
    run(&ov, "overlay export o /tmp/voxel_editor_selftest_overlay.png", &bad);
    let shot = loadPng(pngPath, &mem);
    expect("net width", int(shot.w), 16, &bad);
    expect("net height", int(shot.h), 8, &bad);
    expect("front pixel b", int(shot.pixels[(4 * 16 + 4) * 4 + 2]), 255, &bad);
    expect("front pixel a", int(shot.pixels[(4 * 16 + 4) * 4 + 3]), 255, &bad);
    expect("other pixel", int(shot.pixels[(4 * 16 + 5) * 4 + 2]), 48, &bad);
    let before = ov.texelCount;
    run(&ov, "overlay clear o; overlay import o /tmp/voxel_editor_selftest_overlay.png", &bad);
    expect("png round trip", ov.texelCount, before, &bad);
    expect("png keeps the blue", model.texGet(&ov, model.texKey(1, 4, 2, 5, 5)), 255, &bad);
    refuses(&ov, "overlay import o /tmp/voxel_editor_no_such_file.png", &bad);
    run(&ov, "overlay grow o 2", &bad);
    expect("grow clears", ov.texelCount, 0, &bad);
    run(&ov, "overlay hide o; part rm P", &bad);
    expect("part rm drops overlay", ov.overlayCount, 0, &bad);
    let h = model.create(&mem, 12, 20, 5);
    run(&h, "box 3 0 1 4 9 3 1; box 7 0 1 8 9 3 1; box 3 10 1 8 15 3 2; box 1 10 1 2 15 3 3; box 9 10 1 10 15 3 3; box 4 16 1 7 19 3 4", &bad);
    run(&h, "rig humanoid; rig check", &bad);
    expect("humanoid parts", h.partCount, 11, &bad);
    expect("humanoid head", rig.voxels(&h, rig.find(&h, "Head")), 48, &bad);
    expect("humanoid none loose", rig.voxels(&h, 0), 0, &bad);
    expect("humanoid arm parent", h.parts[rig.find(&h, "UpperArm.L")].parent, rig.find(&h, "Torso"), &bad);
    expect("humanoid shin parent", h.parts[rig.find(&h, "LowerLeg.R")].parent, rig.find(&h, "UpperLeg.R"), &bad);
    reachCheck(&mem, &bad);
    clipCheck(&mem, &bad);
    if bad == 0 { printLn("ok"); }
    return if bad == 0 { 0 } else { 1 };
}
