// The side panels: tools, view, mirror, the model file, and the palette dashboard.

module voxel_editor.panels;

use j3.game;
use j3.game.{ Mouse, Color, rgb, rgba };
use j3.math.Vec2;
use j3.memory.scratch;
use j3.text.Text;
use j3.ui.{ Theme, Ui, typing };
use voxel_editor.cmd;
use voxel_editor.edit.{ frame, look, say, say2 };
use voxel_editor.files;
use voxel_editor.model;
use voxel_editor.util.{ cut, pushHex2 };
use voxel_editor.world;
use voxel_editor.world.{ BOTTOM, BOX, CYLINDER, FILL, LEFT, LINE, PENCIL, PICKER, RIGHT, SPHERE, TOP, World };

pub fn theme(): Theme {
    return Theme {
        text: rgb(222, 226, 234),
        button: rgb(52, 56, 66),
        buttonHot: rgb(68, 74, 88),
        buttonDown: rgb(40, 43, 51),
        panel: rgb(34, 37, 44),
        edge: rgb(60, 64, 76),
        accent: rgb(72, 128, 220),
    };
}

pub fn fill(x: f32, y: f32, wide: f32, tall: f32, c: Color) {
    game.setColor(c);
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: wide, y: tall });
}

fn outline(x: f32, y: f32, wide: f32, tall: f32, c: Color) {
    fill(x, y, wide, 2, c);
    fill(x, y + tall - 2, wide, 2, c);
    fill(x, y, 2, tall, c);
    fill(x + wide - 2, y, 2, tall, c);
}

/// A button drawn in the accent color while `on`.
fn toolButton(ui: &Ui, msg: string, on: bool): bool {
    let keep = ui.theme.button;
    if on { ui.theme.button = ui.theme.accent; }
    let hit = ui.button(msg);
    ui.theme.button = keep;
    return hit;
}

fn maybeButton(ui: &Ui, msg: string, on: bool): bool {
    if on { return ui.button(msg); }
    ui.buttonOff(msg);
    return false;
}

fn section(ui: &Ui, msg: string) {
    ui.gap(6);
    let keep = ui.theme.text;
    ui.theme.text = rgb(140, 170, 230);
    ui.labelBold(msg);
    ui.theme.text = keep;
}

fn caption(ui: &Ui, msg: string) {
    let keep = ui.theme.text;
    ui.theme.text = rgb(150, 156, 170);
    ui.label(msg);
    ui.theme.text = keep;
}

pub fn leftPanel(ui: &Ui, w: &World) {
    let win = game.windowSize();
    fill(0, TOP, LEFT, win.y - TOP - BOTTOM, rgb(34, 37, 44));
    ui.x = 10;
    ui.y = TOP + 4;
    ui.w = LEFT - 20;
    ui.h = 26;
    ui.space = 3;
    section(ui, "Tool");
    if toolButton(ui, "Pencil   B", w.tool == PENCIL) { w.tool = PENCIL; }
    if toolButton(ui, "Box   U", w.tool == BOX) { w.tool = BOX; }
    if toolButton(ui, "Sphere   O", w.tool == SPHERE) { w.tool = SPHERE; }
    if toolButton(ui, "Cylinder   C", w.tool == CYLINDER) { w.tool = CYLINDER; }
    if toolButton(ui, "Line   L", w.tool == LINE) { w.tool = LINE; }
    if toolButton(ui, "Fill   G", w.tool == FILL) { w.tool = FILL; }
    if toolButton(ui, "Pick color   I", w.tool == PICKER) { w.tool = PICKER; }
    section(ui, "Click does");
    ui.row();
    if toolButton(ui, " Add 1 ", w.mode == model.ADD) { w.mode = model.ADD; }
    if toolButton(ui, " Erase 2 ", w.mode == model.ERASE) { w.mode = model.ERASE; }
    if toolButton(ui, " Paint 3 ", w.mode == model.PAINT) { w.mode = model.PAINT; }
    ui.end();
    caption(ui, "Paint recolors, never adds");
    section(ui, "Options");
    ui.stepper("Brush", &w.brush, 1, 8);
    ui.stepper("Depth", &w.depth, 1, 64);
    ui.check("Hollow shapes  H", &w.hollow);
    ui.check("Fill one layer", &w.layerFill);
    section(ui, "Mirror (every tool)");
    ui.row();
    if toolButton(ui, "  X  ", w.m.symX) { w.m.symX = !w.m.symX; }
    if toolButton(ui, "  Y  ", w.m.symY) { w.m.symY = !w.m.symY; }
    if toolButton(ui, "  Z  ", w.m.symZ) { w.m.symZ = !w.m.symZ; }
    ui.end();
    section(ui, "View");
    ui.row();
    if ui.button("Iso") { look(w, 0.7, 0.5); }
    if ui.button("Front") { look(w, 0, 0.03); }
    if ui.button("Side") { look(w, 1.5708, 0.03); }
    if ui.button("Top") { look(w, 0, 1.5); }
    ui.end();
    ui.check("Grid", &w.grid);
    ui.check("Orthographic", &w.ortho);
    if ui.check("Corner shading", &w.shaded) {
        w.view.ao = w.shaded;
        w.view.rev = 0;
    }
    if ui.button("Frame model   F") { frame(w); }
}

/// The color swatches: click to pick, the last cell adds one. Wheel over it scrolls.
fn swatches(ui: &Ui, w: &World) {
    let size: f32 = 26;
    let pad: f32 = 4;
    let cols = int((ui.w + pad) / (size + pad));
    let cells = w.m.palLen + 1;
    let rows = (cells + cols - 1) / cols;
    let shown = 5;
    if rows < shown { shown = rows; }
    // Keep the chosen color on screen.
    let selRow = (w.color - 1) / cols;
    if selRow < w.palTop { w.palTop = selRow; }
    if selRow >= w.palTop + shown { w.palTop = selRow - shown + 1; }
    let x0 = ui.x;
    let y0 = ui.y;
    let height = f32(shown) * (size + pad);
    let mp = game.mousePos();
    if mp.x >= x0 && mp.x < x0 + ui.w && mp.y >= y0 && mp.y < y0 + height {
        let wheel = game.mouseWheel();
        if wheel > 0 { w.palTop -= 1; }
        if wheel < 0 { w.palTop += 1; }
    }
    if w.palTop > rows - shown { w.palTop = rows - shown; }
    if w.palTop < 0 { w.palTop = 0; }
    for i in 0..cells {
        let row = i / cols - w.palTop;
        if row < 0 || row >= shown { continue; }
        let x = x0 + f32(i % cols) * (size + pad);
        let y = y0 + f32(row) * (size + pad);
        let hot = mp.x >= x && mp.x < x + size && mp.y >= y && mp.y < y + size;
        if i < w.m.palLen {
            let id = i + 1;
            fill(x, y, size, size, rgb(u8(model.color(&w.m, id, 0)), u8(model.color(&w.m, id, 1)), u8(model.color(&w.m, id, 2))));
            outline(x, y, size, size, rgb(70, 76, 90));
            if id == w.color { outline(x - 2, y - 2, size + 4, size + 4, rgb(255, 255, 255)); }
            else if hot { outline(x, y, size, size, rgb(200, 205, 220)); }
            if hot && game.mousePressed(Mouse.Left) { w.color = id; }
        } else {
            fill(x, y, size, size, rgb(44, 48, 58));
            outline(x, y, size, size, if hot { rgb(200, 205, 220) } else { rgb(70, 76, 90) });
            fill(x + size / 2 - 1, y + 7, 2, size - 14, rgb(150, 156, 170));
            fill(x + 7, y + size / 2 - 1, size - 14, 2, rgb(150, 156, 170));
            if hot && game.mousePressed(Mouse.Left) && w.m.palLen < 255 {
                model.snapshot(&w.m);
                let at = model.addColor(&w.m, model.color(&w.m, w.color, 0), model.color(&w.m, w.color, 1), model.color(&w.m, w.color, 2));
                if at == w.color || at == 0 {
                    // The same color is already there; add a visibly new slot to edit.
                    model.setColor(&w.m, w.m.palLen + 1, 128, 128, 128);
                    at = w.m.palLen;
                }
                w.color = at;
            }
        }
    }
    ui.gap(height + 2);
}

fn editColor(w: &World, r: int, g: int, b: int) {
    if !w.palEditing {
        model.snapshot(&w.m);
        w.palEditing = true;
    }
    model.setColor(&w.m, w.color, r, g, b);
}

fn colorEditor(ui: &Ui, w: &World) {
    if w.color < 1 || w.color > w.m.palLen { w.color = 1; }
    let r = f32(model.color(&w.m, w.color, 0));
    let g = f32(model.color(&w.m, w.color, 1));
    let b = f32(model.color(&w.m, w.color, 2));
    let changed = false;
    if ui.slider("R", &r, 0, 255) { changed = true; }
    if ui.slider("G", &g, 0, 255) { changed = true; }
    if ui.slider("B", &b, 0, 255) { changed = true; }
    if changed { editColor(w, int(r), int(g), int(b)); }
    // Hex and name boxes show the chosen color unless being typed into.
    if !ui.focused("hex") {
        w.hexEdit.clear();
        w.hexEdit.push(35);
        pushHex2(&w.hexEdit, model.color(&w.m, w.color, 0));
        pushHex2(&w.hexEdit, model.color(&w.m, w.color, 1));
        pushHex2(&w.hexEdit, model.color(&w.m, w.color, 2));
    }
    if !ui.focused("pname") {
        w.nameEdit.clear();
        w.nameEdit.pushStr(w.m.names[w.color]);
    }
    if ui.field("hex", &w.hexEdit) {
        let hr = 0;
        let hg = 0;
        let hb = 0;
        if model.parseHex(w.hexEdit.str(), &hr, &hg, &hb) { editColor(w, hr, hg, hb); }
    }
    if ui.field("pname", &w.nameEdit) {
        model.nameColor(&w.m, w.color, w.nameEdit.str());
    }
    caption(ui, "Hex, then a name for commands");
    if !game.mouseDown(Mouse.Left) && !typing() { w.palEditing = false; }
}

fn preset(w: &World, name: string) {
    model.snapshot(&w.m);
    model.loadPreset(&w.m, name);
    if w.color > w.m.palLen { w.color = 1; }
    say2(w, "Palette: ", name);
}

pub fn rightPanel(ui: &Ui, w: &World) {
    let win = game.windowSize();
    fill(win.x - RIGHT, TOP, RIGHT, win.y - TOP - BOTTOM, rgb(34, 37, 44));
    ui.x = win.x - RIGHT + 10;
    ui.y = TOP + 4;
    ui.w = RIGHT - 20;
    ui.h = 26;
    ui.space = 3;
    section(ui, "Model file");
    ui.field("path", &w.path);
    ui.row();
    if ui.button("Open") { files.open(w); }
    if ui.button("Save  Ctrl+S") { files.save(w); }
    if ui.button("Clear") { files.fresh(w); }
    ui.end();
    if ui.button("Export .j3mesh") { files.exportMesh(w); }
    let sx = w.m.sx;
    let sy = w.m.sy;
    let sz = w.m.sz;
    let resized = false;
    if ui.stepper("Width  x", &sx, 1, model.MAX) { resized = true; }
    if ui.stepper("Height y", &sy, 1, model.MAX) { resized = true; }
    if ui.stepper("Depth  z", &sz, 1, model.MAX) { resized = true; }
    if resized {
        model.snapshot(&w.m);
        model.resize(&w.m, sx, sy, sz);
    }
    section(ui, "Palette");
    swatches(ui, w);
    colorEditor(ui, w);
    ui.row();
    if ui.button("default") { preset(w, "default"); }
    if ui.button("earth") { preset(w, "earth"); }
    if ui.button("pastel") { preset(w, "pastel"); }
    ui.end();
    ui.row();
    if ui.button("gray") { preset(w, "gray"); }
    if ui.button("neon") { preset(w, "neon"); }
    if ui.button("Trim unused") {
        model.snapshot(&w.m);
        let gone = model.trimPalette(&w.m);
        if w.color > w.m.palLen { w.color = 1; }
        say2(w, "Palette trimmed; unused colors dropped: ", if gone > 0 { "yes" } else { "none" });
    }
    ui.end();
    caption(ui, "Palette file: palettes/NAME.j3pal");
    ui.field("palfile", &w.palFile);
    ui.row();
    if ui.button("Save palette") { files.savePalette(w); }
    if ui.button("Load palette") { files.loadPalette(w); }
    ui.end();
}

/// Title, undo and redo, and the file state across the top.
pub fn topBar(ui: &Ui, w: &World) {
    let win = game.windowSize();
    fill(0, 0, win.x, TOP, rgb(28, 30, 36));
    ui.x = 10;
    ui.y = 7;
    ui.h = 26;
    ui.w = 200;
    ui.space = 0;
    ui.row();
    if ui.button("Save") { files.save(w); }
    if maybeButton(ui, "Undo", w.m.undoCount > 0) { model.undo(&w.m); }
    if maybeButton(ui, "Redo", w.m.redoCount > 0) { model.redo(&w.m); }
    if toolButton(ui, "Keys  F2", w.showHelp) { w.showHelp = !w.showHelp; }
    ui.end();
    if w.font.raw != 0 {
        let t = Text.new(scratch(0));
        t.pushStr(w.m.name);
        t.pushStr("   ");
        t.pushInt(w.m.sx);
        t.pushStr(" x ");
        t.pushInt(w.m.sy);
        t.pushStr(" x ");
        t.pushInt(w.m.sz);
        t.pushStr("   ");
        t.pushInt(model.count(&w.m));
        t.pushStr(" voxels");
        if w.m.dirty { t.pushStr("   (unsaved)"); }
        let size = game.textSize(w.font, t.str());
        game.setColor(if w.m.dirty { rgb(240, 190, 90) } else { rgb(170, 176, 190) });
        game.drawText(w.font, Vec2 { x: win.x - size.x - 14, y: 12 }, t.str());
    }
}

/// The status line and the command box (the same commands `vox run` takes).
pub fn bottomBar(ui: &Ui, w: &World): string {
    let win = game.windowSize();
    fill(0, win.y - BOTTOM, win.x, BOTTOM, rgb(28, 30, 36));
    if w.font.raw != 0 {
        game.setColor(rgb(200, 204, 214));
        game.drawText(w.font, Vec2 { x: 12, y: win.y - BOTTOM + 9 }, w.status.str());
    }
    ui.x = win.x - 560;
    ui.y = win.y - BOTTOM + 5;
    ui.w = 548;
    ui.h = 26;
    ui.space = 0;
    ui.field("cmd", &w.console);
    if ui.focused("cmd") && game.keyPressed(game.Key.Enter) {
        let line = w.console.str();
        w.console.clear();
        return line;
    }
    return "";
}

/// Output of a console command (`info`, `dump`, `help`) over the bottom of the view.
pub fn logCard(w: &World) {
    if w.log.len() == 0 || w.font.raw == 0 { return; }
    let win = game.windowSize();
    let text = w.log.str();
    let rows = 1;
    for i in 0..text.len {
        if text[i] == 10 && i + 1 < text.len { rows += 1; }
    }
    if rows > 22 { rows = 22; }
    let top = win.y - BOTTOM - 14 - f32(rows) * 19;
    fill(LEFT + 8, top - 6, win.x - LEFT - RIGHT - 16, f32(rows) * 19 + 12, rgba(20, 22, 28, 232));
    game.setColor(rgb(214, 218, 228));
    let at = 0;
    let row = 0;
    while at < text.len && row < rows {
        let end = at;
        while end < text.len && text[end] != 10 { end += 1; }
        game.drawText(w.font, Vec2 { x: LEFT + 16, y: top + f32(row) * 19 }, cut(text, at, end));
        row += 1;
        at = end + 1;
    }
}

pub fn helpCard(w: &World) {
    if !w.showHelp || w.font.raw == 0 { return; }
    let lines = [
        "Mouse   left: use the tool   right drag: orbit   middle (or shift+right) drag: pan   wheel: zoom",
        "        shift+wheel: brush size   ctrl+wheel: depth   alt+click: pick a color   Esc: cancel a drag",
        "Tools   B pencil   U box   O sphere   C cylinder   L line   G fill   I pick color",
        "Modes   1 add   2 erase   3 paint        H hollow    F frame the model",
        "Keys    Ctrl+Z undo   Ctrl+Y redo   Ctrl+S save   F2 this card",
        "Shapes  press where it starts, drag, release. Depth is how far a box or cylinder goes into or out of the face.",
        "Console type commands below (box 0 0 0 3 3 3 red, sphere ..., help) - the same ones agents use",
    ];
    let o = Vec2 { x: LEFT + 14, y: TOP + 14 };
    fill(o.x - 8, o.y - 8, 880, 28 * 7 + 16, rgba(20, 22, 28, 225));
    game.setColor(rgb(214, 218, 228));
    for i in 0..7 {
        game.drawText(w.font, Vec2 { x: o.x, y: o.y + f32(i) * 28 }, lines[i]);
    }
}
