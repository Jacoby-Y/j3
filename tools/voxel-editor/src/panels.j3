// The side panels: tools, view, mirror, the model file, and the palette dashboard.

module voxel_editor.panels;

use j3.game;
use j3.game.{ Mouse, Color, rgb, rgba };
use j3.math.Vec2;
use j3.memory.scratch;
use j3.text.Text;
use j3.ui.{ Theme, Ui, typing };
use voxel_editor.clipedit;
use voxel_editor.cmd;
use voxel_editor.edit.{ frame, look, say, say2 };
use voxel_editor.files;
use voxel_editor.model;
use voxel_editor.model.Model;
use voxel_editor.overlay;
use voxel_editor.rig;
use voxel_editor.util.{ cut, own, pushHex2 };
use voxel_editor.world;
use voxel_editor.tabs;
use voxel_editor.world.{ BOTTOM, BOX, CYLINDER, FILL, LINE, OVPAINT, PARTPAINT, PARTPICK, PENCIL, PICKER, PIVOT, SPHERE, TOP, World };

pub fn theme(): Theme {
    return Theme {
        text: rgb(222, 226, 234),
        button: rgb(52, 56, 66),
        buttonHot: rgb(68, 74, 88),
        buttonDown: rgb(40, 43, 51),
        panel: rgb(34, 37, 44),
        edge: rgb(60, 64, 76),
        accent: rgb(72, 128, 220),
    };
}

pub fn fill(x: f32, y: f32, wide: f32, tall: f32, c: Color) {
    game.setColor(c);
    game.drawRect(Vec2 { x: x, y: y }, Vec2 { x: wide, y: tall });
}

pub fn outline(x: f32, y: f32, wide: f32, tall: f32, c: Color) {
    fill(x, y, wide, 2, c);
    fill(x, y + tall - 2, wide, 2, c);
    fill(x, y, 2, tall, c);
    fill(x + wide - 2, y, 2, tall, c);
}

/// A button drawn in the accent color while `on`.
pub fn toolButton(ui: &Ui, msg: string, on: bool): bool {
    let keep = ui.theme.button;
    if on { ui.theme.button = ui.theme.accent; }
    let hit = ui.button(msg);
    ui.theme.button = keep;
    return hit;
}

pub fn maybeButton(ui: &Ui, msg: string, on: bool): bool {
    if on { return ui.button(msg); }
    ui.buttonOff(msg);
    return false;
}

fn section(ui: &Ui, msg: string) {
    ui.gap(6);
    let keep = ui.theme.text;
    ui.theme.text = rgb(140, 170, 230);
    ui.labelBold(msg);
    ui.theme.text = keep;
}

fn caption(ui: &Ui, msg: string) {
    let keep = ui.theme.text;
    ui.theme.text = rgb(150, 156, 170);
    ui.label(msg);
    ui.theme.text = keep;
}

pub fn leftPanel(ui: &Ui, w: &World) {
    let win = game.windowSize();
    fill(0, TOP, w.left, win.y - TOP - BOTTOM, rgb(34, 37, 44));
    fill(w.left - 2, TOP, 2, win.y - TOP - BOTTOM, if w.edge == 1 { rgb(120, 170, 255) } else { rgb(52, 56, 66) });
    ui.x = 10;
    ui.y = TOP + 4;
    ui.w = w.left - 20;
    ui.h = 26;
    ui.space = 3;
    section(ui, "Tool");
    if toolButton(ui, "Pencil   B", w.tool == PENCIL) { w.tool = PENCIL; }
    if toolButton(ui, "Box   U", w.tool == BOX) { w.tool = BOX; }
    if toolButton(ui, "Sphere   O", w.tool == SPHERE) { w.tool = SPHERE; }
    if toolButton(ui, "Cylinder   C", w.tool == CYLINDER) { w.tool = CYLINDER; }
    if toolButton(ui, "Line   L", w.tool == LINE) { w.tool = LINE; }
    if toolButton(ui, "Fill   G", w.tool == FILL) { w.tool = FILL; }
    if toolButton(ui, "Pick color   I", w.tool == PICKER) { w.tool = PICKER; }
    section(ui, "Click does");
    ui.row();
    if toolButton(ui, " Add 1 ", w.mode == model.ADD) { w.mode = model.ADD; }
    if toolButton(ui, " Erase 2 ", w.mode == model.ERASE) { w.mode = model.ERASE; }
    if toolButton(ui, " Paint 3 ", w.mode == model.PAINT) { w.mode = model.PAINT; }
    ui.end();
    caption(ui, "Paint recolors, never adds");
    section(ui, "Options");
    ui.stepper("Brush", &w.brush, 1, 8);
    ui.stepper("Depth", &w.depth, 1, 64);
    ui.check("Hollow shapes  H", &w.hollow);
    ui.check("Fill one layer", &w.layerFill);
    section(ui, "Mirror (every tool)");
    ui.row();
    if toolButton(ui, "  X  ", w.m.symX) { w.m.symX = !w.m.symX; }
    if toolButton(ui, "  Y  ", w.m.symY) { w.m.symY = !w.m.symY; }
    if toolButton(ui, "  Z  ", w.m.symZ) { w.m.symZ = !w.m.symZ; }
    ui.end();
    section(ui, "View");
    ui.row();
    if ui.button("Iso") { look(w, 0.7, 0.5); }
    if ui.button("Front") { look(w, 0, 0.03); }
    if ui.button("Side") { look(w, 1.5708, 0.03); }
    if ui.button("Top") { look(w, 0, 1.5); }
    ui.end();
    ui.check("Grid", &w.grid);
    ui.check("Orthographic", &w.ortho);
    if ui.check("Corner shading", &w.shaded) {
        w.view.ao = w.shaded;
        w.view.rev = 0;
    }
    if ui.button("Frame model   F") { frame(w); }
}

/// The color swatches: click to pick, the last cell adds one. Wheel over it scrolls.
fn swatches(ui: &Ui, w: &World) {
    let size: f32 = 26;
    let pad: f32 = 4;
    let cols = int((ui.w + pad) / (size + pad));
    let cells = w.m.palLen + 1;
    let rows = (cells + cols - 1) / cols;
    let shown = 5;
    if rows < shown { shown = rows; }
    // Keep the chosen color on screen.
    let selRow = (w.color - 1) / cols;
    if selRow < w.palTop { w.palTop = selRow; }
    if selRow >= w.palTop + shown { w.palTop = selRow - shown + 1; }
    let x0 = ui.x;
    let y0 = ui.y;
    let height = f32(shown) * (size + pad);
    let mp = game.mousePos();
    if mp.x >= x0 && mp.x < x0 + ui.w && mp.y >= y0 && mp.y < y0 + height {
        let wheel = game.mouseWheel();
        if wheel > 0 { w.palTop -= 1; }
        if wheel < 0 { w.palTop += 1; }
    }
    if w.palTop > rows - shown { w.palTop = rows - shown; }
    if w.palTop < 0 { w.palTop = 0; }
    for i in 0..cells {
        let row = i / cols - w.palTop;
        if row < 0 || row >= shown { continue; }
        let x = x0 + f32(i % cols) * (size + pad);
        let y = y0 + f32(row) * (size + pad);
        let hot = mp.x >= x && mp.x < x + size && mp.y >= y && mp.y < y + size;
        if i < w.m.palLen {
            let id = i + 1;
            fill(x, y, size, size, rgb(u8(model.color(&w.m, id, 0)), u8(model.color(&w.m, id, 1)), u8(model.color(&w.m, id, 2))));
            outline(x, y, size, size, rgb(70, 76, 90));
            if id == w.color { outline(x - 2, y - 2, size + 4, size + 4, rgb(255, 255, 255)); }
            else if hot { outline(x, y, size, size, rgb(200, 205, 220)); }
            if hot && game.mousePressed(Mouse.Left) { w.color = id; }
        } else {
            fill(x, y, size, size, rgb(44, 48, 58));
            outline(x, y, size, size, if hot { rgb(200, 205, 220) } else { rgb(70, 76, 90) });
            fill(x + size / 2 - 1, y + 7, 2, size - 14, rgb(150, 156, 170));
            fill(x + 7, y + size / 2 - 1, size - 14, 2, rgb(150, 156, 170));
            if hot && game.mousePressed(Mouse.Left) && w.m.palLen < 255 {
                model.snapshot(&w.m);
                let at = model.addColor(&w.m, model.color(&w.m, w.color, 0), model.color(&w.m, w.color, 1), model.color(&w.m, w.color, 2));
                if at == w.color || at == 0 {
                    // The same color is already there; add a visibly new slot to edit.
                    model.setColor(&w.m, w.m.palLen + 1, 128, 128, 128);
                    at = w.m.palLen;
                }
                w.color = at;
            }
        }
    }
    ui.gap(height + 2);
}

fn editColor(w: &World, r: int, g: int, b: int) {
    if !w.palEditing {
        model.snapshot(&w.m);
        w.palEditing = true;
    }
    model.setColor(&w.m, w.color, r, g, b);
}

fn colorEditor(ui: &Ui, w: &World) {
    if w.color < 1 || w.color > w.m.palLen { w.color = 1; }
    let r = f32(model.color(&w.m, w.color, 0));
    let g = f32(model.color(&w.m, w.color, 1));
    let b = f32(model.color(&w.m, w.color, 2));
    let changed = false;
    if ui.slider("R", &r, 0, 255) { changed = true; }
    if ui.slider("G", &g, 0, 255) { changed = true; }
    if ui.slider("B", &b, 0, 255) { changed = true; }
    if changed { editColor(w, int(r), int(g), int(b)); }
    // Hex and name boxes show the chosen color unless being typed into.
    if !ui.focused("hex") {
        w.hexEdit.clear();
        w.hexEdit.push(35);
        pushHex2(&w.hexEdit, model.color(&w.m, w.color, 0));
        pushHex2(&w.hexEdit, model.color(&w.m, w.color, 1));
        pushHex2(&w.hexEdit, model.color(&w.m, w.color, 2));
    }
    if !ui.focused("pname") {
        w.nameEdit.clear();
        w.nameEdit.pushStr(w.m.names[w.color]);
    }
    if ui.field("hex", &w.hexEdit) {
        let hr = 0;
        let hg = 0;
        let hb = 0;
        if model.parseHex(w.hexEdit.str(), &hr, &hg, &hb) { editColor(w, hr, hg, hb); }
    }
    if ui.field("pname", &w.nameEdit) {
        model.nameColor(&w.m, w.color, w.nameEdit.str());
    }
    caption(ui, "Hex, then a name for commands");
    if !game.mouseDown(Mouse.Left) && !typing() { w.palEditing = false; }
}

fn preset(w: &World, name: string) {
    model.snapshot(&w.m);
    model.loadPreset(&w.m, name);
    if w.color > w.m.palLen { w.color = 1; }
    say2(w, "Palette: ", name);
}

pub fn rightPanel(ui: &Ui, w: &World) {
    let win = game.windowSize();
    fill(win.x - w.right, TOP, w.right, win.y - TOP - BOTTOM, rgb(34, 37, 44));
    fill(win.x - w.right, TOP, 2, win.y - TOP - BOTTOM, if w.edge == 2 { rgb(120, 170, 255) } else { rgb(52, 56, 66) });
    ui.x = win.x - w.right + 10;
    ui.y = TOP + 4;
    ui.w = w.right - 20;
    ui.h = 26;
    ui.space = 3;
    ui.row();
    if toolButton(ui, "  Model  ", !w.rigTab) { w.rigTab = false; }
    if toolButton(ui, "  Rig  ", w.rigTab) {
        w.rigTab = true;
        if w.tool < PARTPICK && !w.active { w.tool = PARTPICK; } // a click picks a limb instead of drawing
    }
    ui.end();
    if w.rigTab {
        // The rig tab is long: scroll it inside the room left under the tabs.
        ui.scroll(7, win.y - BOTTOM - ui.y - 6);
        rigPanel(ui, w);
        ui.end();
        return;
    }
    section(ui, "Model file");
    ui.field("path", &w.path);
    ui.row();
    if ui.button("Open...") { files.choose(w); }
    if ui.button("Save  Ctrl+S") { files.save(w); }
    if ui.button("Clear") { files.fresh(w); }
    ui.end();
    if ui.button("Export .j3mesh") { files.exportMesh(w); }
    let sx = w.m.sx;
    let sy = w.m.sy;
    let sz = w.m.sz;
    let resized = false;
    if ui.stepper("Width  x", &sx, 1, model.MAX) { resized = true; }
    if ui.stepper("Height y", &sy, 1, model.MAX) { resized = true; }
    if ui.stepper("Depth  z", &sz, 1, model.MAX) { resized = true; }
    if resized {
        model.snapshot(&w.m);
        model.resize(&w.m, sx, sy, sz);
    }
    section(ui, "Palette");
    swatches(ui, w);
    colorEditor(ui, w);
    ui.row();
    if ui.button("default") { preset(w, "default"); }
    if ui.button("earth") { preset(w, "earth"); }
    if ui.button("pastel") { preset(w, "pastel"); }
    ui.end();
    ui.row();
    if ui.button("gray") { preset(w, "gray"); }
    if ui.button("neon") { preset(w, "neon"); }
    if ui.button("Trim unused") {
        model.snapshot(&w.m);
        let gone = model.trimPalette(&w.m);
        if w.color > w.m.palLen { w.color = 1; }
        say2(w, "Palette trimmed; unused colors dropped: ", if gone > 0 { "yes" } else { "none" });
    }
    ui.end();
    caption(ui, "Palette file: palettes/NAME.j3pal");
    ui.field("palfile", &w.palFile);
    ui.row();
    if ui.button("Save palette") { files.savePalette(w); }
    if ui.button("Load palette") { files.loadPalette(w); }
    ui.end();
}

fn depthOf(m: &Model, id: int): int {
    let d = 0;
    let at = m.parts[id].parent;
    while at != 0 && d < model.MAXPARTS {
        d += 1;
        at = m.parts[at].parent;
    }
    return d;
}

/// Snapshot once per slider drag, so one drag is one undo step.
fn rigEdit(w: &World) {
    w.playing = false;
    if !w.palEditing {
        model.snapshot(&w.m);
        w.palEditing = true;
    }
}

fn newPart(w: &World, parent: int) {
    let n = w.m.partCount + 1;
    let name = Text.new(scratch(0));
    name.pushStr("Part");
    name.pushInt(n);
    while rig.find(&w.m, name.str()) != 0 {
        n += 1;
        name.clear();
        name.pushStr("Part");
        name.pushInt(n);
    }
    model.snapshot(&w.m);
    let id = rig.add(&w.m, name.str(), parent);
    if id == 0 {
        model.discardSnapshot(&w.m);
        say(w, "A model holds 32 parts at most");
        return;
    }
    if parent != 0 { rig.pivotAuto(&w.m, id); }
    w.m.active = id;
    say2(w, "Added ", name.str());
}

/// The Rig tab: parts, the active part's joint, the pose, and the rig tools.
fn rigPanel(ui: &Ui, w: &World) {
    let m = &w.m;
    section(ui, "Rig tools");
    ui.row();
    if toolButton(ui, "Pick part", w.tool == PARTPICK) { w.tool = PARTPICK; }
    if toolButton(ui, "Paint part", w.tool == PARTPAINT) { w.tool = PARTPAINT; }
    if toolButton(ui, "Joint", w.tool == PIVOT) { w.tool = PIVOT; }
    ui.end();
    caption(ui, "Paint gives voxels to the active part");
    section(ui, "Parts");
    if m.partCount == 0 { caption(ui, "none yet: add one, or Auto human"); }
    let shown = 8;
    if m.partCount - w.partTop < shown { shown = m.partCount - w.partTop; }
    if w.partTop > m.partCount - 1 { w.partTop = 0; }
    if w.partTop < 0 { w.partTop = 0; }
    for k in 0..shown {
        let id = w.partTop + 1 + k;
        let label = Text.new(scratch(0));
        for d in 0..depthOf(m, id) { label.pushStr("  "); }
        label.pushStr(m.parts[id].name);
        if toolButton(ui, label.str(), id == m.active) { m.active = id; }
    }
    if m.partCount > 8 {
        ui.row();
        if ui.button("Up") { w.partTop -= 1; }
        if ui.button("Down") { w.partTop += 1; }
        ui.end();
        if w.partTop > m.partCount - 8 { w.partTop = m.partCount - 8; }
    }
    ui.row();
    if ui.button("New root") { newPart(w, 0); }
    if maybeButton(ui, "New child", m.active != 0) { newPart(w, m.active); }
    ui.end();
    ui.row();
    if ui.button("Auto human") {
        model.snapshot(m);
        let made = rig.humanoid(m, 0);
        if made == 0 { model.discardSnapshot(m); say(w, "Build the body first"); }
        else { say(w, "Humanoid split; check it with Color by part"); }
    }
    if maybeButton(ui, "Clear rig", m.partCount > 0) {
        model.snapshot(m);
        rig.clearRig(m);
    }
    ui.end();
    ui.check("Color by part", &w.view.tint);
    ui.check("Show joints", &w.view.joints);
    if ui.check("Show overlays", &w.view.overlays) { w.view.rev = 0; }
    w.view.rev = if w.view.tint != w.partTint { 0 } else { w.view.rev };
    w.partTint = w.view.tint;
    if m.active != 0 { activePart(ui, w); }
    overlaySection(ui, w);
    if !game.mouseDown(Mouse.Left) && !typing() { w.palEditing = false; }
}

/// Run an `overlay ...` console command from a button; failures show in the status line.
fn overlayCommand(w: &World, line: string) {
    let out = Text.new(scratch(0));
    if cmd.run(&w.m, line, &out) {
        if out.len() > 0 { say(w, out.str()); }
    } else {
        say(w, out.str());
    }
}

/// Overlays: pixel layers on a part, painted a face at a time or from a PNG.
fn overlaySection(ui: &Ui, w: &World) {
    let m = &w.m;
    section(ui, "Overlays");
    if w.ovActive > m.overlayCount { w.ovActive = 0; }
    if m.overlayCount == 0 { caption(ui, "none: pick a part, then New"); }
    for o in 1..=m.overlayCount {
        let label = Text.new(scratch(0));
        label.pushStr(m.overlays[o].name);
        label.pushStr("  ");
        label.pushStr(m.parts[m.overlays[o].part].name);
        label.pushStr(" +");
        label.pushInt(m.overlays[o].grow);
        if !m.overlays[o].visible { label.pushStr("  (hidden)"); }
        if toolButton(ui, label.str(), o == w.ovActive) { w.ovActive = o; }
    }
    ui.stepper("New grow", &w.ovGrow, 0, overlay.MAXGROW);
    ui.row();
    if maybeButton(ui, "New on part", m.active != 0 && m.overlayCount < model.MAXOVERLAYS) {
        let name = Text.new(scratch(0));
        let n = m.overlayCount + 1;
        name.pushStr("Layer");
        name.pushInt(n);
        while overlay.find(m, name.str()) != 0 {
            n += 1;
            name.clear();
            name.pushStr("Layer");
            name.pushInt(n);
        }
        let lineNew = Text.new(scratch(0));
        lineNew.pushStr("overlay new ");
        lineNew.pushStr(name.str());
        lineNew.push(32);
        lineNew.pushStr(m.parts[m.active].name);
        lineNew.pushStr(" grow ");
        lineNew.pushInt(w.ovGrow);
        overlayCommand(w, lineNew.str());
        if overlay.find(m, name.str()) != 0 { w.ovActive = overlay.find(m, name.str()); }
    }
    if maybeButton(ui, "Delete", w.ovActive != 0) {
        let lineDel = Text.new(scratch(0));
        lineDel.pushStr("overlay rm ");
        lineDel.pushStr(m.overlays[w.ovActive].name);
        overlayCommand(w, lineDel.str());
        w.ovActive = 0;
    }
    ui.end();
    if toolButton(ui, "Paint overlay", w.tool == OVPAINT) { w.tool = OVPAINT; }
    caption(ui, "Click or drag faces with the chosen color; Erase mode clears");
    if w.ovActive == 0 { return; }
    let id = w.ovActive;
    let grow = m.overlays[id].grow;
    if ui.stepper("Grow", &grow, 0, overlay.MAXGROW) {
        let lineGrow = Text.new(scratch(0));
        lineGrow.pushStr("overlay grow ");
        lineGrow.pushStr(m.overlays[id].name);
        lineGrow.push(32);
        lineGrow.pushInt(grow);
        model.snapshot(m);
        overlayCommand(w, lineGrow.str());
    }
    let shown = m.overlays[id].visible;
    if ui.check("Visible", &shown) {
        model.snapshot(m);
        m.overlays[id].visible = shown;
        model.touch(m);
    }
    ui.field("ovfile", &w.ovFile);
    ui.row();
    if ui.button("Export PNG") {
        let lineExp = Text.new(scratch(0));
        lineExp.pushStr("overlay export ");
        lineExp.pushStr(m.overlays[id].name);
        lineExp.push(32);
        lineExp.pushStr(w.ovFile.str());
        overlayCommand(w, lineExp.str());
    }
    if ui.button("Import PNG") {
        let line2 = Text.new(scratch(0));
        line2.pushStr("overlay import ");
        line2.pushStr(m.overlays[id].name);
        line2.push(32);
        line2.pushStr(w.ovFile.str());
        model.snapshot(m);
        overlayCommand(w, line2.str());
    }
    ui.end();
    caption(ui, "Paint on the rest pose (pose reset)");
}

/// The active part's name, parent, joint, and rotation.
fn activePart(ui: &Ui, w: &World) {
    let m = &w.m;
    let id = m.active;
    section(ui, "Active part");
    if !ui.focused("partname") {
        w.partName.clear();
        w.partName.pushStr(m.parts[id].name);
    }
    if ui.field("partname", &w.partName) {
        let nm = w.partName.str();
        if nm.len > 0 && rig.find(m, nm) == 0 {
            rigEdit(w);
            m.parts[id].name = own(m.mem, nm);
            model.touch(m);
        }
    }
    let up = m.parts[id].parent;
    if ui.stepper("Parent #", &up, 0, m.partCount) && up != id && !rig.under(m, up, id) {
        model.snapshot(m);
        m.parts[id].parent = up;
        model.touch(m);
    }
    caption(ui, if up == 0 { "no parent (root)" } else { m.parts[up].name });
    ui.row();
    if ui.button("Auto joint") {
        model.snapshot(m);
        rig.pivotAuto(m, id);
    }
    if ui.button("Assign rest") {
        model.snapshot(m);
        rig.assignRest(m, id);
    }
    if ui.button("Delete") {
        model.snapshot(m);
        rig.remove(m, id);
    }
    ui.end();
    if m.active == 0 { return; }
    let px = m.parts[id].px;
    let py = m.parts[id].py;
    let pz = m.parts[id].pz;
    let moved = false;
    if ui.slider("Joint x", &px, 0, f32(m.sx)) { moved = true; }
    if ui.slider("Joint y", &py, 0, f32(m.sy)) { moved = true; }
    if ui.slider("Joint z", &pz, 0, f32(m.sz)) { moved = true; }
    if moved {
        rigEdit(w);
        m.parts[id].px = px;
        m.parts[id].py = py;
        m.parts[id].pz = pz;
        model.touch(m);
    }
    section(ui, "Pose (degrees, within limits)");
    let rx = m.poses[id * 3];
    let ry = m.poses[id * 3 + 1];
    let rz = m.poses[id * 3 + 2];
    let turned = false;
    if ui.slider("Rot x", &rx, m.parts[id].lx0, m.parts[id].lx1) { turned = true; }
    if ui.slider("Rot y", &ry, m.parts[id].ly0, m.parts[id].ly1) { turned = true; }
    if ui.slider("Rot z", &rz, m.parts[id].lz0, m.parts[id].lz1) { turned = true; }
    if turned {
        rigEdit(w);
        rig.setPose(m, id, rx, ry, rz);
        clipedit.autokey(w);
    }
    ui.row();
    if ui.button("Reset pose") {
        w.playing = false;
        model.snapshot(m);
        rig.resetPose(m);
    }
    ui.end();
    caption(ui, "Limits: `part limit` in the console");
    ui.field("posename", &w.poseName);
    ui.row();
    if maybeButton(ui, "Save pose", w.poseName.len() > 0) {
        model.snapshot(m);
        if !rig.savePose(m, w.poseName.str()) { model.discardSnapshot(m); say(w, "64 poses at most"); }
    }
    ui.end();
    for s in 1..=m.poseCount {
        if ui.button(m.poseNames[s]) {
            model.snapshot(m);
            rig.loadPose(m, s);
            w.playing = false;
        }
    }
    clipSection(ui, w);
}

/// Clips: a click selects one for the timeline (it poses the model at the playhead).
fn clipSection(ui: &Ui, w: &World) {
    let m = &w.m;
    section(ui, "Clips (made with `clip new`)");
    if m.clipCount == 0 { caption(ui, "none yet: New clip in the timeline"); }
    for c in 1..=m.clipCount {
        if toolButton(ui, m.clips[c].name, c == w.clip) { clipedit.select(w, c); }
    }
}

/// Title, undo and redo, and the file state across the top.
pub fn topBar(ui: &Ui, w: &World) {
    let win = game.windowSize();
    fill(0, 0, win.x, TOP, rgb(28, 30, 36));
    ui.x = 10;
    ui.y = 7;
    ui.h = 26;
    ui.w = 200;
    ui.space = 0;
    ui.row();
    if ui.button("Save") { files.save(w); }
    if maybeButton(ui, "Undo", w.m.undoCount > 0) { model.undo(&w.m); }
    if maybeButton(ui, "Redo", w.m.redoCount > 0) { model.redo(&w.m); }
    if toolButton(ui, "Keys  F2", w.showHelp) { w.showHelp = !w.showHelp; }
    if ui.button("+ Tab") { tabs.open(w, ""); }
    if ui.button("Close Tab") { tabs.close(w); }
    ui.end();
    tabStrip(ui, w);
    if w.font.raw != 0 {
        let t = Text.new(scratch(0));
        t.pushStr(w.m.name);
        t.pushStr("   ");
        t.pushInt(w.m.sx);
        t.pushStr(" x ");
        t.pushInt(w.m.sy);
        t.pushStr(" x ");
        t.pushInt(w.m.sz);
        t.pushStr("   ");
        t.pushInt(model.count(&w.m));
        t.pushStr(" voxels");
        if w.m.dirty { t.pushStr("   (unsaved)"); }
        let size = game.textSize(w.font, t.str());
        game.setColor(if w.m.dirty { rgb(240, 190, 90) } else { rgb(170, 176, 190) });
        game.drawText(w.font, Vec2 { x: win.x - size.x - 14, y: 12 }, t.str());
    }
}

/// One button per open model under the top bar.
fn tabStrip(ui: &Ui, w: &World) {
    ui.x = 10;
    ui.y = 41;
    ui.h = 24;
    ui.w = 140;
    ui.space = 2;
    ui.row();
    let go = -1;
    for i in 0..w.tabCount {
        ui.pushId(i);
        if toolButton(ui, tabs.label(w, i), i == w.tab) { go = i; }
        ui.popId();
    }
    ui.end();
    if go >= 0 { tabs.switchTo(w, go); }
}

/// The status line and the command box (the same commands `vox run` takes).
pub fn bottomBar(ui: &Ui, w: &World): string {
    let win = game.windowSize();
    fill(0, win.y - BOTTOM, win.x, BOTTOM, rgb(28, 30, 36));
    if w.font.raw != 0 {
        game.setColor(rgb(200, 204, 214));
        game.drawText(w.font, Vec2 { x: 12, y: win.y - BOTTOM + 9 }, w.status.str());
    }
    ui.x = win.x - 560;
    ui.y = win.y - BOTTOM + 5;
    ui.w = 548;
    ui.h = 26;
    ui.space = 0;
    ui.field("cmd", &w.console);
    if ui.focused("cmd") && game.keyPressed(game.Key.Enter) {
        let line = w.console.str();
        w.console.clear();
        return line;
    }
    return "";
}

/// Output of a console command (`info`, `dump`, `help`) over the bottom of the view.
pub fn logCard(w: &World) {
    if w.log.len() == 0 || w.font.raw == 0 { return; }
    let win = game.windowSize();
    let text = w.log.str();
    let rows = 1;
    for i in 0..text.len {
        if text[i] == 10 && i + 1 < text.len { rows += 1; }
    }
    if rows > 22 { rows = 22; }
    let top = win.y - BOTTOM - 14 - f32(rows) * 19;
    fill(w.left + 8, top - 6, win.x - w.left - w.right - 16, f32(rows) * 19 + 12, rgba(20, 22, 28, 232));
    game.setColor(rgb(214, 218, 228));
    let at = 0;
    let row = 0;
    while at < text.len && row < rows {
        let end = at;
        while end < text.len && text[end] != 10 { end += 1; }
        game.drawText(w.font, Vec2 { x: w.left + 16, y: top + f32(row) * 19 }, cut(text, at, end));
        row += 1;
        at = end + 1;
    }
}

pub fn helpCard(w: &World) {
    if !w.showHelp || w.font.raw == 0 { return; }
    let lines = [
        "Mouse   left: use the tool   right drag: orbit   middle (or shift+right) drag: pan   wheel: zoom",
        "        shift+wheel: brush size   ctrl+wheel: depth   alt+click: pick a color   Esc: cancel a drag",
        "Tools   B pencil   U box   O sphere   C cylinder   L line   G fill   I pick color",
        "Modes   1 add   2 erase   3 paint        H hollow    F frame the model",
        "Keys    Ctrl+Z undo   Ctrl+Y redo   Ctrl+S save   F2 this card",
        "Shapes  press where it starts, drag, release. Depth is how far a box or cylinder goes into or out of the face.",
        "Console type commands below (box 0 0 0 3 3 3 red, sphere ..., help) - the same ones agents use",
    ];
    let o = Vec2 { x: w.left + 14, y: TOP + 14 };
    fill(o.x - 8, o.y - 8, 880, 28 * 7 + 16, rgba(20, 22, 28, 225));
    game.setColor(rgb(214, 218, 228));
    for i in 0..7 {
        game.drawText(w.font, Vec2 { x: o.x, y: o.y + f32(i) * 28 }, lines[i]);
    }
}
