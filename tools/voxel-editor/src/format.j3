// The `.j3voxel` text format. Easy to read, write, and diff:
//
//   # j3voxel 1
//   name robot
//   size 16 24 12
//   p 1 3b3b3b outline        palette entry: index (1..255), hex color, optional name
//   p 2 e63946 red
//   v 0 0 0 1                 voxel: x y z paletteIndex
//   v 1 0 0 2 4               ... with a run length: 4 voxels along +x from x
//
//   part Arm.L parent Torso pivot 12 22 4 limit -150 150 -90 90 -10 120
//                             rig part: parent name (or `-`), joint at a voxel-edge point, optional
//                             rotation limits in degrees (x min max, y min max, z min max)
//   vp 0 0 0 2 4              part layer: x y z part number (in `part` line order), run along +x
//   pose wave Arm.L 0 0 -120  named pose: part, then rotation in degrees about x y z (more parts follow)
//   ov armor Torso 1 visible  overlay: pixel layer on a part, shell `grow` voxels out (0 = on the surface)
//   ot armor 4 12 2 pz 00a8a8 3  one painted face: overlay, cell x y z, face (px nx py ny pz nz), color, run along +x
//   clip walk 0.8 loop a@0 b@0.3 c@0.5  animation: seconds, loop|once, then saved pose names with their time in seconds (no times: spread evenly)
//
// y is up, voxel (0,0,0) is the corner at the origin, and one voxel is one unit. Lines may
// come in any order; `#` starts a comment. Index 0 is air.

module voxel_editor.format;

use j3.gfx.voxel;
use j3.io;
use j3.memory.Arena;
use j3.result.Result;
use j3.text.{ Text, same };
use voxel_editor.model;
use voxel_editor.model.Model;
use voxel_editor.overlay;
use voxel_editor.rig;
use voxel_editor.util.{ cut, own, parseF, parseI, pushHex2, trim, words };

/// The model as `.j3voxel` text.
pub fn write(m: &Model, out: &Text) {
    out.pushStr("# j3voxel 1\n");
    out.pushStr("name ");
    out.pushStr(m.name);
    out.pushStr("\nsize ");
    out.pushInt(m.sx);
    out.push(32);
    out.pushInt(m.sy);
    out.push(32);
    out.pushInt(m.sz);
    out.push(10);
    for i in 1..=m.palLen {
        out.pushStr("p ");
        out.pushInt(i);
        out.push(32);
        pushHex2(out, model.color(m, i, 0));
        pushHex2(out, model.color(m, i, 1));
        pushHex2(out, model.color(m, i, 2));
        if m.names[i].len > 0 {
            out.push(32);
            out.pushStr(m.names[i]);
        }
        out.push(10);
    }
    for y in 0..m.sy {
        for z in 0..m.sz {
            let x = 0;
            while x < m.sx {
                let c = model.get(m, x, y, z);
                if c == 0 { x += 1; continue; }
                let run = 1;
                while x + run < m.sx && model.get(m, x + run, y, z) == c { run += 1; }
                out.pushStr("v ");
                out.pushInt(x);
                out.push(32);
                out.pushInt(y);
                out.push(32);
                out.pushInt(z);
                out.push(32);
                out.pushInt(c);
                if run > 1 {
                    out.push(32);
                    out.pushInt(run);
                }
                out.push(10);
                x += run;
            }
        }
    }
    for i in 1..=m.partCount {
        let pt = m.parts[i];
        out.pushStr("part ");
        out.pushStr(pt.name);
        out.pushStr(" parent ");
        out.pushStr(if pt.parent == 0 { "-" } else { m.parts[pt.parent].name });
        out.pushStr(" pivot ");
        out.pushFloat(pt.px);
        out.push(32);
        out.pushFloat(pt.py);
        out.push(32);
        out.pushFloat(pt.pz);
        if pt.lx0 != -180 || pt.lx1 != 180 || pt.ly0 != -180 || pt.ly1 != 180 || pt.lz0 != -180 || pt.lz1 != 180 {
            out.pushStr(" limit ");
            out.pushFloat(pt.lx0);
            out.push(32);
            out.pushFloat(pt.lx1);
            out.push(32);
            out.pushFloat(pt.ly0);
            out.push(32);
            out.pushFloat(pt.ly1);
            out.push(32);
            out.pushFloat(pt.lz0);
            out.push(32);
            out.pushFloat(pt.lz1);
        }
        out.push(10);
    }
    if m.partCount > 0 {
        for y in 0..m.sy {
            for z in 0..m.sz {
                let vx = 0;
                while vx < m.sx {
                    let vat = voxel.index(vx, y, z, m.sx, m.sz);
                    let id = int(m.part[vat]);
                    if m.cells[vat] == 0 || id == 0 { vx += 1; continue; }
                    let vrun = 1;
                    while vx + vrun < m.sx {
                        let nb = voxel.index(vx + vrun, y, z, m.sx, m.sz);
                        if m.cells[nb] == 0 || int(m.part[nb]) != id { break; }
                        vrun += 1;
                    }
                    out.pushStr("vp ");
                    out.pushInt(vx);
                    out.push(32);
                    out.pushInt(y);
                    out.push(32);
                    out.pushInt(z);
                    out.push(32);
                    out.pushInt(id);
                    if vrun > 1 {
                        out.push(32);
                        out.pushInt(vrun);
                    }
                    out.push(10);
                    vx += vrun;
                }
            }
        }
    }
    for slot in 1..=m.poseCount {
        out.pushStr("pose ");
        out.pushStr(m.poseNames[slot]);
        for i in 1..=m.partCount {
            let rx = m.poses[slot * model.POSE + i * 3];
            let ry = m.poses[slot * model.POSE + i * 3 + 1];
            let rz = m.poses[slot * model.POSE + i * 3 + 2];
            if rx == 0 && ry == 0 && rz == 0 { continue; }
            out.push(32);
            out.pushStr(m.parts[i].name);
            out.push(32);
            out.pushFloat(rx);
            out.push(32);
            out.pushFloat(ry);
            out.push(32);
            out.pushFloat(rz);
        }
        out.push(10);
    }
    for k in 1..=m.clipCount {
        out.pushStr("clip ");
        out.pushStr(m.clips[k].name);
        out.push(32);
        out.pushFloat(m.clips[k].seconds);
        out.pushStr(if m.clips[k].loop { " loop" } else { " once" });
        for j in 0..m.clips[k].count {
            out.push(32);
            out.pushStr(m.clips[k].keys[j]);
            out.push(64);
            out.pushFloat(m.clips[k].times[j]);
        }
        out.push(10);
    }
    for o in 1..=m.overlayCount {
        out.pushStr("ov ");
        out.pushStr(m.overlays[o].name);
        out.push(32);
        out.pushStr(m.parts[m.overlays[o].part].name);
        out.push(32);
        out.pushInt(m.overlays[o].grow);
        out.pushStr(if m.overlays[o].visible { " visible\n" } else { " hidden\n" });
    }
    let ti = 0;
    while ti < m.texelCount {
        let tkey = model.texKeyOf(m.texels[ti]);
        let trgb = model.texRgb(m.texels[ti]);
        let tlen = 1;
        while ti + tlen < m.texelCount && model.texX(tkey) + tlen < 64 && model.texKeyOf(m.texels[ti + tlen]) == tkey + tlen
            && model.texRgb(m.texels[ti + tlen]) == trgb {
            tlen += 1;
        }
        out.pushStr("ot ");
        out.pushStr(m.overlays[model.texOverlay(tkey)].name);
        out.push(32);
        out.pushInt(model.texX(tkey));
        out.push(32);
        out.pushInt(model.texY(tkey));
        out.push(32);
        out.pushInt(model.texZ(tkey));
        out.push(32);
        out.pushStr(overlay.faceName(model.texFace(tkey)));
        out.push(32);
        pushHex2(out, trgb / 65536);
        pushHex2(out, (trgb / 256) % 256);
        pushHex2(out, trgb % 256);
        if tlen > 1 {
            out.push(32);
            out.pushInt(tlen);
        }
        out.push(10);
        ti += tlen;
    }
}

/// An `ov NAME PART GROW [visible|hidden]` line. Returns what is wrong, or "".
fn overlayLine(w: []string, m: &Model): string {
    let g = 0;
    if w.len < 4 || !parseI(w[3], &g) || g < 0 || g > overlay.MAXGROW { return "overlay lines are: ov NAME PART GROW [visible|hidden]"; }
    let p = rig.find(m, w[2]);
    if p == 0 { return "an overlay names a part that no part line defines"; }
    let id = overlay.add(m, w[1], p, g);
    if id == 0 { return "too many overlays (8 at most) or a repeated overlay name"; }
    if w.len > 4 && same(w[4], "hidden") { m.overlays[id].visible = false; }
    return "";
}

/// An `ot NAME X Y Z FACE RRGGBB [RUN]` line. Returns what is wrong, or "".
fn texelLine(w: []string, m: &Model): string {
    let tx = 0;
    let ty = 0;
    let tz = 0;
    let run = 1;
    let cr = 0;
    let cg = 0;
    let cb = 0;
    if w.len < 7 || !parseI(w[2], &tx) || !parseI(w[3], &ty) || !parseI(w[4], &tz) || !model.parseHex(w[6], &cr, &cg, &cb) {
        return "pixel lines are: ot OVERLAY X Y Z FACE RRGGBB [RUN]";
    }
    if w.len > 7 && !parseI(w[7], &run) { return "the run length after the color must be a number"; }
    let id = overlay.find(m, w[1]);
    let face = overlay.faceByName(w[5]);
    if id == 0 { return "a pixel names an overlay that no ov line defines"; }
    if face < 0 { return "a face is px nx py ny pz or nz"; }
    for i in 0..run {
        if model.inside(m, tx + i, ty, tz) {
            if !model.texSet(m, model.texKey(id, face, tx + i, ty, tz), cr * 65536 + cg * 256 + cb) { return "too many painted pixels"; }
        }
    }
    return "";
}

/// A `clip NAME SECONDS loop|once POSE[@SECONDS]...` line. Returns what is wrong, or "".
fn clipLine(w: []string, m: &Model): string {
    let secs: f32 = 0;
    if w.len < 4 || !parseF(w[2], &secs) || secs <= 0 || (!same(w[3], "loop") && !same(w[3], "once")) {
        return "clip lines are: clip NAME SECONDS loop|once POSE[@SECONDS]...";
    }
    let id = rig.addClip(m, w[1], secs, same(w[3], "loop"));
    if id == 0 { return "too many clips (8 at most)"; }
    for i in 4..w.len {
        if !rig.clipKeyWord(m, id, w[i]) { return "a clip holds 16 poses at most, and a time is POSE@SECONDS"; }
    }
    rig.settleClip(m, id);
    return "";
}

/// A `part` line into the next part slot; `parents[id]` keeps the parent's name until all parts exist.
/// Returns what is wrong, or "".
fn partLine(w: []string, m: &Model, parents: []string): string {
    if w.len < 2 { return "part lines are: part NAME [parent P] [pivot X Y Z] [limit XMIN XMAX YMIN YMAX ZMIN ZMAX]"; }
    if m.partCount >= model.MAXPARTS { return "too many parts (32 at most)"; }
    m.partCount += 1;
    let id = m.partCount;
    m.parts[id] = rig.blank(own(m.mem, w[1]), 0);
    parents[id] = "";
    let i = 2;
    let f: f32 = 0;
    let g: f32 = 0;
    let h: f32 = 0;
    while i < w.len {
        if same(w[i], "parent") && i + 1 < w.len {
            parents[id] = w[i + 1];
            i += 2;
        } else if same(w[i], "pivot") && i + 3 < w.len && parseF(w[i + 1], &f) && parseF(w[i + 2], &g) && parseF(w[i + 3], &h) {
            m.parts[id].px = f;
            m.parts[id].py = g;
            m.parts[id].pz = h;
            i += 4;
        } else if same(w[i], "limit") && i + 6 < w.len {
            let lims: [6]f32 = [0, 0, 0, 0, 0, 0];
            for k in 0..6 {
                if !parseF(w[i + 1 + k], &lims[k]) { return "limit wants six numbers: XMIN XMAX YMIN YMAX ZMIN ZMAX"; }
            }
            m.parts[id].lx0 = lims[0];
            m.parts[id].lx1 = lims[1];
            m.parts[id].ly0 = lims[2];
            m.parts[id].ly1 = lims[3];
            m.parts[id].lz0 = lims[4];
            m.parts[id].lz1 = lims[5];
            i += 7;
        } else {
            return "part lines are: part NAME [parent P] [pivot X Y Z] [limit XMIN XMAX YMIN YMAX ZMIN ZMAX]";
        }
    }
    return "";
}

/// A `pose NAME PART rx ry rz ...` line into a new pose slot. Returns what is wrong, or "".
fn poseLine(w: []string, m: &Model): string {
    if w.len < 2 || (w.len - 2) % 4 != 0 { return "pose lines are: pose NAME [PART rx ry rz]..."; }
    if m.poseCount >= model.MAXPOSES { return "too many poses (16 at most)"; }
    m.poseCount += 1;
    let slot = m.poseCount;
    m.poseNames[slot] = own(m.mem, w[1]);
    let f: f32 = 0;
    let g: f32 = 0;
    let h: f32 = 0;
    let i = 2;
    while i < w.len {
        let id = rig.find(m, w[i]);
        if id == 0 { return "pose names a part that no part line defines"; }
        if !parseF(w[i + 1], &f) || !parseF(w[i + 2], &g) || !parseF(w[i + 3], &h) { return "pose angles must be numbers"; }
        m.poses[slot * model.POSE + id * 3] = f;
        m.poses[slot * model.POSE + id * 3 + 1] = g;
        m.poses[slot * model.POSE + id * 3 + 2] = h;
        i += 4;
    }
    return "";
}

fn fail(err: &Text, line: int, msg: string) {
    err.pushStr("line ");
    err.pushInt(line);
    err.pushStr(": ");
    err.pushStr(msg);
}

/// Read `.j3voxel` text into `m` (replacing its cells and palette). On a problem `err` says
/// which line, and `m` is left with what was read so far.
pub fn read(src: string, m: &Model, err: &Text): bool {
    model.clear(m);
    m.palLen = 0;
    for i in 0..256 { m.names[i] = ""; }
    m.partCount = 0;
    m.active = 0;
    m.poseCount = 0;
    m.clipCount = 0;
    m.overlayCount = 0;
    m.texelCount = 0;
    for i in 0..(model.MAXPOSES + 1) * model.POSE { m.poses[i] = 0; }
    let mem = Arena.create(64 * 1024);
    defer mem.destroy();
    let parents = mem.alloc::<string>(model.MAXPARTS + 1);
    let at = 0;
    let lineNo = 0;
    let sized = false;
    while at < src.len {
        let end = at;
        while end < src.len && src[end] != 10 { end += 1; }
        lineNo += 1;
        let w = words(trim(cut(src, at, end)), &mem);
        at = end + 1;
        if w.len == 0 { continue; }
        let n0 = 0;
        let n1 = 0;
        let n2 = 0;
        let n3 = 0;
        if same(w[0], "name") {
            if w.len > 1 { m.name = own(m.mem, w[1]); }
        } else if same(w[0], "size") {
            if w.len != 4 || !parseI(w[1], &n0) || !parseI(w[2], &n1) || !parseI(w[3], &n2) {
                fail(err, lineNo, "size wants three numbers: size 16 16 16");
                return false;
            }
            if n0 < 1 || n1 < 1 || n2 < 1 || n0 > model.MAX || n1 > model.MAX || n2 > model.MAX {
                fail(err, lineNo, "each side of size must be 1 to 64");
                return false;
            }
            m.sx = n0;
            m.sy = n1;
            m.sz = n2;
            sized = true;
        } else if same(w[0], "p") {
            let r = 0;
            let g = 0;
            let b = 0;
            if w.len < 3 || !parseI(w[1], &n0) || n0 < 1 || n0 > 255 || !model.parseHex(w[2], &r, &g, &b) {
                fail(err, lineNo, "palette lines are: p <1..255> <rrggbb> [name]");
                return false;
            }
            model.setColor(m, n0, r, g, b);
            m.names[n0] = "";
            if w.len > 3 { m.names[n0] = own(m.mem, w[3]); }
        } else if same(w[0], "v") {
            if !sized {
                fail(err, lineNo, "put the size line before the first v line");
                return false;
            }
            if w.len < 5 || !parseI(w[1], &n0) || !parseI(w[2], &n1) || !parseI(w[3], &n2) || !parseI(w[4], &n3) {
                fail(err, lineNo, "voxel lines are: v x y z color [run]");
                return false;
            }
            let run = 1;
            if w.len > 5 && !parseI(w[5], &run) {
                fail(err, lineNo, "the run length after the color must be a number");
                return false;
            }
            if n3 < 1 || n3 > 255 {
                fail(err, lineNo, "color must be a palette index from 1 to 255");
                return false;
            }
            for i in 0..run {
                if model.inside(m, n0 + i, n1, n2) { m.cells[voxel.index(n0 + i, n1, n2, m.sx, m.sz)] = u8(n3); }
            }
            if n3 > m.palLen { model.setColor(m, n3, 255, 0, 255); }
        } else if same(w[0], "vp") {
            if !sized {
                fail(err, lineNo, "put the size line before the first vp line");
                return false;
            }
            if w.len < 5 || !parseI(w[1], &n0) || !parseI(w[2], &n1) || !parseI(w[3], &n2) || !parseI(w[4], &n3) {
                fail(err, lineNo, "part layer lines are: vp x y z part [run]");
                return false;
            }
            let prun = 1;
            if w.len > 5 && !parseI(w[5], &prun) {
                fail(err, lineNo, "the run length after the part must be a number");
                return false;
            }
            if n3 < 1 || n3 > model.MAXPARTS {
                fail(err, lineNo, "part must be a number from 1 to 32");
                return false;
            }
            for i in 0..prun {
                if model.inside(m, n0 + i, n1, n2) { m.part[voxel.index(n0 + i, n1, n2, m.sx, m.sz)] = u8(n3); }
            }
        } else if same(w[0], "part") {
            let why = partLine(w, m, parents);
            if why.len > 0 {
                fail(err, lineNo, why);
                return false;
            }
        } else if same(w[0], "ov") {
            let ovWhy = overlayLine(w, m);
            if ovWhy.len > 0 {
                fail(err, lineNo, ovWhy);
                return false;
            }
        } else if same(w[0], "ot") {
            let otWhy = texelLine(w, m);
            if otWhy.len > 0 {
                fail(err, lineNo, otWhy);
                return false;
            }
        } else if same(w[0], "clip") {
            let clipped = clipLine(w, m);
            if clipped.len > 0 {
                fail(err, lineNo, clipped);
                return false;
            }
        } else if same(w[0], "pose") {
            let posed = poseLine(w, m);
            if posed.len > 0 {
                fail(err, lineNo, posed);
                return false;
            }
        }
        // Unknown lines are ignored so the format can grow.
    }
    if !sized {
        fail(err, 1, "no size line");
        return false;
    }
    for i in 1..=m.partCount {
        if parents[i].len > 0 && !same(parents[i], "-") {
            let up = rig.find(m, parents[i]);
            if up == 0 {
                fail(err, 1, "a part names a parent that no part line defines");
                return false;
            }
            m.parts[i].parent = up;
        }
    }
    // Part numbers beyond the part lines mean nothing, and an empty cell has no part.
    for i in 0..m.sx * m.sy * m.sz {
        if m.cells[i] == 0 || int(m.part[i]) > m.partCount { m.part[i] = 0; }
    }
    m.undoCount = 0;
    m.redoCount = 0;
    m.dirty = false;
    m.rev += 1;
    return true;
}

/// Load a `.j3voxel` file into `m`. `err` says why not.
pub fn load(path: string, m: &Model, err: &Text): bool {
    let mem = Arena.create(8 * 1024 * 1024);
    defer mem.destroy();
    match io.readFile(path, &mem) {
        Result.Ok(bytes) {
            if !read(bytes as string, m, err) {
                err.pushStr(" in ");
                err.pushStr(path);
                return false;
            }
            return true;
        }
        Result.Err(_) {
            err.pushStr("cannot read ");
            err.pushStr(path);
            return false;
        }
    }
}

/// Write `m` to `path` as `.j3voxel`.
pub fn save(path: string, m: &Model, err: &Text): bool {
    let mem = Arena.create(4 * 1024 * 1024);
    defer mem.destroy();
    let t = Text.new(&mem);
    write(m, &t);
    match io.writeFile(path, t.bytes[0..t.len()]) {
        Result.Ok(_) {
            m.dirty = false;
            return true;
        }
        Result.Err(_) {
            err.pushStr("cannot write ");
            err.pushStr(path);
            err.pushStr(" (does its folder exist?)");
            return false;
        }
    }
}

/// Palette lines only (`.j3pal`), the same `p` lines the model file holds.
pub fn writePalette(m: &Model, out: &Text) {
    out.pushStr("# j3pal 1\n");
    for i in 1..=m.palLen {
        out.pushStr("p ");
        out.pushInt(i);
        out.push(32);
        pushHex2(out, model.color(m, i, 0));
        pushHex2(out, model.color(m, i, 1));
        pushHex2(out, model.color(m, i, 2));
        if m.names[i].len > 0 {
            out.push(32);
            out.pushStr(m.names[i]);
        }
        out.push(10);
    }
}

/// Replace the palette from `.j3pal` (or `.j3voxel`) text. Voxels keep their indices.
pub fn readPalette(src: string, m: &Model, err: &Text): bool {
    let mem = Arena.create(64 * 1024);
    defer mem.destroy();
    let at = 0;
    let lineNo = 0;
    let found = false;
    while at < src.len {
        let end = at;
        while end < src.len && src[end] != 10 { end += 1; }
        lineNo += 1;
        let w = words(trim(cut(src, at, end)), &mem);
        at = end + 1;
        if w.len == 0 || !same(w[0], "p") { continue; }
        let n0 = 0;
        let r = 0;
        let g = 0;
        let b = 0;
        if w.len < 3 || !parseI(w[1], &n0) || n0 < 1 || n0 > 255 || !model.parseHex(w[2], &r, &g, &b) {
            fail(err, lineNo, "palette lines are: p <1..255> <rrggbb> [name]");
            return false;
        }
        if !found {
            m.palLen = 0;
            for i in 0..256 { m.names[i] = ""; }
            found = true;
        }
        model.setColor(m, n0, r, g, b);
        if w.len > 3 { m.names[n0] = own(m.mem, w[3]); }
    }
    if !found { err.pushStr("no p lines in that file"); }
    return found;
}

pub fn loadPalette(path: string, m: &Model, err: &Text): bool {
    let mem = Arena.create(1024 * 1024);
    defer mem.destroy();
    match io.readFile(path, &mem) {
        Result.Ok(bytes) { return readPalette(bytes as string, m, err); }
        Result.Err(_) {
            err.pushStr("cannot read ");
            err.pushStr(path);
            return false;
        }
    }
}

pub fn savePalette(path: string, m: &Model, err: &Text): bool {
    let mem = Arena.create(64 * 1024);
    defer mem.destroy();
    let t = Text.new(&mem);
    writePalette(m, &t);
    match io.writeFile(path, t.bytes[0..t.len()]) {
        Result.Ok(_) { return true; }
        Result.Err(_) {
            err.pushStr("cannot write ");
            err.pushStr(path);
            return false;
        }
    }
}
