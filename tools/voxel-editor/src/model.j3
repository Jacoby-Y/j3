// The voxel model: a grid of palette indices (0 is air), the palette, symmetry, and undo.
// Every edit goes through `apply`, so mirrored editing works for every tool. Callers take a
// `snapshot` before an edit (a gesture, or one command) so `undo` can put the model back.

module voxel_editor.model;

use j3.gfx.voxel;
use j3.math.floor;
use j3.memory.Arena;
use j3.text.same;
use voxel_editor.util.{ hexValue, own };

/// Largest side of a model, in voxels.
pub const MAX: int = 64;
pub const ADD: int = 0;
pub const ERASE: int = 1;
pub const PAINT: int = 2;
const UNDOS: int = 40;
/// Parts are numbered 1..MAXPARTS; 0 means no part.
pub const MAXPARTS: int = 32;
/// Named poses, beside the live pose in slot 0.
pub const MAXPOSES: int = 64;
/// Floats in one pose: x, y, z rotation (degrees) per part, index `part * 3`.
pub const POSE: int = (MAXPARTS + 1) * 3;

/// Overlays: pixel layers on a part (see `overlay.j3`).
pub const MAXOVERLAYS: int = 16;
/// Painted pixels shared by all overlays, one `int` each: key * 2^24 + rgb.
pub const MAXTEXELS: int = 32768;
/// Keys per overlay: 6 faces of a 64 cubed grid.
const KEYS_PER_OVERLAY: int = 6 * 64 * 64 * 64;
const RGB_RANGE: int = 16777216;

/// A pixel layer on one part. `grow` 0 paints the part's own surface, N puts the pixels on a shell N voxels out.
pub struct Overlay {
    name: string;
    part: int;
    grow: int;
    visible: bool;
}

/// Animation clips, each a loop or one-shot through saved poses.
pub const MAXCLIPS: int = 8;
/// Poses one clip can pass through.
pub const CLIPKEYS: int = 16;

/// A clip: saved poses (by name) at `times` (seconds from the start, in order) over `seconds`. A loop returns from the last pose
/// to the first.
pub struct Clip {
    name: string;
    seconds: f32;
    loop: bool;
    count: int;
    keys: [16]string;
    times: [16]f32;
}

/// A rigid limb. Its joint is `pivot` (voxel-edge coordinates: voxel `x` spans `x..x+1`), turning
/// the part and its children relative to `parent` (0 for a root).
pub struct Part {
    name: string;
    parent: int;
    px: f32;
    py: f32;
    pz: f32;
    /// Rotation limits in degrees, per axis.
    lx0: f32;
    lx1: f32;
    ly0: f32;
    ly1: f32;
    lz0: f32;
    lz1: f32;
}

/// One undo step: the whole model.
pub struct Snap {
    sx: int;
    sy: int;
    sz: int;
    palLen: int;
    cells: []u8;
    pal: []u8;
    names: []string;
    part: []u8;
    parts: []Part;
    partCount: int;
    active: int;
    poses: []f32;
    poseNames: []string;
    poseCount: int;
    clips: []Clip;
    clipCount: int;
    overlays: []Overlay;
    overlayCount: int;
    texels: []int;
    texelCount: int;
}

pub struct Model {
    mem: &Arena;
    name: string;
    sx: int;
    sy: int;
    sz: int;
    /// `sx * sy * sz` ids used, indexed with `voxel.index(x, y, z, sx, sz)`. Room for `MAX` cubed.
    cells: []u8;
    /// Palette color `i` (1..palLen) is rgb at `pal[i * 3]`.
    pal: []u8;
    names: []string;
    palLen: int;
    symX: bool;
    symY: bool;
    symZ: bool;
    tmp: []u8;
    work: []int;
    /// Part id per cell (0 none), parallel to `cells`; only meaningful where a voxel is. New voxels
    /// get `active`.
    part: []u8;
    ptmp: []u8;
    /// Parts 1..partCount (slot 0 unused).
    parts: []Part;
    partCount: int;
    active: int;
    /// Slot 0 is the live pose; named poses are slots 1..poseCount (names in `poseNames[slot]`).
    poses: []f32;
    poseNames: []string;
    poseCount: int;
    /// Clips 1..clipCount (slot 0 unused).
    clips: []Clip;
    clipCount: int;
    /// Overlays 1..overlayCount (slot 0 unused), and their pixels sorted by key (see `texKey`).
    overlays: []Overlay;
    overlayCount: int;
    texels: []int;
    texelCount: int;
    undos: []Snap;
    undoCount: int;
    redos: []Snap;
    redoCount: int;
    /// Moves on every change, so a viewer knows when to rebuild its mesh.
    rev: int;
    /// Changed since the last save.
    dirty: bool;
}

pub fn create(mem: &Arena, sx: int, sy: int, sz: int): Model {
    let m = Model {
        mem: mem, name: "model", sx: 1, sy: 1, sz: 1,
        cells: mem.alloc::<u8>(MAX * MAX * MAX), pal: mem.alloc::<u8>(256 * 3), names: mem.alloc::<string>(256),
        palLen: 0, symX: false, symY: false, symZ: false,
        tmp: mem.alloc::<u8>(MAX * MAX * MAX), work: mem.alloc::<int>(MAX * MAX * MAX),
        part: mem.alloc::<u8>(MAX * MAX * MAX), ptmp: mem.alloc::<u8>(MAX * MAX * MAX),
        parts: mem.alloc::<Part>(MAXPARTS + 1), partCount: 0, active: 0,
        poses: mem.alloc::<f32>((MAXPOSES + 1) * POSE), poseNames: mem.alloc::<string>(MAXPOSES + 1), poseCount: 0,
        clips: mem.alloc::<Clip>(MAXCLIPS + 1), clipCount: 0,
        overlays: mem.alloc::<Overlay>(MAXOVERLAYS + 1), overlayCount: 0, texels: mem.alloc::<int>(MAXTEXELS), texelCount: 0,
        undos: mem.alloc::<Snap>(UNDOS), undoCount: 0, redos: mem.alloc::<Snap>(UNDOS), redoCount: 0,
        rev: 1, dirty: false,
    };
    m.sx = clampSide(sx);
    m.sy = clampSide(sy);
    m.sz = clampSide(sz);
    loadPreset(&m, "default");
    m.dirty = false;
    return m;
}

pub fn clampSide(n: int): int {
    if n < 1 { return 1; }
    if n > MAX { return MAX; }
    return n;
}

pub fn touch(m: &Model) {
    m.rev += 1;
    m.dirty = true;
}

pub fn inside(m: &Model, x: int, y: int, z: int): bool {
    return x >= 0 && y >= 0 && z >= 0 && x < m.sx && y < m.sy && z < m.sz;
}

/// The id at `(x, y, z)`, 0 outside the grid.
pub fn get(m: &Model, x: int, y: int, z: int): int {
    if !inside(m, x, y, z) { return 0; }
    return int(m.cells[voxel.index(x, y, z, m.sx, m.sz)]);
}

pub fn count(m: &Model): int {
    let n = 0;
    for i in 0..m.sx * m.sy * m.sz {
        if m.cells[i] != 0 { n += 1; }
    }
    return n;
}

// ---------------------------------------------------------------------------------- palette

pub fn color(m: &Model, i: int, ch: int): int {
    return int(m.pal[i * 3 + ch]);
}

// -------------------------------------------------------------------------------------- undo

fn capture(m: &Model, s: &Snap) {
    let n = m.sx * m.sy * m.sz;
    if s.cells.len == 0 {
        s.cells = m.mem.alloc::<u8>(MAX * MAX * MAX);
        s.pal = m.mem.alloc::<u8>(256 * 3);
        s.names = m.mem.alloc::<string>(256);
        s.part = m.mem.alloc::<u8>(MAX * MAX * MAX);
        s.parts = m.mem.alloc::<Part>(MAXPARTS + 1);
        s.poses = m.mem.alloc::<f32>((MAXPOSES + 1) * POSE);
        s.poseNames = m.mem.alloc::<string>(MAXPOSES + 1);
        s.clips = m.mem.alloc::<Clip>(MAXCLIPS + 1);
        s.overlays = m.mem.alloc::<Overlay>(MAXOVERLAYS + 1);
    }
    // Pixels cost 256 KB a step, so only models that have them pay.
    if m.texelCount > 0 && s.texels.len == 0 { s.texels = m.mem.alloc::<int>(MAXTEXELS); }
    s.sx = m.sx;
    s.sy = m.sy;
    s.sz = m.sz;
    s.palLen = m.palLen;
    for i in 0..n { s.cells[i] = m.cells[i]; }
    for i in 0..768 { s.pal[i] = m.pal[i]; }
    for i in 0..256 { s.names[i] = m.names[i]; }
    for i in 0..n { s.part[i] = m.part[i]; }
    s.partCount = m.partCount;
    s.active = m.active;
    for i in 0..=m.partCount { s.parts[i] = m.parts[i]; }
    s.poseCount = m.poseCount;
    for i in 0..(MAXPOSES + 1) * POSE { s.poses[i] = m.poses[i]; }
    for i in 0..=m.poseCount { s.poseNames[i] = m.poseNames[i]; }
    s.clipCount = m.clipCount;
    for i in 0..=m.clipCount { s.clips[i] = m.clips[i]; }
    s.overlayCount = m.overlayCount;
    for i in 0..=m.overlayCount { s.overlays[i] = m.overlays[i]; }
    s.texelCount = m.texelCount;
    for i in 0..m.texelCount { s.texels[i] = m.texels[i]; }
}

fn restore(m: &Model, s: &Snap) {
    m.sx = s.sx;
    m.sy = s.sy;
    m.sz = s.sz;
    m.palLen = s.palLen;
    for i in 0..s.sx * s.sy * s.sz { m.cells[i] = s.cells[i]; }
    for i in 0..768 { m.pal[i] = s.pal[i]; }
    for i in 0..256 { m.names[i] = s.names[i]; }
    for i in 0..s.sx * s.sy * s.sz { m.part[i] = s.part[i]; }
    m.partCount = s.partCount;
    m.active = s.active;
    for i in 0..=s.partCount { m.parts[i] = s.parts[i]; }
    m.poseCount = s.poseCount;
    for i in 0..(MAXPOSES + 1) * POSE { m.poses[i] = s.poses[i]; }
    for i in 0..=s.poseCount { m.poseNames[i] = s.poseNames[i]; }
    m.clipCount = s.clipCount;
    for i in 0..=s.clipCount { m.clips[i] = s.clips[i]; }
    m.overlayCount = s.overlayCount;
    for i in 0..=s.overlayCount { m.overlays[i] = s.overlays[i]; }
    m.texelCount = s.texelCount;
    for i in 0..s.texelCount { m.texels[i] = s.texels[i]; }
    touch(m);
}

/// Push the current state as an undo step (and forget redo).
pub fn snapshot(m: &Model) {
    m.redoCount = 0;
    if m.undoCount == UNDOS {
        // Drop the oldest, reusing its buffers for the newest.
        let oldest = m.undos[0];
        for i in 1..UNDOS { m.undos[i - 1] = m.undos[i]; }
        m.undos[UNDOS - 1] = oldest;
        m.undoCount = UNDOS - 1;
    }
    capture(m, &m.undos[m.undoCount]);
    m.undoCount += 1;
}

/// Drop the newest undo step again (a gesture that changed nothing).
pub fn discardSnapshot(m: &Model) {
    if m.undoCount > 0 { m.undoCount -= 1; }
}

pub fn undo(m: &Model): bool {
    if m.undoCount == 0 { return false; }
    if m.redoCount == UNDOS {
        let oldest = m.redos[0];
        for i in 1..UNDOS { m.redos[i - 1] = m.redos[i]; }
        m.redos[UNDOS - 1] = oldest;
        m.redoCount = UNDOS - 1;
    }
    capture(m, &m.redos[m.redoCount]);
    m.redoCount += 1;
    m.undoCount -= 1;
    restore(m, &m.undos[m.undoCount]);
    return true;
}

pub fn redo(m: &Model): bool {
    if m.redoCount == 0 { return false; }
    capture(m, &m.undos[m.undoCount]);
    m.undoCount += 1;
    m.redoCount -= 1;
    restore(m, &m.redos[m.redoCount]);
    return true;
}

// -------------------------------------------------------------------------------- single cells

fn one(m: &Model, x: int, y: int, z: int, mode: int, c: int) {
    if !inside(m, x, y, z) { return; }
    let at = voxel.index(x, y, z, m.sx, m.sz);
    if mode == ADD {
        m.cells[at] = u8(c);
        m.part[at] = if c == 0 { 0 } else { u8(m.active) };
    }
    else if mode == ERASE { m.cells[at] = 0; m.part[at] = 0; }
    else if m.cells[at] != 0 { m.cells[at] = u8(c); }
}

/// Write a cell with an explicit part (moving voxels keeps their parts).
fn put(m: &Model, x: int, y: int, z: int, c: int, p: int) {
    if !inside(m, x, y, z) { return; }
    let at = voxel.index(x, y, z, m.sx, m.sz);
    m.cells[at] = u8(c);
    m.part[at] = u8(p);
}

/// Copy cells and parts to `tmp` / `ptmp`.
fn stash(m: &Model) {
    for i in 0..m.sx * m.sy * m.sz { m.tmp[i] = m.cells[i]; m.ptmp[i] = m.part[i]; }
}

/// Write one voxel (and its mirrors, when symmetry is on). `mode` is ADD, ERASE, or PAINT
/// (recolor only what is already there).
pub fn apply(m: &Model, x: int, y: int, z: int, mode: int, c: int) {
    let nx = if m.symX { 2 } else { 1 };
    let ny = if m.symY { 2 } else { 1 };
    let nz = if m.symZ { 2 } else { 1 };
    for a in 0..nx {
        for b in 0..ny {
            for d in 0..nz {
                one(m, if a == 1 { m.sx - 1 - x } else { x }, if b == 1 { m.sy - 1 - y } else { y },
                    if d == 1 { m.sz - 1 - z } else { z }, mode, c);
            }
        }
    }
    m.rev += 1;
    m.dirty = true;
}

/// Put the model back to the newest undo step without removing it (to redo a live preview).
pub fn rollback(m: &Model) {
    if m.undoCount > 0 { restore(m, &m.undos[m.undoCount - 1]); }
}

/// Whether the cells equal the newest undo step's (a gesture that changed nothing).
pub fn sameAsSnapshot(m: &Model): bool {
    if m.undoCount == 0 { return false; }
    let s = m.undos[m.undoCount - 1];
    if s.sx != m.sx || s.sy != m.sy || s.sz != m.sz || s.palLen != m.palLen { return false; }
    for i in 0..m.sx * m.sy * m.sz {
        if s.cells[i] != m.cells[i] || s.part[i] != m.part[i] { return false; }
    }
    for i in 0..768 {
        if s.pal[i] != m.pal[i] { return false; }
    }
    if s.texelCount != m.texelCount || s.overlayCount != m.overlayCount { return false; }
    for i in 0..m.texelCount {
        if s.texels[i] != m.texels[i] { return false; }
    }
    return true;
}
