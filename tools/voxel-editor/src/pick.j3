// Which voxel a ray hits, and which empty cell sits in front of it.

module voxel_editor.pick;

use j3.math.{ Vec3, floor };
use voxel_editor.model;
use voxel_editor.model.Model;

pub struct Pick {
    /// A voxel was hit, or the floor under the model.
    ok: bool;
    /// A voxel (not only the floor) was hit; `x y z` is it.
    solid: bool;
    x: int;
    y: int;
    z: int;
    /// The cell in front of the face that was hit (where a new voxel goes).
    px: int;
    py: int;
    pz: int;
    /// Axis (0 x, 1 y, 2 z) of the face that was hit, and which way it points (+1 or -1).
    axis: int;
    sign: int;
}

pub fn none(): Pick {
    return Pick { ok: false, solid: false, x: 0, y: 0, z: 0, px: 0, py: 0, pz: 0, axis: 1, sign: 1 };
}

fn abs(v: f32): f32 {
    if v < 0 { return 0 - v; }
    return v;
}

/// March a ray through the model's box. A ray leaving through the bottom counts as hitting the
/// floor, so the first voxels can go on an empty grid.
pub fn cast(m: &Model, origin: Vec3, dir: Vec3): Pick {
    let o: [3]f32 = [origin.x, origin.y, origin.z];
    let d: [3]f32 = [dir.x, dir.y, dir.z];
    let size: [3]int = [m.sx, m.sy, m.sz];
    let t0: f32 = 0;
    let t1: f32 = 1000000;
    let enter = 1;
    for k in 0..3 {
        let hi = f32(size[k]);
        if abs(d[k]) < 0.000001 {
            if o[k] < 0 || o[k] > hi { return none(); }
        } else {
            let ta = (0 - o[k]) / d[k];
            let tb = (hi - o[k]) / d[k];
            if ta > tb {
                let swap = ta;
                ta = tb;
                tb = swap;
            }
            if ta > t0 {
                t0 = ta;
                enter = k;
            }
            if tb < t1 { t1 = tb; }
            if t0 > t1 { return none(); }
        }
    }
    // Start a hair inside the box.
    let t = t0 + 0.0005;
    let start: [3]f32 = [o[0] + d[0] * t, o[1] + d[1] * t, o[2] + d[2] * t];
    let cell: [3]int = [0, 0, 0];
    let step: [3]int = [1, 1, 1];
    let tMax: [3]f32 = [0, 0, 0];
    let tDelta: [3]f32 = [0, 0, 0];
    for k in 0..3 {
        cell[k] = int(floor(start[k]));
        if cell[k] < 0 { cell[k] = 0; }
        if cell[k] >= size[k] { cell[k] = size[k] - 1; }
        tMax[k] = 1000000;
        tDelta[k] = 1000000;
        if d[k] > 0 {
            tDelta[k] = 1 / d[k];
            tMax[k] = (f32(cell[k] + 1) - start[k]) / d[k];
        } else if d[k] < 0 {
            step[k] = -1;
            tDelta[k] = 1 / (0 - d[k]);
            tMax[k] = (start[k] - f32(cell[k])) / (0 - d[k]);
        }
    }
    let left = t1 - t;
    let face = enter;
    let faceSign = if d[enter] > 0 { -1 } else { 1 };
    let n = 0;
    while n < 400 {
        n += 1;
        if model.get(m, cell[0], cell[1], cell[2]) != 0 {
            let p: [3]int = [cell[0], cell[1], cell[2]];
            p[face] += faceSign;
            return Pick { ok: true, solid: true, x: cell[0], y: cell[1], z: cell[2], px: p[0], py: p[1], pz: p[2],
                axis: face, sign: faceSign };
        }
        let k = 0;
        if tMax[1] < tMax[k] { k = 1; }
        if tMax[2] < tMax[k] { k = 2; }
        if tMax[k] > left {
            // Left the box without a voxel; through the bottom means the floor.
            if k == 1 && step[1] < 0 && cell[1] == 0 {
                return Pick { ok: true, solid: false, x: cell[0], y: 0, z: cell[2], px: cell[0], py: 0, pz: cell[2],
                    axis: 1, sign: 1 };
            }
            return none();
        }
        cell[k] += step[k];
        tMax[k] += tDelta[k];
        face = k;
        faceSign = 0 - step[k];
        if cell[k] < 0 || cell[k] >= size[k] {
            if k == 1 && step[1] < 0 {
                return Pick { ok: true, solid: false, x: cell[0], y: 0, z: cell[2], px: cell[0], py: 0, pz: cell[2],
                    axis: 1, sign: 1 };
            }
            return none();
        }
    }
    return none();
}

/// The cell where the ray crosses the middle of layer `layer` along `axis`, clamped into the
/// grid; false when the ray runs parallel to the layer.
pub fn onLayer(m: &Model, origin: Vec3, dir: Vec3, axis: int, layer: int, out: &[3]int): bool {
    let o: [3]f32 = [origin.x, origin.y, origin.z];
    let d: [3]f32 = [dir.x, dir.y, dir.z];
    if abs(d[axis]) < 0.00001 { return false; }
    let t = (f32(layer) + 0.5 - o[axis]) / d[axis];
    let size: [3]int = [m.sx, m.sy, m.sz];
    for k in 0..3 {
        let at = int(floor(o[k] + d[k] * t));
        if k == axis { at = layer; }
        if at < 0 { at = 0; }
        if at >= size[k] { at = size[k] - 1; }
        out[k] = at;
    }
    return true;
}
