// The few libc calls the editor needs: environment, file times, folders.

module voxel_editor.hostio;

use j3.io;
use j3.memory.{ Arena, scratch };
use j3.result.Result;
use j3.text.{ Text, cstr };

use lib "c" as libc {
    fn getenv(name: cstr): cstr;
    fn strlen(s: cstr): int;
    fn mkdir(path: cstr, mode: i32): i32;
    fn stat(path: cstr, buf: ptr): i32;
    fn system(command: cstr): i32;
    fn unlink(path: cstr): i32;
}

pub fn envValue(name: string, fallback: string): string {
    let raw = libc.getenv(cstr(name));
    if raw == 0 { return fallback; }
    let len = libc.strlen(raw);
    if len < 1 { return fallback; }
    return []u8 { ptr: raw as &u8, len: len } as string;
}

/// When `path` last changed (nanoseconds), or 0 when it cannot be read.
pub fn fileStamp(path: string): int {
    // ponytail: x86_64 Linux `struct stat`, st_mtim at byte 88 (same as the scene editor).
    let buf = scratch(0).alloc::<int>(18);
    if libc.stat(cstr(path), buf.ptr as ptr) != 0 { return 0; }
    return buf[11] * 1000000000 + buf[12];
}

/// Make every folder on the way to the file `path` (a no-op for ones that exist).
pub fn makeFolders(path: string, mem: &Arena) {
    for i in 1..path.len {
        if path[i] == 47 {
            let part = []u8 { ptr: path.ptr, len: i } as string;
            libc.mkdir(cstr(part), 493);
        }
    }
}

/// Where the chooser leaves the picked path (an empty file when cancelled).
pub const PICKED: string = "/tmp/voxel-editor-picked.txt";

/// Start the native file chooser (`zenity`) near `start` in the background, so the window keeps running; it writes the picked
/// path to `PICKED` when it closes.
pub fn startChooser(start: string) {
    libc.unlink(cstr(PICKED));
    let line = Text.new(scratch(0));
    line.pushStr("(zenity --file-selection --title='Open a model' --file-filter='Voxel models | *.j3voxel' --filename='");
    for i in 0..start.len { if start[i] != 39 { line.push(start[i]); } }
    line.pushStr("' > ");
    line.pushStr(PICKED);
    line.pushStr(".tmp 2>/dev/null; mv ");
    line.pushStr(PICKED);
    line.pushStr(".tmp ");
    line.pushStr(PICKED);
    line.pushStr(") &");
    libc.system(cstr(line.str()));
}

/// Forget a picked-file result.
pub fn clearPicked() {
    libc.unlink(cstr(PICKED));
}

/// The `.j3voxel` paths in `dir`, one per line (empty when there are none).
pub fn listModels(dir: string, mem: &Arena): string {
    let list = "/tmp/voxel-editor-list.txt";
    let line = Text.new(scratch(0));
    line.pushStr("ls -1 '");
    for i in 0..dir.len { if dir[i] != 39 { line.push(dir[i]); } }
    line.pushStr("'/*.j3voxel > ");
    line.pushStr(list);
    line.pushStr(" 2>/dev/null");
    libc.system(cstr(line.str()));
    match io.readFile(list, mem) {
        Result.Ok(bytes) { return bytes as string; }
        Result.Err(_) { return ""; }
    }
}
