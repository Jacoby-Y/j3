// Handles on the posed model, drawn over the voxels: a click-to-select marker at every joint, three rotation rings on the active
// joint (x red, y green, z blue, as the gimbal the pose angles make), and a reach handle on a wrist whose parent is an elbow hinge.

module voxel_editor.gizmo;

use j3.game;
use j3.game.Mouse;
use j3.gfx;
use j3.math.{ Vec2, Vec3, abs, atan2, clamp, cos, sin };
use j3.math.Mat4;
use voxel_editor.clipedit;
use voxel_editor.edit.say;
use voxel_editor.ik;
use voxel_editor.model;
use voxel_editor.rig;
use voxel_editor.view;
use voxel_editor.world.{ Gizmo, World };

const SEGMENTS: int = 48;
const RING_PX: f32 = 8;
const MARKER_PX: f32 = 10;
const REACH_PX: f32 = 14;
const MARKER: int = 10; // `hot` 10 + part id: a joint marker; 1..3 a ring; 4 the reach handle

pub fn none(): Gizmo {
    return Gizmo { grab: 0, hot: 0, last: 0.0, total: 0.0, base: 0.0, flip: 1.0, at0: Vec3.zero(), hit0: Vec3.zero() };
}

/// The active joint in the world: its pivot, and the axes of its three rotations (a turn is y, then x, then z, so the x ring turns
/// with y and the z ring with y and x).
struct Frame {
    at: Vec3;
    x: Vec3;
    y: Vec3;
    z: Vec3;
}

fn frame(w: &World): Frame {
    let m = &w.m;
    let id = m.active;
    let up = rig.worldMatrix(m, 0, m.parts[id].parent, 0);
    let origin = up.transformPoint(Vec3.zero());
    let ry = Mat4.rotate(Vec3.up(), m.poses[id * 3 + 1] / 57.29578);
    let rx = Mat4.rotate(Vec3.xyz(1, 0, 0), m.poses[id * 3] / 57.29578);
    return Frame {
        at: rig.pivotWorld(m, 0, id),
        x: up.transformPoint(ry.transformPoint(Vec3.xyz(1, 0, 0))) - origin,
        y: up.transformPoint(Vec3.up()) - origin,
        z: up.transformPoint(ry.mul(rx).transformPoint(Vec3.xyz(0, 0, 1))) - origin,
    };
}

fn axis(f: Frame, k: int): Vec3 {
    if k == 0 { return f.x; }
    if k == 1 { return f.y; }
    return f.z;
}

fn radius(w: &World): f32 {
    return clamp(w.cam.radius * 0.12, 3, 9);
}

/// Point `i` of the ring about axis `k`.
fn ringPoint(w: &World, f: Frame, k: int, i: int): Vec3 {
    let a = axis(f, k);
    let h = if abs(a.y) < 0.9 { Vec3.up() } else { Vec3.xyz(1, 0, 0) };
    let u = a.cross(h).normalize();
    let v = a.cross(u);
    let t = f32(i) * 6.2831855 / f32(SEGMENTS);
    return f.at + (u * cos(t) + v * sin(t)) * radius(w);
}

fn screen(p: Vec3): Vec3 {
    return gfx.toScreen(p);
}

/// Squared distance from `p` to the segment `a b`, in pixels.
fn segment(p: Vec2, a: Vec2, b: Vec2): f32 {
    let ab = b - a;
    let len2 = ab.x * ab.x + ab.y * ab.y;
    let t: f32 = 0;
    if len2 > 0.0001 { t = clamp(((p.x - a.x) * ab.x + (p.y - a.y) * ab.y) / len2, 0, 1); }
    let d = Vec2 { x: a.x + ab.x * t - p.x, y: a.y + ab.y * t - p.y };
    return d.x * d.x + d.y * d.y;
}

fn near(p: Vec2, at: Vec3): f32 {
    let s = screen(at);
    if s.z <= 0 { return 1000000; }
    let dx = s.x - p.x;
    let dy = s.y - p.y;
    return dx * dx + dy * dy;
}

/// The wrist the reach handle is on, or 0.
fn wrist(w: &World): int {
    if w.m.active == 0 || ik.shoulder(&w.m, w.m.active) == 0 { return 0; }
    return w.m.active;
}

/// What is under the pointer: 0 nothing, 1..3 a ring, 4 the reach handle, MARKER + part a joint marker.
fn pick(w: &World, mp: Vec2): int {
    let m = &w.m;
    if m.active == 0 { return 0; }
    if wrist(w) != 0 && near(mp, rig.pivotWorld(m, 0, m.active)) < REACH_PX * REACH_PX { return 4; }
    let best: f32 = MARKER_PX * MARKER_PX;
    let hit = 0;
    for id in 1..=m.partCount {
        if id == m.active { continue; }
        let d = near(mp, rig.pivotWorld(m, 0, id));
        if d < best { best = d; hit = MARKER + id; }
    }
    if hit != 0 { return hit; }
    let f = frame(w);
    let ringBest: f32 = RING_PX * RING_PX;
    for k in 0..3 {
        let prev = screen(ringPoint(w, f, k, 0));
        for i in 1..=SEGMENTS {
            let cur = screen(ringPoint(w, f, k, i % SEGMENTS));
            if prev.z > 0 && cur.z > 0 {
                let gap = segment(mp, Vec2 { x: prev.x, y: prev.y }, Vec2 { x: cur.x, y: cur.y });
                if gap < ringBest { ringBest = gap; hit = k + 1; }
            }
            prev = cur;
        }
    }
    return hit;
}

fn screenAngle(w: &World, mp: Vec2): f32 {
    let f = frame(w);
    let c = screen(f.at);
    return atan2(mp.y - c.y, mp.x - c.x);
}

fn turnBy(a: f32): f32 {
    return atan2(sin(a), cos(a));
}

/// Where the pointer's ray meets the plane through `at` that faces the camera.
fn onPlane(w: &World, at: Vec3): Vec3 {
    let ray = gfx.mouseRay(w.cam);
    let n = (w.cam.target - w.cam.eye()).normalize();
    let denom = ray.dir.dot(n);
    if abs(denom) < 0.00001 { return at; }
    return ray.origin + ray.dir * ((at - ray.origin).dot(n) / denom);
}

fn begin(w: &World, mp: Vec2) {
    let g = &w.gz;
    let m = &w.m;
    if g.hot >= MARKER {
        m.active = g.hot - MARKER;
        return;
    }
    model.snapshot(m);
    w.playing = false;
    g.grab = g.hot;
    if g.grab == 4 {
        g.at0 = rig.pivotWorld(m, 0, m.active);
        g.hit0 = onPlane(w, g.at0);
        return;
    }
    let k = g.grab - 1;
    let f = frame(w);
    let toward = (w.cam.target - w.cam.eye()).normalize();
    g.flip = if axis(f, k).dot(toward) < 0 { -1.0 } else { 1.0 };
    g.base = m.poses[m.active * 3 + k];
    g.last = screenAngle(w, mp);
    g.total = 0.0;
}

fn drag(w: &World, mp: Vec2) {
    let g = &w.gz;
    let m = &w.m;
    if g.grab == 4 {
        ik.reach(m, m.active, g.at0 + (onPlane(w, g.at0) - g.hit0));
        return;
    }
    let k = g.grab - 1;
    let now = screenAngle(w, mp);
    g.total += turnBy(now - g.last);
    g.last = now;
    let p = m.parts[m.active];
    let lo = p.lx0;
    let hi = p.lx1;
    if k == 1 { lo = p.ly0; hi = p.ly1; }
    if k == 2 { lo = p.lz0; hi = p.lz1; }
    let v = clamp(g.base + g.flip * g.total * 57.29578, lo, hi);
    let at = m.active * 3;
    rig.setPose(m, m.active, if k == 0 { v } else { m.poses[at] }, if k == 1 { v } else { m.poses[at + 1] }, if k == 2 { v } else { m.poses[at + 2] });
}

/// Once a frame in the Rig tab: hover, and a drag on a ring or the reach handle. True while the handles own the mouse (so the
/// tools must not use the click).
pub fn update(w: &World, mp: Vec2, inView: bool): bool {
    let g = &w.gz;
    if !w.rigTab || w.m.partCount == 0 { g.grab = 0; g.hot = 0; return false; }
    if g.grab == 0 {
        g.hot = if inView { pick(w, mp) } else { 0 };
        if g.hot != 0 && game.mousePressed(Mouse.Left) { begin(w, mp); return true; }
        return false;
    }
    if !game.mouseDown(Mouse.Left) {
        g.grab = 0;
        clipedit.autokey(w);
        return true;
    }
    drag(w, mp);
    return true;
}

fn ringColor(k: int, lit: bool): Vec3 {
    if lit { return Vec3.xyz(1, 1, 0.55); }
    if k == 0 { return Vec3.xyz(0.95, 0.25, 0.25); }
    if k == 1 { return Vec3.xyz(0.3, 0.85, 0.3); }
    return Vec3.xyz(0.35, 0.5, 1.0);
}

fn diamond(at: Vec3, r: f32, c: Vec3) {
    let ends = [Vec3.xyz(r, 0, 0), Vec3.xyz(0 - r, 0, 0), Vec3.xyz(0, r, 0), Vec3.xyz(0, 0 - r, 0), Vec3.xyz(0, 0, r), Vec3.xyz(0, 0, 0 - r)];
    for a in 0..6 {
        for b in (a + 1)..6 {
            if a / 2 != b / 2 { gfx.drawLine(at + ends[a], at + ends[b], c); }
        }
    }
}

/// Draw the handles over the voxels (inside the camera pass).
pub fn draw(w: &World) {
    let m = &w.m;
    if !w.rigTab || m.partCount == 0 || m.active == 0 { return; }
    gfx.clearDepth();
    view.drawJoints(m);
    let g = &w.gz;
    let f = frame(w);
    for k in 0..3 {
        let lit = g.hot == k + 1 || g.grab == k + 1;
        for pass in 0..2 {
            for i in 0..SEGMENTS {
                let a = ringPoint(w, f, k, i);
                let b = ringPoint(w, f, k, (i + 1) % SEGMENTS);
                let out = (a - f.at).normalize() * (0.08 * f32(pass) * radius(w));
                gfx.drawLine(a + out, b + out, ringColor(k, lit));
            }
        }
    }
    if wrist(w) != 0 {
        let held = g.hot == 4 || g.grab == 4;
        diamond(f.at, 0.9, if held { Vec3.xyz(1, 1, 0.55) } else { Vec3.xyz(1, 0.7, 0.1) });
    }
    if g.hot >= MARKER { diamond(rig.pivotWorld(m, 0, g.hot - MARKER), 0.6, Vec3.xyz(1, 1, 0.55)); }
}
