// Editor state: the model, the camera, the active tool, and the text fields.

module voxel_editor.world;

use j3.game.Font;
use j3.gfx.Orbit;
use j3.math.{ Vec2, Vec3 };
use j3.memory.Arena;
use j3.text.Text;
use voxel_editor.model.Model;
use voxel_editor.pick.Pick;
use voxel_editor.view.View;

pub const PENCIL: int = 0;
pub const BOX: int = 1;
pub const SPHERE: int = 2;
pub const CYLINDER: int = 3;
pub const LINE: int = 4;
pub const FILL: int = 5;
pub const PICKER: int = 6;
/// Rig tools: click a voxel to make its part active, paint voxels into the active part, put the
/// active part's joint on the face under the pointer.
pub const PARTPICK: int = 7;
pub const PARTPAINT: int = 8;
pub const PIVOT: int = 9;
/// Paint a face of the active overlay with the chosen color (erase mode clears it).
pub const OVPAINT: int = 10;

/// Panel sizes in pixels.
pub const TOP: f32 = 68;
pub const BOTTOM: f32 = 36;
/// Default widths of the side panels; the person drags their edges (`left`, `right` in `World`).
pub const LEFT: f32 = 230;
pub const RIGHT: f32 = 340;
pub const TIMELINE: f32 = 170;
pub const MIN_TIMELINE: f32 = 100;
pub const MAX_TIMELINE: f32 = 420;
pub const MIN_PANEL: f32 = 150;
pub const MAX_PANEL: f32 = 640;

/// The handles' drag state (see `gizmo.j3`): what is hovered and grabbed, and where the drag started.
pub struct Gizmo {
    grab: int;
    hot: int;
    last: f32;
    total: f32;
    base: f32;
    flip: f32;
    at0: Vec3;
    hit0: Vec3;
}

/// A model waiting in the background (see `tabs.j3`).
pub struct Tab {
    m: Model;
    path: Text;
    stamp: int;
    cam: Orbit;
    clip: int;
    playT: f32;
    key: int;
}

pub struct World {
    mem: &Arena;
    m: Model;
    /// Open models: slots 0..tabCount, the active one (`cur`) also live in `m`, `path`, `cam`.
    tabs: []Tab;
    tabCount: int;
    tab: int;
    view: View;
    font: Font;
    cam: Orbit;
    ortho: bool;
    grid: bool;
    shaded: bool;
    /// The file the model is saved to (a field in the right panel).
    path: Text;
    /// When `path` last changed on disk, as seen at the last load or save.
    stamp: int;
    pollTicks: int;
    saveTicks: int;
    tool: int;
    mode: int;
    color: int;
    brush: int;
    depth: int;
    hollow: bool;
    layerFill: bool;
    hover: Pick;
    /// A gesture (a drag with a tool) is in progress.
    active: bool;
    anchor: [3]int;
    cur: [3]int;
    last: [3]int;
    axis: int;
    sign: int;
    /// Plane lock: -1 follows the face under the pointer, 0/1/2 forces x/y/z.
    lock: int;
    lastMouse: Vec2;
    status: Text;
    console: Text;
    hexEdit: Text;
    nameEdit: Text;
    palFile: Text;
    palTop: int;
    palEditing: bool;
    closeWarned: bool;
    showHelp: bool;
    /// Output of the last console command, shown over the view until Esc.
    log: Text;
    /// The right panel shows the rig, not the file and palette.
    rigTab: bool;
    partTop: int;
    /// A part-paint drag is in progress.
    partDrag: bool;
    partTint: bool;
    /// The overlay the paint tool and the Overlays section act on (0 none), its cells, and the model
    /// revision they were computed at.
    ovActive: int;
    ovCells: []u8;
    ovRev: int;
    ovDrag: bool;
    ovFile: Text;
    ovGrow: int;
    partName: Text;
    poseName: Text;
    left: f32;
    right: f32;
    /// Which panel edge is being dragged: 0 none, 1 left panel, 2 right panel, 3 the top of the timeline.
    edge: int;
    gz: Gizmo;
    /// The clip the timeline edits (0 none), whether it is playing, the playhead in seconds, the selected key (-1 none), and
    /// what the pointer is dragging in the timeline (a key or the playhead).
    clip: int;
    playing: bool;
    playT: f32;
    key: int;
    keyDrag: bool;
    scrub: bool;
    /// A pose edit becomes a key at the playhead.
    autokey: bool;
    /// Timeline height in pixels (shown in the Rig tab).
    tl: f32;
    /// The file chooser is open.
    picking: bool;
}
