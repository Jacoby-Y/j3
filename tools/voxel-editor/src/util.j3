// Text helpers: slicing, splitting, and number parsing. No libc.

module voxel_editor.util;

use j3.data.save;
use j3.memory.Arena;
use j3.text.{ Text, same };

/// `s[a..b]` as a string.
pub fn cut(s: string, a: int, b: int): string {
    if a >= b { return ""; }
    return []u8 { ptr: (s.ptr as int + a) as &u8, len: b - a } as string;
}

pub fn isSpace(b: u8): bool {
    return b == 32 || b == 9 || b == 13;
}

/// Words of `line` split on spaces and tabs.
pub fn words(line: string, mem: &Arena): []string {
    let count = 0;
    let i = 0;
    while i < line.len {
        while i < line.len && isSpace(line[i]) { i += 1; }
        if i < line.len {
            count += 1;
            while i < line.len && !isSpace(line[i]) { i += 1; }
        }
    }
    let out = mem.alloc::<string>(count);
    let n = 0;
    i = 0;
    while i < line.len {
        while i < line.len && isSpace(line[i]) { i += 1; }
        let start = i;
        while i < line.len && !isSpace(line[i]) { i += 1; }
        if i > start {
            out[n] = cut(line, start, i);
            n += 1;
        }
    }
    return out;
}

/// `s` without a trailing `# comment` (a `#` at the start or followed by a space; `#rrggbb` is a
/// color), and without surrounding spaces.
pub fn trim(s: string): string {
    let end = s.len;
    let i = 0;
    while i < s.len {
        if s[i] == 35 && (i == 0 || i + 1 >= s.len || isSpace(s[i + 1])) { end = i; break; }
        i += 1;
    }
    let a = 0;
    while a < end && isSpace(s[a]) { a += 1; }
    while end > a && isSpace(s[end - 1]) { end -= 1; }
    return cut(s, a, end);
}

/// Whole-string integer, optional leading `-`.
pub fn parseI(s: string, out: &int): bool {
    if s.len == 0 { return false; }
    let i = 0;
    if s[0] == 45 || s[0] == 43 { i = 1; }
    if i >= s.len { return false; }
    while i < s.len {
        if s[i] < 48 || s[i] > 57 { return false; }
        i += 1;
    }
    *out = save.parseInt(s as []u8, if s[0] == 43 { 1 } else { 0 }, 0);
    return true;
}

/// Whole-string number, digits with an optional `.`.
pub fn parseF(s: string, out: &f32): bool {
    if s.len == 0 { return false; }
    let i = 0;
    if s[0] == 45 { i = 1; }
    let digits = 0;
    let dots = 0;
    while i < s.len {
        if s[i] == 46 { dots += 1; }
        else if s[i] >= 48 && s[i] <= 57 { digits += 1; }
        else { return false; }
        i += 1;
    }
    if digits == 0 || dots > 1 { return false; }
    *out = save.parseFloat(s as []u8, 0);
    return true;
}

pub fn startsWith(s: string, p: string): bool {
    if s.len < p.len { return false; }
    return same(cut(s, 0, p.len), p);
}

pub fn endsWith(s: string, p: string): bool {
    if s.len < p.len { return false; }
    return same(cut(s, s.len - p.len, s.len), p);
}

/// Copy of `s` on `mem`.
pub fn own(mem: &Arena, s: string): string {
    let b = mem.alloc::<u8>(s.len);
    for i in 0..s.len { b[i] = s[i]; }
    return b as string;
}

/// Lowercase hex digit of `v` (0..15).
pub fn hexDigit(v: int): u8 {
    if v < 10 { return u8(48 + v); }
    return u8(87 + v);
}

pub fn hexValue(b: u8): int {
    if b >= 48 && b <= 57 { return int(b) - 48; }
    if b >= 97 && b <= 102 { return int(b) - 87; }
    if b >= 65 && b <= 70 { return int(b) - 55; }
    return -1;
}

/// Append `v` (0..255) as two hex digits.
pub fn pushHex2(t: &Text, v: int) {
    t.push(hexDigit(v / 16));
    t.push(hexDigit(v % 16));
}

/// Base-36 digit for palette dumps: 1-9, a-z, A-Z.
pub fn glyph(c: int): u8 {
    if c == 0 { return 46; }
    if c < 10 { return u8(48 + c); }
    if c < 36 { return u8(87 + c); }
    if c < 62 { return u8(29 + c); }
    return 35;
}
