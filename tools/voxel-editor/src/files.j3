// File actions for the window: save, open, new, export, palettes, and noticing outside edits.

module voxel_editor.files;

use j3.io.exists;
use j3.memory.scratch;
use j3.text.Text;
use voxel_editor.cmd;
use voxel_editor.edit.{ frame, say, say2 };
use voxel_editor.format;
use voxel_editor.hostio;
use voxel_editor.mesh;
use voxel_editor.model;
use voxel_editor.util.{ cut, endsWith, parseF };
use voxel_editor.world.World;

/// The file field, with `.j3voxel` added to a bare name.
pub fn pathNow(w: &World): string {
    return cmd.fileName(w.path.str(), scratch(0));
}

fn rememberStamp(w: &World) {
    w.stamp = hostio.fileStamp(pathNow(w));
}

pub fn save(w: &World) {
    let path = pathNow(w);
    let err = Text.new(scratch(0));
    hostio.makeFolders(path, scratch(0));
    if format.save(path, &w.m, &err) {
        rememberStamp(w);
        w.closeWarned = false;
        say2(w, "Saved ", path);
    } else {
        say(w, err.str());
    }
}

/// Load the file named in the field.
pub fn open(w: &World) {
    let path = pathNow(w);
    let err = Text.new(scratch(0));
    if !exists(path) {
        say(w, "No such file yet (Save creates it)");
        return;
    }
    if format.load(path, &w.m, &err) {
        rememberStamp(w);
        frame(w);
        say2(w, "Opened ", path);
    } else {
        say(w, err.str());
    }
}

/// An empty model of the current size (an undo step).
pub fn fresh(w: &World) {
    model.snapshot(&w.m);
    model.clear(&w.m);
    say(w, "Cleared (Ctrl+Z brings it back)");
}

/// Write the model as a `.j3mesh` next to the file, for the scene editor.
pub fn exportMesh(w: &World) {
    let path = pathNow(w);
    let base = path;
    if endsWith(path, ".j3voxel") { base = cut(path, 0, path.len - 8); }
    let out = Text.new(scratch(0));
    out.pushStr(base);
    out.pushStr(".j3mesh");
    let err = Text.new(scratch(0));
    hostio.makeFolders(out.str(), scratch(0));
    if mesh.exportMesh(&w.m, out.str(), 0.1, &err) { say2(w, "Exported ", out.str()); }
    else { say(w, err.str()); }
}

fn palettePath(w: &World): string {
    let t = Text.new(scratch(0));
    t.pushStr("palettes/");
    t.pushStr(w.palFile.str());
    if !endsWith(w.palFile.str(), ".j3pal") { t.pushStr(".j3pal"); }
    return t.str();
}

pub fn savePalette(w: &World) {
    if w.palFile.len() == 0 {
        say(w, "Type a palette name first");
        return;
    }
    let path = palettePath(w);
    let err = Text.new(scratch(0));
    hostio.makeFolders(path, scratch(0));
    if format.savePalette(path, &w.m, &err) { say2(w, "Saved palette ", path); }
    else { say(w, err.str()); }
}

pub fn loadPalette(w: &World) {
    let path = palettePath(w);
    let err = Text.new(scratch(0));
    model.snapshot(&w.m);
    if format.loadPalette(path, &w.m, &err) { say2(w, "Loaded palette ", path); }
    else {
        model.discardSnapshot(&w.m);
        say(w, err.str());
    }
}

/// Once a second: pick up edits made to the open file by someone else (an agent, a text editor).
pub fn watch(w: &World) {
    w.pollTicks += 1;
    if w.pollTicks < 30 || w.active { return; }
    w.pollTicks = 0;
    let path = pathNow(w);
    let now = hostio.fileStamp(path);
    if now == 0 || now == w.stamp { return; }
    if w.m.dirty {
        // Do not trample unsaved work; say so once.
        w.stamp = now;
        say(w, "The file changed on disk, but you have unsaved edits. Open (the button) loads it.");
        return;
    }
    let err = Text.new(scratch(0));
    if format.load(path, &w.m, &err) {
        w.stamp = now;
        say2(w, "Reloaded after an outside change: ", path);
    }
}
