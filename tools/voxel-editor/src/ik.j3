// Posing math for the handles: a part's turn as angles and back, and two-bone reach (shoulder, elbow hinge, wrist).
// Angles are degrees, in the order `rig` turns a part: about y, then x, then z.

module voxel_editor.ik;

use j3.math.{ Vec3, abs, acos, asin, atan2, clamp, cos, sin };
use j3.math.Mat4;
use voxel_editor.model;
use voxel_editor.model.Model;
use voxel_editor.rig;

const DEG: f32 = 57.29578;

fn ex(): Vec3 { return Vec3.xyz(1, 0, 0); }
fn ey(): Vec3 { return Vec3.xyz(0, 1, 0); }
fn ez(): Vec3 { return Vec3.xyz(0, 0, 1); }

/// The turn of angles `rx ry rz` (degrees).
pub fn turn(rx: f32, ry: f32, rz: f32): Mat4 {
    return Mat4.rotate(ey(), ry / DEG).mul(Mat4.rotate(ex(), rx / DEG)).mul(Mat4.rotate(ez(), rz / DEG));
}

/// An angle wrapped into -180..180.
pub fn wrap(a: f32): f32 {
    return atan2(sin(a / DEG), cos(a / DEG)) * DEG;
}

fn inside(lo: f32, hi: f32, v: f32): bool {
    return v >= lo - 0.01 && v <= hi + 0.01;
}

/// How far candidate `(x, y, z)` is from the part's current angles, or a huge number when a limit refuses it.
fn cost(m: &Model, id: int, x: f32, y: f32, z: f32): f32 {
    let p = m.parts[id];
    let at = id * 3;
    let miss: f32 = 0;
    if !inside(p.lx0, p.lx1, x) { miss += 1000; }
    if !inside(p.ly0, p.ly1, y) { miss += 1000; }
    if !inside(p.lz0, p.lz1, z) { miss += 1000; }
    return miss + abs(wrap(x - m.poses[at])) + abs(wrap(y - m.poses[at + 1])) + abs(wrap(z - m.poses[at + 2]));
}

/// Set part `id` to the turn `r` (a pure rotation), taking of the two angle sets that give it the one inside the limits and nearest
/// the current angles.
pub fn setTurn(m: &Model, id: int, r: Mat4) {
    let c2 = r.transformPoint(ez());
    let c0 = r.transformPoint(ex());
    let b = asin(clamp(0 - c2.y, -1, 1)) * DEG;
    let a = atan2(c2.x, c2.z) * DEG;
    let c1 = r.transformPoint(ey());
    let c = atan2(c0.y, c1.y) * DEG;
    let b2 = wrap(180 - b);
    let a2 = wrap(a + 180);
    let c2n = wrap(c + 180);
    let p = m.parts[id];
    let one = cost(m, id, b, a, c);
    let two = cost(m, id, b2, a2, c2n);
    if two < one { a = a2; b = b2; c = c2n; }
    rig.setPose(m, id, clamp(b, p.lx0, p.lx1), clamp(a, p.ly0, p.ly1), clamp(c, p.lz0, p.lz1));
}

/// A part that bends about x only (its y and z limits are shut).
pub fn hinge(m: &Model, id: int): bool {
    let p = m.parts[id];
    return p.ly0 == p.ly1 && p.lz0 == p.lz1;
}

/// The shoulder part for a wrist `c`: `c`'s parent must be a hinge with a parent of its own. 0 when there is none.
pub fn shoulder(m: &Model, c: int): int {
    let b = m.parts[c].parent;
    if b == 0 || !hinge(m, b) { return 0; }
    return m.parts[b].parent;
}

fn pivot(m: &Model, id: int): Vec3 {
    return Vec3.xyz(m.parts[id].px, m.parts[id].py, m.parts[id].pz);
}

/// The elbow angle in `from..to` (stepping `step`) whose shoulder-to-wrist distance is nearest `dist`.
fn scan(b1: Vec3, b2: Vec3, dist: f32, from: f32, to: f32, step: f32): f32 {
    let best = from;
    let bestMiss: f32 = 1000000;
    let e = from;
    while e <= to {
        let miss = abs((b1 + Mat4.rotate(ex(), e / DEG).transformPoint(b2)).length() - dist);
        if miss < bestMiss { bestMiss = miss; best = e; }
        e += step;
    }
    return best;
}

/// Turn the shoulder and bend the hinge so part `c`'s pivot lands on `target` (a world point), or as near as the limits allow.
pub fn reach(m: &Model, c: int, target: Vec3) {
    let b = m.parts[c].parent;
    let g = m.parts[b].parent;
    let pg = rig.worldMatrix(m, 0, m.parts[g].parent, 0);
    let want = pg.inverseAffine().transformPoint(target) - pivot(m, g);
    let b1 = pivot(m, b) - pivot(m, g);
    let b2 = pivot(m, c) - pivot(m, b);
    let dist = want.length();
    // The elbow angle that gives the right shoulder-to-wrist distance: scan, then refine.
    let lo = m.parts[b].lx0;
    let hi = m.parts[b].lx1;
    let best = scan(b1, b2, dist, lo, hi, 1);
    best = scan(b1, b2, dist, clamp(best - 1, lo, hi), clamp(best + 1, lo, hi), 0.1);
    let arm = b1 + Mat4.rotate(ex(), best / DEG).transformPoint(b2);
    // Swing the shoulder by the smallest turn that aims the arm at the target (the roll stays as it was).
    let at = g * 3;
    let cur = turn(m.poses[at], m.poses[at + 1], m.poses[at + 2]);
    let now = cur.transformPoint(arm).normalize();
    let to = want.normalize();
    let axis = now.cross(to);
    let swing = Mat4.identity();
    if axis.length() > 0.00001 { swing = Mat4.rotate(axis.normalize(), acos(clamp(now.dot(to), -1, 1))); }
    rig.setPose(m, b, best, m.poses[b * 3 + 1], m.poses[b * 3 + 2]);
    setTurn(m, g, swing.mul(cur));
}
