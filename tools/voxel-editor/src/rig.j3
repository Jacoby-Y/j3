// Rigging: parts (rigid limbs), the joints that join them, poses, and checks. A part is a set of
// voxels (`Model.part` ids); its joint is its pivot, turning it and its children about the parent.
// Voxel edge coordinates: voxel `x` spans `x..x+1`, so a pivot on a face is a whole number.

module voxel_editor.rig;

use j3.gfx.voxel;
use j3.math.{ Mat4, PI, Vec3, floor };
use j3.memory.Arena;
use j3.text.{ Text, same };
use voxel_editor.model;
use voxel_editor.overlay;
use voxel_editor.model.{ CLIPKEYS, Clip, MAXCLIPS, MAXPARTS, MAXPOSES, POSE, Model, Part };
use voxel_editor.util.{ cut, own, parseF };

/// Part id named `name`, or 0.
pub fn find(m: &Model, name: string): int {
    for i in 1..=m.partCount {
        if same(m.parts[i].name, name) { return i; }
    }
    return 0;
}

pub fn blank(name: string, parent: int): Part {
    return Part {
        name: name, parent: parent, px: 0, py: 0, pz: 0,
        lx0: -180, lx1: 180, ly0: -180, ly1: 180, lz0: -180, lz1: 180,
    };
}

/// Add a part; its id, or 0 when the name is taken or the table is full.
pub fn add(m: &Model, name: string, parent: int): int {
    if name.len == 0 || find(m, name) != 0 || m.partCount >= MAXPARTS { return 0; }
    m.partCount += 1;
    m.parts[m.partCount] = blank(own(m.mem, name), parent);
    model.touch(m);
    return m.partCount;
}

/// True when `child` is `ancestor` or sits below it.
pub fn under(m: &Model, child: int, ancestor: int): bool {
    let at = child;
    let steps = 0;
    while at != 0 && steps <= MAXPARTS {
        if at == ancestor { return true; }
        at = m.parts[at].parent;
        steps += 1;
    }
    return false;
}

/// Delete a part: its voxels become unassigned, its children move up to its parent, and higher
/// ids shift down.
pub fn remove(m: &Model, id: int) {
    let up = m.parts[id].parent;
    for i in 0..m.sx * m.sy * m.sz {
        let p = int(m.part[i]);
        if p == id { m.part[i] = 0; }
        else if p > id { m.part[i] = u8(p - 1); }
    }
    for i in 1..=m.partCount {
        if m.parts[i].parent == id { m.parts[i].parent = up; }
    }
    for i in id..m.partCount { m.parts[i] = m.parts[i + 1]; }
    m.partCount -= 1;
    for i in 1..=m.partCount {
        if m.parts[i].parent > id { m.parts[i].parent -= 1; }
    }
    // Poses: drop the removed part's slot in every pose.
    for s in 0..=m.poseCount {
        for i in id..=m.partCount {
            for k in 0..3 { m.poses[s * POSE + i * 3 + k] = m.poses[s * POSE + (i + 1) * 3 + k]; }
        }
        for k in 0..3 { m.poses[s * POSE + (m.partCount + 1) * 3 + k] = 0; }
    }
    if m.active == id { m.active = 0; }
    else if m.active > id { m.active -= 1; }
    // Overlays on the removed part go with it; later parts renumber.
    let o = m.overlayCount;
    while o >= 1 {
        if m.overlays[o].part == id { model.removeOverlay(m, o); }
        o -= 1;
    }
    for k in 1..=m.overlayCount {
        if m.overlays[k].part > id { m.overlays[k].part -= 1; }
    }
    model.touch(m);
}

/// Drop every part, pose, clip and overlay; voxels become unassigned.
pub fn clearRig(m: &Model) {
    m.overlayCount = 0;
    m.texelCount = 0;
    m.partCount = 0;
    m.active = 0;
    m.poseCount = 0;
    m.clipCount = 0;
    for i in 0..m.sx * m.sy * m.sz { m.part[i] = 0; }
    for i in 0..(model.MAXPOSES + 1) * model.POSE { m.poses[i] = 0; }
    model.touch(m);
}

/// Voxels in part `id` (0 counts the unassigned ones).
pub fn voxels(m: &Model, id: int): int {
    let n = 0;
    for i in 0..m.sx * m.sy * m.sz {
        if m.cells[i] != 0 && int(m.part[i]) == id { n += 1; }
    }
    return n;
}

/// Box around part `id`'s voxels; false when it has none.
pub fn bounds(m: &Model, id: int, lo3: &[3]int, hi3: &[3]int): bool {
    let any = false;
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                let at = voxel.index(x, y, z, m.sx, m.sz);
                if m.cells[at] == 0 || int(m.part[at]) != id { continue; }
                if !any {
                    lo3[0] = x; lo3[1] = y; lo3[2] = z;
                    hi3[0] = x; hi3[1] = y; hi3[2] = z;
                    any = true;
                }
                if x < lo3[0] { lo3[0] = x; }
                if y < lo3[1] { lo3[1] = y; }
                if z < lo3[2] { lo3[2] = z; }
                if x > hi3[0] { hi3[0] = x; }
                if y > hi3[1] { hi3[1] = y; }
                if z > hi3[2] { hi3[2] = z; }
            }
        }
    }
    return any;
}

/// Give the voxels in a box to part `id` (0 unassigns). Returns how many voxels moved.
pub fn assignBox(m: &Model, id: int, x0: int, y0: int, z0: int, x1: int, y1: int, z1: int): int {
    let moved = 0;
    for y in lo(y0, y1)..=hi(y0, y1) {
        for z in lo(z0, z1)..=hi(z0, z1) {
            for x in lo(x0, x1)..=hi(x0, x1) {
                if !model.inside(m, x, y, z) { continue; }
                let at = voxel.index(x, y, z, m.sx, m.sz);
                if m.cells[at] == 0 || int(m.part[at]) == id { continue; }
                m.part[at] = u8(id);
                moved += 1;
            }
        }
    }
    model.touch(m);
    return moved;
}

/// Give every voxel of palette color `c` to part `id`.
pub fn assignColor(m: &Model, id: int, c: int): int {
    let moved = 0;
    for i in 0..m.sx * m.sy * m.sz {
        if int(m.cells[i]) == c && int(m.part[i]) != id {
            m.part[i] = u8(id);
            moved += 1;
        }
    }
    model.touch(m);
    return moved;
}

/// Give every unassigned voxel to part `id`.
pub fn assignRest(m: &Model, id: int): int {
    let moved = 0;
    for i in 0..m.sx * m.sy * m.sz {
        if m.cells[i] != 0 && m.part[i] == 0 {
            m.part[i] = u8(id);
            moved += 1;
        }
    }
    model.touch(m);
    return moved;
}

/// Move the voxels of part `from` whose `axis` coordinate is `at` or more into part `to`.
pub fn splitAt(m: &Model, from: int, axis: int, at: int, to: int): int {
    let moved = 0;
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                let cell = voxel.index(x, y, z, m.sx, m.sz);
                if m.cells[cell] == 0 || int(m.part[cell]) != from { continue; }
                let c = if axis == 0 { x } else { if axis == 1 { y } else { z } };
                if c >= at {
                    m.part[cell] = u8(to);
                    moved += 1;
                }
            }
        }
    }
    model.touch(m);
    return moved;
}

fn lo(a: int, b: int): int { if a < b { return a; } return b; }
fn hi(a: int, b: int): int { if a > b { return a; } return b; }

/// Put the joint where the part meets its parent (the middle of the touching faces), or at the
/// middle of the part when it has no parent or does not touch it. False when the part is empty.
pub fn pivotAuto(m: &Model, id: int): bool {
    let up = m.parts[id].parent;
    let sx: f32 = 0;
    let sy: f32 = 0;
    let sz: f32 = 0;
    let n = 0;
    if up != 0 {
        for y in 0..m.sy {
            for z in 0..m.sz {
                for x in 0..m.sx {
                    let cell = voxel.index(x, y, z, m.sx, m.sz);
                    if m.cells[cell] == 0 || int(m.part[cell]) != id { continue; }
                    for d in 0..6 {
                        let ox = if d == 0 { -1 } else { if d == 1 { 1 } else { 0 } };
                        let oy = if d == 2 { -1 } else { if d == 3 { 1 } else { 0 } };
                        let oz = if d == 4 { -1 } else { if d == 5 { 1 } else { 0 } };
                        if !model.inside(m, x + ox, y + oy, z + oz) { continue; }
                        let nb = voxel.index(x + ox, y + oy, z + oz, m.sx, m.sz);
                        if m.cells[nb] == 0 || int(m.part[nb]) != up { continue; }
                        sx += f32(x) + 0.5 + f32(ox) * 0.5;
                        sy += f32(y) + 0.5 + f32(oy) * 0.5;
                        sz += f32(z) + 0.5 + f32(oz) * 0.5;
                        n += 1;
                    }
                }
            }
        }
    }
    if n > 0 {
        m.parts[id].px = sx / f32(n);
        m.parts[id].py = sy / f32(n);
        m.parts[id].pz = sz / f32(n);
        model.touch(m);
        return true;
    }
    let a: [3]int = [0, 0, 0];
    let b: [3]int = [0, 0, 0];
    if !bounds(m, id, &a, &b) { return false; }
    m.parts[id].px = f32(a[0] + b[0] + 1) * 0.5;
    m.parts[id].py = f32(a[1] + b[1] + 1) * 0.5;
    m.parts[id].pz = f32(a[2] + b[2] + 1) * 0.5;
    model.touch(m);
    return true;
}

