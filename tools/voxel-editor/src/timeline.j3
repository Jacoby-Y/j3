// The timeline strip under the view (Rig tab): pick a clip, play it, scrub the playhead, and drag its keys in time. A key is a
// saved pose; editing the model while the clip is stopped bakes it into a key at the playhead (auto-key) or with Set key.

module voxel_editor.timeline;

use j3.game;
use j3.game.{ Color, Mouse, rgb };
use j3.math.{ Vec2, clamp };
use j3.memory.scratch;
use j3.text.Text;
use j3.ui.Ui;
use voxel_editor.clipedit;
use voxel_editor.edit;
use voxel_editor.model;
use voxel_editor.panels.{ fill, maybeButton, outline, toolButton };
use voxel_editor.rig;
use voxel_editor.world.{ BOTTOM, World };

const PAD: f32 = 30; // room each side of the track
const KEY_R: f32 = 7; // half size of a key
const GRAB: f32 = 10; // pixels around a key that grab it

struct Track {
    x0: f32;
    x1: f32;
    y: f32;
    h: f32;
}

fn timeX(t: Track, secs: f32, at: f32): f32 {
    return t.x0 + at / secs * (t.x1 - t.x0);
}

fn xTime(t: Track, secs: f32, x: f32): f32 {
    return clamp((x - t.x0) / (t.x1 - t.x0), 0, 1) * secs;
}

/// A diamond centered on `x y`.
fn diamond(x: f32, y: f32, r: f32, c: Color) {
    let row: f32 = 0 - r;
    while row <= r {
        let half = r - (if row < 0 { 0 - row } else { row });
        fill(x - half, y + row, half * 2 + 1, 1, c);
        row += 1;
    }
}

fn label(w: &World, x: f32, y: f32, msg: string, c: Color) {
    if w.font.raw == 0 { return; }
    game.setColor(c);
    game.drawText(w.font, Vec2 { x: x, y: y }, msg);
}

fn seconds(v: f32): string {
    let t = Text.new(scratch(0));
    t.pushFloat(v);
    t.pushStr("s");
    return t.str();
}

/// Pointer on the track: grab a key (and move it), or scrub the playhead.
fn mouse(w: &World, t: Track, secs: f32, mp: Vec2) {
    let m = &w.m;
    let c = m.clips[w.clip];
    let inside = mp.x >= t.x0 - GRAB && mp.x <= t.x1 + GRAB && mp.y >= t.y - 6 && mp.y <= t.y + t.h;
    if game.mousePressed(Mouse.Left) && inside {
        w.playing = false;
        let hit = -1;
        for j in 0..c.count {
            let dx = mp.x - timeX(t, secs, c.times[j]);
            if dx < GRAB && dx > 0 - GRAB { hit = j; }
        }
        if hit >= 0 {
            model.snapshot(m);
            w.key = hit;
            w.keyDrag = true;
            w.playT = c.times[hit];
            clipedit.show(w);
        } else {
            w.scrub = true;
        }
    }
    if !game.mouseDown(Mouse.Left) {
        w.keyDrag = false;
        w.scrub = false;
    }
    if w.keyDrag { w.playT = rig.moveKey(m, w.clip, w.key, xTime(t, secs, mp.x)); }
    if w.scrub {
        w.playT = xTime(t, secs, mp.x);
        clipedit.show(w);
    }
}

fn drawTrack(w: &World, t: Track, secs: f32) {
    let m = &w.m;
    let c = m.clips[w.clip];
    fill(t.x0, t.y, t.x1 - t.x0, t.h, rgb(24, 26, 32));
    // Ruler: a tick every tenth of a second, taller each half second, numbered each whole second.
    let n = int(secs * 10 + 0.5);
    for i in 0..=n {
        let x = timeX(t, secs, f32(i) / 10);
        let tall: f32 = if i % 5 == 0 { 10 } else { 5 };
        fill(x, t.y, 1, tall, rgb(90, 96, 112));
        if i % 10 == 0 && t.x1 - t.x0 > 200 { label(w, x + 3, t.y + 8, seconds(f32(i) / 10), rgb(130, 136, 150)); }
    }
    let mid = t.y + t.h * 0.55;
    fill(t.x0, mid, t.x1 - t.x0, 1, rgb(60, 64, 76));
    for j in 0..c.count {
        let kx = timeX(t, secs, c.times[j]);
        diamond(kx, mid, KEY_R, if j == w.key { rgb(255, 214, 90) } else { rgb(120, 170, 255) });
        label(w, kx - 14, mid + KEY_R + 4, c.keys[j], rgb(150, 156, 170));
    }
    let head = timeX(t, secs, clamp(w.playT, 0, secs));
    fill(head - 1, t.y, 3, t.h, rgb(235, 80, 80));
    label(w, head + 6, t.y + t.h - 20, seconds(w.playT), rgb(235, 140, 140));
}

fn toolbar(ui: &Ui, w: &World) {
    let m = &w.m;
    ui.row();
    if maybeButton(ui, if w.clip == 0 { "no clip" } else { m.clips[w.clip].name }, m.clipCount > 0) {
        clipedit.select(w, w.clip % m.clipCount + 1);
    }
    if ui.button("New clip") { clipedit.newClip(w); }
    if w.clip != 0 {
        if toolButton(ui, if w.playing { "Pause  Space" } else { "Play  Space" }, w.playing) {
            if !w.playing && !m.clips[w.clip].loop && w.playT >= m.clips[w.clip].seconds { w.playT = 0.0; }
            w.playing = !w.playing;
        }
        let looped = m.clips[w.clip].loop;
        if ui.check("Loop", &looped) {
            m.clips[w.clip].loop = looped;
            model.touch(m);
        }
        let secs = m.clips[w.clip].seconds;
        if ui.slider("Length", &secs, 0.1, 4.0) { rig.setSeconds(m, w.clip, secs); }
    }
    ui.end();
    if w.clip == 0 { return; }
    ui.row();
    if ui.button("Add frame") {
        model.snapshot(m);
        clipedit.addFrame(w);
    }
    if ui.button("Update key") {
        model.snapshot(m);
        clipedit.bake(w);
    }
    if maybeButton(ui, "Delete key", w.key >= 0) {
        model.snapshot(m);
        clipedit.removeKey(w);
    }
    ui.check("Auto-key", &w.autokey);
    ui.end();
}

/// The strip: background, controls, track, and the pointer on it.
pub fn draw(ui: &Ui, w: &World) {
    let h = edit.timelineHeight(w);
    if h == 0 { return; }
    let win = game.windowSize();
    let x0 = w.left;
    let width = win.x - w.left - w.right;
    let y0 = win.y - BOTTOM - h;
    fill(x0, y0, width, h, rgb(30, 32, 38));
    fill(x0, y0, width, 2, if w.edge == 3 { rgb(120, 170, 255) } else { rgb(52, 56, 66) });
    ui.x = x0 + 10;
    ui.y = y0 + 8;
    ui.w = 150;
    ui.h = 26;
    ui.space = 3;
    toolbar(ui, w);
    if w.clip == 0 || w.clip > w.m.clipCount {
        w.clip = 0;
        label(w, x0 + 14, y0 + 48, "New clip, pose the model, Add frame, pose again. Drag the red playhead or a diamond to move in time.", rgb(150, 156, 170));
        return;
    }
    let secs = w.m.clips[w.clip].seconds;
    let t = Track { x0: x0 + PAD, x1: x0 + width - PAD, y: y0 + 78, h: h - 90 };
    drawTrack(w, t, secs);
    mouse(w, t, secs, game.mousePos());
}
