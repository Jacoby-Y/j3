// An overlay as a PNG: six panels in a fixed net, one pixel per face, so any pixel editor can paint it.
// With the overlay's cells in a box `w` x `h` x `d` (y up, front is +z):
//
//        d      w      w
//      +----+------+------+
//      |    | top  | bot. |   top (py) and bottom (ny), each w x d
//      +----+------+------+------+------+
//      | px | pz   | nx   | nz   |          right (px) d x h, front (pz) w x h,
//      +----+------+------+------+          left (nx) d x h, back (nz) w x h
//        d     w      d       w
//
// Image size (2d + 2w) x (d + h). A pixel stands for the outermost exposed face in its column along
// the panel's axis, so every face of a box-shaped part or shell is reachable. A face hidden behind
// another face in the same column (a U shape) has no pixel; the `overlay` commands still paint it.
// Alpha 128 or more is painted; the rest is empty. Exported blanks are a faint gray (alpha 40) outline.

module voxel_editor.overlaypng;

use j3.gfx.canvas.{ Canvas, Mode, loadPng };
use j3.gfx.voxel;
use j3.memory.Arena;
use j3.result.Result;
use j3.text.Text;
use voxel_editor.model;
use voxel_editor.model.Model;
use voxel_editor.overlay;

/// The box around the overlay's cells: `lo3` / `hi3`. False when it has none.
fn box(m: &Model, cellsOf: []u8, lo3: &[3]int, hi3: &[3]int): bool {
    let any = false;
    for y in 0..m.sy {
        for z in 0..m.sz {
            for x in 0..m.sx {
                if cellsOf[voxel.index(x, y, z, m.sx, m.sz)] == 0 { continue; }
                if !any {
                    lo3[0] = x; lo3[1] = y; lo3[2] = z;
                    hi3[0] = x; hi3[1] = y; hi3[2] = z;
                    any = true;
                }
                if x < lo3[0] { lo3[0] = x; }
                if y < lo3[1] { lo3[1] = y; }
                if z < lo3[2] { lo3[2] = z; }
                if x > hi3[0] { hi3[0] = x; }
                if y > hi3[1] { hi3[1] = y; }
                if z > hi3[2] { hi3[2] = z; }
            }
        }
    }
    return any;
}

/// Image size for the overlay's cells; false when it has none.
pub fn size(m: &Model, cellsOf: []u8, wide: &int, tall: &int): bool {
    let a: [3]int = [0, 0, 0];
    let b: [3]int = [0, 0, 0];
    if !box(m, cellsOf, &a, &b) { return false; }
    let w = b[0] - a[0] + 1;
    let h = b[1] - a[1] + 1;
    let d = b[2] - a[2] + 1;
    *wide = 2 * d + 2 * w;
    *tall = d + h;
    return true;
}

/// Where image pixel `(px, py)` points: the face `*face` of cell `(x, y, z)`. False outside the six
/// panels or when no exposed face is in that column.
fn reach(m: &Model, cellsOf: []u8, a: &[3]int, b: &[3]int, px: int, py: int, face: &int, x: &int, y: &int, z: &int): bool {
    let w = b[0] - a[0] + 1;
    let h = b[1] - a[1] + 1;
    let d = b[2] - a[2] + 1;
    let u = 0;
    let v = 0;
    let f = -1;
    if py < d {
        if px >= d && px < d + w { f = 2; u = px - d; v = py; }
        else if px >= d + w && px < d + 2 * w { f = 3; u = px - d - w; v = py; }
    } else {
        v = py - d;
        if px < d { f = 0; u = px; }
        else if px < d + w { f = 4; u = px - d; }
        else if px < 2 * d + w { f = 1; u = px - d - w; }
        else if px < 2 * d + 2 * w { f = 5; u = px - 2 * d - w; }
    }
    if f < 0 { return false; }
    // The two coordinates fixed by the pixel, and the scan along the panel's axis from the outside in.
    let cx = a[0];
    let cy = a[1];
    let cz = a[2];
    let steps = 0;
    if f == 2 { cx = a[0] + u; cz = a[2] + v; cy = b[1]; steps = h; }
    if f == 3 { cx = a[0] + u; cz = b[2] - v; cy = a[1]; steps = h; }
    if f == 4 { cx = a[0] + u; cy = b[1] - v; cz = b[2]; steps = d; }
    if f == 5 { cx = b[0] - u; cy = b[1] - v; cz = a[2]; steps = d; }
    if f == 0 { cz = b[2] - u; cy = b[1] - v; cx = b[0]; steps = w; }
    if f == 1 { cz = a[2] + u; cy = b[1] - v; cx = a[0]; steps = w; }
    for k in 0..steps {
        let sx = cx;
        let sy = cy;
        let sz = cz;
        if f == 2 { sy = cy - k; }
        if f == 3 { sy = cy + k; }
        if f == 4 { sz = cz - k; }
        if f == 5 { sz = cz + k; }
        if f == 0 { sx = cx - k; }
        if f == 1 { sx = cx + k; }
        if cellsOf[voxel.index(sx, sy, sz, m.sx, m.sz)] != 0 && overlay.exposed(m, cellsOf, sx, sy, sz, f) {
            *face = f;
            *x = sx;
            *y = sy;
            *z = sz;
            return true;
        }
    }
    return false;
}

fn put(c: &Canvas, px: int, py: int, r: int, g: int, b: int, a: int) {
    let at = (py * int(c.w) + px) * 4;
    c.pixels[at] = u8(r);
    c.pixels[at + 1] = u8(g);
    c.pixels[at + 2] = u8(b);
    c.pixels[at + 3] = u8(a);
}

/// Write the overlay's pixels as a PNG. `unreached` counts exposed faces no panel pixel can reach.
pub fn exportPng(m: &Model, id: int, cellsOf: []u8, path: string, err: &Text, unreached: &int): bool {
    let a: [3]int = [0, 0, 0];
    let b: [3]int = [0, 0, 0];
    if !box(m, cellsOf, &a, &b) {
        err.pushStr("the overlay has no cells");
        return false;
    }
    let wide = 0;
    let tall = 0;
    size(m, cellsOf, &wide, &tall);
    let mem = Arena.create(wide * tall * 4 + 256 * 1024);
    defer mem.destroy();
    let c = Canvas.create(&mem, i32(wide), i32(tall), Mode.Pixel);
    let face = 0;
    let x = 0;
    let y = 0;
    let z = 0;
    let reached = 0;
    for py in 0..tall {
        for px in 0..wide {
            if !reach(m, cellsOf, &a, &b, px, py, &face, &x, &y, &z) { continue; }
            reached += 1;
            let rgb = model.texGet(m, model.texKey(id, face, x, y, z));
            if rgb < 0 { put(&c, px, py, 150, 150, 150, 40); }
            else { put(&c, px, py, rgb / 65536, (rgb / 256) % 256, rgb % 256, 255); }
        }
    }
    let nc = 0;
    let nf = 0;
    let np = 0;
    let ns = 0;
    overlay.counts(m, id, cellsOf, &nc, &nf, &np, &ns);
    *unreached = nf - reached;
    match c.savePng(path, &mem) {
        Result.Ok(_) { return true; }
        Result.Err(_) {
            err.pushStr("cannot write ");
            err.pushStr(path);
            return false;
        }
    }
}

/// Replace the overlay's reachable pixels from a PNG. `painted` / `cleared` count what changed, `stray` counts
/// opaque PNG pixels that point at no face. False (and `err`) when the file is missing or the wrong size.
pub fn importPng(m: &Model, id: int, cellsOf: []u8, path: string, err: &Text, painted: &int, cleared: &int, stray: &int): bool {
    let a: [3]int = [0, 0, 0];
    let b: [3]int = [0, 0, 0];
    if !box(m, cellsOf, &a, &b) {
        err.pushStr("the overlay has no cells");
        return false;
    }
    let wide = 0;
    let tall = 0;
    size(m, cellsOf, &wide, &tall);
    let mem = Arena.create(32 * 1024 * 1024);
    defer mem.destroy();
    let c = loadPng(path, &mem);
    if int(c.w) == 0 {
        err.pushStr("cannot read ");
        err.pushStr(path);
        err.pushStr(" (an 8-bit PNG)");
        return false;
    }
    if int(c.w) != wide || int(c.h) != tall {
        err.pushStr("the PNG is ");
        err.pushInt(int(c.w));
        err.pushStr("x");
        err.pushInt(int(c.h));
        err.pushStr(" but this overlay's net is ");
        err.pushInt(wide);
        err.pushStr("x");
        err.pushInt(tall);
        err.pushStr(" (`overlay export` writes a template)");
        return false;
    }
    let face = 0;
    let x = 0;
    let y = 0;
    let z = 0;
    *painted = 0;
    *cleared = 0;
    *stray = 0;
    for py in 0..tall {
        for px in 0..wide {
            let at = (py * wide + px) * 4;
            let opaque = int(c.pixels[at + 3]) >= 128;
            if !reach(m, cellsOf, &a, &b, px, py, &face, &x, &y, &z) {
                if opaque { *stray += 1; }
                continue;
            }
            let key = model.texKey(id, face, x, y, z);
            if opaque {
                let rgb = int(c.pixels[at]) * 65536 + int(c.pixels[at + 1]) * 256 + int(c.pixels[at + 2]);
                if model.texGet(m, key) != rgb {
                    if !model.texSet(m, key, rgb) {
                        err.pushStr("too many painted pixels (32768 at most)");
                        return false;
                    }
                    *painted += 1;
                }
            } else if model.texDel(m, key) {
                *cleared += 1;
            }
        }
    }
    return true;
}
