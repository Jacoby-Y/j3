// panels: the right-hand panel and the rig section.

module voxel_editor.panels;

pub fn rightPanel(ui: &Ui, w: &World) {
    let win = game.windowSize();
    fill(win.x - w.right, TOP, w.right, win.y - TOP - BOTTOM, rgb(34, 37, 44));
    fill(win.x - w.right, TOP, 2, win.y - TOP - BOTTOM, if w.edge == 2 { rgb(120, 170, 255) } else { rgb(52, 56, 66) });
    ui.x = win.x - w.right + 10;
    ui.y = TOP + 4;
    ui.w = w.right - 20;
    ui.h = 26;
    ui.space = 3;
    ui.row();
    if toolButton(ui, "  Model  ", !w.rigTab) { w.rigTab = false; }
    if toolButton(ui, "  Rig  ", w.rigTab) {
        w.rigTab = true;
        if w.tool < PARTPICK && !w.active { w.tool = PARTPICK; } // a click picks a limb instead of drawing
    }
    ui.end();
    if w.rigTab {
        // The rig tab is long: scroll it inside the room left under the tabs.
        ui.scroll(7, win.y - BOTTOM - ui.y - 6);
        rigPanel(ui, w);
        ui.end();
        return;
    }
    section(ui, "Model file");
    ui.field("path", &w.path);
    ui.row();
    if ui.button("Open...") { files.choose(w); }
    if ui.button("Save  Ctrl+S") { files.save(w); }
    if ui.button("Clear") { files.fresh(w); }
    ui.end();
    if ui.button("Export .j3mesh") { files.exportMesh(w); }
    let sx = w.m.sx;
    let sy = w.m.sy;
    let sz = w.m.sz;
    let resized = false;
    if ui.stepper("Width  x", &sx, 1, model.MAX) { resized = true; }
    if ui.stepper("Height y", &sy, 1, model.MAX) { resized = true; }
    if ui.stepper("Depth  z", &sz, 1, model.MAX) { resized = true; }
    if resized {
        model.snapshot(&w.m);
        model.resize(&w.m, sx, sy, sz);
    }
    section(ui, "Palette");
    swatches(ui, w);
    colorEditor(ui, w);
    ui.row();
    if ui.button("default") { preset(w, "default"); }
    if ui.button("earth") { preset(w, "earth"); }
    if ui.button("pastel") { preset(w, "pastel"); }
    ui.end();
    ui.row();
    if ui.button("gray") { preset(w, "gray"); }
    if ui.button("neon") { preset(w, "neon"); }
    if ui.button("Trim unused") {
        model.snapshot(&w.m);
        let gone = model.trimPalette(&w.m);
        if w.color > w.m.palLen { w.color = 1; }
        say2(w, "Palette trimmed; unused colors dropped: ", if gone > 0 { "yes" } else { "none" });
    }
    ui.end();
    caption(ui, "Palette file: palettes/NAME.j3pal");
    ui.field("palfile", &w.palFile);
    ui.row();
    if ui.button("Save palette") { files.savePalette(w); }
    if ui.button("Load palette") { files.loadPalette(w); }
    ui.end();
}

fn depthOf(m: &Model, id: int): int {
    let d = 0;
    let at = m.parts[id].parent;
    while at != 0 && d < model.MAXPARTS {
        d += 1;
        at = m.parts[at].parent;
    }
    return d;
}

/// Snapshot once per slider drag, so one drag is one undo step.
fn rigEdit(w: &World) {
    w.playing = false;
    if !w.palEditing {
        model.snapshot(&w.m);
        w.palEditing = true;
    }
}

fn newPart(w: &World, parent: int) {
    let n = w.m.partCount + 1;
    let name = Text.new(scratch(0));
    name.pushStr("Part");
    name.pushInt(n);
    while rig.find(&w.m, name.str()) != 0 {
        n += 1;
        name.clear();
        name.pushStr("Part");
        name.pushInt(n);
    }
    model.snapshot(&w.m);
    let id = rig.add(&w.m, name.str(), parent);
    if id == 0 {
        model.discardSnapshot(&w.m);
        say(w, "A model holds 32 parts at most");
        return;
    }
    if parent != 0 { rig.pivotAuto(&w.m, id); }
    w.m.active = id;
    say2(w, "Added ", name.str());
}

/// The Rig tab: parts, the active part's joint, the pose, and the rig tools.
fn rigPanel(ui: &Ui, w: &World) {
    let m = &w.m;
    section(ui, "Rig tools");
    ui.row();
    if toolButton(ui, "Pick part", w.tool == PARTPICK) { w.tool = PARTPICK; }
    if toolButton(ui, "Paint part", w.tool == PARTPAINT) { w.tool = PARTPAINT; }
    if toolButton(ui, "Joint", w.tool == PIVOT) { w.tool = PIVOT; }
    ui.end();
    caption(ui, "Paint gives voxels to the active part");
    section(ui, "Parts");
    if m.partCount == 0 { caption(ui, "none yet: add one, or Auto human"); }
    let shown = 8;
    if m.partCount - w.partTop < shown { shown = m.partCount - w.partTop; }
    if w.partTop > m.partCount - 1 { w.partTop = 0; }
    if w.partTop < 0 { w.partTop = 0; }
    for k in 0..shown {
        let id = w.partTop + 1 + k;
        let label = Text.new(scratch(0));
        for d in 0..depthOf(m, id) { label.pushStr("  "); }
        label.pushStr(m.parts[id].name);
        if toolButton(ui, label.str(), id == m.active) { m.active = id; }
    }
    if m.partCount > 8 {
        ui.row();
        if ui.button("Up") { w.partTop -= 1; }
        if ui.button("Down") { w.partTop += 1; }
        ui.end();
        if w.partTop > m.partCount - 8 { w.partTop = m.partCount - 8; }
    }
    ui.row();
    if ui.button("New root") { newPart(w, 0); }
    if maybeButton(ui, "New child", m.active != 0) { newPart(w, m.active); }
    ui.end();
    ui.row();
    if ui.button("Auto human") {
        model.snapshot(m);
        let made = rig.humanoid(m, 0);
        if made == 0 { model.discardSnapshot(m); say(w, "Build the body first"); }
        else { say(w, "Humanoid split; check it with Color by part"); }
    }
    if maybeButton(ui, "Clear rig", m.partCount > 0) {
        model.snapshot(m);
        rig.clearRig(m);
    }
    ui.end();
    ui.check("Color by part", &w.view.tint);
    ui.check("Show joints", &w.view.joints);
    if ui.check("Show overlays", &w.view.overlays) { w.view.rev = 0; }
    w.view.rev = if w.view.tint != w.partTint { 0 } else { w.view.rev };
    w.partTint = w.view.tint;
    if m.active != 0 { activePart(ui, w); }
    overlaySection(ui, w);
    if !game.mouseDown(Mouse.Left) && !typing() { w.palEditing = false; }
}
