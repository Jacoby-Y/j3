// Voxel editor: a window for people, and `vox run` for agents and scripts. See README.md.

module voxel_editor;

use j3.io.{ exists, printLn, readFile };
use j3.result.Result;
use j3.memory.Arena;
use j3.sys;
use j3.text.{ Text, same };
use j3.data.save;
use voxel_editor.cmd;
use voxel_editor.format;
use voxel_editor.model;
use voxel_editor.model.Model;
use voxel_editor.pick;
use voxel_editor.gui;
use voxel_editor.files;
use voxel_editor.panels;
use voxel_editor.hostio;
use voxel_editor.selftest;
use voxel_editor.shot;
use voxel_editor.util.{ cut, endsWith, parseF, parseI, startsWith };

fn usage() {
    printLn("voxel editor");
    printLn("  vox [FILE.j3voxel]            open the editor window");
    printLn("  vox run FILE [COMMAND...] [options]");
    printLn("      load FILE (a new 16x16x16 model if it does not exist), run each COMMAND");
    printLn("      (several per argument with ;), save FILE when it changed, then print info");
    printLn("      --script F    also run the commands in file F (one per line)");
    printLn("      --render P    write a PNG: --view iso|front|back|left|right|top|all (default iso)");
    printLn("                    --size WxH   --yaw D --pitch D (custom angle)   --perspective   --no-grid\n                    --parts (color each part)   --no-joints   --no-overlays");
    printLn("      --no-save     do not write FILE");
    printLn("      --out F       save to F instead of FILE");
    printLn("  vox help          this text; `vox run x \"help\"` lists the commands");
    printLn("Files are .j3voxel text (see README.md). A bare name gets .j3voxel.");
}

fn readText(path: string, mem: &Arena, out: &Text): string {
    match readFile(path, mem) {
        Result.Ok(bytes) { return bytes as string; }
        Result.Err(_) {
            out.pushStr("error: cannot read ");
            out.pushStr(path);
            out.push(10);
            return "";
        }
    }
}

/// `vox run`: a batch of commands, an optional picture, and the result as text.
fn runBatch(): int {
    let mem = Arena.create(256 * 1024 * 1024);
    let out = Text.new(&mem);
    let m = model.create(&mem, 16, 16, 16);
    let given = sys.arg(2);
    let path = cmd.fileName(given, &mem);
    if given.len == 0 {
        printLn("error: vox run wants a file: vox run models/robot.j3voxel \"box 0 0 0 3 3 3 red\"");
        return 2;
    }
    let target = path;
    let save = true;
    let ok = true;
    let renderTo = "";
    let sh = shot.defaults();
    let batch = Text.new(&mem);
    let err = Text.new(&mem);
    if exists(path) {
        if !format.load(path, &m, &err) {
            printLn(err.str());
            return 1;
        }
    } else {
        m.name = nameOf(path, &mem);
        out.pushStr("(new model ");
        out.pushStr(path);
        out.pushStr(", 16 16 16; `new SX SY SZ` resizes)\n");
    }
    let i = 3;
    while i < sys.argCount() && ok {
        let a = sys.arg(i);
        i += 1;
        if same(a, "--no-save") { save = false; }
        else if same(a, "--perspective") { sh.perspective = true; }
        else if same(a, "--no-grid") { sh.grid = false; }
        else if same(a, "--parts") { sh.parts = true; }
        else if same(a, "--no-joints") { sh.joints = false; }
        else if same(a, "--no-overlays") { sh.overlays = false; }
        else if same(a, "--render") { renderTo = sys.arg(i); i += 1; }
        else if same(a, "--out") { target = cmd.fileName(sys.arg(i), &mem); i += 1; }
        else if same(a, "--view") { sh.view = sys.arg(i); i += 1; }
        else if same(a, "--yaw") || same(a, "--pitch") {
            let v: f32 = 0;
            if !parseF(sys.arg(i), &v) {
                out.pushStr("error: --yaw and --pitch want degrees, like --yaw 45\n");
                ok = false;
            }
            if same(a, "--yaw") { sh.yaw = v; } else { sh.pitch = v; }
            sh.custom = true;
            i += 1;
        }
        else if same(a, "--size") {
            let s = sys.arg(i);
            let x = 0;
            while x < s.len && s[x] != 120 { x += 1; }
            sh.w = save.parseInt(s as []u8, 0, 512);
            sh.h = save.parseInt(s as []u8, x + 1, 512);
            if sh.w < 16 || sh.h < 16 || sh.w > 2048 || sh.h > 2048 {
                out.pushStr("error: --size is WxH between 16 and 2048, like 512x512\n");
                ok = false;
            }
            i += 1;
        }
        else if same(a, "--script") {
            let text = readText(sys.arg(i), &mem, &out);
            i += 1;
            if text.len == 0 { ok = false; }
            batch.pushStr(text);
            batch.push(10);
        }
        else if startsWith(a, "--") {
            out.pushStr("error: unknown option ");
            out.pushStr(a);
            out.pushStr(" (`vox help`)\n");
            ok = false;
        }
        else { batch.pushStr(a); batch.push(10); }
    }
    if ok { ok = cmd.runAll(&m, batch.str(), &out); }
    if ok && m.dirty && save {
        if format.save(target, &m, &err) {
            out.pushStr("saved ");
            out.pushStr(target);
            out.push(10);
        } else {
            out.pushStr("error: ");
            out.pushStr(err.str());
            out.push(10);
            ok = false;
        }
    } else if !ok && m.dirty && save {
        out.pushStr("(not saved: the batch failed; fix the command and run it again)\n");
    }
    if ok && renderTo.len > 0 {
        sh.out = renderTo;
        if shot.render(&m, sh, &err) {
            out.pushStr("rendered ");
            out.pushStr(renderTo);
            out.push(10);
        } else {
            out.pushStr("error: ");
            out.pushStr(err.str());
            out.push(10);
            ok = false;
        }
    }
    if ok { cmd.run(&m, "info", &out); }
    printLn(out.str());
    return if ok { 0 } else { 1 };
}

/// "models/robot.j3voxel" -> "robot".
fn nameOf(path: string, mem: &Arena): string {
    let start = 0;
    let end = path.len;
    for i in 0..path.len {
        if path[i] == 47 { start = i + 1; end = path.len; }
        if path[i] == 46 && i > start { end = i; }
    }
    return cut(path, start, end);
}

fn main() {
    let first = sys.arg(1);
    if same(first, "help") || same(first, "--help") || same(first, "-h") {
        usage();
        sys.exit(0);
    }
    if same(first, "selftest") {
        sys.exit(i32(selftest.selftest()));
    }
    if same(first, "run") {
        sys.exit(i32(runBatch()));
    }
    gui.run();
}
