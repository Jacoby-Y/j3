// Renders a model to a PNG without showing a window: what an agent looks at.

module voxel_editor.shot;

use j3.game;
use j3.gfx;
use j3.gfx.{ Orbit, Target };
use j3.gfx.canvas.{ Canvas, Mode };
use j3.math.{ PI, Vec2, sqrt };
use j3.memory.Arena;
use j3.result.Result;
use j3.text.{ Text, same };
use voxel_editor.model.Model;
use voxel_editor.view;
use voxel_editor.view.View;

pub struct Shot {
    out: string;
    /// iso, front, back, left, right, top, or all (a sheet of iso, front, right, top).
    view: string;
    w: int;
    h: int;
    /// Degrees; `custom` uses them instead of `view`.
    yaw: f32;
    pitch: f32;
    custom: bool;
    perspective: bool;
    grid: bool;
    /// Color voxels by part, and draw joints.
    parts: bool;
    joints: bool;
    overlays: bool;
}

pub fn defaults(): Shot {
    return Shot { out: "voxel.png", view: "iso", w: 512, h: 512, yaw: 45, pitch: 30, custom: false, perspective: false, grid: true, parts: false, joints: true, overlays: true };
}

fn max(a: f32, b: f32): f32 {
    if a > b { return a; }
    return b;
}

/// Camera yaw and pitch (radians) for a named view; false for an unknown name.
fn angles(name: string, yaw: &f32, pitch: &f32): bool {
    if same(name, "iso") { *yaw = PI / 4; *pitch = 0.5236; return true; }
    if same(name, "front") { *yaw = 0; *pitch = 0; return true; }
    if same(name, "back") { *yaw = PI; *pitch = 0; return true; }
    if same(name, "right") { *yaw = PI / 2; *pitch = 0; return true; }
    if same(name, "left") { *yaw = 0 - PI / 2; *pitch = 0; return true; }
    if same(name, "top") { *yaw = 0; *pitch = 1.5695; return true; }
    return false;
}

/// Half height an orthographic view needs to fit the model from this side.
fn fit(m: &Model, name: string, custom: bool, aspect: f32): f32 {
    let sx = f32(m.sx);
    let sy = f32(m.sy);
    let sz = f32(m.sz);
    let across = sqrt(sx * sx + sy * sy + sz * sz);
    let tall = across;
    if !custom {
        if same(name, "front") || same(name, "back") { across = sx; tall = sy; }
        if same(name, "left") || same(name, "right") { across = sz; tall = sy; }
        if same(name, "top") { across = sx; tall = sz; }
    }
    let half = max(tall / 2, across / 2 / aspect);
    return half * 1.1 + 0.5;
}

fn drawOne(v: &View, m: &Model, shot: Shot, name: string, target: Target, win: Vec2) {
    let yaw: f32 = shot.yaw * PI / 180;
    let pitch: f32 = shot.pitch * PI / 180;
    if !shot.custom { angles(name, &yaw, &pitch); }
    let aspect = f32(target.w) / f32(target.h);
    let half = fit(m, name, shot.custom, aspect);
    let radius = half * 4 + f32(m.sx + m.sy + m.sz);
    let cam = Orbit.create(view.center(m), yaw, pitch, radius);
    gfx.setOutputFbo(target.fbo);
    gfx.setViewRect(0, win.y - f32(target.h), f32(target.w), f32(target.h));
    if shot.perspective {
        gfx.setOrtho(0);
        cam.radius = half * 3.2;
        view.pass(v, m, cam, 0, shot.grid);
    } else {
        view.pass(v, m, cam, half, shot.grid);
    }
}

fn readBack(target: Target, canvas: &Canvas) {
    gfx.setOutputFbo(target.fbo);
    gfx.readPixels(target.w, target.h, canvas.pixels);
    gfx.setOutputFbo(0);
    let i = 3;
    while i < canvas.pixels.len {
        canvas.pixels[i] = 255;
        i += 4;
    }
}

/// Render `m` as `shot` says and write the PNG. `err` says why not.
pub fn render(m: &Model, shot: Shot, err: &Text): bool {
    let sheet = same(shot.view, "all");
    let names = ["iso", "front", "right", "top"];
    if !sheet && !shot.custom {
        let y: f32 = 0;
        let p: f32 = 0;
        if !angles(shot.view, &y, &p) {
            err.pushStr("--view is iso, front, back, left, right, top, or all");
            return false;
        }
    }
    let count = if sheet { 4 } else { 1 };
    let cols = if sheet { 2 } else { 1 };
    let rows = count / cols;
    game.initGlHidden("voxel render", shot.w, shot.h);
    gfx.init();
    let mem = Arena.create(shot.w * shot.h * 4 * (count + 2) + 4096);
    defer mem.destroy();
    let out = Canvas.create(&mem, i32(shot.w * cols), i32(shot.h * rows), Mode.Pixel);
    let tile = Canvas.create(&mem, i32(shot.w), i32(shot.h), Mode.Pixel);
    let target = gfx.makeTarget(shot.w, shot.h);
    let v = view.create();
    v.tint = shot.parts;
    v.joints = shot.joints;
    v.overlays = shot.overlays;
    view.remesh(&v, m);
    let win = game.windowSize();
    for k in 0..count {
        // A few frames so shadow maps settle.
        for frame in 0..2 {
            drawOne(&v, m, shot, if sheet { names[k] } else { shot.view }, target, win);
        }
        readBack(target, &tile);
        out.blit(tile, i32((k % cols) * shot.w), i32((k / cols) * shot.h));
    }
    view.release(&v);
    gfx.freeTarget(&target);
    game.destroy();
    match out.savePng(shot.out, &mem) {
        Result.Ok(_) { return true; }
        Result.Err(_) {
            err.pushStr("cannot write ");
            err.pushStr(shot.out);
            return false;
        }
    }
}
