// Editing the selected clip (`World.clip`) at the playhead (`World.playT`): showing it, baking the live pose into a key, and
// adding, removing and naming keys and clips. The timeline strip and the gizmo both call these.

module voxel_editor.clipedit;

use j3.memory.scratch;
use j3.text.{ Text, same };
use voxel_editor.edit.say;
use voxel_editor.model.Model;
use voxel_editor.rig;
use voxel_editor.world.World;

/// Pose the model at the playhead. The file does not count as changed by this.
pub fn show(w: &World) {
    if w.clip == 0 || w.clip > w.m.clipCount { return; }
    let was = w.m.dirty;
    rig.sampleClip(&w.m, w.clip, w.playT);
    w.m.dirty = was;
}

/// One frame of playback: advance the playhead (a one-shot stops at its end) and pose the model.
pub fn step(w: &World, dt: f32) {
    if !w.playing || w.clip == 0 { return; }
    if w.clip > w.m.clipCount { w.playing = false; return; }
    let c = w.m.clips[w.clip];
    w.playT += dt;
    if !c.loop && w.playT >= c.seconds {
        w.playT = c.seconds;
        w.playing = false;
    }
    if c.loop && w.playT >= c.seconds { w.playT -= c.seconds; }
    show(w);
}

/// Choose clip `id` (0 for none) and put the playhead at its start.
pub fn select(w: &World, id: int) {
    w.clip = id;
    w.playing = false;
    w.playT = 0.0;
    w.key = -1;
    show(w);
}

/// A name for a pose or clip: `base` and a number, the lowest one not yet taken by a pose (`pose` true) or clip.
fn freeName(m: &Model, base: string, pose: bool): string {
    for n in 1..1000 {
        let t = Text.new(scratch(0));
        t.pushStr(base);
        t.push(46);
        t.pushInt(n);
        let taken = if pose { rig.findPose(m, t.str()) } else { rig.findClip(m, t.str()) };
        if taken == 0 { return t.str(); }
    }
    return base;
}

/// A new one-second looping clip, selected.
pub fn newClip(w: &World) {
    let id = rig.addClip(&w.m, freeName(&w.m, "anim", false), 1.0, true);
    if id == 0 { say(w, "A model holds 8 clips at most"); return; }
    select(w, id);
}

/// Whether any clip still uses pose `name`.
fn used(m: &Model, name: string): bool {
    for c in 1..=m.clipCount {
        for j in 0..m.clips[c].count {
            if same(m.clips[c].keys[j], name) { return true; }
        }
    }
    return false;
}

/// Put the live pose into the clip at the playhead: into the key that is there, or into a new key.
pub fn bake(w: &World) {
    let m = &w.m;
    if w.clip == 0 { return; }
    let j = rig.keyNear(m, w.clip, w.playT, 0.02);
    if j >= 0 {
        rig.savePose(m, m.clips[w.clip].keys[j]);
        w.key = j;
        return;
    }
    let name = freeName(m, m.clips[w.clip].name, true);
    if !rig.savePose(m, name) { say(w, "64 poses at most"); return; }
    w.key = rig.insertKey(m, w.clip, name, w.playT);
    if w.key < 0 { say(w, "A clip holds 16 keys at most"); }
}

/// A new key after the last one (a quarter second on, the clip grows to fit), holding the live pose, with the playhead on it.
/// Pose it from there: auto-key keeps rewriting this key.
pub fn addFrame(w: &World) {
    let m = &w.m;
    let c = &m.clips[w.clip];
    let t: f32 = 0.0;
    if c.count > 0 { t = c.times[c.count - 1] + 0.25; }
    if t + 0.25 > c.seconds { c.seconds = t + 0.25; }
    w.playing = false;
    w.playT = t;
    bake(w);
}

/// A pose edit just happened: keep it if auto-key is on and the clip is stopped.
pub fn autokey(w: &World) {
    if w.autokey && w.clip != 0 && !w.playing { bake(w); }
}

/// Take the selected key out of its clip, and its pose too when no clip needs it.
pub fn removeKey(w: &World) {
    let m = &w.m;
    if w.clip == 0 || w.key < 0 || w.key >= m.clips[w.clip].count { return; }
    let name = m.clips[w.clip].keys[w.key];
    rig.removeKey(m, w.clip, w.key);
    if !used(m, name) { rig.removePose(m, rig.findPose(m, name)); }
    w.key = -1;
}
