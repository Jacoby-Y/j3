{
  "name": "j3",
  "displayName": "J3",
  "description": "J3 language: completion, imports, signature help, outline, j3.toml, .j3ui components (markup, slots, keyed lists, {#match}, CSS incl. calc()/vw/flex-wrap, J3 in one file), format, run/build.",
  "version": "0.4.0",
  "publisher": "j3",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "activationEvents": [
    "*",
    "onLanguage:j3",
    "onLanguage:j3toml",
    "onLanguage:j3ui"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "j3",
        "aliases": [
          "J3",
          "j3"
        ],
        "extensions": [
          ".j3",
          ".j3s"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "j3ui",
        "aliases": ["J3 UI", "j3ui"],
        "extensions": [".j3ui"],
        "configuration": "./language-configuration-j3ui.json"
      },
      {
        "id": "j3toml",
        "aliases": ["j3.toml", "J3 manifest"],
        "filenames": ["j3.toml"],
        "configuration": "./language-configuration-toml.json"
      }
    ],
    "grammars": [
      {
        "language": "j3",
        "scopeName": "source.j3",
        "path": "./syntaxes/j3.tmLanguage.json"
      },
      {
        "language": "j3ui",
        "scopeName": "source.j3ui",
        "path": "./syntaxes/j3ui.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.j3": "j3",
          "meta.embedded.block.css": "css",
          "meta.embedded.expression.j3ui": "j3"
        }
      },
      {
        "language": "j3toml",
        "scopeName": "source.j3toml",
        "path": "./syntaxes/j3toml.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[j3ui]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true
      },
      "[j3]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.quickSuggestions": {
          "other": "on",
          "comments": "off",
          "strings": "off"
        },
        "editor.suggestOnTriggerCharacters": true
      }
    },
    "commands": [
      {
        "command": "j3.run",
        "title": "J3: Run"
      },
      {
        "command": "j3.build",
        "title": "J3: Build"
      },
      {
        "command": "j3.fmt",
        "title": "J3: Format"
      }
    ],
    "taskDefinitions": [
      {
        "type": "j3"
      }
    ],
    "configuration": {
      "title": "J3",
      "properties": {
        "j3.j3cPath": {
          "type": "string",
          "default": "j3c",
          "description": "Path to the j3c binary (or `j3c` on PATH)."
        }
      }
    }
  }
}
