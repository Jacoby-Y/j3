{
  "name": "J3",
  "scopeName": "source.j3",
  "comment": "Generated by j3c dump-syntax from lexer/parser tables. Do not edit.",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#interpolate" },
    { "include": "#attributes" },
    { "include": "#intrinsics" },
    { "include": "#module-decl" },
    { "include": "#use-lib" },
    { "include": "#use-decl" },
    { "include": "#fn-decl" },
    { "include": "#type-decl" },
    { "include": "#const-decl" },
    { "include": "#let-decl" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants-bool" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#members" },
    { "include": "#constants-named" },
    { "include": "#variables" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.j3",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.j3",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.j3",
          "match": "\\\\[\\\\\"nrt0]"
        }
      ]
    },
    "interpolate": {
      "name": "string.interpolated.j3",
      "begin": "`",
      "end": "`",
      "patterns": [
        {
          "name": "meta.template.expression.j3",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.j3" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.j3" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#keywords" },
            { "include": "#types" },
            { "include": "#constants-bool" },
            { "include": "#numbers" },
            { "include": "#calls" },
            { "include": "#members" },
            { "include": "#constants-named" },
            { "include": "#variables" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "attributes": {
      "name": "meta.attribute.j3",
      "begin": "(#)(\\[)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.annotation.j3" },
        "2": { "name": "punctuation.definition.bracket.square.j3" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.bracket.square.j3" }
      },
      "patterns": [
        {
          "name": "entity.other.attribute.j3",
          "match": "\\b(?:Debug|singleton|TryCatch)\\b"
        },
        { "include": "#comments" },
        { "include": "#types" },
        { "include": "#punctuation" }
      ]
    },
    "intrinsics": {
      "match": "(@)(syscall|sizeof|slice|j3ui)\\b",
      "captures": {
        "1": { "name": "punctuation.definition.keyword.j3" },
        "2": { "name": "support.function.intrinsic.j3" }
      }
    },
    "module-decl": {
      "patterns": [
        {
          "match": "\\b(module)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.other.j3" },
            "2": { "name": "entity.name.namespace.j3" }
          }
        }
      ]
    },
    "use-lib": {
      "begin": "\\b(use)\\s+(lib)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.other.j3" },
        "2": { "name": "keyword.other.j3" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.j3" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#fn-decl" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#variables" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },
    "use-decl": {
      "begin": "\\b(use)\\b(?!\\s+lib)",
      "beginCaptures": {
        "0": { "name": "keyword.other.j3" }
      },
      "end": ";",
      "endCaptures": {
        "0": { "name": "punctuation.terminator.statement.j3" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#keywords" },
        { "include": "#types" },
        { "include": "#constants-named" },
        { "include": "#calls" },
        { "include": "#members" },
        { "include": "#variables" },
        { "include": "#punctuation" }
      ]
    },
    "fn-decl": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+(operator)(\\.\\.=|!=|&&|\\*=|\\+=|-=|\\.\\.|/=|::|<=|==|>=|\\|\\||!|&|\\*|\\+|-|\\.|/|<|=|>|\\?)",
          "captures": {
            "1": { "name": "storage.type.j3" },
            "2": { "name": "keyword.other.j3" },
            "3": { "name": "entity.name.operator.j3" }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.j3" },
            "2": { "name": "entity.name.function.j3" }
          }
        }
      ]
    },
    "type-decl": {
      "patterns": [
        {
          "match": "\\b(struct|enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.j3" },
            "2": { "name": "entity.name.type.j3" }
          }
        }
      ]
    },
    "const-decl": {
      "patterns": [
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.j3" },
            "2": { "name": "variable.other.constant.j3" }
          }
        }
      ]
    },
    "let-decl": {
      "patterns": [
        {
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.j3" },
            "2": { "name": "variable.other.j3" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.j3",
          "match": "\\b(?:module|use|lib|as|operator)\\b"
        },
        {
          "name": "storage.modifier.j3",
          "match": "\\b(?:pub)\\b"
        },
        {
          "name": "storage.type.j3",
          "match": "\\b(?:fn|struct|enum|const|let)\\b"
        },
        {
          "name": "keyword.control.j3",
          "match": "\\b(?:if|else|while|for|in|match|return|break|continue|defer)\\b"
        },
        {
          "name": "variable.language.j3",
          "match": "\\b(?:this)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "(\\[)(\\])(?=[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.bracket.square.j3" },
            "2": { "name": "punctuation.definition.bracket.square.j3" }
          }
        },
        {
          "match": "(\\[)([0-9]+)(\\])(?=[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.bracket.square.j3" },
            "2": { "name": "constant.numeric.integer.j3" },
            "3": { "name": "punctuation.definition.bracket.square.j3" }
          }
        },
        {
          "name": "support.type.builtin.j3",
          "match": "\\b(?:void|bool|int|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|float|ptr|cstr|string)\\b"
        },
        {
          "begin": "\\b([A-Z][A-Za-z0-9]*)\\s*(<)",
          "beginCaptures": {
            "1": { "name": "entity.name.type.j3" },
            "2": { "name": "punctuation.definition.typeparameters.begin.j3" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.j3" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#types" },
            { "include": "#punctuation" }
          ]
        },
        {
          "name": "entity.name.type.j3",
          "match": "\\b[A-Z][A-Za-z0-9]*\\b"
        }
      ]
    },
    "constants-bool": {
      "patterns": [
        {
          "name": "constant.language.boolean.j3",
          "match": "\\b(?:true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.j3",
          "match": "\\b0x[0-9A-Fa-f]+\\b"
        },
        {
          "name": "constant.numeric.float.j3",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.j3",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*::<)",
          "captures": {
            "1": { "name": "entity.name.function.j3" }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.j3" }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "match": "(\\.)([a-z_][A-Za-z0-9_]*)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.j3" },
            "2": { "name": "entity.name.function.j3" }
          }
        },
        {
          "match": "(\\.)([A-Z][A-Za-z0-9]*|[A-Z][A-Z0-9_]+)(?=\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.j3" },
            "2": { "name": "variable.other.enummember.j3" }
          }
        },
        {
          "match": "(\\.)([A-Z][A-Z0-9_]+)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.j3" },
            "2": { "name": "variable.other.constant.j3" }
          }
        },
        {
          "match": "(\\.)([A-Z][A-Za-z0-9]*)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.j3" },
            "2": { "name": "variable.other.enummember.j3" }
          }
        },
        {
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": { "name": "punctuation.accessor.j3" },
            "2": { "name": "variable.other.property.j3" }
          }
        }
      ]
    },
    "constants-named": {
      "patterns": [
        {
          "name": "variable.other.constant.j3",
          "match": "\\b[A-Z][A-Z0-9_]+\\b"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)",
          "captures": {
            "1": { "name": "variable.parameter.j3" },
            "2": { "name": "punctuation.separator.j3" }
          }
        },
        {
          "name": "variable.other.j3",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.j3",
          "match": "\\.\\.=|\\.\\.|::|&|\\.|\\?"
        },
        {
          "name": "keyword.operator.comparison.j3",
          "match": "!=|<=|==|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.j3",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.assignment.j3",
          "match": "\\*=|\\+=|-=|/=|="
        },
        {
          "name": "keyword.operator.arithmetic.j3",
          "match": "\\*|\\+|-|/"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.bracket.j3",
          "match": "[\\(\\)\\[\\]\\{\\}]"
        },
        {
          "name": "punctuation.separator.j3",
          "match": "[,;]"
        },
        {
          "name": "punctuation.separator.j3",
          "match": ":"
        }
      ]
    }
  }
}
