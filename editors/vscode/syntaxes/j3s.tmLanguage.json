{
  "name": "J3s",
  "scopeName": "source.j3s",
  "patterns": [
    {
      "match": "^\\s*(@)(props|state)\\b",
      "captures": {
        "1": {
          "name": "punctuation.definition.keyword.j3"
        },
        "2": {
          "name": "keyword.other.j3"
        }
      }
    },
    {
      "match": "\\b(self|scene)\\b",
      "name": "variable.language.j3s"
    },
    {
      "include": "source.j3"
    }
  ]
}
