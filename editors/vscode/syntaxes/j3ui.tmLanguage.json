{
  "name": "J3 UI",
  "scopeName": "source.j3ui",
  "comment": "Generated by j3c dump-syntax --ui. Do not edit.",
  "patterns": [
    { "include": "#comment" },
    { "include": "#script" },
    { "include": "#style" },
    { "include": "#block" },
    { "include": "#expr" },
    { "include": "#tag" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.j3ui",
      "begin": "<!--",
      "end": "-->"
    },
    "script": {
      "begin": "(<)(script)\\b[^>]*(>)",
      "end": "(</)(script)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.j3ui" },
        "2": { "name": "entity.name.tag.j3ui" },
        "3": { "name": "punctuation.definition.tag.j3ui" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.j3ui" },
        "2": { "name": "entity.name.tag.j3ui" },
        "3": { "name": "punctuation.definition.tag.j3ui" }
      },
      "contentName": "meta.embedded.block.j3",
      "patterns": [ { "include": "source.j3" } ]
    },
    "style": {
      "begin": "(<)(style)\\b[^>]*(>)",
      "end": "(</)(style)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.j3ui" },
        "2": { "name": "entity.name.tag.j3ui" },
        "3": { "name": "punctuation.definition.tag.j3ui" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.j3ui" },
        "2": { "name": "entity.name.tag.j3ui" },
        "3": { "name": "punctuation.definition.tag.j3ui" }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [ { "include": "source.css" } ]
    },
    "block": {
      "name": "meta.block.j3ui",
      "begin": "(\\{)([#:/])(if|else if|else|each|match|case|let)\\b",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.j3ui" },
        "2": { "name": "keyword.control.j3ui" },
        "3": { "name": "keyword.control.j3ui" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.embedded.end.j3ui" }
      },
      "patterns": [
        { "match": "\\bas\\b", "name": "keyword.control.j3ui" },
        { "include": "source.j3" }
      ]
    },
    "expr": {
      "name": "meta.embedded.expression.j3ui",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.j3ui" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.j3ui" } },
      "patterns": [ { "include": "source.j3" } ]
    },
    "tag": {
      "patterns": [
        {
          "name": "meta.tag.component.j3ui",
          "begin": "(</?)((?:[A-Za-z][A-Za-z0-9_]*\\.)*[A-Z][A-Za-z0-9_]*)",
          "end": "/?>",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.j3ui" },
            "2": { "name": "entity.name.type.class.component.j3ui" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.tag.j3ui" } },
          "patterns": [ { "include": "#attrs" } ]
        },
        {
          "name": "meta.tag.j3ui",
          "begin": "(</?)(div|span|p|h1|h2|small|header|nav|main|section|label|button|input|textarea|select|option|dl|dt|dd|canvas|dialog|aside|img|svg|path|h3|h4|h5|h6|ul|ol|li|a|hr|strong|em|b|i|pre|code|br|progress|meter|details|summary|glyph|component)\\b",
          "end": "/?>",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.j3ui" },
            "2": { "name": "entity.name.tag.j3ui" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.tag.j3ui" } },
          "patterns": [ { "include": "#attrs" } ]
        },
        {
          "name": "meta.tag.j3ui",
          "begin": "(</?)([a-z][A-Za-z0-9_-]*)",
          "end": "/?>",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.j3ui" },
            "2": { "name": "invalid.illegal.unknown-element.j3ui" }
          },
          "endCaptures": { "0": { "name": "punctuation.definition.tag.j3ui" } },
          "patterns": [ { "include": "#attrs" } ]
        }
      ]
    },
    "attrs": {
      "patterns": [
        {
          "match": "\\b(on|bind|class|style|transition)(:)([A-Za-z0-9_-]+)",
          "captures": {
            "1": { "name": "keyword.other.directive.j3ui" },
            "2": { "name": "punctuation.separator.directive.j3ui" },
            "3": { "name": "entity.other.attribute-name.directive.j3ui" }
          }
        },
        { "match": "[A-Za-z_][A-Za-z0-9_-]*", "name": "entity.other.attribute-name.j3ui" },
        { "match": "=", "name": "punctuation.separator.key-value.j3ui" },
        {
          "name": "string.quoted.double.j3ui",
          "begin": "\"",
          "end": "\"",
          "patterns": [ { "include": "#expr" } ]
        },
        { "include": "#expr" }
      ]
    }
  }
}
