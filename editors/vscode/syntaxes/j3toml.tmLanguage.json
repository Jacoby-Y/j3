{
  "scopeName": "source.j3toml",
  "name": "j3.toml",
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#section" },
    { "include": "#pair" },
    { "include": "#boolean" },
    { "include": "#number" }
  ],
  "repository": {
    "comment": {
      "match": "(#).*$",
      "captures": {
        "1": { "name": "punctuation.definition.comment.j3toml" }
      },
      "name": "comment.line.number-sign.j3toml"
    },
    "string": {
      "match": "\"(?:\\\\.|[^\"\\\\])*\"",
      "name": "string.quoted.double.j3toml"
    },
    "section": {
      "match": "^\\s*(\\[)([A-Za-z_][A-Za-z0-9_-]*)(\\])",
      "captures": {
        "1": { "name": "punctuation.definition.section.begin.j3toml" },
        "2": { "name": "entity.name.section.j3toml" },
        "3": { "name": "punctuation.definition.section.end.j3toml" }
      }
    },
    "pair": {
      "match": "^\\s*([A-Za-z_][A-Za-z0-9_-]*)\\s*(=)",
      "captures": {
        "1": { "name": "variable.other.key.j3toml" },
        "2": { "name": "keyword.operator.assignment.j3toml" }
      }
    },
    "boolean": {
      "match": "\\b(?:true|false)\\b",
      "name": "constant.language.boolean.j3toml"
    },
    "number": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.j3toml"
    }
  }
}
