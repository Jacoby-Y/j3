{
  "comments": {
    "blockComment": ["<!--", "-->"]
  },
  "brackets": [
    ["<!--", "-->"],
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["comment"] },
    { "open": "<!--", "close": "-->", "notIn": ["comment", "string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""],
    ["<", ">"]
  ],
  "wordPattern": "(--)?[A-Za-z_][A-Za-z0-9_:-]*",
  "folding": {
    "markers": {
      "start": "^\\s*\\{#(?:if|each)\\b|^\\s*<(?:script|style)\\b",
      "end": "^\\s*\\{/(?:if|each)\\}|^\\s*</(?:script|style)>"
    }
  }
}
